                                        font.family: theme.fontUi
                                        font.pixelSize: 11
                                        font.weight: Font.DemiBold
                                        wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                                        elide: Text.ElideNone
                                    }

                                    StatusChip {
                                        compact: true
                                        text: Boolean(modelData.safeToApply) ? "Verified"
