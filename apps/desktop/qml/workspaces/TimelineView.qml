    function handleTimelineToolMenuAction(key) {
        if (key === "tool-select") {
            timelineDocument.activeTool = "select"
            return
        }
        if (key === "tool-razor") {
            timelineDocument.activeTool = "razor"
            return
        }
        if (key === "tool-slip") {
            timelineDocument.activeTool = "slip"
            return
        }
        if (key === "tool-roll") {
            timelineDocument.activeTool = "roll"
            return
        }
        if (key === "tool-slide") {
            timelineDocument.activeTool = "slide"
            return
        }
        if (key === "mode-insert") {
            timelineDocument.editMode = "insert"
            return
        }
        if (key === "mode-overwrite") {
            timelineDocument.editMode = "overwrite"
            return
        }
        if (key === "toggle-linked") {
            timelineDocument.linkedSelectionEnabled = !timelineDocument.linkedSelectionEnabled
            return
        }
        if (key === "toggle-snapping") {
            snappingEnabled = !snappingEnabled
            return
        }
        if (key === "toggle-audio-peak-snapping") {
            if (snappingEnabled)
                audioPeakSnappingEnabled = !audioPeakSnappingEnabled
            return
        }
        if (key === "toggle-ripple") {
            if (timelineDocument.currentIndex >= 0)
                rippleModeEnabled = !rippleModeEnabled
            return
        }
        if (key === "split") {
            root.splitAtPlayhead()
            return
        }
        if (key === "delete")
            root.deleteSelectedTimelineClip()
    }

    function hasActiveTimelineRenderJobs() {
        return jobQueue && jobQueue.activeJobCountForKind("timeline_render") > 0
    }

    function timelineRenderStatus() {
        return jobQueue
                ? jobQueue.statusForKind("timeline_render", timelineDocument.status)
                : timelineDocument.status
    }

    function openJobsWorkspace() {
        const appWindow = root.Window.window
        if (appWindow)
            appWindow.currentWorkspace = appWindow.exportWorkspaceIndex
    }

    function toggleSourcePanel() {
        sourcePanelCollapsed = !sourcePanelCollapsed
    }

    function toggleEffectsPanel() {
        effectsPanelCollapsed = !effectsPanelCollapsed
    }

    function restoreDefaultLayout() {
        timelineFocusModeActive = false
        sourcePanelCollapsed = false
        sourcePanelHidden = false
        effectsPanelCollapsed = true
        timelineAdvancedControlsVisible = false
        sourcePanelDetached = false
        effectsPanelDetached = false
        programScopesVisible = false
        programSourceGangEnabled = false
        programScopesActiveScope = "waveform"
        sourceRailTab = timelineDocument.hasSourceClip ? "source" : "media"
        inspectorTab = "effects"
        inspectorTabsByType = ({})
        timelineWorkspaceSettings.inspectorTabsByTypeJson = "{}"
        sourcePanelWidth = 320
        effectsPanelWidth = 344
        monitorPanelHeight = 540
        setLaneHeaderWidth(144)
        trackHeights = ({})
        timelineZoom = 84
        timelineWorkspaceSettings.timelineScrollX = 0
        timelineWorkspaceSettings.timelineScrollY = 0
        timelineWorkspaceSettings.detachedSourceX = NaN
        timelineWorkspaceSettings.detachedSourceY = NaN
        timelineWorkspaceSettings.detachedSourceWidth = 420
        timelineWorkspaceSettings.detachedSourceHeight = 720
        timelineWorkspaceSettings.detachedInspectorX = NaN
        timelineWorkspaceSettings.detachedInspectorY = NaN
        timelineWorkspaceSettings.detachedInspectorWidth = 420
        timelineWorkspaceSettings.detachedInspectorHeight = 720
        timelineWorkspaceSettings.detachedScopesX = NaN
        timelineWorkspaceSettings.detachedScopesY = NaN
        timelineWorkspaceSettings.detachedScopesWidth = 1120
        timelineWorkspaceSettings.detachedScopesHeight = 720
        timelineViewportStateRestored = false
        Qt.callLater(restoreTimelineViewportState)
        timelineSearchExpanded = false
        markerReviewExpanded = false
        snappingEnabled = appShell.defaultTimelineSnapping
        audioPeakSnappingEnabled = false
        rippleModeEnabled = appShell.defaultTimelineRipple
    }

    function programVideoFillMode() {
        return programVideoFillModeFor(programClip.frameMode)
    }

    function programVideoFillModeFor(frameMode) {
        switch (String(frameMode || "fit")) {
        case "fill":
            return VideoOutput.PreserveAspectCrop
        case "stretch":
            return VideoOutput.Stretch
        default:
            return VideoOutput.PreserveAspectFit
        }
    }

    function programImageFillMode() {
        return programImageFillModeFor(currentClip.frameMode)
    }

    function programImageFillModeFor(frameMode) {
        switch (String(frameMode || "fit")) {
        case "fill":
            return Image.PreserveAspectCrop
        case "stretch":
            return Image.Stretch
        default:
            return Image.PreserveAspectFit
        }
    }

    function openMediaPicker() {
        if (!catalogAssets.loading && Number(catalogAssets.totalAssetCount || 0) === 0) {
            openImportWorkspace()
            return
        }
        mediaPickerScope = Number(catalogAssets.assetCount || 0) === 0
                ? "all" : (hasProjectScopedMediaPicker() ? "project" : "all")
        refreshMediaPickerAssets(true)
        mediaPickerDialog.openDialog()
    }

    function openImportWorkspace() {
        const appWindow = root.Window.window
        if (appWindow && typeof appWindow.beginImportWorkspace === "function")
            appWindow.beginImportWorkspace()
    }

    function setMediaPickerScope(scope) {
        if (mediaPickerScope === scope)
            return
        mediaPickerScope = scope
        refreshMediaPickerAssets()
    }

    function addPickedMedia() {
        if (!canLoadPickedMedia())
            return false
        const previousIds = timelineClipIds()
        const duration = Math.max(0, Number(mediaPickerDialog.selectedDurationSeconds || 0))
        timelineDocument.insertClipFromGallery(
                    mediaPickerDialog.selectedAssetId,
                    mediaPickerDialog.selectedFilePath,
                    mediaPickerDialog.selectedDisplayLabel,
                    duration, 0, duration,
                    mediaPickerDialog.selectedThumbnailSource)
        if (!hasNewTimelineClip(previousIds))
            return false
        mediaPickerDialog.close()
        return true
    }

    function timelineClipIds() {
        const ids = ({})
        const tracks = timelineDocument.timelineTracks || []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const clips = tracks[trackIndex].clips || []
            for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                const clipId = String(clips[clipIndex].clipId || "")
                if (clipId.length > 0)
                    ids[clipId] = true
            }
        }
        return ids
    }

    function hasNewTimelineClip(previousIds) {
        const tracks = timelineDocument.timelineTracks || []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const clips = tracks[trackIndex].clips || []
            for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                const clipId = String(clips[clipIndex].clipId || "")
                if (clipId.length > 0 && previousIds[clipId] !== true)
                    return true
            }
        }
        return false
    }

    function previewPickedMedia() {
        if (!canLoadPickedMedia())
            return false
        const assetId = String(mediaPickerDialog.selectedAssetId || "")
        timelineDocument.loadSourceClipFromGallery(
                    assetId,
                    mediaPickerDialog.selectedFilePath,
                    mediaPickerDialog.selectedDisplayLabel,
                    mediaPickerDialog.selectedDurationSeconds,
                    mediaPickerDialog.selectedThumbnailSource)
        const loadedSource = timelineDocument.sourceClip
        if (String(loadedSource.assetId || "") !== assetId
                || String(loadedSource.filePath || "") !== String(mediaPickerDialog.selectedFilePath || ""))
            return false
        sourceRailTab = "source"
        sourcePanelHidden = false
        sourcePanelCollapsed = false
        mediaPickerDialog.close()
        return true
    }

    function overwritePickedMedia() {
        if (!canLoadPickedMedia())
            return false
        const duration = Math.max(0, Number(mediaPickerDialog.selectedDurationSeconds || 0))
        const previousIds = timelineClipIds()
        timelineDocument.overwriteClipFromGallery(
                    mediaPickerDialog.selectedAssetId,
                    mediaPickerDialog.selectedFilePath,
                    mediaPickerDialog.selectedDisplayLabel,
                    duration, 0, duration,
                    mediaPickerDialog.selectedThumbnailSource)
        if (!hasNewTimelineClip(previousIds))
            return false
        mediaPickerDialog.close()
        return true
    }

    function updateExternalMediaDrop(payload, sceneX, sceneY) {
        if (!timelineDocument.hasActiveTimeline || !timelineViewport) {
            externalMediaDropState = {"visible": false}
            return
        }
        const viewportPoint = timelineViewport.mapFromItem(null, sceneX, sceneY)
        if (viewportPoint.x < 0 || viewportPoint.y < 0
                || viewportPoint.x > timelineViewport.width
                || viewportPoint.y > timelineViewport.height) {
            externalMediaDropState = {"visible": false}
            return
        }
        const contentX = Math.max(0, viewportPoint.x + timelineViewport.contentX)
        const contentY = viewportPoint.y + timelineViewport.contentY
        for (let row = 0; row < sequenceTrackModel.length; ++row) {
            const track = sequenceTrackModel[row]
            const trackTop = trackTopY(row)
            const trackBottom = trackTop + trackHeight(track.trackId)
            if (contentY < trackTop || contentY > trackBottom)
                continue
            const mediaType = String(payload && payload.mediaType || "video")
            const compatible = track.locked !== true
                    && ((mediaType === "audio" && track.trackKind === "audio")
                        || (mediaType !== "audio" && track.trackKind === "video"))
            externalMediaDropState = {
                "visible": true,
                "compatible": compatible,
                "row": row,
                "x": contentX,
                "seconds": contentX / timelineZoom,
                "payload": payload
            }
            return
        }
        externalMediaDropState = {"visible": false}
    }

    function commitExternalMediaDrop(payload, sceneX, sceneY) {
        updateExternalMediaDrop(payload, sceneX, sceneY)
        const target = externalMediaDropState
        if (target.visible && target.compatible) {
            timelineDocument.insertClipFromGalleryAtTrack(
                        String(payload.assetId || ""),
                        String(payload.filePath || ""),
                        String(payload.titleText || "Media"),
                        0,
                        0,
                        0,
                        String(payload.thumbnailSource || ""),
                        Number(target.row),
                        Number(target.seconds))
        }
        externalMediaDropState = {"visible": false}
    }

    function clipSourceTime(modelData, localX) {
        const localSeconds = Math.max(0, localX / timelineZoom)
        const points = modelData && modelData.retimePoints ? modelData.retimePoints : []
        if (points.length >= 2)
            return Math.max(0, root.animatedClipValueAtLocal(
                                modelData, "sourceTime",
                                Number(modelData.trimStartSeconds || 0), localSeconds))
        const sourceOffset = localSeconds
                             * Math.max(0.25, Number(modelData.playbackRate || 1))
        return Number(modelData.trimStartSeconds || 0) + sourceOffset
    }

    function resetTimelinePreviewState() {
        clipEdgeTrimGesture = null
        dragPreviewState = {"visible": false, "x": 0, "y": 0, "width": 0}
        snapGuideState = {"visible": false, "seconds": 0, "label": ""}
        trimFeedbackState = {
            "visible": false,
            "mode": "",
            "edge": "",
            "clipId": "",
            "baselineSeconds": 0,
            "boundarySeconds": 0,
            "deltaSeconds": 0,
            "label": "",
            "outgoing": ({"valid": false, "role": "OUTGOING"}),
            "incoming": ({"valid": false, "role": "INCOMING"})
        }
        lastTrimPreviewUpdateTime = 0
        Qt.callLater(function() {
            root.refreshVirtualizedTimelineTrackRows(true)
            root.refreshTimelineClipVirtualizationWindow(true)
        })
    }

    function cancelTrimFeedback() {
        if (trimFeedbackState.visible !== true)
            return
        timelineTrimCommitTimer.stop()
        pendingTrimEndSequenceSeconds = -1
        interactionTrimEndSequenceSeconds = -1
        if (clipEdgeTrimGesture === null) {
            timelineDocument.endContinuousEdit()
            timelineDocument.undo()
        }
        clipEdgeTrimGesture = null
        timelineDocument.setLinkedEditOverride(false)
        resetTimelinePreviewState()
    }

    function beginClipEdgeTrim(clip, edge, pointerX, modifiers) {
        const baseline = Number(edge === "in" ? clip.startSeconds : clip.endSeconds)
        const mode = timelineDocument.activeTool === "roll" ? "roll" : "trim"
        clipEdgeTrimGesture = {
            "clipId": String(clip.clipId), "edge": edge, "mode": mode,
            "pressX": Number(pointerX), "baselineSeconds": baseline,
            "pendingSeconds": baseline, "startSeconds": Number(clip.startSeconds),
            "endSeconds": Number(clip.endSeconds), "trimStartSeconds": Number(clip.trimStartSeconds),
            "durationSeconds": Number(clip.durationSeconds),
            "playbackRate": Math.max(0.25, Number(clip.playbackRate || 1)),
            "retimeActive": clip.retimeActive === true, "ripple": rippleModeEnabled
        }
        // Freeze delegate virtualization before selection or playback publishes state.
        beginTrimFeedback(mode, edge, clip.clipId, baseline)
        timelineDocument.setLinkedEditOverride((modifiers & Qt.AltModifier) !== 0)
        timelinePlayback.pause()
        timelineDocument.selectClip(Number(clip.index))
    }

    function previewClipEdgeTrim(pointerX) {
        const gesture = clipEdgeTrimGesture
        if (!gesture) return
        if (Math.abs(Number(pointerX) - gesture.pressX) < 0.5
                && gesture.pendingSeconds === gesture.baselineSeconds) return
        const proposed = gesture.baselineSeconds + (Number(pointerX) - gesture.pressX) / Math.max(1, timelineZoom)
        const snapped = snapSequenceResult(proposed, gesture.clipId)
        const minimumDuration = Math.max(0.05, 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)))
        const minimum = gesture.edge === "in"
                ? (gesture.retimeActive ? gesture.startSeconds
                   : Math.max(0, gesture.startSeconds - gesture.trimStartSeconds / gesture.playbackRate))
                : gesture.startSeconds + minimumDuration
        const maximum = gesture.edge === "in" ? gesture.endSeconds - minimumDuration
                : gesture.retimeActive ? gesture.endSeconds
                : gesture.startSeconds + (gesture.durationSeconds - gesture.trimStartSeconds) / gesture.playbackRate
        const boundary = gesture.mode === "roll" ? snapped.seconds
                : Math.max(minimum, Math.min(maximum, snapped.seconds))
        clipEdgeTrimGesture = Object.assign({}, gesture, {"pendingSeconds": boundary})
        updateTrimFeedback(gesture.mode, gesture.edge, gesture.baselineSeconds, boundary)
        updateSnapGuide(boundary, snapped.snapped && Math.abs(boundary - snapped.seconds) < 0.0001,
                        gesture.mode === "roll" ? "Roll" : "Trim", snapped.label)
    }

    function finishClipEdgeTrim() {
        const gesture = clipEdgeTrimGesture
        if (!gesture) return
        if (Math.abs(gesture.pendingSeconds - gesture.baselineSeconds) > 0.000001) {
            timelineDocument.beginContinuousEdit()
            try {
                if (gesture.mode === "roll") {
                    if (gesture.edge === "in") timelineDocument.rollSelectedClipStartToSequenceSeconds(gesture.pendingSeconds)
                    else timelineDocument.rollSelectedClipEndToSequenceSeconds(gesture.pendingSeconds)
                } else if (gesture.edge === "in") {
                    timelineDocument.trimSelectedClipStartToSequenceSeconds(gesture.pendingSeconds, gesture.ripple)
                } else {
                    timelineDocument.trimSelectedClipEndToSequenceSeconds(gesture.pendingSeconds, gesture.ripple)
                }
            } finally {
                timelineDocument.endContinuousEdit()
            }
        }
        clipEdgeTrimGesture = null
        timelineDocument.setLinkedEditOverride(false)
        resetTimelinePreviewState()
    }

    function updateSnapGuide(seconds, snapped, labelPrefix, targetLabel) {
        if (snapped) {
            snapGuideState = {
                "visible": true,
                "seconds": seconds,
                "label": labelPrefix + " · " + String(targetLabel || "Snap") + " · " + timecodeText(seconds)
            }
        } else {
            snapGuideState = {"visible": false, "seconds": 0, "label": ""}
        }
    }

    function signedSecondsLabel(value) {
        const seconds = Number(value || 0)
        if (Math.abs(seconds) < 0.005)
            return "0.00s"
        return (seconds > 0 ? "+" : "") + seconds.toFixed(2) + "s"
    }

    function trimClipSnapshot(clip) {
        if (!clip)
            return null
        return {
            "clipId": String(clip.clipId || ""),
            "trackId": String(clip.trackId || ""),
            "displayLabel": String(clip.displayLabel || "Clip"),
            "mediaType": String(clip.mediaType || "video"),
            "sourceUrl": String(clip.sourceUrl || ""),
            "posterSource": String(clip.posterSource || ""),
            "frameMode": String(clip.frameMode || "fit"),
            "durationSeconds": Number(clip.durationSeconds || 0),
            "startSeconds": Number(clip.startSeconds || 0),
            "endSeconds": Number(clip.endSeconds || 0),
            "trimStartSeconds": Number(clip.trimStartSeconds || 0),
            "trimEndSeconds": Number(clip.trimEndSeconds || 0)
        }
    }

    function videoClipForId(clipId) {
        const wantedId = String(clipId || "")
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || track.trackKind !== "video" || !track.clips)
                continue
            for (let clipIndex = 0; clipIndex < track.clips.length; ++clipIndex) {
                const clip = track.clips[clipIndex]
                if (clip && String(clip.clipId || "") === wantedId)
                    return clip
            }
        }
        return null
    }

    function adjacentVideoClip(clip, direction) {
        if (!clip)
            return null
        let clips = []
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || track.trackKind !== "video" || String(track.trackId || "") !== String(clip.trackId || ""))
                continue
            clips = track.clips ? Array.from(track.clips) : []
            break
        }
        clips.sort(function(left, right) {
            const startDelta = Number(left.startSeconds || 0) - Number(right.startSeconds || 0)
            return Math.abs(startDelta) > 0.0001 ? startDelta : String(left.clipId || "").localeCompare(String(right.clipId || ""))
        })
        const wantedId = String(clip.clipId || "")
        for (let index = 0; index < clips.length; ++index) {
            if (String(clips[index].clipId || "") !== wantedId)
                continue
            const targetIndex = index + direction
            return targetIndex >= 0 && targetIndex < clips.length ? clips[targetIndex] : null
        }
        return null
    }

    function emptyTrimFrame(role) {
        return {
            "valid": false,
            "role": role,
            "displayLabel": "Gap",
            "mediaType": "gap",
            "sourceUrl": "",
            "posterSource": "",
            "frameMode": "fit",
            "sourceSeconds": 0,
            "sourceTimecode": "--:--:--:--"
        }
    }

    function trimFrameForClip(clip, sourceSeconds, role) {
        if (!clip)
            return emptyTrimFrame(role)
        const frameDuration = 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const minimumSource = 0
        const maximumSource = Math.max(minimumSource, Number(clip.durationSeconds || clip.trimEndSeconds || 0) - frameDuration)
        const boundedSource = Math.max(minimumSource, Math.min(maximumSource, Number(sourceSeconds || 0)))
        return {
            "valid": true,
            "role": role,
            "clipId": String(clip.clipId || ""),
            "displayLabel": String(clip.displayLabel || "Clip"),
            "mediaType": String(clip.mediaType || "video"),
            "sourceUrl": String(clip.sourceUrl || ""),
            "posterSource": String(clip.posterSource || ""),
            "frameMode": String(clip.frameMode || "fit"),
            "sourceSeconds": boundedSource,
            "sourceTimecode": timecodeText(boundedSource)
        }
    }

    function beginTrimFeedback(mode, edge, clipId, baselineSeconds) {
        const clip = videoClipForId(clipId)
        const previousCandidate = adjacentVideoClip(clip, -1)
        const nextCandidate = adjacentVideoClip(clip, 1)
        const adjacencyTolerance = 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const previousClip = clip && previousCandidate
                && Math.abs(Number(previousCandidate.endSeconds || 0) - Number(clip.startSeconds || 0)) <= adjacencyTolerance
                ? previousCandidate : null
        const nextClip = clip && nextCandidate
                && Math.abs(Number(nextCandidate.startSeconds || 0) - Number(clip.endSeconds || 0)) <= adjacencyTolerance
                ? nextCandidate : null
        trimFeedbackState = {
            "visible": true,
            "mode": String(mode || "trim"),
            "edge": String(edge || ""),
            "clipId": String(clipId || ""),
            "baselineSeconds": Number(baselineSeconds || 0),
            "boundarySeconds": Number(baselineSeconds || 0),
            "deltaSeconds": 0,
            "label": "",
            "baseClip": trimClipSnapshot(clip),
            "previousClip": trimClipSnapshot(previousClip),
            "nextClip": trimClipSnapshot(nextClip),
            "outgoing": emptyTrimFrame("OUTGOING"),
            "incoming": emptyTrimFrame("INCOMING")
        }
        lastTrimPreviewUpdateTime = 0
    }

    function updateTrimFeedback(mode, edge, baselineSeconds, nextSeconds) {
        const normalizedMode = String(mode || "trim")
        const normalizedEdge = String(edge || "")
        let state = trimFeedbackState
        if (!state || state.visible !== true || String(state.edge || "") !== normalizedEdge) {
            state = {
                "visible": true,
                "mode": normalizedMode,
                "edge": normalizedEdge,
                "clipId": "",
                "baselineSeconds": Number(baselineSeconds || 0),
                "baseClip": null,
                "previousClip": null,
                "nextClip": null
            }
        }
        const now = Date.now()
        if (lastTrimPreviewUpdateTime > 0 && now - lastTrimPreviewUpdateTime < 24)
            return
        lastTrimPreviewUpdateTime = now
        const baseline = Number(state.baselineSeconds !== undefined ? state.baselineSeconds : baselineSeconds || 0)
        const boundary = Number(nextSeconds || 0)
        const delta = boundary - baseline
        const title = normalizedMode === "slip" ? "Slip"
                    : normalizedMode === "roll" ? "Roll"
                    : normalizedMode === "ripple" ? "Ripple"
                    : normalizedEdge === "out" ? "Trim Out"
                    : "Trim In"
        const baseClip = state.baseClip || null
        const previousClip = state.previousClip || null
        const nextClip = state.nextClip || null
        const frameDuration = 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        let outgoing = emptyTrimFrame("OUTGOING")
        let incoming = emptyTrimFrame("INCOMING")
        if (baseClip && normalizedEdge === "out") {
            outgoing = trimFrameForClip(baseClip, Number(baseClip.trimEndSeconds || 0) + delta - frameDuration, "OUTGOING")
            const nextSource = nextClip
                    ? Number(nextClip.trimStartSeconds || 0) + (normalizedMode === "roll" ? delta : 0)
                    : 0
            incoming = trimFrameForClip(nextClip, nextSource, "INCOMING")
        } else if (baseClip && normalizedEdge === "in") {
            const previousSource = previousClip
                    ? Number(previousClip.trimEndSeconds || 0) + (normalizedMode === "roll" ? delta : 0) - frameDuration
                    : 0
            outgoing = trimFrameForClip(previousClip, previousSource, "OUTGOING")
            incoming = trimFrameForClip(baseClip, Number(baseClip.trimStartSeconds || 0) + delta, "INCOMING")
        }
        trimFeedbackState = {
            "visible": true,
            "mode": normalizedMode,
            "edge": normalizedEdge,
            "clipId": String(state.clipId || ""),
            "baselineSeconds": baseline,
            "boundarySeconds": boundary,
            "deltaSeconds": delta,
            "label": title + " " + root.signedSecondsLabel(delta),
            "baseClip": baseClip,
            "previousClip": previousClip,
            "nextClip": nextClip,
            "outgoing": outgoing,
            "incoming": incoming
        }
    }

    function addMarkerAtPlayhead() {
        timelineDocument.addSequenceMarker()
        markerFeedbackText = "Marker " + root.timecodeText(sequencePlayheadSeconds)
        markerFeedbackVisible = true
        markerFeedbackTimer.restart()
        return markerFeedbackSignature
    }

    function applyEffectToClip(clipIndex, effectName) {
        if (clipIndex < 0 || !effectName || effectName.length === 0)
            return
        timelineDocument.selectClip(clipIndex)
        timelineDocument.addSelectedClipEffect(effectName)
        recordRecentEffect(effectName)
        if (effectName === "Transform" || effectName === "Opacity" || effectName === "Crop")
            inspectorTab = "motion"
        else if (effectName === "Volume" || effectName === "Pan")
            inspectorTab = "audio"
        else
            inspectorTab = "effects"
    }

    function applyTransitionToClipEdge(clipIndex, edge, transitionName, durationSeconds) {
        if (clipIndex < 0 || !transitionName || transitionName.length === 0)
            return
        timelineDocument.selectClip(clipIndex)
        timelineDocument.assignSelectedClipTransition(edge, transitionName, durationSeconds)
        if (transitionName === "Fade In")
            timelineDocument.setSelectedClipFadeInSeconds(durationSeconds)
        else if (transitionName === "Fade Out")
            timelineDocument.setSelectedClipFadeOutSeconds(durationSeconds)
            inspectorTab = "transitions"
    }

    function clipMetadataText(clip) {
        if (!clip)
            return ""
        if (clip.mediaOnline === false)
            return "OFFLINE  ·  " + String(clip.trimmedDurationText || "")
        if (clip.mediaType === "adjustment")
            return String(clip.trimmedDurationText || "") + "  ·  AFFECTS TRACKS BELOW"
        if (clip.trackKind === "audio" && clip.silentPlaceholder)
            return "Silent bed"
        const details = [String(clip.trimmedDurationText || "")]
        if (clip.trackKind === "audio") {
            const gain = Number(clip.audioGainDb || 0)
            const fadeIn = Number(clip.fadeInSeconds || 0)
            const fadeOut = Number(clip.fadeOutSeconds || 0)
            if (Math.abs(gain) > 0.01)
                details.push((gain > 0 ? "+" : "") + gain.toFixed(1) + " dB")
            if (fadeIn > 0 || fadeOut > 0)
                details.push("Fades " + fadeIn.toFixed(1) + "/" + fadeOut.toFixed(1) + "s")
        } else {
            const opacity = clip.opacity !== undefined ? Number(clip.opacity) : 1
            const rate = clip.playbackRate !== undefined ? Number(clip.playbackRate) : 1
            if (Math.abs(opacity - 1) > 0.001)
                details.push(Math.round(opacity * 100) + "% opacity")
            if (Math.abs(rate - 1) > 0.001)
                details.push(rate.toFixed(2) + "×")
        }
        return details.filter(function(detail) { return detail.length > 0 }).join("  ·  ")
    }

    function renderCacheStatusForClip(clip) {
        if (!clip || !root.renderCacheRangeModel)
            return ""
        const clipStart = Number(clip.startSeconds || 0)
        const clipEnd = Number(clip.endSeconds
                               || (clipStart + Number(clip.trimmedDurationSeconds || 0)))
        let bestStatus = ""
        for (let index = 0; index < root.renderCacheRangeModel.length; ++index) {
            const range = root.renderCacheRangeModel[index]
            const rangeStart = Number(range.startSeconds || 0)
            const rangeEnd = Number(range.endSeconds
                                    || (rangeStart + Number(range.durationSeconds || 0)))
            if (rangeEnd <= clipStart || rangeStart >= clipEnd)
                continue
            const status = String(range.status || "missing")
            if (status === "generating")
                return status
            if (status === "queued")
                bestStatus = status
            else if (status === "ready" && bestStatus.length === 0)
                bestStatus = status
        }
        return bestStatus
    }

    function clipStatusBadges(clip, trackSuppressed) {
        if (!clip)
            return []
        const badges = []
        if (clip.mediaOnline === false) {
            badges.push({
                "key": "offline",
                "label": "OFFLINE",
                "iconName": "info",
                "tone": "danger",
                "tooltip": "Source media is missing. Relink this clip before export."
            })
        }
        if (trackSuppressed) {
            badges.push({
                "key": "disabled",
                "label": "OFF",
                "iconName": "hidden",
                "tone": "warning",
                "tooltip": clip.trackKind === "audio"
                           ? "This clip is muted or its track is locked."
                           : "This clip is hidden or its track is locked."
            })
        }
        if (clip.mediaType === "caption") {
            badges.push({
                "key": "caption",
                "label": "CC",
                "iconName": "edit",
                "tone": "neutral",
                "tooltip": "Editable caption clip"
            })
        }
        if (clip.mediaType === "adjustment") {
            badges.push({
                "key": "adjustment",
                "label": "ADJ",
                "iconName": "effects",
                "tone": "ready",
                "tooltip": "Adjustment clip. Its enabled effects process eligible picture tracks below."
            })
        }
        if (Number(clip.groupedClipCount || 0) > 1) {
            badges.push({
                "key": "group",
                "label": "GRP " + Number(clip.groupedClipCount || 0),
                "iconName": "link",
                "tone": "neutral",
                "tooltip": "Grouped clip. Linked edits affect "
                           + Number(clip.groupedClipCount || 0) + " clips."
            })
        } else if (clip.audioLinked === true
                   || (clip.trackKind === "audio"
                       && clip.hasAudio === true
                       && clip.audioDetached !== true)) {
            badges.push({
                "key": "linked",
                "label": "LINK",
                "iconName": "link",
                "tone": "neutral",
                "tooltip": "Linked picture and audio"
            })
        }
        const effectCount = clip.effectCount !== undefined
                ? Number(clip.effectCount || 0)
                : clip.effectStack ? clip.effectStack.length : 0
        if (effectCount > 0) {
            badges.push({
                "key": "effects",
                "label": clip.effectsEnabled === false ? "FX OFF" : "FX " + effectCount,
                "iconName": "effects",
                "tone": clip.effectsEnabled === false ? "warning" : "neutral",
                "tooltip": effectCount + " applied effect" + (effectCount === 1 ? "" : "s")
                           + (clip.effectsEnabled === false ? " (bypassed)" : "")
            })
        }
        if (clip.trackKind === "video"
                && (clip.retimeActive === true
                    || Math.abs(Number(clip.playbackRate || 1) - 1.0) > 0.01)) {
            const speedLabel = clip.retimeActive === true
                    ? (clip.retimeDirection === "reverse" ? "REV "
                       : clip.retimeDirection === "freeze" ? "HOLD " : "RAMP ")
                      + Math.abs(Number(clip.effectivePlaybackRate || 0)).toFixed(1) + "x"
                    : Number(clip.playbackRate || 1).toFixed(1) + "x"
            badges.push({
                "key": "speed",
                "label": speedLabel,
                "iconName": "clock",
                "tone": "warning",
                "tooltip": "Playback speed " + speedLabel
            })
        }
        if (clip.trackKind === "video" && clip.mediaType === "video"
                && String(clip.proxyStatus || "none") !== "none") {
            const proxyStatus = String(clip.proxyStatus || "none")
            badges.push({
                "key": "proxy",
                "label": proxyStatus === "failed" ? "PXY !"
                         : proxyStatus === "ready" ? (clip.usingProxy ? "PXY" : "ORG")
                         : "PXY…",
                "iconName": "media",
                "tone": proxyStatus === "failed" ? "danger"
                        : proxyStatus === "ready" ? "ready" : "warning",
                "tooltip": proxyStatus === "failed" ? "Proxy generation failed"
                           : clip.usingProxy ? "Proxy media is active"
                           : proxyStatus === "ready" ? "Proxy is ready; original is active"
                           : "Proxy generation is in progress"
            })
        }
        const cacheStatus = root.renderCacheStatusForClip(clip)
        if (cacheStatus.length > 0) {
            badges.push({
                "key": "cache",
                "label": cacheStatus === "ready" ? "CACHE"
                         : cacheStatus === "generating" ? "CACHE…" : "CACHE Q",
                "iconName": "media",
                "tone": cacheStatus === "ready" ? "ready" : "warning",
                "tooltip": cacheStatus === "ready"
                           ? "This range is ready in the preview cache"
                           : "This range is being prepared for smooth playback"
            })
        }
        return badges
    }

    function clipMoveOperationLabel() {
        if (root.rippleModeEnabled)
