                                font.family: theme.fontMono
                                font.pixelSize: theme.typeCaption
                            }
                        }

                        ActionButton {
                            objectName: "timelineBackgroundJobsHistoryToggle"
                            text: root.backgroundJobsShowFinished ? "Hide History" : "History"
                            iconName: "clock"
                            compact: true
                            active: root.backgroundJobsShowFinished
                            onClicked: root.backgroundJobsShowFinished = !root.backgroundJobsShowFinished
                        }
                    }

                    Label {
                        Layout.fillWidth: true
                        text: "Persistent imports and deliveries share this view with live Timeline analysis, proxies, transcription, previews, and render work. Controls appear only when the underlying job supports them safely."
                        color: theme.textMuted
                        font.family: theme.fontUi
                        font.pixelSize: theme.typeLabel
                        wrapMode: Text.Wrap
                    }

                    ListView {
                        id: backgroundJobList
                        objectName: "timelineBackgroundJobList"
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        clip: true
                        spacing: theme.space6
                        model: root.visibleBackgroundJobs()
                        ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }

                        delegate: Rectangle {
                            required property var modelData
                            width: ListView.view.width
                            height: Math.max(116, backgroundJobContent.implicitHeight + theme.space10 * 2)
                            radius: theme.radiusSurface
                            color: theme.alpha(theme.ink700, 0.30)
                            border.width: 0

                            ColumnLayout {
                                id: backgroundJobContent
                                anchors.fill: parent
                                anchors.margins: theme.space10
                                spacing: theme.space6

                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: theme.space6

                                    Label {
                                        Layout.fillWidth: true
                                        text: String(modelData.displayLabel || modelData.jobKind || "Background job")
                                        color: theme.textStrong
                                        font.family: theme.fontUi
                                        font.pixelSize: theme.typeLabel
                                        font.weight: Font.DemiBold
                                        wrapMode: Text.Wrap
                                    }

                                    StatusChip {
                                        text: String(modelData.status || "Waiting")
                                        tone: modelData.status === "Failed" ? "error"
                                              : modelData.status === "Completed" ? "success"
                                              : modelData.status === "Paused" ? "warning"
                                              : (modelData.status === "Running" || modelData.status === "Queued")
                                                ? "info" : "neutral"
                                        compact: true
                                        detailText: String(modelData.stage || "")
                                    }

                                    ActionButton {
                                        objectName: "timelineBackgroundJobPriority_" + String(modelData.jobId || "")
                                        text: String(modelData.priority || "normal").toUpperCase()
                                        compact: true
                                        active: modelData.priority === "high"
                                        enabled: modelData.canChangePriority === true
                                        disabledReason: "Priority is fixed while this job is active or is derived from the visible Timeline context."
                                        tooltip: modelData.canChangePriority === true
                                                 ? "Cycle High, Normal, and Low queue priority."
                                                 : disabledReason
                                        onClicked: root.cycleBackgroundJobPriority(modelData)
                                    }

                                    MenuButton {
                                        objectName: "timelinePersistentRenderJobMenu_" + String(modelData.jobId || "")
                                        visible: String(modelData.origin || "") === "persistent" &&
                                                 (String(modelData.jobKind || "") === "asset_export" ||
                                                  String(modelData.jobKind || "") === "timeline_render")
                                        text: "More"
                                        iconName: "menu"
                                        compact: true
                                        secondaryActionMenu: true
                                        primaryOpensMenu: true
                                        menuWidth: 220
                                        menuItems: root.persistentRenderJobMenuItems(modelData)
                                        tooltipText: "Reorder, duplicate, or reveal this persistent render job."
                                        onMenuItemTriggered: function(key) {
                                            root.handlePersistentRenderJobMenu(modelData, key)
                                        }
                                    }
                                }

                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: theme.space8

                                    ColumnLayout {
                                        Layout.fillWidth: true
                                        spacing: theme.space3

                                        Label {
                                            Layout.fillWidth: true
                                            text: String(modelData.stage || "Waiting")
                                            color: theme.textMuted
                                            font.family: theme.fontUi
                                            font.pixelSize: theme.typeCaption
                                            wrapMode: Text.Wrap
                                        }

                                        Label {
                                            visible: String(modelData.priorityReason || "").length > 0
                                            Layout.fillWidth: true
                                            text: String(modelData.priorityReason || "")
                                            color: modelData.deferredByUserIntent === true
                                                   ? theme.warning : theme.textFaint
                                            font.family: theme.fontMono
                                            font.pixelSize: theme.typeCaption
                                            wrapMode: Text.Wrap
                                        }

                                        Rectangle {
                                            Layout.fillWidth: true
                                            Layout.preferredHeight: theme.scaled(4)
                                            radius: height / 2
                                            color: theme.alpha(theme.ink700, 0.50)
                                            clip: true

                                            Rectangle {
                                                height: parent.height
                                                width: parent.width * (modelData.progressKnown === true
                                                                       ? Math.max(0, Math.min(100, Number(modelData.progress || 0))) / 100
                                                                       : 0.32)
                                                radius: height / 2
                                                color: modelData.status === "Failed" ? theme.error
                                                       : modelData.status === "Completed" ? theme.success
                                                       : theme.accentCool300
                                                opacity: modelData.progressKnown === true ? 0.9 : 0.55
                                            }
                                        }

                                        Label {
                                            visible: String(modelData.errorMessage || "").length > 0
                                            Layout.fillWidth: true
                                            text: String(modelData.errorMessage || "")
                                            color: modelData.status === "Failed" ? theme.error : theme.warning
                                            font.family: theme.fontMono
                                            font.pixelSize: theme.typeCaption
                                            wrapMode: Text.Wrap
                                        }
                                    }

                                    ActionButton {
                                        text: String(modelData.jumpLabel || "Show")
                                        iconName: "focus-frame"
                                        compact: true
                                        onClicked: root.jumpToBackgroundJob(modelData)
                                    }

                                    ActionButton {
                                        visible: modelData.canPause === true || modelData.canResume === true
                                        text: modelData.canResume === true ? "Resume" : "Pause"
                                        iconName: modelData.canResume === true ? "play" : "pause"
                                        compact: true
                                        onClicked: root.controlBackgroundJob(
                                                       modelData,
                                                       modelData.canResume === true ? "resume" : "pause")
                                    }

                                    ActionButton {
                                        visible: modelData.canRetry === true
                                        text: "Retry"
                                        iconName: "reset"
                                        compact: true
                                        onClicked: root.controlBackgroundJob(modelData, "retry")
                                    }

                                    ActionButton {
                                        visible: modelData.canCancel === true
                                        text: "Cancel"
                                        iconName: "close"
                                        tone: "danger"
                                        compact: true
                                        onClicked: root.controlBackgroundJob(modelData, "cancel")
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        visible: backgroundJobList.count === 0
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        radius: theme.radiusSurface
                        color: theme.alpha(theme.ink700, 0.22)
                        border.width: 0

                        ColumnLayout {
                            anchors.centerIn: parent
                            width: Math.min(parent.width - theme.space24 * 2, 360)
                            spacing: theme.space6

                            Label {
                                Layout.alignment: Qt.AlignHCenter
                                text: root.backgroundJobsShowFinished ? "No job history" : "No active or failed jobs"
                                color: theme.textStrong
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeLabel
                                font.weight: Font.DemiBold
                            }

                            Label {
                                Layout.fillWidth: true
                                text: "This window stays quiet until background work needs attention."
                                horizontalAlignment: Text.AlignHCenter
                                color: theme.textMuted
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeCaption
                                wrapMode: Text.Wrap
                            }
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: theme.space8

                        Label {
                            Layout.fillWidth: true
                            text: jobQueue ? String(jobQueue.status || "") : ""
                            color: theme.textFaint
                            font.family: theme.fontMono
                            font.pixelSize: theme.typeCaption
                            wrapMode: Text.Wrap
                        }

                        ActionButton {
                            objectName: "timelineClearFinishedBackgroundJobsButton"
                            text: "Clear Finished"
                            iconName: "delete"
                            compact: true
                            enabled: jobQueue && jobQueue.historyMutationsEnabled && root.backgroundJobCount(["Completed", "Canceled"]) > 0
                            disabledReason: jobQueue && !jobQueue.historyMutationsEnabled
                                            ? "Resolve job recovery before changing history."
                                            : "There is no finished persistent job history to clear."
                            onClicked: {
                                if (jobQueue)
                                    jobQueue.clearFinishedJobs()
                                Qt.callLater(root.refreshBackgroundJobs)
                            }
                        }

                        ActionButton {
                            objectName: "timelineRefreshBackgroundJobsButton"
                            text: "Refresh"
                            iconName: "reset"
                            compact: true
                            onClicked: {
                                if (jobQueue)
                                    jobQueue.refresh()
                                root.refreshBackgroundJobs()
                            }
                        }

                        ActionButton {
                            text: "Done"
                            compact: true
                            onClicked: backgroundJobsPopup.close()
                        }
                    }
                }
            }
        }
    }

    AppPopup {
        id: pancakeTimelinePopup
        readonly property var editor: contentItem.item

        objectName: "timelinePancakePopup"
        modal: true
        focus: true
        width: Math.min(popupAvailableWidth, Math.max(1, Math.min(1040, root.width - theme.space24 * 2)))
        height: Math.min(popupAvailableHeight, Math.max(1, Math.min(780, root.height - theme.space24 * 2)))
        x: (root.width - width) / 2
        y: Math.max(theme.space24, (root.height - height) / 2)
        padding: standardPopupPadding
        closePolicy: Popup.CloseOnEscape
        onClosed: {
            root.restorePopupInvoker(root.pancakeFocusReturnItem)
            root.pancakeFocusReturnItem = null
        }

        background: PopupSurface {}

        contentItem: Loader {
            active: pancakeTimelinePopup.visible
            sourceComponent: Component {
                TimelinePancakeEditor {
                    id: pancakeEditor
                    objectName: "timelinePancakeEditor"
                    timelineDocument: root.documentController
                    onCloseRequested: pancakeTimelinePopup.close()
                }
            }
        }
    }

    AppPopup {
        id: projectCachePopup
        property bool contentCreated: false
        objectName: "timelineProjectCachePopup"
        modal: true
        focus: true
        width: Math.min(popupAvailableWidth, Math.max(1, Math.min(680, root.width - theme.space24 * 2)))
        height: Math.min(popupAvailableHeight, Math.max(1, Math.min(720, root.height - theme.space24 * 2)))
        x: (root.width - width) / 2
        y: Math.max(theme.space24, (root.height - height) / 2)
        padding: standardPopupPadding
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        onClosed: {
            timelineDocument.setProjectCacheManagerVisible(false)
            root.projectCacheSelectAfterRefresh = false
            root.restorePopupInvoker(root.projectCacheFocusReturnItem)
            root.projectCacheFocusReturnItem = null
            root.projectCacheData = ({})
            root.projectCacheBudgetData = ({})
            root.projectCacheBudgetDraft = ({})
            root.projectCacheBudgetDetailsVisible = false
            root.projectCacheSelectedCategories = []
            root.projectCacheCleanupResult = ({})
            root.projectCacheCleanupArmed = false
        }

        background: PopupSurface {}

        contentItem: Loader {
            active: projectCachePopup.contentCreated || projectCachePopup.visible
            onLoaded: projectCachePopup.contentCreated = true
            sourceComponent: Component {
                ColumnLayout {
                    spacing: theme.space10

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: theme.space10

                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: theme.space2

                            Label {
                                text: "Project Cache"
                                color: theme.textStrong
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeDialogTitle
                                font.weight: Font.DemiBold
                            }

                            Label {
                                Layout.fillWidth: true
                                text: root.projectCacheData.ready !== true
                                      ? "Checking generated files…"
                                      : String(root.projectCacheData.timelineName || "Current timeline") + "  ·  " +
                                      String(root.projectCacheData.totalFileCount || 0) + " generated files  ·  " +
                                      root.cacheBytesText(root.projectCacheData.totalBytes)
                                color: theme.textMuted
                                font.family: theme.fontMono
                                font.pixelSize: theme.typeCaption
                                wrapMode: Text.Wrap
                            }
                        }

                        StatusChip {
                            text: root.projectCacheData.loading === true ? "Checking…"
                                  : root.cacheBytesText(root.projectCacheData.reclaimableBytes) + " reclaimable"
                            tone: Number(root.projectCacheData.reclaimableFileCount || 0) > 0 ? "info" : "neutral"
                            compact: true
                            detailText: String(root.projectCacheData.reclaimableFileCount || 0) +
                                        " project-only files"
                        }
                    }

                    Label {
                        Layout.fillWidth: true
                        visible: String(root.projectCacheData.error || "").length > 0
                        text: String(root.projectCacheData.error || "")
                        color: theme.warning
                        font.family: theme.fontUi
                        font.pixelSize: theme.typeCaption
                        wrapMode: Text.Wrap
                    }

                    Label {
                        Layout.fillWidth: true
                        text: "Only generated files owned by this project are eligible. Source media, saved timelines, exports, shared cache files, and active job outputs are protected."
                        color: theme.textMuted
                        font.family: theme.fontUi
                        font.pixelSize: theme.typeLabel
                        wrapMode: Text.Wrap
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: theme.space8

                        StatusChip {
                            objectName: "timelineCachePressureStatus"
                            text: String(root.projectCacheBudgetData.pressureLevel || "normal").toUpperCase()
                            tone: root.projectCacheBudgetData.pressureLevel === "critical"
                                  ? "danger"
                                  : root.projectCacheBudgetData.pressureLevel === "warning"
                                    ? "warning" : "positive"
                            compact: true
                            detailText: String(root.projectCacheBudgetData.pressureExplanation || "")
                        }

                        Label {
                            Layout.fillWidth: true
                            text: root.projectCacheBudgetData.automatic === false
                                  ? "Project-specific resource limits"
                                  : "Automatic limits based on this Mac and cache volume"
                            color: theme.textMuted
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeCaption
                            elide: Text.ElideNone
                        }

                        ActionButton {
                            objectName: "timelineProjectCacheBudgetsDisclosure"
                            text: root.projectCacheBudgetDetailsVisible ? "Hide Budgets" : "Budgets"
                            iconName: "settings"
                            compact: true
                            onClicked: root.projectCacheBudgetDetailsVisible =
                                       !root.projectCacheBudgetDetailsVisible
                        }
                    }

                    Rectangle {
                        objectName: "timelineProjectCacheBudgetPanel"
                        visible: root.projectCacheBudgetDetailsVisible
                        Layout.fillWidth: true
                        implicitHeight: visible ? cacheBudgetContent.implicitHeight + theme.space10 * 2 : 0
                        radius: theme.radiusSurface
                        color: theme.alpha(theme.ink700, 0.30)
                        border.width: 0

                        ColumnLayout {
                            id: cacheBudgetContent
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.top: parent.top
                            anchors.margins: theme.space10
                            spacing: theme.space4

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: theme.space6

                                FilterChip {
                                    objectName: "timelineCacheBudgetAutomaticButton"
                                    text: "Automatic"
                                    iconName: "sparkles"
                                    active: root.projectCacheBudgetDraft.automatic !== false
                                    onClicked: root.setProjectCacheBudgetDraftValue("automatic", true)
                                }

                                FilterChip {
                                    objectName: "timelineCacheBudgetProjectButton"
                                    text: "This Project"
                                    iconName: "timeline"
                                    active: root.projectCacheBudgetDraft.automatic === false
                                    onClicked: root.setProjectCacheBudgetDraftValue("automatic", false)
                                }

                                Item { Layout.fillWidth: true }

                                ActionButton {
                                    objectName: "timelineApplyCacheBudgetsButton"
                                    text: "Apply"
                                    iconName: "check"
                                    compact: true
                                    tone: "primary"
                                    onClicked: root.applyProjectCacheBudgets()
                                }
                            }

                            InspectorSlider {
                                objectName: "timelineDiskCacheBudgetSlider"
                                Layout.fillWidth: true
                                label: "Disk cache"
                                from: 1
                                to: 200
                                stepSize: 1
                                value: Number(root.projectCacheBudgetDraft.diskGiB || 10)
                                valueText: Math.round(value) + " GB"
                                enabled: root.projectCacheBudgetDraft.automatic === false
                                disabledReason: "Switch to This Project to set a fixed disk limit."
                                showResetButton: false
                                throttleDraggedValues: false
                                onValueDragged: function(next) { root.setProjectCacheBudgetDraftValue("diskGiB", next) }
                            }

                            InspectorSlider {
                                objectName: "timelineCpuCacheBudgetSlider"
                                Layout.fillWidth: true
                                label: "Decoded frames"
                                from: 32
                                to: 2048
                                stepSize: 32
                                value: Number(root.projectCacheBudgetDraft.cpuMiB || 512)
                                valueText: Math.round(value) + " MB"
                                enabled: root.projectCacheBudgetDraft.automatic === false
                                disabledReason: "Switch to This Project to set a fixed CPU cache limit."
                                showResetButton: false
                                throttleDraggedValues: false
                                onValueDragged: function(next) { root.setProjectCacheBudgetDraftValue("cpuMiB", next) }
                            }

                            InspectorSlider {
                                objectName: "timelineGpuCacheBudgetSlider"
                                Layout.fillWidth: true
                                label: "GPU surfaces*"
                                from: 32
                                to: 3072
                                stepSize: 32
                                value: Number(root.projectCacheBudgetDraft.gpuMiB || 512)
                                valueText: Math.round(value) + " MB"
                                enabled: root.projectCacheBudgetDraft.automatic === false
                                disabledReason: "Switch to This Project to set a fixed GPU estimate."
                                showResetButton: false
                                throttleDraggedValues: false
                                onValueDragged: function(next) { root.setProjectCacheBudgetDraftValue("gpuMiB", next) }
                            }

                            InspectorSlider {
                                objectName: "timelineMemoryCacheBudgetSlider"
                                Layout.fillWidth: true
                                label: "Working memory"
                                from: 64
                                to: 4096
                                stepSize: 64
                                value: Number(root.projectCacheBudgetDraft.memoryMiB || 1024)
                                valueText: Math.round(value) + " MB"
                                enabled: root.projectCacheBudgetDraft.automatic === false
                                disabledReason: "Switch to This Project to set a fixed Timeline working-memory limit."
                                showResetButton: false
                                throttleDraggedValues: false
                                onValueDragged: function(next) { root.setProjectCacheBudgetDraftValue("memoryMiB", next) }
                            }

                            Label {
                                Layout.fillWidth: true
                                text: String(root.projectCacheBudgetData.pressureExplanation || "") +
                                      " *GPU usage is an estimate of active Program surfaces."
                                color: theme.textFaint
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeCaption
                                wrapMode: Text.Wrap
                            }
                        }
                    }

                    ListView {
                        id: projectCacheCategoryList
                        objectName: "timelineProjectCacheCategoryList"
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        clip: true
                        spacing: theme.space6
                        model: root.projectCacheData.categories || []
                        ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }

                        delegate: Rectangle {
                            required property var modelData
                            width: ListView.view.width
                            height: Math.max(92, cacheCategoryContent.implicitHeight + theme.space10 * 2)
                            radius: theme.radiusSurface
                            color: theme.alpha(theme.ink700, 0.30)
                            border.width: 0

                            RowLayout {
                                id: cacheCategoryContent
                                anchors.fill: parent
                                anchors.margins: theme.space10
                                spacing: theme.space10

                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: theme.space2

                                    RowLayout {
                                        Layout.fillWidth: true
                                        spacing: theme.space6

                                        Label {
                                            text: String(modelData.label || "Cache")
                                            color: theme.textStrong
                                            font.family: theme.fontUi
                                            font.pixelSize: theme.typeLabel
                                            font.weight: Font.DemiBold
                                        }

                                        Label {
                                            text: String(modelData.fileCount || 0) + " files  ·  " +
                                                  root.cacheBytesText(modelData.bytes)
                                            color: theme.textMuted
                                            font.family: theme.fontMono
                                            font.pixelSize: theme.typeCaption
                                        }

                                        Item { Layout.fillWidth: true }

                                        StatusChip {
                                            visible: modelData.busy === true || Number(modelData.sharedFileCount || 0) > 0
                                            text: modelData.busy === true
                                                  ? "Active"
                                                  : String(modelData.sharedFileCount || 0) + " shared"
                                            tone: modelData.busy === true ? "warning" : "neutral"
                                            compact: true
                                            detailText: modelData.busy === true
                                                        ? "Cleanup waits for generation to finish."
                                                        : "Referenced by another saved project and retained."
                                        }
                                    }

                                    Label {
                                        Layout.fillWidth: true
                                        text: String(modelData.detail || "")
                                        color: theme.textMuted
                                        font.family: theme.fontUi
                                        font.pixelSize: theme.typeCaption
                                        wrapMode: Text.Wrap
                                    }

                                    Label {
                                        Layout.fillWidth: true
                                        text: Number(modelData.reclaimableFileCount || 0) > 0
                                              ? root.cacheBytesText(modelData.reclaimableBytes) +
                                                " can be cleaned. " + String(modelData.rebuild || "")
                                              : (Number(modelData.fileCount || 0) > 0
                                                 ? "Nothing project-only to clean."
                                                 : "No generated files for this category yet.")
                                        color: Number(modelData.reclaimableFileCount || 0) > 0
                                               ? theme.accentCool300 : theme.textFaint
                                        font.family: theme.fontMono
                                        font.pixelSize: theme.typeCaption
                                        wrapMode: Text.Wrap
                                    }
                                }

                                ActionButton {
                                    objectName: "timelineProjectCacheCategoryToggle_" + String(modelData.key || "")
                                    text: root.projectCacheCategorySelected(modelData.key)
                                          ? "Selected" : "Include"
                                    iconName: root.projectCacheCategorySelected(modelData.key)
                                              ? "check" : "add"
                                    compact: true
                                    active: root.projectCacheCategorySelected(modelData.key)
                                    enabled: modelData.canClean === true
                                    disabledReason: modelData.busy === true
                                                    ? "Wait for this generated-media job to finish."
                                                    : "There are no project-only files in this category."
                                    onClicked: root.setProjectCacheCategorySelected(
                                                   modelData.key,
                                                   !root.projectCacheCategorySelected(modelData.key))
                                }
                            }
                        }
                    }

                    Rectangle {
                        visible: String(root.projectCacheCleanupResult.message || "").length > 0
                        Layout.fillWidth: true
                        implicitHeight: cacheCleanupResultLabel.implicitHeight + theme.space10 * 2
                        radius: theme.radiusSurface
                        color: theme.alpha(root.projectCacheCleanupResult.ok === false
                                           ? theme.warning : theme.success, 0.10)
                        border.width: 0

                        Label {
                            id: cacheCleanupResultLabel
                            anchors.fill: parent
                            anchors.margins: theme.space10
                            text: String(root.projectCacheCleanupResult.message || "")
                            color: theme.textStrong
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeCaption
                            wrapMode: Text.Wrap
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: theme.space8

                        Label {
                            Layout.fillWidth: true
                            text: root.projectCacheCleanupArmed
                                  ? "Confirm to permanently remove the selected generated files."
                                  : String(root.projectCacheSelectedCategories.length) + " categories selected"
                            color: root.projectCacheCleanupArmed ? theme.warning : theme.textFaint
                            font.family: theme.fontMono
                            font.pixelSize: theme.typeCaption
                            wrapMode: Text.Wrap
                        }

                        ActionButton {
                            objectName: "timelineRefreshProjectCacheButton"
                            text: "Refresh"
                            iconName: "reset"
                            compact: true
                            onClicked: {
                                root.projectCacheCleanupArmed = false
                                timelineDocument.refreshProjectCacheSummary()
                                root.refreshProjectCacheData(false)
                            }
                        }

                        ActionButton {
                            text: "Done"
                            compact: true
                            onClicked: projectCachePopup.close()
                        }

                        ActionButton {
                            objectName: "timelineCleanSelectedProjectCacheButton"
                            text: root.projectCacheCleanupArmed ? "Confirm Clean" : "Clean Selected"
                            iconName: "delete"
                            tone: root.projectCacheCleanupArmed ? "danger" : "primary"
                            compact: true
                            enabled: root.projectCacheSelectedCategories.length > 0
                                     && root.projectCacheData.loading !== true
                                     && root.projectCacheData.cleanupRunning !== true
                                     && root.projectCacheData.complete === true
                            disabledReason: root.projectCacheData.loading === true
                                            ? "Wait for the cache check to finish."
                                            : "Select at least one reclaimable cache category."
                            onClicked: {
                                if (!root.projectCacheCleanupArmed) {
                                    root.projectCacheCleanupArmed = true
                                    return
                                }
                                root.cleanSelectedProjectCaches()
                            }
                        }
                    }
                }
            }
        }
