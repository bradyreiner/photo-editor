    function captureProgramScopeFrame(force) {
        if (!force && timelineDocument.programScopeAnalysisBusy)
            return false
        if (!programMonitor || !programScopesPanelPresented() ||
                (!force && programScopesFrozen) || !hasPlayableSequence() ||
                fullScreenProgramActive || programComparisonActive || programTransformGestureClipId.length > 0)
            return false
        if (programScopesCaptureInProgress) {
            if (force && !sequencePlaying && !programScopesFrozen)
                programScopesPausedRefreshPending = true
            return false
        }
        programScopesCaptureInProgress = true
        programScopesPausedRefreshPending = false
        programScopesCaptureRevision += 1
        const revision = programScopesCaptureRevision
        Qt.callLater(function() {
            programMonitor.grabToImage(function(result) {
                root.programScopesCaptureInProgress = false
                if (!result || !root.programScopesPanelPresented()) {
                    if (root.programScopesPausedRefreshPending)
                        programScopesRefreshTimer.restart()
                    return
                }
                root.programScopesGrabResult = result
                timelineDocument.requestProgramScopeImageAnalysis(result.image, revision)
                if (root.programScopesPausedRefreshPending)
                    programScopesRefreshTimer.restart()
            }, Qt.size(480, 270))
        })
        return true
    }

    function publishTrackPhase(trackId, points, correlation, peak) {
        const resolvedId = String(trackId || "")
        if (resolvedId.length === 0)
            return
        const next = Object.assign({}, trackPhaseState)
        next[resolvedId] = {
            "points": points || [],
            "correlation": Math.max(-1, Math.min(1, Number(correlation || 0))),
            "peak": Math.max(0, Number(peak || 0)),
            "updatedAt": Date.now()
        }
        trackPhaseState = next
    }

    function programAudioPhaseData() {
        const keys = Object.keys(trackPhaseState)
        let selectedId = ""
        let selected = ({"points": [], "correlation": 0, "peak": 0})
        for (let index = 0; index < keys.length; ++index) {
            const candidate = trackPhaseState[keys[index]] || ({})
            if ((candidate.points || []).length > 0 &&
                    Number(candidate.peak || 0) >= Number(selected.peak || 0)) {
                selectedId = keys[index]
                selected = candidate
            }
        }
        let label = "No active stereo track"
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            if (String(sequenceTrackModel[trackIndex].trackId || "") === selectedId) {
                label = String(sequenceTrackModel[trackIndex].trackName || selectedId)
                break
            }
        }
        return {
            "points": selected.points || [],
            "correlation": Number(selected.correlation || 0),
            "trackId": selectedId,
            "trackLabel": label,
            "sourceDisclosure": "Post-processing decoded stereo · loudest active Program track"
        }
    }

    onVisibleChanged: {
        if (visible) {
            workspaceResourceIdleTimer.stop()
            workspaceResourcesHibernated = false
            schedulePausedProgramScopeRefresh()
        } else {
            workspaceResourceIdleTimer.restart()
        }
        if (!visible)
            mediaPickerRefreshTimer.stop()
        else if (mediaPickerDialog.visible && mediaPickerAssetsDirty)
            requestMediaPickerRefresh()
        root.scheduleBackgroundWorkIntentPublish()
        if (!visible) {
            adjustmentPreviewCacheTimer.stop()
            programScopesRefreshTimer.stop()
            closeTransientSurfaces()
        }
    }

    function trackTopY(trackIndex) {
        const layout = trackVerticalLayout
        if (trackIndex < 0)
            return 0
        const tops = layout.topByIndex || []
        return trackIndex < tops.length ? Number(tops[trackIndex])
                                        : Number(layout.trackBottom || 0)
    }

    property var pendingTimelineTrackReveal: null
    Timer {
        id: timelineTrackRevealTimer
        interval: 60
        onTriggered: {
            const target = root.pendingTimelineTrackReveal
            root.pendingTimelineTrackReveal = null
            if (target)
                root.ensureTimelineClipTrackVisibleSettled(target, true)
        }
    }

    function ensureTimelineClipTrackVisible(clipValue) {
        return root.ensureTimelineClipTrackVisibleSettled(clipValue, false)
    }

    function ensureTimelineClipTrackVisibleSettled(clipValue, settled) {
        const clip = clipValue !== undefined && clipValue !== null
                ? clipValue : root.currentClip
        const viewport = root.timelineViewport
        if (!clip || !viewport || Number(viewport.height || 0) <= 0)
            return false

        const trackId = String(clip.trackId || "")
        const clipId = String(clip.clipId || "")
        if (trackId.length === 0 && clipId.length === 0)
            return false
        if (settled !== true) {
            root.pendingTimelineTrackReveal = {trackId: trackId, clipId: clipId}
            timelineTrackRevealTimer.restart()
        }

        // A seek or horizontal jump can change the filtered row projection.
        // Resolve its current prefix layout before choosing a vertical offset.
        root.refreshTimelineTrackWindow()
        const tracks = root.sequenceTrackModel || []
        const layout = root.trackVerticalLayout || ({})
        const tops = layout.topByIndex || []
        const hidden = layout.hiddenByIndex || []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const track = tracks[trackIndex]
            if (!track)
                continue
            const matchesTrack = trackId.length > 0
                    && String(track.trackId || "") === trackId
            const clips = track.clips || []
            let containsClip = false
            if (!matchesTrack && clipId.length > 0) {
                for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                    if (String(clips[clipIndex] && clips[clipIndex].clipId || "") === clipId) {
                        containsClip = true
                        break
                    }
                }
            }
            if (!matchesTrack && !containsClip)
                continue
            if (hidden[trackIndex] === true)
                return false

            const selectedTrackId = String(track.trackId || trackId)
            const trackTop = Number(tops[trackIndex] || 0)
            const trackBottom = trackTop + root.trackHeight(selectedTrackId)
            const viewportTop = Number(viewport.contentY || 0)
            const viewportHeight = Math.max(0, Number(viewport.height || 0)
                    - root.timelineViewportBottomInset)
            const viewportBottom = viewportTop + viewportHeight
            if (trackTop >= viewportTop && trackBottom <= viewportBottom)
                return false

            const desiredTop = trackTop < viewportTop
                    ? trackTop : trackBottom - viewportHeight
            const maximumTop = Math.max(0, Number(viewport.contentHeight || 0)
                    + Number(viewport.bottomMargin || 0) - Number(viewport.height || 0))
            viewport.contentY = Math.max(0, Math.min(maximumTop, desiredTop))
            return true
        }
        return false
    }

    function totalTrackHeight() {
        return Number(trackVerticalLayout.totalHeight || defaultLaneHeight + trackSpacing)
    }
    readonly property var resolutionPresetLabels: [
        "1080 x 1350",
        "1920 x 1080",
        "3840 x 2160",
        "1080 x 1920",
        "1080 x 1080",
        "Custom"
    ]

    // Serialize strip decoding so pointer previews never sit behind a whole
    // viewport of ffmpeg jobs. Only materialized, visible tiles enqueue work.
    property var filmstripFrameQueue: []
    property var filmstripFrameInFlight: ({})
    signal filmstripFrameReady(string requestId, real seconds, string source)

    function cancelFilmstripFrame(requestId) {
        filmstripFrameQueue = filmstripFrameQueue.filter(request => request.id !== requestId)
    }

    function requestFilmstripFrame(requestId, source, seconds) {
        cancelFilmstripFrame(requestId)
        const next = filmstripFrameQueue.slice()
        next.push({id: requestId, source: source, seconds: Math.round(seconds * 1000) / 1000})
        filmstripFrameQueue = next
        Qt.callLater(pumpFilmstripFrames)
    }

    function pumpFilmstripFrames() {
        if (!root.visible || filmstripFrameInFlight.id || filmstripFrameQueue.length === 0) return
        const request = filmstripFrameQueue[0]
        filmstripFrameQueue = filmstripFrameQueue.slice(1)
        filmstripFrameInFlight = request
        const cached = documentController.requestMediaPreviewFrame(request.id, request.source, request.seconds, 320, 180)
        if (String(cached || "").length > 0) {
            finishFilmstripFrame(request.id, request.seconds, String(cached))
        } else if (filmstripFrameInFlight.id === request.id) {
            filmstripFrameTimeout.restart()
        }
    }

    function finishFilmstripFrame(requestId, seconds, source) {
        if (filmstripFrameInFlight.id !== requestId || Math.abs(filmstripFrameInFlight.seconds - seconds) > 0.0001) return
        filmstripFrameTimeout.stop()
        filmstripFrameInFlight = ({})
        root.filmstripFrameReady(requestId, seconds, source)
        Qt.callLater(pumpFilmstripFrames)
    }

    Timer {
        id: filmstripFrameTimeout
        interval: 6500
        onTriggered: root.finishFilmstripFrame(root.filmstripFrameInFlight.id, root.filmstripFrameInFlight.seconds, "")
    }

    Connections {
        target: root.documentController
        function onMediaHoverFrameReady(requestId, seconds, source) { root.finishFilmstripFrame(requestId, seconds, source) }
        function onMediaPreviewFrameFailed(requestId, seconds) { root.finishFilmstripFrame(requestId, seconds, "") }
    }

    component TimelineFilmstripFrame: Image {
        id: frameTile
        required property string requestId
        required property string videoSource
        required property real sourceSeconds
        required property bool isVideo
        property string fallbackSource: ""
        property string decodedSource: ""
        property bool failedFrame: false
        readonly property real sampleSeconds: Math.round(Math.max(0, sourceSeconds) * 1000) / 1000
        readonly property bool frameActive: root.visible && visible && isVideo && videoSource.length > 0
        readonly property bool frameReady: decodedSource.length > 0 && status === Image.Ready
        objectName: "timelineFilmstripFrame"
        source: isVideo ? decodedSource : fallbackSource
        sourceSize: Qt.size(Math.max(1, Math.ceil(width * Screen.devicePixelRatio)),
                            Math.max(1, Math.ceil(height * Screen.devicePixelRatio)))
        fillMode: Image.PreserveAspectFit
        asynchronous: true
        cache: true
        function refreshFrame() {
            decodedSource = ""
            failedFrame = false
            root.cancelFilmstripFrame(requestId)
            if (frameActive) requestDelay.restart()
        }
        Component.onCompleted: refreshFrame()
        Component.onDestruction: root.cancelFilmstripFrame(requestId)
        onRequestIdChanged: refreshFrame()
        onVideoSourceChanged: refreshFrame()
        onSampleSecondsChanged: refreshFrame()
        onFrameActiveChanged: refreshFrame()
        Timer {
            id: requestDelay
            interval: 80
            onTriggered: if (frameTile.frameActive)
                root.requestFilmstripFrame(frameTile.requestId, frameTile.videoSource, frameTile.sampleSeconds)
        }
        Connections {
            target: root
            function onFilmstripFrameReady(requestId, seconds, source) {
                if (frameTile.frameActive && requestId === frameTile.requestId && Math.abs(seconds - frameTile.sampleSeconds) < 0.0001) {
                    frameTile.decodedSource = source
                    frameTile.failedFrame = source.length === 0
                }
            }
        }
        Rectangle { anchors.fill: parent; color: theme.mediaCanvas; z: -1 }
        Label {
            anchors.centerIn: parent
            visible: frameTile.isVideo && !frameTile.frameReady
            text: frameTile.failedFrame ? "!" : "…"
            color: theme.textMuted
        }
    }

    component TrimPreviewFrame: Rectangle {
        id: trimFrame

        required property var frameData
        required property string roleLabel

        readonly property bool hasFrame: frameData && frameData.valid === true
        readonly property bool isVideo: hasFrame && String(frameData.mediaType || "") === "video"
        readonly property string frameSourceUrl: hasFrame ? String(frameData.sourceUrl || "") : ""
        readonly property real frameSourceSeconds: hasFrame ? Number(frameData.sourceSeconds || 0) : 0
        property string decodedFrameSource: ""
        property bool pendingFrame: false
        property int decodeWidth: 960
        property int decodeHeight: 540
        readonly property bool frameReady: decodedFrameSource.length > 0 && decodedImage.status === Image.Ready
        readonly property string frameRequestId: "trim:" + String(frameData ? frameData.clipId || "" : "")
            + "|" + frameSourceUrl + "|" + roleLabel
        readonly property real requestedSeconds: Math.max(0, Math.round(frameSourceSeconds * 1000) / 1000)

        color: theme.mediaCanvas
        radius: theme.radius4
        clip: true

        function syncFrame() {
            decodedFrameSource = ""
            pendingFrame = false
            frameTimeout.stop()
            if (!visible || !isVideo || frameSourceUrl.length === 0)
                return
            pendingFrame = true
            const cached = root.documentController.requestMediaPreviewFrame(
                frameRequestId, frameSourceUrl, requestedSeconds, decodeWidth, decodeHeight)
            if (String(cached || "").length > 0) {
                decodedFrameSource = String(cached)
                pendingFrame = false
            } else {
                frameTimeout.restart()
            }
        }

        onFrameDataChanged: Qt.callLater(syncFrame)
        onFrameSourceUrlChanged: Qt.callLater(syncFrame)
        onFrameSourceSecondsChanged: Qt.callLater(syncFrame)
        onRoleLabelChanged: Qt.callLater(syncFrame)
        onVisibleChanged: Qt.callLater(syncFrame)

        Timer {
            id: frameTimeout
            interval: 6000
            onTriggered: trimFrame.pendingFrame = false
        }

        Connections {
            target: root.documentController
            function onMediaHoverFrameReady(assetId, seconds, source) {
                if (!trimFrame.visible || !trimFrame.isVideo || assetId !== trimFrame.frameRequestId
                        || Math.abs(seconds - trimFrame.requestedSeconds) > 0.0001)
                    return
                trimFrame.decodedFrameSource = source
