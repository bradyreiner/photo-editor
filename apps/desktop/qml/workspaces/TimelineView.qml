    function programClipHasEnabledEffects() {
        if (!programClip || programClip.effectsEnabled === false || !programClip.effectDetails)
            return false
        for (let index = 0; index < programClip.effectDetails.length; ++index) {
            const effect = programClip.effectDetails[index]
            if (effect && effect.enabled !== false && Number(effect.amount || effect.baseAmount || 0) !== 0)
                return true
        }
        return false
    }

    function grabCleanProgramComparisonFrame(callback) {
        if (!programComparisonActive || programComparisonCaptureInProgress)
            return false
        programComparisonCaptureInProgress = true
        Qt.callLater(function() {
            const captureWidth = Math.max(1, Math.min(1920, Math.round(programMonitor.width)))
            const captureHeight = Math.max(1, Math.min(1080, Math.round(programMonitor.height)))
            programMonitor.grabToImage(function(result) {
                root.programComparisonCaptureInProgress = false
                if (result && callback)
                    callback(result)
            }, Qt.size(captureWidth, captureHeight))
        })
        return true
    }

    function persistProgramComparisonGrab(result, role) {
        if (!result)
            return ""
        programComparisonCaptureRevision += 1
        const path = timelineDocument.programComparisonCapturePath(
            String(role || "frame"), programComparisonCaptureRevision)
        if (String(path || "").length === 0)
            return ""
        return result.saveToFile(path) ? path : ""
    }

    function updateProgramComparisonDifference() {
        if (programComparisonCurrentFilePath.length === 0 ||
                programComparisonReferenceFilePath.length === 0)
            return false
        const result = timelineDocument.renderProgramComparisonDifference(
            programComparisonCurrentFilePath,
            programComparisonReferenceFilePath,
            programComparisonDifferenceGain)
        programComparisonDifferenceData = result || ({})
        programComparisonDifferenceSource = result && result.success === true
                                            ? String(result.url || "") : ""
        return result && result.success === true
    }

    function refreshProgramComparisonCurrentFrame() {
        return grabCleanProgramComparisonFrame(function(result) {
            root.programComparisonCurrentGrabResult = result
            root.programComparisonCurrentSource = result.url
            root.programComparisonCurrentFilePath =
                root.persistProgramComparisonGrab(result, "current")
            root.updateProgramComparisonDifference()
        })
    }

    function captureProgramComparisonReference() {
        programComparisonBypassEffects = false
        return grabCleanProgramComparisonFrame(function(result) {
            root.programComparisonReferenceGrabResult = result
            root.programComparisonCurrentGrabResult = result
            root.programComparisonReferenceSource = result.url
            root.programComparisonCurrentSource = result.url
            root.programComparisonReferenceFilePath =
                root.persistProgramComparisonGrab(result, "reference")
            root.programComparisonCurrentFilePath = root.programComparisonReferenceFilePath
            root.programComparisonReferenceKind = "captured-program"
            root.programComparisonReferenceLabel = "Captured Program"
            root.programComparisonReferenceSeconds = root.sequencePlayheadSeconds
        })
    }

    function useProgramComparisonVersion(index) {
        const boundedIndex = Math.max(0, Math.min(programComparisonVersionRecords.length - 1,
                                                  Number(index)))
        const record = programComparisonVersionRecords[boundedIndex]
        if (!record || record.comparisonMediaAvailable !== true ||
                String(record.comparisonMediaUrl || "").length === 0)
            return false
        programComparisonBypassEffects = false
        programComparisonReferenceGrabResult = null
        programComparisonReferenceSource = String(record.comparisonMediaUrl)
        programComparisonReferenceFilePath = String(record.comparisonMediaPath || "")
        programComparisonReferenceKind = "previous-version"
        programComparisonReferenceLabel = "Version · " + String(record.label || "Saved")
        programComparisonReferenceSeconds = Number(record.comparisonFrameSeconds || 0)
        refreshProgramComparisonCurrentFrame()
        return true
    }

    function useProgramComparisonReferenceStill(sourceUrl) {
        if (String(sourceUrl || "").length === 0)
            return false
        programComparisonBypassEffects = false
        programComparisonReferenceGrabResult = null
        programComparisonReferenceSource = sourceUrl
        programComparisonReferenceFilePath = String(sourceUrl)
        programComparisonReferenceKind = "reference-still"
        programComparisonReferenceLabel = "Reference Still"
        programComparisonReferenceSeconds = sequencePlayheadSeconds
        refreshProgramComparisonCurrentFrame()
        return true
    }

    function beginProgramEffectsComparison() {
        if (!programClipHasEnabledEffects() || renderCacheActive)
            return false
        programComparisonBypassEffects = false
        return grabCleanProgramComparisonFrame(function(result) {
            root.programComparisonReferenceGrabResult = result
            root.programComparisonReferenceSource = result.url
            root.programComparisonReferenceFilePath =
                root.persistProgramComparisonGrab(result, "effects-after")
            root.programComparisonReferenceKind = "effects-after"
            root.programComparisonReferenceLabel = "After Effects"
            root.programComparisonReferenceSeconds = root.sequencePlayheadSeconds
            root.programComparisonBypassEffects = true
            root.programComparisonMode = "wipe"
            Qt.callLater(function() { root.refreshProgramComparisonCurrentFrame() })
        })
    }

    function openProgramComparison(invoker) {
        if (!hasPlayableSequence())
            return false
        if (programComparisonActive) {
            programComparisonWindow.show()
            programComparisonWindow.raise()
            programComparisonWindow.requestActivate()
            return true
        }
        closeTransientSurfaces()
        timelineDocument.pauseSequence()
        programComparisonFocusReturnItem = invoker || (root.Window.window
                                            ? root.Window.window.activeFocusItem : timelineViewport)
        programComparisonMode = "wipe"
        programComparisonWipePosition = 0.5
        programComparisonOverlayOpacity = 0.5
        programComparisonDifferenceGain = 2.0
        programComparisonBypassEffects = false
        programComparisonVersionRecords = timelineDocument.sequenceVersions
        const hostWindow = root.Window.window
        if (hostWindow && hostWindow.activeFocusItem)
            hostWindow.activeFocusItem.focus = false
        programComparisonActive = true
        programComparisonWindow.show()
        programComparisonWindow.raise()
        programComparisonWindow.requestActivate()
        Qt.callLater(function() { root.captureProgramComparisonReference() })
        return true
    }

    function closeProgramComparison() {
        if (!programComparisonActive)
            return false
        programComparisonCaptureInProgress = false
        programComparisonBypassEffects = false
        const activeWindow = programComparisonWindow
        if (activeWindow && activeWindow.activeFocusItem)
            activeWindow.activeFocusItem.focus = false
        programComparisonActive = false
        programComparisonWindow.hide()
        programComparisonReferenceGrabResult = null
        programComparisonCurrentGrabResult = null
        programComparisonReferenceSource = ""
        programComparisonCurrentSource = ""
        programComparisonDifferenceSource = ""
        programComparisonReferenceFilePath = ""
        programComparisonCurrentFilePath = ""
        programComparisonDifferenceData = ({})
        programComparisonReferenceKind = ""
        programComparisonReferenceLabel = "No reference"
        if (programComparisonFocusReturnItem)
            programComparisonFocusReturnItem.forceActiveFocus()
        programComparisonFocusReturnItem = null
        return true
    }

    function openProgramScopes(detached) {
        if (!hasPlayableSequence())
            return false
        programScopesDetached = detached === true
        programScopesVisible = true
        programScopesFrozen = false
        Qt.callLater(function() { root.captureProgramScopeFrame(true) })
        return true
    }

    function closeProgramScopes() {
        if (!programScopesVisible)
            return false
        programScopesVisible = false
        return true
    }

    function setProgramSourceGangEnabled(enabled) {
        if (enabled !== true) {
            programSourceGangEnabled = false
            timelineDocument.clearProgramSourceGangState()
            return true
        }
        if (!hasPlayableSequence())
            return false
        programSourceGangEnabled = true
        sourceRailTab = "source"
        sourcePanelHidden = false
        sourcePanelCollapsed = false
        synchronizeGangedSourceToProgram()
        return true
    }

    function synchronizeGangedSourceToProgram() {
        if (!programSourceGangEnabled || !hasPlayableSequence())
            return false
        const result = timelineDocument.synchronizeSourceToProgram(
                    Number(sequencePlayheadSeconds || 0))
        return result.matched === true
    }

    function seekProgramFromGangedSource(sourceSeconds) {
        if (!programSourceGangEnabled)
            return false
        const result = timelineDocument.gangedProgramPositionForSource(
                    Number(sourceSeconds || 0))
        if (result.matched !== true)
            return false
        timelinePlayback.pause()
        timelinePlayback.seekSequenceSeconds(Number(result.sequenceSeconds || 0))
        programSourceGangPausedSyncTimer.restart()
        return result.frameExact === true
    }

    function toggleProgramScopesDetached() {
        if (!programScopesVisible)
            return openProgramScopes(true)
        programScopesDetached = !programScopesDetached
        if (programScopesDetached) {
            programScopesWindow.show()
            programScopesWindow.raise()
            programScopesWindow.requestActivate()
        }
        return true
    }

    function captureProgramScopeFrame(force) {
        if (!programScopesVisible || programScopesCaptureInProgress ||
                (!force && programScopesFrozen) || !hasPlayableSequence() ||
                fullScreenProgramActive || programComparisonActive)
            return false
        programScopesCaptureInProgress = true
        programScopesCaptureRevision += 1
        const revision = programScopesCaptureRevision
        Qt.callLater(function() {
            programMonitor.grabToImage(function(result) {
                root.programScopesCaptureInProgress = false
                if (!result || !root.programScopesVisible)
                    return
                root.programScopesGrabResult = result
                const path = timelineDocument.programComparisonCapturePath("scopes", revision)
                if (String(path || "").length === 0 || !result.saveToFile(path))
                    return
                timelineDocument.requestProgramScopeAnalysis(path, revision)
            }, Qt.size(480, 270))
        })
        return true
    }

    function publishTrackPhase(trackId, points, correlation, peak) {
        const resolvedId = String(trackId || "")
        if (resolvedId.length === 0)
            return
        const next = Object.assign({}, trackPhaseState)
        next[resolvedId] = {
            "points": points || [],
            "correlation": Math.max(-1, Math.min(1, Number(correlation || 0))),
            "peak": Math.max(0, Number(peak || 0)),
            "updatedAt": Date.now()
        }
        trackPhaseState = next
    }

    function programAudioPhaseData() {
        const keys = Object.keys(trackPhaseState)
        let selectedId = ""
        let selected = ({"points": [], "correlation": 0, "peak": 0})
        for (let index = 0; index < keys.length; ++index) {
            const candidate = trackPhaseState[keys[index]] || ({})
            if ((candidate.points || []).length > 0 &&
                    Number(candidate.peak || 0) >= Number(selected.peak || 0)) {
                selectedId = keys[index]
                selected = candidate
            }
        }
        let label = "No active stereo track"
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            if (String(sequenceTrackModel[trackIndex].trackId || "") === selectedId) {
                label = String(sequenceTrackModel[trackIndex].trackName || selectedId)
                break
            }
        }
        return {
            "points": selected.points || [],
            "correlation": Number(selected.correlation || 0),
            "trackId": selectedId,
            "trackLabel": label,
            "sourceDisclosure": "Post-processing decoded stereo · loudest active Program track"
        }
    }

    onVisibleChanged: {
        root.scheduleBackgroundWorkIntentPublish()
        if (!visible)
            closeTransientSurfaces()
    }

    function trackTopY(trackIndex) {
        let y = rulerHeight
        for (let i = 0; i < trackIndex; i++) {
            const track = sequenceTrackModel[i]
            y += trackHeight(track ? track.trackId : "") + trackSpacing
        }
        return y
    }

    function totalTrackHeight() {
        let total = rulerHeight
        for (let i = 0; i < Math.max(1, sequenceTrackModel.length); i++) {
            const track = sequenceTrackModel[i]
            total += (track ? trackHeight(track.trackId) : defaultLaneHeight) + trackSpacing
        }
        return total
    }
