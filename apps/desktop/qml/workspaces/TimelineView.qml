                                        {
                                            "key": "duplicate",
                                            "label": "Duplicate snapshot",
                                            "icon": "copy",
                                            "tooltip": "Create a new named version from this exact snapshot."
                                        },
                                        {
                                            "key": "protect",
                                            "label": modelData.protected === true
