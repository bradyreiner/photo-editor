            timelineDocument.selectClip(timelineDocument.currentIndex)
            timelinePlayback.seekSequenceSeconds(splitSeconds)
        }
        timelinePlayback.pause()
        if (timelineDocument.splitSelectedClipsAtSequenceSeconds(splitSeconds) > 0)
            timelinePlayback.seekSequenceSeconds(splitSeconds)
    }

