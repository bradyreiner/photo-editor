    Connections {
        target: appShell

        function onTimelineDefaultsChanged() {
            root.snappingEnabled = appShell.defaultTimelineSnapping
            root.rippleModeEnabled = appShell.defaultTimelineRipple
        }

        function onTimelineWorkspaceSettingsReset() {
            root.restoreDefaultLayout()
        }
    }

    Connections {
        target: timelineDocument

        function onTimelineStateChanged() {
            if (!timelineDocument.hasActiveTimeline) {
                root.timelineViewportStateRestored = false
                root.closeTransientSurfaces()
                root.sourcePanelDetached = false
                root.effectsPanelDetached = false
                root.beginTimelineSetup()
            } else if (!root.timelineViewportStateRestored) {
                Qt.callLater(root.restoreTimelineViewportState)
            }
        }

        function onSelectionChanged() {
            // QVariantMap-valued controller properties can retain their
            // previous JS wrapper even after the shared notify signal fires.
            // Refresh the map explicitly so Program and Inspector content
            // follow the controller selection immediately.
            root.currentClip = timelineDocument.currentClip
            root.programClip = timelineDocument.programClip
            root.restoreInspectorTabForSelection()
            root.scheduleBackgroundWorkIntentPublish()
            if (root.keyboardTrimEdge.length > 0)
                root.editPointData = timelineDocument.selectedEditPointInfo(root.keyboardTrimEdge)
            if (timelineDocument.currentIndex >= 0 && root.width >= 1180) {
                root.effectsPanelCollapsed = false
                root.workspaceFocus = "timeline"
            }
        }

        function onPlaybackStateChanged() {
            // Refresh only the selected clip map. Background layers evaluate
            // their exposed keyframe tracks directly from the shared playhead.
            root.currentClip = timelineDocument.currentClip
            root.programClip = timelineDocument.programClip
            root.scheduleBackgroundWorkIntentPublish()
            if (root.programComparisonActive && !root.sequencePlaying)
                programComparisonRefreshTimer.restart()
        }

        function onSequenceChanged() {
            root.scheduleBackgroundWorkIntentPublish()
            if (root.hasAnyAdjustmentClips())
                adjustmentPreviewCacheTimer.restart()
        }

        function onSequenceVersionsChanged() {
            if (root.programComparisonActive)
                root.programComparisonVersionRecords = timelineDocument.sequenceVersions
            if (sequenceVersionsPopup.visible) {
                root.sequenceVersionRecords = timelineDocument.sequenceVersions
                if (root.sequenceVersionCompareData
                        && root.sequenceVersionCompareData.versionId) {
                    root.sequenceVersionCompareData = timelineDocument.sequenceVersionComparison(
                        String(root.sequenceVersionCompareData.versionId))
                }
            }
        }

        function onRecoveryCandidatesChanged() {
            root.recoveryCandidateRecords = timelineDocument.recoveryCandidates
            if (timelineRecoveryPopup.visible && root.recoveryCandidateRecords.length === 0)
                timelineRecoveryPopup.close()
        }

        function onLoudnessAnalysisChanged() {
            if (deliveryPreflightPopup.visible)
                root.deliveryPreflightData = timelineDocument.timelineDeliveryPreflight()
            if (publishPopup.visible)
                root.publishData = timelineDocument.timelinePublishSummary()
        }

        function onCacheBudgetStateChanged() {
            if (projectCachePopup.visible)
                root.refreshProjectCacheBudgetData(false)
        }
    }

    Connections {
        target: timelinePlayback

        function onRuntimeRecoveryRequested(kind) {
            root.runtimeRecoveryFeedbackVisible = true
            runtimeRecoveryFeedbackTimer.restart()
            if (kind === "external-display") {
                Qt.callLater(root.restoreDetachedSourceGeometry)
                Qt.callLater(root.restoreDetachedInspectorGeometry)
            }
        }

        function onStateChanged() {
            if (!root.sequencePlaying || timelinePlayback.usingRenderCache)
                return
            root.publishTrackMeter(
                        String(root.programClip.audioTrackId || ""),
                        Number(timelinePlayback.audioPeakLeft || 0),
                        Number(timelinePlayback.audioPeakRight || 0),
                        Number(timelinePlayback.audioTruePeakLeft || 0),
                        Number(timelinePlayback.audioTruePeakRight || 0),
                        Number(timelinePlayback.audioRmsLeft || 0),
                        Number(timelinePlayback.audioRmsRight || 0),
                        timelinePlayback.audioClipping === true)
        }
    }

    Timer {
        id: runtimeRecoveryFeedbackTimer
        interval: 5000
        repeat: false
        onTriggered: root.runtimeRecoveryFeedbackVisible = false
    }

    Connections {
        target: catalogAssets

        function onAssetCountChanged() {
            if (mediaPickerDialog.visible)
                root.refreshMediaPickerAssets()
        }

        function onTotalAssetCountChanged() {
            if (mediaPickerDialog.visible)
