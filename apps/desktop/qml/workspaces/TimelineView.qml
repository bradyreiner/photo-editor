                                tooltipText: "Copy, align, distribute, scale, or change timing for selected keyframes."
                                menuWidth: 272
                                menuItems: [
                                    {"key": "copy-selection", "label": "Copy selected keyframes", "iconName": "copy",
                                     "enabled": root.curveEditorParameter !== "sourceTime"
