    function programSceneImageSource(clip) {
        if (clip && clip.sceneAttachmentEnabled === true
                && clip.mediaType === "photo" && clip.mediaOnline !== false
                && String(clip.filePath || "").length > 0)
            return String(clip.filePath)
        return safePosterSource(clip)
