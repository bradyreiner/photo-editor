                backgroundJobsPopup.close()
                Qt.callLater(function() { timelineViewport.forceActiveFocus() })
            }
            return
        }
        const affectedType = String(job.affectedType || "")
        const affectedId = String(job.affectedId || "")
        if (affectedType === "import-source") {
            appShell.revealPath(String(job.affectedPath || affectedId))
            return
        }
        const catalogId = affectedType === "timeline"
                          ? "timeline:" + affectedId : affectedId
        if (catalogId.length > 0 && catalogAssets.selectAssetById(catalogId, true)) {
            const libraryIndex = appShell.workspaceNames.indexOf("Library")
            if (libraryIndex >= 0)
                appShell.currentWorkspace = libraryIndex
            backgroundJobsPopup.close()
            return
        }
        if (String(job.affectedPath || "").length > 0)
            appShell.revealPath(String(job.affectedPath || ""))
    }

