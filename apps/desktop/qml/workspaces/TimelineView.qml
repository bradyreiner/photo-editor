    function toggleProgramScopesDetached() {
        if (!programScopesVisible)
            return openProgramScopes(true)
        const shouldDetach = !programScopesDetached
        if (shouldDetach)
            programScopesWindow.contentRequested = true
        programScopesDetached = shouldDetach
        if (shouldDetach) {
