    function toggleSourcePanel() {
        if (panelDockingReady) {
            if (panelDockState.visible("media") || panelDockState.visible("source")) {
                panelDockState.setVisible("media", false)
                panelDockState.setVisible("source", false)
            } else {
                showTimelinePanel(sourceRailTab === "source" ? "source" : "media")
            }
            syncTimelinePanelState()
            return
        }
        const shouldOpen = sourcePanelHidden || sourcePanelCollapsed
        sourcePanelHidden = false
        sourcePanelCollapsed = !shouldOpen
    }

    function toggleEffectsPanel() {
        if (panelDockingReady) {
            if (panelDockState.visible("inspector")) closeTimelinePanel("inspector")
            else showTimelinePanel("inspector")
            return
        }
        effectsPanelCollapsed = !effectsPanelCollapsed
    }

