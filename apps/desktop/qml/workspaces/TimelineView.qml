    function reviewApprovalLabel(state) {
        const normalized = String(state || "open")
        if (normalized === "changes-requested") return "Changes requested"
        if (normalized === "approved") return "Approved"
        return "Open"
    }

    function reviewApprovalTone(state, resolved) {
        if (resolved) return "neutral"
        const normalized = String(state || "open")
        if (normalized === "approved") return "success"
        if (normalized === "changes-requested") return "warning"
        return "info"
    }

    function reviewNoteMatches(note) {
        if (root.reviewNotesFilter === "all") return true
        if (root.reviewNotesFilter === "resolved") return Boolean(note.completed)
        if (Boolean(note.completed)) return false
        return String(note.approvalState || "open") === root.reviewNotesFilter
    }

    function markerAccentColor(marker) {
        if (marker && marker.completed)
            return theme.accentCool400
        const status = markerStatusLabel(marker ? marker.status : "", false)
        if (status === "review")
            return theme.warning
        if (status === "approved")
            return theme.accentCool400
        if (status === "exported")
            return theme.accentCool500
        return marker && marker.color ? marker.color : theme.markerAccent
    }

    function markerStatusTone(marker) {
        const status = markerStatusLabel(marker ? marker.status : "", marker ? marker.completed : false)
        if (status === "done" || status === "approved" || status === "exported")
            return "success"
        if (status === "review")
            return "warning"
        return "accent"
    }

    function markerMatchesFilters(marker) {
        if (!marker)
            return false
        if (!root.timelineSearchActive)
            return true
        return root.timelineSearchMatchIds["marker:" + String(marker.markerId)] === true
    }

    function clipMatchesSearch(clip) {
        if (!root.timelineSearchActive)
            return true
        if (!clip)
            return false
        return root.timelineSearchMatchIds["clip:" + String(clip.clipId)] === true
    }

    function timelineSearchFilterLabel() {
        const labels = {
            "all": "Filter",
            "clips": "Clips",
            "markers": "Markers",
            "video": "Video",
            "audio": "Audio",
            "photo": "Photos",
            "title": "Titles",
            "caption": "Captions",
            "offline": "Offline",
            "effects": "Effects"
        }
        const label = labels[root.timelineSearchKind] || "Filter"
        return root.timelineSearchTrackScope === "selected" ? label + " · Track" : label
    }

    function timelineSearchFilterMenuItems() {
        return [
            {key: "kind-all", label: "Everything", checked: root.timelineSearchKind === "all"},
            {key: "kind-clips", label: "All Clips", checked: root.timelineSearchKind === "clips"},
            {key: "kind-markers", label: "Markers", checked: root.timelineSearchKind === "markers"},
            {key: "kind-video", label: "Video", checked: root.timelineSearchKind === "video", separatorBefore: true},
            {key: "kind-audio", label: "Audio", checked: root.timelineSearchKind === "audio"},
            {key: "kind-photo", label: "Photos", checked: root.timelineSearchKind === "photo"},
            {key: "kind-title", label: "Titles", checked: root.timelineSearchKind === "title"},
            {key: "kind-caption", label: "Captions", checked: root.timelineSearchKind === "caption"},
            {key: "kind-offline", label: "Offline Media", checked: root.timelineSearchKind === "offline", separatorBefore: true},
            {key: "kind-effects", label: "Clips with Effects", checked: root.timelineSearchKind === "effects"},
            {key: "scope-all", label: "All Tracks", checked: root.timelineSearchTrackScope === "all", separatorBefore: true},
            {
                key: "scope-selected",
                label: "Selected Track",
                checked: root.timelineSearchTrackScope === "selected",
                enabled: Boolean(root.currentClip && root.currentClip.trackId),
                disabledReason: "Select a clip on the track you want to search."
            }
        ]
    }

    function handleTimelineSearchFilterAction(key) {
        if (key.indexOf("kind-") === 0)
            root.timelineSearchKind = key.substring(5)
        else if (key === "scope-all")
            root.timelineSearchTrackScope = "all"
        else if (key === "scope-selected")
            root.timelineSearchTrackScope = "selected"
        root.timelineSearchCursorResultId = ""
    }

    function keyframesForClipParameter(clip, parameter) {
        const source = clip && clip.keyframes ? clip.keyframes : []
        let values = []
        for (let index = 0; index < source.length; ++index) {
            if (String(source[index].parameter || "") === parameter)
                values.push(source[index])
        }
        values.sort(function(left, right) { return Number(left.seconds || 0) - Number(right.seconds || 0) })
        return values
    }

    function sequencePlayheadWithinClip(clip) {
        if (!clip)
            return false
        const start = Number(clip.startSeconds || 0)
        const duration = Math.max(0, Number(clip.trimmedDurationSeconds || 0))
        return sequencePlayheadSeconds >= start
                && sequencePlayheadSeconds < start + duration
    }

    function clipHasKeyframeAtPlayhead(clip, parameter) {
        if (!sequencePlayheadWithinClip(clip))
            return false
        const localSeconds = sequencePlayheadSeconds - Number(clip.startSeconds || 0)
        const tolerance = 0.5 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const keyframes = keyframesForClipParameter(clip, parameter)
        for (let index = 0; index < keyframes.length; ++index) {
            if (Math.abs(Number(keyframes[index].seconds || 0) - localSeconds) <= tolerance)
                return true
        }
        return false
    }

    function clipQuickKeyframeParameter(clip) {
        return clip && clip.trackKind === "audio" ? "audioGainDb" : "frameScale"
    }

    function toggleClipKeyframeAtPlayhead(clip) {
        if (!clip || (clip.trackKind !== "video" && clip.trackKind !== "audio")
                || !sequencePlayheadWithinClip(clip))
            return false
        timelinePlayback.pause()
        timelineDocument.selectClip(Number(clip.index))
        const parameter = clipQuickKeyframeParameter(clip)
        curveEditorParameter = parameter
        timelineDocument.toggleSelectedClipKeyframe(parameter)
        keyframeLanesVisible = true
        const trackId = String(clip.trackId || "")
        if (trackId.length > 0)
            setTrackHeight(trackId, Math.max(92, trackHeight(trackId)))
        return true
    }

    function clipHasPerspective(clip) {
        if (!clip)
            return false
        return Math.abs(Number(clip.baseFramePerspectiveX || 0)) > 0.000001
                || Math.abs(Number(clip.baseFramePerspectiveY || 0)) > 0.000001
                || keyframesForClipParameter(clip, "framePerspectiveX").length > 0
                || keyframesForClipParameter(clip, "framePerspectiveY").length > 0
    }

    function sceneProjectionSequenceSecondsFor(clip) {
        const attachment = clip && clip.sceneAttachment ? clip.sceneAttachment : ({})
        let seconds = Number(sequencePlayheadSeconds || 0)
        const programSource = timelineDocument.programClip || ({})
        const processedFrameTimestampUs = Number(timelinePlayback.processedFrameTimestampUs)
        if (String(attachment.sourceClipId || "") === String(programSource.clipId || "")
                && (!Number.isFinite(processedFrameTimestampUs) || processedFrameTimestampUs < 0))
            return NaN
        if (String(attachment.sourceClipId || "") === String(programSource.clipId || "")
                && Number.isFinite(processedFrameTimestampUs) && processedFrameTimestampUs >= 0) {
            const playbackRate = Number(programSource.playbackRate || 1)
            const sourceStartSeconds = Number(programSource.startSeconds || 0)
            const sourceTrimStartSeconds = Number(programSource.trimStartSeconds || 0)
            if (Number.isFinite(playbackRate) && playbackRate > 0
                    && Number.isFinite(sourceStartSeconds) && Number.isFinite(sourceTrimStartSeconds))
                seconds = sourceStartSeconds
                        + (processedFrameTimestampUs / 1000000 - sourceTrimStartSeconds) / playbackRate
        }
        return seconds
    }

    function sceneOcclusionFrameFor(clip) {
        if (!clip || clip.sceneAttachmentEnabled !== true || !clip.sceneAttachment)
            return ({"enabled": false, "ready": false})
        const seconds = sceneProjectionSequenceSecondsFor(clip)
        if (!Number.isFinite(seconds))
            return ({"enabled": clip.sceneAttachment.occlusionEnabled === true,
                     "ready": false, "error": "Waiting for the source frame timestamp."})
        return timelineDocument.sceneAttachmentOcclusionFrame(String(clip.clipId || ""), seconds)
    }

    function sceneProjectionQuadFor(clip) {
        if (clip && clip.sceneAttachmentEnabled === true
                && clip.sceneAttachmentReady === true) {
            const attachment = clip.sceneAttachment || ({})
            const samples = attachment.samples || []
            const seconds = sceneProjectionSequenceSecondsFor(clip)
            if (!Number.isFinite(seconds))
                return []
            if (samples.length > 0) {
                let before = null
                let after = null
                for (let index = 0; index < samples.length; ++index) {
                    const sample = samples[index]
                    if (!sample || !sample.quad || sample.quad.length !== 4)
                        continue
                    const sampleSeconds = Number(sample.sequenceSeconds || 0)
                    if (sampleSeconds <= seconds
                            && (!before || sampleSeconds > Number(before.sequenceSeconds || 0)))
                        before = sample
                    if (sampleSeconds >= seconds
                            && (!after || sampleSeconds < Number(after.sequenceSeconds || 0)))
                        after = sample
                }
                if (!before)
                    before = after
                if (!after)
                    after = before
                if (before && after) {
                    const beforeSeconds = Number(before.sequenceSeconds || 0)
                    const afterSeconds = Number(after.sequenceSeconds || beforeSeconds)
                    const progress = afterSeconds > beforeSeconds
                            ? Math.max(0, Math.min(1, (seconds - beforeSeconds)
                                                       / (afterSeconds - beforeSeconds))) : 0
                    const quad = []
                    for (let pointIndex = 0; pointIndex < 4; ++pointIndex) {
                        const first = before.quad[pointIndex]
                        const second = after.quad[pointIndex]
                        quad.push({
                            "x": Number(first.x || 0)
                                 + (Number(second.x || 0) - Number(first.x || 0)) * progress,
                            "y": Number(first.y || 0)
                                 + (Number(second.y || 0) - Number(first.y || 0)) * progress
                        })
                    }
                    return quad
                }
            }
            if (clip.sceneAttachmentQuad && clip.sceneAttachmentQuad.length === 4)
                return clip.sceneAttachmentQuad
        }
        const perspectiveX = Number(clip ? animatedClipValue(
                                               clip, "framePerspectiveX",
                                               clip.baseFramePerspectiveX || 0) : 0)
        const perspectiveY = Number(clip ? animatedClipValue(
                                               clip, "framePerspectiveY",
                                               clip.baseFramePerspectiveY || 0) : 0)
        return [
            {"x": perspectiveX, "y": perspectiveY},
            {"x": 1 - perspectiveX, "y": perspectiveY},
            {"x": 0, "y": 1},
            {"x": 1, "y": 1}
        ]
    }

    function keyframeProgress(interpolation, progress) {
        let value = Math.max(0, Math.min(1, Number(progress || 0)))
        const mode = String(interpolation || "linear")
        if (mode === "hold") return 0
        if (mode === "ease-in") return value * value
        if (mode === "ease-out") return 1 - (1 - value) * (1 - value)
        if (mode === "ease-in-out")
            return value * value * (3 - 2 * value)
        return value
    }

    function cubicBezierCoordinate(p0, p1, p2, p3, parameter) {
        const inverse = 1 - parameter
        return inverse * inverse * inverse * p0
                + 3 * inverse * inverse * parameter * p1
                + 3 * inverse * parameter * parameter * p2
                + parameter * parameter * parameter * p3
    }

    function interpolatedKeyframeValue(left, right, progress) {
        const bounded = Math.max(0, Math.min(1, Number(progress || 0)))
        const leftValue = Number(left && left.value || 0)
        const rightValue = Number(right && right.value || 0)
        if (String(left && left.interpolation || "linear") !== "bezier") {
            const shaped = keyframeProgress(left && left.interpolation, bounded)
            return leftValue + (rightValue - leftValue) * shaped
        }
        const span = Math.max(
            0.0001,
            Number(right && right.seconds || 0) - Number(left && left.seconds || 0))
        let x1 = left && left.bezierOutCustom === true
                 ? Math.max(0.001, Math.min(0.999,
                     Number(left.bezierOutTimeSeconds || 0) / span))
                 : 1 / 3
        let x2 = right && right.bezierInCustom === true
                 ? Math.max(0.001, Math.min(0.999,
                     1 + Number(right.bezierInTimeSeconds || 0) / span))
                 : 2 / 3
        if (x2 < x1 + 0.001) {
            const midpoint = (x1 + x2) / 2
            x1 = Math.max(0.001, midpoint - 0.0005)
            x2 = Math.min(0.999, midpoint + 0.0005)
        }
        let lower = 0
        let upper = 1
        for (let iteration = 0; iteration < 24; ++iteration) {
            const midpoint = (lower + upper) / 2
            if (cubicBezierCoordinate(0, x1, x2, 1, midpoint) < bounded)
                lower = midpoint
            else
                upper = midpoint
        }
        const parameter = (lower + upper) / 2
        return cubicBezierCoordinate(
            leftValue,
            leftValue + (left && left.bezierOutCustom === true
                         ? Number(left.bezierOutValue || 0) : 0),
            rightValue + (right && right.bezierInCustom === true
                          ? Number(right.bezierInValue || 0) : 0),
            rightValue,
            parameter)
    }

    function animatedClipValueAtLocal(clip, parameter, fallbackValue, localSeconds) {
        const keyframes = keyframesForClipParameter(clip, parameter)
        if (keyframes.length === 0)
            return Number(fallbackValue || 0)
        const local = Math.max(0, Math.min(Number(clip.trimmedDurationSeconds || 0), Number(localSeconds || 0)))
        if (local <= Number(keyframes[0].seconds || 0))
            return Number(keyframes[0].value || 0)
        if (local >= Number(keyframes[keyframes.length - 1].seconds || 0))
            return Number(keyframes[keyframes.length - 1].value || 0)
        for (let index = 0; index + 1 < keyframes.length; ++index) {
            const left = keyframes[index]
            const right = keyframes[index + 1]
            const leftSeconds = Number(left.seconds || 0)
            const rightSeconds = Number(right.seconds || 0)
            if (local > rightSeconds)
                continue
            return interpolatedKeyframeValue(
                left,
                right,
                (local - leftSeconds) / Math.max(0.0001, rightSeconds - leftSeconds))
        }
        return Number(keyframes[keyframes.length - 1].value || 0)
    }

    function animatedClipValue(clip, parameter, fallbackValue) {
        return animatedClipValueAtLocal(
            clip,
            parameter,
            fallbackValue,
            root.sequencePlayheadSeconds - Number(clip && clip.startSeconds ? clip.startSeconds : 0))
    }

    function groupTransformScale(layer) {
        return Math.max(0.25, Math.min(2, Number(layer && layer.groupTransformScale !== undefined
                                                ? layer.groupTransformScale : 1)))
    }

    function groupTransformRotation(layer) {
        return Number(layer && layer.groupTransformRotationDegrees !== undefined
                       ? layer.groupTransformRotationDegrees : 0)
    }

    function groupTransformOffset(layer, frameOffsetX, frameOffsetY) {
        const width = Math.max(1, Number(programMonitor ? programMonitor.width : 1))
        const height = Math.max(1, Number(programMonitor ? programMonitor.height : 1))
        const scale = root.groupTransformScale(layer)
        const angle = root.groupTransformRotation(layer) * Math.PI / 180
        const cosine = Math.cos(angle)
        const sine = Math.sin(angle)
        const clipX = Number(frameOffsetX || 0) * width * 0.25
        const clipY = Number(frameOffsetY || 0) * height * 0.25
        return Qt.point(
            Number(layer && layer.groupTransformOffsetX || 0) * width
                    + scale * (cosine * clipX - sine * clipY),
            Number(layer && layer.groupTransformOffsetY || 0) * height
                    + scale * (sine * clipX + cosine * clipY))
    }

    function groupCombinedFrameOffsetX(layer, frameOffsetX, frameOffsetY) {
        const width = Math.max(1, Number(programMonitor ? programMonitor.width : 1))
        return root.groupTransformOffset(layer, frameOffsetX, frameOffsetY).x / (width * 0.25)
    }

    function groupCombinedFrameOffsetY(layer, frameOffsetX, frameOffsetY) {
        const height = Math.max(1, Number(programMonitor ? programMonitor.height : 1))
        return root.groupTransformOffset(layer, frameOffsetX, frameOffsetY).y / (height * 0.25)
    }

    function currentClipMotionPathPoints() {
        if (!currentClip)
            return []
        const horizontal = keyframesForClipParameter(currentClip, "frameOffsetX")
        const vertical = keyframesForClipParameter(currentClip, "frameOffsetY")
        let times = []
        for (let index = 0; index < horizontal.length; ++index)
            if (times.indexOf(Number(horizontal[index].seconds || 0)) < 0)
                times.push(Number(horizontal[index].seconds || 0))
        for (let index = 0; index < vertical.length; ++index)
            if (times.indexOf(Number(vertical[index].seconds || 0)) < 0)
                times.push(Number(vertical[index].seconds || 0))
        times.sort(function(left, right) { return left - right })
        let points = []
        for (let timeIndex = 0; timeIndex < times.length; ++timeIndex) {
            const local = times[timeIndex]
            points.push({
                "seconds": local,
                "x": animatedClipValueAtLocal(
                    currentClip, "frameOffsetX", currentClip.baseFrameOffsetX || 0, local),
                "y": animatedClipValueAtLocal(
                    currentClip, "frameOffsetY", currentClip.baseFrameOffsetY || 0, local)
            })
        }
        return points
    }

    function keyframeParameterLabel(parameter) {
        if (parameter === "titleFontSize") return "Title Size"
        if (parameter === "titlePositionX") return "Title Horizontal Position"
        if (parameter === "titlePositionY") return "Title Vertical Position"
        if (parameter === "frameScale") return "Scale"
        if (parameter === "frameOffsetX") return "Horizontal Position"
        if (parameter === "frameOffsetY") return "Vertical Position"
        if (parameter === "frameRotationDegrees") return "Rotation"
        if (parameter === "framePerspectiveX") return "Perspective X"
        if (parameter === "framePerspectiveY") return "Perspective Y"
        if (parameter === "opacity") return "Opacity"
        if (parameter === "audioGainDb") return "Audio Gain"
        if (parameter === "audioPan") return "Audio Pan"
        if (parameter === "audioEqLowDb") return "EQ Low"
        if (parameter === "audioEqMidDb") return "EQ Mid"
        if (parameter === "audioEqHighDb") return "EQ High"
        if (parameter === "audioCompressorThresholdDb") return "Compressor Threshold"
        if (parameter === "audioCompressorRatio") return "Compressor Ratio"
        if (parameter === "audioCompressorMakeupDb") return "Compressor Makeup"
        if (parameter === "audioLimiterCeilingDb") return "Limiter Ceiling"
        if (parameter === "audioGateThresholdDb") return "Gate Threshold"
        if (parameter === "audioDeEsserAmount") return "De-Esser Amount"
        if (parameter === "audioHighPassHz") return "High-Pass Frequency"
        if (parameter === "audioLowPassHz") return "Low-Pass Frequency"
        if (parameter === "sourceTime") return "Source Time"
        if (String(parameter || "").indexOf("effect:") === 0)
            return String(parameter).substring(7) + " Amount"
        if (String(parameter || "").indexOf("grade:") === 0) {
            let gradeParameter = String(parameter).substring(6)
            let prefix = "Grade "
            if (gradeParameter.indexOf("layer:") === 0) {
                const separator = gradeParameter.indexOf(":", 6)
                if (separator > 6) {
                    const layerId = gradeParameter.substring(6, separator)
                    const layers = root.currentClip && root.currentClip.colorGradeLayers
                                  ? root.currentClip.colorGradeLayers : []
                    for (let index = 0; index < layers.length; ++index) {
                        if (String(layers[index].id || "") === layerId) {
                            prefix = String(layers[index].name || "Adjustment Layer") + " · "
                            break
                        }
                    }
                    gradeParameter = gradeParameter.substring(separator + 1)
                }
            }
            return prefix + gradeParameter.replace(/([a-z])([A-Z])/g, "$1 $2")
        }
        return String(parameter || "Motion")
    }

    function keyframeParameterBounds(parameter) {
        if (parameter === "titleFontSize") return ({"minimum": 12, "maximum": 240})
        if (parameter === "titlePositionX" || parameter === "titlePositionY")
            return ({"minimum": 0, "maximum": 1})
        if (parameter === "frameScale") return ({"minimum": 0.05, "maximum": 4})
        if (parameter === "frameOffsetX" || parameter === "frameOffsetY")
            return ({"minimum": -4, "maximum": 4})
        if (parameter === "frameRotationDegrees") return ({"minimum": -180, "maximum": 180})
        if (parameter === "framePerspectiveX" || parameter === "framePerspectiveY")
            return ({"minimum": -0.35, "maximum": 0.35})
        if (parameter === "opacity") return ({"minimum": 0, "maximum": 1})
        if (parameter === "audioGainDb") return ({"minimum": -36, "maximum": 0})
        if (parameter === "sourceTime") return ({
            "minimum": Number(root.currentClip && root.currentClip.trimStartSeconds || 0),
            "maximum": Number(root.currentClip && root.currentClip.trimEndSeconds || 1)
        })
        if (String(parameter || "").indexOf("grade:") === 0) {
            let gradeParameter = String(parameter).substring(6)
            if (gradeParameter.indexOf("layer:") === 0) {
                const separator = gradeParameter.indexOf(":", 6)
                if (separator > 6)
                    gradeParameter = gradeParameter.substring(separator + 1)
            }
            if (gradeParameter === "opacity")
                return ({"minimum": 0, "maximum": 1})
            if (gradeParameter === "exposure")
                return ({"minimum": -5, "maximum": 5})
            if (/Hue$/.test(gradeParameter))
                return ({"minimum": 0, "maximum": 1})
            if (/Saturation$/.test(gradeParameter)
                    && gradeParameter !== "saturation")
                return ({"minimum": 0, "maximum": 100})
            return ({"minimum": -100, "maximum": 100})
        }
        if (String(parameter || "").indexOf("effect:") === 0
                && ["Exposure", "Contrast", "Saturation"].indexOf(String(parameter).substring(7)) < 0)
            return ({"minimum": 0, "maximum": 1})
        return ({"minimum": -1, "maximum": 1})
    }

    function clipKeyframeParameterOptions() {
        return (root.currentClip.availableKeyframeParameters || []).map(parameter => ({
            "parameter": String(parameter),
            "label": root.keyframeParameterLabel(String(parameter)),
            "keyframeCount": root.keyframesForClipParameter(root.currentClip, String(parameter)).length
        }))
    }

    function toggleInlineKeyframeLanes() {
        keyframeLanesVisible = !keyframeLanesVisible
        if (keyframeLanesVisible && currentClip && currentClip.trackId)
            setTrackHeight(String(currentClip.trackId), Math.max(92, trackHeight(String(currentClip.trackId))))
    }

    function openCurveEditor(parameter) {
        timelineDocument.pauseSequence()
        curveEditorTarget = "clip"
        curveEditorTrackId = ""
        curveEditorParameter = String(parameter || "frameScale")
        curveEditorSelectedSeconds = -1
        keyframeCurveWindow.clearCurveSelection()
        keyframeCurveWindow.show()
        keyframeCurveWindow.raise()
        keyframeCurveWindow.requestActivate()
    }

    function curveEditorTrackData() {
        const targetId = String(curveEditorTrackId || "")
        for (let index = 0; index < sequenceTrackModel.length; ++index) {
            if (String(sequenceTrackModel[index].trackId || "") === targetId)
                return sequenceTrackModel[index]
        }
        return null
    }

    function curveEditorTrackRowIndex() {
        const targetId = String(curveEditorTrackId || "")
        for (let index = 0; index < sequenceTrackModel.length; ++index) {
            if (String(sequenceTrackModel[index].trackId || "") === targetId)
                return index
        }
        return -1
    }

    function openTrackAutomationCurveEditor(trackData, parameter) {
        if (!trackData || !trackData.trackId)
            return
        timelineDocument.pauseSequence()
        curveEditorTarget = "track"
        curveEditorTrackId = String(trackData.trackId)
        curveEditorParameter = String(parameter || trackAutomationLaneParameter(trackData))
        curveEditorSelectedSeconds = -1
        keyframeCurveWindow.clearCurveSelection()
        keyframeCurveWindow.graphMode = trackAutomationGraphSpeedMode(curveEditorTrackId)
                                      ? "speed" : "value"
        keyframeCurveWindow.show()
        keyframeCurveWindow.raise()
        keyframeCurveWindow.requestActivate()
    }

    function clipEffectAmount(clip, effectName) {
        if (!clip || clip.effectsEnabled === false || !clip.effectDetails)
            return 0
        if (root.programComparisonBypassEffects &&
                String(clip.clipId || "") === String(root.programClip.clipId || ""))
            return 0
        for (let index = 0; index < clip.effectDetails.length; ++index) {
            const effect = clip.effectDetails[index]
            if (effect && String(effect.name || "") === effectName && effect.enabled !== false)
                return animatedClipValue(
                    clip,
                    "effect:" + effectName,
                    effect.baseAmount !== undefined ? effect.baseAmount : effect.amount)
        }
        return 0
    }

    function clipEffectMask(clip, effectName) {
        const details = clip && clip.effectDetails ? clip.effectDetails : []
        for (let index = 0; index < details.length; ++index) {
            const effect = details[index]
            if (effect && String(effect.name || "") === effectName)
                return effect.mask || ({})
        }
        return ({})
    }

    function clipMaskedPointEffects(clip) {
        const details = clip && clip.effectDetails ? clip.effectDetails : []
        const results = []
        for (let index = 0; index < details.length; ++index) {
            const effect = details[index]
            const name = String(effect && effect.name || "")
            if (!effect || effect.enabled === false || name === "Blur"
                    || effect.mask === undefined || effect.mask.enabled !== true)
                continue
            results.push({
                "name": name,
                "amount": root.clipEffectAmount(clip, name),
                "mask": effect.mask
            })
        }
        return results
    }

    function clipUnmaskedEffectAmount(clip, effectName) {
        const mask = clipEffectMask(clip, effectName)
        return mask.enabled === true ? 0 : clipEffectAmount(clip, effectName)
    }

    function updateSelectedEffectMask(effectName, changes) {
        if (!timelineDocument || !currentClip || !currentClip.clipId)
            return
        const defaults = {
            "enabled": true,
            "shape": "ellipse",
            "centerX": 0.5,
            "centerY": 0.5,
            "width": 0.65,
            "height": 0.65,
            "feather": 0.04,
            "inverted": false
        }
        const updated = Object.assign(
            {}, defaults, clipEffectMask(currentClip, effectName), changes || ({}), {"enabled": true})
        timelineDocument.setSelectedClipEffectMask(effectName, updated)
        activeEffectMaskName = effectName
    }

    function clipEffectBrightness(clip) {
        return Math.max(-1, Math.min(1,
            clipUnmaskedEffectAmount(clip, "Exposure") * 0.40
            + clipUnmaskedEffectAmount(clip, "Fade") * 0.08))
    }

    function clipEffectContrast(clip) {
        return Math.max(-1, Math.min(1,
            clipUnmaskedEffectAmount(clip, "Contrast") * 0.80
            - clipUnmaskedEffectAmount(clip, "Fade") * 0.35
            + clipUnmaskedEffectAmount(clip, "Punch") * 0.35))
    }

    function clipEffectSaturation(clip) {
        return Math.max(-1, Math.min(1,
            clipUnmaskedEffectAmount(clip, "Saturation")
            - clipUnmaskedEffectAmount(clip, "Black & White")
            + clipUnmaskedEffectAmount(clip, "Punch") * 0.40))
    }

    function clipEffectBlur(clip) {
        return Math.max(0, Math.min(1, clipEffectAmount(clip, "Blur")))
    }

    function clipRequiresMultiEffect(clip) {
        return Math.abs(clipEffectBrightness(clip)) > 0.0001
                || Math.abs(clipEffectContrast(clip)) > 0.0001
                || Math.abs(clipEffectSaturation(clip)) > 0.0001
                || clipMaskedPointEffects(clip).length > 0
                || clipEffectBlur(clip) > 0.0001
    }

    function clipsAtSequenceTimeForTrack(track, sequenceSeconds) {
        const clips = track && track.clips ? track.clips : []
        const rangeIndex = track && track.clipRangeIndex
        const entries = rangeIndex && rangeIndex.entries ? rangeIndex.entries : []
        if (entries.length === 0)
            return []

        const time = Number(sequenceSeconds || 0)
        let firstIndex = 0
        let lastIndex = entries.length
        while (firstIndex < lastIndex) {
            const middleIndex = Math.floor((firstIndex + lastIndex) / 2)
            if (Number(entries[middleIndex].prefixMaximumEndSeconds) <= time)
                firstIndex = middleIndex + 1
            else
                lastIndex = middleIndex
        }

        let endIndex = 0
        lastIndex = entries.length
        while (endIndex < lastIndex) {
            const middleIndex = Math.floor((endIndex + lastIndex) / 2)
            if (Number(entries[middleIndex].startSeconds) <= time)
                endIndex = middleIndex + 1
            else
                lastIndex = middleIndex
        }

        const activeEntries = []
        for (let index = firstIndex; index < endIndex; ++index) {
            const entry = entries[index]
            if (Number(entry.endSeconds) > time)
                activeEntries.push(entry)
        }
        activeEntries.sort(function(left, right) {
            return left.clipIndex - right.clipIndex
        })

        const activeClips = []
        for (let index = 0; index < activeEntries.length; ++index)
            activeClips.push(clips[activeEntries[index].clipIndex])
        return activeClips
    }

    function detailedProgramClip(clip) {
        if (!clip)
            return null
        const clipId = String(clip.clipId || "")
        if (clipId.length === 0 || !timelineDocument.timelineClipDetails)
            return clip
        if (root.currentClip && String(root.currentClip.clipId || "") === clipId)
            return root.currentClip
        const cached = programPlaybackDetailCache[clipId]
        if (cached)
            return cached
        const details = timelineDocument.timelineClipDetails(Number(clip.index))
        if (!details || String(details.clipId || "") !== clipId)
            return clip
        const nextCache = Object.assign({}, programPlaybackDetailCache)
        nextCache[clipId] = details
        programPlaybackDetailCache = nextCache
        return details
    }

    function programBackgroundLayers() {
        const activeClipId = String(programClip.clipId || "")
        const playhead = Number(sequencePlayheadSeconds || 0)
        let layers = []
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || track.trackKind !== "video" || track.effectiveVisible === false || !track.clips)
                continue
            const activeClips = clipsAtSequenceTimeForTrack(track, playhead)
            for (let clipIndex = 0; clipIndex < activeClips.length; ++clipIndex) {
                const clip = activeClips[clipIndex]
                if (!clip)
                    continue
                if (clip.mediaType === "adjustment")
                    continue
                if (String(clip.clipId || "") === activeClipId
                        && clip.mediaType !== "title" && clip.mediaType !== "caption")
                    continue
                if (root.programLayerVisible(clip))
                    layers.push(root.detailedProgramClip(clip))
            }
        }
        const transitions = programTransitionStates || []
        for (let index = 0; index < transitions.length; ++index) {
            const incomingClipId = String(transitions[index].incomingClipId || "")
            const clip = sequenceClipById[incomingClipId]
            if (!clip || (String(clip.clipId || "") === activeClipId
                          && clip.mediaType !== "title" && clip.mediaType !== "caption")
                    || clip.mediaType === "adjustment"
                    || !root.programLayerVisible(clip))
                continue
            let included = false
            for (let layerIndex = 0; layerIndex < layers.length; ++layerIndex) {
                if (String(layers[layerIndex].clipId || "") === incomingClipId) {
                    included = true
                    break
                }
            }
            if (!included)
                layers.push(root.detailedProgramClip(clip))
        }
        layers.sort(function(left, right) {
            const laneDelta = Number(left.laneIndex || 0) - Number(right.laneIndex || 0)
            return laneDelta !== 0 ? laneDelta : Number(left.startSeconds || 0) - Number(right.startSeconds || 0)
        })
        return layers
    }

    function sameClipModelItems(left, right) {
        if (!left || !right || left.length !== right.length)
            return false
        for (let index = 0; index < left.length; ++index) {
            if (String(left[index] && left[index].clipId || "")
                    !== String(right[index] && right[index].clipId || ""))
                return false
        }
        return true
    }

    function refreshProgramPlaybackLayerModels(forceUpdate) {
        const nextBackgroundLayers = programBackgroundLayers()
        if (forceUpdate === true
                || !sameClipModelItems(programBackgroundLayerModel, nextBackgroundLayers))
            programBackgroundLayerModel = nextBackgroundLayers

        const nextAdjustmentLayers = programAdjustmentLayers()
        if (forceUpdate === true
                || !sameClipModelItems(programAdjustmentLayerModel, nextAdjustmentLayers))
            programAdjustmentLayerModel = nextAdjustmentLayers

        const nextAudioLayers = programAudioLayers()
        if (forceUpdate === true
                || !sameClipModelItems(programAudioLayerModel, nextAudioLayers))
            programAudioLayerModel = nextAudioLayers
    }

    function programGuidePictureClip() {
        const playhead = Number(sequencePlayheadSeconds || 0)
        let best = null
        function consider(clip) {
            if (!clip || (clip.mediaType !== "video" && clip.mediaType !== "photo"))
                return
            if (playhead < Number(clip.startSeconds || 0)
                    || playhead >= Number(clip.endSeconds || 0))
                return
            if (!best || Number(clip.laneIndex || 0) >= Number(best.laneIndex || 0))
                best = clip
        }
        consider(programClip)
        const background = programBackgroundLayerModel || []
        for (let index = 0; index < background.length; ++index)
            consider(background[index])
        return best || ({})
    }

    function programAdjustmentLayers() {
        let layers = []
        const playhead = Number(sequencePlayheadSeconds || 0)
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || track.trackKind !== "video" || track.effectiveVisible === false || !track.clips)
                continue
            const activeClips = clipsAtSequenceTimeForTrack(track, playhead)
            for (let clipIndex = 0; clipIndex < activeClips.length; ++clipIndex) {
                const clip = activeClips[clipIndex]
                if (clip && clip.mediaType === "adjustment")
                    layers.push(root.detailedProgramClip(clip))
            }
        }
        layers.sort(function(left, right) {
            return Number(left.laneIndex || 0) - Number(right.laneIndex || 0)
        })
        return layers
    }

    function hasAnyAdjustmentClips() {
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || !track.clips)
                continue
            for (let clipIndex = 0; clipIndex < track.clips.length; ++clipIndex) {
                if (track.clips[clipIndex]
                        && track.clips[clipIndex].mediaType === "adjustment")
                    return true
            }
        }
        return false
    }

    function programTransitionStateForClip(layer) {
        const clipId = String(layer && layer.clipId ? layer.clipId : "")
        for (let index = 0; index < programTransitionStates.length; ++index) {
            const state = programTransitionStates[index]
            if (state && (String(state.incomingClipId || "") === clipId
                          || String(state.outgoingClipId || "") === clipId))
                return state
        }
        return null
    }

    function programLayerSourceSeconds(layer, stabilizedVisual) {
        const transition = programTransitionStateForClip(layer)
        const clipId = String(layer && layer.clipId ? layer.clipId : "")
        let sourceSeconds = -1
        if (transition) {
            if (String(transition.incomingClipId || "") === clipId)
                sourceSeconds = Number(transition.incomingSourceSeconds || 0)
            if (String(transition.outgoingClipId || "") === clipId)
                sourceSeconds = Number(transition.outgoingSourceSeconds || 0)
        }
        if (sourceSeconds < 0) {
            const local = Math.max(0, Number(sequencePlayheadSeconds || 0)
                                      - Number(layer && layer.startSeconds ? layer.startSeconds : 0))
            sourceSeconds = root.clipSourceTime(layer, local * timelineZoom)
        }
        return root.programUsesStabilizedPreview(layer, stabilizedVisual)
                ? Math.max(0, sourceSeconds
                           - Number(layer.stabilizationAnalysisTrimStartSeconds || 0))
                : sourceSeconds
    }

    function programAudioLayers() {
        let layers = []
        const playhead = Number(sequencePlayheadSeconds || 0)
        let anySolo = false
        for (let index = 0; index < sequenceTrackModel.length; ++index) {
            const track = sequenceTrackModel[index]
            if (track && track.trackKind === "audio" && track.solo === true)
                anySolo = true
        }
        const activeClipId = String(programClip.clipId || "")
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            const track = sequenceTrackModel[trackIndex]
            if (!track || track.trackKind !== "audio" || track.visible === false || track.muted === true
                    || (anySolo && track.solo !== true) || !track.clips)
                continue
            const activeClips = clipsAtSequenceTimeForTrack(track, playhead)
            for (let clipIndex = 0; clipIndex < activeClips.length; ++clipIndex) {
                const clip = activeClips[clipIndex]
                if (!clip || clip.silentPlaceholder === true || String(clip.sourceUrl || "").length === 0)
                    continue
                if (clip.multicamAudioActive === false)
                    continue
                if (String(clip.clipId || "") === activeClipId && programClip.mediaType === "video")
                    continue
                layers.push(root.detailedProgramClip(clip))
            }
        }
        return layers
    }

    function programAudioVolume(layer) {
        if (layer && layer.retimeAudioMuted === true)
            return 0
        const playhead = Number(sequencePlayheadSeconds || 0)
        const start = Number(layer && layer.startSeconds ? layer.startSeconds : 0)
        const duration = Number(layer && layer.trimmedDurationSeconds ? layer.trimmedDurationSeconds : 0)
        const local = Math.max(0, playhead - start)
        let envelope = 1
        const fadeIn = Number(layer && layer.fadeInSeconds ? layer.fadeInSeconds : 0)
        const fadeOut = Number(layer && layer.fadeOutSeconds ? layer.fadeOutSeconds : 0)
        if (fadeIn > 0)
            envelope = Math.min(envelope, Math.max(0, Math.min(1, local / fadeIn)))
        if (fadeOut > 0)
            envelope = Math.min(envelope, Math.max(0, Math.min(1, (duration - local) / fadeOut)))
        const gainDb = animatedClipValue(
            layer,
            "audioGainDb",
            layer && layer.baseAudioGainDb !== undefined ? layer.baseAudioGainDb
                                                         : layer && layer.audioGainDb !== undefined ? layer.audioGainDb : 0)
        const trackGainDb = Number(layer && layer.trackAudioGainDb !== undefined
                                   ? layer.trackAudioGainDb : 0)
        const linearGain = Math.pow(10, (gainDb + trackGainDb) / 20)
        return Math.max(0, Math.min(1, linearGain * envelope))
    }

    function programAudioPan(layer) {
        return Math.max(-1, Math.min(1, Number(layer && layer.trackAudioPan !== undefined
                                               ? layer.trackAudioPan : 0)))
    }

    function loudnessForEnergy(energy) {
        return energy > 0.0000001
                ? Math.max(-60, -0.691 + 10 * Math.log(energy) / Math.LN10) : -60
    }

    function updateMasterLoudness(meters) {
        const keys = Object.keys(meters || ({}))
        let currentEnergy = 0
        let clipped = false
        const now = Date.now()
        for (let index = 0; index < keys.length; ++index) {
            const meter = meters[keys[index]] || ({})
            const left = Number(meter.rmsLeft || 0)
            const right = Number(meter.rmsRight || 0)
            currentEnergy += (left * left + right * right) * 0.5
            clipped = clipped || Number(meter.clipUntil || 0) > now
        }
        masterMomentaryEnergy = masterMomentaryEnergy * 0.80 + currentEnergy * 0.20
        masterShortTermEnergy = masterShortTermEnergy * 0.9737 + currentEnergy * 0.0263
        masterMomentaryLufs = loudnessForEnergy(masterMomentaryEnergy)
        masterShortTermLufs = loudnessForEnergy(masterShortTermEnergy)
        if (clipped)
            masterClipUntil = now + 800
        masterOverloadLatched = masterOverloadLatched || clipped
        let history = masterLoudnessHistory.slice()
        history.push(masterShortTermLufs)
        while (history.length > 38)
            history.shift()
        masterLoudnessHistory = history
        if (masterLoudnessCanvas)
            masterLoudnessCanvas.requestPaint()
    }

    function publishTrackMeter(trackId, left, right, truePeakLeft, truePeakRight,
                               rmsLeft, rmsRight, clipping) {
        const resolvedId = String(trackId || "")
        if (resolvedId.length === 0)
            return
        const next = Object.assign({}, trackMeterState)
        const previous = next[resolvedId] || ({"left": 0, "right": 0, "clipUntil": 0})
        next[resolvedId] = {
            "left": audioMeterReducedMotion
                    ? Math.min(1, Number(left || 0))
                    : Math.max(Number(previous.left || 0), Math.min(1, Number(left || 0))),
            "right": audioMeterReducedMotion
                     ? Math.min(1, Number(right || 0))
                     : Math.max(Number(previous.right || 0), Math.min(1, Number(right || 0))),
            "truePeakLeft": audioMeterReducedMotion
                            ? Math.min(2, Number(truePeakLeft || 0))
                            : Math.max(Number(previous.truePeakLeft || 0),
                                       Math.min(2, Number(truePeakLeft || 0))),
            "truePeakRight": audioMeterReducedMotion
                             ? Math.min(2, Number(truePeakRight || 0))
                             : Math.max(Number(previous.truePeakRight || 0),
                                        Math.min(2, Number(truePeakRight || 0))),
            "rmsLeft": Math.max(Number(previous.rmsLeft || 0) * 0.72,
                                Math.min(1, Number(rmsLeft || 0))),
            "rmsRight": Math.max(Number(previous.rmsRight || 0) * 0.72,
                                 Math.min(1, Number(rmsRight || 0))),
            "clipUntil": clipping === true ? Date.now() + 2000 : Number(previous.clipUntil || 0),
            "overloadLatched": clipping === true || previous.overloadLatched === true
        }
        trackMeterState = next
    }

    function trackMeterFor(trackId) {
        return trackMeterState[String(trackId || "")] || ({
            "left": 0, "right": 0, "truePeakLeft": 0, "truePeakRight": 0,
            "rmsLeft": 0, "rmsRight": 0, "clipUntil": 0,
            "overloadLatched": false
        })
    }

    function audioMeterDb(value) {
        const safe = Math.max(0.000001, Number(value || 0))
        return Math.max(-60, 20 * Math.log(safe) / Math.LN10)
    }

    function audioTracks() {
        const tracks = []
        for (let index = 0; index < sequenceTrackModel.length; ++index) {
            const track = sequenceTrackModel[index]
            if (!track || track.trackKind !== "audio")
                continue
            const override = root.trackAutomationOverrides[String(track.trackId || "")]
            if (!override) {
                tracks.push(track)
                continue
            }
            const liveTrack = Object.assign({}, track)
            const parameters = []
            for (let keyframeIndex = 0; keyframeIndex < override.length; ++keyframeIndex) {
                const parameter = String(override[keyframeIndex].parameter || "")
                if (parameter.length > 0 && parameters.indexOf(parameter) < 0)
                    parameters.push(parameter)
            }
            for (let parameterIndex = 0; parameterIndex < parameters.length; ++parameterIndex) {
                const parameter = parameters[parameterIndex]
                liveTrack[parameter] = root.trackAutomationValueAt(
                    track, parameter, root.sequencePlayheadSeconds)
            }
            liveTrack.automationKeyframes = override
            tracks.push(liveTrack)
        }
        return tracks
    }

    function audioBusMeter(busName) {
        const normalized = String(busName || "main").toLowerCase()
        const tracks = audioTracks()
        let leftEnergy = 0
        let rightEnergy = 0
        let peakLeft = 0
        let peakRight = 0
        let truePeakLeft = 0
        let truePeakRight = 0
        let overload = false
        let count = 0
        for (let index = 0; index < tracks.length; ++index) {
            if (String(tracks[index].audioBus || "main").toLowerCase() !== normalized)
                continue
            const meter = trackMeterFor(tracks[index].trackId)
            leftEnergy += Math.pow(Number(meter.rmsLeft || 0), 2)
            rightEnergy += Math.pow(Number(meter.rmsRight || 0), 2)
            peakLeft = Math.max(peakLeft, Number(meter.left || 0))
            peakRight = Math.max(peakRight, Number(meter.right || 0))
            truePeakLeft = Math.max(truePeakLeft, Number(meter.truePeakLeft || 0))
            truePeakRight = Math.max(truePeakRight, Number(meter.truePeakRight || 0))
            overload = overload || meter.overloadLatched === true
            ++count
        }
        return {
            "left": peakLeft,
            "right": peakRight,
            "truePeakLeft": truePeakLeft,
            "truePeakRight": truePeakRight,
            "rmsLeft": Math.sqrt(leftEnergy),
            "rmsRight": Math.sqrt(rightEnergy),
            "overloadLatched": overload,
            "trackCount": count
        }
    }

    function masterMeter() {
        const tracks = audioTracks()
        let leftEnergy = 0
        let rightEnergy = 0
        let peakLeft = 0
        let peakRight = 0
        let truePeakLeft = 0
        let truePeakRight = 0
        let overload = root.masterOverloadLatched
        for (let index = 0; index < tracks.length; ++index) {
            const meter = trackMeterFor(tracks[index].trackId)
            leftEnergy += Math.pow(Number(meter.rmsLeft || 0), 2)
            rightEnergy += Math.pow(Number(meter.rmsRight || 0), 2)
            peakLeft = Math.max(peakLeft, Number(meter.left || 0))
            peakRight = Math.max(peakRight, Number(meter.right || 0))
            truePeakLeft = Math.max(truePeakLeft, Number(meter.truePeakLeft || 0))
            truePeakRight = Math.max(truePeakRight, Number(meter.truePeakRight || 0))
            overload = overload || meter.overloadLatched === true
        }
        return {
            "left": peakLeft,
            "right": peakRight,
            "truePeakLeft": truePeakLeft,
            "truePeakRight": truePeakRight,
            "rmsLeft": Math.sqrt(leftEnergy),
            "rmsRight": Math.sqrt(rightEnergy),
            "overloadLatched": overload
        }
    }

    function resetAudioMeters() {
        trackMeterState = ({})
        trackPhaseState = ({})
        masterMomentaryEnergy = 0
        masterShortTermEnergy = 0
        masterMomentaryLufs = -60
        masterShortTermLufs = -60
        masterLoudnessHistory = []
        masterClipUntil = 0
        masterOverloadLatched = false
        ++audioMeterResetRevision
        timelinePlayback.resetAudioMeters()
    }

    function openExternalAudioSync(invoker) {
        externalAudioSyncFocusReturnItem = invoker
        externalAudioSyncMethod = "waveform"
        externalAudioManualOffsetDraft = "0.000000"
        externalAudioSyncPreview = ({})
        if (root.audioMixerPopupVisible)
            root.closeAudioMixerPopup()
        externalAudioSyncPopup.open()
    }

    function previewExternalAudioSync() {
        let offset = Number(externalAudioManualOffsetDraft)
        if (!Number.isFinite(offset))
            offset = 0
        externalAudioSyncPreview = timelineDocument.previewSelectedExternalAudioSync(
                    externalAudioSyncMethod, offset)
    }

    function applyExternalAudioSync() {
        if (externalAudioSyncPreview.valid !== true)
            return
        let offset = Number(externalAudioManualOffsetDraft)
        if (!Number.isFinite(offset))
            offset = 0
        if (timelineDocument.applySelectedExternalAudioSync(
                    externalAudioSyncMethod, offset))
            externalAudioSyncPopup.close()
    }

    function programLayerVisible(layer) {
        if (layer && layer.videoVisible === false)
            return false
        if (layer && layer.multicamActive === false)
            return false
        const playhead = Number(sequencePlayheadSeconds || 0)
        const start = Number(layer && layer.startSeconds ? layer.startSeconds : 0)
        const end = Number(layer && layer.endSeconds ? layer.endSeconds : 0)
        if (playhead >= start && playhead < end)
            return true
        const transition = programTransitionStateForClip(layer)
        return transition
                && String(transition.incomingClipId || "") === String(layer && layer.clipId || "")
                && playhead < start
    }

    function programLayerOpacity(layer) {
        const clipOpacity = animatedClipValue(
            layer,
            "opacity",
            layer && layer.baseOpacity !== undefined ? layer.baseOpacity
                                                      : layer && layer.opacity !== undefined ? layer.opacity : 1)
        const baseOpacity = clipOpacity * Number(layer && layer.trackOpacity !== undefined
                                                 ? layer.trackOpacity : 1)
        const transition = programTransitionStateForClip(layer)
        if (transition
                && String(transition.incomingClipId || "") === String(layer && layer.clipId || "")
                && Number(sequencePlayheadSeconds || 0) < Number(transition.endSeconds || 0))
            return baseOpacity * Number(transition.incomingAlpha || 0)
        return baseOpacity
    }

    function programColorFadeState(layer) {
        if (!layer) return {amount: 0, color: "black"}
        const local = Number(sequencePlayheadSeconds || 0) - Number(layer.startSeconds || 0)
        const duration = Number(layer.trimmedDurationSeconds || 0)
        const amount = function(name, seconds, incoming) {
            if (["Fade to Black", "Fade to White"].indexOf(String(name)) < 0 || Number(seconds) <= 0)
                return 0
            return Math.max(0, Math.min(1, incoming ? 1 - local / Number(seconds)
                                                   : 1 - (duration - local) / Number(seconds)))
        }
        const incoming = amount(layer.transitionInName, layer.transitionInSeconds, true)
        const outgoing = amount(layer.transitionOutName, layer.transitionOutSeconds, false)
        const combined = incoming * (1 - outgoing) + outgoing
        const white = (layer.transitionInName === "Fade to White" ? incoming * (1 - outgoing) : 0)
                    + (layer.transitionOutName === "Fade to White" ? outgoing : 0)
        const value = combined > 0 ? white / combined : 0
        return {amount: combined, color: Qt.rgba(value, value, value, 1)}
    }

    function escapedCaptionText(value) {
        return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
    }

    function programCaptionRichText(layer) {
        const words = layer && layer.captionWords ? layer.captionWords : []
        if (words.length === 0)
            return root.escapedCaptionText(root.captionCasedText(
                                               layer ? layer.titleText : "",
                                               layer ? layer.captionCasing : "none"))
        const mode = root.captionEffectiveEmphasisMode(layer)
        const activeIndex = root.captionActiveWordIndex(layer)
        if (mode === "single-word") {
            return activeIndex >= 0
                    ? root.escapedCaptionText(root.captionCasedText(
                                                  words[activeIndex].text,
                                                  layer ? layer.captionCasing : "none")) : ""
        }
        if (mode === "none")
            return root.escapedCaptionText(root.captionCasedText(
                                               layer ? layer.titleText : "",
                                               layer ? layer.captionCasing : "none"))
        const localSeconds = Number(root.sequencePlayheadSeconds || 0)
                             - Number(layer.startSeconds || 0)
        let output = []
        for (let index = 0; index < words.length; ++index) {
            const word = words[index]
            const text = root.escapedCaptionText(root.captionCasedText(
                                                     word.text,
                                                     layer ? layer.captionCasing : "none"))
            const active = index === activeIndex
            const completed = localSeconds >= Number(word.endSeconds || 0)
            if (mode === "karaoke" && (completed || active)) {
                output.push("<span style='color:"
                            + String(active ? theme.accentWarm300 : theme.accentWarm400)
                            + (active ? ";font-weight:700" : "") + "'>" + text + "</span>")
            } else if (active) {
                const sizeStyle = mode === "pop" ? ";font-size:125%"
                                  : mode === "bounce" ? ";font-size:112%" : ""
                output.push("<span style='color:" + String(theme.accentWarm300)
                            + ";font-weight:700" + sizeStyle + "'>" + text + "</span>")
            } else {
                output.push(text)
            }
        }
        return output.join(" ")
    }

    function captionEffectiveEmphasisMode(layer) {
        let mode = String(layer && layer.captionEmphasisMode || "highlight").toLowerCase()
        if (["none", "highlight", "karaoke", "pop", "bounce", "single-word"].indexOf(mode) < 0)
            mode = "highlight"
        if ((mode === "pop" || mode === "bounce")
                && (theme.reducedMotion
                    || Boolean(layer && layer.captionEmphasisReducedMotion)))
            return "highlight"
        return mode
    }

    function captionActiveWordIndex(layer) {
        const words = layer && layer.captionWords ? layer.captionWords : []
        const localSeconds = Number(root.sequencePlayheadSeconds || 0)
                             - Number(layer && layer.startSeconds || 0)
        for (let index = 0; index < words.length; ++index) {
            if (localSeconds >= Number(words[index].startSeconds || 0)
                    && localSeconds < Number(words[index].endSeconds || 0))
                return index
        }
        return -1
    }

    function captionEmphasisPhase(layer) {
        const mode = root.captionEffectiveEmphasisMode(layer)
        if (mode !== "pop" && mode !== "bounce")
            return 0
        const words = layer && layer.captionWords ? layer.captionWords : []
        const activeIndex = root.captionActiveWordIndex(layer)
        if (activeIndex < 0 || activeIndex >= words.length)
            return 0
        const localSeconds = Number(root.sequencePlayheadSeconds || 0)
                             - Number(layer.startSeconds || 0)
        const start = Number(words[activeIndex].startSeconds || 0)
        const end = Math.max(start + 0.001, Number(words[activeIndex].endSeconds || start))
        const progress = Math.max(0, Math.min(1, (localSeconds - start) / (end - start)))
        return Math.sin(Math.PI * progress)
    }

    function programCaptionPlainText(layer) {
        const mode = root.captionEffectiveEmphasisMode(layer)
        const words = layer && layer.captionWords ? layer.captionWords : []
        if (mode === "single-word" && words.length > 0) {
            const activeIndex = root.captionActiveWordIndex(layer)
            return activeIndex >= 0
                    ? root.captionCasedText(words[activeIndex].text,
                                            layer ? layer.captionCasing : "none") : ""
        }
        return root.captionCasedText(layer ? layer.titleText : "",
                                     layer ? layer.captionCasing : "none")
    }

    function captionCasedText(text, casing) {
        const value = String(text || "")
        const mode = String(casing || "none").toLowerCase()
        if (mode === "upper")
            return value.toUpperCase()
        if (mode === "lower")
            return value.toLowerCase()
        if (mode !== "title")
            return value
        const words = value.toLowerCase().split(" ")
        for (let index = 0; index < words.length; ++index) {
            if (words[index].length > 0)
                words[index] = words[index].charAt(0).toUpperCase() + words[index].slice(1)
        }
        return words.join(" ")
    }

    function hasProgramVisualAtPlayhead() {
        for (let index = 0; index < programBackgroundLayerModel.length; ++index) {
            if (root.programLayerVisible(programBackgroundLayerModel[index]))
                return true
        }
        return false
    }

    function searchMatchCount() {
        return root.timelineSearchResultModel ? root.timelineSearchResultModel.length : 0
    }

    function activateTimelineSearchResult(result) {
        if (!result)
            return
        timelineDocument.activateTimelineSearchResult(String(result.type), String(result.id))
        timelinePlayback.seekSequenceSeconds(Number(result.seconds || 0))
        root.timelineSearchCursorResultId = String(result.type) + ":" + String(result.id)
    }

    function jumpToSearchResult(direction) {
        const results = root.timelineSearchResultModel || []
        if (results.length === 0)
            return

        let cursorIndex = -1
        for (let index = 0; index < results.length; ++index) {
            const key = String(results[index].type) + ":" + String(results[index].id)
            if (key === root.timelineSearchCursorResultId) {
                cursorIndex = index
                break
            }
        }
        if (cursorIndex >= 0) {
            const nextIndex = (cursorIndex + (direction >= 0 ? 1 : -1) + results.length) % results.length
            root.activateTimelineSearchResult(results[nextIndex])
            return
        }

        const current = Number(sequencePlayheadSeconds || 0)
        if (direction >= 0) {
            for (let forwardIndex = 0; forwardIndex < results.length; ++forwardIndex) {
                if (Number(results[forwardIndex].seconds || 0) >= current - 0.001) {
                    root.activateTimelineSearchResult(results[forwardIndex])
                    return
                }
            }
            root.activateTimelineSearchResult(results[0])
            return
        }
        for (let reverseIndex = results.length - 1; reverseIndex >= 0; --reverseIndex) {
            if (Number(results[reverseIndex].seconds || 0) <= current + 0.001) {
                root.activateTimelineSearchResult(results[reverseIndex])
                return
            }
        }
        root.activateTimelineSearchResult(results[results.length - 1])
    }

