            }
        }

        Image {
            anchors.fill: parent
            anchors.margins: theme.space4
            source: trimFrame.hasFrame ? String(trimFrame.frameData.posterSource || "") : ""
            fillMode: Image.PreserveAspectFit
            asynchronous: true
            cache: true
            visible: source.toString().length > 0 && !trimFrame.frameReady
            opacity: trimFrame.isVideo ? 0.25 : 1
        }

        Image {
            id: decodedImage
            objectName: trimFrame.objectName + "DecodedImage"
            anchors.fill: parent
            anchors.margins: theme.space4
            source: trimFrame.decodedFrameSource
            fillMode: Image.PreserveAspectFit
            asynchronous: true
            cache: true
            visible: trimFrame.isVideo && trimFrame.frameReady
        }

        Label {
            anchors.centerIn: parent
            width: parent.width - theme.space16
            horizontalAlignment: Text.AlignHCenter
            wrapMode: Text.Wrap
            visible: trimFrame.isVideo && !trimFrame.frameReady
            text: trimFrame.pendingFrame ? "Loading source frame…" : "Source frame unavailable"
            color: theme.textMuted
            font.family: theme.fontUi
            font.pixelSize: theme.typeCaption
        }

        Label {
            anchors.centerIn: parent
            visible: !trimFrame.hasFrame
            text: "GAP"
            color: theme.textMuted
            font.family: theme.fontUi
            font.pixelSize: theme.typeSection
            font.weight: Font.DemiBold
        }

        Rectangle {
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.margins: theme.space8
            implicitWidth: trimRoleLabel.implicitWidth + theme.space12
            implicitHeight: trimRoleLabel.implicitHeight + theme.space6
            radius: theme.radiusChip
            color: theme.alpha(theme.ink950, 0.78)

            Label {
                id: trimRoleLabel
                anchors.centerIn: parent
                text: trimFrame.roleLabel
                color: trimFrame.roleLabel === "OUTGOING" ? theme.accentWarm300 : theme.accentCool300
                font.family: theme.fontUi
                font.pixelSize: theme.typeMicro
                font.weight: Font.Bold
                font.letterSpacing: 0.7
            }
        }

        Rectangle {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.margins: theme.space8
            implicitHeight: trimFrameReadout.implicitHeight + theme.space10
            radius: theme.radiusSurface
            color: theme.alpha(theme.ink950, 0.84)

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: theme.space8
                anchors.rightMargin: theme.space8
                spacing: theme.space8

                Label {
                    Layout.fillWidth: true
                    text: trimFrame.hasFrame ? String(trimFrame.frameData.displayLabel || "Clip") : "Sequence gap"
                    color: theme.textMain
                    font.family: theme.fontUi
                    font.pixelSize: theme.typeCaption
                    elide: Text.ElideRight
                }

                Label {
                    id: trimFrameReadout
                    text: trimFrame.hasFrame ? String(trimFrame.frameData.sourceTimecode || "00:00:00:00") : "--:--:--:--"
                    color: theme.textStrong
                    font.family: theme.fontNumeric
                    font.features: theme.numericFontFeatures
                    font.pixelSize: theme.typeCaption
                }
            }
        }

        Component.onCompleted: Qt.callLater(syncFrame)
    }

    TimelineWorkspaceLayoutState {
        id: workspaceLayoutState
    }

    Timer {
        id: initialTimelineUiTimer
        interval: 0
        onTriggered: {
            root.restoreInspectorTabForSelection()
            root.presentTimelineRecoveryIfNeeded()
            root.scheduleBackgroundWorkIntentPublish()
        }
    }

    Timer {
        id: timelineSurfaceRefreshTimer
        property bool revealSelectedTrack: false
        interval: 0
        onTriggered: {
            root.refreshVirtualizedTimelineTrackRows(true)
            root.refreshTimelineClipVirtualizationWindow(true)
            root.refreshProgramPlaybackLayerModels(true)
            if (revealSelectedTrack) {
                revealSelectedTrack = false
                if (timelineDocument.selectedClipIds.indexOf(String(root.currentClip.clipId || "")) >= 0)
                    root.ensureTimelineClipTrackVisible(root.currentClip)
            }
        }
    }

    Timer {
        id: programPlaybackLayersRefreshTimer
        interval: 0
        onTriggered: root.refreshProgramPlaybackLayerModels()
    }

    Timer {
        id: workspaceLayoutSaveTimer
        interval: 250
        onTriggered: root.saveCurrentTimelineWorkspaceLayout()
    }

    function scheduleWorkspaceLayoutSave() {
        if (workspacePanelSettingsInitialized && !restoringTimelineLayout)
            workspaceLayoutSaveTimer.restart()
    }

    Settings {
        id: timelineWorkspaceSettings
        objectName: "timelineWorkspaceSettings"
        category: "TimelineWorkspace"
        property string workspaceLayoutsJson: "{}"
        property string panelDockSnapshotJson: ""
        property string lastFocusedPanel: "inspector"
        property string lastSideFocusedPanel: "inspector"
        property bool sourcePanelCollapsed: false
        property bool sourcePanelHidden: false
        property bool effectsPanelCollapsed: true
        property bool advancedControlsVisible: false
        property string timelineLayoutPreset: "edit"
        property string sourceRailTab: "media"
        property string inspectorTab: "controls"
        property string inspectorTabsByTypeJson: "{}"
        property string inspectorScrollByContextJson: "{}"
        property string inspectorDisclosureByTypeJson: "{}"
        property real sourcePanelWidth: 400
        property real effectsPanelWidth: 320
        property real monitorPanelHeight: 540
        property real laneHeaderWidth: 144
        property string trackHeightsJson: "{}"
        property string trackDensity: "compact"
        property real laneScale: 1
        property bool overviewVisible: false
        property real timelineZoom: 84
        property real timelineScrollX: 0
        property real timelineScrollY: 0
        property real detachedSourceX: NaN
        property real detachedSourceY: NaN
        property real detachedSourceWidth: 420
        property real detachedSourceHeight: 720
        property real detachedInspectorX: NaN
        property real detachedInspectorY: NaN
        property real detachedInspectorWidth: 420
        property real detachedInspectorHeight: 720
        property bool programSourceGangEnabled: false
        property bool programScopesVisible: false
        property string programScopesActiveScope: "waveform"
        property real detachedScopesX: NaN
        property real detachedScopesY: NaN
        property real detachedScopesWidth: 1120
        property real detachedScopesHeight: 720
        property bool curveEditorDocked: true
        property bool curveEditorOpen: false
        property real curveEditorDockWidth: 440
        property real curveEditorX: NaN
        property real curveEditorY: NaN
        property real curveEditorWidth: 1020
        property real curveEditorHeight: 700
        property int shellLayoutVersion: 0
        property int controlsLayoutVersion: 0
        property bool snappingEnabled: appShell.defaultTimelineSnapping
        property bool audioPeakSnappingEnabled: false
        property bool rippleModeEnabled: appShell.defaultTimelineRipple
        property string previewQualityMode: "auto"
        property string effectFavoritesJson: "[]"
        property string effectRecentsJson: "[]"
        property string effectDiscoveryCategory: "All"
        property bool compatibleEffectsOnly: false
        property int effectCatalogVersion: 0
    }

    Timer {
        id: monitorPanelHeightPersistenceTimer
        interval: 250
        repeat: false
        onTriggered: timelineWorkspaceSettings.monitorPanelHeight = root.monitorPanelHeight
    }

    Component.onCompleted: {
        if (timelineWorkspaceSettings.effectCatalogVersion < 1) {
            timelineWorkspaceSettings.compatibleEffectsOnly = false
            timelineWorkspaceSettings.effectCatalogVersion = 1
        }
        sequenceTrackSnapshotSelectionSignature = TimelineSelectionRefresh.selectionSignature(
                    timelineDocument ? timelineDocument.selectedClipIds || [] : [])
        programSnapshotPlaybackSourceUrl = String(timelinePlayback.activeSourceUrl || "")
        timelineDocument.setProgramComparisonSurfaceAvailable(true)
        const needsShellMigration = timelineWorkspaceSettings.shellLayoutVersion < 4
        sourcePanelCollapsed = root.forceCollapsedSourcePanelForPerformanceProbe
                ? true
                : needsShellMigration ? false : timelineWorkspaceSettings.sourcePanelCollapsed
        sourcePanelHidden = needsShellMigration ? false : timelineWorkspaceSettings.sourcePanelHidden
        effectsPanelCollapsed = root.forceCollapsedInspectorForPerformanceProbe
                ? true
                : needsShellMigration ? true : timelineWorkspaceSettings.effectsPanelCollapsed
        timelineAdvancedControlsVisible = needsShellMigration ? false : timelineWorkspaceSettings.advancedControlsVisible
        const savedLayoutPreset = String(timelineWorkspaceSettings.timelineLayoutPreset || "edit")
        timelineLayoutPreset = ["edit", "color", "audio", "finish"].indexOf(savedLayoutPreset) >= 0
                ? savedLayoutPreset : "edit"
        sourceRailTab = timelineWorkspaceSettings.sourceRailTab
        programSourceGangEnabled = timelineWorkspaceSettings.programSourceGangEnabled
        programScopesVisible = timelineWorkspaceSettings.programScopesVisible
        inspectorTab = timelineWorkspaceSettings.inspectorTab
        try {
            inspectorTabsByType = JSON.parse(
                        String(timelineWorkspaceSettings.inspectorTabsByTypeJson || "{}"))
        } catch (error) {
            inspectorTabsByType = ({})
            timelineWorkspaceSettings.inspectorTabsByTypeJson = "{}"
        }
        try {
            inspectorScrollByContext = JSON.parse(
                        String(timelineWorkspaceSettings.inspectorScrollByContextJson || "{}"))
        } catch (error) {
            inspectorScrollByContext = ({})
            timelineWorkspaceSettings.inspectorScrollByContextJson = "{}"
        }
        try {
            inspectorDisclosureByType = JSON.parse(
                        String(timelineWorkspaceSettings.inspectorDisclosureByTypeJson || "{}"))
        } catch (error) {
            inspectorDisclosureByType = ({})
            timelineWorkspaceSettings.inspectorDisclosureByTypeJson = "{}"
        }
        try {
            effectFavorites = normalizedEffectNames(
                        JSON.parse(String(timelineWorkspaceSettings.effectFavoritesJson || "[]")),
                        effectLibraryModel.length)
        } catch (error) {
            effectFavorites = []
            timelineWorkspaceSettings.effectFavoritesJson = "[]"
        }
        try {
            effectRecents = normalizedEffectNames(
                        JSON.parse(String(timelineWorkspaceSettings.effectRecentsJson || "[]")), 8)
        } catch (error) {
            effectRecents = []
            timelineWorkspaceSettings.effectRecentsJson = "[]"
        }
        const savedEffectCategory = String(timelineWorkspaceSettings.effectDiscoveryCategory || "All")
        effectDiscoveryCategory = ["All", "Favorites", "Recent", "Color", "Style", "Utility"]
                .indexOf(savedEffectCategory) >= 0 ? savedEffectCategory : "All"
        compatibleEffectsOnly = timelineWorkspaceSettings.compatibleEffectsOnly
        sourcePanelWidth = needsShellMigration ? 400 : Math.max(260, Number(timelineWorkspaceSettings.sourcePanelWidth || 400))
        effectsPanelWidth = needsShellMigration ? 320 : Math.max(280, Number(timelineWorkspaceSettings.effectsPanelWidth || 320))
        curveEditorDocked = timelineWorkspaceSettings.curveEditorDocked !== false
        curveEditorOpen = timelineWorkspaceSettings.curveEditorOpen === true
        curveEditorDockWidth = Math.max(360, Math.min(720,
            Number(timelineWorkspaceSettings.curveEditorDockWidth || 440)))
        monitorPanelHeight = needsShellMigration ? 540
                                                 : Math.max(300,
                                                            Math.min(720,
                                                                     Number(timelineWorkspaceSettings.monitorPanelHeight || 540)))
        setLaneHeaderWidth(Number(timelineWorkspaceSettings.laneHeaderWidth || 144))
        try {
            trackHeights = JSON.parse(String(timelineWorkspaceSettings.trackHeightsJson || "{}"))
        } catch (error) {
            trackHeights = ({})
            timelineWorkspaceSettings.trackHeightsJson = "{}"
        }
        timelineZoom = Math.max(timelineZoomMin,
                                Math.min(timelineZoomMax,
                                         Number(timelineWorkspaceSettings.timelineZoom || 84)))
        timelineWorkspaceSettings.shellLayoutVersion = 4
        snappingEnabled = timelineWorkspaceSettings.snappingEnabled
        audioPeakSnappingEnabled = timelineWorkspaceSettings.audioPeakSnappingEnabled
        rippleModeEnabled = timelineWorkspaceSettings.rippleModeEnabled
        previewQualityMode = timelineWorkspaceSettings.previewQualityMode
        programScopesActiveScope = String(timelineWorkspaceSettings.programScopesActiveScope || "waveform")
        timelinePlayback.previewQualityMode = previewQualityMode
        timelinePlayback.interactionActive = previewInteractionActive
        beginTimelineSetup()
        refreshProgramPlaybackLayerModels(true)
        initialTimelineUiTimer.restart()
        workspacePanelSettingsInitialized = true
        workspaceLayoutState.restore(timelineWorkspaceSettings.workspaceLayoutsJson)
        if (!Object.prototype.hasOwnProperty.call(workspaceLayoutState.layouts, "edit")) {
            const editingLayout = workspaceLayoutState.defaults("edit")
            // The former shared shell becomes the user's Editing layout.
            // Other tasks get their own factory arrangement on first upgrade.
            if (!needsShellMigration) {
                editingLayout.sourceCollapsed = sourcePanelCollapsed
                editingLayout.sourceHidden = sourcePanelHidden
                editingLayout.inspectorCollapsed = effectsPanelCollapsed
                editingLayout.sourceWidth = sourcePanelWidth
                editingLayout.inspectorWidth = effectsPanelWidth
                editingLayout.monitorHeight = monitorPanelHeight
                editingLayout.monitorUserResized = Math.abs(monitorPanelHeight - 540) > 0.5
                editingLayout.sourceTab = sourceRailTab
                editingLayout.inspectorTab = inspectorTab
            }
            editingLayout.timelineHeight = Math.max(220, Math.min(380,
                        Number(trackVerticalLayout.totalHeight || 124) / theme.scaled(1) + 112))
            workspaceLayoutState.remember("edit", editingLayout)
        }
        applyStoredTimelineLayoutPreset(timelineLayoutPreset, true)
        restoreTimelinePanelState()
        if (timelineWorkspaceSettings.controlsLayoutVersion < 1) {
            const migrated = workspaceLayoutState.migrateEditingControlsLayout()
            if (timelineLayoutPreset === "edit") {
                panelDockState.applyArrangement("edit", migrated)
                sourcePanelWidth = Math.max(320, sourcePanelWidth)
                syncTimelinePanelState()
            }
            timelineWorkspaceSettings.workspaceLayoutsJson = JSON.stringify(workspaceLayoutState.layouts)
            timelineWorkspaceSettings.panelDockSnapshotJson = JSON.stringify(panelDockState.snapshot())
            timelineWorkspaceSettings.controlsLayoutVersion = 1
        }
        if (timelineWorkspaceSettings.controlsLayoutVersion < 2) {
            const migratedWorkspace = workspaceLayoutState.migrateLegacyEditingKeyframes()
            panelDockState.migrateLegacyEditingKeyframes()
            if (migratedWorkspace) {
                timelineWorkspaceSettings.workspaceLayoutsJson = JSON.stringify(workspaceLayoutState.layouts)
                if (timelineLayoutPreset === "edit")
                    inspectorTab = "controls"
            }
            syncTimelinePanelState()
            timelineWorkspaceSettings.panelDockSnapshotJson = JSON.stringify(panelDockState.snapshot())
            timelineWorkspaceSettings.controlsLayoutVersion = 2
        }
        if (timelineWorkspaceSettings.controlsLayoutVersion < 3) {
            workspaceLayoutState.remember("edit", captureTimelineWorkspaceLayout())
            const complete = workspaceLayoutState.migrateCompleteEditingLayout()
            applyStoredTimelineLayoutPreset("edit", true)
            panelDockState.applyArrangement("edit", complete)
            syncTimelinePanelState()
            timelineWorkspaceSettings.workspaceLayoutsJson = JSON.stringify(workspaceLayoutState.layouts)
            timelineWorkspaceSettings.panelDockSnapshotJson = JSON.stringify(panelDockState.snapshot())
            timelineWorkspaceSettings.timelineLayoutPreset = "edit"
            timelineWorkspaceSettings.controlsLayoutVersion = 3
        }
        if (timelineLayoutPreset === "edit")
            panelDockState.focusPanel("inspector")
        if (root.forceCollapsedSourcePanelForPerformanceProbe)
            sourcePanelCollapsed = true
        if (root.forceCollapsedInspectorForPerformanceProbe)
            effectsPanelCollapsed = true
    }
    Component.onDestruction: {
        timelineSelectionRefreshLifetime.alive = false
        cancelDirectTimelineTool()
        if (panelDockingReady)
            timelineWorkspaceSettings.panelDockSnapshotJson = JSON.stringify(panelDockState.snapshot())
        keyframeCurveWindow.endCurveGesture()
        saveCurrentTimelineWorkspaceLayout()
        panelDockingReady = false
        timelineDocument.setProgramComparisonSurfaceAvailable(false)
        if (fullScreenProgramActive)
            exitFullScreenProgram()
        if (programComparisonActive)
            closeProgramComparison()
        timelineDocument.clearProgramSourceGangState()
        timelineDocument.clearProgramScopeAnalysis()
        timelineDocument.setBackgroundWorkIntent(false, false, [])
        timelinePlayback.attachVideoOutput(null)
    }

    Timer {
        id: fullScreenProgramControlsTimer
        objectName: "timelineFullScreenProgramControlsTimer"
        interval: 2200
        repeat: false
        onTriggered: {
            if (root.fullScreenProgramActive)
                root.fullScreenProgramControlsVisible = false
        }
    }

    Timer {
        id: workspaceResourceIdleTimer
        objectName: "timelineWorkspaceResourceIdleTimer"
        interval: 10000
        repeat: false
        onTriggered: root.hibernateWorkspaceResources()
    }

    Timer {
        interval: 30000
        repeat: true
        running: root.visible
        onTriggered: {
            if (timelineEditorPageLoader.item)
                timelineEditorPageLoader.item.releaseRetainedPanels(true)
        }
    }

    Timer {
        id: programComparisonRefreshTimer
        objectName: "timelineProgramComparisonRefreshTimer"
        interval: 90
        repeat: false
        onTriggered: {
            if (root.programComparisonActive && !root.sequencePlaying)
                root.refreshProgramComparisonCurrentFrame()
        }
    }

    Timer {
        id: programComparisonDifferenceTimer
        objectName: "timelineProgramComparisonDifferenceTimer"
        interval: 80
        repeat: false
        onTriggered: root.updateProgramComparisonDifference()
    }

    Timer {
        id: programSourceGangSyncTimer
        objectName: "timelineProgramSourceGangSyncTimer"
        interval: 33
        repeat: true
        running: root.programSourceGangEnabled && root.sequencePlaying && root.visible
        onTriggered: root.synchronizeGangedSourceToProgram()
    }

    Timer {
        id: programSourceGangPausedSyncTimer
        objectName: "timelineProgramSourceGangPausedSyncTimer"
        interval: 0
        repeat: false
        onTriggered: root.synchronizeGangedSourceToProgram()
    }

    Timer {
        id: programScopesLiveTimer
        objectName: "timelineProgramScopesLiveTimer"
        interval: 67
        repeat: true
        running: root.programScopesPanelPresented() && !root.programScopesFrozen
                 && root.sequencePlaying && root.hasPlayableSequence() && !root.fullScreenProgramActive
                 && !root.programComparisonActive
        onTriggered: root.captureProgramScopeFrame(false)
    }

    Timer {
        id: programScopesRefreshTimer
        objectName: "timelineProgramScopesRefreshTimer"
        interval: 70
        repeat: false
        onTriggered: {
            if (!root.programScopesPanelPresented() || root.programScopesFrozen) {
                root.programScopesPausedRefreshPending = false
                return
            }
            root.captureProgramScopeFrame(true)
        }
    }

    Timer {
        id: backgroundWorkIntentTimer
        interval: 48
        repeat: false
        onTriggered: root.publishBackgroundWorkIntent()
    }

    Timer {
        id: markerFeedbackTimer
        interval: 1800
        repeat: false
        onTriggered: root.markerFeedbackVisible = false
    }

    Timer {
        id: timelineSeekCommitTimer
        interval: 16
        repeat: false
        onTriggered: root.commitPendingTimelineSeek()
    }

    Timer {
        id: timelineTrimCommitTimer
        interval: 17
        repeat: false
        onTriggered: root.commitPendingTrimEnd()
    }

    Timer {
        id: timelineFadeCommitTimer
        interval: 17
        repeat: false
        onTriggered: {
            timelineDocument.setSelectedClipFadeInSeconds(root.pendingFadeInSeconds)
            root.interactionFadeInSeconds = -1
            root.pendingFadeInSeconds = -1
        }
    }

    Timer {
        id: adjustmentPreviewCacheTimer
        objectName: "timelineAdjustmentPreviewCacheTimer"
        interval: 420
        repeat: false
        onTriggered: {
            if (root.visible && root.hasAnyAdjustmentClips()
                    && !timelineDocument.renderCacheBusy
                    && timelineDocument.renderCacheReadyRangeCount
                       < timelineDocument.renderCacheRangeCount)
                timelineDocument.generateRenderCache()
        }
    }

    Timer {
        id: trackMeterDecayTimer
        interval: 80
        repeat: true
        running: root.visible && !root.audioMeterReducedMotion
                 && (root.sequencePlaying || Object.keys(root.trackMeterState).length > 0)
        onTriggered: {
            const next = ({})
            const now = Date.now()
            const keys = Object.keys(root.trackMeterState)
            for (let index = 0; index < keys.length; ++index) {
                const key = keys[index]
                const meter = root.trackMeterState[key]
                const left = Number(meter.left || 0) * 0.72
                const right = Number(meter.right || 0) * 0.72
                const rmsLeft = Number(meter.rmsLeft || 0) * 0.82
                const rmsRight = Number(meter.rmsRight || 0) * 0.82
                const truePeakLeft = Number(meter.truePeakLeft || 0) * 0.72
                const truePeakRight = Number(meter.truePeakRight || 0) * 0.72
                const clipUntil = Number(meter.clipUntil || 0)
                if (left > 0.004 || right > 0.004 || rmsLeft > 0.001 || rmsRight > 0.001 || clipUntil > now)
                    next[key] = ({"left": left, "right": right,
                                  "rmsLeft": rmsLeft, "rmsRight": rmsRight,
                                  "truePeakLeft": truePeakLeft,
                                  "truePeakRight": truePeakRight,
                                  "clipUntil": clipUntil,
                                  "overloadLatched": meter.overloadLatched === true})
            }
            root.trackMeterState = next
            root.updateMasterLoudness(next)
        }
    }

    onSourcePanelCollapsedChanged: {
        if (!root.forceCollapsedSourcePanelForPerformanceProbe)
            timelineWorkspaceSettings.sourcePanelCollapsed = sourcePanelCollapsed
        if (!sourcePanelCollapsed)
            sourcePanelEverExpanded = true
        scheduleWorkspaceLayoutSave()
    }
    onSourcePanelHiddenChanged: {
        timelineWorkspaceSettings.sourcePanelHidden = sourcePanelHidden
        scheduleWorkspaceLayoutSave()
    }
    onSourcePanelDetachedChanged: {
        if (sourcePanelDetached)
            detachedSourceWindow.contentRequested = true
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout) {
            const panelId = sourceRailTab === "source" ? "source" : "media"
            if (sourcePanelDetached) panelDockState.floatPanel(panelId)
            else if (panelDockState.dock(panelId) === "floating") panelDockState.dockPanel(panelId)
        }
        scheduleWorkspaceLayoutSave()
    }
    onEffectsPanelDetachedChanged: {
        if (effectsPanelDetached)
            detachedInspectorWindow.contentRequested = true
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout) {
            if (effectsPanelDetached) panelDockState.floatPanel("inspector")
            else if (panelDockState.dock("inspector") === "floating") panelDockState.dockPanel("inspector")
        }
        scheduleWorkspaceLayoutSave()
    }
    onProgramScopesDetachedChanged: {
        if (programScopesDetached)
            programScopesWindow.contentRequested = true
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout) {
            if (programScopesDetached) panelDockState.floatPanel("scopes")
            else if (panelDockState.dock("scopes") === "floating") panelDockState.dockPanel("scopes")
        }
        scheduleWorkspaceLayoutSave()
    }
    onEffectsPanelCollapsedChanged: {
        if (!root.forceCollapsedInspectorForPerformanceProbe)
            timelineWorkspaceSettings.effectsPanelCollapsed = effectsPanelCollapsed
        if (!effectsPanelCollapsed)
            effectsPanelEverExpanded = true
        scheduleWorkspaceLayoutSave()
    }
    onTimelineAdvancedControlsVisibleChanged: timelineWorkspaceSettings.advancedControlsVisible = timelineAdvancedControlsVisible
    onTimelineLayoutPresetChanged: {
        if (workspacePanelSettingsInitialized)
            timelineWorkspaceSettings.timelineLayoutPreset = timelineLayoutPreset
    }
    onSourceRailTabChanged: {
        timelineWorkspaceSettings.sourceRailTab = sourceRailTab
        scheduleWorkspaceLayoutSave()
    }
    onInspectorTabChanged: {
        if (root.sharedColorEditor && inspectorTab === "color")
            Qt.callLater(function() { if (root.panelDockingReady) root.showSharedColorTools("adjust") })
        scheduleWorkspaceLayoutSave()
        timelineWorkspaceSettings.inspectorTab = inspectorTab
        const selectionType = currentInspectorSelectionType()
        if (inspectorTabValidForType(inspectorTab, selectionType)) {
            const updated = Object.assign({}, inspectorTabsByType)
            updated[selectionType] = inspectorTab
            inspectorTabsByType = updated
            timelineWorkspaceSettings.inspectorTabsByTypeJson = JSON.stringify(updated)
        }
    }
    onSourcePanelWidthChanged: {
        timelineWorkspaceSettings.sourcePanelWidth = sourcePanelWidth
        scheduleWorkspaceLayoutSave()
    }
    onEffectsPanelWidthChanged: {
        timelineWorkspaceSettings.effectsPanelWidth = effectsPanelWidth
        scheduleWorkspaceLayoutSave()
    }
    onCurveEditorDockedChanged: {
        timelineWorkspaceSettings.curveEditorDocked = curveEditorDocked
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout) {
            if (curveEditorDocked && panelDockState.dock("keyframes") === "floating")
                panelDockState.dockPanel("keyframes")
            else if (!curveEditorDocked && panelDockState.dock("keyframes") !== "floating")
                panelDockState.floatPanel("keyframes")
        }
        scheduleWorkspaceLayoutSave()
    }
    onCurveEditorOpenChanged: {
        if (!curveEditorOpen) keyframeCurveWindow.endCurveGesture()
        timelineWorkspaceSettings.curveEditorOpen = curveEditorOpen
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout) {
            if (curveEditorOpen)
                panelDockState.focusPanel("keyframes")
            else
                panelDockState.setVisible("keyframes", false)
        }
        scheduleWorkspaceLayoutSave()
    }
    onCurveEditorDockWidthChanged: {
        timelineWorkspaceSettings.curveEditorDockWidth = curveEditorDockWidth
        scheduleWorkspaceLayoutSave()
    }
    onMonitorPanelHeightChanged: {
        monitorPanelHeightPersistenceTimer.restart()
        scheduleWorkspaceLayoutSave()
    }
    onLaneHeaderWidthChanged: timelineWorkspaceSettings.laneHeaderWidth = laneHeaderWidth
    onTrackVerticalLayoutChanged: {
        root.scheduleVirtualizedTimelineTrackRowsRefresh(true)
        if (root.pendingTimelineTrackReveal)
            timelineTrackRevealTimer.restart()
        Qt.callLater(function() {
            if (timelineViewport)
                timelineViewport.contentY = Math.max(0, Math.min(timelineViewport.contentY,
                        root.timelineContentHeight + root.timelineViewportBottomInset - timelineViewport.height))
        })
    }
    onTrackHeightsChanged: {
        timelineWorkspaceSettings.trackHeightsJson = JSON.stringify(trackHeights)
        root.refreshVirtualizedTimelineTrackRows(true)
    }
    onTimelineTrackFocusModeChanged: root.refreshVirtualizedTimelineTrackRows(true)
    onTimelineTrackFocusExpandedIdsChanged: root.refreshVirtualizedTimelineTrackRows(true)
    onTimelineTrackFocusHeightOverridesChanged: root.refreshVirtualizedTimelineTrackRows(true)
    onTimelineZoomChanged: {
        timelineWorkspaceSettings.timelineZoom = timelineZoom
        root.refreshTimelineClipVirtualizationWindow(true)
        timelineTrackWindowTimer.restart()
        root.scheduleBackgroundWorkIntentPublish()
    }
