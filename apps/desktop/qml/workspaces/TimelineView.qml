    Window {
        id: keyframeCurveWindow
        property bool contentCreated: false
        readonly property var curveGraphItem:
            keyframeCurveContentLoader.item ? keyframeCurveContentLoader.item.curveGraphItem : null
        readonly property var curveCanvasItem:
            keyframeCurveContentLoader.item ? keyframeCurveContentLoader.item.curveCanvasItem : null
        objectName: "timelineKeyframeCurveWindow"
        title: "Curve Editor — " + root.keyframeParameterLabel(root.curveEditorParameter)
        transientParent: root.Window.window
        flags: Qt.Tool
        width: 1020
        height: 700
        minimumWidth: 760
        minimumHeight: 600
        color: theme.ink950
        visible: false

        readonly property bool trackAutomationMode: root.curveEditorTarget === "track"
        readonly property var trackData: trackAutomationMode ? root.curveEditorTrackData() : null
        readonly property int trackRowIndex: trackAutomationMode
                                             ? root.curveEditorTrackRowIndex() : -1
        readonly property var curveKeyframes: trackAutomationMode
                                               ? root.trackAutomationKeyframes(
                                                     trackData, root.curveEditorParameter)
                                               : root.keyframesForClipParameter(
                                                     root.currentClip, root.curveEditorParameter)
        readonly property var parameterBounds: trackAutomationMode
                                                ? root.trackAutomationBounds(root.curveEditorParameter)
                                                : root.keyframeParameterBounds(root.curveEditorParameter)
        readonly property real curveDuration: Math.max(
            0.001,
            trackAutomationMode ? root.sequenceDurationSeconds()
                                : Number(root.currentClip.trimmedDurationSeconds || 0))
        readonly property real curvePlayheadSeconds: Number(timelineDocument.sequencePlayheadSeconds || 0)
            - (trackAutomationMode ? 0 : Number(root.currentClip.startSeconds || 0))
        readonly property real curveSpeedMagnitudeValue: computeCurveSpeedMagnitude()
        property string graphMode: "value"
        property var selectedSeconds: []
        property bool fitGraphValues: true
        property var frozenDisplayBounds: null
        readonly property var displayBounds: {
            if (frozenDisplayBounds) return frozenDisplayBounds
            if (!fitGraphValues || curveKeyframes.length < 2) return parameterBounds
            let low = Infinity
            let high = -Infinity
            for (const key of curveKeyframes) {
                const value = Number(key.value)
                low = Math.min(low, value, value + Number(key.bezierInValue || 0), value + Number(key.bezierOutValue || 0))
                high = Math.max(high, value, value + Number(key.bezierInValue || 0), value + Number(key.bezierOutValue || 0))
            }
            const span = Math.max(high - low, (Number(parameterBounds.maximum) - Number(parameterBounds.minimum)) * 0.05)
            return {minimum: low - span * 0.15, maximum: high + span * 0.15}
        }
        function beginCurveGesture() {
            frozenDisplayBounds = displayBounds
            timelineDocument.beginContinuousEdit()
        }
        function endCurveGesture() {
            timelineDocument.endContinuousEdit()
            frozenDisplayBounds = null
        }
        onDisplayBoundsChanged: if (curveCanvasItem) curveCanvasItem.requestPaint()

        function sequenceSecondsForCurve(seconds) {
            return Number(seconds || 0)
                    + (trackAutomationMode ? 0 : Number(root.currentClip.startSeconds || 0))
        }

        function seekCurveSeconds(seconds) {
            timelineDocument.seekSequenceSeconds(sequenceSecondsForCurve(seconds))
        }

        function updateCurveKeyframe(fromSeconds, toSeconds, value) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.updateTrackAutomationKeyframe(
                    trackRowIndex, root.curveEditorParameter,
                    fromSeconds, toSeconds, value)
            }
            const moved = timelineDocument.moveSelectedClipKeyframe(
                root.curveEditorParameter, fromSeconds, toSeconds)
            const updated = timelineDocument.setSelectedClipKeyframeValue(
                root.curveEditorParameter, toSeconds, value)
            return moved || updated
        }

        function setCurveKeyframeSpeed(seconds, side, value) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.setTrackAutomationKeyframeSpeedForSide(
                    trackRowIndex, root.curveEditorParameter, seconds, side, value)
            }
            return timelineDocument.setSelectedClipKeyframeSpeedForSide(
                root.curveEditorParameter, seconds, side, value)
        }

        function editSelectedCurveKeyframe(timeText, valueText) {
            const selected = selectedCurveKeyframe()
            const seconds = Number(timeText)
            const value = Number(valueText)
            if (!selected || !isFinite(seconds) || !isFinite(value)) return
            const boundedSeconds = Math.max(0, Math.min(curveDuration, seconds))
            const boundedValue = Math.max(parameterBounds.minimum, Math.min(parameterBounds.maximum, value))
            if (Math.abs(boundedSeconds - Number(selected.seconds)) < 0.000001
                    && Math.abs(boundedValue - Number(selected.value)) < 0.000001) return
            keyframeCurveWindow.beginCurveGesture()
            try {
                updateCurveKeyframe(Number(selected.seconds), boundedSeconds, boundedValue)
                selectCurveSecond(boundedSeconds, false)
            } finally {
                keyframeCurveWindow.endCurveGesture()
            }
        }

        function setCurveKeyframeInterpolation(seconds, interpolation) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.setTrackAutomationKeyframeInterpolation(
                    trackRowIndex, root.curveEditorParameter, seconds, interpolation)
            }
            return timelineDocument.setSelectedClipKeyframeInterpolation(
                root.curveEditorParameter, seconds, interpolation)
        }

        function setCurveSelectionInterpolation(interpolation) {
            const seconds = selectedSeconds.slice()
            if (!seconds.length) return
            if (!trackAutomationMode) {
                timelineDocument.setSelectedClipKeyframeSelectionInterpolation(
                    root.curveEditorParameter, seconds, interpolation)
                return
            }
            const changed = seconds.filter(second => curveKeyframes.some(key =>
                Math.abs(Number(key.seconds) - Number(second)) < 0.001
                && String(key.interpolation) !== interpolation))
            if (!changed.length) return
            keyframeCurveWindow.beginCurveGesture()
            try {
                for (const second of changed) setCurveKeyframeInterpolation(second, interpolation)
            } finally {
                keyframeCurveWindow.endCurveGesture()
            }
        }

        function curveSelectionInterpolation() {
            let result = ""
            for (const key of curveKeyframes) {
                if (!isCurveSecondSelected(Number(key.seconds))) continue
                const mode = String(key.interpolation || "linear")
                if (result && mode !== result) return "mixed"
                result = mode
            }
            return result || "linear"
        }

        function setCurveBezierHandle(seconds, side, timeOffset, valueOffset) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.setTrackAutomationKeyframeBezierHandle(
                    trackRowIndex, root.curveEditorParameter, seconds,
                    side, timeOffset, valueOffset)
            }
            return timelineDocument.setSelectedClipKeyframeBezierHandle(
                root.curveEditorParameter, seconds, side, timeOffset, valueOffset)
        }

        function setCurveBezierHandlesLinked(seconds, linked) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.setTrackAutomationKeyframeBezierHandlesLinked(
                    trackRowIndex, root.curveEditorParameter, seconds, linked)
            }
            return timelineDocument.setSelectedClipKeyframeBezierHandlesLinked(
                root.curveEditorParameter, seconds, linked)
        }

        function removeCurveKeyframe(seconds) {
            if (trackAutomationMode) {
                return trackRowIndex >= 0 && timelineDocument.removeTrackAutomationKeyframe(
                    trackRowIndex, root.curveEditorParameter, seconds)
            }
            return timelineDocument.removeSelectedClipKeyframe(root.curveEditorParameter, seconds)
        }

        function addCurveKeyframe(seconds) {
            if (trackAutomationMode) {
                if (!trackData || trackRowIndex < 0)
                    return false
                for (let index = 0; index < curveKeyframes.length; ++index) {
                    if (Math.abs(Number(curveKeyframes[index].seconds || 0) - seconds)
                            <= 0.5 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)))
                        return false
                }
                timelineDocument.seekSequenceSeconds(seconds)
                return timelineDocument.toggleTrackAutomationKeyframe(
                    trackRowIndex, root.curveEditorParameter)
            }
            for (let index = 0; index < curveKeyframes.length; ++index) {
                if (Math.abs(Number(curveKeyframes[index].seconds || 0) - seconds)
                        <= 0.5 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)))
                    return false
            }
            timelineDocument.seekSequenceSeconds(
                Number(root.currentClip.startSeconds || 0) + seconds)
            return timelineDocument.toggleSelectedClipKeyframe(root.curveEditorParameter)
        }

        function clearCurveSelection() {
            selectedSeconds = []
            root.curveEditorSelectedSeconds = -1
        }

        function isCurveSecondSelected(seconds) {
            const target = Number(seconds || 0)
            for (let index = 0; index < selectedSeconds.length; ++index) {
                if (Math.abs(Number(selectedSeconds[index]) - target) < 0.001)
                    return true
            }
            return false
        }

        function selectCurveSecond(seconds, additive) {
            const target = Number(seconds || 0)
            let next = additive ? selectedSeconds.slice(0) : []
            let existing = -1
            for (let index = 0; index < next.length; ++index) {
                if (Math.abs(Number(next[index]) - target) < 0.001) {
                    existing = index
                    break
                }
            }
            if (additive && existing >= 0) {
                next.splice(existing, 1)
            } else if (existing < 0) {
                next.push(target)
            }
            next.sort(function(left, right) { return Number(left) - Number(right) })
            selectedSeconds = next
            root.curveEditorSelectedSeconds = next.length > 0
                                              ? target : -1
        }

        function pruneCurveSelection() {
            const next = []
            for (let selectionIndex = 0; selectionIndex < selectedSeconds.length; ++selectionIndex) {
                const seconds = Number(selectedSeconds[selectionIndex])
                for (let keyIndex = 0; keyIndex < curveKeyframes.length; ++keyIndex) {
                    if (Math.abs(Number(curveKeyframes[keyIndex].seconds || 0) - seconds) < 0.001) {
                        next.push(seconds)
                        break
                    }
                }
            }
            selectedSeconds = next
            if (!isCurveSecondSelected(root.curveEditorSelectedSeconds))
                root.curveEditorSelectedSeconds = next.length > 0 ? Number(next[next.length - 1]) : -1
        }

        function curveValueAt(localSeconds) {
            const values = curveKeyframes
            if (values.length === 0)
                return parameterBounds.minimum
            if (localSeconds <= Number(values[0].seconds || 0))
                return Number(values[0].value || 0)
            if (localSeconds >= Number(values[values.length - 1].seconds || 0))
                return Number(values[values.length - 1].value || 0)
            for (let index = 0; index + 1 < values.length; ++index) {
                const left = values[index]
                const right = values[index + 1]
                const leftSeconds = Number(left.seconds || 0)
                const rightSeconds = Number(right.seconds || 0)
                if (localSeconds > rightSeconds)
                    continue
                return root.interpolatedKeyframeValue(
                    left,
                    right,
                    (localSeconds - leftSeconds)
                    / Math.max(0.0001, rightSeconds - leftSeconds))
            }
            return Number(values[values.length - 1].value || 0)
        }

        function curveSpeedAt(localSeconds) {
            const step = Math.max(1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)),
                                  curveDuration / 1000)
            const left = Math.max(0, Number(localSeconds || 0) - step)
            const right = Math.min(curveDuration, Number(localSeconds || 0) + step)
            if (right <= left)
                return 0
            return (curveValueAt(right) - curveValueAt(left)) / (right - left)
        }

        function computeCurveSpeedMagnitude() {
            let magnitude = 0.001
            for (let sample = 0; sample <= 120; ++sample) {
                magnitude = Math.max(magnitude, Math.abs(
                    curveSpeedAt(curveDuration * sample / 120)))
            }
            const range = Math.max(0.001,
                                   Number(displayBounds.maximum)
                                   - Number(displayBounds.minimum))
            return Math.max(magnitude, range / Math.max(0.001, curveDuration) * 2)
        }

        function keyframeSpeedAtIndex(index) {
            const values = curveKeyframes
            if (values.length < 2 || index < 0 || index >= values.length)
                return 0
            return curveSpeedAt(Number(values[index].seconds || 0))
        }

        function keyframeSpeedOnSide(index, side) {
            const values = curveKeyframes
            if (index < 0 || index >= values.length)
                return 0
            const incoming = String(side || "") === "in"
            const neighborIndex = incoming ? index - 1 : index + 1
            if (neighborIndex < 0 || neighborIndex >= values.length)
                return 0
            const currentSeconds = Number(values[index].seconds || 0)
            const neighborSeconds = Number(values[neighborIndex].seconds || 0)
            const span = Math.abs(currentSeconds - neighborSeconds)
            const step = Math.min(
                span * 0.25,
                Math.max(1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)),
                         curveDuration / 1000))
            if (step <= 0)
                return 0
            const sampleSeconds = incoming ? currentSeconds - step : currentSeconds + step
            const currentValue = curveValueAt(currentSeconds)
            const sampleValue = curveValueAt(sampleSeconds)
            return incoming
                    ? (currentValue - sampleValue) / step
                    : (sampleValue - currentValue) / step
        }

        function graphYForSpeed(speed) {
            const magnitude = curveSpeedMagnitudeValue
                    return theme.space16
                            + (1 - (Number(speed || 0) + magnitude) / (magnitude * 2))
                              * Math.max(1, keyframeCurveWindow.curveGraphItem.height - theme.space16 * 2)
        }

        function graphSpeedForY(y) {
            const graphHeight = Math.max(1, keyframeCurveWindow.curveGraphItem.height - theme.space16 * 2)
            const progress = Math.max(0, Math.min(
                1, (Number(y || 0) - theme.space16) / graphHeight))
            return curveSpeedMagnitudeValue * (1 - progress * 2)
        }

        function selectedCurveKeyframe() {
            for (let index = 0; index < curveKeyframes.length; ++index) {
                if (Math.abs(Number(curveKeyframes[index].seconds || 0)
                             - root.curveEditorSelectedSeconds) < 0.001)
                    return curveKeyframes[index]
            }
            return null
        }

        function selectedCurveKeyframeIndex() {
            for (let index = 0; index < curveKeyframes.length; ++index) {
                if (Math.abs(Number(curveKeyframes[index].seconds || 0)
                             - root.curveEditorSelectedSeconds) < 0.001)
                    return index
            }
            return -1
        }

        function graphXForSeconds(seconds) {
            return theme.space16
                    + Math.max(0, Math.min(curveDuration, Number(seconds || 0)))
                      / curveDuration * Math.max(1, keyframeCurveWindow.curveGraphItem.width - theme.space16 * 2)
        }

        function graphYForValue(value) {
            const minimum = Number(displayBounds.minimum)
            const maximum = Number(displayBounds.maximum)
            return theme.space16
                    + (1 - (Number(value || 0) - minimum)
                       / Math.max(0.0001, maximum - minimum))
                      * Math.max(1, keyframeCurveWindow.curveGraphItem.height - theme.space16 * 2)
        }

        function graphSecondsForX(x) {
            return Math.max(0, Math.min(
                curveDuration,
                (Number(x || 0) - theme.space16)
                / Math.max(1, keyframeCurveWindow.curveGraphItem.width - theme.space16 * 2)
                * curveDuration))
        }

        function graphValueForY(y) {
            const minimum = Number(displayBounds.minimum)
            const maximum = Number(displayBounds.maximum)
            return maximum
                    - Math.max(0, Math.min(1,
                        (Number(y || 0) - theme.space16)
                        / Math.max(1, keyframeCurveWindow.curveGraphItem.height - theme.space16 * 2)))
                      * (maximum - minimum)
        }

        function bezierHandlePoint(side) {
            if (graphMode !== "value")
                return ({"visible": false, "x": 0, "y": 0})
            const index = selectedCurveKeyframeIndex()
            if (index < 0)
                return ({"visible": false, "x": 0, "y": 0})
            const selected = curveKeyframes[index]
            if (side === "out") {
                if (index + 1 >= curveKeyframes.length
                        || String(selected.interpolation || "") !== "bezier")
                    return ({"visible": false, "x": 0, "y": 0})
                const next = curveKeyframes[index + 1]
                const span = Number(next.seconds || 0) - Number(selected.seconds || 0)
                const timeOffset = selected.bezierOutCustom === true
                                   ? Number(selected.bezierOutTimeSeconds || 0) : span / 3
                const valueOffset = selected.bezierOutCustom === true
                                    ? Number(selected.bezierOutValue || 0) : 0
                return ({
                    "visible": true,
                    "x": graphXForSeconds(Number(selected.seconds || 0) + timeOffset),
                    "y": graphYForValue(Number(selected.value || 0) + valueOffset)
                })
            }
            if (index === 0
                    || String(curveKeyframes[index - 1].interpolation || "") !== "bezier")
                return ({"visible": false, "x": 0, "y": 0})
            const previous = curveKeyframes[index - 1]
            const span = Number(selected.seconds || 0) - Number(previous.seconds || 0)
            const timeOffset = selected.bezierInCustom === true
                               ? Number(selected.bezierInTimeSeconds || 0) : -span / 3
            const valueOffset = selected.bezierInCustom === true
                                ? Number(selected.bezierInValue || 0) : 0
            return ({
                "visible": true,
                "x": graphXForSeconds(Number(selected.seconds || 0) + timeOffset),
                "y": graphYForValue(Number(selected.value || 0) + valueOffset)
            })
        }

        function selectedCurveHasBezierHandles() {
            const index = selectedCurveKeyframeIndex()
            if (index < 0)
                return false
            return String(curveKeyframes[index].interpolation || "") === "bezier"
                    || (index > 0
                        && String(curveKeyframes[index - 1].interpolation || "") === "bezier")
        }

        onCurveKeyframesChanged: {
            pruneCurveSelection()
            if (keyframeCurveWindow.curveCanvasItem) keyframeCurveWindow.curveCanvasItem.requestPaint()
        }
        onParameterBoundsChanged: if (keyframeCurveWindow.curveCanvasItem) keyframeCurveWindow.curveCanvasItem.requestPaint()
        onGraphModeChanged: if (keyframeCurveWindow.curveCanvasItem) keyframeCurveWindow.curveCanvasItem.requestPaint()
        onCurvePlayheadSecondsChanged: if (visible && curveCanvasItem) curveCanvasItem.requestPaint()

        Loader {
            id: keyframeCurveContentLoader
            anchors.fill: parent
            active: keyframeCurveWindow.contentCreated || keyframeCurveWindow.visible
            onLoaded: Qt.callLater(() => keyframeCurveWindow.contentCreated = true)
            sourceComponent: Component {
                GlassSurface {
                    property alias curveGraphItem: curveGraph
                    property alias curveCanvasItem: curveCanvas
                    anchors.fill: parent
                    anchors.margins: theme.panelPaddingCompact
                    radius: theme.radiusPanel
                    elevated: true
                    edgeOpacity: 0

                    ColumnLayout {
                        anchors.fill: parent
                        anchors.margins: theme.panelPaddingCompact
                        spacing: theme.space8

                        RowLayout {
                            Layout.fillWidth: true
                            spacing: theme.space6

                            ColumnLayout {
                                Layout.fillWidth: true
                                spacing: theme.space2

                                Label {
                                    text: keyframeCurveWindow.trackAutomationMode
                                          ? String(keyframeCurveWindow.trackData
                                                   ? keyframeCurveWindow.trackData.trackName || "Track"
                                                   : "Track")
                                            + " · " + root.keyframeParameterLabel(root.curveEditorParameter)
                                          : String(root.currentClip.displayLabel || "Clip") + " · "
                                            + root.keyframeParameterLabel(root.curveEditorParameter)
                                    Layout.fillWidth: true
                                    elide: Text.ElideRight
                                    color: theme.textStrong
                                    font.family: theme.fontUi
                                    font.pixelSize: theme.typeTitle
                                    font.weight: Font.DemiBold
                                }

                                Label {
                                    text: keyframeCurveWindow.trackAutomationMode
                                          ? keyframeCurveWindow.curveKeyframes.length + " track keyframes  ·  "
                                            + keyframeCurveWindow.selectedSeconds.length + " selected  ·  Shift/Cmd-click to add"
                                          : root.curveEditorParameter === "sourceTime"
                                          ? keyframeCurveWindow.curveKeyframes.length + " points  ·  horizontal is timeline time, vertical is source time"
                                          : keyframeCurveWindow.curveKeyframes.length + " keyframes  ·  "
                                            + keyframeCurveWindow.selectedSeconds.length + " selected  ·  Shift/Cmd-click to add"
                                    Layout.fillWidth: true
                                    elide: Text.ElideRight
                                    color: theme.textMuted
                                    font.family: theme.fontMono
                                    font.pixelSize: theme.typeCaption
