                String(record.comparisonMediaUrl || "").length === 0)
            return false
        programComparisonBypassEffects = false
        programComparisonReferenceGrabResult = null
        programComparisonReferenceSource = String(record.comparisonMediaUrl)
        programComparisonReferenceFilePath = String(record.comparisonMediaPath || "")
        programComparisonReferenceKind = "previous-version"
        programComparisonReferenceLabel = "Version · " + String(record.label || "Saved")
        programComparisonReferenceSeconds = Number(record.comparisonFrameSeconds || 0)
        refreshProgramComparisonCurrentFrame()
        return true
