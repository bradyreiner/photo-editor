            timelineDocument.applyOutputPreset(key.substring(8))
    }

    function handleTimelineZoomMenuAction(key) {
        const anchor = timelineViewport.contentX + timelineViewport.width / 2
        if (key === "zoom-out")
            root.setTimelineZoom(root.timelineZoom / 1.35, anchor)
        else if (key === "zoom-in")
            root.setTimelineZoom(root.timelineZoom * 1.35, anchor)
        else if (key === "zoom-100")
            root.setTimelineZoom(84, anchor)
        else if (key === "zoom-fit")
            root.zoomToFit()
        else if (key === "zoom-selection")
            root.zoomToSelection()
        else if (key === "view-expand")
            root.timelineFocusModeActive = !root.timelineFocusModeActive
        else if (key === "view-focus")
            root.toggleTimelineTrackFocus()
        else if (key === "view-follow-playhead") {
            root.followTimelinePlayhead = !root.followTimelinePlayhead
            if (root.followTimelinePlayhead && root.sequencePlaying)
                root.followTimelinePlayheadIfNeeded()
        }
        else if (key === "view-overview")
            timelineWorkspaceSettings.overviewVisible = !timelineWorkspaceSettings.overviewVisible
        else if (key === "view-reset-lanes")
            root.setTimelineLaneScale(1, 0)
        else if (key === "view-markers")
            root.markerReviewExpanded = !root.markerReviewExpanded
        else if (key.indexOf("section:") === 0)
            root.focusTimelineSection(key.substring(8))
    }

