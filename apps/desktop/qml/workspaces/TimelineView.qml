                                              Math.max(0, timelineViewport.contentWidth - timelineViewport.width),
                                              timelineViewport.contentX + timelineViewport.width * 0.25)

                    readonly property real barDuration: Math.max(1, sequenceDurationSeconds())
                    readonly property real barScale: (width - 4) / barDuration

                    Canvas {
                        id: timelineMinimapCanvas
                        objectName: "timelineMinimapCanvas"
                        anchors.fill: parent
                        readonly property var trackModel: root.sequenceTrackModel
                        readonly property real scale: minimapBar.barScale
                        renderStrategy: Canvas.Cooperative

                        onTrackModelChanged: requestPaint()
                        onScaleChanged: requestPaint()
                        onWidthChanged: requestPaint()
                        onHeightChanged: requestPaint()

                        onPaint: {
                            const context = getContext("2d")
                            context.reset()
                            context.clearRect(0, 0, width, height)
                            const tracks = trackModel || []
                            for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
                                const track = tracks[trackIndex]
                                const clips = track && track.clips ? track.clips : []
                                context.fillStyle = track && track.trackKind === "audio"
                                                    ? theme.alpha(theme.audioAccent, 0.5)
                                                    : theme.alpha(theme.primaryAccent, 0.5)
                                for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                                    const clip = clips[clipIndex]
                                    const x = 2 + Number(clip && clip.startSeconds || 0) * scale
                                    const clipWidth = Math.max(
                                                        2,
                                                        Number(clip && clip.trimmedDurationSeconds || 0) * scale)
                                    context.fillRect(x, 2, clipWidth, Math.max(1, height - 4))
                                }
                            }
                        }
                    }

