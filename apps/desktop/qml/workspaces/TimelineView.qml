        }

        background: PopupSurface {}

        contentItem: Loader {
            active: colorFinishingPopup.contentCreated || colorFinishingPopup.visible
            onLoaded: colorFinishingPopup.contentCreated = true
            sourceComponent: Component {
                ColumnLayout {
                    property alias scopesCanvas: colorScopesCanvas
                    property alias referenceCombo: colorReferenceCombo
                    spacing: theme.space10

                    RowLayout {
                        Layout.fillWidth: true
                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: theme.space2
                            Label {
                                text: "Color Finishing"
                                color: theme.textStrong
