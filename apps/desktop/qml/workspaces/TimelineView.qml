    function scenePointSelectionPrompt() {
        return "Click three widely spaced visible features on one plane · source "
                + Number(root.scenePointFrameSourceSeconds || 0).toFixed(3) + " s."
    }

    function beginScenePointSelection(clipId, selectedIds) {
        const row = root.sceneTrackingSourceRow(clipId)
        if (!row) {
            root.motionTrackingUiMessage = "Solve this source clip first to reconstruct selectable static scene points."
            return false
        }
        timelinePlayback.pause()
        const frame = timelineDocument.sceneTrackPointFrame(String(clipId), Number(root.sequencePlayheadSeconds || 0))
        if (!frame || frame.success !== true) {
            root.motionTrackingUiMessage = String(frame && frame.message || "Move the paused playhead inside the selected source shot to choose scene points.")
            return false
        }
        root.scenePointSourceClipId = String(clipId)
        root.scenePointSelectionDraftIds = root.scenePointSelectionSourceClipId === String(clipId)
                ? (selectedIds || root.scenePointSelectionIds || []).slice(0) : []
        root.scenePointFrameSourceSeconds = Number(frame.sourceSeconds || 0)
        root.scenePointFrameSource = String(frame.path || "")
        root.scenePointFramePoints = frame.points || []
        root.scenePointFrameWidth = Number(frame.width || 0)
        root.scenePointFrameHeight = Number(frame.height || 0)
        root.scenePointFrameAwaiting = root.scenePointFrameSource.length > 0
        root.scenePointSelectionMessage = root.scenePointFrameAwaiting
                ? "Loading the selected source frame and its reconstructed points…"
                : root.scenePointSelectionPrompt()
        root.scenePointSelectionHudVisible = true
        root.scenePointSelectionActive = true
        if (!root.scenePointFrameAwaiting) {
            root.scenePointSelectionActive = false
            root.scenePointSelectionHudVisible = false
