                                readonly property real originX: selectedKeyframe
                                                                ? keyframeCurveWindow.graphXForSeconds(
                                                                    Number(selectedKeyframe.seconds || 0)) : 0
                                readonly property real originY: selectedKeyframe
                                                                ? keyframeCurveWindow.graphYForValue(
                                                                    Number(selectedKeyframe.value || 0)) : 0
                                visible: bezierOutHandle.visible
                                x: originX
                                y: originY
                                width: Math.hypot(
