    function clipSourceUrl() {
        return timelineDocument.playbackSourceUrl ? timelineDocument.playbackSourceUrl : ""
    }

    function previewQualityLabel() {
        if (previewQualityMode === "full")
            return "Full"
        if (previewQualityMode === "half")
            return "Half"
        if (previewQualityMode === "quarter")
            return "Quarter"
        if (previewQualityMode === "proxy")
            return "Proxy"
        if (previewQualityMode === "clip")
            return "Clip setting"
        return "Auto"
    }

    function toggleKeyboardTrimEdge() {
        if (timelineDocument.currentIndex < 0) {
            root.showMarkerFeedback("Select a clip before choosing a trim edge.")
            return
        }
        keyboardTrimEdge = keyboardTrimEdge === "start" ? "end" : "start"
        timelineDocument.activeTool = "trim"
        editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        root.showMarkerFeedback(keyboardTrimEdge === "start"
                                ? "Keyboard trim: In edge"
                                : "Keyboard trim: Out edge")
    }

    function showMarkerFeedback(message) {
        markerFeedbackText = message
        markerFeedbackVisible = true
        markerFeedbackTimer.restart()
    }

    function nudgeKeyboardTrim(frameDelta, asymmetricLinkedAv) {
        if (keyboardTrimEdge.length === 0) {
            root.showMarkerFeedback("Press T to select the In trim edge first.")
            return
        }
        if (timelineDocument.nudgeSelectedTrimEdge(
                    keyboardTrimEdge, frameDelta,
                    asymmetricLinkedAv === true, rippleModeEnabled))
            editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
    }

    function navigateEditPoint(direction) {
        const boundary = Number(editPointData.boundarySeconds || sequencePlayheadSeconds)
        const selected = timelineDocument.selectAdjacentEditPoint(boundary, direction)
        if (!selected || String(selected.schema || "").length === 0)
            return
        keyboardTrimEdge = String(selected.edge || (direction < 0 ? "end" : "start"))
        editPointData = selected
        timelineDocument.activeTool = "trim"
    }

    function openEditPointDetails(invoker) {
        editPointFocusReturnItem = invoker || null
        editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        if (!editPointData || String(editPointData.schema || "").length === 0)
            return
        editPointPopup.open()
    }

    function switchEditPointSide() {
        const selected = timelineDocument.selectOtherEditPointSide(keyboardTrimEdge)
        if (!selected || String(selected.schema || "").length === 0)
            return
        keyboardTrimEdge = String(selected.edge || keyboardTrimEdge)
        editPointData = selected
    }

    function openSelectSimilar(invoker) {
        similarSelectionFocusReturnItem = invoker || null
        similarSelectionOptions = timelineDocument.selectedClipSimilarityOptions()
        similarSelectionConstraints = []
        for (let index = 0; index < similarSelectionOptions.length; ++index) {
            if (similarSelectionOptions[index].available === true
                    && String(similarSelectionOptions[index].key) === "media-type") {
                similarSelectionConstraints = ["media-type"]
                break
            }
        }
        similarSelectionPopup.open()
    }

    function toggleSimilarConstraint(key) {
        let updated = similarSelectionConstraints.slice(0)
        const index = updated.indexOf(key)
        if (index >= 0)
            updated.splice(index, 1)
        else
            updated.push(key)
        similarSelectionConstraints = updated
    }

    function openPasteAttributes(invoker) {
        pasteAttributesFocusReturnItem = invoker || null
        pasteAttributesComparisonData = timelineDocument.pasteAttributesComparison()
        pasteAttributeCategories = []
        const categories = pasteAttributesComparisonData.categories || []
