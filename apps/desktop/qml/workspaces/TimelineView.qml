    function beginRotoscopeCorrection() {
        if (!currentClip || currentClip.rotoCorrectionReady !== true) {
            motionTrackingUiMessage = "Analyze this source clip with SAM2 before refining its matte."
            return false
        }
        timelinePlayback.pause()
        const frame = documentController.rotoscopeCorrectionFrame()
        if (!frame || frame.success !== true) {
            motionTrackingUiMessage = String(frame && frame.message
                    || "Pause the playhead inside the analyzed source shot to add correction points.")
            return false
        }
        rotoCorrectionFrameSource = String(frame.path || "")
        rotoCorrectionClipId = String(currentClip.clipId || "")
        rotoCorrectionSourceSeconds = Number(frame.sourceSeconds || 0)
        rotoCorrectionFrameIndex = Number(frame.frameIndex || 0)
        rotoCorrectionFrameWidth = Number(currentClip.sourceWidth || 0)
        rotoCorrectionFrameHeight = Number(currentClip.sourceHeight || 0)
        rotoCorrectionDraftPoints = (frame.points || []).slice(0)
        rotoCorrectionNegativeMode = false
        rotoCorrectionAwaitingFrame = rotoCorrectionFrameSource.length === 0
        if (rotoCorrectionAwaitingFrame) {
            motionTrackingUiMessage = "The cached paused source frame is unavailable. Retry after the frame cache is ready."
            return false
        }
        rotoCorrectionOverlayVisible = true
        motionTrackingPopup.close()
        return true
    }

    function finishRotoscopeCorrection(accept) {
        rotoCorrectionOverlayVisible = false
        rotoCorrectionAwaitingFrame = false
        if (accept && String(currentClip.clipId || "") !== rotoCorrectionClipId) {
            motionTrackingUiMessage = "The selected source changed. Open Refine Matte on the intended source again."
        } else if (accept && rotoCorrectionDraftPoints.length > 0) {
            const frame = documentController.rotoscopeCorrectionFrame()
            if (!frame || frame.success !== true || Number(frame.frameIndex) !== rotoCorrectionFrameIndex
                    || Math.abs(Number(frame.sourceSeconds) - rotoCorrectionSourceSeconds) > 0.000001) {
                motionTrackingUiMessage = "The source frame changed. Open Refine Matte again on the intended frame."
            } else {
                const started = documentController.correctSelectedRotoscope(rotoCorrectionDraftPoints)
                motionTrackingUiMessage = started
                        ? "SAM2 is re-running the full source shot with these correction points."
                        : "Could not start SAM2 correction. Keep the source selected and the playhead paused inside its shot, then retry."
            }
        } else {
            motionTrackingUiMessage = accept
                    ? "Add at least one positive or negative point before applying corrections."
                    : "SAM2 matte correction cancelled."
        }
        motionTrackingPopup.open()
    }

    function removeLastRotoscopeCorrectionPoint() {
        if (rotoCorrectionDraftPoints.length === 0)
            return
        rotoCorrectionDraftPoints = rotoCorrectionDraftPoints.slice(0, -1)
    }

    function scenePointSourceRect(imageSize) {
        if (!videoMonitor)
            return Qt.rect(0, 0, 0, 0)
        const sourceWidth = Math.max(1, Number(imageSize ? imageSize.width : 1))
        const sourceHeight = Math.max(1, Number(imageSize ? imageSize.height : 1))
        const sourceAspect = sourceWidth / sourceHeight
        const frameAspect = Math.max(0.01, Number(programMonitor.sequenceAspectRatio || 1))
        let width = videoMonitor.width
        let height = videoMonitor.height
        let x = 0
        let y = 0
        if (sourceAspect > frameAspect) {
            height = videoMonitor.width / sourceAspect
            y = (videoMonitor.height - height) / 2
        } else {
            width = videoMonitor.height * sourceAspect
            x = (videoMonitor.width - width) / 2
        }
        return Qt.rect(x, y, Math.max(1, width), Math.max(1, height))
    }

    function updateMotionSeedFrameImageStatus(status) {
        if (!root.motionSeedSelectionHudVisible)
            return
        if (status === Image.Ready) {
            root.motionSeedAwaitingFirstFrame = false
            root.motionTrackingUiMessage = "First source frame ready. Drag around the subject."
        } else if (status === Image.Error) {
            root.motionSeedAwaitingFirstFrame = false
            root.motionTrackingUiMessage = "The source frame could not be loaded. Reopen the tracking panel to enter the region numerically."
        }
    }

    function motionSeedSourceRect() {
        if (!videoMonitor || !root.currentClip)
            return Qt.rect(0, 0, 0, 0)
        const sourceWidth = Math.max(1, Number(root.currentClip.sourceWidth || 1))
        const sourceHeight = Math.max(1, Number(root.currentClip.sourceHeight || 1))
        const sourceAspect = sourceWidth / sourceHeight
        const frameAspect = Math.max(0.01, Number(programMonitor.sequenceAspectRatio || 1))
        let width = videoMonitor.width
        let height = videoMonitor.height
        let x = 0
        let y = 0
        if (sourceAspect > frameAspect) {
            height = videoMonitor.width / sourceAspect
            y = (videoMonitor.height - height) / 2
        } else {
            width = videoMonitor.height * sourceAspect
            x = (videoMonitor.width - width) / 2
        }
        return Qt.rect(x, y, Math.max(1, width), Math.max(1, height))
    }

    function motionSeedSourceIsTrackable() {
        if (!root.currentClip || String(root.currentClip.trackKind || "") !== "video"
                || String(root.currentClip.mediaType || "video") !== "video")
            return false
        const clip = root.currentClip
        const tolerance = 0.0001
        return String(clip.frameMode || "fit") === "fit"
                && Math.abs(Number(clip.baseFrameScale !== undefined ? clip.baseFrameScale : 1) - 1) < tolerance
                && Math.abs(Number(clip.baseFrameRotationDegrees || 0)) < tolerance
                && Math.abs(Number(clip.baseFrameOffsetX || 0)) < tolerance
                && Math.abs(Number(clip.baseFrameOffsetY || 0)) < tolerance
                && Math.abs(Number(clip.baseFramePerspectiveX || 0)) < tolerance
                && Math.abs(Number(clip.baseFramePerspectiveY || 0)) < tolerance
                && root.keyframesForClipParameter(clip, "frameScale").length === 0
                && root.keyframesForClipParameter(clip, "frameRotationDegrees").length === 0
                && root.keyframesForClipParameter(clip, "frameOffsetX").length === 0
                && root.keyframesForClipParameter(clip, "frameOffsetY").length === 0
                && root.keyframesForClipParameter(clip, "framePerspectiveX").length === 0
                && root.keyframesForClipParameter(clip, "framePerspectiveY").length === 0
                && Number(clip.groupTransformScale || 1) === 1
                && Math.abs(Number(clip.groupTransformRotationDegrees || 0)) < tolerance
                && Math.abs(Number(clip.groupTransformOffsetX || 0)) < tolerance
                && Math.abs(Number(clip.groupTransformOffsetY || 0)) < tolerance
    }

    function beginMotionSeedSelection() {
        if (!root.motionSeedSourceIsTrackable()) {
            root.motionSeedSelectionActive = false
            root.motionTrackingUiMessage = "For seed selection, use a video clip with Fit framing and reset transforms."
            return
        }
        timelinePlayback.pause()
        root.motionSeedRectNormalized = ({"x": 0, "y": 0, "width": 0, "height": 0})
        root.motionSeedSelectionHudVisible = true
        root.motionSeedSelectionActive = true
        return root.requestMotionSeedSourceFrame()
    }

    function finishMotionSeedSelection(keepRegion) {
        const isSurfaceExclusion = motionTrackingPanel.surfaceExclusionSelectionPending
        root.motionSeedSelectionActive = false
        root.motionSeedAwaitingFirstFrame = false
        root.motionSeedSelectionHudVisible = false
        if (!keepRegion)
            root.motionSeedRectNormalized = ({"x": 0, "y": 0, "width": 0, "height": 0})
        root.motionTrackingUiMessage = keepRegion && isSurfaceExclusion
                ? "Exclusion added. Retrack Surface to apply it."
                : keepRegion &&
                Number(root.motionSeedRectNormalized.width || 0) > 0
                ? "Seed region saved. Track motion or create a cutout."
                : "Seed region cancelled."
        if (motionTrackingPanel.surfaceExclusionSelectionPending) {
            if (keepRegion)
                motionTrackingPanel.acceptSurfaceExclusionSelection(root.motionSeedRectNormalized)
            else
                motionTrackingPanel.surfaceExclusionSelectionPending = false
        }
        motionTrackingPopup.open()
    }

    function updateMotionSeedRect(fromX, fromY, toX, toY) {
        const bounds = root.motionSeedSourceRect()
        if (bounds.width <= 0 || bounds.height <= 0)
            return
        const left = Math.max(bounds.x, Math.min(bounds.x + bounds.width, Math.min(fromX, toX)))
        const top = Math.max(bounds.y, Math.min(bounds.y + bounds.height, Math.min(fromY, toY)))
        const right = Math.max(bounds.x, Math.min(bounds.x + bounds.width, Math.max(fromX, toX)))
        const bottom = Math.max(bounds.y, Math.min(bounds.y + bounds.height, Math.max(fromY, toY)))
        root.motionSeedRectNormalized = ({
            "x": (left - bounds.x) / bounds.width,
            "y": (top - bounds.y) / bounds.height,
            "width": (right - left) / bounds.width,
            "height": (bottom - top) / bounds.height
        })
    }

    function endMotionSeedSelection() {
        const rect = root.motionSeedRectNormalized
        if (Number(rect.width || 0) < 0.015 || Number(rect.height || 0) < 0.015) {
            root.motionSeedRectNormalized = ({"x": 0, "y": 0, "width": 0, "height": 0})
            root.motionTrackingUiMessage = "Drag a larger rectangle around the subject to set the tracking region."
            root.motionSeedSelectionActive = true
        } else {
            root.motionSeedSelectionActive = false
            root.motionTrackingUiMessage = ""
        }
    }

    function sequenceVersionDateText(value) {
        const date = new Date(String(value || ""))
        if (isNaN(date.getTime()))
            return String(value || "")
        return Qt.formatDateTime(date, "MMM d, yyyy · h:mm AP")
    }

    function sequenceVersionDifferenceText(label, values) {
        const items = values || []
        if (items.length === 0)
            return ""
        const visibleItems = []
        for (let index = 0; index < Math.min(4, items.length); ++index)
            visibleItems.push(String(items[index]))
        const remainder = items.length > visibleItems.length
                          ? " +" + String(items.length - visibleItems.length) + " more" : ""
        return label + ": " + visibleItems.join(", ") + remainder
    }

