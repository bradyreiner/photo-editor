                                font.pixelSize: theme.typeDialogTitle
                                font.weight: Font.DemiBold
                            }
                            Label {
                                Layout.fillWidth: true
                                text: "Post-grade scopes, reference matching, and managed LUTs for the selected clip."
                                color: theme.textMuted
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeLabel
                                wrapMode: Text.Wrap
                            }
                        }
                        StatusChip {
                            text: String(root.currentClip.colorLutName || "No LUT")
                            tone: root.currentClip.colorLutName ? "info" : "neutral"
                            compact: true
                        }
                    }

                    Rectangle {
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        Layout.minimumHeight: 220
                        radius: theme.radius8
                        color: theme.alpha(theme.ink900, 0.58)
                        border.width: 0

                        Canvas {
                            id: colorScopesCanvas
                            objectName: "timelineColorScopesCanvas"
                            anchors.fill: parent
                            anchors.margins: theme.space8
                            renderTarget: Canvas.Image
                            onPaint: {
                                const context = getContext("2d")
                                context.reset()
                                context.fillStyle = theme.alpha(theme.ink900, 0.72)
                                context.fillRect(0, 0, width, height)
                                context.strokeStyle = theme.alpha(theme.textFaint, 0.16)
                                context.lineWidth = 1
                                const gap = theme.space12
                                const scopeWidth = (width - gap * 2) / 3
                                for (let scope = 0; scope < 3; ++scope) {
                                    const left = scope * (scopeWidth + gap)
                                    context.strokeRect(left + 0.5, 0.5, scopeWidth - 1, height - 1)
                                    for (let row = 1; row < 4; ++row) {
                                        const y = height * row / 4
                                        context.beginPath(); context.moveTo(left, y); context.lineTo(left + scopeWidth, y); context.stroke()
                                    }
                                    for (let column = 1; column < 4; ++column) {
                                        const x = left + scopeWidth * column / 4
                                        context.beginPath(); context.moveTo(x, 0); context.lineTo(x, height); context.stroke()
                                    }
                                }
                                function drawDensity(values, left, tint) {
                                    const resolution = Number(root.colorScopeData.scopeResolution || 0)
                                    if (!values || resolution < 2 || values.length !== resolution * resolution)
                                        return
                                    const cellWidth = scopeWidth / resolution
                                    const cellHeight = height / resolution
                                    for (let row = 0; row < resolution; ++row) {
                                        for (let column = 0; column < resolution; ++column) {
                                            const value = Math.max(0, Math.min(1, Number(values[row * resolution + column])))
                                            if (value < 0.01)
                                                continue
                                            context.globalAlpha = Math.min(0.92, 0.10 + Math.sqrt(value) * 0.82)
                                            context.fillStyle = tint
                                            context.fillRect(left + column * cellWidth,
                                                             height - (row + 1) * cellHeight,
                                                             Math.max(1, cellWidth), Math.max(1, cellHeight))
                                        }
                                    }
                                    context.globalAlpha = 1
                                }

                                function drawHistogram(values, left, tint) {
                                    if (!values || values.length < 2)
                                        return
                                    context.save()
                                    context.globalCompositeOperation = "lighter"
                                    context.strokeStyle = tint
                                    context.lineWidth = 1.35
                                    context.beginPath()
                                    for (let index = 0; index < values.length; ++index) {
                                        const x = left + scopeWidth * index / (values.length - 1)
                                        const level = Math.max(0, Math.min(1, Number(values[index])))
                                        const y = height - level * (height - theme.space20) - theme.space6
                                        if (index === 0)
                                            context.moveTo(x, y)
                                        else
                                            context.lineTo(x, y)
                                    }
                                    context.stroke()
                                    context.restore()
                                }

                                drawDensity(root.colorScopeData.lumaWaveform, 0, "#d8dde5")
                                const histogramLeft = scopeWidth + gap
                                drawHistogram(root.colorScopeData.red, histogramLeft, theme.signalRed)
                                drawHistogram(root.colorScopeData.green, histogramLeft, theme.vectorGreen)
                                drawHistogram(root.colorScopeData.blue, histogramLeft, theme.signalCyan)
                                drawDensity(root.colorScopeData.vectorscope,
                                            (scopeWidth + gap) * 2, "#7cc9b5")
                                context.fillStyle = theme.textMuted
                                context.font = "11px " + theme.fontUi
                                context.fillText("LUMA WAVEFORM", theme.space6, theme.space16)
                                context.fillText("RGB HISTOGRAM", histogramLeft + theme.space6, theme.space16)
                                context.fillText("VECTORSCOPE",
                                                 (scopeWidth + gap) * 2 + theme.space6,
                                                 theme.space16)
                            }
                        }

                        Label {
                            anchors.centerIn: parent
                            visible: !root.colorScopeData.sampleCount
                            text: "Analyze the selected frame to draw RGB and luma scopes."
                            color: theme.textMuted
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeLabel
                            wrapMode: Text.Wrap
                        }
