        timelinePlayback.interactionActive = previewInteractionActive
        beginTimelineSetup()
        refreshProgramPlaybackLayerModels(true)
        Qt.callLater(restoreInspectorTabForSelection)
        Qt.callLater(presentTimelineRecoveryIfNeeded)
