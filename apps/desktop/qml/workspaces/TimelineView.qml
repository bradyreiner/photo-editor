    function clipSourceUrl() {
        return timelineDocument.playbackSourceUrl ? timelineDocument.playbackSourceUrl : ""
    }

    function previewQualityLabel() {
        if (previewQualityMode === "full")
            return "Full"
        if (previewQualityMode === "half")
            return "Half"
        if (previewQualityMode === "quarter")
            return "Quarter"
        if (previewQualityMode === "proxy")
            return "Proxy"
        if (previewQualityMode === "clip")
            return "Clip setting"
        return "Auto"
    }

    function precisionTrimDisabledReason(asymmetricLinkedAv) {
        if (timelineDocument.currentIndex < 0 || !root.currentClip
                || String(root.currentClip.trackKind || "") !== "video")
            return "Select a picture clip to trim its In or Out edge."
        if (Number(timelineDocument.selectedClipCount || 0) > 1)
            return "Select one picture clip for precision trimming."
        const tracks = root.sequenceTrackModel || []
        const trackId = String(root.currentClip.trackId || "")
        const audioTrackId = String(root.currentClip.audioTrackId || "")
        for (let index = 0; index < tracks.length; ++index) {
            const track = tracks[index]
            if (String(track.trackId || "") === trackId && track.locked === true)
                return "Unlock the selected track before trimming."
            // Even picture-only trimming detaches paired audio, so its track must be writable.
            if (root.currentClip.audioLinked === true && audioTrackId.length > 0
                    && String(track.trackId || "") === audioTrackId && track.locked === true)
                return "Unlock the linked audio track before trimming this clip."
        }
        return ""
    }

    function selectPrecisionTrimEdge(edge) {
        const reason = root.precisionTrimDisabledReason(false)
        if (reason.length > 0) {
            root.showMarkerFeedback(reason)
            return false
        }
        timelineDocument.activeTool = "trim"
        keyboardTrimEdge = edge === "end" ? "end" : "start"
        editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        return String(editPointData.schema || "").length > 0
    }

    function precisionTrimPlayheadReason(edge) {
        const reason = root.precisionTrimDisabledReason(false)
        if (reason.length > 0)
            return reason
        const start = Number(root.currentClip.startSeconds || 0)
        const end = start + Number(root.currentClip.trimmedDurationSeconds || 0)
        const frame = 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const position = Number(root.sequencePlayheadSeconds)
        return edge === "start"
                ? (position >= start && position <= end - frame
                   ? "" : "Place the playhead inside the selected clip, before its last frame.")
                : (position >= start + frame && position <= end
                   ? "" : "Place the playhead inside the selected clip, after its first frame.")
    }

    function timelinePrecisionTrimMenuItems() {
        const reason = root.precisionTrimDisabledReason(false)
        const edgeChosen = reason.length === 0 && root.keyboardTrimEdge.length > 0
                           && timelineDocument.activeTool === "trim"
        const edgeReason = reason.length > 0 ? reason : "Choose the In or Out edge first."
        const inReason = root.precisionTrimPlayheadReason("start")
        const outReason = root.precisionTrimPlayheadReason("end")
        return [
            {key: "trim-in", label: "Select In edge", icon: "step-back", enabled: reason.length === 0,
             disabledReason: reason, checked: edgeChosen && keyboardTrimEdge === "start",
             tooltip: "Choose the clip start. T alternates between In and Out."},
            {key: "trim-out", label: "Select Out edge", icon: "step-forward", enabled: reason.length === 0,
             disabledReason: reason, checked: edgeChosen && keyboardTrimEdge === "end",
             tooltip: "Choose the clip end. T alternates between In and Out."},
            {key: "trim-earlier-1", label: "Earlier by 1 frame", icon: "step-back", enabled: edgeChosen,
             disabledReason: edgeReason, separatorBefore: true, tooltip: "Comma. Respects linked selection and Ripple."},
            {key: "trim-later-1", label: "Later by 1 frame", icon: "step-forward", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Period. Respects linked selection and Ripple."},
            {key: "trim-earlier-5", label: "Earlier by 5 frames", icon: "step-back", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Shift+Comma. Respects linked selection and Ripple."},
            {key: "trim-later-5", label: "Later by 5 frames", icon: "step-forward", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Shift+Period. Respects linked selection and Ripple."},
            {key: "trim-in-playhead", label: "Trim In to playhead", icon: "step-back", enabled: inReason.length === 0,
             disabledReason: inReason, separatorBefore: true, tooltip: "Remove the selected clip before the playhead; respects Ripple."},
            {key: "trim-out-playhead", label: "Trim Out to playhead", icon: "step-forward", enabled: outReason.length === 0,
             disabledReason: outReason, tooltip: "Remove the selected clip after the playhead; respects Ripple."},
            {key: "tool-roll", label: "Roll adjacent edit", icon: "roll", checked: timelineDocument.activeTool === "roll",
             separatorBefore: true, tooltip: "N. Move a cut while preserving the combined duration."},
            {key: "leave-trim", label: "Return to Select", icon: "select", tooltip: "V. Finish trimming and return to selection."}
        ]
    }

    function handlePrecisionTrimAction(key) {
        if (key === "tool-roll" || key === "leave-trim") {
            keyboardTrimEdge = ""
            editPointData = ({})
            timelineDocument.activeTool = key === "tool-roll" ? "roll" : "select"
            return
        }
        if (key === "trim-in" || key === "trim-out") {
            root.selectPrecisionTrimEdge(key === "trim-in" ? "start" : "end")
            return
        }
        if (key === "trim-in-playhead" || key === "trim-out-playhead") {
            const edge = key === "trim-in-playhead" ? "start" : "end"
            const reason = root.precisionTrimPlayheadReason(edge)
            if (reason.length > 0) {
                root.showMarkerFeedback(reason)
                return
            }
            const position = Number(root.sequencePlayheadSeconds)
            if (!root.selectPrecisionTrimEdge(edge))
                return
            if (edge === "start")
                timelineDocument.trimSelectedClipStartToSequenceSeconds(position, rippleModeEnabled)
            else
                timelineDocument.trimSelectedClipEndToSequenceSeconds(position, rippleModeEnabled)
            editPointData = timelineDocument.selectedEditPointInfo(edge)
            return
        }
        if (key.indexOf("trim-earlier-") === 0 || key.indexOf("trim-later-") === 0)
            root.nudgeKeyboardTrim((key.indexOf("trim-earlier-") === 0 ? -1 : 1)
                                  * (key.endsWith("-5") ? 5 : 1), false)
    }

    function toggleKeyboardTrimEdge() {
        const edge = keyboardTrimEdge === "start" ? "end" : "start"
        if (root.selectPrecisionTrimEdge(edge))
            root.showMarkerFeedback(edge === "start" ? "Keyboard trim: In edge" : "Keyboard trim: Out edge")
    }

    function showMarkerFeedback(message) {
        markerFeedbackText = message
        markerFeedbackVisible = true
        markerFeedbackTimer.restart()
    }

    function nudgeKeyboardTrim(frameDelta, asymmetricLinkedAv) {
        const reason = root.precisionTrimDisabledReason(asymmetricLinkedAv)
        if (reason.length > 0) {
            root.showMarkerFeedback(reason)
            return
        }

        if (keyboardTrimEdge.length === 0) {
            root.showMarkerFeedback("Press T to select the In trim edge first.")
            return
        }
        const previousStatus = String(timelineDocument.status || "")
        if (timelineDocument.nudgeSelectedTrimEdge(
                    keyboardTrimEdge, frameDelta,
                    asymmetricLinkedAv === true, rippleModeEnabled)) {
            editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        } else {
            const currentStatus = String(timelineDocument.status || "")
            root.showMarkerFeedback(currentStatus.length > 0 && currentStatus !== previousStatus
                                    ? currentStatus : "Trim was not applied. Check source handles and locked tracks.")
        }
    }

    function navigateEditPoint(direction) {
        const boundary = Number(editPointData.boundarySeconds || sequencePlayheadSeconds)
        const selected = timelineDocument.selectAdjacentEditPoint(boundary, direction)
        if (!selected || String(selected.schema || "").length === 0)
            return
        keyboardTrimEdge = String(selected.edge || (direction < 0 ? "end" : "start"))
        editPointData = selected
        timelineDocument.activeTool = "trim"
    }

