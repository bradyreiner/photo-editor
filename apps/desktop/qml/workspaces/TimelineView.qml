                                                    anchors.bottom: parent.bottom
                                                    anchors.bottomMargin: theme.space4
                                                    width: Math.min(
                                                               parent.width / 2 - 6,
                                                               Math.max(
                                                                   12,
                                                                   (modelData.selected
                                                                    && root.interactionFadeInSeconds >= 0
                                                                    ? root.interactionFadeInSeconds
                                                                    : Number(modelData.fadeInSeconds || 0))
                                                                   * timelineZoom))
                                                    height: theme.space8
                                                    radius: theme.radius4
                                                    color: theme.alpha(theme.accentCool400, 0.82)
                                                    visible: clipBlock.editHandlesVisible
                                                             || Number(modelData.fadeInSeconds || 0) > 0

                                                    Item {
                                                        objectName: modelData.selected
                                                                    ? "timelineSelectedClipFadeInHandle" : ""
                                                        anchors.fill: parent
                                                    }

                                                    MouseArea {
                                                        anchors.fill: parent
                                                        cursorShape: Qt.SizeHorCursor
                                                        enabled: timelineDocument.currentIndex >= 0
                                                        onPressed: timelineDocument.selectClip(modelData.index)
                                                        onPositionChanged: function(mouse) {
                                                            if (!pressed)
                                                                return
                                                            timelineDocument.selectClip(modelData.index)
                                                            const durationSeconds = Math.max(0, Math.min(Number(modelData.trimmedDurationSeconds || 0), mouse.x / timelineZoom))
                                                            root.requestSelectedFadeInSeconds(durationSeconds)
                                                            inspectorTab = "audio"
                                                        }
                                                    }
                                                }

                                                Rectangle {
                                                    objectName: "timelineClipFadeOutHandle"
                                                    anchors.right: parent.right
                                                    anchors.rightMargin: theme.space4
                                                    anchors.bottom: parent.bottom
                                                    anchors.bottomMargin: theme.space4
                                                    width: Math.min(parent.width / 2 - 6, Math.max(12, Number(modelData.fadeOutSeconds || 0) * timelineZoom))
                                                    height: theme.space8
                                                    radius: theme.radius4
                                                    color: theme.alpha(theme.accentCool400, 0.82)
                                                    visible: clipBlock.editHandlesVisible
                                                             || Number(modelData.fadeOutSeconds || 0) > 0

                                                    MouseArea {
                                                        anchors.fill: parent
                                                        cursorShape: Qt.SizeHorCursor
                                                        enabled: timelineDocument.currentIndex >= 0
                                                        onPressed: timelineDocument.selectClip(modelData.index)
                                                        onPositionChanged: function(mouse) {
                                                            if (!pressed)
                                                                return
                                                            timelineDocument.selectClip(modelData.index)
                                                            const durationSeconds = Math.max(0, Math.min(Number(modelData.trimmedDurationSeconds || 0), (parent.width - mouse.x) / timelineZoom))
                                                            timelineDocument.setSelectedClipFadeOutSeconds(durationSeconds)
                                                            inspectorTab = "audio"
                                                        }
                                                    }
                                                }

                                                Rectangle {
                                                    id: splitFailOverlay
                                                    anchors.fill: parent
                                                    color: theme.alpha(theme.error, 0.3)
                                                    radius: clipBlock.radius
                                                    visible: false
                                                    opacity: 0

                                                    SequentialAnimation {
                                                        id: splitFailFlash
                                                        PropertyAction { target: splitFailOverlay; property: "visible"; value: true }
                                                        NumberAnimation { target: splitFailOverlay; property: "opacity"; from: 0.6; to: 0; duration: theme.durationSlow }
                                                        PropertyAction { target: splitFailOverlay; property: "visible"; value: false }
                                                    }
                                                }

                                                TimelineClipContent {
                                                    objectName: "timelineClipContent"
                                                    anchors.fill: parent
                                                    title: String(modelData.displayLabel || "Clip")
                                                    metadata: root.clipMetadataText(modelData)
                                                    statusBadges: root.clipStatusBadges(
                                                                      modelData,
                                                                      clipBlock.trackSuppressed)
                                                    horizontalInset: clipBlock.trimHandleWidth
                                                    selected: Boolean(modelData.selected)
                                                    z: 10
                                                }

                                                Rectangle {
                                                    objectName: "timelineClipSelectionOverlay"
                                                    anchors.fill: parent
                                                    visible: modelData.selected
                                                    radius: clipBlock.radius
                                                    color: "transparent"
                                                    border.width: theme.scaled(2)
                                                    border.color: theme.editorSelectionEdge
                                                    z: 100
                                                    Accessible.ignored: true
                                                }
                                            }
                                        }

                                        Rectangle {
                                            id: trackAutomationLane
                                            objectName: "timelineTrackAutomationLane"
                                            readonly property string parameter: root.trackAutomationLaneParameter(trackLane.modelData)
                                            readonly property var keyframes: root.trackAutomationKeyframes(
                                                                                  trackLane.modelData,
                                                                                  parameter)
                                            readonly property var curvePoints: root.trackAutomationCurvePoints(
                                                                                    trackLane.modelData,
                                                                                    parameter,
                                                                                    height)
                                            visible: root.trackAutomationLaneExpanded(trackLane.modelData.trackId)
                                            anchors.left: parent.left
                                            anchors.right: parent.right
                                            anchors.bottom: parent.bottom
                                            anchors.leftMargin: 3
                                            anchors.rightMargin: 3
                                            anchors.bottomMargin: 5
                                            height: 38
                                            radius: theme.radius4
                                            color: theme.alpha(theme.ink950, 0.82)
                                            border.width: 0
                                            clip: true
                                            z: 70
                                            Accessible.name: root.keyframeParameterLabel(parameter) + " track automation"
                                            Accessible.description: "Click to seek, double-click to add a point, drag points to change time and value, or right-click a point for interpolation."

                                            MouseArea {
                                                anchors.fill: parent
                                                acceptedButtons: Qt.LeftButton
                                                cursorShape: Qt.CrossCursor
                                                onClicked: function(mouse) {
                                                    timelineDocument.seekSequenceSeconds(
                                                        Math.max(0, Math.min(
                                                            root.sequenceDurationSeconds(),
                                                            mouse.x / timelineZoom)))
                                                }
                                                onDoubleClicked: function(mouse) {
                                                    const seconds = Math.max(0, Math.min(
                                                        root.sequenceDurationSeconds(),
                                                        mouse.x / timelineZoom))
                                                    timelineDocument.seekSequenceSeconds(seconds)
                                                    timelineDocument.toggleTrackAutomationKeyframe(
                                                        trackLane.trackRowIndex,
                                                        trackAutomationLane.parameter)
                                                }
                                            }

                                            Shape {
                                                anchors.fill: parent
                                                antialiasing: true

                                                ShapePath {
                                                    strokeColor: theme.accentCool300
                                                    strokeWidth: theme.focusBorderWidth
                                                    fillColor: "transparent"
                                                    capStyle: ShapePath.RoundCap
                                                    joinStyle: ShapePath.RoundJoin

                                                    PathPolyline {
                                                        path: trackAutomationLane.curvePoints
                                                    }
                                                }
                                            }

                                            Repeater {
                                                model: trackAutomationLane.keyframes

                                                delegate: Rectangle {
                                                    id: trackAutomationPoint
                                                    required property var modelData
                                                    property real originalSeconds: Number(modelData.seconds || 0)
                                                    width: 10
                                                    height: 10
                                                    radius: 2
                                                    rotation: 45
                                                    x: Number(modelData.seconds || 0) * timelineZoom - width / 2
                                                    y: root.trackAutomationPointY(
                                                           trackAutomationLane.parameter,
                                                           Number(modelData.value || 0),
                                                           trackAutomationLane.height) - height / 2
                                                    color: Math.abs(
                                                               Number(modelData.seconds || 0)
                                                               - root.sequencePlayheadSeconds)
                                                           <= 0.5 / Math.max(
                                                               1,
                                                               Number(timelineDocument.framesPerSecond || 30))
                                                           ? theme.textStrong : theme.accentCool300
                                                    border.width: theme.hairlineWidth
                                                    border.color: theme.alpha(theme.ink950, 0.72)
                                                    z: 3

                                                    MouseArea {
                                                        id: trackAutomationPointMouse
                                                        anchors.fill: parent
                                                        anchors.margins: -6
                                                        acceptedButtons: Qt.LeftButton | Qt.RightButton
                                                        cursorShape: Qt.SizeAllCursor
                                                        drag.target: (pressedButtons & Qt.LeftButton) !== 0
                                                                     ? trackAutomationPoint : null
                                                        drag.axis: Drag.XAndYAxis
                                                        drag.minimumX: -trackAutomationPoint.width / 2
                                                        drag.maximumX: trackAutomationLane.width
                                                                       - trackAutomationPoint.width / 2
                                                        drag.minimumY: -trackAutomationPoint.height / 2
                                                        drag.maximumY: trackAutomationLane.height
                                                                       - trackAutomationPoint.height / 2

                                                        onPressed: function(mouse) {
                                                            trackAutomationPoint.originalSeconds = Number(
                                                                trackAutomationPoint.modelData.seconds || 0)
                                                            if (mouse.button === Qt.RightButton) {
                                                                timelineDocument.seekSequenceSeconds(
                                                                    trackAutomationPoint.originalSeconds)
                                                                trackAutomationPointMenu.popup()
                                                                return
                                                            }
                                                            timelineDocument.beginContinuousEdit()
                                                        }

                                                        onReleased: function(mouse) {
                                                            if (mouse.button !== Qt.LeftButton)
                                                                return
                                                            const nextSeconds = Math.max(0, Math.min(
                                                                root.sequenceDurationSeconds(),
                                                                (trackAutomationPoint.x
                                                                 + trackAutomationPoint.width / 2)
                                                                / timelineZoom))
                                                            const nextValue = root.trackAutomationValueFromY(
                                                                trackAutomationLane.parameter,
                                                                trackAutomationPoint.y
                                                                + trackAutomationPoint.height / 2,
                                                                trackAutomationLane.height)
                                                            timelineDocument.updateTrackAutomationKeyframe(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                trackAutomationPoint.originalSeconds,
                                                                nextSeconds,
                                                                nextValue)
                                                            timelineDocument.endContinuousEdit()
                                                            timelineDocument.seekSequenceSeconds(nextSeconds)
                                                        }

                                                        onCanceled: timelineDocument.endContinuousEdit()
                                                    }

                                                    AppMenu {
                                                        id: trackAutomationPointMenu
                                                        accent: theme.accentCool400

                                                        AppMenuItem {
                                                            text: "Hold"
                                                            iconName: "check"
                                                            accent: trackAutomationPointMenu.accent
                                                            onTriggered: timelineDocument.setTrackAutomationKeyframeInterpolation(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                Number(trackAutomationPoint.modelData.seconds || 0),
                                                                "hold")
                                                        }

                                                        AppMenuItem {
                                                            text: "Linear"
                                                            iconName: "curve"
                                                            accent: trackAutomationPointMenu.accent
                                                            onTriggered: timelineDocument.setTrackAutomationKeyframeInterpolation(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                Number(trackAutomationPoint.modelData.seconds || 0),
                                                                "linear")
                                                        }

                                                        AppMenuItem {
                                                            text: "Ease In Out"
                                                            iconName: "curve"
                                                            accent: trackAutomationPointMenu.accent
                                                            onTriggered: timelineDocument.setTrackAutomationKeyframeInterpolation(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                Number(trackAutomationPoint.modelData.seconds || 0),
                                                                "ease-in-out")
                                                        }

                                                        AppMenuItem {
                                                            text: "Bezier"
                                                            iconName: "curve"
                                                            accent: trackAutomationPointMenu.accent
                                                            onTriggered: timelineDocument.setTrackAutomationKeyframeInterpolation(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                Number(trackAutomationPoint.modelData.seconds || 0),
                                                                "bezier")
                                                        }

                                                        AppMenuItem {
                                                            text: "Delete Point"
                                                            iconName: "delete"
                                                            accent: theme.error
                                                            onTriggered: timelineDocument.removeTrackAutomationKeyframe(
                                                                trackLane.trackRowIndex,
                                                                trackAutomationLane.parameter,
                                                                Number(trackAutomationPoint.modelData.seconds || 0))
                                                        }
                                                    }
                                                }
                                            }

                                            Label {
                                                x: timelineViewport.contentX + theme.space6
                                                anchors.top: parent.top
                                                anchors.topMargin: 2
                                                text: root.keyframeParameterLabel(
                                                          trackAutomationLane.parameter).toUpperCase()
                                                      + "  ·  "
                                                      + trackAutomationLane.keyframes.length
                                                      + " POINTS"
                                                color: theme.textFaint
                                                font.family: theme.fontMono
                                                font.pixelSize: theme.typeMicro
                                                z: 4
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    objectName: "timelineClipDragDestinationLane"
                                    visible: root.dragPreviewState.visible
                                    x: 0
                                    y: root.trackTopY(Number(root.dragPreviewState.targetRow || 0))
                                    width: timelineContentWidth
                                    height: root.trackHeight(
                                                sequenceTrackModel[
                                                    Number(root.dragPreviewState.targetRow || 0)]
                                                ? sequenceTrackModel[
                                                    Number(root.dragPreviewState.targetRow || 0)].trackId
                                                : "")
                                    radius: theme.radius4
                                    color: theme.alpha(theme.accentCool400, 0.07)
                                    z: 998
                                }

                                Rectangle {
                                    objectName: "timelineClipDragAffectedRange"
                                    visible: root.dragPreviewState.visible
                                    x: Number(root.dragPreviewState.x || 0)
                                    y: Number(root.dragPreviewState.y || 0)
                                    width: Number(root.dragPreviewState.width || 0)
                                    height: Number(root.dragPreviewState.height
                                                   || defaultLaneHeight - 12)
                                    radius: theme.radius4
                                    color: String(root.dragPreviewState.operation || "").toLowerCase()
                                           .indexOf("overwrite") >= 0
                                           ? theme.alpha(theme.error, 0.12)
                                           : theme.alpha(theme.accentCool400, 0.10)
                                    border.width: theme.hairlineWidth
                                    border.color: String(root.dragPreviewState.operation || "").toLowerCase()
                                                  .indexOf("overwrite") >= 0
                                                  ? theme.alpha(theme.error, 0.54)
                                                  : theme.alpha(theme.accentCool300, 0.42)
                                    z: 999
                                }

                                Rectangle {
                                    objectName: "timelineClipDragPreview"
                                    visible: root.dragPreviewState.visible
                                    x: Number(root.dragPreviewState.x || 0)
                                    y: Number(root.dragPreviewState.y || 0)
                                    width: Number(root.dragPreviewState.width || 0)
                                    height: Number(root.dragPreviewState.height || defaultLaneHeight - 12)
                                    radius: theme.radius4
                                    color: theme.alpha(theme.accentCool400, 0.18)
                                    border.width: 0
                                    z: 1000

                                    Rectangle {
                                        anchors.left: parent.left
                                        anchors.top: parent.top
                                        anchors.bottom: parent.bottom
                                        width: theme.scaled(2)
                                        color: theme.accentCool300
                                    }

                                    StatusChip {
                                        objectName: "timelineClipDragPreviewLabel"
                                        anchors.centerIn: parent
                                        text: String(root.dragPreviewState.operation || "Move")
                                              + " · "
                                              + String(root.dragPreviewState.trackLabel || "Track")
                                              + " · "
                                              + root.timecodeText(
                                                  Number(root.dragPreviewState.seconds || 0))
                                              + " · "
                                              + String(root.dragPreviewState.result || "")
                                        tone: "neutral"
                                        compact: true
                                        maximumReadableWidth: theme.scaled(340)
                                        tooltipText: text
                                    }
                                }

                                Rectangle {
                                    objectName: "timelineClipDragInsertionPoint"
                                    visible: root.dragPreviewState.visible
                                    x: Number(root.dragPreviewState.x || 0)
                                    y: Number(root.dragPreviewState.y || 0) - theme.space4
                                    width: theme.scaled(2)
                                    height: Number(root.dragPreviewState.height
                                                   || defaultLaneHeight - 12) + theme.space8
                                    color: theme.accentCool300
                                    z: 1001
                                }

                                Rectangle {
                                    visible: root.marqueeActive
                                    x: Math.min(root.marqueeStartX, root.marqueeCurrentX)
                                    y: Math.min(root.marqueeStartY, root.marqueeCurrentY)
                                    width: Math.abs(root.marqueeCurrentX - root.marqueeStartX)
                                    height: Math.abs(root.marqueeCurrentY - root.marqueeStartY)
                                    color: theme.alpha(theme.accentCool400, 0.14)
                                    border.width: theme.hairlineWidth
                                    border.color: theme.alpha(theme.accentCool300, 0.72)
                                }

                                Rectangle {
                                    objectName: "timelineSnapGuide"
                                    visible: root.snapGuideState.visible
                                    x: root.timelineX(root.snapGuideState.seconds)
                                    y: 0
                                    width: theme.hairlineWidth
                                    height: timelineContentHeight
                                    color: theme.accentCool400
                                }

                                PopupSurface {
                                    objectName: "timelineSnapGuideLabel"
                                    visible: root.snapGuideState.visible
                                    x: Math.max(0, root.timelineX(root.snapGuideState.seconds)
                                                   - snapGuideBubble.implicitWidth / 2)
                                    y: 2
                                    radius: theme.radiusSurface
                                    fillColor: theme.alpha(theme.ink950, 0.94)
                                    borderColor: theme.alpha(theme.accentCool400, 0.56)
                                    implicitWidth: snapGuideBubble.implicitWidth + 12
                                    implicitHeight: snapGuideBubble.implicitHeight + 6

                                    Label {
                                        id: snapGuideBubble
                                        anchors.centerIn: parent
                                        text: String(root.snapGuideState.label || "")
                                        color: theme.textStrong
                                        font.family: theme.fontMono
                                        font.pixelSize: theme.typeMicro
                                    }
                                }

                                Rectangle {
                                    objectName: "timelinePlayheadLine"
                                    x: root.timelineX(sequencePlayheadSeconds)
                                    y: 0
                                    width: theme.hairlineWidth
                                    height: timelineContentHeight
                                    color: theme.accentWarm500
                                }

                                Item {
                                    id: timelinePlayheadHitTarget
                                    objectName: "timelinePlayheadHitTarget"
                                    x: root.timelineX(sequencePlayheadSeconds) - width / 2
                                    y: 0
                                    width: theme.scaled(14)
                                    height: timelineContentHeight
                                    z: 10003
                                    Accessible.name: "Timeline playhead"
                                    Accessible.description: "Drag to seek across the ruler and tracks."
                                    Accessible.role: Accessible.Slider

                                    MouseArea {
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.SizeHorCursor
                                        onPressed: function(mouse) {
                                            root.seekTimelineFromX(
                                                        timelinePlayheadHitTarget.x + mouse.x)
                                        }
                                        onPositionChanged: function(mouse) {
                                            if (pressed)
                                                root.seekTimelineFromX(
                                                            timelinePlayheadHitTarget.x + mouse.x)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    Connections {
        target: timelineDocument

        function onTimelineNameChanged() {
            timelineNameField.text = timelineDocument.timelineName
        }
    }
}
