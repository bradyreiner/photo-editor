                            MouseArea {
                                anchors.fill: parent
                                anchors.margins: -6
                                drag.target: curvePoint
                                drag.axis: keyframeCurveWindow.graphMode === "speed"
                                           ? Drag.XAxis : Drag.XAndYAxis
                                drag.minimumX: theme.space16 - curvePoint.width / 2
                                drag.maximumX: curveGraph.width - theme.space16 - curvePoint.width / 2
                                drag.minimumY: theme.space16 - curvePoint.height / 2
                                drag.maximumY: curveGraph.height - theme.space16 - curvePoint.height / 2
                                cursorShape: Qt.SizeAllCursor
                                onPressed: function(mouse) {
                                    curvePoint.originalSeconds = Number(curvePoint.modelData.seconds || 0)
                                    const additive = (mouse.modifiers & Qt.ShiftModifier)
                                                     || (mouse.modifiers & Qt.ControlModifier)
                                                     || (mouse.modifiers & Qt.MetaModifier)
                                    keyframeCurveWindow.selectCurveSecond(
