    function toggleCleanupSuggestion(suggestionId) {
        const id = String(suggestionId || "")
        if (id.length === 0)
            return
        let next = root.transcriptCleanupSelection.slice()
        const existingIndex = next.indexOf(id)
        if (existingIndex >= 0)
            next.splice(existingIndex, 1)
        else
            next.push(id)
        root.transcriptCleanupSelection = next
        root.disarmPopupControl(transcriptEditorPopup.cleanupApplyControl)
    }

