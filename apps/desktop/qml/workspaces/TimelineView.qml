        readonly property bool isVideo: hasFrame && String(frameData.mediaType || "") === "video"
        readonly property string frameSourceUrl: hasFrame ? String(frameData.sourceUrl || "") : ""
        readonly property real frameSourceSeconds: hasFrame ? Number(frameData.sourceSeconds || 0) : 0

