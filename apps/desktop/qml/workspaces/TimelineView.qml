    function captionStyleTemplateAt(index) {
        const templates = timelineDocument.captionStyleTemplates || []
        if (templates.length === 0)
            return ({})
        const bounded = Math.max(0, Math.min(templates.length - 1, Number(index || 0)))
        return templates[bounded]
    }

    function captionStyleAspectIndex() {
        if (root.captionStyleAspectKey === "vertical")
            return 1
        if (root.captionStyleAspectKey === "square")
            return 2
        if (root.captionStyleAspectKey === "portrait")
            return 3
        return 0
    }

    function captionStyleAspectKeyAt(index) {
        return ["landscape", "vertical", "square", "portrait"][Math.max(0, Math.min(3, index))]
    }

    function effectiveCaptionStylePreview() {
        const preview = root.captionStyleTemplatePreviewData || ({})
        let result = Object.assign({}, preview.style || ({}))
        const overrides = preview.aspectOverrides || ({})
        const aspectStyle = overrides[root.captionStyleAspectKey] || ({})
        const keys = Object.keys(aspectStyle)
        for (let index = 0; index < keys.length; ++index)
            result[keys[index]] = aspectStyle[keys[index]]
        return result
    }

    function refreshCaptionStyleTemplatePreview(preferredTemplateId) {
        const templates = timelineDocument.captionStyleTemplates || []
        if (templates.length === 0) {
            root.captionStyleTemplateIndex = 0
            root.captionStyleTemplatePreviewData = ({})
            return
        }
        let nextIndex = Math.max(0, Math.min(templates.length - 1,
                                             root.captionStyleTemplateIndex))
        const preferredId = String(preferredTemplateId || "")
        if (preferredId.length > 0) {
            for (let index = 0; index < templates.length; ++index) {
                if (String(templates[index].templateId || "") === preferredId) {
                    nextIndex = index
                    break
                }
            }
        }
        root.captionStyleTemplateIndex = nextIndex
        const selected = templates[nextIndex]
        root.captionStyleTemplatePreviewData = timelineDocument.captionStyleTemplatePreview(
                    String(selected.templateId || ""))
    }

    function selectCaptionStyleTemplate(index) {
