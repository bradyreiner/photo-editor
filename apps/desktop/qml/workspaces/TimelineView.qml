        sourceRailTab = timelineWorkspaceSettings.sourceRailTab
        programSourceGangEnabled = timelineWorkspaceSettings.programSourceGangEnabled
        programScopesVisible = timelineWorkspaceSettings.programScopesVisible
        inspectorTab = timelineWorkspaceSettings.inspectorTab
        try {
            inspectorTabsByType = JSON.parse(
                        String(timelineWorkspaceSettings.inspectorTabsByTypeJson || "{}"))
        } catch (error) {
            inspectorTabsByType = ({})
            timelineWorkspaceSettings.inspectorTabsByTypeJson = "{}"
        }
        try {
            inspectorScrollByContext = JSON.parse(
                        String(timelineWorkspaceSettings.inspectorScrollByContextJson || "{}"))
        } catch (error) {
            inspectorScrollByContext = ({})
            timelineWorkspaceSettings.inspectorScrollByContextJson = "{}"
        }
        try {
            inspectorDisclosureByType = JSON.parse(
