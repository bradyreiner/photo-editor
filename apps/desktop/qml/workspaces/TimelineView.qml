    function handlePersistentRenderJobMenu(job, action) {
        const id = String(job.jobId || "")
        if (!jobQueue || id.length === 0)
            return
        if (action === "move-earlier")
            jobQueue.moveRenderJob(id, -1)
        else if (action === "move-later")
            jobQueue.moveRenderJob(id, 1)
        else if (action === "duplicate")
            jobQueue.duplicateRenderJob(id)
        else if (action === "reveal")
            jobQueue.revealJobOutput(id)
        else if (action.indexOf("resources-") === 0)
            jobQueue.setRenderResourcePolicy(id, action.slice("resources-".length))
        Qt.callLater(root.refreshBackgroundJobs)
