        root.transcriptEditWordIndex = Number(word.index === undefined ? -1 : word.index)
        root.transcriptEditText = String(word.text || "")
        root.transcriptEditSpeaker = String(word.speaker || segment && segment.speaker || "")
        root.transcriptEditConfidence = Number(word.confidence === undefined ? 1 : word.confidence)
        root.disarmPopupControl(transcriptEditorPopup.extractControl)
        if (!root.transcriptSelectionPrimed) {
            root.transcriptSelectionAnchor = wordStart
            root.transcriptSelectionStart = wordStart
            root.transcriptSelectionEnd = wordEnd
            root.transcriptSelectionPrimed = true
            timelinePlayback.seekSequenceSeconds(wordStart)
            return
        }
        root.transcriptSelectionStart = Math.min(root.transcriptSelectionAnchor, wordStart)
        root.transcriptSelectionEnd = Math.max(root.transcriptSelectionAnchor, wordEnd)
        root.transcriptSelectionPrimed = false
        timelinePlayback.seekSequenceSeconds(root.transcriptSelectionStart)
