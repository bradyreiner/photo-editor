    function multicamAudioOptionIndex(group) {
        const angleCount = Number(group && group.angleCount || 0)
        const mode = String(group && group.audioMode || "follow-video")
        if (mode === "mute")
            return angleCount + 1
        if (mode === "fixed-angle")
            return Math.min(angleCount, Math.max(0, Number(group.audioAngleIndex || 0))) + 1
        return 0
