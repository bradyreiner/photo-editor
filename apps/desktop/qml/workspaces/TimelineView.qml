    function programUsesStabilizedPreview(clip, stabilizedVisual) {
        return stabilizedVisual === true
                && clip && clip.mediaType === "video"
                && (clip.stabilizationEnabled === true || clip.rollingShutterEnabled === true)
                && clip.stabilizationReady === true
                && timelineDocument.stabilizationCompareBefore !== true
                && String(clip.stabilizationPreviewSourceUrl || "").length > 0
    }

    function programPlaybackSourceUrl(clip, stabilizedVisual) {
        if (!clip)
            return ""
        if (root.programUsesStabilizedPreview(clip, stabilizedVisual))
            return String(clip.stabilizationPreviewSourceUrl)
        const original = String(clip.originalSourceUrl || clip.sourceUrl || "")
        const proxy = clip.proxyReady === true ? String(clip.proxySourceUrl || "") : ""
        if (previewQualityMode === "full")
            return original
        if (previewQualityMode === "proxy")
            return proxy.length > 0 ? proxy : original
        if (previewQualityMode === "clip")
            return String(clip.sourceUrl || original)
        return previewInteractionActive && proxy.length > 0 ? proxy : original
    }

    function foregroundCutoutMaskUrlForClip(clip, sourceSeconds) {
        if (!clip || clip.foregroundCutoutEnabled !== true
                || clip.foregroundCutoutReady !== true)
            return ""
        const metadata = clip.foregroundCutout || ({})
        const directory = String(clip.foregroundMaskDirectory
                                 || metadata.directoryUrl || metadata.directory || "")
        const fps = Number(metadata.fps || 0)
        const trimStart = Number(metadata.trimStart || 0)
        const frameCount = Math.max(0, Number(metadata.frameCount || 0))
        if (directory.length === 0 || !Number.isFinite(fps) || fps <= 0
                || !Number.isFinite(sourceSeconds) || frameCount <= 0)
            return ""
        const frameIndex = Math.floor((sourceSeconds - trimStart) * fps)
        if (frameIndex < 0 || frameIndex >= frameCount)
            return ""
        const fileName = "mask_" + String(frameIndex).padStart(6, "0") + ".png"
            return directory + (directory.endsWith("/") ? "" : "/") + fileName
    }

    function foregroundCutoutMaskUrlForLayer(layer) {
        return root.foregroundCutoutMaskUrlForClip(
