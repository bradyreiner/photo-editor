    function knownEffectName(effectName) {
        const candidate = String(effectName || "")
        for (let index = 0; index < effectLibraryModel.length; ++index) {
            if (String(effectLibraryModel[index].name || "") === candidate)
                return true
        }
        return false
    }

    function normalizedEffectNames(names, maximumCount) {
        const source = names || []
        const limit = Math.max(0, Number(maximumCount || effectLibraryModel.length))
        let result = []
        for (let index = 0; index < source.length && result.length < limit; ++index) {
            const effectName = String(source[index] || "")
            if (knownEffectName(effectName) && result.indexOf(effectName) < 0)
                result.push(effectName)
        }
        return result
    }

    function toggleEffectFavorite(effectName) {
        const candidate = String(effectName || "")
        if (!knownEffectName(candidate))
            return
        let updated = normalizedEffectNames(effectFavorites, effectLibraryModel.length)
        const existingIndex = updated.indexOf(candidate)
        if (existingIndex >= 0)
            updated.splice(existingIndex, 1)
        else
            updated.unshift(candidate)
        effectFavorites = updated
    }

    function recordRecentEffect(effectName) {
        const candidate = String(effectName || "")
        if (!knownEffectName(candidate))
            return
        let updated = normalizedEffectNames(effectRecents, 8)
        const existingIndex = updated.indexOf(candidate)
        if (existingIndex >= 0)
            updated.splice(existingIndex, 1)
        updated.unshift(candidate)
        effectRecents = updated.slice(0, 8)
    }

