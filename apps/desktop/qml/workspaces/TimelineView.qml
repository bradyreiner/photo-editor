    function transcriptWordSelected(word) {
        if (root.transcriptSelectionStart < 0 || root.transcriptSelectionEnd <= root.transcriptSelectionStart)
            return false
        return Number(word.endSeconds || 0) > root.transcriptSelectionStart + 0.0001
                && Number(word.startSeconds || 0) < root.transcriptSelectionEnd - 0.0001
    }

    function transcriptWordPendingKind(word) {
        const wordStart = Number(word.startSeconds || 0)
        const wordEnd = Number(word.endSeconds || wordStart)
        const operations = timelineDocument.pendingTextBasedEdits || []
        for (let index = 0; index < operations.length; ++index) {
            const operation = operations[index]
            if (Number(operation.endSeconds || 0) > wordStart + 0.0001
                    && Number(operation.startSeconds || 0) < wordEnd - 0.0001)
                return String(operation.kind || "")
        }
        return ""
    }

    function chooseTranscriptWord(word, segment) {
