    function applyTimelineLayoutPreset(preset) {
        const key = String(preset || "")
        if (["edit", "color", "audio", "finish"].indexOf(key) < 0)
            return false

        timelineLayoutPreset = key
        sourcePanelHidden = false
        // Explicit preset changes arrange the task workspace; selection-only
        // changes leave deliberate detached panel placement alone.
        sourcePanelDetached = false
        effectsPanelDetached = false

        if (key === "edit") {
            sourcePanelCollapsed = false
            sourceRailTab = "media"
            effectsPanelCollapsed = true
            closeProgramScopes()
        } else if (key === "color") {
            sourcePanelCollapsed = true
            effectsPanelWidth = Math.max(effectsPanelWidth, 360)
            const selectionType = currentInspectorSelectionType()
            if (inspectorTabValidForType("color", selectionType)) {
                openInspectorTab("color")
            } else {
                openInspectorTab("effects")
                effectDiscoveryCategory = "Color"
            }
            if (hasPlayableSequence()) {
                programScopesActiveScope = "waveform"
                openProgramScopes(false)
            } else {
                closeProgramScopes()
            }
        } else if (key === "audio") {
            sourcePanelCollapsed = true
            effectsPanelWidth = Math.max(effectsPanelWidth, 400)
            effectsPanelCollapsed = false
            closeProgramScopes()
        } else {
            sourcePanelCollapsed = true
            effectsPanelWidth = Math.max(effectsPanelWidth, 360)
            const selectionType = currentInspectorSelectionType()
            openInspectorTab((selectionType === "title" || selectionType === "caption")
                             ? "title" : "effects")
            closeProgramScopes()
        }
        return true
    }

    function restoreInspectorTabForSelection() {
        const selectionType = currentInspectorSelectionType()
        if (selectionType === "none" || selectionType === "multi")
            return
        if (timelineLayoutPreset === "color"
                && inspectorTabValidForType("color", selectionType)) {
            inspectorTab = "color"
