                                        Number(root.currentClip.startSeconds || 0)
                                        + curvePoint.originalSeconds)
                                    timelineDocument.beginContinuousEdit()
                                }
                                onReleased: {
                                    const graphWidth = Math.max(1, curveGraph.width - theme.space16 * 2)
                                    const graphHeight = Math.max(1, curveGraph.height - theme.space16 * 2)
                                    const nextSeconds = Math.max(0, Math.min(
                                        keyframeCurveWindow.curveDuration,
                                        (curvePoint.x + curvePoint.width / 2 - theme.space16)
                                        / graphWidth * keyframeCurveWindow.curveDuration))
                                    const nextValue = curvePoint.maximumValue
                                                      - Math.max(0, Math.min(1,
                                                          (curvePoint.y + curvePoint.height / 2 - theme.space16)
                                                          / graphHeight))
                                                        * (curvePoint.maximumValue - curvePoint.minimumValue)
                                    timelineDocument.moveSelectedClipKeyframe(
                                        root.curveEditorParameter,
                                        curvePoint.originalSeconds,
                                        nextSeconds)
