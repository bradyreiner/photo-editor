    function publishTrackPhase(trackId, points, correlation, peak) {
        const resolvedId = String(trackId || "")
        if (resolvedId.length === 0)
            return
        const next = Object.assign({}, trackPhaseState)
        next[resolvedId] = {
            "points": points || [],
            "correlation": Math.max(-1, Math.min(1, Number(correlation || 0))),
            "peak": Math.max(0, Number(peak || 0)),
            "updatedAt": Date.now()
        }
        trackPhaseState = next
    }

    function programAudioPhaseData() {
        const keys = Object.keys(trackPhaseState)
        let selectedId = ""
        let selected = ({"points": [], "correlation": 0, "peak": 0})
        for (let index = 0; index < keys.length; ++index) {
            const candidate = trackPhaseState[keys[index]] || ({})
            if ((candidate.points || []).length > 0 &&
                    Number(candidate.peak || 0) >= Number(selected.peak || 0)) {
                selectedId = keys[index]
                selected = candidate
            }
        }
        let label = "No active stereo track"
        for (let trackIndex = 0; trackIndex < sequenceTrackModel.length; ++trackIndex) {
            if (String(sequenceTrackModel[trackIndex].trackId || "") === selectedId) {
                label = String(sequenceTrackModel[trackIndex].trackName || selectedId)
                break
            }
        }
        return {
            "points": selected.points || [],
            "correlation": Number(selected.correlation || 0),
            "trackId": selectedId,
            "trackLabel": label,
            "sourceDisclosure": "Post-processing decoded stereo · loudest active Program track"
        }
    }

