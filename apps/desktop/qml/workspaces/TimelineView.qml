                                                const context = getContext("2d")
                                                context.reset()
                                                const values = root.masterLoudnessHistory || []
                                                if (values.length < 2)
                                                    return
                                                context.strokeStyle = Date.now() < root.masterClipUntil
                                                                      ? theme.error : theme.accentCool300
                                                context.lineWidth = 1.5
                                                context.beginPath()
                                                for (let index = 0; index < values.length; ++index) {
                                                    const x = width * index / Math.max(1, values.length - 1)
                                                    const normalized = Math.max(0, Math.min(1,
                                                        (Number(values[index]) + 60) / 60))
                                                    const y = height - normalized * (height - 2) - 1
                                                    if (index === 0) context.moveTo(x, y); else context.lineTo(x, y)
