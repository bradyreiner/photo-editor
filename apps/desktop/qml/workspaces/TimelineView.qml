        modal: true
        focus: true
        width: Math.min(popupAvailableWidth, Math.max(1, Math.min(700, root.width - theme.space24 * 2)))
        x: (root.width - width) / 2
        y: Math.max(theme.space24, (root.height - height) / 2)
        padding: standardPopupPadding
        closePolicy: Popup.CloseOnEscape
        onAboutToShow: contentCreated = true
        onClosed: {
            if (pendingRecoveryCandidateId.length > 0
                    && timelineDocument.recoveryOpenInProgress
                    && timelineDocument.recoveryOpenCandidateId === pendingRecoveryCandidateId)
                timelineDocument.cancelRecoveryOpen()
            pendingRecoveryCandidateId = ""
        }

        background: PopupSurface {}

        contentItem: Loader {
            active: timelineRecoveryPopup.contentCreated
            sourceComponent: Component {
                ColumnLayout {
                    spacing: theme.space12

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: theme.space10

                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: theme.space2

                            Label {
                                text: "Recover Timeline Work"
                                color: theme.textStrong
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeDialogTitle
                                font.weight: Font.DemiBold
                            }

                            Label {
                                Layout.fillWidth: true
                                            text: "Looksy found newer edits that are not in the last saved project file. Review the affected sequence before continuing."
                                color: theme.textMuted
                                font.family: theme.fontUi
                                font.pixelSize: theme.typeBody
                                wrapMode: Text.Wrap
                            }
                        }

                        StatusChip {
                            text: String(root.recoveryCandidateRecords.length)
                            detailText: "Recovery options"
                            tone: "info"
                            compact: true
                            minimumReadableWidth: 48
                        }
                    }

                    Rectangle {
                        Layout.fillWidth: true
                        implicitHeight: recoveryChoiceExplanation.implicitHeight + theme.space10 * 2
                        radius: theme.radiusSurface
                        color: theme.alpha(theme.ink700, 0.30)
                        border.width: 0

                        Label {
                            id: recoveryChoiceExplanation
                            anchors.fill: parent
                            anchors.margins: theme.space10
                            text: "Open works from the recovery and changes nothing until Save. Restore Copy creates a separate project immediately. Discard hides the recovery while preserving the last saved project."
                            color: theme.textMain
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeLabel
                            wrapMode: Text.Wrap
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        visible: timelineDocument.recoveryOpenInProgress
                                 || root.recoveryOpenErrorMessage.length > 0

                        Label {
                            Layout.fillWidth: true
                            text: timelineDocument.recoveryOpenInProgress
                                  ? String(timelineDocument.status ||
                                           "Verifying the recovery before opening it…")
                                  : root.recoveryOpenErrorMessage
                            color: timelineDocument.recoveryOpenInProgress
                                   ? theme.textMuted : theme.warning
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeLabel
                            wrapMode: Text.Wrap
                        }

                        ActionButton {
                            visible: timelineDocument.recoveryOpenInProgress
                            text: "Cancel Opening"
                            compact: true
                            onClicked: timelineDocument.cancelRecoveryOpen()
                        }
                    }

                    Label {
                        Layout.fillWidth: true
                        visible: timelineDocument.recoveryCandidatesLoading
                                 && root.recoveryCandidateRecords.length === 0
                        text: "Checking recovery files…"
                        color: theme.textMuted
                        font.family: theme.fontMono
                        font.pixelSize: theme.typeCaption
                    }

                    ListView {
                        id: timelineRecoveryList
                        objectName: "timelineRecoveryCandidateList"
                        Layout.fillWidth: true
                        Layout.preferredHeight: Math.min(360, Math.max(126, count * 122))
                        clip: true
                        spacing: theme.space6
                        model: root.recoveryCandidateRecords
                        ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }

                        delegate: Rectangle {
                            required property var modelData
                            required property int index
                            width: timelineRecoveryList.width
                            height: Math.max(112, recoveryCardContent.implicitHeight + theme.space10 * 2)
                            radius: theme.radiusSurface
                            color: theme.alpha(theme.ink700, 0.34)
                            border.width: 0

                            RowLayout {
                                id: recoveryCardContent
                                anchors.fill: parent
                                anchors.margins: theme.space10
                                spacing: theme.space10

                                Rectangle {
                                    Layout.preferredWidth: 4
                                    Layout.fillHeight: true
                                    radius: 2
                                    color: modelData.kind === "journal" ? theme.accentCool400 : theme.warning
                                    opacity: 0.78
                                }

                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: theme.space2

                                    RowLayout {
                                        Layout.fillWidth: true
                                        spacing: theme.space6

                                        Label {
                                            Layout.fillWidth: true
                                            text: String(modelData.name || "Recovered Timeline")
                                            color: theme.textStrong
                                            font.family: theme.fontUi
                                            font.pixelSize: theme.typeBody
                                            font.weight: Font.DemiBold
                                            wrapMode: Text.Wrap
                                        }

                                        StatusChip {
                                            text: modelData.kind === "journal" ? "Edit journal" : "Autosave"
                                            tone: modelData.damagedTail === true ? "warning" : "info"
                                            compact: true
                                            minimumReadableWidth: 84
                                        }
                                    }

                                    Label {
                                        Layout.fillWidth: true
                                        text: root.sequenceVersionDateText(modelData.timestamp) + "  ·  " +
                                              String(modelData.summary || "")
                                        color: theme.textMuted
                                        font.family: theme.fontMono
                                        font.pixelSize: theme.typeCaption
                                        wrapMode: Text.Wrap
                                    }

                                    Label {
                                        Layout.fillWidth: true
                                        text: modelData.damagedTail === true
                                              ? "The journal ended mid-write. This is the latest complete, hash-verified edit before that point."
                                              : "Affected sequence: " + String(modelData.name || "Timeline")
                                        color: modelData.damagedTail === true ? theme.warning : theme.textFaint
                                        font.family: theme.fontUi
                                        font.pixelSize: theme.typeCaption
                                        wrapMode: Text.Wrap
                                    }
                                }

                                ActionButton {
                                    objectName: "timelineOpenRecoveryButton"
                                    text: "Open"
                                    iconName: "folder"
                                    tone: "primary"
                                    compact: true
                                    enabled: !timelineDocument.recoveryOpenInProgress
                                    tooltipText: String(modelData.openExplanation || "Open recovered work.")
                                    onClicked: {
                                        const candidateId = String(modelData.candidateId || "")
                                        root.recoveryOpenErrorMessage = ""
                                        timelineRecoveryPopup.pendingRecoveryCandidateId = candidateId
                                        if (!timelineDocument.openRecoveryCandidate(candidateId)) {
                                            timelineRecoveryPopup.pendingRecoveryCandidateId = ""
                                            root.recoveryOpenErrorMessage = String(timelineDocument.status ||
                                                                                   "Recovery could not be opened. Your current timeline remains open.")
                                        }
                                    }
                                }

                                MenuButton {
                                    objectName: "timelineRecoveryActionsButton"
                                    text: "More"
                                    iconName: "more"
                                    compact: true
                                    enabled: !timelineDocument.recoveryOpenInProgress
                                    primaryOpensMenu: true
                                    secondaryActionMenu: true
                                    menuWidth: 280
                                    menuItems: [
                                        {
                                            "key": "copy",
                                            "label": "Restore as separate copy",
                                            "icon": "copy",
                                            "tooltip": String(modelData.restoreCopyExplanation || "Create an independent recovered copy.")
                                        },
                                        {
                                            "key": "discard",
                                            "label": "Discard recovery",
                                            "icon": "delete",
                                            "danger": true,
                                            "separatorBefore": true,
                                            "tooltip": String(modelData.discardExplanation || "Discard this recovery option.")
                                        }
                                    ]
                                    onMenuItemTriggered: function(key) {
                                        if (key === "copy") {
                                            if (timelineDocument.restoreRecoveryCandidateAsCopy(
                                                        String(modelData.candidateId)))
                                                timelineRecoveryPopup.close()
                                        } else if (key === "discard") {
                                            timelineDocument.discardRecoveryCandidate(
                                                        String(modelData.candidateId))
                                        }
                                    }
                                }
                            }
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true

                        Label {
                            Layout.fillWidth: true
                            text: "Recovery never rewrites the last saved file in the background."
                            color: theme.textFaint
                            font.family: theme.fontUi
                            font.pixelSize: theme.typeCaption
                            wrapMode: Text.Wrap
                        }

                        ActionButton {
                            text: "Not Now"
                            compact: true
                            onClicked: timelineRecoveryPopup.close()
                        }
                    }
                }
            }
        }
    }

