                                        String(modelData.notes || ""),
                                        String(modelData.author || "Local editor"),
                                        modelData.protected !== true)
                                } else if (key === "remove") {
                                    timelineDocument.deleteSequenceVersion(String(modelData.versionId))
                                }
                            }
                        }
