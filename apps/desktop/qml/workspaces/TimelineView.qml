    readonly property var timelineChapterRanges: {
        const chapters = (sequenceMarkerModel || []).filter(function(marker) {
            return marker.reviewNote !== true
        }).slice().sort(function(a, b) { return Number(a.seconds || 0) - Number(b.seconds || 0) })
        return chapters.map(function(marker, index) {
