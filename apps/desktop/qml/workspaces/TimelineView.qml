    function snapSequenceResult(proposedSeconds, excludedClipId, useCache, excludedMarkerId) {
        if (!snappingEnabled)
            return {
                "seconds": Math.max(0, Number(proposedSeconds || 0)),
                "snapped": false,
                "kind": "",
                "label": ""
            }

        const thresholdSeconds = snapThresholdPixels / Math.max(1, timelineZoom)
        return timelineDocument.resolveTimelineSnap(
                    Math.max(0, Number(proposedSeconds || 0)),
