    function relinkCandidatePaths(substitution) {
        const paths = []
        const matches = substitution && substitution.matches
                      ? substitution.matches : []
        for (let index = 0; index < matches.length; ++index)
            paths.push(String(matches[index].candidatePath || ""))
        return paths
    }

    function relinkCandidateMatch(substitution, candidatePath) {
        const matches = substitution && substitution.matches
                      ? substitution.matches : []
        for (let index = 0; index < matches.length; ++index) {
            if (String(matches[index].candidatePath || "") === String(candidatePath || ""))
                return matches[index]
        }
        return ({})
    }

    function updateBatchRelinkSubstitution(index, candidatePath, approved) {
        const updated = root.batchRelinkSubstitutions.slice()
        const item = Object.assign({}, updated[index] || ({}))
        item.candidatePath = String(candidatePath || "")
        item.approved = approved === true
        updated[index] = item
        root.batchRelinkSubstitutions = updated
