        }
        timelineZoom = Math.max(timelineZoomMin,
                                Math.min(timelineZoomMax,
                                         Number(timelineWorkspaceSettings.timelineZoom || 84)))
        timelineWorkspaceSettings.shellLayoutVersion = 4
        snappingEnabled = timelineWorkspaceSettings.snappingEnabled
        audioPeakSnappingEnabled = timelineWorkspaceSettings.audioPeakSnappingEnabled
        rippleModeEnabled = timelineWorkspaceSettings.rippleModeEnabled
        previewQualityMode = timelineWorkspaceSettings.previewQualityMode
