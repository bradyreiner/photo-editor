    function requestMotionSeedSourceFrame() {
        const clip = root.currentClip
        const assetId = String(clip && (clip.assetId || clip.clipId) || "")
        const filePath = String(clip && clip.filePath || "")
        const sourceSeconds = Math.round(Number(clip && clip.trimStartSeconds || 0) * 1000) / 1000
        root.motionSeedFrameAssetId = assetId
        root.motionSeedFrameSourceSeconds = sourceSeconds
        root.motionSeedFrameSource = ""
        root.motionSeedAwaitingFirstFrame = true
        root.motionTrackingUiMessage = "Loading the first source frame…"
        if (assetId.length === 0 || filePath.length === 0) {
            root.motionSeedAwaitingFirstFrame = false
            root.motionTrackingUiMessage = "The source file is unavailable. Reopen the tracking panel to enter the region numerically."
            root.motionSeedSelectionActive = false
            root.motionSeedSelectionHudVisible = false
            return false
        }
        const cachedSource = String(timelineDocument.requestMediaHoverFrame(
                                         assetId, filePath, sourceSeconds) || "")
        if (cachedSource.length > 0)
            root.motionSeedFrameSource = cachedSource
        return true
    }

