    function deleteSelectedTimelineClip() {
        if (timelineDocument.selectedClipCount > 1) {
            if (rippleModeEnabled)
                timelineDocument.extractSelectedClips()
            else
                timelineDocument.liftSelectedClips()
            return
        }
        if (rippleModeEnabled)
            timelineDocument.extractSelectedClip()
        else
            timelineDocument.liftSelectedClip()
    }

    function clipWidth(durationSeconds) {
        return Math.max(minimumClipWidth, Number(durationSeconds || 0) * timelineZoom)
    }

    function snapSequenceSeconds(proposedSeconds, excludedClipId) {
        return snapSequenceResult(proposedSeconds, excludedClipId).seconds
    }

    function snapSequenceResult(proposedSeconds, excludedClipId, useCache, excludedMarkerId, excludedClipIds) {
        if (!snappingEnabled)
            return {
                "seconds": Math.max(0, Number(proposedSeconds || 0)),
                "snapped": false,
                "kind": "",
                "label": ""
            }

        const thresholdSeconds = snapThresholdPixels / Math.max(1, timelineZoom)
        const excludedIds = excludedClipIds || []
        if (excludedIds.length > 0) {
            return timelineDocument.resolveTimelineSnapForClips(
                        Math.max(0, Number(proposedSeconds || 0)),
                        thresholdSeconds,
                        excludedIds,
                        String(excludedMarkerId || ""),
                        audioPeakSnappingEnabled)
        }
        return timelineDocument.resolveTimelineSnap(
                    Math.max(0, Number(proposedSeconds || 0)),
                    thresholdSeconds,
                    String(excludedClipId || ""),
                    String(excludedMarkerId || ""),
                    audioPeakSnappingEnabled)
    }

    function snapGroupBoundsResult(proposedStartSeconds, durationSeconds, excludedClipId,
                                   useCache, excludedClipIds) {
        const ids = excludedClipIds || []
        const leading = root.snapSequenceResult(
                    proposedStartSeconds, excludedClipId, useCache, "", ids)
        if (ids.length < 2)
            return {"startSeconds": leading.seconds, "snapResult": leading}

        const trailing = root.snapSequenceResult(
                    Number(proposedStartSeconds || 0) + Math.max(0, Number(durationSeconds || 0)),
                    excludedClipId, useCache, "", ids)
        if (trailing.snapped === true
                && (leading.snapped !== true
                    || Number(trailing.distance || 0) < Number(leading.distance || 0))) {
            return {
                "startSeconds": Math.max(
                    0, Number(trailing.seconds || 0) - Math.max(0, Number(durationSeconds || 0))),
                "snapResult": trailing
            }
        }
        return {"startSeconds": leading.seconds, "snapResult": leading}
    }

    function selectedClipDragGeometry(anchorClip) {
        const anchorId = String(anchorClip && anchorClip.clipId || "")
        const anchorStart = Number(anchorClip && anchorClip.startSeconds || 0)
        const anchorEnd = anchorStart + Math.max(
                    0, Number(anchorClip && anchorClip.trimmedDurationSeconds || 0))
        const selectedIds = timelineDocument.selectedClipIds || []
        if (selectedIds.length < 2 || selectedIds.indexOf(anchorId) < 0) {
            return {
                "clipIds": anchorId.length > 0 ? [anchorId] : [],
                "anchorStartSeconds": anchorStart,
                "minimumStartSeconds": anchorStart,
                "maximumEndSeconds": anchorEnd,
                "selectedSpanSeconds": Math.max(0, anchorEnd - anchorStart)
            }
        }

        const selectedSet = ({})
        for (let index = 0; index < selectedIds.length; ++index)
            selectedSet[String(selectedIds[index])] = true
        const clips = []
        const tracks = sequenceTrackModel || []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const track = tracks[trackIndex]
            if (!track)
                continue
            const trackClips = track.clips || []
            for (let clipIndex = 0; clipIndex < trackClips.length; ++clipIndex) {
                const clip = trackClips[clipIndex]
                const clipId = String(clip && clip.clipId || "")
                let alreadyAdded = false
                for (let existingIndex = 0; existingIndex < clips.length; ++existingIndex) {
                    if (String(clips[existingIndex].clipId || "") === clipId) {
                        alreadyAdded = true
                        break
                    }
                }
                if (selectedSet[clipId] !== true || alreadyAdded)
                    continue
                clips.push(clip)
            }
        }

        let minimumStart = anchorStart
        let maximumEnd = anchorEnd
        const movingIds = []
        const intervals = []
        for (let index = 0; index < clips.length; ++index) {
            const clip = clips[index]
            const start = Number(clip.startSeconds || 0)
            const end = start + Math.max(0, Number(clip.trimmedDurationSeconds || 0))
            minimumStart = Math.min(minimumStart, start)
            maximumEnd = Math.max(maximumEnd, end)
            movingIds.push(String(clip.clipId || ""))
            intervals.push([start, end])
        }
        if (movingIds.indexOf(anchorId) < 0)
            movingIds.push(anchorId)
        intervals.sort(function(left, right) { return left[0] - right[0] })
        let selectedSpan = 0
        let intervalStart = -1
        let intervalEnd = -1
        for (let index = 0; index < intervals.length; ++index) {
            if (intervalStart < 0 || intervals[index][0] > intervalEnd) {
                if (intervalStart >= 0)
                    selectedSpan += Math.max(0, intervalEnd - intervalStart)
                intervalStart = intervals[index][0]
                intervalEnd = intervals[index][1]
            } else {
                intervalEnd = Math.max(intervalEnd, intervals[index][1])
            }
        }
        if (intervalStart >= 0)
            selectedSpan += Math.max(0, intervalEnd - intervalStart)
        return {
            "clipIds": movingIds,
            "anchorStartSeconds": anchorStart,
            "minimumStartSeconds": minimumStart,
            "maximumEndSeconds": maximumEnd,
            "selectedSpanSeconds": selectedSpan
        }
    }

    function seekTimelineFromX(xPos) {
        requestTimelineSeek(Math.max(0, Math.min(sequenceDurationSeconds(), xPos / timelineZoom)))
    }

    function beginTimelineSeekGesture() {
        if (timelineSeekGestureActive)
            return
        timelineSeekGestureActive = true
        timelineSeeking = true
        if (sequencePlaying)
            timelinePlayback.pause()
    }

    function finishTimelineSeekGesture() {
        if (!timelineSeekGestureActive)
            return
        timelineSeekCommitTimer.stop()
        commitPendingTimelineSeek()
        timelineSeekGestureActive = false
        interactionPlayheadPreviewSeconds = -1
        timelineSeeking = false
    }

    function commitPendingTimelineSeek() {
        if (!timelineSeekCommitPending)
            return false
        timelineSeekCommitPending = false
        const requestedSeconds = pendingTimelineSeekSeconds
        if (sequencePlaying)
            timelinePlayback.pause()
        timelinePlayback.seekSequenceSeconds(requestedSeconds)
        if (!timelineSeekGestureActive) {
            interactionPlayheadPreviewSeconds = -1
            timelineSeeking = false
        }
        return true
    }

    function requestTimelineSeek(seconds) {
        const clamped = Math.max(0, Math.min(sequenceDurationSeconds(), Number(seconds || 0)))
        pendingTimelineSeekSeconds = clamped
        interactionPlayheadPreviewSeconds = clamped
        timelineSeeking = true
        timelineSeekCommitPending = true
        timelinePlayback.setLikelyNextEditSeconds(clamped)
        if (!timelineSeekCommitTimer.running)
            timelineSeekCommitTimer.start()
    }

    function requestSelectedTrimEndToSequenceSeconds(seconds) {
        const clipStart = Number(currentClip && currentClip.startSeconds || 0)
        const minimumEnd = clipStart + 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const requested = Math.max(minimumEnd, Number(seconds || minimumEnd))
        pendingTrimEndSequenceSeconds = requested
        interactionTrimEndSequenceSeconds = requested
        timelinePlayback.setLikelyNextEditSeconds(requested)
        timelineTrimCommitTimer.restart()
    }

    function commitPendingTrimEnd() {
        timelineTrimCommitTimer.stop()
        const requestedSeconds = pendingTrimEndSequenceSeconds
        pendingTrimEndSequenceSeconds = -1
        interactionTrimEndSequenceSeconds = -1
        if (requestedSeconds >= 0)
            timelineDocument.trimSelectedClipEndToSequenceSeconds(requestedSeconds, rippleModeEnabled)
    }

    function requestSelectedFadeInSeconds(seconds) {
        const requested = Math.max(0, Number(seconds || 0))
        pendingFadeInSeconds = requested
        interactionFadeInSeconds = requested
        timelineFadeCommitTimer.restart()
    }

    function timelineX(seconds) {
        return Math.max(0, Number(seconds || 0)) * timelineZoom
    }

    function setTimelineZoom(newZoom, anchorX) {
        const oldZoom = timelineZoom
        const clampedZoom = Math.max(timelineZoomMin, Math.min(timelineZoomMax, newZoom))
        if (Math.abs(clampedZoom - oldZoom) < 0.01)
            return
        const ratio = clampedZoom / oldZoom
        timelineZoom = clampedZoom
        timelineViewport.contentX = Math.max(0, anchorX * ratio - (anchorX - timelineViewport.contentX))
    }

    function zoomToFit() {
        const duration = sequenceDurationSeconds()
        if (duration <= 0)
            return
        const availableWidth = timelineViewport.width - 40
        timelineZoom = Math.max(timelineZoomMin, Math.min(timelineZoomMax, availableWidth / duration))
        timelineViewport.contentX = 0
    }

    function zoomToSelection() {
        if (timelineDocument.currentIndex < 0) {
            zoomToFit()
            return
        }
        const start = Math.max(0, Number(currentClip.startSeconds || 0))
        const duration = Math.max(
                    1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)),
                    Number(currentClip.trimmedDurationSeconds || 0))
        const horizontalPadding = Math.min(120, Math.max(32, timelineViewport.width * 0.12))
        const availableWidth = Math.max(80, timelineViewport.width - horizontalPadding * 2)
        timelineZoom = Math.max(timelineZoomMin,
                                Math.min(timelineZoomMax, availableWidth / duration))
        timelineViewport.contentX = Math.max(0, timelineX(start) - horizontalPadding)
    }

    function rulerInterval() {
        const fps = Math.max(1, Math.round(Number(timelineDocument.framesPerSecond || 30)))
        const candidates = [1 / fps, 2 / fps, 5 / fps, 10 / fps,
                            0.5, 1, 2, 5, 10, 15, 30, 60, 120, 300]
        for (let index = 0; index < candidates.length; ++index) {
            if (candidates[index] * timelineZoom >= 8)
                return candidates[index]
        }
        return candidates[candidates.length - 1]
    }

    function rulerLabelInterval() {
        const fps = Math.max(1, Math.round(Number(timelineDocument.framesPerSecond || 30)))
        const candidates = [1 / fps, 2 / fps, 5 / fps, 10 / fps,
                            0.5, 1, 2, 5, 10, 15, 30, 60, 120, 300, 600]
        for (let index = 0; index < candidates.length; ++index) {
            if (candidates[index] * timelineZoom >= 72)
                return candidates[index]
        }
        return candidates[candidates.length - 1]
    }

    function isMajorRulerTick(seconds) {
        const labelInterval = rulerLabelInterval()
        const ratio = seconds / Math.max(0.000001, labelInterval)
        return Math.abs(ratio - Math.round(ratio)) < 0.001
    }

    function rulerLabel(seconds) {
        const interval = rulerLabelInterval()
        const fps = Math.max(1, Math.round(Number(timelineDocument.framesPerSecond || 30)))
        if (interval < 1) {
            const totalFrames = Math.round(seconds * fps)
            const s = Math.floor(totalFrames / fps)
            const f = totalFrames % fps
            const m = Math.floor(s / 60)
            return String(m).padStart(2, "0") + ":" + String(s % 60).padStart(2, "0") + ":" + String(f).padStart(2, "0")
        }
        return formatSeconds(seconds)
    }

    function splitAtPlayhead() {
        if (!hasSplitSelection())
