                                    "icon": modelData.protected === true ? "unlock" : "lock",
                                    "enabled": String(modelData.kind || "named") === "named",
                                    "disabledReason": "Automatic recovery checkpoints cannot become milestones.",
                                    "tooltip": "Protected milestones cannot be removed until explicitly unprotected."
                                },
                                {
                                    "key": "remove",
                                    "label": "Remove version",
                                    "icon": "delete",
                                    "danger": true,
