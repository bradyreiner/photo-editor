    function refreshBackgroundJobs() {
        const persistent = jobQueue ? jobQueue.jobsForCenter() : []
        const timelineLocal = timelineDocument.timelineBackgroundJobs()
        let combined = []
        for (let index = 0; index < persistent.length; ++index)
            combined.push(persistent[index])
        for (let index = 0; index < timelineLocal.length; ++index)
            combined.push(timelineLocal[index])
        const statusRank = function(status) {
            if (status === "Running" || status === "Canceling" || status === "Pausing") return 0
            if (status === "Queued" || status === "Paused") return 1
            if (status === "Failed") return 2
            if (status === "Canceled") return 3
            return 4
        }
        const priorityRank = function(priority) {
            return priority === "high" ? 0 : priority === "low" ? 2 : 1
        }
        combined.sort(function(left, right) {
            const statusDifference = statusRank(String(left.status || ""))
                                     - statusRank(String(right.status || ""))
            if (statusDifference !== 0)
                return statusDifference
            const priorityDifference = priorityRank(String(left.priority || "normal"))
                                       - priorityRank(String(right.priority || "normal"))
            if (priorityDifference !== 0)
                return priorityDifference
            return String(right.updatedAt || right.createdAt || "")
                    .localeCompare(String(left.updatedAt || left.createdAt || ""))
        })
        root.backgroundJobsData = combined
    }

    function visibleBackgroundJobs() {
        if (root.backgroundJobsShowFinished)
            return root.backgroundJobsData
        let values = []
        for (let index = 0; index < root.backgroundJobsData.length; ++index) {
            const status = String(root.backgroundJobsData[index].status || "")
            if (status !== "Completed" && status !== "Canceled")
                values.push(root.backgroundJobsData[index])
        }
        return values
    }

    function backgroundJobCount(statuses) {
        let count = 0
        for (let index = 0; index < root.backgroundJobsData.length; ++index) {
            if (statuses.indexOf(String(root.backgroundJobsData[index].status || "")) >= 0)
                ++count
        }
        return count
    }

