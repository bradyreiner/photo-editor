    readonly property var trackHeaderOrderDataByTrackId: {
        const tracks = sequenceTrackModel || []
        const states = ({})
        const graphicsTracks = []
        const independentAudioTracks = []
        const seenGroupIds = ({})

        for (let index = 0; index < tracks.length; ++index) {
            const track = tracks[index]
            const trackId = String(track && track.trackId || "")
            const groupId = String(track && track.groupId || "")
            states[trackId] = {
                "standaloneVisualPosition": -1,
                "standaloneVisualCount": 0,
                "independentAudioPosition": -1,
                "independentAudioCount": 0,
                "isGroupHead": false,
                "groupDepth": Number(trackGroupHierarchyById[groupId]
                                     ? trackGroupHierarchyById[groupId].depth || 0 : 0)
            }
            if (track && track.isStandaloneVisual === true)
                graphicsTracks.push({"trackId": trackId,
                                     "laneIndex": Number(track.laneIndex || 0),
                                     "trackIndex": index})
            if (track && track.trackKind === "audio" && track.isIndependent === true)
                independentAudioTracks.push({"trackId": trackId,
                                             "laneIndex": Number(track.laneIndex || 0),
                                             "trackIndex": index})
            if (groupId.length > 0 && seenGroupIds[groupId] !== true) {
                seenGroupIds[groupId] = true
                states[trackId].isGroupHead = true
            }
        }

        const laneOrder = function(left, right) {
            if (left.laneIndex !== right.laneIndex)
                return left.laneIndex - right.laneIndex
            return left.trackIndex - right.trackIndex
        }
        graphicsTracks.sort(laneOrder)
        independentAudioTracks.sort(laneOrder)
        for (let index = 0; index < graphicsTracks.length; ++index) {
            const state = states[graphicsTracks[index].trackId]
            state.standaloneVisualPosition = index
            state.standaloneVisualCount = graphicsTracks.length
        }
        for (let index = 0; index < independentAudioTracks.length; ++index) {
            const state = states[independentAudioTracks[index].trackId]
            state.independentAudioPosition = index
            state.independentAudioCount = independentAudioTracks.length
        }
        return states
    }
