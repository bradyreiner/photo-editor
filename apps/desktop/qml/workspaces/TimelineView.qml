        } catch (error) {
            inspectorDisclosureByType = ({})
            timelineWorkspaceSettings.inspectorDisclosureByTypeJson = "{}"
        }
        try {
            effectFavorites = normalizedEffectNames(
                        JSON.parse(String(timelineWorkspaceSettings.effectFavoritesJson || "[]")),
                        effectLibraryModel.length)
        } catch (error) {
            effectFavorites = []
            timelineWorkspaceSettings.effectFavoritesJson = "[]"
        }
        try {
            effectRecents = normalizedEffectNames(
                        JSON.parse(String(timelineWorkspaceSettings.effectRecentsJson || "[]")), 8)
        } catch (error) {
            effectRecents = []
            timelineWorkspaceSettings.effectRecentsJson = "[]"
        }
        const savedEffectCategory = String(timelineWorkspaceSettings.effectDiscoveryCategory || "All")
        effectDiscoveryCategory = ["All", "Favorites", "Recent", "Color", "Style", "Utility"]
                .indexOf(savedEffectCategory) >= 0 ? savedEffectCategory : "All"
        compatibleEffectsOnly = timelineWorkspaceSettings.compatibleEffectsOnly
        sourcePanelWidth = needsShellMigration ? 300 : Math.max(260, Number(timelineWorkspaceSettings.sourcePanelWidth || 300))
        effectsPanelWidth = needsShellMigration ? 320 : Math.max(280, Number(timelineWorkspaceSettings.effectsPanelWidth || 320))
        monitorPanelHeight = needsShellMigration ? 540
                                                 : Math.max(300,
                                                            Math.min(720,
                                                                     Number(timelineWorkspaceSettings.monitorPanelHeight || 540)))
        setLaneHeaderWidth(Number(timelineWorkspaceSettings.laneHeaderWidth || 144))
        try {
