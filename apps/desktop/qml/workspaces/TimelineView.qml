    Timer {
        id: trackMeterDecayTimer
        interval: 80
        repeat: true
        running: !root.audioMeterReducedMotion
                 && (root.sequencePlaying || Object.keys(root.trackMeterState).length > 0)
        onTriggered: {
            const next = ({})
            const now = Date.now()
            const keys = Object.keys(root.trackMeterState)
            for (let index = 0; index < keys.length; ++index) {
                const key = keys[index]
                const meter = root.trackMeterState[key]
                const left = Number(meter.left || 0) * 0.72
                const right = Number(meter.right || 0) * 0.72
                const rmsLeft = Number(meter.rmsLeft || 0) * 0.82
                const rmsRight = Number(meter.rmsRight || 0) * 0.82
                const truePeakLeft = Number(meter.truePeakLeft || 0) * 0.72
                const truePeakRight = Number(meter.truePeakRight || 0) * 0.72
                const clipUntil = Number(meter.clipUntil || 0)
                if (left > 0.004 || right > 0.004 || rmsLeft > 0.001 || rmsRight > 0.001 || clipUntil > now)
                    next[key] = ({"left": left, "right": right,
                                  "rmsLeft": rmsLeft, "rmsRight": rmsRight,
                                  "truePeakLeft": truePeakLeft,
                                  "truePeakRight": truePeakRight,
                                  "clipUntil": clipUntil,
                                  "overloadLatched": meter.overloadLatched === true})
            }
            root.trackMeterState = next
            root.updateMasterLoudness(next)
        }
    }

