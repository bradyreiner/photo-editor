        multicamPopup.contentCreated = true
        multicamPopup.open()
        Qt.callLater(function() { multicamPopup.contentFocus.forceActiveFocus() })
    }

    function multicamAudioOptionLabels(group) {
        const labels = ["Follow Program"]
        const angles = group && group.angles ? group.angles : []
        for (let index = 0; index < angles.length; ++index)
            labels.push("Angle " + String(index + 1) + " · "
                        + String(angles[index].label || "Camera"))
        labels.push("Mute Camera Audio")
        return labels
    }

    function multicamAudioOptionIndex(group) {
        const angleCount = Number(group && group.angleCount || 0)
        const mode = String(group && group.audioMode || "follow-video")
        if (mode === "mute")
            return angleCount + 1
        if (mode === "fixed-angle")
            return Math.min(angleCount, Math.max(0, Number(group.audioAngleIndex || 0))) + 1
        return 0
    }

    function applyMulticamAudioOption(group, optionIndex) {
        const groupId = String(group && group.groupId || "")
        const angleCount = Number(group && group.angleCount || 0)
        if (groupId.length === 0)
            return
        if (optionIndex === 0)
            timelineDocument.setMulticamAudioMode(groupId, "follow-video", -1)
        else if (optionIndex > angleCount)
            timelineDocument.setMulticamAudioMode(groupId, "mute", -1)
        else
            timelineDocument.setMulticamAudioMode(groupId, "fixed-angle", optionIndex - 1)
    }

    function openTitleTemplatePicker() {
        titleTemplateFocusReturnItem = root.Window.window
                                       ? root.Window.window.activeFocusItem
                                       : timelineViewport
        titleTemplatePopup.open()
    }

    function transcriptSegmentMatches(segment) {
        const query = root.transcriptSearchQuery.trim().toLowerCase()
        return query.length === 0 || String(segment && segment.text ? segment.text : "").toLowerCase().indexOf(query) >= 0
    }

    function transcriptWordSelected(word) {
        if (root.transcriptSelectionStart < 0 || root.transcriptSelectionEnd <= root.transcriptSelectionStart)
            return false
        return Number(word.endSeconds || 0) > root.transcriptSelectionStart + 0.0001
                && Number(word.startSeconds || 0) < root.transcriptSelectionEnd - 0.0001
    }

    function transcriptWordPendingKind(word) {
        const wordStart = Number(word.startSeconds || 0)
        const wordEnd = Number(word.endSeconds || wordStart)
        const operations = timelineDocument.pendingTextBasedEdits || []
        for (let index = 0; index < operations.length; ++index) {
            const operation = operations[index]
            if (Number(operation.endSeconds || 0) > wordStart + 0.0001
                    && Number(operation.startSeconds || 0) < wordEnd - 0.0001)
                return String(operation.kind || "")
        }
        return ""
    }

    function chooseTranscriptWord(word, segment) {
        const wordStart = Number(word.startSeconds || 0)
        const wordEnd = Number(word.endSeconds || wordStart)
        root.transcriptEditSegmentId = String(segment && segment.segmentId || "")
        root.transcriptEditWordIndex = Number(word.index === undefined ? -1 : word.index)
        root.transcriptEditText = String(word.text || "")
        root.transcriptEditSpeaker = String(word.speaker || segment && segment.speaker || "")
        root.transcriptEditConfidence = Number(word.confidence === undefined ? 1 : word.confidence)
        root.disarmPopupControl(transcriptEditorPopup.extractControl)
        if (!root.transcriptSelectionPrimed) {
            root.transcriptSelectionAnchor = wordStart
            root.transcriptSelectionStart = wordStart
            root.transcriptSelectionEnd = wordEnd
            root.transcriptSelectionPrimed = true
            timelinePlayback.seekSequenceSeconds(wordStart)
            return
        }
        root.transcriptSelectionStart = Math.min(root.transcriptSelectionAnchor, wordStart)
        root.transcriptSelectionEnd = Math.max(root.transcriptSelectionAnchor, wordEnd)
        root.transcriptSelectionPrimed = false
        timelinePlayback.seekSequenceSeconds(root.transcriptSelectionStart)
    }

    function saveTranscriptWordCorrection() {
        if (root.transcriptEditSegmentId.length === 0 || root.transcriptEditWordIndex < 0)
            return
        if (timelineDocument.updateTranscriptWord(
                    root.transcriptEditSegmentId,
                    root.transcriptEditWordIndex,
                    root.transcriptEditText,
                    root.transcriptEditSpeaker)) {
            root.transcriptEditText = root.transcriptEditText.trim()
            root.transcriptEditSpeaker = root.transcriptEditSpeaker.trim()
        }
    }

    function captionSegmentationOptions() {
        return {
            "maxCharsPerLine": Number(root.captionMaxCharsDraft || 32),
            "maxLines": Number(root.captionMaxLinesDraft || 2),
            "maxReadingSpeedCps": Number(root.captionReadingSpeedDraft || 20),
            "minimumDurationSeconds": Number(root.captionMinimumDurationDraft || 1),
            "minimumGapFrames": Number(root.captionMinimumGapDraft || 2),
            "semanticLineBreaks": true
        }
    }

    function previewCaptionSegmentation() {
        root.captionSegmentationPreview = timelineDocument.previewCaptionSegmentation(
                    root.captionSegmentationOptions())
    }

    function applyCaptionSegmentation() {
        if (root.captionSegmentationPreview.valid !== true)
            return
        if (timelineDocument.applyCaptionSegmentation(root.captionSegmentationOptions())) {
            root.captionSegmentationPreview = ({})
            root.refreshCaptionValidation()
        }
    }

    function refreshCaptionValidation() {
        root.captionValidationData = timelineDocument.validateCaptions(
                    root.captionValidationFormat)
    }

    function captionStyleTemplateLabels() {
        const templates = timelineDocument.captionStyleTemplates || []
        let labels = []
        for (let index = 0; index < templates.length; ++index)
            labels.push(String(templates[index].name || "Caption Style"))
        return labels
    }

    function captionStyleTemplateAt(index) {
        const templates = timelineDocument.captionStyleTemplates || []
        if (templates.length === 0)
            return ({})
        const bounded = Math.max(0, Math.min(templates.length - 1, Number(index || 0)))
        return templates[bounded]
    }

    function captionStyleAspectIndex() {
        if (root.captionStyleAspectKey === "vertical")
            return 1
        if (root.captionStyleAspectKey === "square")
            return 2
        if (root.captionStyleAspectKey === "portrait")
            return 3
        return 0
    }

    function captionStyleAspectKeyAt(index) {
        return ["landscape", "vertical", "square", "portrait"][Math.max(0, Math.min(3, index))]
    }

    function effectiveCaptionStylePreview() {
        const preview = root.captionStyleTemplatePreviewData || ({})
        let result = Object.assign({}, preview.style || ({}))
        const overrides = preview.aspectOverrides || ({})
        const aspectStyle = overrides[root.captionStyleAspectKey] || ({})
        const keys = Object.keys(aspectStyle)
        for (let index = 0; index < keys.length; ++index)
            result[keys[index]] = aspectStyle[keys[index]]
        return result
    }

    function refreshCaptionStyleTemplatePreview(preferredTemplateId) {
        const templates = timelineDocument.captionStyleTemplates || []
        if (templates.length === 0) {
            root.captionStyleTemplateIndex = 0
            root.captionStyleTemplatePreviewData = ({})
            return
        }
        let nextIndex = Math.max(0, Math.min(templates.length - 1,
                                             root.captionStyleTemplateIndex))
        const preferredId = String(preferredTemplateId || "")
        if (preferredId.length > 0) {
            for (let index = 0; index < templates.length; ++index) {
                if (String(templates[index].templateId || "") === preferredId) {
                    nextIndex = index
                    break
                }
            }
        }
        root.captionStyleTemplateIndex = nextIndex
        const selected = templates[nextIndex]
        root.captionStyleTemplatePreviewData = timelineDocument.captionStyleTemplatePreview(
                    String(selected.templateId || ""))
    }

    function selectCaptionStyleTemplate(index) {
        root.captionStyleTemplateIndex = Number(index || 0)
        root.refreshCaptionStyleTemplatePreview("")
        root.disarmPopupControl(transcriptEditorPopup.styleDeleteControl)
