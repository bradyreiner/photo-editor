    // Keep user intent independently of expensive panel objects. Controller
    // state and Undo never belong to the evictable UI cache.
    function rememberPanelSession(panelId, panel) {
        if (!panel)
            return
        if (typeof panel.suspendForRelease === "function")
            panel.suspendForRelease()
        const keys = ["mediaSearchText", "mediaSearchScopes", "mediaViewMode",
            "mediaThumbnailTargetSize", "mediaFilmstripDensity", "mediaGridScrollPosition",
            "mediaListScrollPosition", "selectedMediaBinId", "selectedMediaAssetIds",
            "mediaSelectionAnchorIndex", "mediaBinDraft", "mediaBinRenameDraft", "mediaTagsDraft",
            "takeComparisonAssets", "takeComparisonPlaying", "mediaUsageFilter",
            "mediaUsageCanonicalAssetId", "previewSeconds",
            "suspendedSourceSeconds", "suspendedSourceUrl",
            "mediaInspectorAsset", "mediaInspectorTechnical",
            "mediaInspectorNotesDraft", "mediaInspectorCustomFieldsDraft", "mediaInspectorApplyStatus",
            "smartCollectionEditingId", "smartCollectionNameDraft", "smartCollectionMediaTypeDraft",
            "smartCollectionRatingDraft", "smartCollectionLabelDraft", "smartCollectionTagDraft",
            "smartCollectionDateFromDraft", "smartCollectionDateToDraft", "smartCollectionMinimumDurationDraft",
            "smartCollectionMaximumDurationDraft", "smartCollectionOrientationDraft", "smartCollectionOnlineDraft",
            "smartCollectionUsageDraft", "smartCollectionCustomFieldDraft", "smartCollectionCustomValueDraft",
            "effectSearchText", "transitionSearchText", "animateSearchText", "animateSelectedGroup",
            "animateAnimatedOnly", "selectedKeyframeParameter", "contentScrollPosition",
            "discoveryCategory", "compatibleOnly", "effectDisclosureState",
            "effectDiscoveryExpandedCategories", "selectedEffectPresetPreview",
            "presetEffectSelection",
            "effectPresetNameDraft", "effectPresetReplaceExisting",
            "activePage", "curveChannel", "comparisonMode",
            "curveDraftActive", "curveDraftChannel", "curveDraftPoints",
            "selectedAudioTrackIndex", "processorTrackIndex", "dialogueCleanupDraft",
            "dialogueCleanupAuditionOriginal", "dialogueCleanupAdvancedVisible",
            "voiceoverPlaybackStartedByPanel", "transcriptSearchText", "transcriptMonitor",
            "selectedTranscriptSegmentId", "selectedTranscriptWordIndex", "transcriptEditText",
            "transcriptEditSpeaker", "retainedCaptionDraftByClipId",
            "draftLabel", "draftNote", "anchorMode", "filter",
            "includeCurrentClip", "editingMarkerId", "editLabel", "editNote",
            "editStartText", "editEndText", "editApprovalState", "editAssignee", "editClipIds",
            "draftRangeStartText", "draftRangeEndText"]
        const state = ({})
        for (const key of keys) {
            if (panel[key] !== undefined)
                state[key] = panel[key]
        }
        const next = Object.assign({}, retainedPanelSessionState)
        next[panelId] = JSON.parse(JSON.stringify(state))
        retainedPanelSessionState = next
    }

    function restorePanelSession(panelId, panel) {
        const state = retainedPanelSessionState[panelId]
        if (!panel || !state)
            return
        for (const key of Object.keys(state)) {
            if (panel[key] !== undefined)
                panel[key] = state[key]
        }
        if (typeof panel.syncSourceMonitor === "function")
            panel.syncSourceMonitor()
    }

    function retainReadyPanel(loader) {
        if (!workspaceResourcesHibernated && loader.status === Loader.Ready && loader.item)
            loader.retainLoaded = true
    }

    function hibernateWorkspaceResources() {
        if (visible || workspaceResourcesHibernated)
            return false
        if (timelineEditorPageLoader.item)
            timelineEditorPageLoader.item.releaseRetainedPanels()
        workspaceResourcesHibernated = true
        timelineDocument.clearProgramScopeAnalysis()
        return true
    }

    function timelineTrackAtY(contentY) {
        const layout = trackVerticalLayout
        const rowHeights = layout.rowHeightByIndex || []
        for (let index = 0; index < sequenceTrackModel.length; ++index) {
            if (layout.hiddenByIndex[index] === true)
                continue
            const track = sequenceTrackModel[index]
            const top = trackTopY(index)
            const height = Number(rowHeights[index] || 0)
            if (contentY >= top && contentY < top + height)
                return {track: track, index: index, top: top, height: height}
        }
        return null
    }

    function timelineTrackIndexForDrag(sourceRow, pointerYInSourceLane) {
        const tracks = sequenceTrackModel || []
        const sourceIndex = Number(sourceRow)
        if (!Number.isInteger(sourceIndex) || sourceIndex < 0 || sourceIndex >= tracks.length)
            return -1
        const pointerY = Number(pointerYInSourceLane)
        if (!Number.isFinite(pointerY))
            return sourceIndex
        const layout = trackVerticalLayout
        const targetIndex = timelineVirtualizedTrackRowsModel.nearestTrackIndexAtY(
                    layout, trackTopY(sourceIndex) + pointerY)
        return targetIndex >= 0 ? targetIndex : sourceIndex
    }

    function recordTimelineWheelDiagnostic(orientation, state) {
        if (orientation !== "horizontal" && orientation !== "vertical")
            return
        const expectedOrientation = orientation === "horizontal" ? "horizontal" : "vertical"
        const expectedObjectName = expectedOrientation === "horizontal"
                ? "timelineViewportHorizontalWheelHandler"
                : "timelineViewportVerticalWheelHandler"
        if (!state || state.objectName !== expectedObjectName
                || state.orientation !== expectedOrientation) {
            return
        }
        const snapshot = ({
            found: true,
            objectName: expectedObjectName,
            orientation: expectedOrientation,
            enabled: state.enabled === true,
            acceptedDevices: Number(state.acceptedDevices || 0),
            stateUpdatedAtMs: Date.now(),
            lastEvent: state.lastEvent && typeof state.lastEvent === "object"
                    ? state.lastEvent : ({ received: false })
        })
        if (expectedOrientation === "horizontal")
            root.timelineWheelHorizontalDiagnostic = snapshot
        else
            root.timelineWheelVerticalDiagnostic = snapshot
    }

    function beginDirectTimelineTool(tool, track, clip, contentX, localY, itemHeight, pointer) {
        if (tool === "hand") {
            directTimelineGesture = {kind: "hand", x: pointer.x, y: pointer.y,
                scrollX: timelineViewport.contentX, scrollY: timelineViewport.contentY}
            return true
        }
        if (tool === "zoom") {
            setTimelineZoom(timelineZoom * (pointer.zoomOut === true ? 0.8 : 1.25), contentX)
            return true
        }
        if (!track)
            return false
        if (tool === "track-select") {
            documentController.selectClipsFromSequenceTime(String(track.trackId || ""),
                Math.max(0, contentX / timelineZoom), trackSelectionDirection,
                pointer.allTracks === true)
            return true
        }
        if (tool === "rate-stretch") {
            if (!clip || !documentController.beginRateStretchEdit(String(clip.clipId || "")))
                return true
            directTimelineGesture = {kind: "rate-stretch", clipId: String(clip.clipId),
                trackId: String(track.trackId), pointerX: pointer.x,
                originalDuration: Number(clip.trimmedDurationSeconds || 0),
                duration: Number(clip.trimmedDurationSeconds || 0)}
            return true
        }
        if (tool === "pen") {
            const trackTarget = !clip || pointer.trackTarget === true
            const parameter = String(pointer.parameter || (track.trackKind === "audio" ? "audioGainDb" : "opacity"))
            const targetId = trackTarget ? String(track.trackId) : String(clip.clipId || "")
            if (!documentController.beginEnvelopePenGesture(targetId, String(track.trackId),
                                                           trackTarget, parameter))
                return true
            const bounds = trackTarget ? trackAutomationBounds(parameter)
                    : parameter === "audioGainDb" ? {minimum: -36, maximum: 24} : {minimum: 0, maximum: 1}
            const low = Number(bounds.minimum)
            const high = Number(bounds.maximum)
            const value = pointer.envelopeLane === true
                    ? trackAutomationValueFromY(parameter, localY, itemHeight)
                    : low + (1 - Math.max(0, Math.min(1, localY / Math.max(1, itemHeight)))) * (high - low)
            directTimelineGesture = {kind: "pen", clipId: trackTarget ? "" : targetId,
                targetId: targetId, trackId: String(track.trackId), trackTarget: trackTarget,
                parameter: parameter, minimum: low, maximum: high,
                envelopeLane: pointer.envelopeLane === true,
                seconds: Math.max(0, contentX / timelineZoom), value: value}
            return true
        }
        return false
    }

    function updateDirectTimelineTool(contentX, localY, itemHeight, pointer) {
        const gesture = directTimelineGesture
        if (!gesture.kind)
            return false
        if (gesture.kind === "hand") {
            timelineViewport.contentX = Math.max(0, Math.min(
                timelineViewport.contentWidth - timelineViewport.width,
                gesture.scrollX - (pointer.x - gesture.x)))
            timelineViewport.contentY = Math.max(0, Math.min(
                timelineViewport.contentHeight + timelineViewportBottomInset - timelineViewport.height,
                gesture.scrollY - (pointer.y - gesture.y)))
        } else if (gesture.kind === "rate-stretch") {
            const availability = documentController.rateStretchAvailability(gesture.clipId)
            if (availability.enabled !== true) {
                cancelDirectTimelineTool()
                return true
            }
            directTimelineGesture = Object.assign({}, gesture, {
                duration: Math.max(Number(availability.minimumDurationSeconds || 0.05),
                    Math.min(Number(availability.maximumDurationSeconds || 3600),
                        gesture.originalDuration + (pointer.x - gesture.pointerX) / timelineZoom))})
        } else if (gesture.kind === "pen") {
            directTimelineGesture = Object.assign({}, gesture, {
                seconds: Math.max(0, contentX / timelineZoom),
                value: gesture.envelopeLane
                    ? trackAutomationValueFromY(gesture.parameter, localY, itemHeight)
                    : gesture.minimum + (1 - Math.max(0, Math.min(1,
                        localY / Math.max(1, itemHeight)))) * (gesture.maximum - gesture.minimum)})
        }
        return true
    }

    function finishDirectTimelineTool() {
        const gesture = directTimelineGesture
        if (!gesture.kind)
            return false
        // Release the visual gesture before publishing a new clip projection.
        // Its delegates may be replaced by the resulting controller signals.
        directTimelineGesture = ({})
        if (gesture.kind === "rate-stretch") {
            documentController.updateRateStretchEdit(gesture.duration)
            documentController.endRateStretchEdit()
        } else if (gesture.kind === "pen") {
            const updated = documentController.updateEnvelopePenGesture(gesture.seconds, gesture.value, "linear")
            documentController.endEnvelopePenGesture()
            if (updated && !gesture.trackTarget) {
                selectedAnimatedParameter = gesture.parameter
                keyframeLanesVisible = true
                setTrackHeight(gesture.trackId, Math.max(92, trackHeight(gesture.trackId)))
            } else if (updated) {
                const lane = trackAutomationLaneState(gesture.trackId)
                if (!lane.expanded || String(lane.parameter) !== gesture.parameter)
                    toggleTrackAutomationLane({trackId: gesture.trackId}, gesture.parameter)
            }
        }
        return true
    }

    function cancelDirectTimelineTool() {
        const gesture = directTimelineGesture
        directTimelineGesture = ({})
        if (gesture.kind === "rate-stretch") documentController.cancelRateStretchEdit()
        else if (gesture.kind === "pen") documentController.cancelEnvelopePenGesture()
    }
    readonly property bool compactTimelineDocks: width < theme.scaled(1900)
    readonly property bool narrowTimelineWorkspace: width < theme.scaled(1250)

    TimelinePanelDockState {
        id: panelDockState
        panelDropHandler: root.dockDroppedPanel
        objectName: "timelinePanelDockState"
        onPanelFocused: function(panelId, dockId) { root.handleTimelinePanelFocus(panelId) }
        onPanelVisibilityChanged: root.syncTimelinePanelState()
        onPanelPlacementChanged: root.syncTimelinePanelState()
        onPanelStateChanged: {
            if (root.panelDockingReady) {
                panelDockPersistenceTimer.restart()
                hiddenPanelReleaseTimer.restart()
            }
        }
        onActivePanelByDockChanged: {
            if (root.panelDockingReady) {
                panelDockPersistenceTimer.restart()
                hiddenPanelReleaseTimer.restart()
            }
        }
    }

    Timer {
        id: panelDockPersistenceTimer
        interval: 180
        onTriggered: {
            if (!root.panelDockingReady || root.syncingPanelState)
                return
            timelineWorkspaceSettings.panelDockSnapshotJson = JSON.stringify(panelDockState.snapshot())
            root.syncTimelinePanelState()
            root.saveCurrentTimelineWorkspaceLayout()
        }
    }

    Timer {
        id: hiddenPanelReleaseTimer
        objectName: "timelineHiddenPanelReleaseTimer"
        interval: 1200
        repeat: false
        onTriggered: {
            if (!root.panelDockingReady || !root.visible || !timelineEditorPageLoader.item)
                return
            timelineEditorPageLoader.item.releaseRetainedPanels(true)
        }
    }

    function dockDroppedPanel(panelId, globalX, globalY) {
        const point = root.mapFromGlobal(globalX, globalY)
        if (point.x < 0 || point.y < 0 || point.x > root.width || point.y > root.height) return false
        const dock = point.y > root.height * 0.72 ? "bottom"
                : point.x < root.width * 0.3 ? "left"
                : point.x > root.width * 0.7 ? "right" : ""
        return dock.length > 0 && panelDockState.movePanel(panelId, dock, 999)
    }

    function timelinePanelDockSlot(panelId) {
        const dock = panelDockState.dock(panelId)
        return dock === "auxiliary" ? "right" : dock
    }

    function timelinePanelContentHost(panelId) {
        return timelineEditorPageLoader.item
                ? timelineEditorPageLoader.item.panelContentHost(panelId) : null
    }

    function timelinePanelExposed(panelId) {
        return timelineEditorPageLoader.item
                ? timelineEditorPageLoader.item.panelExposed(panelId) : false
    }

    function programScopesPanelPresented() {
        if (!programScopesVisible || workspaceResourcesHibernated)
            return false
        if (programScopesDetached)
            return programScopesWindow.visible
        return root.visible && panelDockingReady && timelinePanelExposed("scopes")
    }

    function schedulePausedProgramScopeRefresh() {
        if (sequencePlaying || programScopesFrozen || !programScopesPanelPresented())
            return false
        programScopesRefreshTimer.restart()
        return true
    }

    function handleTimelinePanelFocus(panelId) {
        lastFocusedTimelinePanel = String(panelId || "")
        const dockId = panelDockState.dock(panelId)
        if (dockId === "right" || dockId === "auxiliary")
            compactSideFocusedPanel = String(panelId)
        if (panelId === "media" || panelId === "source") {
            sourcePanelCollapsed = false
            sourcePanelHidden = false
            sourceRailTab = panelId
        } else if (panelId === "inspector" || panelId === "effects") {
            effectsPanelCollapsed = false
        } else if (panelId === "keyframes") {
            curveEditorOpen = true
            curveEditorDocked = panelDockState.dock(panelId) !== "floating"
        } else if (panelId === "scopes") {
            programScopesVisible = true
            schedulePausedProgramScopeRefresh()
        }
    }

    onLastFocusedTimelinePanelChanged: {
        if (panelDockingReady)
            timelineWorkspaceSettings.lastFocusedPanel = lastFocusedTimelinePanel
    }
    onCompactSideFocusedPanelChanged: {
        if (panelDockingReady)
            timelineWorkspaceSettings.lastSideFocusedPanel = compactSideFocusedPanel
    }

    function showTimelinePanel(panelId) {
        return panelDockState.focusPanel(panelId)
    }

    property string requestedSharedColorTab: "adjust"
    function showSharedColorTools(tab) {
        requestedSharedColorTab = String(tab || "adjust")
        showTimelinePanel("color")
        if (colorConsolePanelLoader.item)
            colorConsolePanelLoader.item.showSharedTab(requestedSharedColorTab)
    }

    function openSourceMonitor() {
        sourceRailTab = "source"
        sourcePanelHidden = false
        sourcePanelCollapsed = false
        if (panelDockingReady)
            showTimelinePanel("source")
    }

    function closeTimelinePanel(panelId) {
        panelDockState.setVisible(panelId, false)
        syncTimelinePanelState()
    }

    function syncTimelinePanelState() {
        if (!panelDockingReady || syncingPanelState)
            return
        syncingPanelState = true
        curveEditorOpen = panelDockState.visible("keyframes")
        curveEditorDocked = panelDockState.dock("keyframes") !== "floating"
        programScopesVisible = panelDockState.visible("scopes")
        sourcePanelDetached = panelDockState.dock(sourceRailTab === "source" ? "source" : "media") === "floating"
        effectsPanelDetached = panelDockState.dock("inspector") === "floating"
        programScopesDetached = panelDockState.dock("scopes") === "floating"
        sourcePanelCollapsed = !panelDockState.visible("media") && !panelDockState.visible("source")
        effectsPanelCollapsed = !panelDockState.visible("inspector")
        syncingPanelState = false
    }

    function restoreTimelinePanelState() {
        syncingPanelState = true
        const serialized = String(timelineWorkspaceSettings.panelDockSnapshotJson || "")
        if (serialized.length > 0) {
            panelDockState.restore(serialized)
        } else {
            const layout = workspaceLayoutState.layout(timelineLayoutPreset)
            panelDockState.applyArrangement(timelineLayoutPreset, layout)
            if (sourcePanelDetached)
                panelDockState.floatPanel(sourceRailTab === "source" ? "source" : "media")
            if (effectsPanelDetached)
                panelDockState.floatPanel("inspector")
            if (curveEditorOpen)
                panelDockState.setVisible("keyframes", true)
        }
        const storedFocus = String(timelineWorkspaceSettings.lastFocusedPanel || "inspector")
        if (panelDockState.validPanel(storedFocus))
            lastFocusedTimelinePanel = storedFocus
        const storedSideFocus = String(timelineWorkspaceSettings.lastSideFocusedPanel || "inspector")
        if (panelDockState.validPanel(storedSideFocus))
            compactSideFocusedPanel = storedSideFocus
        panelDockingReady = true
        syncingPanelState = false
        syncTimelinePanelState()
        schedulePausedProgramScopeRefresh()
    }
    property real voiceoverRecordingStartSeconds: 0

    TimelineVoiceoverRecorder {
        id: voiceoverRecorder

        onRecordingStarted: {
            root.voiceoverRecordingStartSeconds = Number(
                        root.documentController.sequencePlayheadSeconds || 0)
        }
        onRecordingFinished: function(filePath, durationMs) {
            const recordingPath = String(filePath || "")
            const inserted = root.documentController.insertVoiceoverRecording(
                        recordingPath, Number(durationMs || 0) / 1000,
                        root.voiceoverRecordingStartSeconds,
                        voiceoverRecorder.captureTimelineIdentity,
                        voiceoverRecorder.captureDocumentPath)
            if (!inserted) {
                const detail = String(root.documentController.status ||
                                      "The saved WAV could not be inserted.")
                        + " The WAV remains at " + recordingPath
                        + "; use Add Audio after switching to the correct timeline."
                voiceoverRecorder.reportInsertionFailure(recordingPath, detail)
            }
        }
    }

    Connections {
        target: root.documentController
        function onSequenceChanged() { stopVoiceoverCaptureForTimelineChange() }
        function onTimelineStateChanged() { stopVoiceoverCaptureForTimelineChange() }
        function onSavedPathsChanged() { stopVoiceoverCaptureForTimelineChange() }
    }

    function stopVoiceoverCaptureForTimelineChange() {
        voiceoverRecorder.stopForTimelineChange(
                    String(root.documentController.timelineAssetId || ""),
                    String(root.documentController.savedDocumentPath || ""))
    }

