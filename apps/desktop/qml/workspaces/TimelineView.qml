                                            const nextValue = curvePoint.maximumValue
                                                              - Math.max(0, Math.min(1,
                                                                  (curvePoint.y + curvePoint.height / 2 - theme.space16)
                                                                  / graphHeight))
                                                                * (curvePoint.maximumValue - curvePoint.minimumValue)
                                            const speedMode = keyframeCurveWindow.graphMode === "speed"
                                            const nextSpeed = keyframeCurveWindow.graphSpeedForY(
                                                curvePoint.y + curvePoint.height / 2)
