    function selectClipFromMarquee() {
        const left = Math.min(marqueeStartX, marqueeCurrentX)
        const right = Math.max(marqueeStartX, marqueeCurrentX)
        const top = Math.min(marqueeStartY, marqueeCurrentY)
        const bottom = Math.max(marqueeStartY, marqueeCurrentY)
        const ids = marqueeSeedIds.slice()
        if (Math.hypot(right - left, bottom - top) >= 4) {
            for (let row = 0; row < sequenceTrackModel.length; ++row) {
                const track = sequenceTrackModel[row]
                if (!track || track.locked || trackVerticalLayout.hiddenByIndex[row] === true) continue
                const laneTop = root.trackTopY(row)
                if (bottom < laneTop || top > laneTop + root.trackHeight(track.trackId)) continue
                for (const clip of (track.clips || [])) {
                    const clipLeft = Number(clip.startSeconds || 0) * timelineZoom
                    const clipRight = clipLeft + Number(clip.trimmedDurationSeconds || 0) * timelineZoom
                    const id = String(clip.clipId || "")
                    if (id && right >= clipLeft && left <= clipRight && ids.indexOf(id) < 0) ids.push(id)
                }
            }
        }
        timelineDocument.selectClipsByIds(ids)
    }

