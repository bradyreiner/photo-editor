    function restoreDetachedWindowGeometry(windowItem, storedX, storedY,
                                           storedWidth, storedHeight,
                                           fallbackOffsetX, fallbackOffsetY) {
        if (!windowItem)
            return
        const hostWindow = root.Window.window
        const targetScreen = hostWindow && hostWindow.screen
                           ? hostWindow.screen : windowItem.screen
        const candidateGeometry = targetScreen ? targetScreen.availableGeometry : null
        const available = candidateGeometry && Number(candidateGeometry.width) > 64
                          && Number(candidateGeometry.height) > 64
                        ? candidateGeometry : Qt.rect(0, 0, 1920, 1080)
        const safeWidth = Math.max(windowItem.minimumWidth,
                                   Math.min(Number(storedWidth || 420), available.width - 32))
        const safeHeight = Math.max(windowItem.minimumHeight,
                                    Math.min(Number(storedHeight || 720), available.height - 32))
        const fallbackX = hostWindow ? hostWindow.x + fallbackOffsetX
                                     : available.x + fallbackOffsetX
        const fallbackY = hostWindow ? hostWindow.y + fallbackOffsetY
                                     : available.y + fallbackOffsetY
        const candidateX = Number(storedX)
        const candidateY = Number(storedY)
        const safeX = isFinite(candidateX) && candidateX >= available.x
                      && candidateX + safeWidth <= available.x + available.width
                    ? candidateX : fallbackX
        const safeY = isFinite(candidateY) && candidateY >= available.y
                      && candidateY + safeHeight <= available.y + available.height
                    ? candidateY : fallbackY
        windowItem.width = safeWidth
        windowItem.height = safeHeight
        windowItem.x = Math.max(available.x,
                                Math.min(safeX, available.x + available.width - safeWidth))
        windowItem.y = Math.max(available.y,
                                Math.min(safeY, available.y + available.height - safeHeight))
    }

