    function handleTimelineEditMenuAction(key) {
        if (key === "split-at-playhead")
            root.splitAtPlayhead()
        else if (key === "insert-source")
            timelineDocument.insertSourceClipAtPlayhead()
        else if (key === "overwrite-source")
            timelineDocument.overwriteSourceClipAtPlayhead()
        else if (key === "move-earlier")
            timelineDocument.moveSelectedBackward()
        else if (key === "move-later")
            timelineDocument.moveSelectedForward()
        else if (key === "delete-selection")
            root.deleteSelectedTimelineClip()
        else if (key === "select-forward")
            timelineDocument.selectClipsForward(false)
        else if (key === "select-forward-track")
            timelineDocument.selectClipsForward(true)
        else if (key === "select-backward")
            timelineDocument.selectClipsBackward(false)
        else if (key === "select-backward-track")
            timelineDocument.selectClipsBackward(true)
        else if (key === "select-similar")
            root.openSelectSimilar(null)
        else if (key === "gap-index")
            root.openGapIndex(null)
        else if (key === "copy-clips")
            timelineDocument.copySelectedClips()
        else if (key === "cut-clips")
            timelineDocument.cutSelectedClips()
        else if (key === "paste-overwrite")
            timelineDocument.pasteClipsAtPlayhead("overwrite")
        else if (key === "paste-insert")
            timelineDocument.pasteClipsAtPlayhead("insert")
        else if (key === "paste-attributes")
            root.openPasteAttributes(null)
        else if (key === "duplicate-clips")
            timelineDocument.duplicateSelectedClip()
        else if (key === "replace-source")
            timelineDocument.replaceSelectedClipFromSource()
        else if (key === "fit-to-fill-source")
            timelineDocument.fitToFillSelectedClipFromSource()
        else if (key === "match-frame") {
            if (timelineDocument.matchFrameToSource()) {
                root.sourceRailTab = "source"
                root.sourcePanelHidden = false
                root.sourcePanelCollapsed = false
            }
        } else if (key === "clear-clipboard")
            timelineDocument.clearClipClipboard()
    }

    function handleTimelineCreateMenuAction(key) {
        if (key === "add-marker") {
            root.addMarkerAtPlayhead()
            return
        }
        if (key === "add-title") {
            root.openTitleTemplatePicker()
            return
        }
        if (key === "add-adjustment") {
            if (timelineDocument.addAdjustmentClip(5.0)) {
                root.inspectorTab = "effects"
                root.effectsPanelHidden = false
                root.effectsPanelCollapsed = false
                adjustmentPreviewCacheTimer.restart()
            }
            return
        }
        if (key === "review-notes") {
            root.openReviewNotes(null)
            return
        }
        if (key === "color-finishing") {
            root.colorFinishingFocusReturnItem = root.Window.window
                                                  ? root.Window.window.activeFocusItem : null
            root.colorScopeData = ({})
            const clips = timelineDocument.sequenceClipSummaries || []
            root.colorReferenceClipId = ""
            for (let index = 0; index < clips.length; ++index) {
                if (String(clips[index].clipId || "") !== String(root.currentClip.clipId || "")
                        && String(clips[index].mediaType || "") !== "audio") {
                    root.colorReferenceClipId = String(clips[index].clipId || "")
                    break
                }
            }
            colorFinishingPopup.contentCreated = true
            colorFinishingPopup.open()
            return
        }
        if (key === "add-captions") {
            root.openCaptionGenerator()
            return
        }
        if (key === "text-based-edit") {
            root.openTranscriptEditor()
            return
        }
        if (key === "beat-markers") {
            root.openBeatAnalysis()
            return
        }
        if (key === "multicam") {
            root.openMulticam(null)
            return
        }
        if (key === "make-compound") {
            timelineDocument.createCompoundClipFromSelection()
            return
        }
    }

