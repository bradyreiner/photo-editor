                appShell.interfaceDensity = density
            return
        }
        if (key === "toggle-source") {
            if (root.sourcePanelHidden || root.sourcePanelCollapsed) {
                root.sourcePanelHidden = false
                root.sourcePanelCollapsed = false
            } else {
                root.sourcePanelCollapsed = true
            }
            return
        }
        if (key === "toggle-inspector") {
            root.effectsPanelCollapsed = !root.effectsPanelCollapsed
            return
        }
        if (key === "gang-monitors") {
            root.setProgramSourceGangEnabled(!root.programSourceGangEnabled)
            return
        }
        if (key === "audio-mixer") {
            root.openAudioMixerPopup()
            return
        }
        if (key === "review-ranges") {
            root.resetReviewRangeDraft()
            reviewRangesPopup.open()
            return
        }
        if (key === "pancake-timelines") {
            root.openPancakeTimelines(null)
            return
        }
        if (key === "detach-source") {
            if (!root.sourcePanelDetached)
                detachedSourceWindow.contentRequested = true
            root.sourcePanelDetached = !root.sourcePanelDetached
            if (!root.sourcePanelDetached) {
                root.sourcePanelHidden = false
                root.sourcePanelCollapsed = false
            }
            return
        }
        if (key === "detach-inspector") {
            if (!root.effectsPanelDetached)
                detachedInspectorWindow.contentRequested = true
            root.effectsPanelDetached = !root.effectsPanelDetached
            if (!root.effectsPanelDetached)
                root.effectsPanelCollapsed = false
            return
        }
        if (key === "toggle-advanced") {
            root.timelineAdvancedControlsVisible = !root.timelineAdvancedControlsVisible
            return
        }
        if (key === "safe-areas") {
            root.openPlatformOverlaySettings()
            return
        }
        if (key === "platform-overlays") {
            root.openPlatformOverlaySettings()
            return
        }
        if (key.indexOf("quality-") === 0) {
            root.previewQualityMode = key.substring(8)
            return
        }
        if (key === "project-cache") {
            root.openProjectCacheManager(null)
            return
        }
        if (key === "background-jobs") {
            root.openBackgroundJobCenter(null)
            return
        }
        if (key === "cache-toggle") {
            if (timelineDocument.renderCacheBusy)
                timelineDocument.cancelRenderCacheGeneration()
            else
                timelineDocument.generateRenderCache()
            return
        }
        if (key === "cache-clear") {
            timelineDocument.clearRenderCache()
            return
        }
        if (key === "compare-program") {
            root.openProgramComparison(null)
            return
        }
        if (key === "program-scopes") {
            if (!root.programScopesVisible)
                root.openProgramScopes(false)
            else if (root.programScopesDetached)
                root.programScopesDetached = false
            else
                root.closeProgramScopes()
            return
        }
        if (key === "full-screen-program") {
            root.enterFullScreenProgram()
            return
        }
        if (key === "focus-timeline") {
            root.timelineFocusModeActive = !root.timelineFocusModeActive
            root.workspaceFocus = "timeline"
            Qt.callLater(function() {
                if (timelineViewport)
                    timelineViewport.forceActiveFocus()
            })
            return
        }
        if (key === "focus-program") {
            root.sourcePanelDetached = false
            root.effectsPanelDetached = false
            root.sourcePanelCollapsed = true
            root.effectsPanelCollapsed = true
            root.workspaceFocus = "program"
            Qt.callLater(function() {
                if (videoMonitor)
                    videoMonitor.forceActiveFocus()
            })
            return
        }
        if (key === "reset-layout")
            root.restoreDefaultLayout()
    }

