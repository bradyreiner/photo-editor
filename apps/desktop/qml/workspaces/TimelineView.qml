    function refreshTimelineSelectionState() {
        // QVariantMap-valued controller properties can retain their
        // previous JS wrapper even after the shared notify signal fires.
        // Refresh the map explicitly so Program and Inspector content
        // follow the latest controller selection on the next event-loop turn.
        const previousClipId = String(root.currentClip && root.currentClip.clipId || "")
        const nextClip = TimelineSelectionRefresh.currentClipSnapshotForSelectionRefresh(
                    root, root.selectionRefreshObservedClipSnapshotRevision)
        const nextClipId = String(nextClip && nextClip.clipId || "")
        const primaryClipChanged = previousClipId !== nextClipId
        const selectedIds = timelineDocument.selectedClipIds || []
        const selectedSignature = TimelineSelectionRefresh.selectionSignature(selectedIds)
        const explicitSelectionChanged = selectedSignature !== root.observedTimelineSelectionSignature
        root.observedTimelineSelectionSignature = selectedSignature
        if (explicitSelectionChanged)
            TimelineSelectionRefresh.refreshTrackSnapshotForSelectionChange(root, selectedSignature)
        root.invalidateProgramPlaybackDetail(previousClipId)
        root.invalidateProgramPlaybackDetail(nextClipId)
        root.adoptCurrentClipSnapshot(nextClip)
        root.selectionRefreshObservedClipSnapshotRevision = root.currentClipSnapshotRevision
        if (primaryClipChanged) {
            root.motionSeedSelectionActive = false
            root.motionSeedSelectionHudVisible = false
            root.motionSeedAwaitingFirstFrame = false
            root.motionSeedFrameSource = ""
            root.motionSeedFrameAssetId = ""
            root.motionSeedFrameSourceSeconds = -1
            root.motionSeedRectNormalized = ({"x": 0, "y": 0, "width": 0, "height": 0})
            root.motionTrackingUiMessage = ""
        }
        if (root.curveEditorTarget === "clip" && !root.curveEditorPinned) {
            root.curveEditorTargetClipId = nextClipId
            const parameters = nextClip.availableKeyframeParameters || []
            if (parameters.indexOf(root.selectedAnimatedParameter) < 0 && parameters.length > 0)
                root.selectedAnimatedParameter = String(parameters[0])
            if (root.curveEditorOpen && primaryClipChanged)
                keyframeCurveWindow.clearCurveSelection()
        }
        const programClipChanged = root.refreshProgramClipSnapshotIfIdentityChanged()
        if (primaryClipChanged || programClipChanged ||
                root.programPlaybackModelContainsClip(previousClipId) ||
                root.programPlaybackModelContainsClip(nextClipId))
            root.refreshProgramPlaybackLayerModels(true)
        root.publishProgramPlaybackDetailCacheChanges()
        if (root.timelineTrackFocusMode)
            root.refreshTimelineTrackFocus()
        if (primaryClipChanged) {
            root.scheduleBackgroundWorkIntentPublish()
            if (nextClipId.length > 0 && timelineDocument.selectedClipIds.indexOf(nextClipId) >= 0) {
                const selectedClipForScroll = nextClip
                Qt.callLater(function() {
                    if (root.currentClip
                            && String(root.currentClip.clipId || "") === nextClipId
                            && timelineDocument.selectedClipIds.indexOf(nextClipId) >= 0)
                        root.ensureTimelineClipTrackVisible(selectedClipForScroll)
                })
            }
        }
        if (explicitSelectionChanged && Number(timelineDocument.selectedClipCount || 0) > 0) {
            root.revealTimelineSelection(root.pendingTimelineEffectsClipId === nextClipId ? "effects"
                                         : root.timelineLayoutPreset === "color" ? "color" : "controls")
            root.pendingTimelineEffectsClipId = ""
        }
        if (root.timelineTrackFocusMode && !root.refreshTimelineTrackFocus())
            root.clearTimelineTrackFocus()
        if (root.keyboardTrimEdge.length > 0)
            root.editPointData = timelineDocument.selectedEditPointInfo(root.keyboardTrimEdge)
        if (primaryClipChanged && timelineDocument.currentIndex >= 0 && root.width >= 1180) {
            root.workspaceFocus = "timeline"
        }
    }

    Connections {
        target: timelineDocument

        function onTrackingChanged() { root.motionTrackingUiMessage = "" }

        function onColorScopeAnalysisChanged() {
            if (!colorFinishingPopup.visible)
                return
            root.colorScopeData = timelineDocument.colorScopeAnalysisData
            if (colorFinishingPopup.scopesCanvas)
                colorFinishingPopup.scopesCanvas.requestPaint()
        }

        function onProgramComparisonRequested(clipId, sequenceSeconds, mode) {
            if (!root.hasPlayableSequence())
                return
            if (root.programComparisonActive)
                root.closeProgramComparison()
            timelineDocument.seekSequenceSeconds(Number(sequenceSeconds))
            root.refreshCurrentClipSnapshot()
            root.programClip = timelineDocument.snapshotProgramClip()
            if (String(root.programClip.clipId || "") !== String(clipId))
                return
            if (!root.openProgramComparison())
                return
            root.programComparisonMode = String(mode || "wipe")
        }

        function onProgramScopeCaptureRequested() {
            if (root.programComparisonActive || root.fullScreenProgramActive) {
                timelineDocument.acknowledgeProgramScopeCaptureRequest(
                            false, "Close Program Comparison or Full Screen Program before capturing scopes.")
                return
            }
            const accepted = root.openProgramScopes(false)
            timelineDocument.acknowledgeProgramScopeCaptureRequest(
                        accepted, accepted ? "" : "The Timeline has no playable Program frame.")
        }

        function onTimelineStateChanged() {
            TimelineSelectionRefresh.refreshSequenceTrackSnapshotForTimelineState(root)
            root.refreshTimelineDocumentSnapshots()
            if (!timelineDocument.hasActiveTimeline) {
                root.clearTimelineTrackFocus()
                root.timelineViewportStateRestored = false
                root.closeTransientSurfaces()
                root.sourcePanelDetached = false
                root.effectsPanelDetached = false
            } else if (!root.timelineViewportStateRestored) {
                Qt.callLater(root.restoreTimelineViewportState)
            }
        }

        function onRecentTimelinesChanged() {
            root.recentTimelineRecords = timelineDocument.recentTimelineRecords
            root.recentTimelinesLoading = timelineDocument.recentTimelinesLoading
        }

        function onTimelineSaveCompleted(success, timelineAssetId, projectBinding) {
            if (!success)
                return
            if (projectBinding.length > 0 && timelineAssetId.length > 0)
                catalogAssets.addAssetToProjectAsync(timelineAssetId, projectBinding)
            else
                catalogAssets.refresh()
        }

        function onSelectionChanged() {
            TimelineSelectionRefresh.schedule(root)
        }

        function onPlaybackStateChanged() {
            // Keep the authored maps stable during scalar playhead ticks. The
            // current map refreshes on selection/authored-state signals; the
            // Program map only changes when its cheap stable-ID projection
            // reports a different source clip. Animated values continue to
            // evaluate against root.sequencePlayheadSeconds.
            root.refreshProgramClipSnapshotIfIdentityChanged()
            if (!root.sequencePlaying && root.currentClip
                    && root.currentClip.surfaceTrackRepairable === true)
                root.refreshCurrentClipSnapshot()
            root.scheduleBackgroundWorkIntentPublish()
            if (root.programComparisonActive && !root.sequencePlaying)
                programComparisonRefreshTimer.restart()
        }

        function onEditorStateChanged() {
            if (timelineDocument.activeTool !== "trim" && root.keyboardTrimEdge.length > 0) {
                root.keyboardTrimEdge = ""
                root.editPointData = ({})
            }
        }

        function onSequenceChanged() {
            TimelineSelectionRefresh.refreshSequenceTrackSnapshotForSequenceChange(root)
            root.refreshSequenceSettingsSnapshot()
            root.trackAutomationOverrides = ({})
            root.scheduleVirtualizedTimelineTrackRowsRefresh(true)
            root.scheduleBackgroundWorkIntentPublish()
            if (root.hasAnyAdjustmentClips())
                adjustmentPreviewCacheTimer.restart()
            if (root.timelineTrackFocusMode)
                Qt.callLater(function() {
                    if (!root.refreshTimelineTrackFocus())
                        root.clearTimelineTrackFocus()
                })
        }

        function onTrackAutomationStateChanged(trackId, keyframes) {
            const updated = Object.assign({}, root.trackAutomationOverrides || ({}))
            updated[String(trackId || "")] = keyframes || []
            root.trackAutomationOverrides = updated
        }

        function onSelectedClipStateChanged() {
            root.timelineClipParameterRevision += 1
            const nextClip = root.refreshCurrentClipSnapshot()
            root.programClip = timelineDocument.snapshotProgramClip()
            if (String(nextClip.mediaType || "") === "adjustment")
                adjustmentPreviewCacheTimer.restart()
        }

        function onSequenceVersionsChanged() {
            if (root.programComparisonActive)
                root.programComparisonVersionRecords = timelineDocument.sequenceVersions
            if (sequenceVersionsPopup.visible) {
                root.sequenceVersionRecords = timelineDocument.sequenceVersions
                if (root.sequenceVersionCompareData
                        && root.sequenceVersionCompareData.versionId) {
                    root.sequenceVersionCompareData = timelineDocument.sequenceVersionComparison(
                        String(root.sequenceVersionCompareData.versionId))
                }
            }
        }

        function onRecoveryCandidatesChanged() {
            // Journal commits are frequent. Verify full recovery chains only
            // while the chooser is being used, rather than after every edit.
            root.recoveryCandidateRecords = timelineDocument.recoveryCandidates
            if (!root.visible)
                return
            if (root.recoveryCandidateRefreshPending
                    && !timelineDocument.recoveryCandidatesLoading) {
                root.recoveryCandidateRefreshPending = false
                if (!root.recoveryPromptPresented && root.recoveryCandidateRecords.length > 0) {
                    root.recoveryPromptPresented = true
                    timelineRecoveryPopup.open()
                }
            }
            if (timelineRecoveryPopup.visible
                    && !timelineDocument.recoveryCandidatesLoading
                    && root.recoveryCandidateRecords.length === 0
                    && !timelineDocument.recoveryOpenInProgress)
                timelineRecoveryPopup.close()
        }

        function onRecoveryOpenCompleted(candidateId, succeeded) {
            if (String(candidateId || "") !== timelineRecoveryPopup.pendingRecoveryCandidateId)
                return
            timelineRecoveryPopup.pendingRecoveryCandidateId = ""
            if (succeeded) {
                root.recoveryOpenErrorMessage = ""
                timelineRecoveryPopup.close()
            } else {
                root.recoveryOpenErrorMessage = String(timelineDocument.status ||
                                                       "Recovery could not be opened. Your current timeline remains open.")
            }
        }

        function onLoudnessAnalysisChanged() {
            if (deliveryPreflightPopup.visible)
                root.deliveryPreflightData = timelineDocument.timelineDeliveryPreflight()
            if (publishPopup.visible)
                root.publishData = timelineDocument.timelinePublishSummary()
        }

        function onProjectCacheSummaryChanged() {
            if (projectCachePopup.visible) {
                root.refreshProjectCacheData(root.projectCacheSelectAfterRefresh)
                root.refreshProjectCacheBudgetData(false)
            }
        }

        function onProjectCacheCleanupFinished(result) {
            if (projectCachePopup.visible
                    && (!result.timelineId || result.timelineId === root.projectCacheData.timelineId)) {
                root.projectCacheCleanupResult = result
                root.projectCacheSelectedCategories = []
                root.projectCacheCleanupArmed = false
                root.refreshProjectCacheData(false)
            }
        }

        function onCacheBudgetStateChanged() {
            if (projectCachePopup.visible)
                root.refreshProjectCacheBudgetData(false)
        }
    }

    Connections {
        target: timelinePlayback

        function onProcessedFrameSourceChanged() {
            root.schedulePausedProgramScopeRefresh()
            if (!root.programComparisonAwaitingBypassFrame)
                return
            const currentSource = String(timelinePlayback.processedFrameSource || "")
            if (currentSource.length === 0 ||
                    currentSource === root.programComparisonBypassClearSource)
                return
            root.programComparisonAwaitingBypassFrame = false
            root.programComparisonBypassClearSource = ""
            Qt.callLater(root.refreshProgramComparisonCurrentFrame)
        }

        function onRuntimeRecoveryRequested(kind) {
            root.runtimeRecoveryFeedbackVisible = true
            runtimeRecoveryFeedbackTimer.restart()
            if (kind === "external-display") {
                Qt.callLater(root.restoreDetachedSourceGeometry)
                Qt.callLater(root.restoreDetachedInspectorGeometry)
            }
        }

        function onStateChanged() {
            root.refreshProgramClipSnapshotIfIdentityChanged()
            if (!root.sequencePlaying || timelinePlayback.usingRenderCache)
                return
            root.publishTrackMeter(
                        String(root.programClip.audioTrackId || ""),
                        Number(timelinePlayback.audioPeakLeft || 0),
                        Number(timelinePlayback.audioPeakRight || 0),
                        Number(timelinePlayback.audioTruePeakLeft || 0),
                        Number(timelinePlayback.audioTruePeakRight || 0),
                        Number(timelinePlayback.audioRmsLeft || 0),
                        Number(timelinePlayback.audioRmsRight || 0),
                        timelinePlayback.audioClipping === true)
        }
    }

    Connections {
        target: timelineDocument

        function onMediaHoverFrameReady(assetId, sourceSeconds, frameSource) {
            if (String(assetId) === root.motionSeedFrameAssetId
                    && Math.abs(Number(sourceSeconds) - root.motionSeedFrameSourceSeconds) < 0.002) {
                root.motionSeedFrameSource = String(frameSource || "")
                if (root.motionSeedFrameSource.length > 0)
                    root.motionTrackingUiMessage = "Loading the first source frame…"
            }
        }
    }

    Timer {
        id: runtimeRecoveryFeedbackTimer
        interval: 5000
        repeat: false
        onTriggered: root.runtimeRecoveryFeedbackVisible = false
    }

    Timer {
        id: motionSeedFrameRequestTimeout
        interval: 10000
        repeat: false
        running: root.motionSeedAwaitingFirstFrame && root.motionSeedFrameSource.length === 0
        onTriggered: {
            root.motionSeedAwaitingFirstFrame = false
            root.motionTrackingUiMessage = "The source frame could not be loaded. Reopen the tracking panel to enter the region numerically."
        }
    }

    Timer {
        id: scenePointFrameRequestTimeout
        interval: 10000
        repeat: false
        running: root.scenePointFrameAwaiting && root.scenePointFrameSource.length > 0
        onTriggered: {
            root.scenePointFrameAwaiting = false
            root.scenePointSelectionMessage = "The cached source frame did not load. Cancel point selection and solve this clip again."
        }
    }

    Timer {
        id: mediaPickerRefreshTimer
        interval: 0
        repeat: false
        onTriggered: root.refreshMediaPickerAssets(false)
    }

    Connections {
        target: catalogAssets

        function onMediaDurationsChanged() { root.requestMediaPickerRefresh() }
        function onAssetCountChanged() { root.requestMediaPickerRefresh() }
        function onTotalAssetCountChanged() { root.requestMediaPickerRefresh() }
        function onProjectStatsRevisionChanged() { root.requestMediaPickerRefresh() }
        function onLoadingChanged() { root.requestMediaPickerRefresh() }
        function onDataChanged() { root.requestMediaPickerRefresh() }
        function onModelReset() { root.requestMediaPickerRefresh() }
    }

    function clipSourceUrl() {
        return timelineDocument.playbackSourceUrl ? timelineDocument.playbackSourceUrl : ""
    }

    function previewQualityLabel() {
        if (previewQualityMode === "full")
            return "Full"
        if (previewQualityMode === "half")
            return "Half"
        if (previewQualityMode === "quarter")
            return "Quarter"
        if (previewQualityMode === "proxy")
            return "Proxy"
        if (previewQualityMode === "clip")
            return "Clip setting"
        return "Auto"
    }

    function precisionTrimDisabledReason(asymmetricLinkedAv) {
        if (timelineDocument.currentIndex < 0 || !root.currentClip
                || String(root.currentClip.trackKind || "") !== "video")
            return "Select a picture clip to trim its In or Out edge."
        if (Number(timelineDocument.selectedClipCount || 0) > 1)
            return "Select one picture clip for precision trimming."
        const tracks = root.sequenceTrackModel || []
        const trackId = String(root.currentClip.trackId || "")
        const audioTrackId = String(root.currentClip.audioTrackId || "")
        for (let index = 0; index < tracks.length; ++index) {
            const track = tracks[index]
            if (String(track.trackId || "") === trackId && track.locked === true)
                return "Unlock the selected track before trimming."
            // Even picture-only trimming detaches paired audio, so its track must be writable.
            if (root.currentClip.audioLinked === true && audioTrackId.length > 0
                    && String(track.trackId || "") === audioTrackId && track.locked === true)
                return "Unlock the linked audio track before trimming this clip."
        }
        return ""
    }

    function selectPrecisionTrimEdge(edge) {
        const reason = root.precisionTrimDisabledReason(false)
        if (reason.length > 0) {
            root.showMarkerFeedback(reason)
            return false
        }
        timelineDocument.activeTool = "trim"
        keyboardTrimEdge = edge === "end" ? "end" : "start"
        editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        return String(editPointData.schema || "").length > 0
    }

    function precisionTrimPlayheadReason(edge) {
        const reason = root.precisionTrimDisabledReason(false)
        if (reason.length > 0)
            return reason
        const start = Number(root.currentClip.startSeconds || 0)
        const end = start + Number(root.currentClip.trimmedDurationSeconds || 0)
        const frame = 1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const position = Number(root.sequencePlayheadSeconds)
        return edge === "start"
                ? (position >= start && position <= end - frame
                   ? "" : "Place the playhead inside the selected clip, before its last frame.")
                : (position >= start + frame && position <= end
                   ? "" : "Place the playhead inside the selected clip, after its first frame.")
    }

    function timelinePrecisionTrimMenuItems() {
        const reason = root.precisionTrimDisabledReason(false)
        const edgeChosen = reason.length === 0 && root.keyboardTrimEdge.length > 0
                           && timelineDocument.activeTool === "trim"
        const edgeReason = reason.length > 0 ? reason : "Choose the In or Out edge first."
        const inReason = root.precisionTrimPlayheadReason("start")
        const outReason = root.precisionTrimPlayheadReason("end")
        return [
            {key: "trim-in", label: "Select In edge", icon: "step-back", enabled: reason.length === 0,
             disabledReason: reason, checked: edgeChosen && keyboardTrimEdge === "start",
             tooltip: "Choose the clip start. T alternates between In and Out."},
            {key: "trim-out", label: "Select Out edge", icon: "step-forward", enabled: reason.length === 0,
             disabledReason: reason, checked: edgeChosen && keyboardTrimEdge === "end",
             tooltip: "Choose the clip end. T alternates between In and Out."},
            {key: "trim-earlier-1", label: "Earlier by 1 frame", icon: "step-back", enabled: edgeChosen,
             disabledReason: edgeReason, separatorBefore: true, tooltip: "Comma. Respects linked selection and Ripple."},
            {key: "trim-later-1", label: "Later by 1 frame", icon: "step-forward", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Period. Respects linked selection and Ripple."},
            {key: "trim-earlier-5", label: "Earlier by 5 frames", icon: "step-back", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Shift+Comma. Respects linked selection and Ripple."},
            {key: "trim-later-5", label: "Later by 5 frames", icon: "step-forward", enabled: edgeChosen,
             disabledReason: edgeReason, tooltip: "Shift+Period. Respects linked selection and Ripple."},
            {key: "trim-in-playhead", label: "Trim In to playhead", icon: "step-back", enabled: inReason.length === 0,
             disabledReason: inReason, separatorBefore: true, tooltip: "Remove the selected clip before the playhead; respects Ripple."},
            {key: "trim-out-playhead", label: "Trim Out to playhead", icon: "step-forward", enabled: outReason.length === 0,
             disabledReason: outReason, tooltip: "Remove the selected clip after the playhead; respects Ripple."},
            {key: "tool-roll", label: "Roll adjacent edit", icon: "roll", checked: timelineDocument.activeTool === "roll",
             separatorBefore: true, tooltip: "N. Move a cut while preserving the combined duration."},
            {key: "leave-trim", label: "Return to Select", icon: "select", tooltip: "V. Finish trimming and return to selection."}
        ]
    }

    function handlePrecisionTrimAction(key) {
        if (key === "tool-roll" || key === "leave-trim") {
            keyboardTrimEdge = ""
            editPointData = ({})
            timelineDocument.activeTool = key === "tool-roll" ? "roll" : "select"
            return
        }
        if (key === "trim-in" || key === "trim-out") {
            root.selectPrecisionTrimEdge(key === "trim-in" ? "start" : "end")
            return
        }
        if (key === "trim-in-playhead" || key === "trim-out-playhead") {
            const edge = key === "trim-in-playhead" ? "start" : "end"
            const reason = root.precisionTrimPlayheadReason(edge)
            if (reason.length > 0) {
                root.showMarkerFeedback(reason)
                return
            }
            const position = Number(root.sequencePlayheadSeconds)
            if (!root.selectPrecisionTrimEdge(edge))
                return
            if (edge === "start")
                timelineDocument.trimSelectedClipStartToSequenceSeconds(position, rippleModeEnabled)
            else
                timelineDocument.trimSelectedClipEndToSequenceSeconds(position, rippleModeEnabled)
            editPointData = timelineDocument.selectedEditPointInfo(edge)
            return
        }
        if (key.indexOf("trim-earlier-") === 0 || key.indexOf("trim-later-") === 0)
            root.nudgeKeyboardTrim((key.indexOf("trim-earlier-") === 0 ? -1 : 1)
                                  * (key.endsWith("-5") ? 5 : 1), false)
    }

    function toggleKeyboardTrimEdge() {
        const edge = keyboardTrimEdge === "start" ? "end" : "start"
        if (root.selectPrecisionTrimEdge(edge))
            root.showMarkerFeedback(edge === "start" ? "Keyboard trim: In edge" : "Keyboard trim: Out edge")
    }

    function showMarkerFeedback(message) {
        markerFeedbackText = message
        markerFeedbackVisible = true
        markerFeedbackTimer.restart()
    }

    function nudgeKeyboardTrim(frameDelta, asymmetricLinkedAv) {
        const reason = root.precisionTrimDisabledReason(asymmetricLinkedAv)
        if (reason.length > 0) {
            root.showMarkerFeedback(reason)
            return
        }

        if (keyboardTrimEdge.length === 0) {
            root.showMarkerFeedback("Press T to select the In trim edge first.")
            return
        }
        const previousStatus = String(timelineDocument.status || "")
        if (timelineDocument.nudgeSelectedTrimEdge(
                    keyboardTrimEdge, frameDelta,
                    asymmetricLinkedAv === true, rippleModeEnabled)) {
            editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        } else {
            const currentStatus = String(timelineDocument.status || "")
            root.showMarkerFeedback(currentStatus.length > 0 && currentStatus !== previousStatus
                                    ? currentStatus : "Trim was not applied. Check source handles and locked tracks.")
        }
    }

    function navigateEditPoint(direction) {
        const boundary = Number(editPointData.boundarySeconds || sequencePlayheadSeconds)
        const selected = timelineDocument.selectAdjacentEditPoint(boundary, direction)
        if (!selected || String(selected.schema || "").length === 0)
            return
        keyboardTrimEdge = String(selected.edge || (direction < 0 ? "end" : "start"))
        editPointData = selected
        timelineDocument.activeTool = "trim"
    }

    function openEditPointDetails(invoker) {
        editPointFocusReturnItem = invoker || null
        editPointData = timelineDocument.selectedEditPointInfo(keyboardTrimEdge)
        if (!editPointData || String(editPointData.schema || "").length === 0)
            return
        editPointPopup.open()
    }

    function switchEditPointSide() {
        const selected = timelineDocument.selectOtherEditPointSide(keyboardTrimEdge)
        if (!selected || String(selected.schema || "").length === 0)
            return
        keyboardTrimEdge = String(selected.edge || keyboardTrimEdge)
        editPointData = selected
    }

    function openSelectSimilar(invoker) {
        similarSelectionFocusReturnItem = invoker || null
        similarSelectionOptions = timelineDocument.selectedClipSimilarityOptions()
        similarSelectionConstraints = []
        for (let index = 0; index < similarSelectionOptions.length; ++index) {
            if (similarSelectionOptions[index].available === true
                    && String(similarSelectionOptions[index].key) === "media-type") {
                similarSelectionConstraints = ["media-type"]
                break
            }
        }
        similarSelectionPopup.open()
    }

    function toggleSimilarConstraint(key) {
        let updated = similarSelectionConstraints.slice(0)
        const index = updated.indexOf(key)
        if (index >= 0)
            updated.splice(index, 1)
        else
            updated.push(key)
        similarSelectionConstraints = updated
    }

    function openPasteAttributes(invoker) {
        pasteAttributesFocusReturnItem = invoker || null
        pasteAttributesComparisonData = timelineDocument.pasteAttributesComparison()
        pasteAttributeCategories = []
        const categories = pasteAttributesComparisonData.categories || []
        for (let index = 0; index < categories.length; ++index) {
            if (categories[index].available === true && categories[index].changed === true)
                pasteAttributeCategories.push(String(categories[index].key || ""))
        }
        pasteAttributeCategories = pasteAttributeCategories.slice(0)
        pasteAttributesPopup.open()
    }

    function togglePasteAttributeCategory(key) {
        let updated = pasteAttributeCategories.slice(0)
        const index = updated.indexOf(key)
        if (index >= 0)
            updated.splice(index, 1)
        else
            updated.push(key)
        pasteAttributeCategories = updated
    }

    function gapMinimumDurationSeconds() {
        const value = Number(root.gapMinimumDurationDraft)
        return isFinite(value) ? Math.max(0, value) : 0
    }

    function gapMaximumDurationSeconds() {
        const value = Number(root.gapMaximumDurationDraft)
        return root.gapMaximumDurationDraft.trim().length > 0 && isFinite(value)
                ? Math.max(0, value) : 0
    }

    function refreshGapIndex() {
        gapIndexRows = timelineDocument.timelineGaps(
                    root.gapMinimumDurationSeconds(),
                    root.gapMaximumDurationSeconds())
        const visibleIds = []
        for (let index = 0; index < gapIndexRows.length; ++index)
            visibleIds.push(String(gapIndexRows[index].gapId || ""))
        const retained = []
        for (let selectedIndex = 0; selectedIndex < selectedGapIds.length; ++selectedIndex) {
            if (visibleIds.indexOf(selectedGapIds[selectedIndex]) >= 0)
                retained.push(selectedGapIds[selectedIndex])
        }
        selectedGapIds = retained
    }

    function openGapIndex(invoker) {
        gapIndexFocusReturnItem = invoker || null
        selectedGapIds = []
        root.refreshGapIndex()
        gapIndexPopup.open()
    }

    function toggleGapSelection(gapId) {
        let updated = selectedGapIds.slice(0)
        const index = updated.indexOf(gapId)
        if (index >= 0)
            updated.splice(index, 1)
        else
            updated.push(gapId)
        selectedGapIds = updated
    }

    function navigateGapIndex(direction) {
        const gap = timelineDocument.navigateTimelineGap(
                    sequencePlayheadSeconds, direction,
                    root.gapMinimumDurationSeconds(),
                    root.gapMaximumDurationSeconds())
        if (gap && String(gap.gapId || "").length > 0)
            selectedGapIds = [String(gap.gapId)]
    }

    function gapIndexHasUnsafeRows() {
        for (let index = 0; index < gapIndexRows.length; ++index) {
            if (gapIndexRows[index].safeToClose !== true)
                return true
        }
        return false
    }

    function openTimecodeEntry(operation, invoker) {
        timecodeOperation = operation || "seek"
        timecodeEntryFocusReturnItem = invoker || null
        timecodeEntryError = ""
        let seconds = sequencePlayheadSeconds
        if (currentClip && timelineDocument.currentIndex >= 0) {
            if (timecodeOperation === "place" || timecodeOperation === "trim-start")
                seconds = Number(currentClip.startSeconds || 0)
            else if (timecodeOperation === "trim-end")
                seconds = Number(currentClip.endSeconds || 0)
            else if (timecodeOperation === "duration")
                seconds = Number(currentClip.trimmedDurationSeconds || 0)
        }
        timecodeDraft = timecodeText(seconds)
        timecodeEntryPopup.contentCreated = true
        timecodeEntryPopup.open()
        Qt.callLater(function() {
            timecodeEntryPopup.entryField.forceActiveFocus()
            timecodeEntryPopup.entryField.selectAll()
        })
    }

    function timecodeOperationIndex(operation) {
        switch (operation) {
        case "place": return 1
        case "trim-start": return 2
        case "trim-end": return 3
        case "duration": return 4
        case "marker": return 5
        default: return 0
        }
    }

    function submitTimecodeEntry() {
        if (timelineDocument.applyTimecodeEntry(timecodeOperation, timecodeDraft)) {
            timecodeEntryPopup.close()
            return
        }
        timecodeEntryError = String(timelineDocument.status || "Timecode could not be applied.")
    }

    function programUsesStabilizedPreview(clip, stabilizedVisual) {
        return stabilizedVisual === true
                && clip && clip.mediaType === "video"
                && (clip.stabilizationEnabled === true || clip.rollingShutterEnabled === true)
                && clip.stabilizationReady === true
                && timelineDocument.stabilizationCompareBefore !== true
                && String(clip.stabilizationPreviewSourceUrl || "").length > 0
    }

    function programPlaybackSourceUrl(clip, stabilizedVisual) {
        if (!clip)
            return ""
        if (root.programUsesStabilizedPreview(clip, stabilizedVisual))
            return String(clip.stabilizationPreviewSourceUrl)
        const original = String(clip.originalSourceUrl || clip.sourceUrl || "")
        const proxy = clip.proxyReady === true ? String(clip.proxySourceUrl || "") : ""
        if (previewQualityMode === "full")
            return original
        if (previewQualityMode === "proxy")
            return proxy.length > 0 ? proxy : original
        if (previewQualityMode === "clip")
            return String(clip.sourceUrl || original)
        return previewInteractionActive && proxy.length > 0 ? proxy : original
    }

    function foregroundCutoutMaskUrlForClip(clip, sourceSeconds) {
        if (!clip || clip.foregroundCutoutEnabled !== true
                || clip.foregroundCutoutReady !== true)
            return ""
        const metadata = clip.foregroundCutout || ({})
        const directory = String(clip.foregroundMaskDirectory
                                 || metadata.directoryUrl || metadata.directory || "")
        const fps = Number(metadata.fps || 0)
        const trimStart = Number(metadata.trimStart || 0)
        const frameCount = Math.max(0, Number(metadata.frameCount || 0))
        if (directory.length === 0 || !Number.isFinite(fps) || fps <= 0
                || !Number.isFinite(sourceSeconds) || frameCount <= 0)
            return ""
        const frameIndex = Math.floor((sourceSeconds - trimStart) * fps)
        if (frameIndex < 0 || frameIndex >= frameCount)
            return ""
        const fileName = "mask_" + String(frameIndex).padStart(6, "0") + ".png"
            return directory + (directory.endsWith("/") ? "" : "/") + fileName
    }

    function foregroundCutoutMaskUrlForLayer(layer) {
        return root.foregroundCutoutMaskUrlForClip(
                    layer,
                    root.programLayerSourceSeconds(layer))
    }

    function foregroundMaskImageFillModeFor(frameMode) {
        switch (String(frameMode || "fit")) {
        case "fill":
            return Image.PreserveAspectCrop
        case "stretch":
            return Image.Stretch
        default:
            return Image.PreserveAspectFit
        }
    }

    function canLoadPickedMedia() {
        return mediaPickerDialog.selectedMediaType !== "timeline"
                && mediaPickerDialog.selectedFilePath.length > 0
                && mediaPickerDialog.selectedOnline
    }

    function pickedMediaDisabledReason() {
        if (mediaPickerDialog.selectedMediaType === "timeline")
            return "Choose photo, video, or audio media instead of a timeline document."
        if (mediaPickerDialog.selectedFilePath.length === 0)
            return "Choose media from the gallery before loading it."
        if (!mediaPickerDialog.selectedOnline)
            return "This media is offline. Reconnect it in Library before using it in the timeline."
        return ""
    }

    function preferredMediaPickerProject() {
        if (timelineDocument.projectBinding.length > 0)
            return timelineDocument.projectBinding
        if (catalogAssets.projectFilter !== "all" && catalogAssets.projectFilter !== "unassigned")
            return catalogAssets.projectFilter
        return ""
    }

    function hasProjectScopedMediaPicker() {
        return preferredMediaPickerProject().length > 0
    }

    function requestMediaPickerRefresh() {
        mediaPickerAssetsDirty = true
        if (root.visible && mediaPickerDialog.visible)
            mediaPickerRefreshTimer.restart()
    }

    function refreshMediaPickerAssets(force) {
        if (!force && (!root.visible || !mediaPickerDialog.visible)) {
            mediaPickerAssetsDirty = true
            return
        }
        mediaPickerRefreshTimer.stop()
        const selectedAssetId = mediaPickerDialog.selectedAssetId
        mediaPickerProjectName = mediaPickerScope === "project" ? preferredMediaPickerProject() : ""
        mediaPickerAssets = catalogAssets.mediaPickerAssets(mediaPickerProjectName)
        mediaPickerAssetsDirty = false
        if (!force && selectedAssetId.length > 0) {
            let selectedIndex = -1
            for (let index = 0; index < mediaPickerAssets.length; ++index) {
                if (String(mediaPickerAssets[index].assetId || "") === selectedAssetId) {
                    selectedIndex = index
                    break
                }
            }
            mediaPickerDialog.selectAssetIndex(selectedIndex)
        }
    }

    function mediaPickerSubtitle() {
        if (mediaPickerScope === "project" && mediaPickerProjectName.length > 0)
            return "Showing timeline-ready media in " + mediaPickerProjectName
        return "Showing all timeline-ready media from the catalog"
    }

    function mediaPickerEmptyStateText() {
        if (catalogAssets.loading)
            return "Library is still loading."
        if (mediaPickerScope === "project" && mediaPickerProjectName.length > 0)
            return "No photo, video, or audio media is assigned to " + mediaPickerProjectName + "."
        return "No timeline-ready media is available yet. Import media in Library first."
    }

    function applyResolutionPreset() {
        switch (setupResolutionPreset) {
        case "1920 x 1080":
            setupWidth = "1920"
            setupHeight = "1080"
            break
        case "3840 x 2160":
            setupWidth = "3840"
            setupHeight = "2160"
            break
        case "1080 x 1920":
            setupWidth = "1080"
            setupHeight = "1920"
            break
        case "1080 x 1080":
            setupWidth = "1080"
            setupHeight = "1080"
            break
        case "1080 x 1350":
            setupWidth = "1080"
            setupHeight = "1350"
            break
        default:
            break
        }
    }

    function applySetupExportPreset(preset) {
        setupExportPreset = preset
        setupExportContainer = "mp4"
        setupExportCodec = "h264"
        if (preset === "youtube")
            setupResolutionPreset = "1920 x 1080"
        else if (preset === "instagram")
            setupResolutionPreset = "1080 x 1350"
        else
            setupResolutionPreset = "1080 x 1920"
        applyResolutionPreset()
    }

