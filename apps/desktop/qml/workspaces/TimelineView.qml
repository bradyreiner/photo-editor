    function currentInspectorSelectionType() {
        const count = Number(timelineDocument ? timelineDocument.selectedClipCount : 0)
        if (count <= 0)
            return "none"
        if (count > 1)
            return "multi"
        const mediaType = String(currentClip && currentClip.mediaType
                                 ? currentClip.mediaType : "video")
        if (mediaType === "adjustment")
            return "adjustment"
        if (mediaType === "title" || mediaType === "caption" || mediaType === "audio")
            return mediaType
        if (mediaType === "video")
            return "video"
        return "visual"
    }

    function inspectorTabValidForType(tab, selectionType) {
        if (selectionType === "none" || selectionType === "multi")
            return false
        if (tab === "title")
            return selectionType === "title" || selectionType === "caption"
        if (selectionType === "adjustment")
            return tab === "effects" || tab === "clip" || tab === "color"
        if (selectionType === "video")
            return tab === "effects" || tab === "motion" || tab === "audio"
                    || tab === "transitions" || tab === "clip" || tab === "color"
        return tab === "effects" || tab === "motion" || tab === "audio"
                || tab === "transitions" || tab === "clip"
    }

    function defaultInspectorTabForType(selectionType) {
        if (selectionType === "title" || selectionType === "caption")
            return "title"
        if (selectionType === "audio")
            return "audio"
        return "effects"
