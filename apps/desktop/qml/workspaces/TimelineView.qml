    function timelineToolCursor(pressed) {
        const tool = timelineDocument.activeTool
        if (tool === "hand") return pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
        if (["trim", "ripple", "roll", "slip", "slide", "rate-stretch"].indexOf(tool) >= 0)
            return Qt.SizeHorCursor
        if (["razor", "pen", "zoom", "track-select"].indexOf(tool) >= 0) return Qt.CrossCursor
        return pressed ? Qt.ClosedHandCursor : Qt.ArrowCursor
    }

    function updateBladePreview(clip, contentX, contentY, laneHeight) {
        if (timelineDocument.activeTool !== "razor") {
