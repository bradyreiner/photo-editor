    function platformOverlayAspectMismatch() {
        const expected = Number(root.activePlatformOverlayDefinition.aspectValue || 0)
        if (expected <= 0)
            return false
        const settings = root.sequenceSettings || ({})
        const actual = Number(settings.width || 1920) / Math.max(1, Number(settings.height || 1080))
        return Math.abs(actual - expected) > 0.02
    }

