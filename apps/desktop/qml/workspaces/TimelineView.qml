                                                tone: "neutral"
                                            }
                                        }

                                        Label {
                                            Layout.fillWidth: true
                                            text: String(relinkCard.modelData.originalPath || "")
                                            color: theme.textFaint
                                            font.family: theme.fontMono
                                            font.pixelSize: theme.typeCaption
                                            elide: Text.ElideNone
                                        }

                                        RowLayout {
                                            Layout.fillWidth: true
                                            spacing: theme.space8

                                            ToneComboBox {
                                                accessibleLabel: qsTr("Replacement path for missing timeline media")
                                                Layout.fillWidth: true
                                                model: root.relinkCandidatePaths(relinkCard.modelData)
                                                currentIndex: Math.max(0, model.indexOf(
                                                                           String(relinkCard.modelData.candidatePath || "")))
                                                enabled: model.length > 0
                                                onActivated: function(candidateIndex) {
                                                    root.updateBatchRelinkSubstitution(
                                                                relinkCard.index,
                                                                model[candidateIndex], false)
                                                }
                                            }

                                            FilterChip {
                                                text: "Approve"
                                                active: relinkCard.modelData.approved === true
                                                enabled: relinkCard.selectedMatch.accepted === true
                                                tooltipText: enabled
                                                             ? "Approve this identity-verified substitution."
                                                             : "This candidate conflicts with the saved size, duration, dimensions, or content signature."
                                                onClicked: root.updateBatchRelinkSubstitution(
                                                               relinkCard.index,
                                                               relinkCard.modelData.candidatePath,
                                                               !active)
                                            }
                                        }

                                        Label {
                                            Layout.fillWidth: true
                                            text: relinkCard.selectedMatch.accepted === true
                                                  ? "Identity match · " + String(relinkCard.selectedMatch.confidence || 0) + "% · "
                                                    + (relinkCard.selectedMatch.reasons || []).join(" · ")
                                                  : (relinkCard.modelData.matches || []).length === 0
                                                    ? "No same-name candidates found in this folder."
                                                    : "Candidate rejected · " + (relinkCard.selectedMatch.reasons || []).join(" · ")
