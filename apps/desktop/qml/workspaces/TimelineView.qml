                                    "enabled": modelData.protected !== true,
                                    "disabledReason": "Unprotect this milestone before removing it.",
                                    "tooltip": "Permanently remove this checkpoint file."
                                }
                            ]
                            onMenuItemTriggered: function(key) {
                                if (key === "compare") {
                                    root.sequenceVersionCompareData =
                                        timelineDocument.sequenceVersionComparison(
                                            String(modelData.versionId))
                                } else if (key === "restore") {
                                    timelineDocument.restoreSequenceVersion(String(modelData.versionId))
                                } else if (key === "edit-details") {
                                    root.sequenceVersionEditingId = String(modelData.versionId)
