        fullScreenProgramSafeAreas = false
        fullScreenProgramPlatformPreset = "off"
        fullScreenProgramControlsVisible = true
        fullScreenProgramPreviousWindowVisibility = hostWindow
                ? hostWindow.visibility : Window.Windowed
