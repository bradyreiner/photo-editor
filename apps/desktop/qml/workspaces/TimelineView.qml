    onAudioPeakSnappingEnabledChanged: timelineWorkspaceSettings.audioPeakSnappingEnabled = audioPeakSnappingEnabled
    onRippleModeEnabledChanged: timelineWorkspaceSettings.rippleModeEnabled = rippleModeEnabled
    onPreviewQualityModeChanged: {
        timelineWorkspaceSettings.previewQualityMode = previewQualityMode
        timelinePlayback.previewQualityMode = previewQualityMode
    }
    onPreviewInteractionActiveChanged: {
        timelinePlayback.interactionActive = previewInteractionActive
        root.scheduleBackgroundWorkIntentPublish()
    }
    onEffectFavoritesChanged: timelineWorkspaceSettings.effectFavoritesJson = JSON.stringify(effectFavorites)
    onEffectRecentsChanged: timelineWorkspaceSettings.effectRecentsJson = JSON.stringify(effectRecents)
    onEffectDiscoveryCategoryChanged: timelineWorkspaceSettings.effectDiscoveryCategory = effectDiscoveryCategory
    onCompatibleEffectsOnlyChanged: timelineWorkspaceSettings.compatibleEffectsOnly = compatibleEffectsOnly
    onProgramComparisonBypassEffectsChanged: {
        timelinePlayback.setTimelineEffectsBypassed(programComparisonBypassEffects)
        if (!programComparisonBypassEffects) {
            programComparisonAwaitingBypassFrame = false
            programComparisonBypassClearSource = ""
        }
    }
    onProgramScopesActiveScopeChanged: {
        timelineWorkspaceSettings.programScopesActiveScope = programScopesActiveScope
        scheduleWorkspaceLayoutSave()
    }
    onProgramSourceGangEnabledChanged: {
        timelineWorkspaceSettings.programSourceGangEnabled = programSourceGangEnabled
        if (programSourceGangEnabled)
            programSourceGangPausedSyncTimer.restart()
        else
            timelineDocument.clearProgramSourceGangState()
    }
    onProgramScopesVisibleChanged: {
        if (panelDockingReady && !syncingPanelState && !restoringTimelineLayout)
            panelDockState.setVisible("scopes", programScopesVisible)
        scheduleWorkspaceLayoutSave()
        if (workspacePanelSettingsInitialized)
            timelineWorkspaceSettings.programScopesVisible = programScopesVisible
        if (programScopesVisible) {
            schedulePausedProgramScopeRefresh()
        } else {
            programScopesRefreshTimer.stop()
            programScopesPausedRefreshPending = false
            programScopesDetached = false
            programScopesFrozen = false
            programScopesGrabResult = null
            timelineDocument.clearProgramScopeAnalysis()
        }
    }
    onProgramScopesFrozenChanged: {
        if (programScopesFrozen) {
            programScopesRefreshTimer.stop()
            programScopesPausedRefreshPending = false
        }
    }
    onSequenceTrackModelChanged: {
        clearProgramPlaybackDetailCache()
        timelineTrackWindowTimer.restart()
        // Keep the item holding a pointer grab alive through its edit gesture.
        // Updating delegates inside this binding can cancel a trim and undo it.
        timelineSurfaceRefreshTimer.restart()
    }
    onSequencePlayheadSecondsChanged: {
        if (rotoCorrectionOverlayVisible)
            rotoCorrectionOverlayVisible = false
        root.followTimelinePlayheadIfNeeded()
        programPlaybackLayersRefreshTimer.restart()
        if (programSourceGangEnabled && !sequencePlaying)
            programSourceGangPausedSyncTimer.restart()
        schedulePausedProgramScopeRefresh()
    }
    onProgramComparisonModeChanged: {
        if (programComparisonMode === "difference")
            programComparisonDifferenceTimer.restart()
    }

