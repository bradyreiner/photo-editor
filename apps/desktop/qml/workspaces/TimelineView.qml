        const fps = Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const seconds = Math.round(contentX / timelineZoom * fps) / fps
        if (bladePreview.visible && bladePreview.frameData && bladePreview.frameData.clipId === String(clip.clipId || "")
                && Math.abs(bladePreview.seconds - seconds) < 0.000001
                && bladePreview.y === contentY && bladePreview.height === laneHeight) return
        const frameData = root.trimFrameForClip(clip,
            root.clipSourceTime(clip, (seconds - Number(clip.startSeconds || 0)) * timelineZoom), "SOURCE FRAME")
        bladePreview = {visible: true, x: seconds * timelineZoom, y: contentY,
            height: laneHeight, seconds: seconds, frameData: frameData,
            valid: seconds > Number(clip.startSeconds || 0) + 0.5 / fps
                && seconds < Number(clip.startSeconds || 0) + Number(clip.trimmedDurationSeconds || 0) - 0.5 / fps}
