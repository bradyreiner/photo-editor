        if (viewportWidth <= 0)
            return [0, cadence]
        const buffer = horizontalVirtualizationBuffer()
        const leftSeconds = Math.max(0, (timelineViewport.contentX - buffer) / timelineZoom)
        const rightSeconds = Math.min(sequenceDurationSeconds(),
                                      (timelineViewport.contentX + viewportWidth + buffer) / timelineZoom)
        const first = Math.max(0, Math.floor(leftSeconds / cadence))
        const last = Math.max(first + 1, Math.ceil(rightSeconds / cadence))
        let ticks = []
        for (let tick = first; tick <= last; ++tick)
            ticks.push(tick * cadence)
        return ticks
    }

    function virtualizedSequenceMarkers() {
        const markers = sequenceMarkerModel || []
        const viewportWidth = Number(timelineViewport ? timelineViewport.width : 0)
        if (viewportWidth <= 0)
            return markers
        const buffer = horizontalVirtualizationBuffer()
        const leftSeconds = Math.max(0, (timelineViewport.contentX - buffer) / timelineZoom)
        const rightSeconds = (timelineViewport.contentX + viewportWidth + buffer) / timelineZoom
        let visibleMarkers = []
        for (let markerIndex = 0; markerIndex < markers.length; ++markerIndex) {
            const marker = markers[markerIndex]
            const seconds = Number(marker && marker.seconds || 0)
            if (seconds >= leftSeconds && seconds <= rightSeconds)
                visibleMarkers.push(marker)
        }
        return visibleMarkers
    }

    function virtualizedTrackModel() {
        const tracks = sequenceTrackModel || []
        const viewportHeight = Number(timelineViewport ? timelineViewport.height : 0)
        if (viewportHeight <= 0)
            return tracks
        const buffer = verticalVirtualizationBuffer()
        const visibleTop = Math.max(0, timelineViewport.contentY - buffer)
        const visibleBottom = timelineViewport.contentY + viewportHeight + buffer
        let visibleTracks = []
        for (let row = 0; row < tracks.length; ++row) {
            const track = tracks[row]
            const top = trackTopY(row)
            const bottom = top + trackHeight(track ? track.trackId : "")
            if (bottom >= visibleTop && top <= visibleBottom)
                visibleTracks.push(track)
        }
        return visibleTracks
    }

    function virtualizedClipsForTrack(track) {
        const clips = track && track.clips ? track.clips : []
        const viewportWidth = Number(timelineViewport ? timelineViewport.width : 0)
        if (viewportWidth <= 0)
            return clips
        const buffer = horizontalVirtualizationBuffer()
        const leftSeconds = Math.max(0, (timelineViewport.contentX - buffer) / timelineZoom)
        const rightSeconds = (timelineViewport.contentX + viewportWidth + buffer) / timelineZoom
        let visibleClips = []
        for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
            const clip = clips[clipIndex]
            const start = Number(clip && clip.startSeconds || 0)
            const end = start + Math.max(0, Number(clip && clip.trimmedDurationSeconds || 0))
            if (clip && clip.selected || end >= leftSeconds && start <= rightSeconds)
                visibleClips.push(clip)
        }
        return visibleClips
    }

    function visibleBackgroundWorkClipIds() {
        const tracks = virtualizedTrackModel()
        let ids = []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const clips = virtualizedClipsForTrack(tracks[trackIndex])
            for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                const clipId = String(clips[clipIndex].clipId || "")
                if (clipId.length > 0 && ids.indexOf(clipId) < 0)
                    ids.push(clipId)
            }
        }
        return ids
    }

