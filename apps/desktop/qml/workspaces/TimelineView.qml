            onProjectSettingsRequested: root.openProjectSettings()
        }
    }

    Window {
        id: keyframeCurveWindow
        objectName: "timelineKeyframeCurveWindow"
        title: "Curve Editor — " + root.keyframeParameterLabel(root.curveEditorParameter)
        transientParent: root.Window.window
        flags: Qt.Tool
        width: 760
        height: 440
        minimumWidth: 560
        minimumHeight: 340
        color: theme.ink950
        visible: false

        readonly property var curveKeyframes: root.keyframesForClipParameter(
                                                  root.currentClip,
                                                  root.curveEditorParameter)
        readonly property var parameterBounds: root.keyframeParameterBounds(root.curveEditorParameter)
        readonly property real curveDuration: Math.max(0.001, Number(root.currentClip.trimmedDurationSeconds || 0))
        readonly property real curveSpeedMagnitudeValue: computeCurveSpeedMagnitude()
        property string graphMode: "value"
        property var selectedSeconds: []

        function clearCurveSelection() {
            selectedSeconds = []
            root.curveEditorSelectedSeconds = -1
        }

        function isCurveSecondSelected(seconds) {
            const target = Number(seconds || 0)
            for (let index = 0; index < selectedSeconds.length; ++index) {
                if (Math.abs(Number(selectedSeconds[index]) - target) < 0.001)
                    return true
            }
            return false
        }

        function selectCurveSecond(seconds, additive) {
            const target = Number(seconds || 0)
            let next = additive ? selectedSeconds.slice(0) : []
            let existing = -1
            for (let index = 0; index < next.length; ++index) {
                if (Math.abs(Number(next[index]) - target) < 0.001) {
                    existing = index
                    break
                }
            }
            if (additive && existing >= 0) {
                next.splice(existing, 1)
            } else if (existing < 0) {
                next.push(target)
            }
            next.sort(function(left, right) { return Number(left) - Number(right) })
            selectedSeconds = next
            root.curveEditorSelectedSeconds = next.length > 0
                                              ? target : -1
        }

        function pruneCurveSelection() {
            const next = []
            for (let selectionIndex = 0; selectionIndex < selectedSeconds.length; ++selectionIndex) {
                const seconds = Number(selectedSeconds[selectionIndex])
                for (let keyIndex = 0; keyIndex < curveKeyframes.length; ++keyIndex) {
                    if (Math.abs(Number(curveKeyframes[keyIndex].seconds || 0) - seconds) < 0.001) {
                        next.push(seconds)
                        break
                    }
                }
            }
            selectedSeconds = next
            if (!isCurveSecondSelected(root.curveEditorSelectedSeconds))
                root.curveEditorSelectedSeconds = next.length > 0 ? Number(next[next.length - 1]) : -1
        }

        function curveValueAt(localSeconds) {
            const values = curveKeyframes
            if (values.length === 0)
                return parameterBounds.minimum
            if (localSeconds <= Number(values[0].seconds || 0))
                return Number(values[0].value || 0)
            if (localSeconds >= Number(values[values.length - 1].seconds || 0))
                return Number(values[values.length - 1].value || 0)
            for (let index = 0; index + 1 < values.length; ++index) {
                const left = values[index]
                const right = values[index + 1]
                const leftSeconds = Number(left.seconds || 0)
                const rightSeconds = Number(right.seconds || 0)
                if (localSeconds > rightSeconds)
                    continue
                return root.interpolatedKeyframeValue(
                    left,
                    right,
                    (localSeconds - leftSeconds)
                    / Math.max(0.0001, rightSeconds - leftSeconds))
            }
            return Number(values[values.length - 1].value || 0)
        }

        function curveSpeedAt(localSeconds) {
            const step = Math.max(1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)),
                                  curveDuration / 1000)
            const left = Math.max(0, Number(localSeconds || 0) - step)
            const right = Math.min(curveDuration, Number(localSeconds || 0) + step)
            if (right <= left)
                return 0
            return (curveValueAt(right) - curveValueAt(left)) / (right - left)
        }

        function computeCurveSpeedMagnitude() {
            let magnitude = 0.001
            for (let sample = 0; sample <= 120; ++sample) {
                magnitude = Math.max(magnitude, Math.abs(
                    curveSpeedAt(curveDuration * sample / 120)))
            }
            return magnitude
        }

        function keyframeSpeedAtIndex(index) {
            const values = curveKeyframes
            if (values.length < 2 || index < 0 || index >= values.length)
                return 0
            const leftIndex = Math.max(0, index - 1)
            const rightIndex = Math.min(values.length - 1, index + 1)
            const left = values[leftIndex]
            const right = values[rightIndex]
            return (Number(right.value || 0) - Number(left.value || 0))
                    / Math.max(0.0001,
                               Number(right.seconds || 0) - Number(left.seconds || 0))
        }

        function graphYForSpeed(speed) {
            const magnitude = curveSpeedMagnitudeValue
            return theme.space16
                    + (1 - (Number(speed || 0) + magnitude) / (magnitude * 2))
                      * Math.max(1, curveGraph.height - theme.space16 * 2)
        }

        function selectedCurveKeyframe() {
            for (let index = 0; index < curveKeyframes.length; ++index) {
                if (Math.abs(Number(curveKeyframes[index].seconds || 0)
                             - root.curveEditorSelectedSeconds) < 0.001)
                    return curveKeyframes[index]
            }
            return null
        }

        function selectedCurveKeyframeIndex() {
            for (let index = 0; index < curveKeyframes.length; ++index) {
                if (Math.abs(Number(curveKeyframes[index].seconds || 0)
                             - root.curveEditorSelectedSeconds) < 0.001)
                    return index
            }
            return -1
        }

        function graphXForSeconds(seconds) {
            return theme.space16
                    + Math.max(0, Math.min(curveDuration, Number(seconds || 0)))
                      / curveDuration * Math.max(1, curveGraph.width - theme.space16 * 2)
        }

        function graphYForValue(value) {
            const minimum = Number(parameterBounds.minimum)
            const maximum = Number(parameterBounds.maximum)
            return theme.space16
                    + (1 - (Number(value || 0) - minimum)
                       / Math.max(0.0001, maximum - minimum))
                      * Math.max(1, curveGraph.height - theme.space16 * 2)
        }

        function graphSecondsForX(x) {
            return Math.max(0, Math.min(
                curveDuration,
                (Number(x || 0) - theme.space16)
                / Math.max(1, curveGraph.width - theme.space16 * 2)
                * curveDuration))
        }

        function graphValueForY(y) {
            const minimum = Number(parameterBounds.minimum)
            const maximum = Number(parameterBounds.maximum)
            return maximum
                    - Math.max(0, Math.min(1,
                        (Number(y || 0) - theme.space16)
                        / Math.max(1, curveGraph.height - theme.space16 * 2)))
                      * (maximum - minimum)
        }

        function bezierHandlePoint(side) {
            if (graphMode !== "value")
                return ({"visible": false, "x": 0, "y": 0})
            const index = selectedCurveKeyframeIndex()
            if (index < 0)
                return ({"visible": false, "x": 0, "y": 0})
            const selected = curveKeyframes[index]
            if (side === "out") {
                if (index + 1 >= curveKeyframes.length
                        || String(selected.interpolation || "") !== "bezier")
                    return ({"visible": false, "x": 0, "y": 0})
                const next = curveKeyframes[index + 1]
                const span = Number(next.seconds || 0) - Number(selected.seconds || 0)
                const timeOffset = selected.bezierOutCustom === true
                                   ? Number(selected.bezierOutTimeSeconds || 0) : span / 3
                const valueOffset = selected.bezierOutCustom === true
                                    ? Number(selected.bezierOutValue || 0) : 0
                return ({
                    "visible": true,
                    "x": graphXForSeconds(Number(selected.seconds || 0) + timeOffset),
                    "y": graphYForValue(Number(selected.value || 0) + valueOffset)
                })
            }
            if (index === 0
                    || String(curveKeyframes[index - 1].interpolation || "") !== "bezier")
                return ({"visible": false, "x": 0, "y": 0})
            const previous = curveKeyframes[index - 1]
            const span = Number(selected.seconds || 0) - Number(previous.seconds || 0)
            const timeOffset = selected.bezierInCustom === true
                               ? Number(selected.bezierInTimeSeconds || 0) : -span / 3
            const valueOffset = selected.bezierInCustom === true
                                ? Number(selected.bezierInValue || 0) : 0
            return ({
                "visible": true,
                "x": graphXForSeconds(Number(selected.seconds || 0) + timeOffset),
                "y": graphYForValue(Number(selected.value || 0) + valueOffset)
            })
        }

        function selectedCurveHasBezierHandles() {
            const index = selectedCurveKeyframeIndex()
            if (index < 0)
                return false
            return String(curveKeyframes[index].interpolation || "") === "bezier"
                    || (index > 0
                        && String(curveKeyframes[index - 1].interpolation || "") === "bezier")
        }

        onCurveKeyframesChanged: {
            pruneCurveSelection()
            curveCanvas.requestPaint()
        }
        onParameterBoundsChanged: curveCanvas.requestPaint()
        onGraphModeChanged: curveCanvas.requestPaint()

