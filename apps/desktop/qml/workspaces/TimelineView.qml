    function controlBackgroundJob(job, action) {
        const id = String(job.jobId || "")
        if (String(job.origin || "") === "timeline") {
            timelineDocument.controlTimelineBackgroundJob(id, action)
        } else if (jobQueue) {
            if (action === "pause")
                jobQueue.pauseJob(id)
            else if (action === "resume")
                jobQueue.resumeJob(id)
            else if (action === "cancel")
                jobQueue.cancelJob(id)
            else if (action === "retry")
                jobQueue.retryJob(id)
        }
        Qt.callLater(root.refreshBackgroundJobs)
    }

    function cycleBackgroundJobPriority(job) {
        if (!jobQueue || job.canChangePriority !== true)
            return
        const current = String(job.priority || "normal")
        const next = current === "high" ? "normal"
                   : current === "normal" ? "low" : "high"
        jobQueue.setJobPriority(String(job.jobId || ""), next)
        Qt.callLater(root.refreshBackgroundJobs)
    }

    function persistentRenderJobMenuItems(job) {
        const resourcePolicy = job.metadata && job.metadata.resourcePolicy
                               ? String(job.metadata.resourcePolicy) : "playback-first"
        return [
            { key: "move-earlier", label: "Move Earlier", icon: "move-up",
              enabled: job.canMoveUp === true,
              disabledReason: "This job is already first at its priority." },
            { key: "move-later", label: "Move Later", icon: "move-down",
              enabled: job.canMoveDown === true,
              disabledReason: "This job is already last at its priority." },
            { key: "resources-playback-first", label: "Resources · Playback First", icon: "play",
              separatorBefore: true, checked: resourcePolicy === "playback-first",
              enabled: job.canChangePriority === true,
              disabledReason: "Resource policy is fixed while a render is active." },
            { key: "resources-balanced", label: "Resources · Balanced", icon: "adjust",
              checked: resourcePolicy === "balanced", enabled: job.canChangePriority === true,
              disabledReason: "Resource policy is fixed while a render is active." },
            { key: "resources-export-first", label: "Resources · Export First", icon: "export",
              checked: resourcePolicy === "export-first", enabled: job.canChangePriority === true,
              disabledReason: "Resource policy is fixed while a render is active." },
            { key: "duplicate", label: "Duplicate Job", icon: "copy",
              separatorBefore: true, enabled: job.canDuplicate === true,
              disabledReason: "Wait for the active render to stop before duplicating it." },
            { key: "reveal", label: "Reveal Output", icon: "folder",
              enabled: job.canRevealOutput === true,
              disabledReason: "Reveal is available after the output is written." }
        ]
    }

    function handlePersistentRenderJobMenu(job, action) {
        const id = String(job.jobId || "")
        if (!jobQueue || id.length === 0)
            return
        if (action === "move-earlier")
            jobQueue.moveRenderJob(id, -1)
        else if (action === "move-later")
            jobQueue.moveRenderJob(id, 1)
        else if (action === "duplicate")
            jobQueue.duplicateRenderJob(id)
        else if (action === "reveal")
            jobQueue.revealJobOutput(id)
        else if (action.indexOf("resources-") === 0)
            jobQueue.setRenderResourcePolicy(id, action.slice("resources-".length))
        Qt.callLater(root.refreshBackgroundJobs)
    }

