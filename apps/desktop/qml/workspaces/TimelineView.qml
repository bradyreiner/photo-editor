                                        {
                                            "key": "restore",
                                            "label": "Restore this version",
                                            "icon": "reset",
                                            "tooltip": "Create a safety checkpoint, then restore this edit."
                                        },
                                        {
                                            "key": "edit-details",
                                            "label": "Edit name and details",
                                            "icon": "edit",
                                            "enabled": String(modelData.kind || "named") === "named",
                                            "disabledReason": "Automatic recovery metadata is read-only.",
                                            "tooltip": "Update milestone metadata without changing its saved edit."
