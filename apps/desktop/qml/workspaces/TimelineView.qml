    function handleTimelineWorkspaceToolAction(key) {
        if (key === "program-scopes") {
            programScopesVisible ? closeProgramScopes() : openProgramScopes(false)
        } else if (key === "audio-mixer") {
            openAudioMixerPopup()
        } else if (key === "generate-captions") {
            openCaptionGenerator()
        } else if (key === "delivery-settings") {
            openDeliverySettings(null)
        } else if (key === "delivery-check") {
            openDeliveryPreflight(null)
        }
    }

    function captureTimelineWorkspaceLayout() {
        return {
            sourceCollapsed: sourcePanelCollapsed, sourceHidden: sourcePanelHidden,
            inspectorCollapsed: effectsPanelCollapsed, sourceDetached: sourcePanelDetached,
            inspectorDetached: effectsPanelDetached, sourceWidth: sourcePanelWidth,
            inspectorWidth: effectsPanelWidth, monitorHeight: monitorPanelHeight,
            monitorUserResized: monitorPanelUserResized, timelineHeight: initialTimelinePanelHeight,
            sourceTab: sourceRailTab, inspectorTab: inspectorTab,
            scopesVisible: programScopesVisible, scopesDetached: programScopesDetached,
            scopeKind: programScopesActiveScope,
            curveDocked: curveEditorDocked, curveOpen: curveEditorOpen,
            auxiliaryDockWidth: auxiliaryDockWidth, bottomDockWidth: bottomDockWidth,
            dockPanels: panelDockState.snapshot().panels,
            activePanelByDock: Object.assign({}, panelDockState.activePanelByDock)
        }
    }

    function saveCurrentTimelineWorkspaceLayout() {
        if (!workspacePanelSettingsInitialized || restoringTimelineLayout)
            return false
        workspaceLayoutState.remember(timelineLayoutPreset, captureTimelineWorkspaceLayout())
        if (panelDockingReady)
            panelDockState.rememberPreset(timelineLayoutPreset)
        timelineWorkspaceSettings.workspaceLayoutsJson = JSON.stringify(workspaceLayoutState.layouts)
        workspaceLayoutStatus = timelineLayoutPresetTitle() + " layout saved"
        return true
    }

    function applyTimelineLayoutPreset(preset) {
        return applyStoredTimelineLayoutPreset(preset, false)
    }

    function applyStoredTimelineLayoutPreset(preset, restoring) {
        const key = String(preset || "")
        if (!workspaceLayoutState.validPreset(key))
            return false
        if (restoring !== true)
            saveCurrentTimelineWorkspaceLayout()
        restoringTimelineLayout = true
        const layout = workspaceLayoutState.layout(key)
        timelineLayoutPreset = key
        timelineFocusModeActive = false
        sourcePanelHidden = layout.sourceHidden
        sourcePanelCollapsed = layout.sourceCollapsed
        effectsPanelCollapsed = layout.inspectorCollapsed
        if (layout.sourceDetached)
            detachedSourceWindow.contentRequested = true
        if (layout.inspectorDetached)
            detachedInspectorWindow.contentRequested = true
        sourcePanelDetached = layout.sourceDetached
        effectsPanelDetached = layout.inspectorDetached
        sourcePanelWidth = layout.sourceWidth
        effectsPanelWidth = layout.inspectorWidth
        auxiliaryDockWidth = Number(layout.auxiliaryDockWidth || 340)
        bottomDockWidth = Number(layout.bottomDockWidth || 440)
        monitorPanelHeight = layout.monitorHeight
        monitorPanelUserResized = layout.monitorUserResized
        initialTimelinePanelHeight = layout.timelineHeight
        sourceRailTab = layout.sourceTab
        inspectorTab = key === "color" ? "color" : layout.inspectorTab
        if (key !== "color" && !inspectorTabValidForType(inspectorTab, currentInspectorSelectionType()))
            inspectorTab = defaultInspectorTabForType(currentInspectorSelectionType())
        programScopesActiveScope = layout.scopeKind
        programScopesVisible = (layout.scopesVisible
                || (panelDockingReady && panelDockState.visible("scopes"))) && hasPlayableSequence()
        programScopesDetached = layout.scopesDetached && programScopesVisible
        if (programScopesDetached)
            programScopesWindow.contentRequested = true
        curveEditorDocked = layout.curveDocked
        curveEditorOpen = layout.curveOpen || (panelDockingReady && panelDockState.visible("keyframes"))
        workspaceLayoutStatus = timelineLayoutPresetTitle(key) + " workspace"
        restoringTimelineLayout = false
        if (panelDockingReady) {
            panelDockState.applyArrangement(key, layout)
            // A task choice must reveal its primary controls even if that panel
            // was closed in a previously saved arrangement.
            if (key === "color") panelDockState.focusPanel("color")
            else if (key === "audio") panelDockState.focusPanel("mixer")
            else if (key === "finish") panelDockState.focusPanel("captions")
            lastFocusedTimelinePanel = key === "color" ? "color"
                    : key === "audio" ? "mixer" : key === "finish" ? "captions" : "inspector"
            compactSideFocusedPanel = key === "color" || key === "audio" ? "color" : "inspector"
            syncTimelinePanelState()
        }
        if (programScopesVisible)
            Qt.callLater(root.schedulePausedProgramScopeRefresh)
        return true
    }

    function resetCurrentTimelineWorkspaceLayout() {
        workspaceLayoutState.reset(timelineLayoutPreset)
        timelineWorkspaceSettings.workspaceLayoutsJson = JSON.stringify(workspaceLayoutState.layouts)
        applyStoredTimelineLayoutPreset(timelineLayoutPreset, true)
        workspaceLayoutStatus = timelineLayoutPresetTitle() + " layout reset"
    }

    function restoreInspectorTabForSelection() {
        const selectionType = currentInspectorSelectionType()
        if (timelineLayoutPreset === "color") {
            inspectorTab = "color"
            return
        }
        if (selectionType === "none" || selectionType === "multi")
            return
        if (timelineLayoutPreset === "color"
                && inspectorTabValidForType("color", selectionType)) {
            inspectorTab = "color"
            return
        }
        if (timelineLayoutPreset === "finish"
                && (selectionType === "title" || selectionType === "caption")) {
            inspectorTab = "title"
            return
        }
        const saved = String(inspectorTabsByType[selectionType] || "")
        inspectorTab = inspectorTabValidForType(saved, selectionType)
                       ? saved : defaultInspectorTabForType(selectionType)
    }

    function inspectorContextKey() {
        return currentInspectorSelectionType() + "|" + inspectorTab
    }

    function inspectorContentScrollPosition(panelRole) {
        const key = panelRole === "effects" ? "library|effects" : inspectorContextKey()
        return Math.max(0, Number(inspectorScrollByContext[key] || 0))
    }

    function setInspectorContentScrollPosition(position, panelRole) {
        const key = panelRole === "effects" ? "library|effects" : inspectorContextKey()
        const selectionType = currentInspectorSelectionType()
        if (panelRole !== "effects" && (selectionType === "none" || selectionType === "multi"))
            return
        const updated = Object.assign({}, inspectorScrollByContext)
        updated[key] = Math.max(0, Number(position || 0))
        inspectorScrollByContext = updated
        timelineWorkspaceSettings.inspectorScrollByContextJson = JSON.stringify(updated)
    }

    function inspectorEffectDisclosureState() {
        return inspectorDisclosureByType[currentInspectorSelectionType()] || ({})
    }

    function setInspectorEffectDisclosure(effectName, expanded) {
        const selectionType = currentInspectorSelectionType()
        if (selectionType === "none" || selectionType === "multi")
            return
        const updated = Object.assign({}, inspectorDisclosureByType)
        const typeState = Object.assign({}, updated[selectionType] || ({}))
        typeState[String(effectName || "")] = expanded === true
        updated[selectionType] = typeState
        inspectorDisclosureByType = updated
        timelineWorkspaceSettings.inspectorDisclosureByTypeJson = JSON.stringify(updated)
    }

