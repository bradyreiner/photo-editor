    function revealTimelineSelection(preferredTab) {
        if (Number(timelineDocument.selectedClipCount || 0) <= 0)
            return false
        const type = currentInspectorSelectionType()
        const saved = String(inspectorTabsByType[type] || "")
        const requested = String(preferredTab || (timelineLayoutPreset === "color" ? "color" : "controls"))
        const initial = timelineSelectionIntent.initialTab(currentClip)
        if (inspectorTabValidForType(requested, type))
            inspectorTab = requested
        else if (inspectorTabValidForType(saved, type))
            inspectorTab = saved
        else if (inspectorTabValidForType(initial, type))
            inspectorTab = initial
        effectsPanelCollapsed = false
        showTimelinePanel("inspector")
        return true
    }

