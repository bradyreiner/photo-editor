    function trackAutomationLaneState(trackId) {
        const state = trackAutomationLanes[String(trackId || "")]
        return state || ({"expanded": false, "parameter": "", "previousHeight": defaultLaneHeight})
    }

    function trackAutomationLaneExpanded(trackId) {
        return trackAutomationLaneState(trackId).expanded === true
    }

    function trackAutomationLaneParameter(trackData) {
        const state = trackAutomationLaneState(trackData ? trackData.trackId : "")
        if (String(state.parameter || "").length > 0)
            return String(state.parameter)
        return trackData && trackData.trackKind === "audio" ? "audioGainDb" : "opacity"
    }

    function trackAutomationGraphSpeedMode(trackId) {
        return trackAutomationGraphModes[String(trackId || "")] === true
    }

    function setTrackAutomationGraphSpeedMode(trackId, enabled) {
        const modes = Object.assign({}, trackAutomationGraphModes)
        modes[String(trackId || "")] = enabled === true
        trackAutomationGraphModes = modes
    }

    function toggleTrackAutomationLane(trackData, parameter) {
        if (!trackData || !trackData.trackId)
            return
        const trackId = String(trackData.trackId)
        const requested = String(parameter || (trackData.trackKind === "audio" ? "audioGainDb" : "opacity"))
        const current = trackAutomationLaneState(trackId)
        const closing = current.expanded === true && String(current.parameter || "") === requested
        let updated = Object.assign({}, trackAutomationLanes)
        if (closing) {
            updated[trackId] = {
                "expanded": false,
                "parameter": requested,
                "previousHeight": Number(current.previousHeight || defaultLaneHeight)
            }
            trackAutomationLanes = updated
            setTrackHeight(trackId, Number(current.previousHeight || defaultLaneHeight))
            return
        }
        updated[trackId] = {
            "expanded": true,
            "parameter": requested,
            "previousHeight": current.expanded === true
                              ? Number(current.previousHeight || defaultLaneHeight)
                              : trackHeight(trackId)
        }
        trackAutomationLanes = updated
        setTrackHeight(trackId, Math.max(104, trackHeight(trackId)))
    }

    function trackAutomationKeyframes(trackData, parameter) {
        const overrides = root.trackAutomationOverrides || ({})
        const trackId = String(trackData ? trackData.trackId || "" : "")
        const source = overrides[trackId] !== undefined
                       ? overrides[trackId]
                       : (trackData && trackData.automationKeyframes
                          ? trackData.automationKeyframes : [])
        let values = []
        for (let index = 0; index < source.length; ++index) {
            if (String(source[index].parameter || "") === String(parameter || ""))
                values.push(source[index])
        }
        values.sort(function(left, right) {
            return Number(left.seconds || 0) - Number(right.seconds || 0)
        })
        return values
    }

    function trackAutomationBounds(parameter) {
        if (parameter === "opacity") return ({"minimum": 0, "maximum": 1})
        if (parameter === "audioPan") return ({"minimum": -1, "maximum": 1})
        if (parameter === "audioEqLowDb" || parameter === "audioEqMidDb"
                || parameter === "audioEqHighDb") return ({"minimum": -12, "maximum": 12})
        if (parameter === "audioCompressorThresholdDb") return ({"minimum": -48, "maximum": -1})
        if (parameter === "audioCompressorRatio") return ({"minimum": 1, "maximum": 20})
        if (parameter === "audioCompressorMakeupDb") return ({"minimum": 0, "maximum": 18})
        if (parameter === "audioLimiterCeilingDb") return ({"minimum": -12, "maximum": 0})
        if (parameter === "audioGateThresholdDb") return ({"minimum": -80, "maximum": -10})
        if (parameter === "audioDeEsserAmount") return ({"minimum": 0, "maximum": 1})
        if (parameter === "audioHighPassHz") return ({"minimum": 20, "maximum": 1000})
        if (parameter === "audioLowPassHz") return ({"minimum": 1000, "maximum": 20000})
        return ({"minimum": -36, "maximum": 0})
    }

    function trackAutomationBaseValue(trackData, parameter) {
        if (trackData && trackData[parameter] !== undefined)
            return Number(trackData[parameter])
        if (parameter === "opacity")
            return Number(trackData && trackData.baseOpacity !== undefined ? trackData.baseOpacity : 1)
        if (parameter === "audioPan")
            return Number(trackData && trackData.baseAudioPan !== undefined ? trackData.baseAudioPan : 0)
        return Number(trackData && trackData.baseAudioGainDb !== undefined ? trackData.baseAudioGainDb : 0)
    }

    function trackAutomationValueAt(trackData, parameter, sequenceSeconds) {
        const values = trackAutomationKeyframes(trackData, parameter)
        if (values.length === 0)
            return trackAutomationBaseValue(trackData, parameter)
        const seconds = Math.max(0, Number(sequenceSeconds || 0))
        if (seconds <= Number(values[0].seconds || 0))
            return Number(values[0].value || 0)
        if (seconds >= Number(values[values.length - 1].seconds || 0))
            return Number(values[values.length - 1].value || 0)
        for (let index = 0; index + 1 < values.length; ++index) {
            const left = values[index]
            const right = values[index + 1]
            const leftSeconds = Number(left.seconds || 0)
            const rightSeconds = Number(right.seconds || 0)
            if (seconds > rightSeconds)
                continue
            return interpolatedKeyframeValue(
                left,
                right,
                (seconds - leftSeconds) / Math.max(0.0001, rightSeconds - leftSeconds))
        }
        return Number(values[values.length - 1].value || 0)
    }

    function trackAutomationPointY(parameter, value, laneHeight) {
        const bounds = trackAutomationBounds(parameter)
        const normalized = (Number(value || 0) - Number(bounds.minimum))
                           / Math.max(0.0001, Number(bounds.maximum) - Number(bounds.minimum))
        return theme.space4 + (1 - Math.max(0, Math.min(1, normalized)))
               * Math.max(1, laneHeight - theme.space8)
    }

    function trackAutomationValueFromY(parameter, y, laneHeight) {
        const bounds = trackAutomationBounds(parameter)
        const normalized = 1 - Math.max(0, Math.min(1,
            (Number(y || 0) - theme.space4) / Math.max(1, laneHeight - theme.space8)))
        return Number(bounds.minimum)
               + normalized * (Number(bounds.maximum) - Number(bounds.minimum))
    }

    function trackAutomationSpeedAt(trackData, parameter, sequenceSeconds) {
        const duration = Math.max(0.001, sequenceDurationSeconds())
        const step = Math.max(1 / Math.max(1, Number(timelineDocument.framesPerSecond || 30)), duration / 2000)
        const seconds = Math.max(0, Math.min(duration, Number(sequenceSeconds || 0)))
        const left = Math.max(0, seconds - step)
        const right = Math.min(duration, seconds + step)
        if (right <= left)
            return 0
        return (trackAutomationValueAt(trackData, parameter, right)
                - trackAutomationValueAt(trackData, parameter, left)) / (right - left)
    }

    function trackAutomationKeyframeIndexAt(trackData, parameter, sequenceSeconds) {
        const values = trackAutomationKeyframes(trackData, parameter)
        const tolerance = 0.5 / Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        for (let index = 0; index < values.length; ++index) {
            if (Math.abs(Number(values[index].seconds || 0) - Number(sequenceSeconds || 0))
                    <= tolerance)
                return index
        }
        return -1
    }

    function trackAutomationKeyframeHasSide(trackData, parameter, sequenceSeconds, side) {
        const values = trackAutomationKeyframes(trackData, parameter)
        const index = trackAutomationKeyframeIndexAt(trackData, parameter, sequenceSeconds)
        if (index < 0)
            return false
        return side === "in" ? index > 0 : index + 1 < values.length
    }

    function trackAutomationKeyframeHandlesLinked(trackData, parameter, sequenceSeconds) {
        const values = trackAutomationKeyframes(trackData, parameter)
        const index = trackAutomationKeyframeIndexAt(trackData, parameter, sequenceSeconds)
        return index < 0 || values[index].bezierHandlesLinked !== false
    }

    function trackAutomationSpeedAtSide(trackData, parameter, sequenceSeconds, side) {
        const values = trackAutomationKeyframes(trackData, parameter)
        const index = trackAutomationKeyframeIndexAt(trackData, parameter, sequenceSeconds)
        if (index < 0 || !trackAutomationKeyframeHasSide(
                    trackData, parameter, sequenceSeconds, side))
            return 0
        const keyframe = values[index]
        const custom = side === "in" ? Boolean(keyframe.bezierInCustom)
                                       : Boolean(keyframe.bezierOutCustom)
        const interpolation = side === "in"
                ? String(values[index - 1].interpolation || "linear")
                : String(keyframe.interpolation || "linear")
        const handleTime = side === "in" ? Number(keyframe.bezierInTimeSeconds || 0)
                                          : Number(keyframe.bezierOutTimeSeconds || 0)
        const handleValue = side === "in" ? Number(keyframe.bezierInValue || 0)
                                           : Number(keyframe.bezierOutValue || 0)
        if (custom && interpolation === "bezier" && Math.abs(handleTime) > 0.000001)
            return handleValue / handleTime

        const keySeconds = Number(keyframe.seconds || 0)
        const neighbor = values[side === "in" ? index - 1 : index + 1]
        const span = Math.abs(keySeconds - Number(neighbor.seconds || 0))
        const step = Math.max(0.00001, Math.min(0.001, span / 1000))
        const otherSeconds = side === "in" ? Math.max(0, keySeconds - step)
                                            : keySeconds + step
        const leftSeconds = Math.min(keySeconds, otherSeconds)
        const rightSeconds = Math.max(keySeconds, otherSeconds)
        if (rightSeconds <= leftSeconds)
            return 0
        return (trackAutomationValueAt(trackData, parameter, rightSeconds)
                - trackAutomationValueAt(trackData, parameter, leftSeconds))
               / (rightSeconds - leftSeconds)
    }

    function trackAutomationSpeedEditorTrackData() {
        const index = trackAutomationSpeedEditTrackRowIndex
        return index >= 0 && index < sequenceTrackModel.length
               ? sequenceTrackModel[index] : trackAutomationSpeedEditTrackData
    }

    function trackAutomationSpeedUnit(parameter) {
        const normalized = String(parameter || "")
        if (normalized === "audioHighPassHz" || normalized === "audioLowPassHz")
            return "Hz/s"
        if (normalized === "audioPan")
            return "pan/s"
        if (normalized === "audioCompressorRatio")
            return "ratio/s"
        if (normalized === "opacity" || normalized === "audioDeEsserAmount")
            return "value/s"
        return "dB/s"
    }

    function openTrackAutomationKeyframeSpeedEditor(trackRowIndex, trackData, parameter,
                                                     sequenceSeconds, focusReturnItem) {
        trackAutomationSpeedEditTrackRowIndex = Number(trackRowIndex)
        trackAutomationSpeedEditParameter = String(parameter || "")
        trackAutomationSpeedEditSeconds = Number(sequenceSeconds || 0)
        trackAutomationSpeedEditTrackData = trackData
        trackAutomationSpeedEditFocusReturnItem = focusReturnItem
        trackAutomationSpeedEditorPopup.contentCreated = true
        trackAutomationSpeedEditorPopup.incomingSpeedField.text = Number(trackAutomationSpeedAtSide(
            trackData, trackAutomationSpeedEditParameter,
            trackAutomationSpeedEditSeconds, "in")).toFixed(4)
        trackAutomationSpeedEditorPopup.outgoingSpeedField.text = Number(trackAutomationSpeedAtSide(
            trackData, trackAutomationSpeedEditParameter,
            trackAutomationSpeedEditSeconds, "out")).toFixed(4)
        trackAutomationSpeedEditorPopup.open()
        Qt.callLater(function() {
            const field = trackAutomationKeyframeHasSide(
                trackAutomationSpeedEditorTrackData(),
                trackAutomationSpeedEditParameter,
                trackAutomationSpeedEditSeconds,
                "in") ? trackAutomationSpeedEditorPopup.incomingSpeedField
                      : trackAutomationSpeedEditorPopup.outgoingSpeedField
            field.forceActiveFocus()
            field.selectAll()
        })
    }

    function applyTrackAutomationKeyframeSpeedSide(side) {
        const field = side === "in" ? trackAutomationSpeedEditorPopup.incomingSpeedField
                                     : trackAutomationSpeedEditorPopup.outgoingSpeedField
        const speed = Number(field.text)
        if (!isFinite(speed) || trackAutomationSpeedEditTrackRowIndex < 0 ||
                trackAutomationSpeedEditParameter.length === 0 ||
                trackAutomationSpeedEditSeconds < 0 ||
                !trackAutomationKeyframeHasSide(
                    trackAutomationSpeedEditorTrackData(),
                    trackAutomationSpeedEditParameter,
                    trackAutomationSpeedEditSeconds,
                    side)) {
            return false
        }
        timelineDocument.beginContinuousEdit()
        timelineDocument.setTrackAutomationKeyframeSpeedForSide(
            trackAutomationSpeedEditTrackRowIndex,
            trackAutomationSpeedEditParameter,
            trackAutomationSpeedEditSeconds,
            side,
            speed)
        timelineDocument.endContinuousEdit()
        timelineDocument.seekSequenceSeconds(trackAutomationSpeedEditSeconds)
        return true
    }

    function trackAutomationSpeedMagnitude(trackData, parameter) {
        const duration = Math.max(0.001, sequenceDurationSeconds())
        const bounds = trackAutomationBounds(parameter)
        let magnitude = Math.max(0.001,
                                 (Number(bounds.maximum) - Number(bounds.minimum)) / duration * 2)
        for (let sample = 0; sample <= 80; ++sample)
            magnitude = Math.max(magnitude, Math.abs(trackAutomationSpeedAt(
                trackData, parameter, duration * sample / 80)))
        return magnitude
    }

    function trackAutomationSpeedPointY(trackData, parameter, speed, laneHeight) {
        const magnitude = trackAutomationSpeedMagnitude(trackData, parameter)
        const normalized = (Number(speed || 0) + magnitude) / (magnitude * 2)
        return theme.space4 + (1 - Math.max(0, Math.min(1, normalized)))
               * Math.max(1, laneHeight - theme.space8)
    }

    function trackAutomationSpeedFromY(trackData, parameter, y, laneHeight) {
        const magnitude = trackAutomationSpeedMagnitude(trackData, parameter)
        const normalized = 1 - Math.max(0, Math.min(1,
            (Number(y || 0) - theme.space4) / Math.max(1, laneHeight - theme.space8)))
        return magnitude * (normalized * 2 - 1)
    }

    function trackAutomationCurvePoints(trackData, parameter, laneHeight, speedMode) {
        const duration = Math.max(0, sequenceDurationSeconds())
        const values = trackAutomationKeyframes(trackData, parameter)
        let sampleTimes = [0]
        if (values.length === 0) {
            sampleTimes.push(duration)
        } else {
            for (let index = 0; index < values.length; ++index) {
                const current = Math.max(0, Math.min(duration, Number(values[index].seconds || 0)))
                if (sampleTimes.indexOf(current) < 0)
                    sampleTimes.push(current)
                if (index + 1 >= values.length)
                    continue
                const next = Math.max(0, Math.min(duration, Number(values[index + 1].seconds || 0)))
                for (let step = 1; step < 12; ++step)
                    sampleTimes.push(current + (next - current) * step / 12)
            }
            sampleTimes.push(duration)
        }
        sampleTimes.sort(function(left, right) { return left - right })
        let points = []
        for (let index = 0; index < sampleTimes.length; ++index) {
            const seconds = sampleTimes[index]
            const pointValue = speedMode === true
                    ? trackAutomationSpeedAt(trackData, parameter, seconds)
                    : trackAutomationValueAt(trackData, parameter, seconds)
            points.push(Qt.point(seconds * timelineZoom,
                                 speedMode === true
                                 ? trackAutomationSpeedPointY(trackData, parameter, pointValue, laneHeight)
                                 : trackAutomationPointY(parameter, pointValue, laneHeight)))
        }
        return points
    }

