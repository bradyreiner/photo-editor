    function trackTopY(trackIndex) {
        const layout = trackVerticalLayout
        if (trackIndex < 0)
            return rulerHeight
        const tops = layout.topByIndex || []
        return trackIndex < tops.length ? Number(tops[trackIndex])
                                        : Number(layout.trackBottom || rulerHeight)
    }

    function ensureTimelineClipTrackVisible(clipValue) {
        const clip = clipValue !== undefined && clipValue !== null
                ? clipValue : root.currentClip
        const viewport = root.timelineViewport
        if (!clip || !viewport || Number(viewport.height || 0) <= 0)
            return false

        const trackId = String(clip.trackId || "")
        const clipId = String(clip.clipId || "")
        if (trackId.length === 0 && clipId.length === 0)
            return false

        const tracks = root.sequenceTrackModel || []
        const layout = root.trackVerticalLayout || ({})
        const tops = layout.topByIndex || []
        const hidden = layout.hiddenByIndex || []
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const track = tracks[trackIndex]
            if (!track)
                continue
            const matchesTrack = trackId.length > 0
                    && String(track.trackId || "") === trackId
            const clips = track.clips || []
            let containsClip = false
            if (!matchesTrack && clipId.length > 0) {
                for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                    if (String(clips[clipIndex] && clips[clipIndex].clipId || "") === clipId) {
                        containsClip = true
                        break
                    }
                }
            }
            if (!matchesTrack && !containsClip)
                continue
            if (hidden[trackIndex] === true)
                return false

            const selectedTrackId = String(track.trackId || trackId)
            const trackTop = Number(tops[trackIndex] || root.rulerHeight)
            const trackBottom = trackTop + root.trackHeight(selectedTrackId)
            const viewportTop = Number(viewport.contentY || 0)
            const viewportHeight = Number(viewport.height || 0)
            const viewportBottom = viewportTop + viewportHeight
            if (trackTop >= viewportTop && trackBottom <= viewportBottom)
                return false

            const desiredTop = trackTop < viewportTop
                    ? trackTop : trackBottom - viewportHeight
            const maximumTop = Math.max(0, Number(viewport.contentHeight || 0) - viewportHeight)
            viewport.contentY = Math.max(0, Math.min(maximumTop, desiredTop))
            return true
        }
        return false
    }

