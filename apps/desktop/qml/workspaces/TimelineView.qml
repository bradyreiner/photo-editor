    Connections {
        target: appShell

        function onTimelineDefaultsChanged() {
            root.snappingEnabled = appShell.defaultTimelineSnapping
            root.rippleModeEnabled = appShell.defaultTimelineRipple
        }

        function onTimelineWorkspaceSettingsReset() {
            root.restoreDefaultLayout()
        }
    }

    Connections {
        target: timelineDocument

        function onTrackingChanged() { root.motionTrackingUiMessage = "" }

        function onColorScopeAnalysisChanged() {
            if (!colorFinishingPopup.visible)
                return
            root.colorScopeData = timelineDocument.colorScopeAnalysisData
            if (colorFinishingPopup.scopesCanvas)
                colorFinishingPopup.scopesCanvas.requestPaint()
        }

        function onProgramComparisonRequested(clipId, sequenceSeconds, mode) {
            if (!root.hasPlayableSequence())
                return
            if (root.programComparisonActive)
                root.closeProgramComparison()
            timelineDocument.seekSequenceSeconds(Number(sequenceSeconds))
            root.currentClip = timelineDocument.currentClip
            root.programClip = timelineDocument.programClip
            if (String(root.programClip.clipId || "") !== String(clipId))
                return
            if (!root.openProgramComparison())
                return
            root.programComparisonMode = String(mode || "wipe")
        }

        function onProgramScopeCaptureRequested() {
            if (root.programComparisonActive || root.fullScreenProgramActive) {
                timelineDocument.acknowledgeProgramScopeCaptureRequest(
                            false, "Close Program Comparison or Full Screen Program before capturing scopes.")
                return
            }
            const accepted = root.openProgramScopes(false)
            timelineDocument.acknowledgeProgramScopeCaptureRequest(
                        accepted, accepted ? "" : "The Timeline has no playable Program frame.")
        }

        function onTimelineStateChanged() {
            if (!timelineDocument.hasActiveTimeline) {
                root.clearTimelineTrackFocus()
                root.timelineViewportStateRestored = false
                root.closeTransientSurfaces()
                root.sourcePanelDetached = false
                root.effectsPanelDetached = false
            } else if (!root.timelineViewportStateRestored) {
                Qt.callLater(root.restoreTimelineViewportState)
            }
        }

        function onRecentTimelinesChanged() {
            root.recentTimelineRecords = timelineDocument.recentTimelineRecords
            root.recentTimelinesLoading = timelineDocument.recentTimelinesLoading
        }

        function onTimelineSaveCompleted(success, timelineAssetId, projectBinding) {
            if (!success)
                return
            if (projectBinding.length > 0 && timelineAssetId.length > 0)
                catalogAssets.addAssetToProjectAsync(timelineAssetId, projectBinding)
            else
                catalogAssets.refresh()
        }

        function onSelectionChanged() {
            // QVariantMap-valued controller properties can retain their
            // previous JS wrapper even after the shared notify signal fires.
            // Refresh the map explicitly so Program and Inspector content
            // follow the controller selection immediately.
            const previousClipId = String(root.currentClip && root.currentClip.clipId || "")
            const nextClip = timelineDocument.currentClip
            const nextClipId = String(nextClip && nextClip.clipId || "")
            const primaryClipChanged = previousClipId !== nextClipId
            root.currentClip = nextClip
            if (primaryClipChanged) {
                root.motionSeedSelectionActive = false
                root.motionSeedSelectionHudVisible = false
                root.motionSeedAwaitingFirstFrame = false
                root.motionSeedFrameSource = ""
                root.motionSeedFrameAssetId = ""
                root.motionSeedFrameSourceSeconds = -1
                root.motionSeedRectNormalized = ({"x": 0, "y": 0, "width": 0, "height": 0})
                root.motionTrackingUiMessage = ""
            }
            if (keyframeCurveWindow.visible && !keyframeCurveWindow.trackAutomationMode) {
                const parameters = nextClip.availableKeyframeParameters || []
                if (parameters.indexOf(root.curveEditorParameter) < 0 && parameters.length > 0) {
                    root.curveEditorParameter = String(parameters[0])
                    keyframeCurveWindow.clearCurveSelection()
                } else if (primaryClipChanged) {
                    keyframeCurveWindow.clearCurveSelection()
                }
            }
            root.programClip = timelineDocument.programClip
            if (root.timelineTrackFocusMode)
                root.refreshTimelineTrackFocus()
            if (primaryClipChanged) {
                root.restoreInspectorTabForSelection()
                root.scheduleBackgroundWorkIntentPublish()
                if (nextClipId.length > 0) {
                    const selectedClipForScroll = nextClip
                    Qt.callLater(function() {
                        if (root.currentClip
                                && String(root.currentClip.clipId || "") === nextClipId)
                            root.ensureTimelineClipTrackVisible(selectedClipForScroll)
                    })
                }
            }
            if (root.timelineTrackFocusMode && !root.refreshTimelineTrackFocus())
                root.clearTimelineTrackFocus()
            if (root.keyboardTrimEdge.length > 0)
                root.editPointData = timelineDocument.selectedEditPointInfo(root.keyboardTrimEdge)
            if (primaryClipChanged && timelineDocument.currentIndex >= 0 && root.width >= 1180) {
                root.workspaceFocus = "timeline"
            }
        }

        function onPlaybackStateChanged() {
            // Refresh only the selected clip map. Background layers evaluate
            // their exposed keyframe tracks directly from the shared playhead.
            root.currentClip = timelineDocument.currentClip
            root.programClip = timelineDocument.programClip
            root.scheduleBackgroundWorkIntentPublish()
            if (root.programComparisonActive && !root.sequencePlaying)
                programComparisonRefreshTimer.restart()
        }

        function onEditorStateChanged() {
            if (timelineDocument.activeTool !== "trim" && root.keyboardTrimEdge.length > 0) {
                root.keyboardTrimEdge = ""
                root.editPointData = ({})
            }
        }

        function onSequenceChanged() {
            root.trackAutomationOverrides = ({})
            root.scheduleBackgroundWorkIntentPublish()
            if (root.hasAnyAdjustmentClips())
                adjustmentPreviewCacheTimer.restart()
            if (root.timelineTrackFocusMode)
                Qt.callLater(function() {
                    if (!root.refreshTimelineTrackFocus())
                        root.clearTimelineTrackFocus()
                })
        }

        function onTrackAutomationStateChanged(trackId, keyframes) {
            const updated = Object.assign({}, root.trackAutomationOverrides || ({}))
            updated[String(trackId || "")] = keyframes || []
            root.trackAutomationOverrides = updated
        }

        function onSelectedClipStateChanged() {
            root.timelineClipParameterRevision += 1
            if (!root.currentClip)
                return
            if (String(root.currentClip.mediaType || "") === "adjustment")
                adjustmentPreviewCacheTimer.restart()
            if (String(root.currentClip.trackKind || "") === "video"
                    && String(root.currentClip.clipId || "")
                       !== String(root.programClip.clipId || "")
                    && root.programLayerVisible(root.currentClip))
                root.refreshProgramPlaybackLayerModels(true)
        }

        function onSequenceVersionsChanged() {
            if (root.programComparisonActive)
                root.programComparisonVersionRecords = timelineDocument.sequenceVersions
            if (sequenceVersionsPopup.visible) {
                root.sequenceVersionRecords = timelineDocument.sequenceVersions
                if (root.sequenceVersionCompareData
                        && root.sequenceVersionCompareData.versionId) {
                    root.sequenceVersionCompareData = timelineDocument.sequenceVersionComparison(
                        String(root.sequenceVersionCompareData.versionId))
                }
            }
        }

        function onRecoveryCandidatesChanged() {
            // Journal commits are frequent. Verify full recovery chains only
            // while the chooser is being used, rather than after every edit.
            root.recoveryCandidateRecords = timelineDocument.recoveryCandidates
            if (!root.visible)
                return
            if (root.recoveryCandidateRefreshPending
                    && !timelineDocument.recoveryCandidatesLoading) {
                root.recoveryCandidateRefreshPending = false
                if (!root.recoveryPromptPresented && root.recoveryCandidateRecords.length > 0) {
                    root.recoveryPromptPresented = true
                    timelineRecoveryPopup.open()
                }
            }
            if (timelineRecoveryPopup.visible
                    && !timelineDocument.recoveryCandidatesLoading
                    && root.recoveryCandidateRecords.length === 0
                    && !timelineDocument.recoveryOpenInProgress)
                timelineRecoveryPopup.close()
        }

        function onRecoveryOpenCompleted(candidateId, succeeded) {
            if (String(candidateId || "") !== timelineRecoveryPopup.pendingRecoveryCandidateId)
                return
            timelineRecoveryPopup.pendingRecoveryCandidateId = ""
            if (succeeded) {
                root.recoveryOpenErrorMessage = ""
                timelineRecoveryPopup.close()
            } else {
                root.recoveryOpenErrorMessage = String(timelineDocument.status ||
                                                       "Recovery could not be opened. Your current timeline remains open.")
            }
        }

        function onLoudnessAnalysisChanged() {
            if (deliveryPreflightPopup.visible)
                root.deliveryPreflightData = timelineDocument.timelineDeliveryPreflight()
            if (publishPopup.visible)
                root.publishData = timelineDocument.timelinePublishSummary()
        }

        function onProjectCacheSummaryChanged() {
            if (projectCachePopup.visible) {
                root.refreshProjectCacheData(root.projectCacheSelectAfterRefresh)
                root.refreshProjectCacheBudgetData(false)
            }
        }

        function onProjectCacheCleanupFinished(result) {
            if (projectCachePopup.visible
                    && (!result.timelineId || result.timelineId === root.projectCacheData.timelineId)) {
                root.projectCacheCleanupResult = result
                root.projectCacheSelectedCategories = []
                root.projectCacheCleanupArmed = false
                root.refreshProjectCacheData(false)
            }
        }

        function onCacheBudgetStateChanged() {
            if (projectCachePopup.visible)
                root.refreshProjectCacheBudgetData(false)
        }
    }

