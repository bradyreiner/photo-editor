        for (let index = 0; index < tracks.length; ++index) {
            const track = tracks[index]
            if (Number(track.clipCount || 0) === 0 && (track.clips || []).length === 0)
                empty[String(track.trackId || "")] = true
        }
        return empty
    }

    function trackHeight(trackId) {
        if (timelineTrackFocusMode
                && timelineTrackFocusHeightOverrides[String(trackId || "")] !== undefined)
            return Math.max(28, timelineTrackFocusHeightOverrides[String(trackId || "")] * timelineLaneScale)
        return trackHeights[trackId] ? Math.max(28, trackHeights[trackId] * timelineLaneScale)
                : (emptyTimelineTrackIds[String(trackId || "")]
                   ? Math.max(28, Math.min(defaultLaneHeight, theme.scaled(32) * timelineLaneScale)) : defaultLaneHeight)
    }

    function trackIsHiddenByCollapsedGroup(trackIndex) {
        const hiddenRows = trackVerticalLayout.hiddenByIndex || []
        return trackIndex >= 0 && trackIndex < hiddenRows.length
                ? hiddenRows[trackIndex] === true : false
    }

    function setTrackHeight(trackId, height) {
        const clamped = Math.max(28, Math.min(200, height / timelineLaneScale))
        if (timelineTrackFocusMode) {
            const focusedHeights = Object.assign({}, timelineTrackFocusHeightOverrides || ({}))
            focusedHeights[String(trackId || "")] = clamped
            timelineTrackFocusHeightOverrides = focusedHeights
            return
        }
        let updated = Object.assign({}, trackHeights)
        updated[trackId] = clamped
        trackHeights = updated
    }

    function setTimelineLaneScale(value, viewportAnchorY) {
        const next = Math.max(0.65, Math.min(2.5, Number(value)))
        if (!Number.isFinite(next) || Math.abs(next - timelineLaneScale) < 0.001)
            return
        const anchorY = Math.max(0, Math.min(timelineViewport.height, Number(viewportAnchorY || 0)))
        const hit = timelineTrackAtY(timelineViewport.contentY + anchorY)
        const fraction = hit ? (timelineViewport.contentY + anchorY - hit.top) / Math.max(1, hit.height) : 0
        timelineWorkspaceSettings.laneScale = next
        if (hit) {
            // Keep the same row under the pointer instead of jumping to another lane.
            timelineViewport.contentY = Math.max(0, Math.min(
                timelineContentHeight - timelineViewport.height,
                trackTopY(hit.index) + fraction * trackHeight(hit.track.trackId) - anchorY))
        }
    }

    function openTimelineNoteAt(seconds, clip, sourceItem, point, wholeClip) {
        const fps = Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const id = String(clip && clip.clipId || "")
        const clipStart = Math.round(Number(clip && clip.startSeconds || 0) * fps)
        const clipEnd = Math.round((Number(clip && clip.startSeconds || 0)
                                   + Number(clip && (clip.trimmedDurationSeconds || clip.durationSeconds) || 0)) * fps)
        const maxFrame = Math.round(sequenceDurationSeconds() * fps)
        let first = Math.max(0, Math.min(maxFrame, Math.round(Number(seconds) * fps)))
        let last = first
        if (id.length > 0) {
            first = wholeClip ? clipStart : Math.max(clipStart, Math.min(Math.max(clipStart, clipEnd - 1), first))
            last = wholeClip ? clipEnd : first
        }
        const local = sourceItem && point ? sourceItem.mapToItem(root, point.x, point.y)
                                         : Qt.point(root.width / 2 - quickNoteComposer.width / 2, root.height / 2 - 140)
        quickNoteComposer.x = Math.max(12, Math.min(root.width - quickNoteComposer.width - 12, local.x))
        quickNoteComposer.y = Math.max(12, Math.min(root.height - 320, local.y - 240))
        quickNoteComposer.beginDraft(first, last, id.length > 0 ? [id] : [],
            id.length > 0 ? String(clip.displayLabel || clip.timelineLabel || "Clip") : "Timeline · frame " + first)
    }

    function revealTimelineNote(note) {
        if (!note || !timelineViewport) return
        const fps = Math.max(1, Number(timelineDocument.framesPerSecond || 30))
        const first = Math.max(0, Number(note.seconds || 0))
        const last = String(note.anchorType || "frame") === "range"
                ? Math.max(first, Number(note.endFrame || 0) / fps) : first
        const ids = note.clipIds || []
        if (ids.length > 0) {
            timelineDocument.selectClipsByIds(ids)
            root.ensureTimelineClipTrackVisible(timelineDocument.currentClip)
        }
        timelinePlayback.seekSequenceSeconds(first)
        const contextDuration = Math.max(8, last - first + 4)
        root.timelineZoom = timelineScaleGeometry.fitZoom(
            Math.max(1, timelineViewport.width - 40), contextDuration,
            root.timelineZoomMin, root.timelineZoomMax)
        timelineViewport.contentX = Math.max(0, Math.min(
            root.timelineContentWidth - timelineViewport.width,
            root.timelineX(Math.max(0, first - 2))))
    }

    function clearTimelineTrackFocus() {
        timelineTrackFocusMode = false
        timelineTrackFocusExpandedIds = ({})
        timelineTrackFocusHeightOverrides = ({})
    }

    function refreshTimelineTrackFocus() {
        if (!timelineTrackFocusMode)
            return false

        const tracks = sequenceTrackModel || []
        const selectedIds = (timelineDocument.selectedClipIds || []).slice(0)
        const fallbackClipId = String(root.currentClip && root.currentClip.clipId || "")
        if (selectedIds.length === 0 && fallbackClipId.length > 0)
            selectedIds.push(fallbackClipId)

        const expanded = ({})
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const track = tracks[trackIndex]
            const clips = track && track.clips ? track.clips : []
            for (let clipIndex = 0; clipIndex < clips.length; ++clipIndex) {
                if (selectedIds.indexOf(String(clips[clipIndex].clipId || "")) >= 0) {
                    expanded[String(track.trackId || "")] = true
                    break
                }
            }
        }

        // Keep a linked picture and sound pair together in the focused view.
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const track = tracks[trackIndex]
            if (!track || expanded[String(track.trackId || "")] !== true
                    || track.isIndependent === true
                    || track.isStandaloneVisual === true
                    || track.isCaptionTrack === true)
                continue
            for (let pairedIndex = 0; pairedIndex < tracks.length; ++pairedIndex) {
                const paired = tracks[pairedIndex]
                if (paired && pairedIndex !== trackIndex
                        && Number(paired.laneIndex) === Number(track.laneIndex)
                        && paired.trackKind !== track.trackKind
                        && paired.isIndependent !== true
                        && paired.isStandaloneVisual !== true
                        && paired.isCaptionTrack !== true) {
                    expanded[String(paired.trackId || "")] = true
                }
            }
        }

        if (Object.keys(expanded).length === 0) {
            timelineTrackFocusExpandedIds = ({})
            timelineTrackFocusHeightOverrides = ({})
            return false
        }

        const heights = ({})
        for (let trackIndex = 0; trackIndex < tracks.length; ++trackIndex) {
            const trackId = String(tracks[trackIndex].trackId || "")
            heights[trackId] = expanded[trackId] === true
                    ? Math.max(88,
                               trackAutomationLaneExpanded(trackId)
                               ? Number(trackHeights[trackId] || defaultLaneHeight / timelineLaneScale) : 0)
                    : 34
        }
        timelineTrackFocusExpandedIds = expanded
        timelineTrackFocusHeightOverrides = heights
        return true
    }

    function toggleTimelineTrackFocus() {
        if (timelineTrackFocusMode) {
            clearTimelineTrackFocus()
            return true
        }
        timelineTrackFocusMode = true
        if (refreshTimelineTrackFocus())
            return true
        clearTimelineTrackFocus()
        return false
    }

    function setLaneHeaderWidth(width) {
        laneHeaderWidth = Math.max(laneHeaderWidthMinimum,
                                   Math.min(laneHeaderWidthMaximum, Number(width)))
    }

    function horizontalVirtualizationBuffer() {
        return Math.max(320, Number(timelineViewport ? timelineViewport.width : 0) * 0.75)
    }

    function verticalVirtualizationBuffer() {
        return Math.max(defaultLaneHeight * 2,
                        Number(timelineViewport ? timelineViewport.height : 0) * 0.5)
    }

    function virtualizedRulerTicks(interval) {
        const cadence = Number(interval || 0)
        if (cadence <= 0)
            return []
        const viewportWidth = Number(timelineViewport ? timelineViewport.width : 0)
        if (viewportWidth <= 0)
            return [0, cadence]
        const buffer = horizontalVirtualizationBuffer()
        const leftSeconds = Math.max(0, (timelineViewport.contentX - buffer) / timelineZoom)
        const rightSeconds = Math.min(sequenceDurationSeconds(),
                                      (timelineViewport.contentX + viewportWidth + buffer) / timelineZoom)
        const first = Math.max(0, Math.floor(leftSeconds / cadence))
        const last = Math.max(first + 1, Math.ceil(rightSeconds / cadence))
        let ticks = []
        for (let tick = first; tick <= last; ++tick)
            ticks.push(tick * cadence)
        return ticks
    }

    function timelineRulerTickModel(interval) {
        const ticks = virtualizedRulerTicks(interval)
        const labelEvery = rulerLabelInterval()
        return ticks.map(function(seconds) {
            const ratio = Number(seconds || 0) / Math.max(0.000001, labelEvery)
            const isMajor = Math.abs(ratio - Math.round(ratio)) < 0.001
            return {
                seconds: Number(seconds || 0),
                isMajor: isMajor,
                label: isMajor ? rulerLabel(seconds) : ""
            }
        })
    }

    function virtualizedSequenceMarkers() {
        const markers = sequenceMarkerModel || []
        const viewportWidth = Number(timelineViewport ? timelineViewport.width : 0)
        if (viewportWidth <= 0)
            return markers
        const buffer = horizontalVirtualizationBuffer()
        const leftSeconds = Math.max(0, (timelineViewport.contentX - buffer) / timelineZoom)
        const rightSeconds = (timelineViewport.contentX + viewportWidth + buffer) / timelineZoom
        let firstVisibleIndex = 0
        let lastSearchIndex = markers.length
        while (firstVisibleIndex < lastSearchIndex) {
            const middleIndex = Math.floor((firstVisibleIndex + lastSearchIndex) / 2)
            const markerSeconds = Number(markers[middleIndex] && markers[middleIndex].seconds || 0)
            if (markerSeconds < leftSeconds)
                firstVisibleIndex = middleIndex + 1
            else
                lastSearchIndex = middleIndex
        }
        let visibleMarkers = []
        for (let markerIndex = firstVisibleIndex; markerIndex < markers.length; ++markerIndex) {
            const marker = markers[markerIndex]
            const seconds = Number(marker && marker.seconds || 0)
            if (seconds > rightSeconds)
                break
            visibleMarkers.push(marker)
        }
        return visibleMarkers
    }

    function virtualizedTrackModel() {
        return timelineVirtualizedTrackRows
    }

    property bool timelineTrackRowsRefreshForcePending: false
    Timer {
        id: timelineTrackRowsRefreshTimer
        interval: 0
        repeat: false
        onTriggered: {
            const force = root.timelineTrackRowsRefreshForcePending
            root.timelineTrackRowsRefreshForcePending = false
            root.refreshVirtualizedTimelineTrackRows(force)
        }
    }

    function scheduleVirtualizedTimelineTrackRowsRefresh(force) {
        timelineTrackRowsRefreshForcePending = timelineTrackRowsRefreshForcePending
                || force === true
        timelineTrackRowsRefreshTimer.restart()
    }

    function refreshVirtualizedTimelineTrackRows(force) {
        if (trimFeedbackState.visible === true || dragPreviewState.visible === true)
            return false
        const tracks = sequenceTrackModel || []
        const layout = trackVerticalLayout
        const viewportHeight = Number(timelineViewport ? timelineViewport.height : 0)
        const viewportTop = Math.max(0, Number(timelineViewport ? timelineViewport.contentY : 0))
        const viewportBottom = viewportTop + viewportHeight
        const snapshotIsCurrent = timelineVirtualizedTrackSourceModel === tracks
                                           && timelineVirtualizedTrackLayoutSnapshot === layout
                                           && timelineVirtualizedTrackViewportHeight === viewportHeight
        if (force !== true && snapshotIsCurrent
                && viewportTop >= timelineVirtualizedTrackWindowTop
                && viewportBottom <= timelineVirtualizedTrackWindowBottom)
            return false

        const buffer = verticalVirtualizationBuffer()
        const visibleTop = Math.max(0, viewportTop - buffer)
        const visibleBottom = viewportBottom + buffer
        let visibleTracks = []
        // A zero-sized viewport is the transient state before the timeline
        // workspace has completed layout. Keep delegates empty until geometry
        // is available; the viewport size handlers populate the visible rows.
        if (viewportHeight > 0) {
            const trackTops = layout.topByIndex || []
            const hiddenRows = layout.hiddenByIndex || []
            for (let row = 0; row < tracks.length; ++row) {
                if (hiddenRows[row] === true)
                    continue
                const track = tracks[row]
                if (!track)
                    continue
                const top = Number(trackTops[row] || 0)
                const bottom = top + trackHeight(track.trackId)
                if (bottom >= visibleTop && top <= visibleBottom)
                    visibleTracks.push(track)
            }
        }

        const updateTrackData = force === true || timelineVirtualizedTrackSourceModel !== tracks
        const synchronizationResult = timelineVirtualizedTrackRowsModel.synchronizeRows(
                    visibleTracks, updateTrackData)
        if (!synchronizationResult || synchronizationResult.ok !== true)
            return false
        timelineVirtualizedTrackRows = visibleTracks
        timelineVirtualizedTrackSourceModel = tracks
        timelineVirtualizedTrackLayoutSnapshot = layout
        timelineVirtualizedTrackViewportHeight = viewportHeight
        timelineVirtualizedTrackWindowTop = visibleTop
        timelineVirtualizedTrackWindowBottom = visibleBottom
        return true
    }

    function refreshTimelineClipVirtualizationWindow(force) {
        if (trimFeedbackState.visible === true || dragPreviewState.visible === true)
            return false
        const previous = timelineClipVirtualizationWindow || ({})
        const viewportWidth = Number(timelineViewport ? timelineViewport.width : 0)
        const viewportLeftPixels = Math.max(0, Number(timelineViewport ? timelineViewport.contentX : 0))
        const viewportRightPixels = viewportLeftPixels + viewportWidth
        const zoom = timelineScaleGeometry.effectiveZoom(timelineZoom, timelineZoomMin)
        const duration = Math.max(0, sequenceDurationSeconds())
        const visibleLeft = Math.min(duration, viewportLeftPixels / zoom)
        const visibleRight = Math.min(duration, viewportRightPixels / zoom)
        const sameGeometry = previous.ready === true
                && Number(previous.viewportWidth) === viewportWidth
                && Number(previous.zoom) === zoom
                && Number(previous.duration) === duration
        if (force !== true && sameGeometry
                && visibleLeft >= Number(previous.left || 0)
                && visibleRight <= Number(previous.right || 0))
            return false

        let windowLeft = 0
        let windowRight = 0
        if (viewportWidth > 0) {
            const buffer = horizontalVirtualizationBuffer()
            windowLeft = Math.max(
                        0, (viewportLeftPixels - buffer) / zoom)
            windowRight = Math.min(
                        duration, (viewportRightPixels + buffer) / zoom)
        }
        timelineClipVirtualizationWindow = {
            "ready": viewportWidth > 0,
            "left": windowLeft,
            "right": windowRight,
            "viewportWidth": viewportWidth,
            "zoom": zoom,
            "duration": duration
        }
        return true
    }

    function virtualizedClipsForTrack(track) {
        return timelineBackgroundWorkIntent.virtualizedClipsForTrack(track)
    }

    function visibleBackgroundWorkClipIds() {
        return timelineBackgroundWorkIntent.visibleBackgroundWorkClipIds()
    }

    function scheduleBackgroundWorkIntentPublish() {
        backgroundWorkIntentTimer.restart()
    }

    function publishBackgroundWorkIntent() {
        timelineDocument.setBackgroundWorkIntent(
                    root.visible,
                    root.previewInteractionActive,
                    root.visible ? root.visibleBackgroundWorkClipIds() : [])
    }

    function safePosterSource(clip) {
        if (!clip || clip.mediaOnline === false)
            return ""
        return String(clip.posterSource || "")
    }

    function programSourceMatte(clip) {
        return clip && clip.sourceMatte ? clip.sourceMatte : ({ "enabled": false })
    }

    function programSourceMatteSource(clip) {
        const matte = root.programSourceMatte(clip)
        return matte.enabled === true ? String(matte.filePath || "") : ""
    }

    function programSourceMatteMode(clip) {
        return String(root.programSourceMatte(clip).mode || "alpha")
    }

    function programSourceMatteInvert(clip) {
        return root.programSourceMatte(clip).invert === true
    }

    function programSourceMatteFillEnabled(clip) {
        const matte = root.programSourceMatte(clip)
        return matte.fillColor !== undefined && String(matte.fillColor).length > 0
    }

    function programSourceMatteFillColor(clip) {
        return String(root.programSourceMatte(clip).fillColor || "transparent")
    }

    function programSceneImageSource(clip) {
        if (clip && clip.sceneAttachmentEnabled === true
                && clip.mediaType === "photo" && clip.mediaOnline !== false
                && String(clip.filePath || "").length > 0)
            return String(clip.filePath)
        return safePosterSource(clip)
    }

    function programUncroppedSourceAspectRatio(clip, sourcePixelSize) {
        let sourceWidth = Number(sourcePixelSize && sourcePixelSize.width || 0)
        let sourceHeight = Number(sourcePixelSize && sourcePixelSize.height || 0)
        if (sourceWidth <= 0 || sourceHeight <= 0) {
            sourceWidth = Number(clip && clip.sourceWidth || 0)
            sourceHeight = Number(clip && clip.sourceHeight || 0)
        }
        if (sourceWidth <= 0 || sourceHeight <= 0)
            return programMonitor.sequenceAspectRatio
        return sourceWidth / sourceHeight
    }

    function programSourceAspectRatio(clip, sourcePixelSize) {
        const sourceAspectRatio = programUncroppedSourceAspectRatio(clip, sourcePixelSize)
        const left = Number(clip && clip.sourceCropLeft || 0)
        const top = Number(clip && clip.sourceCropTop || 0)
        const right = Number(clip && clip.sourceCropRight !== undefined
                             ? clip.sourceCropRight : 1)
        const bottom = Number(clip && clip.sourceCropBottom !== undefined
                              ? clip.sourceCropBottom : 1)
        return sourceAspectRatio * Math.max(0.01, right - left)
                / Math.max(0.01, bottom - top)
    }

    function programSourceCropDisplayRect(clip, boundsWidth, boundsHeight) {
        const sourceWidth = Math.max(1, Number(clip && clip.sourceWidth || 1))
        const sourceHeight = Math.max(1, Number(clip && clip.sourceHeight || 1))
        const left = Number(clip && clip.sourceCropLeft || 0)
        const top = Number(clip && clip.sourceCropTop || 0)
        const right = Number(clip && clip.sourceCropRight !== undefined
                             ? clip.sourceCropRight : 1)
        const bottom = Number(clip && clip.sourceCropBottom !== undefined
                              ? clip.sourceCropBottom : 1)
        const cropWidth = Math.max(0.01, right - left)
        const cropHeight = Math.max(0.01, bottom - top)
        if (sourceCropEditingActive)
            return Qt.rect(boundsWidth * left, boundsHeight * top,
                           boundsWidth * cropWidth, boundsHeight * cropHeight)
        const frameMode = clip && clip.sceneAttachmentEnabled === true
                ? "fit" : String(clip && clip.frameMode || "fit")
        if (frameMode === "stretch")
            return Qt.rect(0, 0, boundsWidth, boundsHeight)
        const cropAspect = sourceWidth * cropWidth / (sourceHeight * cropHeight)
        const boundsAspect = boundsWidth / Math.max(1, boundsHeight)
        if (cropAspect > boundsAspect) {
            const displayedHeight = boundsWidth / cropAspect
            return Qt.rect(0, (boundsHeight - displayedHeight) * 0.5,
                           boundsWidth, displayedHeight)
        }
        const displayedWidth = boundsHeight * cropAspect
        return Qt.rect((boundsWidth - displayedWidth) * 0.5, 0,
                       displayedWidth, boundsHeight)
    }

    function knownEffectName(effectName) {
        const candidate = String(effectName || "")
        for (let index = 0; index < effectLibraryModel.length; ++index) {
            if (String(effectLibraryModel[index].name || "") === candidate)
                return true
        }
        return false
    }

    function normalizedEffectNames(names, maximumCount) {
        const source = names || []
        const limit = Math.max(0, Number(maximumCount || effectLibraryModel.length))
        let result = []
        for (let index = 0; index < source.length && result.length < limit; ++index) {
            const effectName = String(source[index] || "")
            if (knownEffectName(effectName) && result.indexOf(effectName) < 0)
                result.push(effectName)
        }
        return result
    }

    function toggleEffectFavorite(effectName) {
        const candidate = String(effectName || "")
        if (!knownEffectName(candidate))
            return
        let updated = normalizedEffectNames(effectFavorites, effectLibraryModel.length)
        const existingIndex = updated.indexOf(candidate)
        if (existingIndex >= 0)
            updated.splice(existingIndex, 1)
        else
            updated.unshift(candidate)
        effectFavorites = updated
    }

    function recordRecentEffect(effectName) {
        const candidate = String(effectName || "")
        if (!knownEffectName(candidate))
            return
        let updated = normalizedEffectNames(effectRecents, 8)
        const existingIndex = updated.indexOf(candidate)
        if (existingIndex >= 0)
            updated.splice(existingIndex, 1)
        updated.unshift(candidate)
        effectRecents = updated.slice(0, 8)
        if (Number(timelineDocument.selectedClipCount || 0) > 0) {
            setInspectorEffectDisclosure(candidate, true)
            revealTimelineSelection("effects")
        }
    }

    function restoreTimelineViewportState() {
        if (!timelineViewport || timelineViewport.width <= 0 || timelineViewport.contentWidth <= 0)
            return
        timelineViewport.contentX = Math.max(
                    0, Math.min(Number(timelineWorkspaceSettings.timelineScrollX || 0),
                                Math.max(0, timelineViewport.contentWidth - timelineViewport.width)))
        timelineViewport.contentY = Math.max(
                    0, Math.min(Number(timelineWorkspaceSettings.timelineScrollY || 0),
                                Math.max(0, timelineViewport.contentHeight + timelineViewportBottomInset - timelineViewport.height)))
        timelineViewportStateRestored = true
    }

    function currentInspectorSelectionType() {
        const count = Number(timelineDocument ? timelineDocument.selectedClipCount : 0)
        if (count <= 0)
            return "none"
        if (count > 1)
            return "multi"
        const mediaType = String(currentClip && currentClip.mediaType
                                 ? currentClip.mediaType : "video")
        if (mediaType === "adjustment")
            return "adjustment"
        if (mediaType === "title" || mediaType === "caption" || mediaType === "audio")
            return mediaType
        if (mediaType === "video")
            return "video"
        if (mediaType === "photo")
            return "photo"
        return "visual"
    }

    function inspectorTabValidForType(tab, selectionType) {
        if (selectionType === "none" || selectionType === "multi")
            return false
        if (tab === "controls")
            return true
        if (tab === "animate")
            return true
        if (tab === "title")
            return selectionType === "title" || selectionType === "caption"
        if (selectionType === "adjustment")
            return tab === "effects" || tab === "clip" || tab === "color"
        if (selectionType === "video")
            return tab === "effects" || tab === "motion" || tab === "audio"
                    || tab === "transitions" || tab === "clip" || tab === "color"
        if (selectionType === "photo")
            return tab === "effects" || tab === "motion" || tab === "audio"
                    || tab === "transitions" || tab === "clip" || tab === "color"
        return tab === "effects" || tab === "motion" || tab === "audio"
                || tab === "transitions" || tab === "clip"
    }

    function defaultInspectorTabForType(selectionType) {
        return "controls"
    }

