        reviewRangeNameDraft = String(range.name || "")
        reviewRangeStartDraft = Number(range.startSeconds || 0).toFixed(3)
        reviewRangeEndDraft = Number(range.endSeconds || 0).toFixed(3)
        reviewRangePrerollDraft = Number(range.prerollSeconds || 0).toFixed(3)
        reviewRangePostrollDraft = Number(range.postrollSeconds || 0).toFixed(3)
    }

    function saveReviewRangeDraft() {
        const start = Number(reviewRangeStartDraft || 0)
        const end = Number(reviewRangeEndDraft || 0)
        const preroll = Number(reviewRangePrerollDraft || 0)
        const postroll = Number(reviewRangePostrollDraft || 0)
        let saved = false
        if (reviewRangeEditingId.length > 0)
            saved = timelineDocument.updateReviewRange(
                        reviewRangeEditingId, reviewRangeNameDraft,
                        start, end, preroll, postroll)
        else
            saved = timelineDocument.createReviewRange(
                        reviewRangeNameDraft, start, end, preroll, postroll).length > 0
        if (saved)
            resetReviewRangeDraft()
        return saved
    }

