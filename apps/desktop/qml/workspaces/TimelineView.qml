    function fittedTransformViewScale(availableWidth, availableHeight) {
        if (!programTransformControlsVisible || !selectedVisualClipActive || sequencePlaying || fullScreenProgramActive)
            return 1
        if (sourceCropEditingActive)
            return 0.9
        const clip = currentClip
        const aspect = Math.max(0.01, Number(root.sequenceSettings.width || 1920)
                / Math.max(1, Number(root.sequenceSettings.height || 1080)))
        const sourceAspect = programSourceAspectRatio(clip)
        const fitting = String(clip.frameMode || "fit") === "fit"
        const w = fitting ? Math.min(1, sourceAspect / aspect) : 1
        const h = fitting ? Math.min(1, aspect / sourceAspect) : 1
        const scale = animatedClipValue(clip, "frameScale", clip.baseFrameScale || 1) * groupTransformScale(clip)
        const angle = (animatedClipValue(clip, "frameRotationDegrees", clip.baseFrameRotationDegrees || 0)
                + groupTransformRotation(clip)) * Math.PI / 180
        const c = Math.abs(Math.cos(angle)), r = Math.abs(Math.sin(angle))
        const groupAngle = groupTransformRotation(clip) * Math.PI / 180
        const ox = animatedClipValue(clip, "frameOffsetX", clip.baseFrameOffsetX || 0) / 4
        const oy = animatedClipValue(clip, "frameOffsetY", clip.baseFrameOffsetY || 0) / 4
        const cx = Number(clip.groupTransformOffsetX || 0) + groupTransformScale(clip)
                * (Math.cos(groupAngle) * ox - Math.sin(groupAngle) * oy / aspect)
        const cy = Number(clip.groupTransformOffsetY || 0) + groupTransformScale(clip)
                * (Math.sin(groupAngle) * ox * aspect + Math.cos(groupAngle) * oy)
        const extent = Math.max(1, scale * (c * w + r * h / aspect) + Math.abs(cx) * 2,
                                  scale * (r * w * aspect + c * h) + Math.abs(cy) * 2)
        const reserve = Math.min(0.88, Math.max(0.1, 1 - theme.scaled(72)
                / Math.max(1, Math.min(availableWidth, availableHeight))))
        return Math.max(0.05, Math.min(1, reserve / extent))
    }

