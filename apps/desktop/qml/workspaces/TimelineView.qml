    function handlePersistentRenderJobMenu(job, action) {
        const id = String(job.jobId || "")
        if (!jobQueue || id.length === 0)
            return
        if (action === "move-earlier")
            jobQueue.moveRenderJob(id, -1)
        else if (action === "move-later")
            jobQueue.moveRenderJob(id, 1)
        else if (action === "duplicate")
            jobQueue.duplicateRenderJob(id)
        else if (action === "reveal")
            jobQueue.revealJobOutput(id)
        else if (action.indexOf("resources-") === 0)
            jobQueue.setRenderResourcePolicy(id, action.slice("resources-".length))
        Qt.callLater(root.refreshBackgroundJobs)
    }

    function jumpToBackgroundJob(job) {
        if (String(job.origin || "") === "timeline") {
            if (timelineDocument.activateTimelineBackgroundJob(String(job.jobId || ""))) {
                backgroundJobsPopup.close()
                Qt.callLater(function() { timelineViewport.forceActiveFocus() })
            }
            return
        }
        const affectedType = String(job.affectedType || "")
        const affectedId = String(job.affectedId || "")
        if (affectedType === "import-source") {
            appShell.revealPath(String(job.affectedPath || affectedId))
            return
        }
        const catalogId = affectedType === "timeline"
                          ? "timeline:" + affectedId : affectedId
        if (catalogId.length > 0 && catalogAssets.selectAssetById(catalogId, true)) {
            const libraryIndex = appShell.workspaceNames.indexOf("Library")
            if (libraryIndex >= 0)
                appShell.currentWorkspace = libraryIndex
            backgroundJobsPopup.close()
            return
        }
        if (String(job.affectedPath || "").length > 0)
            appShell.revealPath(String(job.affectedPath || ""))
    }

