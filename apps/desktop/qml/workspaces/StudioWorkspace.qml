        return root.editorPreviewController.compareAdjustmentGroups.indexOf(groupKey) >= 0
    }

    function toggleCompareEditGroup(groupKey) {
        const groups = root.editorPreviewController.compareAdjustmentGroups.slice(0)
        const existingIndex = groups.indexOf(groupKey)
        if (existingIndex >= 0) {
            groups.splice(existingIndex, 1)
        } else {
            groups.push(groupKey)
        }
        root.editorPreviewController.compareAdjustmentGroups = groups
