                label: "Group",
                icon: "folder",
                description: "Organize related layers without adding permanent stack clutter.",
                tooltip: "Add a layer group."
            }
        ]
    }

    function layerAddSplitSignature() {
        const items = root.layerAddMenuItems()
        let keys = []
        let descriptions = 0
        let disabledReasons = 0
        let checked = 0
        for (let index = 0; index < items.length; ++index) {
            keys.push(String(items[index].key || ""))
            if (String(items[index].description || "").length > 0)
                descriptions += 1
            if (items[index].checked === true)
                checked += 1
            if (items[index].enabled === false && String(items[index].disabledReason || "").length > 0)
                disabledReasons += 1
        }
        return "layer-add-split:v2" +
               "|primary:adjustment" +
               "|menu:" + keys.join(",") +
               "|descriptions:" + descriptions.toString() +
               "|checked:" + checked.toString() +
               "|disabled-reasons:" + disabledReasons.toString() +
               "|one-primary:true" +
               "|permanent-fill-text:false" +
               "|readable-menu:true" +
               "|stack-clutter:false" +
               "|no-elide:true"
    }

    function placeSourceLayer(sourceUrl) {
        if (root.editBoardMode)
            return root.addDroppedImageLayer(String(sourceUrl), {x: 0.5, y: 0.5})
        if (!root.editorPreviewController.addSourceLayer(String(sourceUrl), ""))
            return false
        return root.setActivePhotoLayer(0)
    }

    function handleLayerAddMenuAction(key) {
        if (key === "paint") {
            if (root.editorPreviewController.addPaintLayer()) {
                root.setActivePhotoLayerSelection(0, false)
                root.activateEditTool("paint")
            }
        } else if (key === "pen") {
            root.startPhotoPen(-1)
        } else if (key === "shapes") {
            root.activateEditTool("shapes")
        } else if (key === "adjustment") {
            root.addAdjustmentLayerForCurrentTarget()
        } else if (key === "fill") {
            if (root.editorPreviewController.addFillLayer("#808080", ""))
                root.setActivePhotoLayer(0)
        } else if (key === "text") {
            if (root.editorPreviewController.addTextLayer("Text", ""))
                root.setActivePhotoLayer(0)
        } else if (key === "paragraph") {
            root.activateEditTool("text")
        } else if (key === "source") {
            sourceLayerDialog.open()
        } else if (key === "group") {
            const selected = root.normalizedPhotoLayerSelection()
            if (selected.length === 0) {
                if (root.editorPreviewController.addLayerGroup(""))
                    root.setActivePhotoLayer(0)
            } else {
                const first = Math.min.apply(null, selected)
                if (root.editorPreviewController.groupPhotoLayers(selected, ""))
                    root.setActivePhotoLayer(first)
            }
        }
    }

    function photoLayerIndexForId(layerId) {
        const id = String(layerId || "")
        for (let index = 0; index < root.editorPreviewController.photoLayerCount; ++index) {
            if (String((root.photoLayerRows[index] || ({})).id || "") === id)
                return index
        }
        return -1
    }

    function useActiveSelectionAsLayerMask(layerIndex, inverted) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount || !root.editorPreviewController.hasWorkingSelection)
            return false
        const layerId = String((root.photoLayerRows[index] || ({})).id || "")
        if (!root.editorPreviewController.applyWorkingSelectionToLayer(index, Boolean(inverted)))
            return false
        const resolvedIndex = root.photoLayerIndexForId(layerId)
        if (resolvedIndex >= 0)
            root.setActivePhotoLayerSelection(resolvedIndex, false)
        root.editTool = "masks"
        root.editInspectorTab = "layers"
        root.editorPreviewController.maskPreviewMode = "overlay"
        return true
    }

    function startLayerBackgroundEraser(layerIndex) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        const layerId = String((root.photoLayerRows[index] || ({})).id || "")
        const previousIds = root.photoLayerMaskSetIds(root.editorPreviewController.photoLayers[index] || ({}))
        if (!root.editorPreviewController.hasWorkingSelection)
            root.createGeneratedSelectionSource("subject")
        const resolvedIndex = root.photoLayerIndexForId(layerId)
        if (resolvedIndex < 0 || !root.useActiveSelectionAsLayerMask(resolvedIndex, false))
            return false
        const attached = root.photoLayerMaskSetIds(root.editorPreviewController.photoLayers[resolvedIndex] || ({}))
        const createdIds = attached.filter(function(id) { return previousIds.indexOf(id) < 0 })
        if (createdIds.length !== 1 || !root.selectLayerMaskTarget(resolvedIndex, createdIds[0]))
            return false
        // The attachment is now the edit target; erasing edits its coverage.
        root.activateEditTool("eraser")
        return true
    }

    function addAdjustmentLayerForCurrentTarget() {
        root.editorPreviewController.beginCoalescedEdit()
        try {
            if (!root.editorPreviewController.addAdjustmentLayer("")) return false
            if (root.editorPreviewController.hasWorkingSelection &&
                    !root.editorPreviewController.applyWorkingSelectionToLayer(0, false)) {
                root.editorPreviewController.cancelCoalescedEdit()
                return false
            }
            return root.setActivePhotoLayer(0)
        } finally {
            root.editorPreviewController.endCoalescedEdit()
        }
    }

    function layerVisibilityStateMenuItems() {
        const stateCount = root.editorPreviewController.photoLayerVisibilityStateCount
        const latestState = stateCount > 0 ? root.editorPreviewController.photoLayerVisibilityStates[stateCount - 1] : ({})
        const latestName = String(latestState.name || "Latest visibility state")
        const latestSummary = String(latestState.visibilitySummary || "")
        return [
            {
                key: "save-visibility-state",
                label: "Save Visibility State",
                icon: "source",
                enabled: root.editorPreviewController.photoLayerCount > 0,
                tooltip: "Save current layer visibility and isolation."
            },
            {
                key: "apply-visibility-state",
                label: "Apply " + latestName,
                description: latestSummary,
                icon: "check",
                enabled: stateCount > 0,
                disabledReason: "Save a visibility state first.",
                tooltip: "Restore the latest saved layer visibility state."
            },
            {
                key: "delete-visibility-state",
                label: "Delete " + latestName,
                description: latestSummary,
                icon: "delete",
                destructive: true,
                separatorBefore: true,
                enabled: stateCount > 0,
                disabledReason: "Save a visibility state first.",
                tooltip: "Delete the latest saved layer visibility state."
            }
        ]
    }

    function handleLayerVisibilityStateMenuAction(key) {
        if (key === "save-visibility-state") {
            root.editorPreviewController.savePhotoLayerVisibilityState("")
        } else if (key === "apply-visibility-state") {
            if (root.editorPreviewController.photoLayerVisibilityStateCount > 0)
                root.editorPreviewController.applyPhotoLayerVisibilityState(root.editorPreviewController.photoLayerVisibilityStateCount - 1)
        } else if (key === "delete-visibility-state") {
            if (root.editorPreviewController.photoLayerVisibilityStateCount > 0)
                root.editorPreviewController.deletePhotoLayerVisibilityState(root.editorPreviewController.photoLayerVisibilityStateCount - 1)
        }
    }

    function photoLayerCanMoveIntoGroup(layerIndex, groupIndex) {
        const rows = root.photoLayerRows || []
        const sourceIndex = Math.floor(Number(layerIndex))
        const targetIndex = Math.floor(Number(groupIndex))
        if (sourceIndex < 0 || sourceIndex >= rows.length ||
                targetIndex < 0 || targetIndex >= rows.length || sourceIndex === targetIndex)
            return false
        const source = rows[sourceIndex] || ({})
        const target = rows[targetIndex] || ({})
        if (source.baseImageEdit === true || source.locked === true || target.locked === true ||
                String(target.kind || "") !== "group")
            return false
        const sourceId = String(source.id || "")
        const targetId = String(target.id || "")
        if (sourceId.length === 0 || targetId.length === 0 ||
                String(source.parentId || "") === targetId)
            return false
        let parentId = targetId
        let guard = 0
        while (parentId.length > 0 && guard < rows.length) {
            if (parentId === sourceId)
                return false
            const parentIndex = root.photoLayerIndexForId(parentId)
            if (parentIndex < 0)
                break
            parentId = String((rows[parentIndex] || ({})).parentId || "")
            ++guard
        }
        return true
    }

    function photoLayerCanMoveOutOfGroup(layerIndex) {
        const rows = root.photoLayerRows || []
        const sourceIndex = Math.floor(Number(layerIndex))
        if (sourceIndex < 0 || sourceIndex >= rows.length)
            return false
        const source = rows[sourceIndex] || ({})
        const parentId = String(source.parentId || "")
        if (parentId.length === 0 || source.locked === true)
            return false
        const parentIndex = root.photoLayerIndexForId(parentId)
        if (parentIndex < 0)
            return false
        const parent = rows[parentIndex] || ({})
        if (String(parent.kind || "") !== "group" || parent.locked === true)
            return false
        const destinationParentId = String(parent.parentId || "")
        if (destinationParentId.length === 0)
            return true
        const destinationIndex = root.photoLayerIndexForId(destinationParentId)
        if (destinationIndex < 0)
            return false
        const destination = rows[destinationIndex] || ({})
        return String(destination.kind || "") === "group"
                && destination.locked !== true
    }

    function photoLayerGroupDropTargetAtPointer(sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater) {
        if (!pointerItem || !rowsRepeater)
            return -1
        const pointer = pointerItem.mapToItem(root, pointerX, pointerY)
        for (let index = 0; index < rowsRepeater.count; ++index) {
            if (!root.photoLayerCanMoveIntoGroup(sourceIndex, index))
                continue
            const row = rowsRepeater.itemAt(index)
            if (!row || !row.visible)
                continue
            const topLeft = row.mapToItem(root, 0, 0)
            if (pointer.x >= topLeft.x && pointer.x <= topLeft.x + row.width &&
                    pointer.y >= topLeft.y + row.height * 0.2 &&
                    pointer.y <= topLeft.y + row.height * 0.8)
                return index
        }
        return -1
    }

    function photoLayerDragDestination(sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater) {
        const none = { groupIndex: -1, markerIndex: -1, after: false, offset: 0 }
        if (!pointerItem || !rowsRepeater || sourceIndex < 0 ||
                (root.photoLayerRows[sourceIndex] || ({})).locked === true)
            return none
        const groupIndex = root.photoLayerGroupDropTargetAtPointer(
                    sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater)
        if (groupIndex >= 0)
            return { groupIndex: groupIndex, markerIndex: -1, after: false, offset: 0 }
        const pointer = pointerItem.mapToItem(root, pointerX, pointerY)
        const rows = root.photoLayerRows || []
        const parentId = String((rows[sourceIndex] || ({})).parentId || "")
        const siblings = []
        for (let index = 0; index < rows.length; ++index)
            if (String((rows[index] || ({})).parentId || "") === parentId)
                siblings.push(index)
        const sourcePosition = siblings.indexOf(sourceIndex)
        if (sourcePosition < 0)
            return none
        let destination = siblings.length - 1
        for (let position = 0; position < siblings.length; ++position) {
            const index = siblings[position]
            const row = rowsRepeater.itemAt(index)
            if (index === sourceIndex || !row || !row.visible)
                continue
            const middle = row.mapToItem(root, 0, row.height / 2)
            if (pointer.y < middle.y) {
                destination = position - (position > sourcePosition ? 1 : 0)
                break
            }
        }
        if (destination === sourcePosition)
            return none
        let markerIndex = siblings[destination]
        const after = destination > sourcePosition
        if (after && String((rows[markerIndex] || ({})).kind || "") === "group") {
            // Moving below a group inserts after its entire subtree.
            const groupId = String(rows[markerIndex].id || "")
            for (let index = markerIndex + 1; index < rows.length; ++index) {
                let ancestorId = String((rows[index] || ({})).parentId || "")
                let guard = 0
                while (ancestorId.length > 0 && ancestorId !== groupId && guard++ < rows.length) {
                    const ancestorIndex = root.photoLayerIndexForId(ancestorId)
                    ancestorId = ancestorIndex >= 0 ? String(rows[ancestorIndex].parentId || "") : ""
                }
                const row = rowsRepeater.itemAt(index)
                if (ancestorId === groupId && row && row.visible)
                    markerIndex = index
            }
        }
        return { groupIndex: -1, markerIndex: markerIndex, after: after,
                 offset: destination - sourcePosition }
    }

    function clearPhotoLayerDropIndicator() {
        root.photoLayerHierarchyDropTargetIndex = -1
        root.photoLayerReorderDropTargetIndex = -1
    }

    function updatePhotoLayerHierarchyDropTarget(sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater) {
        const destination = root.photoLayerDragDestination(sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater)
        root.photoLayerHierarchyDropTargetIndex = destination.groupIndex
        root.photoLayerReorderDropAfter = destination.after
        root.photoLayerReorderDropTargetIndex = destination.markerIndex
    }

    function finishPhotoLayerDrag(sourceIndex, sourceRow, pointerItem, pointerX, pointerY, dragProxy, rowsRepeater) {
        if (!sourceRow.reorderDragActive) {
            root.clearPhotoLayerDropIndicator()
            dragProxy.y = 0
            return false
        }
        const destination = root.photoLayerDragDestination(sourceIndex, pointerItem, pointerX, pointerY, rowsRepeater)
        const groupIndex = destination.groupIndex
        const offset = destination.offset
        const sourceId = String((root.photoLayerRows[sourceIndex] || ({})).id || "")
        const groupId = groupIndex >= 0
                        ? String((root.photoLayerRows[groupIndex] || ({})).id || "") : ""
        root.clearPhotoLayerDropIndicator()
        dragProxy.y = 0
        sourceRow.reorderDragActive = false
        if (groupIndex >= 0 && root.editorPreviewController.movePhotoLayerIntoGroup(sourceIndex, groupIndex)) {
            const expandedGroupIndex = root.photoLayerIndexForId(groupId)
            if (expandedGroupIndex >= 0)
                root.editorPreviewController.setPhotoLayerGroupExpanded(expandedGroupIndex, true)
            const movedLayerIndex = root.photoLayerIndexForId(sourceId)
            if (movedLayerIndex >= 0)
                root.setActivePhotoLayerSelection(movedLayerIndex, false)
            return true
        }
        if (offset !== 0)
            return root.movePhotoLayerPreservingSelection(sourceIndex, offset)
        return false
    }

