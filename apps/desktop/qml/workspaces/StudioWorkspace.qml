    function libraryEmptyStateTitle() {
        if (catalogAssets.errorMessage.length > 0)
            return "Library Error"
        if (catalogAssets.loading)
            return "Loading Library"
        if (catalogAssets.totalAssetCount === 0)
            return "No Media Yet"
        if (catalogAssets.assetCount === 0)
            return "No Results"
        return ""
    }

    function libraryEmptyStateMessage() {
        if (catalogAssets.errorMessage.length > 0)
            return catalogAssets.errorMessage
        if (catalogAssets.loading)
            return "Catalog metadata and previews are still being prepared."
        if (catalogAssets.totalAssetCount === 0)
            return "Import a folder or connect a local source to begin building the library."
        if (catalogAssets.assetCount === 0)
            return "No assets match the current filters. Clear filters or broaden the search."
        return ""
    }

    function editEmptyStateTitle() {
        if (!editorPreview.hasAsset)
            return "No Photo Selected"
        return ""
    }

    function editEmptyStateMessage() {
        if (!editorPreview.hasAsset)
            return "Select a photo in Library or open a local image to start editing."
        return ""
    }

    function exportEmptyStateTitle() {
        if (catalogAssets.selectedAssetCount === 0 && catalogAssets.assetCount === 0)
            return "Nothing To Export"
        return ""
    }

    function exportEmptyStateMessage() {
        if (catalogAssets.selectedAssetCount === 0 && catalogAssets.assetCount === 0)
            return "Select assets in Library or add files before starting an export queue."
        return ""
    }

    function signedPercent(value) {
        const rounded = Math.round(Number(value || 0))
        if (rounded > 0)
            return "+" + rounded + "%"
        return rounded + "%"
    }

    function exposureText(value) {
        const number = Number(value || 0)
        return (number >= 0 ? "+" : "") + number.toFixed(2) + " EV"
    }

    function whiteBalanceKelvin(value) {
        const clamped = clamp(Number(value || 0), -100, 100)
        if (clamped >= 0)
            return Math.round(5500 + (12000 - 5500) * (clamped / 100))
        return Math.round(5500 + (2000 - 5500) * (-clamped / 100))
    }

    function inspectorTabTitle(tabKey) {
        if (tabKey === "presets")
            return "Presets"
        if (tabKey === "crop")
            return "Crop"
        if (tabKey === "layers")
            return "Layers"
        if (tabKey === "scopes")
            return "Scopes"
        if (tabKey === "info")
            return "Info"
        return "Adjust"
    }

    function assetAt(index) {
        if (!catalogAssets || index < 0 || index >= catalogAssets.assetCount)
            return ({})
        return catalogAssets.assetAt(index)
    }

    function assetName(index) {
        const asset = assetAt(index)
        const path = String(asset.filePath || "")
        if (path.length > 0) {
            const parts = path.split("/")
            return parts.length > 0 ? parts[parts.length - 1] : path
        }
        const fallback = String(asset.assetId || "")
        return fallback.length > 0 ? fallback : "Untitled"
    }

    function assetThumb(index) {
        const asset = assetAt(index)
        const thumb = String(asset.thumbnailSource || "")
        if (thumb.length > 0)
            return thumb
        return ""
    }

    function assetThumbCacheable(index) {
        const asset = assetAt(index)
        return String(asset.thumbnailSource || "").length > 0
    }

    function assetRating(index) {
        const asset = assetAt(index)
        return Math.max(0, Math.min(5, Number(asset.rating || 0)))
    }

    function assetPicked(index) {
        const asset = assetAt(index)
        return Boolean(asset.picked)
    }

    function assetRejected(index) {
        const asset = assetAt(index)
        return Boolean(asset.rejected)
    }

    function assetMetadataLine(index) {
        const asset = assetAt(index)
        const parts = []
        const captureDate = String(asset.captureDate || "")
        const cameraLabel = String(asset.cameraLabel || "")
        const lensModel = String(asset.lensModel || "")
        if (captureDate.length > 0)
            parts.push(captureDate)
        if (cameraLabel.length > 0)
            parts.push(cameraLabel)
        if (lensModel.length > 0 && lensModel !== cameraLabel)
            parts.push(lensModel)
        return parts.length > 0 ? parts.join("  -  ") : "Metadata pending"
    }

    function selectedMetadataRows() {
        const rows = []
        function add(label, value) {
            const text = String(value || "")
            if (text.length > 0)
                rows.push([label, text])
        }
        add("Camera", catalogAssets.selectedCameraLabel)
        add("Lens", catalogAssets.selectedLensModel)
        add("Captured", catalogAssets.selectedCaptureDate)
        add("ISO", catalogAssets.selectedIso)
        add("Shutter", catalogAssets.selectedShutterSpeed)
        add("Aperture", catalogAssets.selectedAperture)
        add("Imported", catalogAssets.selectedImportedAt)
        add("Project", catalogAssets.selectedProjectSummary)
        add("Path", catalogAssets.selectedFilePath)
        if (rows.length === 0)
            rows.push(["Metadata", "Pending"])
        return rows
    }

    function mediaFilterLabel() {
        if (catalogAssets.mediaTypeFilter === "photos")
            return "Photos"
        if (catalogAssets.mediaTypeFilter === "videos")
            return "Videos"
        if (catalogAssets.mediaTypeFilter === "timelines")
