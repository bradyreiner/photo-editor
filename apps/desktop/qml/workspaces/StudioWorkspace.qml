    function saveStudioPreset() {
        const name = studioPresetDraftName.trim()
        if (name.length === 0)
            return false
        const pack = studioPresetDraftPack.trim().length > 0 ? studioPresetDraftPack.trim() : "User Presets"
        if (editorPreview.savePresetToPack(name, pack, true)) {
