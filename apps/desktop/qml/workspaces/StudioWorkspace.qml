            root.editorPreviewController.activeMaskCloneScale = root.editorPreviewController.activeMaskCloneScale - 0.1
        } else if (key === "clone-scale-up") {
            root.editorPreviewController.activeMaskCloneScale = root.editorPreviewController.activeMaskCloneScale + 0.1
        } else if (key === "clone-rotate-left") {
            root.editorPreviewController.activeMaskCloneRotation = root.editorPreviewController.activeMaskCloneRotation - 15
        } else if (key === "clone-rotate-right") {
            root.editorPreviewController.activeMaskCloneRotation = root.editorPreviewController.activeMaskCloneRotation + 15
        } else if (key.indexOf("clone-source-") === 0) {
            root.editorPreviewController.selectActiveCloneSource(Number(key.substring(13)))
        } else if (key.indexOf("variation-") === 0) {
            root.editorPreviewController.activeInpaintCandidateIndex = Number(key.substring(10))
        } else if (key === "reset-selection") {
            root.editorPreviewController.resetActiveRetouchSelection()
        } else if (key === "cancel") {
            root.editorPreviewController.cancelActiveRetouch()
        } else if (key === "discard") {
            root.editorPreviewController.discardActiveRetouch()
        } else if (key === "reopen-selection") {
            root.editorPreviewController.reopenActiveRetouchSelection()
        } else if (key === "delete-patch") {
            root.editorPreviewController.deleteActiveRetouchPatch()
