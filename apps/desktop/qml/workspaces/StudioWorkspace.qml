    function usesSignedColorGrading() {
        const model = root.editorPreviewController.renderingUpgradePreviewActive
                    ? root.editorPreviewController.renderingUpgradeTargetModel
                    : root.editorPreviewController.currentPhotographicRenderingModel
        return String(model) === "aces2-ocio-v1"
