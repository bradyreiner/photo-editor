            "presets": "preset presets look pack style custom looksy built in apply save"
        }
        return String(searchable[groupKey] || groupKey).toLowerCase()
    }

    function adjustmentIntentGroupKeys(intent) {
        const key = String(intent || "all").trim().toLowerCase()
        if (key === "light")
            return ["raw", "light", "tone-curve", "levels"]
        if (key === "color")
            return ["white-balance", "color", "color-mix", "color-grading", "advanced-color"]
        if (key === "detail")
            return ["presence", "detail", "lens-transform"]
        return ["raw", "white-balance", "light", "tone-curve", "levels", "color", "color-mix", "color-grading",
                "presence", "detail", "lens-transform", "advanced-color"]
    }

    function normalizedAdjustmentGroupKey(groupKey) {
        const key = String(groupKey || "").trim().toLowerCase()
        return key === "lens" ? "lens-transform" : key
    }

    function adjustmentIntentForGroup(groupKey) {
        const key = normalizedAdjustmentGroupKey(groupKey)
        if (["white-balance", "color", "color-mix", "color-grading", "advanced-color",
             "hsl", "grading", "lut"].indexOf(key) >= 0)
            return "color"
        if (["presence", "detail", "lens-transform"].indexOf(key) >= 0)
            return "detail"
        return "light"
    }

    function expandAdjustmentControls() {
        lightAdvancedToneExpanded = true
        lightZonesExpanded = true
        curveParametricExpanded = true
        channelMixerExpanded = true
        blackWhiteExpanded = true
        colorReplaceExpanded = true
        skinToneExpanded = true
        harmonyExpanded = true
    }

    function adjustmentGroupMatches(groupKey) {
        const key = normalizedAdjustmentGroupKey(groupKey)
        if (adjustmentIntentGroupKeys(activeAdjustmentIntent).indexOf(key) < 0)
            return false
        const needle = editAdjustmentFilterNeedle()
        if (needle.length === 0)
            return true
        return adjustmentGroupSearchText(key).indexOf(needle) >= 0
    }

    function adjustmentGroupFilterText(groupKey) {
        const key = String(groupKey || "").trim().toLowerCase()
        if (key === "white-balance")
            return "white balance"
        if (key === "tone-curve")
            return "tone curve"
        if (key === "color-grading")
            return "color grading"
        if (key === "hsl")
            return "hsl"
        if (key === "grading")
            return "grading"
        if (key === "lut")
            return "lut"
        if (key === "lens-transform")
            return "lens transform"
        return key
    }

    function adjustmentGroupEditStack(groupKey) {
        const key = String(groupKey || "").trim().toLowerCase()
        if (key === "tone-curve")
            return "curve"
        if (key === "hsl")
            return "hsl"
        if (key === "grading" || key === "lut" || key === "color")
            return "color"
        if (key === "detail")
            return "detail"
        if (key === "lens-transform")
            return "lens"
        return "adjustments"
    }

    function studioCurrentPresetName() {
        if (studioSelectedPresetName.length > 0 && root.editorPreviewController.presetNames.indexOf(studioSelectedPresetName) >= 0)
            return studioSelectedPresetName
        if (root.editorPreviewController.presetNames.length > 0)
            return root.editorPreviewController.presetNames[0]
        return ""
    }

    function selectStudioPreset(name) {
        const nextName = String(name || "")
        if (studioPresetPreviewPinned && studioPresetPreviewName !== nextName)
            root.clearStudioPresetPreview()
        studioSelectedPresetName = nextName
        studioPresetDraftName = studioSelectedPresetName
        const pack = root.editorPreviewController.presetPackName(studioSelectedPresetName)
        studioPresetDraftPack = pack.length > 0 ? pack : "User Presets"
    }

    function studioPresetMetaText() {
        const name = studioCurrentPresetName()
        if (name.length === 0)
            return "No presets available"
        const pack = root.editorPreviewController.presetPackName(name)
        const category = root.editorPreviewController.presetCategoryName(name)
        return (pack.length > 0 ? pack : "User Presets") + (category.length > 0 ? " / " + category : "")
    }

    function studioPresetLibraryNames() {
        // Invokable catalog queries need an explicit notify dependency.
        const revision = studioPresetLibraryRevision
        const names = root.editorPreviewController.searchPresetNames(studioPresetSearchText).slice()
        const filtered = []
        for (let index = 0; index < names.length; ++index) {
            const name = names[index]
            if (studioPresetLibraryTab === "Favorites" && !root.editorPreviewController.isPresetFavorite(name))
                continue
            if (studioPresetLibraryTab === "My Presets" && !root.editorPreviewController.isUserPreset(name))
                continue
            if (studioPresetFavoritesOnly && !root.editorPreviewController.isPresetFavorite(name))
                continue
            if (studioPresetCategoryFilter !== "All" && root.editorPreviewController.presetCategoryName(name) !== studioPresetCategoryFilter)
                continue
            if (studioPresetPackFilter !== "All" && root.editorPreviewController.presetPackName(name) !== studioPresetPackFilter)
                continue
            filtered.push(name)
        }
        filtered.sort(function(left, right) {
            const leftPack = root.editorPreviewController.presetPackName(left)
            const rightPack = root.editorPreviewController.presetPackName(right)
            if (leftPack !== rightPack)
                return leftPack.localeCompare(rightPack)
            const leftCategory = root.editorPreviewController.presetCategoryName(left)
            const rightCategory = root.editorPreviewController.presetCategoryName(right)
            if (leftCategory !== rightCategory)
                return leftCategory.localeCompare(rightCategory)
            return left.localeCompare(right)
        })
        return filtered
    }

    function studioPresetLibraryRows() {
        const names = studioPresetLibraryNames()
        const rows = []
        let currentPack = ""
        let currentPackCount = 0
        for (let index = 0; index < names.length; ++index) {
            const name = names[index]
            const pack = root.editorPreviewController.presetPackName(name).length > 0 ? root.editorPreviewController.presetPackName(name) : "User Presets"
            if (pack !== currentPack) {
                currentPack = pack
                currentPackCount = 0
                for (let countIndex = 0; countIndex < names.length; ++countIndex) {
                    const countPack = root.editorPreviewController.presetPackName(names[countIndex]).length > 0 ? root.editorPreviewController.presetPackName(names[countIndex]) : "User Presets"
                    if (countPack === pack)
                        ++currentPackCount
                }
                rows.push({ kind: "pack", label: pack, count: currentPackCount })
            }
            rows.push({ kind: "preset", name: name })
        }
        return rows
    }

    function studioPresetCategoryFilters() {
        const filters = ["All"]
        const categories = root.editorPreviewController.presetCategoryNames
        for (let index = 0; index < categories.length; ++index)
            filters.push(categories[index])
        return filters
    }

    function studioPresetPackFilters() {
        const filters = ["All"]
        const packs = root.editorPreviewController.presetPackNames
        for (let index = 0; index < packs.length; ++index)
            filters.push(packs[index])
        return filters
    }

    function studioPresetFilterLabel(value) {
        if (value === "All")
            return "All"
        return value
    }

    function studioPresetTypeText(name) {
        if (String(name || "").length === 0)
            return ""
        return root.editorPreviewController.isUserPreset(name) ? "Custom" : "Looksy"
    }

    function previewStudioPreset(name, pinPreview) {
        const presetName = String(name || "")
        const pinned = pinPreview === true
        if (!pinned && studioPresetPreviewPinned)
            return false
        if (presetName.length === 0) {
            root.clearStudioPresetPreview()
            return false
        }
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (!root.editorPreviewController.previewPreset(presetName, layerIndex, [], root.editorPreviewController.presetIntensity)) {
            studioPresetPreviewName = ""
            studioPresetPreviewPinned = false
            return false
        }
        studioPresetPreviewName = presetName
        studioPresetPreviewPinned = pinned
        return true
    }

    function clearStudioPresetHoverPreview() {
        if (!studioPresetPreviewPinned)
            root.clearStudioPresetPreview()
    }

    function clearStudioPresetPreview() {
        root.editorPreviewController.clearPresetPreview()
        studioPresetPreviewName = ""
        studioPresetPreviewPinned = false
    }

    function applyStudioPreset() {
        const name = studioCurrentPresetName()
        if (name.length === 0)
            return false
        selectStudioPreset(name)
        root.clearStudioPresetPreview()
        return root.routePrimaryPresetCommand(name, "base-image,adjustment-layer")
    }

    function resetCurrentEdit() {
        if (root.resetEditHandler) {
            if (!root.resetEditHandler()) return
        } else {
            if (root.editorPreviewController.selectionEditSessionActive &&
                    (root.editorPreviewController.selectionEditSessionDirty || !root.editorPreviewController.finishSelectionEditSession())) return
            if (!root.resolveTextSession()) return
            if (root.editBoardMode) root.editorPreviewController.resetAdjustments()
            else if (!root.editorPreviewController.revertPhotoToOriginal()) return
        }
        if (root.editViewportHandle) root.editViewportHandle.resetView()
    }

    function saveStudioPreset() {
        studioPresetCreateMode = "capture"
        studioPresetCreateSource = root.activeAdjustmentLayerIndex() >= 0 ? "selected-layer" : "base-image"
        if (studioPresetCreateSource === "selected-layer")
            setStudioPresetCreateSource("selected-layer")
        if (!root.editorPreviewController.isUserPreset(root.studioCurrentPresetName()))
            studioPresetDraftPack = "User Presets"
        studioPresetCreateFeedback = ""
        studioPresetCreateDialog.open()
        return true
    }

    function openStudioPresetCreator() {
        return saveStudioPreset()
    }

    function submitStudioPresetCreator(updateSelected) {
        return createStudioPreset(updateSelected === true)
    }

    function openStudioPresetDuplicateDialog() {
        if (studioCurrentPresetName().length === 0)
            return false
        studioPresetCreateMode = "duplicate"
        studioPresetDraftName = uniqueStudioPresetCopyName(studioCurrentPresetName())
        studioPresetDraftPack = root.editorPreviewController.presetPackName(studioCurrentPresetName()) || "User Presets"
        studioPresetCreateFeedback = ""
        studioPresetCreateDialog.open()
        return true
    }

    function uniqueStudioPresetCopyName(sourceName) {
        const base = String(sourceName || "My Preset").trim() || "My Preset"
        return uniqueStudioPresetName(base + " Copy")
    }

    function uniqueStudioPresetName(base) {
        let candidate = base
        let suffix = 2
        while (root.editorPreviewController.presetNames.indexOf(candidate) >= 0) {
            candidate = base + " " + suffix
            ++suffix
        }
        return candidate
    }

    function toggleStudioPresetScope(group) {
        const next = studioPresetScopeSelection.slice()
        const index = next.indexOf(group)
        if (index >= 0)
            next.splice(index, 1)
        else
            next.push(group)
        studioPresetScopeSelection = next
    }

    function setStudioPresetCreateSource(source) {
        studioPresetCreateSource = source
        if (source === "selected-layer") {
            studioPresetScopeSelection = studioPresetScopeSelection.filter(function(group) {
                return group === "tone" || group === "color" || group === "detail"
            })
        }
    }

    function createStudioPreset(updateSelected) {
        let name = studioPresetDraftName.trim()
        const pack = studioPresetDraftPack.trim()
        if (updateSelected) {
            const selectedName = root.studioCurrentPresetName()
            if (selectedName.length === 0 || !root.editorPreviewController.isUserPreset(selectedName)) {
                studioPresetCreateFeedback = "Choose a custom preset before updating it."
                studioPresetCreateFeedbackError = true
                return false
            }
            name = selectedName
        }
        if (name.length === 0) {
            studioPresetCreateFeedback = "Add a name for this preset."
            studioPresetCreateFeedbackError = true
            return false
        }
        if (pack.length === 0) {
            studioPresetCreateFeedback = "Add a pack name."
            studioPresetCreateFeedbackError = true
            return false
        }
        if (studioPresetCreateMode === "capture" && studioPresetScopeSelection.length === 0) {
            studioPresetCreateFeedback = "Choose at least one adjustment group."
            studioPresetCreateFeedbackError = true
            return false
        }
        let result = null
        if (studioPresetCreateMode === "duplicate") {
            result = root.editorPreviewController.duplicatePreset(root.studioCurrentPresetName(), name, pack)
        } else {
            const layerIndex = studioPresetCreateSource === "selected-layer" ? root.activeAdjustmentLayerIndex() : -1
            if (studioPresetCreateSource === "selected-layer" && layerIndex < 0) {
                studioPresetCreateFeedback = "Select an adjustment layer before capturing its settings."
                studioPresetCreateFeedbackError = true
                return false
            }
            result = root.editorPreviewController.saveCustomPreset(name, pack, studioPresetScopeSelection, layerIndex, updateSelected)
        }
        if (!result || result.ok !== true) {
            studioPresetCreateFeedback = result && result.error ? String(result.error) : "Could not save this preset."
            studioPresetCreateFeedbackError = true
            return false
        }
        selectStudioPreset(String(result.name || name))
        studioPresetLibraryTab = "My Presets"
        studioPresetSearchText = ""
        studioPresetCategoryFilter = "All"
        studioPresetPackFilter = "All"
        studioPresetFavoritesOnly = false
        studioPresetCreateFeedback = updateSelected ? "Preset updated." : "Preset saved to " + String(result.pack || pack) + "."
        studioPresetCreateFeedbackError = false
        return true
    }

    function toggleStudioPresetFavorite(name) {
        const presetName = String(name || "")
        if (presetName.length === 0)
            return false
        root.editorPreviewController.setPresetFavorite(presetName, !root.editorPreviewController.isPresetFavorite(presetName))
        return true
    }

    function renameStudioPreset() {
        const oldName = studioCurrentPresetName()
        const newName = studioPresetDraftName.trim()
        if (oldName.length === 0 || newName.length === 0 || !root.editorPreviewController.isUserPreset(oldName))
            return false
        if (root.editorPreviewController.renamePreset(oldName, newName)) {
            selectStudioPreset(newName)
            return true
        }
        return false
    }

    function moveStudioPresetToPack() {
        const name = studioCurrentPresetName()
        const pack = studioPresetDraftPack.trim().length > 0 ? studioPresetDraftPack.trim() : "User Presets"
        if (name.length === 0 || !root.editorPreviewController.isUserPreset(name))
            return false
        return root.editorPreviewController.movePresetToPack(name, pack)
    }

    function deleteStudioPreset() {
        const name = studioCurrentPresetName()
        if (name.length === 0 || !root.editorPreviewController.isUserPreset(name))
            return false
        if (root.editorPreviewController.deletePreset(name)) {
            const names = root.editorPreviewController.presetNames
            selectStudioPreset(names.length > 0 ? names[0] : "")
            return true
        }
        return false
    }

    function exportStudioPresetBundle() {
        const folder = studioPresetExportFolder.trim()
        if (folder.length === 0)
            return false
        return root.editorPreviewController.exportPresetSyncBundle(folder)
    }

    function importStudioPresetBundle() {
        const folder = studioPresetImportFolder.trim()
        if (folder.length === 0)
            return false
        return root.editorPreviewController.importPresetSyncBundle(folder, true)
    }

    function wrapUnit(value) {
        const wrapped = value - Math.floor(value)
        return wrapped < 0 ? wrapped + 1 : wrapped
    }

    function harmonyAnchorHues(mode, baseHue) {
        const base = wrapUnit(baseHue)
        if (mode === "Analogous")
            return [wrapUnit(base - 1 / 12), base, wrapUnit(base + 1 / 12)]
        if (mode === "Triadic")
            return [base, wrapUnit(base + 1 / 3), wrapUnit(base + 2 / 3)]
        if (mode === "Split Complementary")
            return [base, wrapUnit(base + 5 / 12), wrapUnit(base + 7 / 12)]
        if (mode === "Tetradic")
            return [base, wrapUnit(base + 0.25), wrapUnit(base + 0.5), wrapUnit(base + 0.75)]
        return [base, wrapUnit(base + 0.5)]
    }

    function harmonyRangeHues(mode, baseHue) {
        const anchors = harmonyAnchorHues(mode, baseHue)
        const range = []
        for (let i = 0; i < anchors.length; ++i) {
            range.push(wrapUnit(anchors[i] - 1 / 36))
            range.push(anchors[i])
            range.push(wrapUnit(anchors[i] + 1 / 36))
        }
        return range
    }

    function hueSwatchColor(hue) {
        // Keep swatches on the same display sRGB wheel reported by ColorWheelControl.
        return Qt.hsla(wrapUnit(hue), 0.72, 0.58, 1)
    }

    function colorMixerResponseName(model) {
        if (model === "HSV")
            return "Gentle"
        if (model === "LCH")
            return "Soft"
        return "Standard"
    }

    function colorMixerResponseModel(responseName) {
        if (responseName === "Gentle")
            return "HSV"
        if (responseName === "Soft")
            return "LCH"
        return "OKLab"
    }

    function colorMixerResponseDescription(responseName) {
        if (responseName === "Gentle")
            return "Lower hue, color, and lightness response."
        if (responseName === "Soft")
            return "Lower color response with a softer lightness change."
        return "Balanced channel response."
    }

    function applyHarmonyPreset(name) {
        if (name === "Warm Analogous") {
            root.setPrimaryBoolAdjustmentValue("colorHarmonyEnabled", true)
            root.setPrimaryStringAdjustmentValue("colorHarmonyMode", "Analogous")
            root.setPrimaryAdjustmentValue("colorHarmonyBaseHue", 0.08)
            root.setPrimaryAdjustmentValue("colorHarmonyStrength", 35)
            return true
        }
        if (name === "Cool Triad") {
            root.setPrimaryBoolAdjustmentValue("colorHarmonyEnabled", true)
            root.setPrimaryStringAdjustmentValue("colorHarmonyMode", "Triadic")
            root.setPrimaryAdjustmentValue("colorHarmonyBaseHue", 0.56)
            root.setPrimaryAdjustmentValue("colorHarmonyStrength", 32)
            return true
        }
        if (name === "Soft Complement") {
            root.setPrimaryBoolAdjustmentValue("colorHarmonyEnabled", true)
            root.setPrimaryStringAdjustmentValue("colorHarmonyMode", "Complementary")
            root.setPrimaryAdjustmentValue("colorHarmonyBaseHue", 0.08)
            root.setPrimaryAdjustmentValue("colorHarmonyStrength", 28)
            return true
        }
        return false
    }

    function rawUnavailableReason() {
        return "RAW controls require a RAW source; this asset is a rendered image."
    }

    function modelUnavailableReason(modelKey) {
        const status = String(root.editorPreviewController.aiModelStatus || "Model runtime unavailable")
        if (modelKey === "smart-selection" && !root.editorPreviewController.aiSmartSelectionAvailable)
            return "Model-backed smart selection is not active in this build; " +
                    root.editorPreviewController.smartSelectionRuntimeLabel + " is active: " + status
        if (modelKey === "inpaint" && !root.editorPreviewController.aiInpaintAvailable)
            return "LaMa Model Inpaint is not active in this build; retouch will use " +
                    root.editorPreviewController.inpaintRuntimeLabel + ": " + status
        return ""
    }

    function profileUnavailableReason(profileKey) {
        if (profileKey === "camera-input" && !root.editorPreviewController.rawControlsAvailable)
            return "Camera input profiles require RAW data; rendered images keep their embedded profile."
        if (profileKey === "soft-proof" && !root.editorPreviewController.softProofEnabled)
            return "Enable soft proofing before choosing a proof profile."
        return ""
    }

    function disabledCapabilityReason(capabilityKey) {
        const key = String(capabilityKey || "")
        if (key === "raw")
            return root.editorPreviewController.rawControlsAvailable ? "" : rawUnavailableReason()
        if (key === "model-smart-selection")
            return modelUnavailableReason("smart-selection")
        if (key === "model-inpaint")
            return modelUnavailableReason("inpaint")
        if (key === "profile-camera-input")
            return profileUnavailableReason("camera-input")
        if (key === "profile-soft-proof")
            return profileUnavailableReason("soft-proof")
        return ""
    }

    function disabledCapabilityReasonSignature() {
        const keys = ["raw", "model-smart-selection", "model-inpaint", "profile-camera-input", "profile-soft-proof"]
        return keys.map(function(key) {
            const reason = disabledCapabilityReason(key)
            return key + ":" + (reason.length > 0 ? "disabled:" + reason : "enabled")
        }).join("|")
    }

    function filteredAdjustmentGroupKeys() {
        const keys = adjustmentIntentGroupKeys(activeAdjustmentIntent)
        return keys.filter(function(key) {
            return adjustmentGroupMatches(key) && (key !== "raw" || root.editorPreviewController.rawControlsAvailable)
        })
    }

    function editAdjustmentFilterStatusText() {
        const count = filteredAdjustmentGroupKeys().length
        if (editAdjustmentFilterNeedle().length > 0 && adjustmentGroupMatches("raw") && !root.editorPreviewController.rawControlsAvailable)
            return rawUnavailableReason()
        return count > 0 ? count + " matching adjustment groups" : "No matching adjustment groups"
    }

    function editAdjustmentFilterSignature() {
        return "query:" + editAdjustmentFilterNeedle()
                + "|intent:" + activeAdjustmentIntent
                + "|count:" + filteredAdjustmentGroupKeys().length
                + "|groups:" + filteredAdjustmentGroupKeys().join(",")
    }

    function rawControlAvailabilitySignature() {
        const rawGroups = filteredAdjustmentGroupKeys().filter(function(key) {
            return key === "raw"
        })
        const rawGroupVisible = root.editInspectorTab === "adjust"
                && root.editorPreviewController.rawControlsAvailable
                && root.adjustmentGroupMatches("raw")
        return "available:" + String(Boolean(root.editorPreviewController.rawControlsAvailable))
                + "|rawGroups:" + rawGroups.length
                + "|groupVisible:" + String(Boolean(rawGroupVisible))
    }

    function hslChannelShortLabel(channelName) {
        const labels = {
            "Reds": "Red",
            "Oranges": "Org",
            "Yellows": "Yel",
            "Greens": "Grn",
            "Aquas": "Aqu",
            "Blues": "Blu",
            "Purples": "Pur",
            "Magentas": "Mag"
        }
        const name = String(channelName || "")
        return labels[name] || name.slice(0, 3)
    }

    function hslChannelTooltip(channelName) {
        const name = String(channelName || "")
        return name.length > 0 ? name + " color mix channel." : "Color mix channel."
    }

    function hslChannelColor(channelName) {
        const colors = {
            "Reds": "#F25A5A",
            "Oranges": "#F39B45",
            "Yellows": "#E3C84B",
            "Greens": "#5CCB73",
            "Aquas": "#4BD1C9",
            "Blues": "#4D91F0",
            "Purples": "#9B75F0",
            "Magentas": "#E05AC8"
        }
        const name = String(channelName || "")
        return colors[name] || root.mint
    }

    function hslChannelRangeColors(channelName) {
        const channels = ["Reds", "Oranges", "Yellows", "Greens", "Aquas", "Blues", "Purples", "Magentas"]
        const index = Math.max(0, channels.indexOf(String(channelName || "")))
        const previous = channels[(index + channels.length - 1) % channels.length]
        const current = channels[index]
        const next = channels[(index + 1) % channels.length]
        return [hslChannelColor(previous), hslChannelColor(current), hslChannelColor(next)]
    }

    function hslChannelControlSignature(channelName) {
        return String(channelName || "")
                + "|label:" + hslChannelShortLabel(channelName)
                + "|tooltip:" + hslChannelTooltip(channelName)
    }

    function colorMixActiveChannelSignature() {
        return root.primaryStringAdjustmentValue("colorMixerModel", root.editorPreviewController.colorMixerModel) + "|" +
                root.primaryStringAdjustmentValue("hslChannel", root.editorPreviewController.hslChannel)
                + "|h:" + Math.round(root.primaryColorMixerChannelValue("hue", root.editorPreviewController.hueAdjustment))
                + "|s:" + Math.round(root.primaryColorMixerChannelValue("saturation", root.editorPreviewController.saturationAdjustment))
                + "|l:" + Math.round(root.primaryColorMixerChannelValue("luminance", root.editorPreviewController.luminanceAdjustment))
    }

    function resetColorMixActiveChannel() {
        root.editorPreviewController.beginCoalescedEdit()
        root.setPrimaryAdjustmentValue("hueAdjustment", 0)
        root.setPrimaryAdjustmentValue("saturationAdjustment", 0)
        root.setPrimaryAdjustmentValue("luminanceAdjustment", 0)
        root.editorPreviewController.endCoalescedEdit()
        return true
    }

    function colorReplaceSignature() {
        return "source:" + Math.round(root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "sourceHue", root.editorPreviewController.colorReplacementSourceHue) * 360)
                + "|target:" + Math.round(root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "targetHue", root.editorPreviewController.colorReplacementTargetHue) * 360)
                + "|range:" + Math.round(root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "range", root.editorPreviewController.colorReplacementRange))
                + "|softness:" + Math.round(root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "softness", root.editorPreviewController.colorReplacementSoftness))
                + "|strength:" + Math.round(root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "strength", root.editorPreviewController.colorReplacementStrength))
                + "|preserveLuma:" + String(root.primaryBoolAdjustmentValue("colorReplacementPreserveLuminance", root.editorPreviewController.colorReplacementPreserveLuminance))
                + "|preserveSat:" + String(root.primaryBoolAdjustmentValue("colorReplacementPreserveSaturation", root.editorPreviewController.colorReplacementPreserveSaturation))
    }

    function swapColorReplacementHues() {
        const source = root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "sourceHue", root.editorPreviewController.colorReplacementSourceHue)
        root.setPrimaryAdjustmentValue("colorReplacementSourceHue", root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", "targetHue", root.editorPreviewController.colorReplacementTargetHue))
        root.setPrimaryAdjustmentValue("colorReplacementTargetHue", source)
        return true
    }

    function setColorToolSampler(target) {
        const cleanTarget = String(target || "")
        root.maskColorRangeSampling = false
        root.maskLuminanceRangeSampling = false
        root.maskDepthRangeSampling = false
        if (root.editorPreviewController.colorToolSamplingTarget === cleanTarget) {
            root.editorPreviewController.setColorToolSamplingTarget("")
