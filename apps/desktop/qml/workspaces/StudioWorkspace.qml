                ListView {
                    id: studioLibraryGalleryGrid
                    objectName: "studioLibraryGalleryGrid"
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    visible: !root.importModeOpen && !root.libraryDocumentsOpen && root.catalogViewMode === "grid" && root.assetCount() > 0
                    clip: true
                    boundsBehavior: Flickable.StopAtBounds
                    flickableDirection: Flickable.VerticalFlick
                    orientation: ListView.Vertical
                    model: galleryRows
                    cacheBuffer: Math.max(300, height * 0.5)
                    reuseItems: true
                    readonly property int galleryScrollbarGutter: Math.max(root.libraryGalleryScrollbarGutter,
                                                                            Math.ceil(Number(galleryVerticalScrollBar.implicitWidth || galleryVerticalScrollBar.width || 0)) + 2)
                    readonly property int galleryViewportWidth: root.libraryGalleryViewportWidth(width, galleryScrollbarGutter)
                    property var galleryRows: []

                    function rowAtOffset(offset) {
                        let low = 0
                        let high = galleryRows.length
                        while (low < high) {
                            const middle = Math.floor((low + high) / 2)
                            const row = galleryRows[middle]
                            if (row.top + row.height <= offset)
                                low = middle + 1
                            else
                                high = middle
                        }
                        return Math.max(0, Math.min(low, galleryRows.length - 1))
                    }
                    ScrollBar.vertical: ScrollBar {
                        id: galleryVerticalScrollBar
                        policy: ScrollBar.AsNeeded
                    }

                    WheelHandler {
                        objectName: "studioLibraryGalleryWheelHandler"
                        target: null

                        onWheel: function(event) {
                            const pixelDelta = event.pixelDelta.y
                            const angleDelta = event.angleDelta.y
                            const delta = Math.abs(pixelDelta) > 0.01
                                         ? pixelDelta
                                         : angleDelta / 120 * 48
                            if (Math.abs(delta) < 0.01)
                                return
                            const maximum = Math.max(0, studioLibraryGalleryGrid.contentHeight
                                                       - studioLibraryGalleryGrid.height)
                            studioLibraryGalleryGrid.contentY = Math.max(
                                0, Math.min(maximum, studioLibraryGalleryGrid.contentY - delta))
                            event.accepted = true
                        }
                    }

                    function scheduleGalleryRowsRefresh() {
                        libraryGalleryRowsRefreshTimer.restart()
                    }

                    property int layoutRevision: 0
                    function refreshGalleryRows() {
                        if (!visible)
                            return
                        layoutRevision += 1
                        const previousRow = galleryRows[rowAtOffset(contentY)]
                        const anchorId = previousRow && previousRow.items.length > 0
                                         ? previousRow.items[0].assetId : ""
                        const anchorOffset = previousRow ? contentY - previousRow.top : 0
                        const nextRows = root.libraryGalleryRows(galleryViewportWidth)
                        galleryRows = nextRows
                        // Thumbnail aspect discovery must not move the row being viewed.
                        if (anchorId.length > 0) {
                            for (let rowIndex = 0; rowIndex < nextRows.length; ++rowIndex) {
                                const row = nextRows[rowIndex]
                                if (row.items.some(function(item) { return item.assetId === anchorId })) {
                                    contentY = Math.max(0, Math.min(row.top + anchorOffset, contentHeight - height))
                                    break
                                }
                            }
                        }
                        updateVisibleAssetRange()
                    }

                    function updateVisibleAssetRange() {
                        if (!catalogAssets)
                            return
                        if (!visible)
                            return
                        if (root.assetCount() <= 0) {
                            catalogAssets.setVisibleAssetRange(-1, -1)
                            return
                        }
                        const firstRow = galleryRows[rowAtOffset(contentY)]
                        const lastRow = galleryRows[rowAtOffset(contentY + height)]
                        const firstItems = firstRow ? firstRow.items : []
                        const lastItems = lastRow ? lastRow.items : []
                        if (firstItems.length === 0 || lastItems.length === 0)
                            catalogAssets.setVisibleAssetRange(-1, -1)
                        else
                            catalogAssets.setVisibleAssetRange(firstItems[0].index, lastItems[lastItems.length - 1].index)
                    }

                    Timer {
                        id: libraryGalleryRowsRefreshTimer
                        interval: 0
                        repeat: false
                        onTriggered: studioLibraryGalleryGrid.refreshGalleryRows()
                    }

                    Connections {
                        target: root
                        function onLibraryGalleryAspectRevisionChanged() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                        function onCatalogViewModeChanged() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                    }

                    Connections {
                        target: catalogAssets
                        function onAssetCountChanged() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                        function onModelReset() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                        function onRowsInserted() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                        function onRowsRemoved() { studioLibraryGalleryGrid.scheduleGalleryRowsRefresh() }
                    }

                    Component.onCompleted: refreshGalleryRows()
                    onContentYChanged: updateVisibleAssetRange()
                    onHeightChanged: updateVisibleAssetRange()
                    onWidthChanged: scheduleGalleryRowsRefresh()
                    onGalleryViewportWidthChanged: scheduleGalleryRowsRefresh()
                    onVisibleChanged: scheduleGalleryRowsRefresh()
                    onGalleryRowsChanged: updateVisibleAssetRange()

                    delegate: Row {
                        id: galleryRow
                        required property var modelData
                        width: studioLibraryGalleryGrid.galleryViewportWidth
                        height: Math.max(1, Number(modelData.height || 0))
                        spacing: 0

                        Repeater {
                            model: galleryRow.modelData.items || []

                            FocusScope {
                                id: tileDelegate
                                objectName: "libraryGalleryTile"
                                required property var modelData
                                readonly property int assetIndex: Number(modelData.index || 0)
                                property int galleryDataRevision: 0
                                readonly property var galleryAsset: {
                                            // Keep the binding live when row geometry/filtering
                                            // reuses a delegate for another model entry.
                                            const identity = modelData.assetId
                                            const revision = galleryDataRevision
                                            return identity && revision >= 0 ? catalogAssets.galleryAssetAt(assetIndex) : ({})
                                        }
                                readonly property string assetId: String(galleryAsset.assetId || "")
                                        readonly property string thumbnailSource: String(galleryAsset.thumbnailSource || "")
                                        readonly property string mediaType: String(galleryAsset.mediaType || "photo")
                                        readonly property string durationText: String(galleryAsset.durationText || "")
                                        readonly property int rating: Math.max(0, Math.min(5, Number(galleryAsset.rating || 0)))
                                        readonly property bool picked: Boolean(galleryAsset.picked)
                                        readonly property bool rejected: Boolean(galleryAsset.rejected)

                                        Connections {
                                            target: catalogAssets
                                            function onDataChanged(topLeft, bottomRight) {
                                                if (tileDelegate.assetIndex >= topLeft.row &&
                                                        tileDelegate.assetIndex <= bottomRight.row)
                                                    tileDelegate.galleryDataRevision += 1
                                            }
                                        }
                                        readonly property bool batchSelected: catalogAssets.selectedAssetCount >= 0 && catalogAssets.assetSelected(assetId)
                                        readonly property bool currentAsset: catalogAssets.selectedIndex === assetIndex
                                        readonly property bool highlighted: batchSelected || currentAsset || activeFocus

                                        width: Math.max(1, Number(modelData.width || 1))
                                        height: galleryRow.height
                                        activeFocusOnTab: true

                                        Keys.onReturnPressed: root.selectAsset(assetIndex)
                                        Keys.onEnterPressed: root.selectAsset(assetIndex)
                                        Keys.onSpacePressed: root.selectAsset(assetIndex, Qt.ControlModifier)

                                        Rectangle {
                                            anchors.fill: parent
	                                            color: theme.mediaCanvas
                                            clip: true

                                            Image {
                                                id: tileImage
                                                objectName: "libraryGalleryImage"
                                                anchors.fill: parent
                                                source: tileDelegate.thumbnailSource
                                                fillMode: Image.PreserveAspectFit
                                                // Decode independently of the row geometry. Feeding
                                                // painted dimensions back into layout causes resize /
                                                // reload cycles as width and height change separately.
                                                sourceSize: Qt.size(768, 768)
                                                asynchronous: true
                                                cache: tileDelegate.thumbnailSource.length > 0
                                                visible: source.toString().length > 0
                                                function recordSourceAspect() {
                                                    if (status === Image.Ready)
                                                        root.setLibraryGalleryAspectRatio(
                                                                    tileDelegate.assetIndex,
                                                                    tileDelegate.thumbnailSource,
                                                                    implicitWidth,
                                                                    implicitHeight, tileDelegate.assetId)
                                                }
                                                onStatusChanged: if (status === Image.Ready) aspectDiscoveryTimer.restart()
                                                Timer {
                                                    id: aspectDiscoveryTimer
                                                    interval: 0
                                                    onTriggered: tileImage.recordSourceAspect()
                                                }
                                            }

                                            Rectangle {
                                                anchors.fill: parent
                                                visible: tileDelegate.thumbnailSource.length === 0
	                                                color: theme.ink850
                                            }

                                            Rectangle {
                                                anchors.fill: parent
                                                visible: tileMouse.containsMouse || tileDelegate.highlighted
                                                color: tileDelegate.batchSelected
                                                       ? theme.alpha(root.mint, 0.12)
                                                       : tileDelegate.currentAsset
                                                         ? theme.alpha(theme.polar, 0.10)
                                                         : tileMouse.containsMouse
                                                           ? theme.alpha(theme.polar, 0.05)
                                                           : "transparent"
                                                border.width: tileDelegate.highlighted ? 2 : theme.chromeBorderWidth
                                                border.color: tileDelegate.batchSelected
                                                              ? theme.alpha(root.mint, 0.94)
                                                              : tileDelegate.currentAsset || tileDelegate.activeFocus
                                                                ? theme.alpha(theme.polar, 0.84)
                                                                : theme.alpha(theme.polar, 0.34)
                                            }

                                            Rectangle {
                                                anchors.top: parent.top
                                                anchors.right: parent.right
                                                anchors.margins: 8
                                                width: 22
                                                height: 22
                                                radius: 11
                                                visible: tileDelegate.batchSelected || root.selectionMode || tileMouse.containsMouse
                                                color: tileDelegate.batchSelected ? root.mint : theme.alpha(theme.ink950, 0.68)
                                                border.width: theme.chromeBorderWidth
                                                border.color: tileDelegate.batchSelected ? root.mintSoft : theme.alpha(theme.polar, 0.42)
                                                z: 2

                                                AppIcon {
                                                    anchors.centerIn: parent
                                                    width: 12
                                                    height: 12
                                                    name: "check"
	                                                    color: theme.ink950
                                                    visible: tileDelegate.batchSelected
                                                }
                                            }

                                            Rectangle {
                                                anchors.left: parent.left
                                                anchors.top: parent.top
                                                anchors.margins: 8
                                                width: 22
                                                height: 22
                                                radius: 11
                                                visible: tileDelegate.picked || tileDelegate.rejected
                                                color: tileDelegate.rejected ? theme.alpha(theme.error, 0.90) : theme.alpha(root.mint, 0.90)
                                                border.width: theme.chromeBorderWidth
                                                border.color: tileDelegate.rejected ? theme.error : root.mintSoft
                                                z: 2

                                                AppIcon {
                                                    anchors.centerIn: parent
                                                    width: 12
                                                    height: 12
                                                    name: tileDelegate.rejected ? "close" : "check"
	                                                    color: theme.ink950
                                                }
                                            }

                                            Row {
                                                anchors.left: parent.left
                                                anchors.bottom: parent.bottom
                                                anchors.margins: 8
                                                visible: tileDelegate.rating > 0
                                                spacing: 1
                                                z: 2

                                                Repeater {
                                                    model: tileDelegate.rating
                                                    AppIcon {
                                                        width: 11
                                                        height: 11
                                                        name: "star"
                                                        color: root.mint
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                anchors.right: parent.right
                                                anchors.bottom: parent.bottom
                                                anchors.margins: 8
                                                visible: tileDelegate.mediaType !== "photo"
                                                radius: 3
                                                color: theme.alpha(theme.ink950, 0.72)
                                                border.width: theme.chromeBorderWidth
                                                border.color: theme.alpha(theme.polar, 0.22)
                                                implicitWidth: durationBadge.implicitWidth + 12
                                                implicitHeight: 20
                                                z: 2

                                                RowLayout {
                                                    id: durationBadge
                                                    anchors.centerIn: parent
                                                    spacing: theme.space4
                                                    MediaTypeIcon {
                                                        mediaType: tileDelegate.mediaType
                                                        color: theme.textStrong
                                                        Layout.preferredWidth: theme.scaled(13)
                                                        Layout.preferredHeight: theme.scaled(13)
                                                    }
                                                    Label {
                                                        text: tileDelegate.durationText.length > 0 ? tileDelegate.durationText
                                                              : tileDelegate.mediaType === "timeline" ? "Timeline"
                                                              : tileDelegate.mediaType === "carousel" ? "Boards" : "Video"
                                                        color: theme.textStrong
                                                        font.family: theme.fontMono
                                                        font.pixelSize: theme.typeMicro
                                                    }
                                                }
                                            }

                                            MouseArea {
                                                id: tileMouse
                                                anchors.fill: parent
                                                hoverEnabled: true
                                                acceptedButtons: Qt.LeftButton
                                                onClicked: function(mouse) {
                                                    tileDelegate.forceActiveFocus()
                                                    root.selectAsset(tileDelegate.assetIndex, mouse.modifiers)
                                                }
                                                onDoubleClicked: function(mouse) {
                                                    if (mouse.modifiers & (Qt.ShiftModifier | Qt.ControlModifier | Qt.MetaModifier))
                                                        return
                                                    tileDelegate.forceActiveFocus()
                                                    root.selectAsset(tileDelegate.assetIndex)
                                                    root.assetActivated(tileDelegate.mediaType === "photo" ? "edit" : "timeline")
                                                }
                                            }
                                        }
                                    }
                                }
                            }
