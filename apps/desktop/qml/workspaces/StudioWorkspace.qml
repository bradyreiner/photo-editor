    Keys.onPressed: function(event) {
        if (root.handleLayerNudgePress(event)) return
        if (event.key === Qt.Key_Space &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.maskSpacePanShortcutActive()) {
            root.spacePanActive = true
            event.accepted = true
            return
        }
        if (event.key === Qt.Key_H &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.setMaskPreviewTemporarilyHiddenFromShortcut(true)) {
            event.accepted = true
            return
        }
        if (event.key === Qt.Key_B &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.page === "edit" &&
                root.workspaceActive &&
                root.setOriginalHold(true)) {
            event.accepted = true
            return
        }
        if (event.key === Qt.Key_X &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.setTemporaryBrushEraseFromShortcut(true)) {
            event.accepted = true
        }
    }

    Keys.onReleased: function(event) {
        if (root.nudgeArrowKey(event.key) && root.layerNudgeKeys.indexOf(event.key) >= 0) {
            event.accepted = true
            if (event.isAutoRepeat) return
            const remaining = root.layerNudgeKeys.filter(function(key) { return key !== event.key })
            if (remaining.length === 0) root.finishLayerNudge()
            else root.layerNudgeKeys = remaining
            return
        }
        if (event.key === Qt.Key_Space &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat) {
            if (root.spacePanActive) {
                root.spacePanActive = false
                event.accepted = true
            }
            return
        }
        if (event.key === Qt.Key_H &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.setMaskPreviewTemporarilyHiddenFromShortcut(false)) {
            event.accepted = true
            return
        }
        if (event.key === Qt.Key_B &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.setOriginalHold(false)) {
            event.accepted = true
            return
        }
        if (event.key === Qt.Key_X &&
                event.modifiers === Qt.NoModifier &&
                !event.isAutoRepeat &&
                root.setTemporaryBrushEraseFromShortcut(false)) {
            event.accepted = true
        }
    }

