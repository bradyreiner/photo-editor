               focusItem.selectedText !== undefined ||
               focusItem.echoMode !== undefined ||
               focusItem.acceptableInput !== undefined
    }

    function brushShortcutContextActive() {
        return root.brushToolReady() && !root.shortcutTextInputActive()
    }

    function switchLayerTargetFromShortcut(delta) {
        if (!root.targetShortcutContextActive(true) || root.editorPreviewController.photoLayerCount <= 0)
            return false
        const count = root.editorPreviewController.photoLayerCount
        const direction = Number(delta || 0) < 0 ? -1 : 1
        let currentIndex = root.activeEditTargetLayerIndex()
        if (currentIndex < 0)
            currentIndex = root.normalizedActivePhotoLayerIndex()
        const nextIndex = (Math.max(0, currentIndex) + direction + count) % count
        return root.editPhotoLayerInspectorTarget(nextIndex)
    }

    function switchMaskTargetFromShortcut(delta) {
        const maskSets = root.maskSetRows
        const count = maskSets.length
        if (!root.targetShortcutContextActive(true) || count <= 0)
            return false
        const direction = Number(delta || 0) < 0 ? -1 : 1
        let currentIndex = -1
        for (let index = 0; index < count; ++index) {
            if (root.maskSetActive(maskSets[index] || ({}))) {
                currentIndex = index
                break
            }
        }
        if (currentIndex < 0)
            currentIndex = Math.max(0, Math.min(count - 1, root.selectedMaskSetIndex))
        const nextIndex = (Math.max(0, currentIndex) + direction + count) % count
        root.selectMaskSetAndLayer(maskSets[nextIndex] || ({}), false)
        return true
    }

    function returnToBaseImageFromShortcut() {
        if (!root.targetShortcutContextActive(true))
            return false
        return root.activateBaseImageLayerTarget()
    }

    function activateBaseImageLayerTarget() {
        if (root.componentWorkspaceActive)
            return false
        if (root.selectionNavigationActive && root.editorPreviewController.hasWorkingSelection)
            return root.switchSelectionLayerTarget("base-image")
        if (root.editorPreviewController.selectionEditSessionActive)
            return root.queueSelectionAction("base-image")
        const retainedInspectorTab = root.editInspectorTab
        const retainedLayerSelection = root.normalizedPhotoLayerSelection()
        const activeIndex = root.normalizedActivePhotoLayerIndex()
        if (retainedLayerSelection.length === 0 && activeIndex >= 0 &&
                (root.photoLayerRows[activeIndex] || ({})).baseImageEdit !== true)
            retainedLayerSelection.push(activeIndex)
        if (!root.setSelectedEditTarget("base-image", -1, ({}), -1))
            return false
        root.editorPreviewController.finishLayerMaskEditing()
        root.clearTransientToolStateFor("adjust")
        root.selectedPhotoLayerIndices = retainedLayerSelection
        root.selectedEditLayer = "adjustments"
        root.editTool = "adjust"
        root.editInspectorTab = retainedInspectorTab === "layers" ? "layers" : "adjust"
        root.editorPreviewController.maskPreviewTemporarilyHidden = false
        return true
    }

    function toggleMaskOutlineFromShortcut() {
        if (!root.maskShortcutContextActive(true))
            return false
        root.editorPreviewController.maskPreviewMode = root.editorPreviewController.maskPreviewDisplayMode === "marching-ants"
                ? "overlay"
                : "marching-ants"
        return true
    }

    function startMaskPathSource(kindName) {
        root.prepareWorkingSelectionTarget()
        if (!root.beginMaskSelectionSession())
            return false
        const operation = root.maskCreationOperation
        root.clearTransientMaskTools()
        root.editTool = "masks"
        root.editInspectorTab = "adjust"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "outline"
        root.lassoDrawArmed = kindName === "lasso"
        root.polygonDrawArmed = kindName === "polygon"
        root.beginMaskShapeEditTransaction()
        if (root.lassoDrawArmed)
            root.editorPreviewController.startLassoSelection(operation === "subtract")
        else
            root.editorPreviewController.startPolygonSelection(operation === "subtract")
        if (root.editorPreviewController.hasActiveMask)
            root.editorPreviewController.activeMaskOperation = operation
        root.selectActiveSelectionAdjustmentLayer()
        return true
    }

    function startMaskLassoFromShortcut() {
        if (!root.maskShortcutContextActive(false))
            return false
        return root.startMaskPathSource("lasso")
    }

    function startMaskPolygonFromShortcut() {
        if (!root.maskShortcutContextActive(false))
            return false
        return root.startMaskPathSource("polygon")
    }

    function setMaskOperationFromShortcut(operationName) {
        if (!root.maskShortcutContextActive(false))
            return false
        root.editTool = "masks"
        root.editInspectorTab = "adjust"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "outline"
        root.setMaskCreationOperation(operationName)
        return true
    }

    function selectionShortcutContextActive() {
        return root.page === "edit" && root.editorPreviewController.hasAsset && !root.editorPreviewController.compareMode &&
                !root.shortcutTextInputActive() && root.editorPreviewController.hasWorkingSelection
    }

    function runSelectionAction(action) {
        if (action.indexOf("export-cutout:") === 0) {
            const request = JSON.parse(action.slice(14))
            return root.exportWorkingSelectionCutout(request.path, request.source, request.renderedLayer)
        }
        if (action.indexOf("cutout:") === 0) {
            const request = JSON.parse(action.slice(7))
            return root.createCutoutFromWorkingSelection(request.independent, request.source)
        }
        if (action === "adjust-selection") return root.createAdjustmentFromWorkingSelection()
        if (action === "base-image" || action.indexOf("layer:") === 0)
            return root.switchSelectionLayerTarget(action)
        if (action.indexOf("edit-layer:") === 0) {
            const index = root.photoLayerIndexForId(action.slice(11))
            return index >= 0 && root.editPhotoLayerInspectorTarget(index)
        }
        if (action.indexOf("layer-row:") === 0) {
            const target = JSON.parse(action.slice(10))
            const index = root.photoLayerIndexForId(String(target.id || ""))
            return index >= 0 && root.selectPhotoLayerWithModifiers(index, Number(target.modifiers || 0))
        }
        if (action === "invert") return root.editorPreviewController.invertActiveSelection()
        if (action === "deselect") {
            return root.editorPreviewController.deselectWorkingSelection()
        }
        if (action === "reselect") return root.editorPreviewController.reselectWorkingSelection()
        root.applyEditToolActivation(action)
        return true
    }

    function queueSelectionAction(action) {
        if (!root.editorPreviewController.selectionEditSessionActive) return root.runSelectionAction(action)
        root.pendingSelectionAction = action
        if (root.editorPreviewController.brushStrokeActive) root.editorPreviewController.endActiveBrushStroke()
        root.endMaskShapeEditTransaction()
        // A pending brush commit completes this action through the session-finished signal.
        const finished = root.editorPreviewController.finishSelectionEditSession()
        if (!finished && !root.editorPreviewController.selectionEditSessionActive) root.pendingSelectionAction = ""
        return finished || root.editorPreviewController.selectionEditSessionActive
    }

    function invertInspectedMaskOrSelection() {
        if (root.editorPreviewController.editingLayerMask)
            return root.editorPreviewController.invertLayerMask(root.photoLayerIndexForId(root.editorPreviewController.maskEditLayerId), String(root.activeMaskSetData().id || ""))
        return root.queueSelectionAction("invert")
    }

    function invertActiveMaskFromShortcut() {
        if (!root.selectionShortcutContextActive() ||
                String(root.editorPreviewController.activeMaskEditDisabledReason || "").length > 0)
            return false
        return root.queueSelectionAction("invert")
    }

    function toggleActiveMaskOverlayFromShortcut() {
