        const presentation = previewRenderPresentationSignature(
                    processing,
                    statusText,
                    failureStage,
                    failureDetail)
        const failed = presentation.indexOf("failed") === 0
        return presentation
                + "|chrome:badge"
                + "|center:false"
                + "|retryButton:" + String(failed)
