                                            ["Lens", root.editorPreviewController.lensModel.length > 0 ? root.editorPreviewController.lensModel : "Not available"],
                                            ["Captured", root.editorPreviewController.captureDate.length > 0 ? root.editorPreviewController.captureDate : "Not available"],
                                            ["Resolution", Number(root.editorPreviewController.sourceImageWidth || 0) > 0 && Number(root.editorPreviewController.sourceImageHeight || 0) > 0
                                             ? Math.round(root.editorPreviewController.sourceImageWidth) + " x " + Math.round(root.editorPreviewController.sourceImageHeight) + " (" + root.aspectRatioText(root.editorPreviewController.sourceImageWidth, root.editorPreviewController.sourceImageHeight) + ")"
                                             : "Pending"],
                                            ["Color Space", root.editorPreviewController.outputColorSpace],
                                            ["Proofing", root.proofingStatusText()],
                                            ["Catalog", root.formatInt(catalogAssets.assetCount) + " visible / " + root.formatInt(catalogAssets.totalAssetCount) + " total"],
                                            ["Review", catalogAssets.reviewFilter === "all" && catalogAssets.minimumRatingFilter === 0
                                             ? root.formatInt(catalogAssets.visiblePickedCount) + " picked, " + root.formatInt(catalogAssets.visibleRatedCount) + " rated"
                                             : "Filter " + catalogAssets.reviewFilter + (catalogAssets.minimumRatingFilter > 0 ? ", " + catalogAssets.minimumRatingFilter + "+ stars" : "")],
                                            ["Project", catalogAssets.projectFilter === "all" ? "All Projects" : catalogAssets.projectFilter]
                                        ]
                                        RowLayout {
                                            required property var modelData
                                            Layout.fillWidth: true
                                            Label { Layout.preferredWidth: 92; text: modelData[0]; color: root.dimText; font.pixelSize: 11 }
                                            Label {
                                                Layout.fillWidth: true
                                                text: modelData[1]
                                                color: theme.textMain
                                                font.pixelSize: 11
                                                wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                                                maximumLineCount: 2
                                                elide: Text.ElideNone
                                            }
                                        }
                                    }
                                }

                                InspectorGroup {
                                    objectName: "renderingModelInspectorGroup"
                                    title: "Rendering"
                                    subtitle: "Versioned output rendering • legacy edits never change silently"

                                    Label {
                                        Layout.fillWidth: true
                                        text: "Current  " + root.renderingModelLabel(root.editorPreviewController.currentPhotographicRenderingModel)
                                        color: theme.textMain
                                        font.family: theme.fontUi
                                        font.pixelSize: 11
                                        wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                                    }

                                    Label {
                                        Layout.fillWidth: true
                                        text: root.editorPreviewController.renderingUpgradeStatus === "current"
                                              ? "This recipe already uses the current official renderer."
                                              : root.editorPreviewController.renderingUpgradeStatus === "official-processor-unavailable"
                                                ? "The pinned official ACES 2 processor is unavailable in this build."
                                                : "Preview the identical recipe with ACES 2 and the versioned legacy-luminance preservation look before opting in."
                                        color: root.editorPreviewController.renderingUpgradeStatus === "official-processor-unavailable"
                                               ? theme.error
                                               : root.dimText
                                        font.family: theme.fontUi
                                        font.pixelSize: 10
                                        wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                                    }

                                    MiniButton {
                                        objectName: "previewRenderingUpgradeButton"
                                        Layout.fillWidth: true
                                        visible: !root.componentWorkspaceActive && root.editorPreviewController.renderingUpgradeStatus !== "current"
                                        text: "Compare Rendering Upgrade"
                                        iconName: "compare"
                                        role: "secondary"
                                        enabled: root.editorPreviewController.renderingUpgradeAvailable
                                        tooltip: enabled
                                                 ? "Open a synchronized current-versus-ACES 2 comparison."
                                                 : "The official ACES 2 processor is unavailable."
                                        onClicked: {
                                            if (root.editorPreviewController.startRenderingUpgradePreview()) {
                                                root.compareViewMode = "side-by-side"
                                                root.editTool = "compare"
                                            }
                                        }
                                    }
                                    StudioColorManagementPanel { objectName: "studioColorManagementPanel"; Layout.fillWidth: true; visible: !root.componentWorkspaceActive; editorPreview: root.editorPreviewController; theme: root.studioTheme; dimText: root.dimText; proofingStatusText: root.proofingStatusText() }
                                }
                            }
                        }
                    }

                }
                }

            }
        }
    }

    Component {
        id: exportPage

        RowLayout {
            spacing: 0

            StudioPanel {
                objectName: "exportPresetsPanel"
                visible: root.exportPresetsPanelVisible
                Layout.preferredWidth: root.exportPresetsPanelVisible ? root.exportPresetsPanelWidth : 0
                Layout.fillHeight: true
                title: "Export Presets"
                ColumnLayout {
                    anchors.fill: parent
                    spacing: 10
                    MenuButton {
                        objectName: "exportPresetCreateMenuButton"
                        Layout.fillWidth: true
                        text: "New Preset"
                        iconName: "plus"
                        tone: "secondary"
                        compact: true
                        menuItems: [
                            { key: "save-current", label: "Save Current Settings", icon: "save", tooltip: "Open the Edit preset panel to save the current look." },
                            { key: "import-bundle", label: "Import Preset Bundle", icon: "folder", tooltip: "Open the Edit preset panel to import a preset bundle." }
                        ]
                        onMenuItemTriggered: function(key) { root.presetManagementRequested(key) }
                        tooltipText: "Create or import export presets."
                    }
                    Repeater {
                        model: root.exportPresets
                        StudioSidebarRow {
                            required property int index
                            required property var modelData
                            label: modelData.name
                            value: modelData.format
                            active: index === root.selectedPresetIndex
                            onClicked: root.selectedPresetIndex = index
                        }
                    }
                    MenuButton {
                        objectName: "exportPresetManageMenuButton"
                        Layout.fillWidth: true
                        text: "More"
                        iconName: "more"
                        tone: "secondary"
                        compact: true
                        secondaryActionMenu: true
                        menuItems: [
                            { key: "manage-saved", label: "Manage Saved Presets", icon: "edit", tooltip: "Open the Edit preset panel to rename, move, or delete custom presets." },
                            { key: "export-bundle", label: "Export Preset Bundle", icon: "export", tooltip: "Open the Edit preset panel to export a preset bundle." },
                            { key: "import-bundle", label: "Import Preset Bundle", icon: "folder", tooltip: "Open the Edit preset panel to import a preset bundle." }
                        ]
                        onMenuItemTriggered: function(key) { root.presetManagementRequested(key) }
                        tooltipText: "Preset management actions."
                    }
                    StudioRowRule {}
                    StudioSectionTitle { label: "Destinations" }
                    Repeater {
                        model: [["Local Drive", "/Volumes/Exports"], ["Shared Drive", "Connected"], ["Dropbox", "brad@example.com"], ["Google Drive", "brad@example.com"], ["OneDrive", "brad@example.com"]]
                        StudioSidebarRow { required property int index; required property var modelData; label: modelData[0]; value: modelData[1]; active: index < 2; onClicked: root.exportDestination = modelData[1] }
                    }
                    Item { Layout.fillHeight: true }
                    StudioSectionTitle { label: "Export Drive" }
                    ProgressStrip { Layout.fillWidth: true; progress: 0.30; active: false }
                    Label { text: "2.4 TB / 8 TB                                      30%"; color: root.dimText; font.pixelSize: 10 }
                }
            }

            Rectangle { Layout.preferredWidth: 0; Layout.fillHeight: true; color: "transparent" }

            ColumnLayout {
                Layout.fillWidth: true
                Layout.fillHeight: true
                Layout.margins: 20
                spacing: 14

                RowLayout {
                    Layout.fillWidth: true
                    StudioSectionTitle {
                        Layout.fillWidth: true
                        label: "Selected Assets  " + root.formatInt(Math.max(catalogAssets.selectedAssetCount, Math.min(root.assetCount(), 4)))
                    }
                    MiniButton { text: "Presets"; role: "segmented"; active: root.exportPresetsPanelVisible; onClicked: root.exportPresetsPanelVisible = !root.exportPresetsPanelVisible }
                    MiniButton { text: "Settings"; role: "segmented"; active: root.exportSettingsPanelVisible; onClicked: root.exportSettingsPanelVisible = !root.exportSettingsPanelVisible }
                    MenuButton {
                        objectName: "exportInterfaceDensityMenuButton"
                        text: "Density"
                        iconName: "density"
                        tone: "secondary"
                        compact: true
                        primaryOpensMenu: true
                        menuWidth: 210
                        menuItems: [
                            { key: "comfortable", label: "Comfortable", icon: "density", checked: root.interfaceDensity === "comfortable" },
                            { key: "balanced", label: "Balanced", icon: "density", checked: root.interfaceDensity === "balanced" },
                            { key: "compact", label: "Compact", icon: "density", checked: root.interfaceDensity === "compact" }
                        ]
                        tooltipText: "Choose the control size and spacing used throughout the app."
                        onMenuItemTriggered: function(key) { root.setInterfaceDensity(key) }
                    }
                    MenuButton {
                        objectName: "exportAddAssetsMenuButton"
                        text: "Add Assets"
                        iconName: "plus"
                        tone: "secondary"
                        compact: true
                        menuWidth: 210
                        menuItems: [
                            { key: "library", label: "Choose From Library", icon: "grid" },
                            { key: "import", label: "Import Folder", icon: "folder" }
                        ]
                        tooltipText: "Add assets to the export workflow."
                        onClicked: root.assetActivated("library")
                        onMenuItemTriggered: function(key) {
                            if (key === "library")
                                root.assetActivated("library")
                            else if (key === "import")
                                root.assetActivated("import")
                        }
                    }
                }

                StudioEmptyStateCard {
                    studioTheme: theme
                    hairline: root.hairline
                    accentColor: root.mint
                    dimText: root.dimText
                    objectName: "exportEmptyState"
                    visible: root.exportEmptyStateTitle().length > 0
                    iconName: "export"
                    title: root.exportEmptyStateTitle()
                    message: root.exportEmptyStateMessage()
                }

                RowLayout {
                    visible: root.exportEmptyStateTitle().length === 0
                    Layout.fillWidth: true
                    Layout.preferredHeight: 250
                    spacing: 12
                    Repeater {
                        model: Math.min(2, Math.max(1, root.assetCount()))
                        ThumbnailCard {
                            required property int index
                            Layout.preferredWidth: 282
                            Layout.fillHeight: true
                            assetIndex: index
                            selected: true
                        }
                    }
                }

                StudioRowRule {}
                RowLayout {
                    visible: root.exportEmptyStateTitle().length === 0
                    Layout.fillWidth: true
                    StudioSectionTitle {
                        Layout.fillWidth: true
                        label: "Export Queue  -  " + root.formatInt(exportJobs ? exportJobs.jobCount : 0) + " jobs"
                    }
                    MenuButton {
                        objectName: "exportQueueManagementMenuButton"
                        text: "More"
                        iconName: "more"
                        tone: "secondary"
                        compact: true
                        secondaryActionMenu: true
                        menuWidth: 210
                        menuItems: root.studioExportQueueManagementMenuItems()
                        tooltipText: "Queue retry and cleanup actions."
                        onClicked: root.handleStudioExportQueueManagementAction(
                                       root.failedExportJobCount() > 0 ? "retry-failed" : "clear-finished")
                        onMenuItemTriggered: function(key) { root.handleStudioExportQueueManagementAction(key) }
                    }
                    SplitButton {
                        objectName: "studioExportPrimarySplitButton"
                        text: "Start Export"
                        iconName: "export"
                        tone: "primary"
                        compact: true
                        active: true
                        primaryEnabled: root.studioExportCanQueueCurrent() &&
                                        root.studioExportDisabledReason(false).length === 0
                        disabledReason: root.studioExportDisabledReason(false)
                        tooltipText: "Queue the current export with the selected preset and destination."
                        menuWidth: 236
                        menuItems: root.studioExportActionMenuItems()
                        menuTooltipText: "Export variants and setup actions."
                        onClicked: root.queuePrimaryStudioExport()
                        onMenuItemTriggered: function(key) { root.handleStudioExportAction(key) }
                    }
                }

                Rectangle {
                    visible: root.exportEmptyStateTitle().length === 0
                    Layout.fillWidth: true
                    Layout.preferredHeight: 196
                    color: root.panelColor
                    border.width: theme.chromeBorderWidth
                    border.color: root.hairline
                    radius: 4

                    ColumnLayout {
                        anchors.fill: parent
                        anchors.margins: 12
                        spacing: 0

                        Repeater {
                            model: root.exportQueueRows(4)
                            ExportQueueRow {
                                id: exportQueueRowRoot
                                required property int index
                                required property var modelData
                                readonly property var rowData: modelData || ({})
                                Layout.fillWidth: true
                                objectName: "exportQueueRow"
                                rowIndex: index
                                alternate: index % 2 !== 0
                                previewSource: String(rowData.preview || "")
                                fallbackIconName: "export"
                                title: String(rowData.displayLabel || "Export item")
                                destination: String(rowData.destinationDirectory || root.exportDestination)
                                preset: String(rowData.preset || "Preset")
                                format: String(rowData.format || "JPG")
                                statusText: String(rowData.status || "Ready")
                                statusTone: root.exportQueueStatusTone(rowData.status)
                                busy: String(rowData.status || "").toLowerCase() === "running"
                                      || String(rowData.status || "").toLowerCase() === "canceling"
                                showProgress: String(rowData.kind || "") === "job"
                                progressValue: Math.max(0.05, Math.min(1.0, Number(rowData.progress || 0) / 100.0))
                                progressAccent: root.exportQueueStatusColor(rowData.status)
                                menuItems: root.exportQueueMenuItems(rowData)
                                menuWidth: 190
                                menuTooltipText: "Export row actions."
                                onPrimaryActionRequested: {
                                    if (Number(rowData.assetIndex || -1) >= 0)
                                        root.queueExport(Number(rowData.assetIndex))
                                }
                                onMenuItemTriggered: function(key) {
                                    root.handleExportQueueMenu(key, rowData)
                                }
                            }
                        }

                        Rectangle {
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            Layout.topMargin: 14
                            color: theme.ink900
                            border.width: theme.chromeBorderWidth
                            border.color: theme.alpha(root.mint, 0.28)
                            radius: 4
                            Column {
                                anchors.centerIn: parent
                                spacing: 6
                                AppIcon { anchors.horizontalCenter: parent.horizontalCenter; name: "plus"; width: 28; height: 28; color: root.mint }
                                Label { anchors.horizontalCenter: parent.horizontalCenter; text: "Drag more assets here"; color: root.mint; font.family: theme.fontUi; font.pixelSize: 11; font.weight: Font.DemiBold; font.letterSpacing: 0 }
                                Label { anchors.horizontalCenter: parent.horizontalCenter; text: "Add files or folders to the export queue"; color: root.dimText; font.pixelSize: 10 }
                            }
                        }
                    }
                }
            }

            Rectangle { Layout.preferredWidth: 0; Layout.fillHeight: true; color: "transparent" }

            StudioPanel {
                objectName: "exportSettingsPanel"
                visible: root.exportSettingsPanelVisible
                Layout.preferredWidth: root.exportSettingsPanelVisible ? root.exportSettingsPanelWidth : 0
                Layout.fillHeight: true
                title: "Output Settings"
                ColumnLayout {
                    anchors.fill: parent
                    spacing: 12
                    Repeater {
                        model: [
                            ["Output Preset", root.exportPresets[root.selectedPresetIndex].name],
                            ["Color Space", "sRGB IEC61966-2.1"],
                            ["Resize", "Long Edge            2048 px"],
                            ["Sharpening", "Standard            Amount 40"],
                            ["Watermark", "No Watermark"],
                            ["File Naming", "Custom Name / " + root.exportNameSuffix],
                            ["Destination", "Local Drive / " + root.exportDestination]
                        ]
                        Rectangle {
                            required property var modelData
                            Layout.fillWidth: true
                            Layout.preferredHeight: 66
                            color: theme.ink900
                            border.width: theme.chromeBorderWidth
                            border.color: root.hairline
                            radius: 4
                            Column {
                                anchors.fill: parent
                                anchors.margins: 12
                                spacing: 6
                                Label { text: modelData[0]; color: root.dimText; font.family: theme.fontUi; font.pixelSize: 9; font.letterSpacing: 0 }
                                Label {
                                    text: modelData[1]
                                    color: theme.textStrong
                                    font.family: theme.fontNumeric
                                    font.features: theme.numericFontFeatures
                                    font.pixelSize: 12
                                    wrapMode: Text.WrapAnywhere
                                    maximumLineCount: 2
                                    elide: Text.ElideNone
                                    width: parent.width
                                }
                            }
                        }
                    }
                    Item { Layout.fillHeight: true }
                    Rectangle {
                        Layout.fillWidth: true
                        Layout.preferredHeight: 134
                        color: theme.ink900
                        border.width: theme.chromeBorderWidth
                        border.color: root.hairline
                        radius: 4
                        Column {
                            anchors.fill: parent
                            anchors.margins: 14
                            spacing: 8
                            StudioSectionTitle { label: "EXPORT SUMMARY" }
                            Label { text: "2 Assets"; color: root.dimText; font.pixelSize: 11 }
                            Label { text: "2 Total Outputs"; color: root.dimText; font.pixelSize: 11 }
                            Label { text: root.exportPresets[root.selectedPresetIndex].format + "  -  90% Quality"; color: root.dimText; font.pixelSize: 11 }
                            Label { text: "Est. Total Size  ~2.3 MB"; color: root.dimText; font.pixelSize: 11 }
                        }
                    }
                }
            }
        }
    }
}
