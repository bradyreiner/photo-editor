            "saturationShift", "colorizeHue", "colorizeStrength",
            "curveShadows", "curveDarks", "curveLights", "curveHighlights",
            "texture", "clarity", "dehaze", "sharpening", "sharpenRadius",
            "sharpenDetail", "sharpenMasking", "luminanceNr", "colorNr",
            "lensDistortion", "lensVignette", "chromaticAberration",
            "perspectiveVertical", "perspectiveHorizontal", "transformRotation",
            "transformScale", "transformSkewX", "transformSkewY",
            "liquifyCenterX", "liquifyCenterY", "liquifyRadius", "liquifyStrength"
        ].indexOf(key) >= 0
    }

    function layerAdjustmentNeutralValue(adjustment) {
        const key = String(adjustment || "").trim()
        if (key === "sharpenRadius" || key === "transformScale")
            return 1
        if (key === "liquifyCenterX" || key === "liquifyCenterY")
            return 0.5
        if (key === "liquifyRadius")
            return 0.25
        return 0
    }

    function layerStoredAdjustmentValue(layer, key) {
        const field = String(key || "").trim()
        if (field.length === 0 || !layer)
            return undefined
        if (layer[field] !== undefined && layer[field] !== null)
            return layer[field]
        const adjustments = layer.adjustments || ({})
        if (adjustments[field] !== undefined && adjustments[field] !== null)
            return adjustments[field]
        return undefined
    }

    function layerNumericAdjustmentChanged(layer, key, neutralValue) {
        const value = root.layerStoredAdjustmentValue(layer, key)
        if (value === undefined || value === null)
            return false
        const numericValue = Number(value)
        const neutral = Number(neutralValue !== undefined ? neutralValue : root.layerAdjustmentNeutralValue(key))
        return isFinite(numericValue) && Math.abs(numericValue - neutral) > 0.0001
    }

    function layerAnyNumericAdjustmentChanged(layer, keys) {
        for (let index = 0; index < keys.length; ++index) {
            const key = String(keys[index] || "")
            if (root.layerNumericAdjustmentChanged(layer, key, root.layerAdjustmentNeutralValue(key)))
                return true
        }
        return false
    }

    function layerObjectHasChangedValues(objectValue) {
        if (!objectValue)
            return false
        for (let key in objectValue) {
            const value = objectValue[key]
            if (value === undefined || value === null)
                continue
            if (typeof value === "number" && isFinite(value) && Math.abs(value) > 0.0001)
                return true
            if (typeof value === "boolean" && value)
                return true
            if (typeof value === "string" && value.trim().length > 0)
                return true
            if (typeof value === "object" && root.layerObjectHasChangedValues(value))
                return true
        }
        return false
    }

    function layerLutStack(layer) {
        const adjustments = layer && layer.adjustments ? layer.adjustments : ({})
        const stack = adjustments.lutStack || layer.lutStack || []
        return stack && stack.length !== undefined ? stack : []
    }

    function layerCurveAdjustmentChanged(layer) {
        const curveKeys = [
            "curveShadows", "curveDarks", "curveLights", "curveHighlights"
        ]
        const pointKeys = [
            "masterCurvePoints", "lumaCurvePoints", "redCurvePoints",
            "greenCurvePoints", "blueCurvePoints"
        ]
        if (root.layerAnyNumericAdjustmentChanged(layer, curveKeys))
            return true
        for (let index = 0; index < pointKeys.length; ++index) {
            const points = root.layerStoredAdjustmentValue(layer, pointKeys[index])
            if (points && points.length !== undefined && points.length >= 2)
                return true
        }
        return false
    }

    function layerHslAdjustmentChanged(layer) {
        const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
        const channels = colorMixer.channels || ({})
        return root.layerObjectHasChangedValues(channels)
    }

    function layerDominantHslChannelName(layer) {
        const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
        const channels = colorMixer.channels || ({})
        const fields = [
            "hue", "saturation", "luminance",
            "selectiveCyan", "selectiveMagenta", "selectiveYellow", "selectiveBlack"
        ]
        let bestChannel = ""
        let bestMagnitude = 0
        for (const channelName in channels) {
            const channel = channels[channelName] || ({})
            let magnitude = 0
            for (let fieldIndex = 0; fieldIndex < fields.length; ++fieldIndex)
                magnitude = Math.max(magnitude, Math.abs(Number(channel[fields[fieldIndex]] || 0)))
            if (magnitude > bestMagnitude) {
                bestMagnitude = magnitude
                bestChannel = String(channelName || "")
            }
        }
        if (bestChannel.length > 0)
            return bestChannel
        const activeChannel = String(colorMixer.channel || layer.hslChannel || "")
        return activeChannel.length > 0 && root.layerHslAdjustmentChanged(layer) ? activeChannel : ""
    }

    function layerGradingAdjustmentChanged(layer) {
        return root.layerObjectHasChangedValues(root.layerAdjustmentObject(layer, "colorGrading"))
    }

    function layerLutAdjustmentChanged(layer) {
        return root.layerLutStack(layer).length > 0
    }

    function layerChangedAdjustmentGroups(layer) {
        const groups = []
        if (String(layer && layer.kind || "").trim().toLowerCase() !== "adjustment")
            return groups
        function appendGroup(key, label) {
            const nextLabel = String(label || "").trim()
            if (nextLabel.length === 0)
                return
            const nextKey = String(key || nextLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-"))
            for (let groupIndex = 0; groupIndex < groups.length; ++groupIndex) {
                if (groups[groupIndex].label === nextLabel || groups[groupIndex].key === nextKey)
                    return
            }
            groups.push({ key: nextKey, label: nextLabel })
        }
        const suppliedGroups = layer && layer.changedAdjustmentGroups !== undefined
                ? layer.changedAdjustmentGroups : undefined
        if (suppliedGroups !== undefined && suppliedGroups !== null &&
                suppliedGroups.length !== undefined) {
            for (let index = 0; index < suppliedGroups.length; ++index) {
                const supplied = suppliedGroups[index] || ({})
                const label = String(supplied.label || supplied || "").trim()
                if (label.length === 0)
                    continue
                appendGroup(supplied.key, label)
            }
        }
        if (root.layerAnyNumericAdjustmentChanged(layer, ["temperature", "tint"]))
            appendGroup("white-balance", "WB")
        if (root.layerAnyNumericAdjustmentChanged(layer, [
                "exposure", "contrast", "highlights", "shadows", "whites", "blacks",
                "brightness", "filmicShoulder", "filmicToe", "adaptiveContrast",
                "levelsBlackPoint", "levelsGamma", "levelsWhitePoint",
                "zoneDeepShadows", "zoneShadows", "zoneMidtones", "zoneLights", "zoneHighlights"
            ]))
            appendGroup("light", "Light")
        if (root.layerCurveAdjustmentChanged(layer))
            appendGroup("tone-curve", "Curve")
        if (root.layerAnyNumericAdjustmentChanged(layer, [
                "vibrance", "saturation", "hueShift", "saturationShift",
                "colorizeHue", "colorizeStrength"
            ]))
            appendGroup("color", "Color")
        if (root.layerHslAdjustmentChanged(layer))
            appendGroup("hsl", "HSL")
        if (root.layerGradingAdjustmentChanged(layer))
            appendGroup("grading", "Grade")
        if (root.layerLutAdjustmentChanged(layer))
            appendGroup("lut", "LUT")
        if (root.layerAnyNumericAdjustmentChanged(layer, [
                "texture", "clarity", "dehaze", "sharpening", "sharpenRadius",
                "sharpenDetail", "sharpenMasking", "luminanceNr", "colorNr"
            ]))
            appendGroup("detail", "Detail")
        if (root.layerAnyNumericAdjustmentChanged(layer, [
                "lensDistortion", "lensVignette", "chromaticAberration",
                "perspectiveVertical", "perspectiveHorizontal", "transformRotation",
                "transformScale", "transformSkewX", "transformSkewY",
                "liquifyCenterX", "liquifyCenterY", "liquifyRadius", "liquifyStrength"
            ]) || Boolean(root.layerStoredAdjustmentValue(layer, "contentAwareCropFill")))
            appendGroup("lens-transform", "Lens")
        const suppliedLabel = String(layer && layer.changedAdjustmentGroupLabel || "")
        const suppliedParts = suppliedLabel.split(",")
        for (let suppliedIndex = 0; suppliedIndex < suppliedParts.length; ++suppliedIndex)
            appendGroup("", suppliedParts[suppliedIndex])
        return groups
    }

    function layerChangedAdjustmentGroupSignature(layer) {
        const groups = root.layerChangedAdjustmentGroups(layer)
        const labels = []
        for (let index = 0; index < groups.length; ++index)
            labels.push(groups[index].label)
        return "groups:" + labels.join(",") + "|count:" + groups.length.toString()
    }

    function signedLayerValueText(value, suffix) {
        const numericValue = Number(value || 0)
        const sign = numericValue > 0 ? "+" : ""
        const rounded = Math.abs(numericValue) < 10 && Math.abs(numericValue % 1) > 0.001
                ? numericValue.toFixed(1)
                : Math.round(numericValue).toString()
        return sign + rounded + String(suffix || "")
    }

    function layerLocalAdjustmentSummary(layer) {
        const parts = []
        if (root.layerNumericAdjustmentChanged(layer, "exposure", 0))
            parts.push("Exposure " + root.signedLayerValueText(root.layerStoredAdjustmentValue(layer, "exposure"), " EV"))
        if (root.layerNumericAdjustmentChanged(layer, "temperature", 0))
            parts.push("WB " + root.signedLayerValueText(root.layerStoredAdjustmentValue(layer, "temperature"), ""))
        if (root.layerCurveAdjustmentChanged(layer))
            parts.push("Curve")
        if (root.layerHslAdjustmentChanged(layer)) {
            const hslChannel = root.layerDominantHslChannelName(layer)
            parts.push(hslChannel.length > 0 ? "HSL " + hslChannel : "HSL")
        }
        if (root.layerGradingAdjustmentChanged(layer))
            parts.push("Grade")
        if (root.layerLutAdjustmentChanged(layer))
            parts.push("LUT")
        const suppliedLabel = String(layer && layer.changedAdjustmentGroupLabel || "")
        const suppliedParts = suppliedLabel.split(",")
        for (let suppliedIndex = 0; suppliedIndex < suppliedParts.length; ++suppliedIndex) {
            const label = String(suppliedParts[suppliedIndex] || "").trim()
            if (label.length > 0 && parts.indexOf(label) < 0)
                parts.push(label)
        }
        if (parts.length === 0) {
            const groups = root.layerChangedAdjustmentGroups(layer)
            for (let index = 0; index < Math.min(3, groups.length); ++index)
                parts.push(groups[index].label)
        }
        return parts.length > 0 ? "Layer edits: " + parts.join(", ") : "No layer-local adjustments"
    }

    function globalNumericAdjustmentChanged(key, neutralValue) {
        const field = String(key || "").trim()
        if (field.length === 0)
            return false
        const numericValue = Number(root.editorPreviewController[field] !== undefined && root.editorPreviewController[field] !== null
                                    ? root.editorPreviewController[field] : 0)
        const neutral = Number(neutralValue !== undefined ? neutralValue : root.layerAdjustmentNeutralValue(field))
        return isFinite(numericValue) && Math.abs(numericValue - neutral) > 0.0001
    }

    function globalAnyNumericAdjustmentChanged(keys) {
        for (let index = 0; index < keys.length; ++index) {
            const key = String(keys[index] || "")
            if (root.globalNumericAdjustmentChanged(key, root.layerAdjustmentNeutralValue(key)))
                return true
        }
        return false
    }

    function globalChangedAdjustmentGroups() {
        const groups = []
        if (root.globalAnyNumericAdjustmentChanged(["temperature", "tint"]))
            groups.push({ key: "white-balance", label: "WB" })
        if (root.globalAnyNumericAdjustmentChanged([
                "exposure", "contrast", "highlights", "shadows", "whites", "blacks",
                "brightness", "filmicShoulder", "filmicToe", "adaptiveContrast",
                "levelsBlackPoint", "levelsGamma", "levelsWhitePoint",
                "zoneDeepShadows", "zoneShadows", "zoneMidtones", "zoneLights", "zoneHighlights"
            ]))
            groups.push({ key: "light", label: "Light" })
        if (root.globalAnyNumericAdjustmentChanged([
                "curveShadows", "curveDarks", "curveLights", "curveHighlights"
            ]))
            groups.push({ key: "tone-curve", label: "Curve" })
        if (root.globalAnyNumericAdjustmentChanged([
                "vibrance", "saturation", "hueShift", "saturationShift",
                "colorizeHue", "colorizeStrength"
            ]))
            groups.push({ key: "color", label: "Color" })
        if (root.globalAnyNumericAdjustmentChanged([
                "texture", "clarity", "dehaze", "sharpening", "sharpenRadius",
                "sharpenDetail", "sharpenMasking", "luminanceNr", "colorNr"
            ]))
            groups.push({ key: "detail", label: "Detail" })
        if (root.globalAnyNumericAdjustmentChanged([
                "lensDistortion", "lensVignette", "chromaticAberration",
                "perspectiveVertical", "perspectiveHorizontal", "transformRotation",
                "transformScale", "transformSkewX", "transformSkewY",
                "liquifyCenterX", "liquifyCenterY", "liquifyRadius", "liquifyStrength"
            ]) || Boolean(root.editorPreviewController.contentAwareCropFill))
            groups.push({ key: "lens-transform", label: "Lens" })
        return groups
    }

    function globalChangedAdjustmentGroupSignature() {
        const groups = root.globalChangedAdjustmentGroups()
        const labels = []
        for (let index = 0; index < groups.length; ++index)
            labels.push(groups[index].label)
        return "base-groups:" + labels.join(",") + "|count:" + groups.length.toString()
    }

    function globalAdjustmentSummary() {
        const parts = []
        if (root.globalNumericAdjustmentChanged("exposure", 0))
            parts.push("Exposure " + root.signedLayerValueText(root.editorPreviewController.exposure, " EV"))
        if (root.globalNumericAdjustmentChanged("temperature", 0))
            parts.push("WB " + root.signedLayerValueText(root.editorPreviewController.temperature, ""))
        const groups = root.globalChangedAdjustmentGroups()
        for (let index = 0; index < groups.length && parts.length < 3; ++index) {
            if (parts.indexOf(groups[index].label) < 0)
                parts.push(groups[index].label)
        }
        return parts.length > 0 ? parts.join(", ") : "No global adjustments"
    }

    function baseImageMetadataSummary() {
        const parts = []
        if (root.editorPreviewController.cameraLabel.length > 0)
            parts.push(root.editorPreviewController.cameraLabel)
        if (root.editorPreviewController.lensModel.length > 0 &&
                root.editorPreviewController.lensModel !== root.editorPreviewController.cameraLabel)
            parts.push(root.editorPreviewController.lensModel)
        if (root.editorPreviewController.captureDate.length > 0)
            parts.push(root.editorPreviewController.captureDate)
        return parts.length > 0 ? parts.join(" / ") : "Original image"
    }

    function primaryAdjustmentValue(adjustment, fallbackValue) {
        const layerIndex = root.primaryAdjustmentLayerIndex()
        const layer = layerIndex >= 0 ? (root.photoLayerRows[layerIndex] || ({})) : ({})
        const key = String(adjustment || "")
        if (key.length > 0 && layer[key] !== undefined && layer[key] !== null)
            return Number(layer[key])
        if (layerIndex >= 0 && root.layerAdjustmentKeySupported(key))
            return root.layerAdjustmentNeutralValue(key)
        return Number(fallbackValue || 0)
    }

    function routePrimaryAdjustmentValueCommand(adjustment, value, rawTargets) {
        const numericValue = Number(value)
        const key = String(adjustment || "")
        if (!isFinite(numericValue) || key.length === 0)
            return false
        if (!root.adjustmentControlCanWriteActiveTarget(rawTargets || "base-image,adjustment-layer"))
            return false
        const layerIndex = root.primaryAdjustmentLayerIndex()
        if (layerIndex >= 0 && root.activeEditTargetScope() !== "base-image") {
            return root.editorPreviewController.setPhotoLayerAdjustmentValue(layerIndex, key, numericValue)
        }
        if (!root.globalAdjustmentWritesAllowed())
            return false
        root.editorPreviewController[key] = numericValue
        return true
    }

    function setPrimaryAdjustmentValue(adjustment, value) {
        return root.routePrimaryAdjustmentValueCommand(adjustment, value, "base-image,adjustment-layer")
    }

    function setPrimaryBaseAdjustmentValue(adjustment, value) {
        return root.routePrimaryAdjustmentValueCommand(adjustment, value, "base-image")
    }

    function layerAdjustmentObject(layer, objectName) {
        const adjustments = layer && layer.adjustments ? layer.adjustments : ({})
        const value = adjustments[objectName] !== undefined && adjustments[objectName] !== null
                ? adjustments[objectName]
                : (layer && layer[objectName] !== undefined ? layer[objectName] : ({}))
        return value || ({})
    }

    function layerAdjustmentChildObject(parent, childName) {
        const value = parent && parent[childName] !== undefined && parent[childName] !== null
                ? parent[childName]
                : ({})
        return value || ({})
    }

    function primaryStringAdjustmentValue(adjustment, fallbackValue) {
        const layer = root.activeAdjustmentLayerData()
        const key = String(adjustment || "")
        if (root.activeAdjustmentLayerIndex() >= 0) {
            const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
            if (key === "colorMixerModel")
                return String(colorMixer.model !== undefined ? colorMixer.model : (layer.colorMixerModel !== undefined ? layer.colorMixerModel : fallbackValue))
            if (key === "hslChannel")
                return String(colorMixer.channel !== undefined ? colorMixer.channel : (layer.hslChannel !== undefined ? layer.hslChannel : fallbackValue))
            if (key === "colorHarmonyMode") {
                const harmony = root.layerAdjustmentChildObject(colorMixer, "colorHarmony")
                return String(harmony.mode !== undefined ? harmony.mode : fallbackValue)
            }
        }
        return String(fallbackValue || "")
    }

    function routePrimaryAdjustmentStringCommand(adjustment, value, rawTargets) {
        if (!root.adjustmentControlCanWriteActiveTarget(rawTargets || "base-image,adjustment-layer"))
            return false
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex >= 0)
            return root.editorPreviewController.setPhotoLayerAdjustmentString(layerIndex, adjustment, String(value || ""))
        if (!root.globalAdjustmentWritesAllowed())
            return false
        root.editorPreviewController[adjustment] = String(value || "")
        return true
    }

    function setPrimaryStringAdjustmentValue(adjustment, value) {
        return root.routePrimaryAdjustmentStringCommand(adjustment, value, "base-image,adjustment-layer")
    }

    function primaryBoolAdjustmentValue(adjustment, fallbackValue) {
        const layer = root.activeAdjustmentLayerData()
        const key = String(adjustment || "")
        if (root.activeAdjustmentLayerIndex() >= 0) {
            if (key === "contentAwareCropFill")
                return Boolean(layer[key] !== undefined ? layer[key] : fallbackValue)
            const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
            const childName = key === "blackAndWhiteEnabled" ? "blackAndWhite"
                    : key.indexOf("colorReplacement") === 0 ? "colorReplacement"
                    : key.indexOf("skinToneProtection") === 0 ? "skinToneProtection"
                    : key.indexOf("colorHarmony") === 0 ? "colorHarmony"
                    : ""
            const fieldName = key === "blackAndWhiteEnabled" || key === "colorReplacementEnabled" ||
                    key === "skinToneProtectionEnabled" || key === "colorHarmonyEnabled" ? "enabled"
                    : key === "colorReplacementPreserveLuminance" ? "preserveLuminance"
                    : key === "colorReplacementPreserveSaturation" ? "preserveSaturation"
                    : ""
            if (childName.length > 0 && fieldName.length > 0) {
                const child = root.layerAdjustmentChildObject(colorMixer, childName)
                return Boolean(child[fieldName] !== undefined ? child[fieldName] : fallbackValue)
            }
        }
        return Boolean(fallbackValue)
    }

    function routePrimaryAdjustmentBoolCommand(adjustment, value, rawTargets) {
        if (!root.adjustmentControlCanWriteActiveTarget(rawTargets || "base-image,adjustment-layer"))
            return false
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex >= 0)
            return root.editorPreviewController.setPhotoLayerAdjustmentBool(layerIndex, adjustment, Boolean(value))
        if (!root.globalAdjustmentWritesAllowed())
            return false
        root.editorPreviewController[adjustment] = Boolean(value)
        return true
    }

    function setPrimaryBoolAdjustmentValue(adjustment, value) {
        return root.routePrimaryAdjustmentBoolCommand(adjustment, value, "base-image,adjustment-layer")
    }

    function setPrimaryBaseBoolAdjustmentValue(adjustment, value) {
        return root.routePrimaryAdjustmentBoolCommand(adjustment, value, "base-image")
    }

    function applyPrimaryChannelMixerPreset(presetName) {
        const name = String(presetName || "")
        const values = name === "Monochrome"
                ? [33, 33, 34, 33, 33, 34, 33, 33, 34]
                : name === "Swap Red Blue"
                  ? [0, 0, 100, 0, 100, 0, 100, 0, 0]
                  : [100, 0, 0, 0, 100, 0, 0, 0, 100]
        const keys = [
            "channelMixerRedFromRed", "channelMixerRedFromGreen", "channelMixerRedFromBlue",
            "channelMixerGreenFromRed", "channelMixerGreenFromGreen", "channelMixerGreenFromBlue",
            "channelMixerBlueFromRed", "channelMixerBlueFromGreen", "channelMixerBlueFromBlue"
        ]
        if (!root.adjustmentControlCanWriteActiveTarget("base-image,adjustment-layer"))
            return false
        root.editorPreviewController.beginCoalescedEdit()
        let applied = false
        for (let index = 0; index < keys.length; ++index)
            applied = root.setPrimaryAdjustmentValue(keys[index], values[index]) || applied
        root.editorPreviewController.endCoalescedEdit()
        return applied
    }

    function resetPrimaryChannelMixerRow(rowName) {
        const row = String(rowName || "").toLowerCase()
        const prefix = row === "green" ? "channelMixerGreen" : row === "blue" ? "channelMixerBlue" : "channelMixerRed"
        const own = row === "green" ? "FromGreen" : row === "blue" ? "FromBlue" : "FromRed"
        if (!root.adjustmentControlCanWriteActiveTarget("base-image,adjustment-layer"))
            return false
        root.editorPreviewController.beginCoalescedEdit()
        const red = root.setPrimaryAdjustmentValue(prefix + "FromRed", own === "FromRed" ? 100 : 0)
        const green = root.setPrimaryAdjustmentValue(prefix + "FromGreen", own === "FromGreen" ? 100 : 0)
        const blue = root.setPrimaryAdjustmentValue(prefix + "FromBlue", own === "FromBlue" ? 100 : 0)
        root.editorPreviewController.endCoalescedEdit()
        return red || green || blue
    }

    function primaryColorMixerChannelValue(fieldName, fallbackValue) {
        const layer = root.activeAdjustmentLayerData()
        if (root.activeAdjustmentLayerIndex() >= 0) {
            const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
            const channels = colorMixer.channels || ({})
            const channelName = root.primaryStringAdjustmentValue("hslChannel", root.editorPreviewController.hslChannel)
            const channel = channels[channelName] || ({})
            if (channel[fieldName] !== undefined && channel[fieldName] !== null)
                return Number(channel[fieldName])
            return 0
        }
        return Number(fallbackValue || 0)
    }

    function primaryNestedAdjustmentValue(objectName, childName, fieldName, fallbackValue) {
        const layer = root.activeAdjustmentLayerData()
        if (root.activeAdjustmentLayerIndex() >= 0) {
            const object = root.layerAdjustmentObject(layer, objectName)
            const child = childName.length > 0 ? root.layerAdjustmentChildObject(object, childName) : object
            if (child[fieldName] !== undefined && child[fieldName] !== null)
                return Number(child[fieldName])
            return Number(fallbackValue || 0)
        }
        return Number(fallbackValue || 0)
    }

    function primaryChannelMixerValue(fieldName, fallbackValue) {
        return root.primaryNestedAdjustmentValue("colorMixer", "rgbChannelMixer", fieldName, fallbackValue)
    }

    function primaryBlackAndWhiteValue(channelName, fallbackValue) {
        const layer = root.activeAdjustmentLayerData()
        if (root.activeAdjustmentLayerIndex() >= 0) {
            const colorMixer = root.layerAdjustmentObject(layer, "colorMixer")
            const blackAndWhite = root.layerAdjustmentChildObject(colorMixer, "blackAndWhite")
            const channels = blackAndWhite.channels || ({})
            if (channels[channelName] !== undefined && channels[channelName] !== null)
                return Number(channels[channelName])
            return 0
        }
        return Number(fallbackValue || 0)
    }

    function primaryColorReplacementValue(fieldName, fallbackValue) {
        return root.primaryNestedAdjustmentValue("colorMixer", "colorReplacement", fieldName, fallbackValue)
    }

    function primarySkinToneValue(fieldName, fallbackValue) {
        return root.primaryNestedAdjustmentValue("colorMixer", "skinToneProtection", fieldName, fallbackValue)
    }

    function primaryHarmonyValue(fieldName, fallbackValue) {
        return root.primaryNestedAdjustmentValue("colorMixer", "colorHarmony", fieldName, fallbackValue)
    }

    function primaryGradingValue(zoneName, fieldName, fallbackValue) {
        return root.primaryNestedAdjustmentValue("colorGrading", zoneName, fieldName, fallbackValue)
    }

    function routePrimaryAdjustmentResetCommand(groupName, rawTargets) {
        if (!root.adjustmentControlCanWriteActiveTarget(rawTargets || "base-image,adjustment-layer"))
            return false
        const layerIndex = root.activeAdjustmentLayerIndex()
        const group = String(groupName || "")
        const layerGroupKey = group.replace(/[ _-]/g, "").toLowerCase()
        const layerResetGroups = [
            "whitebalance", "wb", "light", "tone", "color", "colormixer", "hsl",
            "rgbmixer", "channelmixer", "rgbchannelmixer", "blackandwhite", "bw",
            "colorreplacement", "skintone", "skinprotection", "skintoneprotection",
            "colorharmony", "harmony", "colorgrading", "grading", "lut", "tonecurve", "curve",
            "presence", "detail", "effects", "lens", "transform", "geometry"
        ]
        if (layerIndex >= 0 && layerResetGroups.indexOf(layerGroupKey) >= 0)
            return root.editorPreviewController.resetPhotoLayerAdjustmentGroup(layerIndex, group)
        if (!root.globalAdjustmentWritesAllowed())
            return false
        return root.editorPreviewController.resetAdjustmentGroup(group)
    }

    function routePrimaryPresetCommand(presetName, rawTargets) {
        if (!root.adjustmentControlCanWriteActiveTarget(rawTargets || "base-image,adjustment-layer"))
            return false
        const name = String(presetName || "")
        if (name.length === 0)
            return false
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex >= 0) {
            return root.editorPreviewController.applyPresetToPhotoLayer(layerIndex, name, root.editorPreviewController.presetIntensity, [])
        }
        if (!root.globalAdjustmentWritesAllowed())
            return false
        return root.editorPreviewController.applyPresetWithIntensity(name, root.editorPreviewController.presetIntensity, [])
    }

    function layerLocalPresetApplicationSignature() {
        return "layer-local-preset-apply:v1" +
                "|target:" + root.activeEditTargetScope() +
                "|layer-index:" + root.activeAdjustmentLayerIndex() +
                "|uses-applyPresetToPhotoLayer:true" +
                "|uses-applyPresetWithIntensity-only-for-base:true" +
                "|no-global-fallback:true"
    }

    function resetPrimaryAdjustmentGroup(groupName) {
        return root.routePrimaryAdjustmentResetCommand(groupName, "base-image,adjustment-layer")
    }

    function resetActiveAdjustmentLayerRecipe() {
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex < 0)
            return false
        return root.editorPreviewController.resetPhotoLayerAdjustments(layerIndex)
    }

    function curvePoint(x, y) {
        return { "x": Number(x), "y": Number(y) }
    }

    function defaultCurvePoints() {
        return [
            root.curvePoint(0.0, 0.0),
            root.curvePoint(1.0, 1.0)
        ]
    }

    function layerCurvePointOutput(x, delta) {
        return Math.max(0, Math.min(1, Number(x) + (Number(delta || 0) / 100.0) * 0.34))
    }

    function layerParametricCurvePoints(layer) {
        return [
            root.curvePoint(0.0, 0.0),
            root.curvePoint(0.20, root.layerCurvePointOutput(0.20, layer.curveShadows)),
            root.curvePoint(0.40, root.layerCurvePointOutput(0.40, layer.curveDarks)),
            root.curvePoint(0.65, root.layerCurvePointOutput(0.65, layer.curveLights)),
            root.curvePoint(0.85, root.layerCurvePointOutput(0.85, layer.curveHighlights)),
            root.curvePoint(1.0, 1.0)
        ]
    }

    function layerCurvePointKey(channel) {
        const normalized = String(channel || "RGB").trim()
        if (normalized === "RGB" || normalized === "Master")
            return "masterCurvePoints"
        if (normalized === "Luma")
            return "lumaCurvePoints"
        if (normalized === "Red")
            return "redCurvePoints"
        if (normalized === "Green")
            return "greenCurvePoints"
        return "blueCurvePoints"
    }

    function primaryCurveMode() {
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex < 0)
            return root.editorPreviewController.activeCurveMode
        const layer = root.photoLayerRows[layerIndex] || ({})
        const key = root.layerCurvePointKey(root.editorPreviewController.curveChannel)
        const points = layer[key]
        if (points && points.length >= 2)
            return "Point"
        const channel = String(root.editorPreviewController.curveChannel || "RGB")
        if ((channel === "RGB" || channel === "Master") &&
                (Number(layer.curveShadows || 0) !== 0 || Number(layer.curveDarks || 0) !== 0 ||
                 Number(layer.curveLights || 0) !== 0 || Number(layer.curveHighlights || 0) !== 0))
            return "Parametric"
        return "Neutral"
    }

    function primaryCurvePoints() {
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex < 0)
            return root.editorPreviewController.activeCurvePoints
        const layer = root.photoLayerRows[layerIndex] || ({})
        const key = root.layerCurvePointKey(root.editorPreviewController.curveChannel)
        const points = layer[key]
        if (points && points.length >= 2)
            return points
        const channel = String(root.editorPreviewController.curveChannel || "RGB")
        if ((channel === "RGB" || channel === "Master") &&
                (Number(layer.curveShadows || 0) !== 0 || Number(layer.curveDarks || 0) !== 0 ||
                 Number(layer.curveLights || 0) !== 0 || Number(layer.curveHighlights || 0) !== 0))
            return root.layerParametricCurvePoints(layer)
        return root.defaultCurvePoints()
    }

    function setPrimaryCurvePoints(points) {
        if (!root.adjustmentControlCanWriteActiveTarget("base-image,adjustment-layer"))
            return false
        const layerIndex = root.primaryAdjustmentLayerIndex()
        if (layerIndex >= 0 && root.activeEditTargetScope() !== "base-image")
            return root.editorPreviewController.setPhotoLayerCurvePoints(layerIndex, root.editorPreviewController.curveChannel, points)
        if (!root.globalAdjustmentWritesAllowed())
            return false
        root.editorPreviewController.activeCurvePoints = points
        return true
    }

    function applyPrimaryCurvePreset(presetName) {
        return root.setPrimaryCurvePoints(root.editorPreviewController.curvePresetPreviewPoints(String(presetName || "")))
    }

    function photoLayerHasDirectTransform(layer) {
        const kind = String(layer.kind || "").trim().toLowerCase()
        // Groups composite their children into the sequence canvas before the
        // group transform is applied, so their transform frame is canvas-sized.
        if (kind === "group")
            return true
        return (kind === "pixel" || kind === "text" || kind === "source") &&
               Number(layer.pixelWidth || 0) > 0 &&
               Number(layer.pixelHeight || 0) > 0
    }

    function photoTextDimensionGeometryContainsPoint(geometry, x, y) {
        const points = geometry && Array.isArray(geometry.outline) ? geometry.outline : []
        if (points.length !== 4 || !Number.isFinite(Number(x)) || !Number.isFinite(Number(y)))
            return false
        let hasPositive = false
        let hasNegative = false
        for (let index = 0; index < points.length; ++index) {
            const first = points[index]
            const second = points[(index + 1) % points.length]
            if (!first || !second || !Number.isFinite(Number(first.x)) || !Number.isFinite(Number(first.y)) ||
                    !Number.isFinite(Number(second.x)) || !Number.isFinite(Number(second.y)))
                return false
            const cross = (Number(second.x) - Number(first.x)) * (Number(y) - Number(first.y)) -
                (Number(second.y) - Number(first.y)) * (Number(x) - Number(first.x))
            if (Math.abs(cross) <= 1e-8)
                continue
            if (cross > 0) hasPositive = true
            else hasNegative = true
            if (hasPositive && hasNegative)
                return false
        }
        return true
    }

    function photoLayerAtViewportPoint(viewportX, viewportY) {
        const viewport = root.editViewportHandle
        if (!viewport)
            return -1
        const sourceWidth = Number(root.editorPreviewController.sourceImageWidth || 0)
        const sourceHeight = Number(root.editorPreviewController.sourceImageHeight || 0)
        const paintedWidth = Number(viewport.paintedContentWidth || 0)
        const paintedHeight = Number(viewport.paintedContentHeight || 0)
        if (sourceWidth <= 0 || sourceHeight <= 0 || paintedWidth <= 0 || paintedHeight <= 0)
            return -1

        const sourceX = (viewportX - viewport.paintedContentX) * sourceWidth / paintedWidth
        const sourceY = (viewportY - viewport.paintedContentY) * sourceHeight / paintedHeight
        if (sourceX < 0 || sourceY < 0 || sourceX > sourceWidth || sourceY > sourceHeight) {
            // The selected linked photo stays draggable by its dimmed overflow.
            // Unselected content outside the board remains background/navigation.
            const selected = root.normalizedActivePhotoLayerIndex()
            const photo = root.currentPhotoLayerData()
            return root.editBoardMode && selected >= 0 && photo.kind === "source" &&
                photo.enabled !== false && Number(photo.opacity === undefined ? 1 : photo.opacity) > 0 &&
                !String(photo.parentId || "").length &&
                root.editorPreviewController.photoLayerContainsPoint(selected, sourceX, sourceY) ? selected : -1
        }
        let fillIndex = -1
        for (let rowIndex = 0; rowIndex < root.editorPreviewController.photoLayerCount; ++rowIndex) {
            const layer = root.photoLayerRows[rowIndex] || ({})
            const layerIndex = Number(layer.flatIndex !== undefined ? layer.flatIndex : rowIndex)
            const kind = String(layer.kind || "").trim().toLowerCase()
            if (layer.enabled === false || Number(layer.opacity !== undefined ? layer.opacity : 1) <= 0)
                continue
            if (kind === "fill" && fillIndex < 0)
                fillIndex = layerIndex
            // Color adjustments have no selectable object geometry. Let clicks
            // reach the text, shape, or image underneath them.
            const canvasHitLayer = kind !== "group" &&
                                   root.photoLayerHasDirectTransform(layer)
            if (layer.enabled === false || !canvasHitLayer)
                continue
            if (kind === "text") {
                let dimension = ({})
                try { dimension = root.editorPreviewController.photoLayerTextDimension(layerIndex) || ({}) }
                catch (error) { dimension = layer.textDimension || ({}) }
                if (dimension.enabled === true || dimension.cornerPinEnabled === true) {
                    let geometry = ({})
                    try { geometry = root.editorPreviewController.photoTextDimensionCanvasGeometry(layerIndex) || ({}) }
                    catch (error) { geometry = ({}) }
                    const normalizedViewX = (viewportX - viewport.paintedContentX) / paintedWidth
                    const normalizedViewY = (viewportY - viewport.paintedContentY) / paintedHeight
                    if (geometry.valid === true && root.photoTextDimensionGeometryContainsPoint(
                            geometry, normalizedViewX, normalizedViewY))
                        return layerIndex
                    continue
                }
            }
            const bounds = root.editorPreviewController.photoLayerBounds(layerIndex) || ({})
            const left = Number(bounds.x || 0)
            const top = Number(bounds.y || 0)
            const width = Number(bounds.width || 0)
            const height = Number(bounds.height || 0)
            if (width <= 0 || height <= 0)
                continue

            const centerX = left + width / 2
            const centerY = top + height / 2
            const radians = Number(bounds.rotation || 0) * Math.PI / 180
            const deltaX = sourceX - centerX
            const deltaY = sourceY - centerY
            const localX = centerX + deltaX * Math.cos(radians) + deltaY * Math.sin(radians)
            const localY = centerY - deltaX * Math.sin(radians) + deltaY * Math.cos(radians)
            if (localX >= left && localX <= left + width &&
                    localY >= top && localY <= top + height &&
                    root.editorPreviewController.photoLayerContainsPoint(layerIndex, sourceX, sourceY))
                return layerIndex
        }
        return fillIndex
    }

    function selectPhotoLayerAtViewportPoint(viewportX, viewportY, modifiers) {
        const viewport = root.editViewportHandle
        if (root.editBoardMode && viewport && viewport.boardStageActive) {
            const board = viewport.boardIndexAtPoint(viewportX, viewportY)
            // Every tile in the active span shares the same live photo layers.
            if (board >= 0 && !viewport.boardInActiveCanvas(board)) return false
        }
        const layerIndex = root.photoLayerAtViewportPoint(viewportX, viewportY)
        if (layerIndex < 0) return false
        if (Number(modifiers || 0) & (Qt.ControlModifier | Qt.MetaModifier | Qt.ShiftModifier))
            return root.selectPhotoLayerWithModifiers(layerIndex, modifiers)
        if (root.normalizedPhotoLayerSelection().indexOf(layerIndex) >= 0)
            return root.setSelectedEditTarget(root.selectedLayerTargetScope(layerIndex), layerIndex, ({}), -1)
        return root.setActivePhotoLayer(layerIndex)
    }

    function basicBoardPhotoSelection(rows) {
        const layers = rows || root.photoLayerRows
        return movablePhotoLayerSelection().filter(function(index) {
            const layer = layers[index] || ({})
            return root.isBoardPhotoLayer(layer)
        })
    }

    function isBoardPhotoLayer(layer) {
        return (layer.kind === "source" || (layer.kind === "pixel" && !layer.paintTiles &&
                !layer.copyBaseImage && !Object.keys(layer.shapeDefinition || ({})).length &&
                !Object.keys(layer.vectorPath || ({})).length)) && layer.locked !== true &&
                layer.enabled !== false && !String(layer.parentId || "").length
    }

    function boardPhotoLayoutTargets(rows) {
        const layers = rows || root.photoLayerRows
        const selected = basicBoardPhotoSelection(layers)
        if (selected.length > 1) return selected
        const targets = []
        layers.forEach(function(layer, index) {
            if (root.isBoardPhotoLayer(layer)) targets.push(index)
        })
        return targets
    }

    function applyBasicBoardPhotoLayout(preset, options, targetIndices) {
        const layers = root.editorPreviewController.photoLayerSnapshot()
        const indices = targetIndices || ((preset === "fit" || preset === "fill") ? basicBoardPhotoSelection(layers) : boardPhotoLayoutTargets(layers))
        const settings = Object.assign({}, options || ({}))
        settings.displayReferredCanvas = root.activeEditBoard.compositionCanvas === true
        const sourceRecipes = []
        if (root.catalogAssets) for (const index of indices) {
            const layer = layers[index] || ({})
            if (layer.kind !== "source" || layer.sourceRecipeJson || layer.boardVideoSource) continue
            const assetId = root.catalogAssets.assetIdForFilePath(String(layer.sourcePath || ""))
            if (!assetId) continue
            const asset = root.catalogAssets.assetForPhotoPlacement(assetId)
            if (!asset.assetId) {
                root.showEditActionFeedback(qsTr("Loading the photos’ saved edits. Apply the layout when loading finishes."), false)
                return false
            }
            if (asset.adjustmentPatchJson) sourceRecipes.push({index: index, asset: asset})
        }
        const viewport = root.editViewportHandle
        if (root.editBoardMode && viewport && viewport.paintedContentWidth > 0 && viewport.paintedContentHeight > 0) {
            const sx = viewport.paintedContentWidth / root.editorPreviewController.sourceImageWidth
            const sy = viewport.paintedContentHeight / root.editorPreviewController.sourceImageHeight
            settings.canvasX = Math.round((viewport.imageFrameX - viewport.paintedContentX) / sx)
            settings.canvasY = Math.round((viewport.imageFrameY - viewport.paintedContentY) / sy)
            settings.canvasWidth = Math.round(viewport.imageFrameWidth * viewport.zoom / sx)
            settings.canvasHeight = Math.round(viewport.boardUnitHeight * viewport.zoom / sy)
        }
        root.editorPreviewController.beginCoalescedEdit()
        for (const source of sourceRecipes)
            root.editorPreviewController.setSourceLayerRecipe(source.index, source.asset.adjustmentPatchJson, source.asset.assetId)
        const applied = root.editorPreviewController.applyBoardPhotoLayout(indices, preset, settings)
        root.editorPreviewController.endCoalescedEdit()
        if (!applied) {
            root.showEditActionFeedback(qsTr("Choose photos or videos and reduce margins, spacing, or borders to fit the board."), true)
            return false
        }
        root.editTool = "layers"
        root.editInspectorTab = "layers"
        return true
    }

    function savedBoardPhotoLayoutSettings(rows) {
        for (const layer of (rows || root.photoLayerRows)) {
            if (layer.boardPhotoLayoutSettings && layer.boardPhotoLayoutSettings.preset)
                return layer.boardPhotoLayoutSettings
        }
        return {preset: "stack", margin: 0, spacing: 0, border: 4}
    }

    function reapplyBoardPhotoLayout() {
        // Commands use the current controller stack, including every member of a
        // just-imported batch; the inspector snapshot can publish on a later turn.
        const layers = root.editorPreviewController.photoLayerSnapshot()
        const indices = []
        layers.forEach(function(layer, index) { if (root.isBoardPhotoLayer(layer)) indices.push(index) })
        if (indices.length < 2) return false
        const settings = savedBoardPhotoLayoutSettings(layers)
        const preset = ["stack", "columns", "grid"].indexOf(settings.preset) >= 0 ? settings.preset : "stack"
        return applyBasicBoardPhotoLayout(preset, settings, indices)
    }

    function movablePhotoLayerSelection() {
        const selected = root.normalizedPhotoLayerSelection()
        const active = root.normalizedActivePhotoLayerIndex()
        return selected.length > 0 ? selected : active >= 0 ? [active] : []
    }

    function movePhotoLayerSelection(deltaX, deltaY) {
        return root.editorPreviewController.movePhotoLayersByPixels(root.movablePhotoLayerSelection(),
                                                     Math.round(deltaX), Math.round(deltaY))
    }

    function nudgeArrowKey(key) {
        return key === Qt.Key_Left || key === Qt.Key_Right || key === Qt.Key_Up || key === Qt.Key_Down
    }

    function handleLayerNudgePress(event) {
        if (!root.nudgeArrowKey(event.key) || !root.layerNudgeContextActive ||
                event.modifiers !== Qt.NoModifier) return false
        event.accepted = true
        if (event.isAutoRepeat || root.layerNudgeKeys.indexOf(event.key) >= 0) return true
        // Layer rows can be recreated when their preview data refreshes.
        // Keep the held gesture on the stable workspace focus owner.
        root.forceActiveFocus()
        if (root.layerNudgeKeys.length === 0) {
            root.editorPreviewController.beginCoalescedEdit()
            root.layerNudgeRepeating = false
            root.layerNudgeNextAtMs = Date.now() + 250
            layerNudgeTimer.start()
        }
        root.layerNudgeKeys = root.layerNudgeKeys.concat([event.key])
        root.nudgeLayerKeys([event.key])
        return true
    }

    function nudgeLayerKeys(keys, pixels) {
        const step = pixels === undefined ? 1 : pixels
        const dx = (keys.indexOf(Qt.Key_Right) >= 0 ? 1 : 0) - (keys.indexOf(Qt.Key_Left) >= 0 ? 1 : 0)
        const dy = (keys.indexOf(Qt.Key_Down) >= 0 ? 1 : 0) - (keys.indexOf(Qt.Key_Up) >= 0 ? 1 : 0)
        root.movePhotoLayerSelection(dx * step, dy * step)
    }

    function finishLayerNudge() {
        layerNudgeTimer.stop()
        if (root.layerNudgeKeys.length === 0) return
        root.layerNudgeKeys = []
        root.layerNudgeRepeating = false
        root.editorPreviewController.endCoalescedEdit()
    }

    Timer {
        id: layerNudgeTimer
        objectName: "photoLayerNudgeTimer"
        interval: root.layerNudgeRepeating ? 16 : 250
        repeat: false
        onTriggered: {
            if (!root.layerNudgeContextActive) {
                root.finishLayerNudge()
                return
            }
            root.layerNudgeRepeating = true
            // Keep pixel speed stable when a preview delays a timer callback.
            // Bound catch-up so returning from a stalled frame cannot jump far.
            const pixels = Math.max(1, Math.min(8, Math.floor((Date.now() - root.layerNudgeNextAtMs) / 16) + 1))
            root.layerNudgeNextAtMs += pixels * 16
            root.nudgeLayerKeys(root.layerNudgeKeys, pixels)
            restart()
        }
    }

    Connections {
        target: root.Window.window
        function onActiveChanged() {
            if (!root.Window.window.active) root.finishLayerNudge()
        }
        function onActiveFocusItemChanged() { root.finishLayerNudge() }
    }

    function photoLayerIconName(layer) {
        const kind = String(layer.kind || "").trim().toLowerCase()
        if (kind === "pixel" && Object.keys((layer && layer.shapeDefinition) || ({})).length > 0)
            return "geometry"
        if (kind === "source")
            return "source"
        if (kind === "pixel")
            return "media"
        if (kind === "text")
            return "edit"
        if (kind === "group")
            return "grid"
        return "adjust"
    }

    function maskSourceIconName(kindName) {
        const kind = String(kindName || "").trim().toLowerCase()
        if (kind === "brush")
            return "brush-tool"
        if (kind === "lasso")
            return "lasso"
        if (kind === "polygon")
            return "polygon-tool"
        if (kind === "object" || kind === "subject" || kind === "sky" || kind === "background")
            return "smart-select"
        if (kind === "linear" || kind === "rectangle")
            return "geometry"
        if (kind === "radial" || kind === "ellipse")
            return "masks"
        if (kind === "luminance" || kind === "color" || kind === "depth" ||
                kind === "luminance_range" || kind === "color_range" ||
                kind === "depth_range")
            return "filter"
        if (kind === "composite")
            return "masks"
        return "masks"
    }

    function layerSnapTargets(viewport, horizontal) {
        const sourceExtent = horizontal ? root.editorPreviewController.sourceImageWidth : root.editorPreviewController.sourceImageHeight
        const imageStart = horizontal ? viewport.paintedContentX : viewport.paintedContentY
        const imageExtent = horizontal ? viewport.paintedContentWidth : viewport.paintedContentHeight
        if (!(sourceExtent > 0 && imageExtent > 0)) return []
        const scale = imageExtent / sourceExtent
        const targets = []
        const add = function(pixel, label) { targets.push({ position: (pixel - imageStart) / scale, label: label }) }
        if (root.editBoardMode) {
            const first = Number(root.activeEditBoard.imageSpanStart || 0)
            const count = root.activeEditBoardSpan
            const start = horizontal ? viewport.imageFrameX : viewport.imageFrameY
            const extent = (horizontal ? viewport.boardUnitWidth : viewport.boardUnitHeight) * viewport.zoom
            const tiles = horizontal ? count : 1
            for (let tile = 0; tile < tiles; ++tile) {
                const offset = start + tile * extent
                add(offset, horizontal && tile > 0 ? qsTr("Board seam") : qsTr("Board edge"))
                add(offset + extent / 2, qsTr("Board %1 center").arg(horizontal ? first + tile + 1 : root.editBoardIndex + 1))
                if (root.layerSafeMarginsEnabled) {
                    add(offset + extent * 0.05, qsTr("Safe margin"))
                    add(offset + extent * 0.95, qsTr("Safe margin"))
                }
            }
            add(start + tiles * extent, qsTr("Board edge"))
        } else {
            add(imageStart, qsTr("Image edge"))
            add(imageStart + imageExtent / 2, qsTr("Image center"))
            add(imageStart + imageExtent, qsTr("Image edge"))
            if (root.layerSafeMarginsEnabled) {
                add(imageStart + imageExtent * 0.05, qsTr("Safe margin"))
                add(imageStart + imageExtent * 0.95, qsTr("Safe margin"))
            }
        }
        return targets.concat(editGuideState.snapTargets(horizontal))
    }

    function sourceCanvasWidthForLayers(layer) {
        const sourceWidth = Number(root.editorPreviewController.sourceImageWidth || 0)
        if (sourceWidth > 0)
            return sourceWidth
        return Math.max(1, Number(layer.x || 0) + Number(layer.pixelWidth || 0) * Number(layer.scale || 1))
    }

    function sourceCanvasHeightForLayers(layer) {
        const sourceHeight = Number(root.editorPreviewController.sourceImageHeight || 0)
        if (sourceHeight > 0)
            return sourceHeight
        return Math.max(1, Number(layer.y || 0) + Number(layer.pixelHeight || 0) * Number(layer.scale || 1))
    }

    function setActivePhotoLayer(index) {
        if (!root.resolveTextSession()) return false
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        if ((root.photoLayerRows[index] || ({})).baseImageEdit === true)
            return root.activateBaseImageLayerTarget()
        if (root.editorPreviewController.selectionEditSessionActive)
            return root.queueSelectionAction("layer:" + root.photoLayerIdentityAt(index))
        if (!root.setActivePhotoLayerSelection(index, false)) return false
        root.editInspectorPanelVisible = true
        root.editTool = "layers"
        root.editInspectorTab = "layers"
        root.clearTransientMaskTools()
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        return true
    }

    function queueLayerToolActivation(index) {
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        root.pendingLayerActivationIndex = index
        layerToolActivationTimer.restart()
        return true
    }

    function completePendingLayerToolActivation() {
        const index = root.pendingLayerActivationIndex
        root.pendingLayerActivationIndex = -1
        if (root.editTool !== "layers" || index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        return root.setActivePhotoLayer(index)
    }

    function editPhotoLayerInspectorTarget(index) {
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        if ((root.photoLayerRows[index] || ({})).baseImageEdit === true)
            return root.activateBaseImageLayerTarget()
        if (root.editorPreviewController.selectionEditSessionActive)
            return root.queueSelectionAction("edit-layer:" + root.photoLayerIdentityAt(index))
        if (!root.setActivePhotoLayerSelection(index, false))
            return false
        root.editInspectorPanelVisible = true
        if (["adjustment", "pixel", "source"].indexOf(root.photoLayerKind(index)) >= 0) {
            root.activateEditTool("adjust")
        } else {
            root.editTool = "layers"
            root.editInspectorTab = "layers"
        }
        return true
    }

    function openPhotoLayerInspector(index) {
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        if ((root.photoLayerRows[index] || ({})).baseImageEdit === true)
            return root.activateBaseImageLayerTarget()
        root.editInspectorPanelVisible = true
        root.editTool = "layers"
        root.editInspectorTab = "layers"
        root.clearTransientMaskTools()
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        return true
    }

    function activateLayerAdjustmentGroup(layerIndex, groupKey) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        root.setActivePhotoLayerSelection(index, false)
        root.activateEditTool("adjust")
        root.activeAdjustmentIntent = root.adjustmentIntentForGroup(groupKey)
        root.selectedEditLayer = root.adjustmentGroupEditStack(groupKey)
        root.editTool = root.selectedEditLayer === "adjustments" ? "adjust" : root.selectedEditLayer
        root.editInspectorTab = "adjust"
        root.editAdjustmentFilterText = root.adjustmentGroupFilterText(groupKey)
        if (root.selectedEditLayer === "curve")
            root.editorPreviewController.curveChannel = "RGB"
        else if (root.selectedEditLayer === "hsl")
            root.setPrimaryStringAdjustmentValue("hslChannel", "Blues")
        return true
    }

    function selectEditStack(index) {
        const keys = ["adjustments", "color", "hsl", "curve", "detail", "lens", "crop"]
        root.selectedEditLayer = keys[Math.max(0, Math.min(keys.length - 1, index))]
        root.editTool = root.selectedEditLayer
        root.editInspectorTab = root.selectedEditLayer === "crop" ? "crop" : "adjust"
        if (index === 2)
            root.setPrimaryStringAdjustmentValue("hslChannel", "Blues")
        else if (index === 3)
            root.editorPreviewController.curveChannel = "RGB"
        else if (index === 6) {
            root.cropToolMode = "crop"
            root.editorPreviewController.cropEditing = true
        } else {
            root.editorPreviewController.cropEditing = false
        }
    }

