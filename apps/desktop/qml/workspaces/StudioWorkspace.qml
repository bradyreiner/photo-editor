    function clamp(value, low, high) {
        return Math.max(low, Math.min(high, value))
    }

    function thumbnailScreenDevicePixelRatio() {
        return Math.max(1.0, Number(Screen.devicePixelRatio || 1.0))
    }

    function thumbnailSourceSizeForDisplay(displayPixels, backingPixels) {
        return Math.max(0, Math.max(Number(backingPixels || 0),
                                   Math.round(Math.max(1, Number(displayPixels || 1)) *
                                              root.thumbnailScreenDevicePixelRatio())))
    }

    function libraryGalleryAspectKey(index, thumbnailSource, knownAssetId) {
        const asset = knownAssetId ? ({ assetId: knownAssetId }) : root.assetAt(index)
        const assetId = String(asset.assetId || "")
        if (assetId.length > 0)
            return assetId
        const source = String(thumbnailSource || asset.thumbnailSource || "")
        return source.length > 0 ? source : String(index)
    }

    function libraryGalleryAspectRatio(index, thumbnailSource, knownAssetId) {
        const revision = root.libraryGalleryAspectRevision
        const key = root.libraryGalleryAspectKey(index, thumbnailSource, knownAssetId)
        const ratio = Number(root.libraryGalleryAspectRatios[key] || 0)
        if (revision >= 0 && ratio > 0)
            return root.clamp(ratio, 0.28, 4.5)
        return 1.5
    }

    function setLibraryGalleryAspectRatio(index, thumbnailSource, sourceWidth, sourceHeight, knownAssetId) {
        const width = Number(sourceWidth || 0)
        const height = Number(sourceHeight || 0)
        if (width <= 0 || height <= 0)
            return

        const key = root.libraryGalleryAspectKey(index, thumbnailSource, knownAssetId)
        const nextRatio = root.clamp(width / height, 0.28, 4.5)
        const currentRatio = root.libraryGalleryAspectRatio(index, thumbnailSource, knownAssetId)
        // Cached and regenerated thumbnails can round either dimension by a
        // pixel. That is not a new aspect ratio and must not rebuild the rows.
        const roundingTolerance = (1 + currentRatio) / height
        if (Math.abs(currentRatio - nextRatio) <= Math.max(0.001, roundingTolerance))
            return

        const ratios = {}
        for (const existingKey in root.libraryGalleryAspectRatios)
            ratios[existingKey] = root.libraryGalleryAspectRatios[existingKey]
        ratios[key] = nextRatio
        root.libraryGalleryAspectRatios = ratios
        root.libraryGalleryAspectRevision += 1
    }

    function libraryGalleryViewportWidth(viewWidth, scrollbarGutter) {
        const width = Math.max(1, Math.floor(Number(viewWidth || 0)))
        const gutter = Math.max(0, Math.ceil(Number(scrollbarGutter || root.libraryGalleryScrollbarGutter)))
        return Math.max(1, width - gutter)
    }

    function libraryGalleryRows(viewWidth) {
        const revision = root.libraryGalleryAspectRevision
        const assets = catalogAssets ? catalogAssets.galleryAssets() : []
        const count = assets.length
        const width = Math.max(1, Math.floor(Number(viewWidth || 0)))
        if (revision < 0 || count <= 0 || width <= 1)
            return []

        const idealHeight = root.libraryToolbarTight ? 184 : 214
        const rows = []
        let row = []
        let rowAspect = 0
        let rowTop = 0

        function flushRow(justified) {
            if (row.length === 0)
                return

            const rowJustified = justified === true
            const height = rowJustified
                           ? Math.max(92, Math.round(width / Math.max(0.1, rowAspect)))
                           : idealHeight
            const items = []
            let consumed = 0
            for (let position = 0; position < row.length; ++position) {
                const entry = row[position]
                const isLast = position === row.length - 1
                const naturalWidth = Math.max(1, Math.round(height * entry.aspect))
                const remainingWidth = Math.max(1, width - consumed)
                const itemWidth = rowJustified && isLast ? remainingWidth
                                                         : Math.min(naturalWidth, remainingWidth)
                consumed += itemWidth
                items.push({
                    index: entry.index,
                    assetId: entry.assetId,
                    thumbnailSource: entry.thumbnailSource,
                    mediaType: entry.mediaType,
                    durationText: entry.durationText,
                    rating: entry.rating,
                    picked: entry.picked,
                    rejected: entry.rejected,
                    width: itemWidth
                })
            }

            rows.push({ top: rowTop, height: height, width: consumed, justified: rowJustified, items: items })
            rowTop += height
            row = []
            rowAspect = 0
        }

        for (let index = 0; index < count; ++index) {
            const asset = assets[index]
            const thumbnailSource = String(asset.thumbnailSource || "")
            const aspect = root.libraryGalleryAspectRatio(index, thumbnailSource, String(asset.assetId || ""))
            row.push({
                index: index,
                assetId: String(asset.assetId || ""),
                thumbnailSource: thumbnailSource,
                mediaType: String(asset.mediaType || "photo"),
                durationText: String(asset.durationText || ""),
                rating: Math.max(0, Math.min(5, Number(asset.rating || 0))),
                picked: Boolean(asset.picked),
                rejected: Boolean(asset.rejected),
                aspect: aspect
            })
            rowAspect += aspect
            if (row.length > 0 && rowAspect * idealHeight >= width)
                flushRow(true)
        }
        flushRow(false)

        return rows
    }

    function libraryGalleryLayoutSignature(viewWidth, scrollbarGutter) {
        const rawWidth = Math.max(1, Math.floor(Number(viewWidth || 0)))
        const gutter = Math.max(0, Math.ceil(Number(scrollbarGutter || root.libraryGalleryScrollbarGutter)))
        const viewportWidth = root.libraryGalleryViewportWidth(rawWidth, gutter)
        const rows = root.libraryGalleryRows(viewportWidth)
        let maxRowWidth = 0
        let lastRowHeight = 0
        let lastRowJustified = false
        for (let rowIndex = 0; rowIndex < rows.length; ++rowIndex) {
            const items = rows[rowIndex].items || []
            let rowWidth = 0
            for (let itemIndex = 0; itemIndex < items.length; ++itemIndex)
                rowWidth += Math.max(0, Number(items[itemIndex].width || 0))
            maxRowWidth = Math.max(maxRowWidth, rowWidth)
            if (rowIndex === rows.length - 1) {
                lastRowHeight = Math.round(Number(rows[rowIndex].height || 0))
                lastRowJustified = rows[rowIndex].justified === true
            }
        }
        return "library-gallery-layout:v1|raw:" + rawWidth +
               "|gutter:" + gutter +
               "|viewport:" + viewportWidth +
               "|rows:" + rows.length +
               "|max-row:" + maxRowWidth +
               "|last-height:" + lastRowHeight +
               "|last-justified:" + String(lastRowJustified) +
               "|overflow:" + String(maxRowWidth > viewportWidth)
    }

    function clearTransientMaskTools() {
        if (editorPreview.brushStrokeActive)
            editorPreview.endActiveBrushStroke()
        root.endMaskShapeEditTransaction()
        if (root.maskRefinementSessionActive) {
            root.maskRefinementSessionActive = false
            editorPreview.endCoalescedEdit()
        }
        objectPickArmed = false
        objectPickBoxMode = false
        objectPickCreateNew = false
        objectPickMode = "selection"
        polygonDrawArmed = false
        lassoDrawArmed = false
        spacePanActive = false
        editorPreview.clearSmartSelectPreview()
    }

    function beginMaskShapeEditTransaction() {
        if (root.maskShapeEditTransactionActive)
            return
        editorPreview.beginCoalescedEdit()
        root.maskShapeEditTransactionActive = true
    }

    function endMaskShapeEditTransaction() {
        if (!root.maskShapeEditTransactionActive)
            return
        root.maskShapeEditTransactionActive = false
        editorPreview.endCoalescedEdit()
    }

    function manualSelectionSubtractActive() {
        return root.maskCreationOperation === "subtract" ||
               root.objectPickMode === "selection-subtract"
    }

    function maskOperationForModifierState(modifierState) {
        const modifiers = Number(modifierState || 0)
        const shiftHeld = (modifiers & Qt.ShiftModifier) !== 0
        const optionHeld = (modifiers & Qt.AltModifier) !== 0
        if (shiftHeld && optionHeld)
            return "intersect"
        if (optionHeld)
            return "subtract"
        if (shiftHeld)
            return "add"
        return root.maskCreationOperation
    }

    function applyMaskOperationForModifierState(modifierState) {
        const operation = root.maskOperationForModifierState(modifierState)
        root.maskCreationOperation = operation
        if (editorPreview.hasActiveMask && editorPreview.activeMaskToolRole !== "retouch")
            editorPreview.activeMaskOperation = operation
        return operation
    }

    function objectPickModeForModifierState(modifierState) {
        return root.maskOperationForModifierState(modifierState) === "subtract"
                ? "selection-subtract"
                : "selection"
    }

    function applyObjectPickModeForModifierState(modifierState) {
        if (root.objectPickMode === "remove")
            return root.objectPickMode
        root.objectPickMode = root.objectPickModeForModifierState(modifierState)
        return root.objectPickMode
    }

    function maskSpacePanShortcutActive() {
        return page === "edit" &&
               editorPreview.hasAsset &&
               !editorPreview.compareMode &&
               (root.brushToolReady() ||
                root.lassoDrawArmed ||
                root.activeLassoShortcutReady() ||
                root.polygonDrawArmed ||
                root.activePolygonShortcutReady() ||
                root.objectPickArmed)
    }

    function handleMaskPickOutcome(outcome) {
        if (outcome === "selection-ai" || outcome === "remove-ai") {
            root.clearTransientMaskTools()
            root.editTool = "masks"
            root.editInspectorTab = "adjust"
        }
    }

    function pixelValueText(sample) {
        if (!sample || sample.valid !== true)
            return "--"
        return sample.hex + "  " + sample.red + " " + sample.green + " " + sample.blue
    }

    function pixelDeltaText(inspector) {
        if (!inspector || inspector.hasBefore !== true || inspector.hasAfter !== true)
            return "Before unavailable"
        const r = inspector.deltaRed > 0 ? "+" + inspector.deltaRed : "" + inspector.deltaRed
        const g = inspector.deltaGreen > 0 ? "+" + inspector.deltaGreen : "" + inspector.deltaGreen
        const b = inspector.deltaBlue > 0 ? "+" + inspector.deltaBlue : "" + inspector.deltaBlue
        const luma = inspector.deltaLuminance > 0
            ? "+" + inspector.deltaLuminance.toFixed(3)
            : inspector.deltaLuminance.toFixed(3)
        return "Delta " + r + " " + g + " " + b + "  Y " + luma
    }

    function previewFailureStageLabel(stage) {
        if (String(stage || "").trim() === "layer_source")
            return "Linked image source"
        const normalized = String(stage || "").replace(/_/g, " ").trim()
        if (normalized.length === 0)
            return ""
        return normalized.charAt(0).toUpperCase() + normalized.slice(1)
    }

    function thumbnailFailureStageLabel(stage) {
        const label = previewFailureStageLabel(stage)
        return label.length > 0 ? label : "Thumbnail"
    }

    function thumbnailStateSignature(data) {
        return thumbnailStateUtils.thumbnailStateSignature(data)
    }

    function thumbnailDisplayState(data) {
        return thumbnailStateUtils.thumbnailDisplayState(data)
    }

    function thumbnailStatusLabel(data, fallbackText) {
        return thumbnailStateUtils.thumbnailStatusLabel(data, fallbackText)
    }

    function thumbnailRetryActionSignature(data, rowKind) {
        return thumbnailStateUtils.thumbnailRetryActionSignature(data, rowKind)
    }

    function thumbnailRefreshQueued(data) {
        return thumbnailStateUtils.thumbnailRefreshQueued(data)
