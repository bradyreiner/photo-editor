        const jobId = String(row && row.jobId || "")
        if (action === "queue" && row && Number(row.assetIndex || -1) >= 0) {
            root.queueExport(Number(row.assetIndex))
            return
        }
        if (action === "retry" && jobId.length > 0) {
            exportJobs.retryJob(jobId)
