            "11x14 in": "14x11 in", "14x11 in": "11x14 in",
            "A4": "A4 Landscape", "A4 Landscape": "A4"
        }
        if (pairs[preset] !== undefined)
            return pairs[preset]
        const parts = preset.split(":")
        if (parts.length === 2 && Number(parts[0]) > 0 && Number(parts[1]) > 0)
            return parts[1].trim() + ":" + parts[0].trim()
        return preset
