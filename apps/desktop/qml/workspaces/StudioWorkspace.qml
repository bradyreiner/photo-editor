    function maskVocabularyTooltip() {
        return "A selection restricts edits on the active layer. A layer mask controls its layer's coverage. Add, Remove, and Overlap refine the selection; Deselect clears it. Overlay only changes how the selection is shown."
    }

    function activeMaskToolbarStatusText() {
        const emptySuffix = root.editorPreviewController.emptyMaskCount > 0 ? " / Empty selections: " + root.editorPreviewController.emptyMaskCount : ""
        const staleSuffix = root.editorPreviewController.staleGeneratedMaskCount > 0 ? " / Update AI: " + root.editorPreviewController.staleGeneratedMaskCount : ""
        if (!root.editorPreviewController.hasActiveMask)
            return "No active selection / Next tool creates a new selection" + emptySuffix + staleSuffix
        const state = root.editorPreviewController.activeMaskInverted ? "Inverted" : "Normal"
        const target = String(root.editorPreviewController.activeMaskSetName || root.editorPreviewController.activeMaskName || "Selection")
        return root.maskKindLabel(root.editorPreviewController.activeMaskKind) + " / " +
               root.maskOperationLabel(root.editorPreviewController.activeMaskOperation) + " / " +
               state + " / Target: " + target + " / Adjustment layer" + emptySuffix + staleSuffix
               + " / " + root.maskOutlineQualityLabel(root.editorPreviewController.activeMaskOutlineQualityTier)
    }

    function activeMaskData() {
        return root.editorPreviewController.hasActiveMask &&
               root.editorPreviewController.activeMaskIndex >= 0 &&
               root.editorPreviewController.activeMaskIndex < root.editorPreviewController.maskStack.length
               ? root.editorPreviewController.maskStack[root.editorPreviewController.activeMaskIndex]
               : ({})
    }

    function smartSelectionFallbackState(mask) {
        const metadata = mask && mask.generatedMaskMetadata ? mask.generatedMaskMetadata : ({})
        return metadata.smartFallback === true ? "Editable preview" : ""
    }

    function maskCreationContextSignature() {
        if (!root.editorPreviewController.hasActiveMask)
            return "component:none|operation:" + root.maskCreationOperation + "|targetGroup:new|target:Active layer"
        const target = String(root.editorPreviewController.activeMaskSetName || root.editorPreviewController.activeMaskName || "Selection")
        return "component:" + root.maskKindLabel(root.editorPreviewController.activeMaskKind) +
                "|operation:" + root.maskOperationLabel(root.editorPreviewController.activeMaskOperation) +
                "|state:" + (root.editorPreviewController.activeMaskInverted ? "Inverted" : "Normal") +
                "|targetGroup:" + target +
                "|target:" + (root.editorPreviewController.editingLayerMask ? "Layer mask" : "Active layer")
    }

    function maskActionRetrySignature() {
        return "available:" + String(root.editorPreviewController.maskActionRetryAvailable) +
                "|label:" + String(root.editorPreviewController.maskActionRetryLabel || "") +
                "|detail:" + String(root.editorPreviewController.maskActionRetryDetail || "")
    }

    function maskCreationOperationTooltip(operationName) {
        const operation = root.maskOperationLabel(operationName)
        if (!root.editorPreviewController.hasActiveMask)
            return operation + " creates the first component in a new selection."
        const target = String(root.editorPreviewController.activeMaskSetName || root.editorPreviewController.activeMaskName || "Selection")
        if (String(operationName || "").trim().toLowerCase() === "replace")
            return "Replace the result of " + target + " with the next component."
        return operation + " the next component in " + target + "."
    }

    function activeMaskDisabledTooltipSuffix() {
        const reason = String(root.editorPreviewController.activeMaskEditDisabledReason || "")
        return reason.length > 0 ? " " + reason : ""
    }

    function maskStackSourceSummary(maskSet) {
        const sourceCount = Number(maskSet.sourceCount || 0)
        if (sourceCount === 1)
            return "1 component"
        return sourceCount + " components"
    }

    function beginMaskSelectionSession() {
        if (root.editorPreviewController.selectionEditSessionActive)
            return true
        if (!root.editorPreviewController.editingLayerMask) root.editorPreviewController.activateWorkingSelection()
        root.maskSessionUiBaseline = {
            target: root.selectedEditTarget,
            layerIndices: root.selectedPhotoLayerIndices.slice(0),
            tool: root.editTool,
            inspector: root.editInspectorTab
        }
        return root.editorPreviewController.beginSelectionEditSession()
    }

    function setMaskCreationOperation(operationName) {
        root.maskCreationOperation = root.normalizedMaskCreationOperation(operationName)
        if (root.objectPickArmed && root.objectPickMode !== "remove")
            root.objectPickMode = root.objectPickModeForModifierState(0)
        return root.maskCreationOperation
    }

    function selectActiveSelectionAdjustmentLayer() {
        // Selection authoring never creates or chooses a layer.
        return root.selectedEditTargetLayerIndex()
    }

    function prepareWorkingSelectionTarget() {
        const index = root.selectedEditTargetLayerIndex()
        root.editorPreviewController.activateWorkingSelection()
        if (root.selectedEditTargetScope() === "mask")
            root.setSelectedEditTarget(index >= 0 ? root.selectedLayerTargetScope(index) : "base-image", index, ({}), -1)
    }

    function createMaskSource(kindName) {
        const kind = String(kindName || "").trim().toLowerCase()
        if (root.componentWorkspaceActive && kind === "depth") {
            root.showEditActionFeedback(root.componentSourceSamplingDisabledReason(), true)
            return false
        }
        root.prepareWorkingSelectionTarget()
        if (!root.beginMaskSelectionSession())
            return false
        root.clearTransientMaskTools()
        root.editTool = "masks"
        root.editInspectorTab = "layers"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "outline"
        if (kind === "object") {
            root.objectPickArmed = true
            root.objectPickCreateNew = false
            root.objectPickMode = root.objectPickModeForModifierState(0)
            return
        }
        root.editorPreviewController.addMask(kindName)
        const layerIndex = root.selectActiveSelectionAdjustmentLayer()
        if (root.editorPreviewController.hasActiveMask)
            root.editorPreviewController.activeMaskOperation = root.maskCreationOperation
        if (layerIndex >= 0)
            root.editInspectorTab = "layers"
        if (kind === "color") {
            root.setMaskColorRangeSampler(true)
            root.creativeToolsScrollResetRequested()
        } else if (kind === "luminance") {
            root.setMaskLuminanceRangeSampler(true)
            root.creativeToolsScrollResetRequested()
        }
    }

    function createGeneratedSelectionSource(kindName) {
        root.prepareWorkingSelectionTarget()
        if (!root.beginMaskSelectionSession())
            return false
        root.clearTransientMaskTools()
        root.editTool = "masks"
        root.editInspectorTab = "layers"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "outline"
        const previousMaskCount = root.editorPreviewController.maskCount
        root.editorPreviewController.addAIMask(kindName)
        if (root.editorPreviewController.maskCount === previousMaskCount)
            return false
        const layerIndex = root.selectActiveSelectionAdjustmentLayer()
        if (root.editorPreviewController.hasActiveMask)
            root.editorPreviewController.activeMaskOperation = root.maskCreationOperation
        if (layerIndex >= 0)
            root.editInspectorTab = "layers"
    }

