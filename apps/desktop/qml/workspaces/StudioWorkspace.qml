    function agentScopeModeLabel(scope) {
        if (scope === "current-photo")
            return "Current"
        if (scope === "project")
            return "Project"
        if (scope === "filtered-library")
            return "Filter"
        return "Selected"
    }

    function agentScopeModeFullLabel(scope) {
        if (scope === "current-photo")
            return "Current Photo"
        if (scope === "project")
            return "Project"
        if (scope === "filtered-library")
            return "Filtered Library"
        return "Selected Assets"
    }

    function agentScopeModeIcon(scope) {
        if (scope === "project")
            return "folder"
        if (scope === "filtered-library")
            return "filter"
        if (scope === "current-photo")
            return "media"
        return "check"
    }

    function agentScopeEstimatedCount(scope) {
        if (!catalogAssets)
            return 0
        if (scope === "current-photo")
            return catalogAssets.selectedIndex >= 0 ? 1 : 0
        if (scope === "project")
            return catalogAssets.projectFilter !== "all"
                   ? catalogAssets.assetCountForProject(catalogAssets.projectFilter)
                   : catalogAssets.assetCount
        if (scope === "filtered-library")
            return root.filtersActive() ? catalogAssets.assetCount : 0
        return Number(catalogAssets.selectedAssetCount || 0)
    }

    function batchSyncGroupEnabled(groupKey) {
        return root.batchSyncGroups.indexOf(String(groupKey || "")) >= 0
    }

    function toggleBatchSyncGroup(groupKey) {
        const key = String(groupKey || "")
        let next = root.batchSyncGroups.slice(0)
        const existing = next.indexOf(key)
        if (existing >= 0) {
            if (next.length === 1)
                return
            next.splice(existing, 1)
        } else {
            next.push(key)
        }
        root.batchSyncGroups = next
    }

    function selectedBatchFileNames(maximumCount) {
        const selectedIds = catalogAssets.selectedAssetIds || []
        const names = []
        const maximum = Math.max(1, Number(maximumCount || 3))
        for (let index = 0; index < catalogAssets.assetCount && names.length < maximum; ++index) {
            const asset = catalogAssets.assetAt(index)
            if (selectedIds.indexOf(asset.assetId) < 0)
                continue
            const path = String(asset.filePath || "")
            names.push(path.length > 0 ? path.split(/[\\/]/).pop() : String(asset.assetId || "Photo"))
        }
        return names
    }

    function batchRecipeConflictCount() {
        const selectedIds = catalogAssets.selectedAssetIds || []
        const sourceRecipe = String(editorPreview.currentAssetBoundAdjustmentPatchJson() || "")
        let conflicts = 0
        for (let index = 0; index < catalogAssets.assetCount; ++index) {
            const asset = catalogAssets.assetAt(index)
            if (selectedIds.indexOf(asset.assetId) >= 0 && String(asset.adjustmentPatchJson || "") !== sourceRecipe)
                conflicts += 1
        }
        return conflicts
    }

    function applySelectiveBatchSync() {
        if (catalogAssets.selectedAssetCount < 2 || root.batchSyncGroups.length === 0)
            return
        catalogAssets.applyAdjustmentPatchJsonToAssetIds(
                    catalogAssets.selectedAssetIds,
                    editorPreview.currentAdjustmentPatchJson(root.batchSyncGroups),
                    root.batchSyncGroups)
    }

    function bestAgentScopeMode(preferredScope) {
        if (root.agentScopeEstimatedCount("selected-assets") > 1)
            return "selected-assets"
        if (root.page === "edit" && root.agentScopeEstimatedCount("current-photo") > 0)
            return "current-photo"
        if (catalogAssets && String(catalogAssets.projectFilter || "all") !== "all" &&
                root.agentScopeEstimatedCount("project") > 0)
            return "project"
        if (root.agentScopeEstimatedCount("selected-assets") > 0)
            return "selected-assets"
        if (root.agentScopeEstimatedCount("filtered-library") > 0)
            return "filtered-library"
        if (root.agentScopeEstimatedCount("current-photo") > 0)
            return "current-photo"
        if (root.agentScopeEstimatedCount("project") > 0)
            return "project"
        return "current-photo"
    }

    function applyAgentResultToEditor(report) {
        const result = report || ({})
        const commit = result.commitReport || result
        const previous = commit.previousAdjustmentPatchByAssetId || ({})
        const committed = commit.committedAdjustmentPatchByAssetId || ({})
        const assetIds = commit.assetIds || result.assetIds || []
        let visibleApplied = false
        for (let index = 0; index < assetIds.length; ++index) {
            const assetId = String(assetIds[index] || "")
            const nextAdjustments = String(committed[assetId] || "")
            if (assetId.length === 0 || nextAdjustments.length === 0)
                continue
            const applied = editorPreview.applyExternalAdjustmentPatchEdit(
                        assetId,
                        String(previous[assetId] || ""),
                        nextAdjustments,
                        "Looksy assistant edit")
            if (assetId === String(editorPreview.assetId || ""))
                visibleApplied = Boolean(applied) || visibleApplied
        }
        if (!visibleApplied && assetIds.length > 0) {
            const firstAssetId = String(assetIds[0] || "")
            if (firstAssetId.length > 0)
                root.showAgentAsset(firstAssetId)
        }
        return assetIds
    }

    function agentTargetIdsForScope(scope) {
        if (scope === "confirmed-assets")
            return root.searchEditWorkflow ? (root.searchEditWorkflow.confirmedIds || []).slice(0) : []
        if (!catalogAssets)
            return []
        if (scope === "current-photo") {
            const id = String(catalogAssets.selectedAssetId || "")
            return id.length > 0 ? [id] : []
        }
        if (scope === "project") {
            const assets = catalogAssets.assetsForProject(String(catalogAssets.projectFilter || "all")) || []
            const ids = []
            for (let index = 0; index < assets.length; ++index) {
                const id = String((assets[index] || ({})).assetId || "")
                if (id.length > 0)
                    ids.push(id)
            }
            return ids
        }
        if (scope === "filtered-library") {
            const ids = []
            for (let index = 0; index < catalogAssets.assetCount; ++index) {
                const id = String((catalogAssets.assetAt(index) || ({})).assetId || "")
                if (id.length > 0)
                    ids.push(id)
            }
            return ids
        }
        return (catalogAssets.selectedAssetIds || []).slice(0)
    }

    AgentWorkspaceTouchResolver { id: agentWorkspaceTouchResolver }
    function agentWorkspaceTouchTarget(event, parameterKey) {
        return agentWorkspaceTouchResolver.resolve(
                    event,
                    parameterKey,
                    studioPageLoader.item,
                    agentWorkspaceOverlay,
                    root.editViewportHandle,
                    root)
    }

    function runAgentDraftForScope(scope, instructions, keepAgentScreenOpen) {
        if (!root.hasAgentEditController)
            return ({ ok: false, errors: ["The agent is not available."] })
        if (root.agentEditController.draftActive) {
            const rollback = root.agentEditController.rollbackDraft() || ({})
            if (!Boolean(rollback.ok))
                return rollback
        }
        root.agentTargetAssetIds = root.agentTargetIdsForScope(scope)
        if (root.agentTargetAssetIds.length > 0)
            catalogAssets.selectAssetById(String(root.agentTargetAssetIds[0]), true)
        root.assetActivated("edit")
        if (!keepAgentScreenOpen && agentRunDialogLoader.item && agentRunDialogLoader.item.visible)
            agentRunDialogLoader.item.close()
        root.agentResultVisible = false
        root.agentApplyInProgress = true
        const accepted = root.agentEditController.startDraftForScope(scope, instructions) || ({})
        if (Boolean(accepted.ok) && Boolean(accepted.accepted)) {
            root.agentActiveDraftRequestId = String(accepted.requestId || "")
        } else {
            root.agentApplyInProgress = false
            root.agentResultVisible = true
        }
        return accepted
    }

    function finishAgentDraftRequest(requestId, report) {
        if (root.agentActiveDraftRequestId.length > 0 &&
                requestId !== root.agentActiveDraftRequestId)
            return
        root.agentActiveDraftRequestId = ""
        root.agentApplyInProgress = false
        if (Boolean(report.ok) && root.agentEditController.draftActive) {
            if (root.agentScopeMode !== "project" &&
                    root.agentScopeMode !== "filtered-library") {
                root.agentScopeMode = root.agentTargetAssetIds.length > 1
                        ? "selected-assets" : "current-photo"
            }
            root.assetActivated("edit")
        } else if (!Boolean(report.ok)) {
            root.agentResultVisible = true
        }
    }

    Timer {
        id: agentResultVisibleTimer
        interval: 2600
        repeat: false
        onTriggered: root.agentResultVisible = false
    }

    function openAgentRunDialog(explicitScope) {
        root.agentScopeMode = explicitScope === "current-photo" || explicitScope === "selected-assets" || explicitScope === "confirmed-assets"
                            ? explicitScope : root.bestAgentScopeMode(root.agentScopeMode)
        if (root.hasAgentEditController &&
                String(root.agentEditController.mcpEndpoint || "").length > 0 &&
                (!root.agentEditController.mcpAvailable ||
                 String(root.agentEditController.mcpStatus || "").toLowerCase() === "failed")) {
            root.agentEditController.refreshMcpTools()
        }
        agentRunDialogLoader.active = true
        if (agentRunDialogLoader.item) {
            agentRunDialogLoader.item.open()
            return
        }
        Qt.callLater(function() {
            if (agentRunDialogLoader.item)
                agentRunDialogLoader.item.open()
        })
    }

    function openAgentDraftReview() {
        const confirmed = root.searchEditWorkflow && root.searchEditWorkflow.confirmedIds.length > 0 &&
                        root.hasAgentEditController && root.agentEditController.lastRunReport.scope === "confirmed-assets"
        root.openAgentRunDialog(confirmed ? "confirmed-assets" : undefined)
        Qt.callLater(function() {
            if (agentRunDialogLoader.item && root.agentEditController.draftActive)
                agentRunDialogLoader.item.setPage(3)
        })
    }

    function beginAgentTargetSelection(prompt, inspirationAssetIds, styleId) {
        root.agentPrompt = String(prompt || "").trim()
        root.agentInspirationAssetIds = inspirationAssetIds || []
        root.agentInspirationStyleId = String(styleId || "")
        root.agentTargetAssetIds = []
        root.agentTargetSelectionMode = true
        root.selectionMode = true
        if (catalogAssets)
            catalogAssets.clearSelection()
    }

    function cancelAgentTargetSelection() {
        root.agentTargetSelectionMode = false
        root.selectionMode = false
        root.agentTargetAssetIds = []
    }

    function startAgentTargetEditing() {
        if (!root.hasAgentEditController || !catalogAssets || catalogAssets.selectedAssetCount <= 0)
            return
        root.agentTargetAssetIds = (catalogAssets.selectedAssetIds || []).slice(0)
        root.agentScopeMode = "selected-assets"
        root.agentTargetSelectionMode = false
        root.selectionMode = false
        root.agentEditController.userInstructions = root.agentPrompt
        if (root.agentInspirationStyleId.length > 0)
            root.agentEditController.selectedStyleId = root.agentInspirationStyleId
        if (root.agentInspirationAssetIds.length > 0) {
            const learned = root.agentEditController.createLearnedStyleProfileFromAssets(
                        "Prompt Reference Look",
                        "Use these references as visual inspiration while following: " + root.agentPrompt,
                        root.agentPrompt,
                        root.agentInspirationAssetIds)
            if (Boolean((learned || ({})).ok) && String((learned || ({})).styleId || "").length > 0)
                root.agentEditController.selectedStyleId = String(learned.styleId)
        }
        if (root.agentTargetAssetIds.length > 0)
            catalogAssets.selectAssetById(root.agentTargetAssetIds[0], true)
        if (root.page !== "edit")
            root.assetActivated("edit")
        root.runAgentDraftForScope("selected-assets", root.agentPrompt)
    }

    function showAgentAsset(assetId) {
        if (!catalogAssets || String(assetId || "").length === 0)
            return
        catalogAssets.selectAssetById(String(assetId), true)
    }

    function maskSetForAgentMaskId(maskId) {
        const resolvedId = String(maskId || "")
        const sets = root.maskSetRows
        for (let setIndex = 0; setIndex < sets.length; ++setIndex) {
            const maskSet = sets[setIndex] || ({})
            const sources = maskSet.sources || []
            for (let sourceIndex = 0; sourceIndex < sources.length; ++sourceIndex) {
                const source = sources[sourceIndex] || ({})
                if (String(source.id || source.sourceId || "") === resolvedId)
                    return maskSet
            }
        }
        return ({})
    }

    function focusAgentFinding(finding) {
        const resolved = finding || ({})
        const maskId = String(resolved.maskId || "")
        const region = resolved.region || ({})
        const hasRegion = Number.isFinite(Number(region.centerX)) &&
                          Number.isFinite(Number(region.centerY)) &&
                          Number(region.radiusX || 0) > 0 &&
                          Number(region.radiusY || 0) > 0
        if (hasRegion)
            root.agentFindingFocusRegion = region
        const stack = editorPreview.maskStack || []
        let maskIndex = -1
        for (let index = 0; index < stack.length; ++index) {
            if (String((stack[index] || ({})).id || "") === maskId) {
                maskIndex = index
                break
            }
        }
        if (maskIndex < 0 && !hasRegion)
            return false
        if (maskIndex >= 0) {
            const maskSet = root.maskSetForAgentMaskId(maskId)
            if (Object.keys(maskSet).length > 0) {
                root.selectMaskSetAndLayer(maskSet, false, true)
                if (editorPreview.activeMaskIndex !== maskIndex) {
                    editorPreview.activeMaskIndex = maskIndex
                    root.setSelectedEditTarget("mask",
                                               root.adjustmentLayerIndexForMaskSet(maskSet),
                                               maskSet,
                                               maskIndex)
                }
            } else {
                root.deferMaskOutlineActivation()
                editorPreview.activeMaskIndex = maskIndex
                root.editTool = "masks"
                root.editInspectorTab = "layers"
                editorPreview.maskPreviewMode = "overlay"
            }
        }
        root.agentFocusedMaskId = maskId
        root.agentFindingFocusSerial += 1
        return true
    }

    function setAgentSpatialTargetMode(enabled) {
        root.agentSpatialTargetMode = Boolean(enabled)
        if (root.agentSpatialTargetMode) {
            root.agentSpatialTargetRegion = ({})
            root.agentFindingFocusRegion = ({})
            root.agentFocusedMaskId = ""
        } else {
            root.agentSpatialTargetRegion = ({})
        }
    }

    function chooseAgentSpatialTarget(normalizedX, normalizedY) {
        if (!root.agentSpatialTargetMode)
            return false
        const x = Number(normalizedX)
        const y = Number(normalizedY)
        if (!Number.isFinite(x) || !Number.isFinite(y) ||
                x < 0 || x > 1 || y < 0 || y > 1)
            return false
        const region = ({
            centerX: x,
            centerY: y,
            radiusX: 0.12,
            radiusY: 0.12,
            feather: 0.72
        })
        root.agentSpatialTargetRegion = region
        root.agentFindingFocusRegion = region
        root.agentFindingFocusSerial += 1
        root.agentSpatialTargetMode = false
        agentWorkspaceOverlay.acceptSpatialTarget(
                    x,
                    y,
                    catalogAssets ? String(catalogAssets.selectedAssetId || "") : "")
        return true
    }

    function agentRunModeLabel(mode) {
        if (mode === "analyze")
            return "Analyze"
        if (mode === "validate-batch")
            return "Batch Check"
        if (mode === "export-preflight")
            return "Export Check"
        return "Draft"
    }

    function agentRunModeFullLabel(mode) {
        if (mode === "validate-batch")
            return "Batch Validation"
        if (mode === "export-preflight")
            return "Export Preflight"
        return agentRunModeLabel(mode)
    }

    function agentRunModeIcon(mode) {
        if (mode === "analyze")
            return "filter"
        if (mode === "validate-batch")
            return "check"
        if (mode === "export-preflight")
            return "export"
        return "adjust"
    }

    function agentCanRunMode(mode) {
        if (!catalogAssets || !root.hasAgentEditController ||
                root.agentEditController.running ||
                root.agentEditController.manualEditingActive)
            return false
        if (mode === "analyze") {
            return (root.agentScopeMode === "current-photo" ||
                    root.agentScopeMode === "selected-assets") &&
                   root.agentScopeEstimatedCount(root.agentScopeMode) === 1
        }
        return root.agentScopeEstimatedCount(root.agentScopeMode) >= 1
    }

    function agentWorkflowState() {
        return root.hasAgentEditController
               ? root.agentEditController.aiEditWorkflowState(root.agentScopeMode) || ({})
               : ({})
    }

    function agentVisualMode() {
        if (!root.hasAgentEditController)
            return "sleep"
        if (root.agentEditController.awaitingUserInput)
            return "thinking"
        if (root.agentEditController.running)
            return "processing"
        if (String(root.agentEditController.errorMessage || "").length > 0)
            return "warning"
        if (root.agentHasRunAudit())
            return "success"
        return "idle"
    }

    function residentAgentStatusText() {
        const mode = root.agentVisualMode()
        if (mode === "processing")
            return "Looksy is working"
        if (mode === "thinking")
            return "Looksy needs you"
        if (mode === "success")
            return "Draft ready"
        if (mode === "warning")
            return "Looksy hit a snag"
        if (mode === "sleep")
            return "Looksy is offline"
        return "Ask Looksy"
    }

    function agentWorkflowPrimaryAction() {
        const state = root.agentWorkflowState()
        return state.primaryAction || ({})
    }

    function agentWorkflowPrimaryKey() {
        const action = root.agentWorkflowPrimaryAction()
        return String(action.key || "")
    }

    function agentSampleReviewWaiting() {
        const state = root.agentWorkflowState()
        return Boolean(state.sampleReviewWaiting)
    }

    function agentWorkflowPrimaryLabel() {
        const action = root.agentWorkflowPrimaryAction()
        return String(action.label || "Looksy")
    }

    function agentWorkflowPrimaryIcon() {
        const key = root.agentWorkflowPrimaryKey()
        if (key === "set_up_local_ai")
            return "download"
        if (key === "learn_style")
            return "select"
        if (key === "apply_to_all")
            return "check"
        if (key === "commit")
            return "check"
        if (key === "cancel")
            return "close"
        if (key === "answer_question" || key === "review_issue")
            return "select"
        if (key === "choose_style")
            return "menu"
        return "adjust"
    }

    function agentWorkflowPrimaryEnabled() {
        if (!root.hasAgentEditController)
            return false
        const action = root.agentWorkflowPrimaryAction()
        const key = String(action.key || "")
        if (key === "create_draft" || key === "create_samples")
            return root.agentCanRunMode("draft")
        if (key === "apply_to_all")
            return root.agentEditController.draftActive && !root.agentEditController.running
        if (key === "commit")
            return root.agentEditController.draftActive && !root.agentEditController.running
        if (key === "cancel")
            return root.agentEditController.running
        if (key === "set_up_local_ai")
            return !root.agentEditController.running
        if (key === "learn_style")
            return !root.agentEditController.running
        return Boolean(action.enabled)
    }

    function agentWorkflowDetailText() {
        const state = root.agentWorkflowState()
        const reasons = state.blockingReasons || []
        if (reasons.length > 0)
            return String(reasons[0] || "")
        const style = state.style || ({})
        const scope = String(state.scopeLabel || "")
        return scope.length > 0 ? scope : String(style.name || "")
    }

    function agentWorkflowTasteCard() {
        const state = root.agentWorkflowState()
        return state.tasteCard || (state.style ? state.style.tasteCard || ({}) : ({}))
    }

    function agentWorkflowStyleLearning() {
        const state = root.agentWorkflowState()
        return state.styleLearning || ({})
    }

    function agentTasteCardVisible() {
        const learning = root.agentWorkflowStyleLearning()
        return Boolean(learning.available)
    }

    function agentTasteCardTitle() {
        const card = root.agentWorkflowTasteCard()
        if (Boolean(card.available))
            return String(card.name || "Active style")
        const learning = root.agentWorkflowStyleLearning()
        if (Boolean(learning.available))
            return "Ready to learn from selection"
        return ""
    }

    function agentTasteCardText() {
        const card = root.agentWorkflowTasteCard()
        if (Boolean(card.available)) {
            const confidence = String(card.confidence || "")
            const references = Number(card.referenceCount || 0)
            const summary = String(card.summary || "")
            const parts = []
            if (references > 0)
                parts.push(references + " reference" + (references === 1 ? "" : "s"))
            if (confidence.length > 0)
                parts.push(confidence + " confidence")
            if (summary.length > 0)
                parts.push(summary)
            return parts.join(" · ")
        }
        const learning = root.agentWorkflowStyleLearning()
        if (Boolean(learning.available)) {
            const usable = Number(learning.usableRecipeCount || 0)
            return usable + " usable edited reference" + (usable === 1 ? "" : "s")
        }
        return ""
    }

    function learnAgentStyleFromSelection() {
        if (!root.hasAgentEditController)
            return
        const learning = root.agentWorkflowStyleLearning()
        const count = Number(learning.selectedCount || 0)
        const label = count > 1 ? "Learned Project Style" : "Learned Photo Style"
        const result = root.agentEditController.createLearnedStyleProfileFromSelection(
                    label,
                    "Edit selected photos consistently in my demonstrated style.",
                    String(root.agentEditController.userInstructions || ""))
        if (!Boolean(result.ok)) {
            const errors = result.errors || []
            if (errors.length > 0)
                console.warn(errors.join("\n"))
        }
    }

    function runAgentWorkflowPrimaryAction() {
        if (!root.hasAgentEditController || !root.agentWorkflowPrimaryEnabled())
            return
        const key = root.agentWorkflowPrimaryKey()
        if (key === "create_draft" || key === "create_samples") {
            root.runAgentDraftForScope(
                        root.agentScopeMode,
                        root.agentEditController.userInstructions)
        } else if (key === "learn_style") {
            root.learnAgentStyleFromSelection()
        } else if (key === "choose_style") {
            if (agentRunDialogLoader.item)
                agentRunDialogLoader.item.preparePromptSuggestions()
        } else if (key === "apply_to_all") {
            root.agentEditController.applySampleReviewToAll(true)
        } else if (key === "commit") {
            const report = root.agentEditController.commitDraft(true)
            if (Boolean((report || ({})).ok))
                root.applyAgentResultToEditor(report)
        } else if (key === "cancel") {
            root.agentEditController.cancelRun("user_cancelled")
        } else if (key === "set_up_local_ai") {
            agentModelSetupDialog.present()
        }
    }

    function runSelectedAgentMode() {
        if (!agentCanRunMode(root.agentRunMode))
            return
        if (root.agentRunMode === "analyze") {
            root.agentEditController.analyzeSelected()
        } else if (root.agentRunMode === "validate-batch") {
            root.agentEditController.validateBatchForScope(root.agentScopeMode)
        } else if (root.agentRunMode === "export-preflight") {
            root.agentEditController.exportPreflightForScope(root.agentScopeMode)
        } else {
            root.runAgentDraftForScope(
                        root.agentScopeMode,
                        root.agentEditController.userInstructions)
        }
    }

    function agentLastReport() {
        return root.hasAgentEditController ? root.agentEditController.lastRunReport || ({}) : ({})
    }

    function editHistoryAgentRuns() {
        return root.hasAgentEditController ? root.agentEditController.runHistory || [] : []
    }

    function editHistoryAgentModeLabel(mode) {
        const normalized = String(mode || "").toLowerCase()
        if (normalized === "analyze")
            return "Analyzed photo"
        if (normalized === "validate-batch")
            return "Checked batch"
        if (normalized === "export-preflight")
            return "Checked export"
        if (normalized === "rollback")
            return "Rolled back assistant draft"
        if (normalized === "commit" || normalized === "apply")
            return "Applied assistant edit"
        if (normalized === "draft")
            return "Created assistant draft"
        return "Assistant action"
    }

    function editHistoryAgentDetail(entry) {
        const parts = []
        const assetCount = Number((entry && entry.assetCount) || 0)
        const durationMs = Number((entry && entry.durationMs) || 0)
        const warnings = Number((entry && entry.warningCount) || 0)
        if (assetCount > 0)
            parts.push(assetCount + (assetCount === 1 ? " photo" : " photos"))
        if (durationMs >= 0)
            parts.push(durationMs + " ms")
        if (warnings > 0)
            parts.push(warnings + (warnings === 1 ? " warning" : " warnings"))
        if (parts.length === 0)
            parts.push("Run provenance recorded")
        return parts.join(" • ")
    }

    function editHistoryAgentChangedRecipe(entry) {
        const mode = String((entry && entry.mode) || "").toLowerCase()
        return mode !== "analyze" && mode !== "validate-batch" && mode !== "export-preflight"
    }

    function agentPendingQuestionText() {
        if (!root.hasAgentEditController)
            return ""
        const questions = root.agentEditController.pendingUserQuestions || []
        const parts = []
        for (let index = 0; index < questions.length; ++index) {
            const question = questions[index]
            if (typeof question === "string") {
                if (question.length > 0)
                    parts.push(question)
            } else {
                const text = String((question && (question.question || question.text || question.prompt)) || "")
                if (text.length > 0)
                    parts.push(text)
            }
        }
        const report = root.agentLastReport()
        if (parts.length === 0 && String(report.planSummary || "").length > 0)
            parts.push(String(report.planSummary || ""))
        return parts.join("\n")
    }

    function agentHasPendingInputSurface() {
        if (!root.hasAgentEditController)
            return false
        const report = root.agentLastReport()
        return root.agentEditController.awaitingUserInput ||
               String(root.agentEditController.safeStopReason || "").length > 0 ||
               String(report.safeStopReason || "").length > 0
    }

    function agentSafeStopText() {
        if (!root.hasAgentEditController)
            return ""
        const report = root.agentLastReport()
        return String(root.agentEditController.safeStopReason ||
                      report.safeStopReason ||
                      report.planSummary || "")
    }

    function agentArtifactPath(keyName) {
        const report = root.agentLastReport()
        const key = String(keyName || "")
        if (report && report[key] !== undefined && String(report[key] || "").length > 0)
            return String(report[key])
        const draft = report && report.draftReport !== undefined ? report.draftReport : ({})
        if (draft && draft[key] !== undefined && String(draft[key] || "").length > 0)
            return String(draft[key])
        const validation = report && report.validationReport !== undefined ? report.validationReport : ({})
        const artifacts = validation && validation.artifacts !== undefined ? validation.artifacts : ({})
        if (artifacts && artifacts[key] !== undefined && String(artifacts[key] || "").length > 0)
            return String(artifacts[key])
        const draftValidation = draft && draft.validationReport !== undefined ? draft.validationReport : ({})
        const draftArtifacts = draftValidation && draftValidation.artifacts !== undefined
                               ? draftValidation.artifacts : ({})
        if (draftArtifacts && draftArtifacts[key] !== undefined && String(draftArtifacts[key] || "").length > 0)
            return String(draftArtifacts[key])
        return ""
    }

    function agentFileSource(path) {
        const text = String(path || "")
        if (text.length === 0)
            return ""
        if (text.indexOf("file:") === 0 || text.indexOf("qrc:") === 0)
            return text
        return "file://" + text
    }

    function agentProofImages() {
        const images = []
        if (root.hasAgentEditController && root.agentEditController.running) {
            const events = root.agentEditController.runEvents || []
            for (let index = events.length - 1; index >= 0; --index) {
                const evidence = (events[index] || ({})).evidence || ({})
                const liveAfter = String(evidence.afterProofPath || "")
                if (liveAfter.length > 0) {
                    images.push({ label: "Latest edited attempt", source: root.agentFileSource(liveAfter) })
                    break
                }
            }
            return images
        }
        const current = root.agentArtifactPath("currentProofPath")
        const before = root.agentArtifactPath("beforeProofPath")
        const after = root.agentArtifactPath("afterProofPath")
        if (before.length > 0)
            images.push({ label: "Before", source: root.agentFileSource(before) })
        if (after.length > 0)
            images.push({ label: "After", source: root.agentFileSource(after) })
        if (images.length === 0 && current.length > 0)
            images.push({
                label: root.agentLastReport().ok === false ? "Target unchanged" : "Current target",
                source: root.agentFileSource(current)
            })
        return images
    }

    function agentToolCalls() {
        const report = root.agentLastReport()
        return report && report.toolCalls !== undefined && report.toolCalls !== null ? report.toolCalls : []
    }

    function agentEditLoops() {
        const report = root.agentLastReport()
        if (report && report.editLoops !== undefined && report.editLoops !== null)
            return report.editLoops
        const loops = []
        const reports = report && report.assetReports !== undefined ? report.assetReports : []
        for (let index = 0; index < reports.length; ++index) {
            const loop = reports[index] && reports[index].editLoop !== undefined ? reports[index].editLoop : null
            if (loop)
                loops.push(loop)
        }
        return loops
    }

    function agentLoopAttemptRows() {
        const loops = root.agentEditLoops()
        const rows = []
        for (let loopIndex = 0; loopIndex < loops.length; ++loopIndex) {
            const loop = loops[loopIndex] || ({})
            const attempts = loop.attempts || []
            for (let attemptIndex = 0; attemptIndex < attempts.length && rows.length < 6; ++attemptIndex) {
                const attempt = attempts[attemptIndex] || ({})
                rows.push({
                    "label": "Attempt " + (Number(attempt.attemptIndex || attemptIndex) + 1),
                    "status": String(attempt.stopReasonCandidate || loop.finalStopReason || "checked"),
                    "score": Number(attempt.qualityScorePercent || Math.round(Number(attempt.qualityScore || 0) * 100)),
                    "warningCount": attempt.warnings !== undefined && attempt.warnings !== null ? attempt.warnings.length : 0,
                    "needsUserReview": Boolean(attempt.needsUserReview),
                    "assetId": String(loop.assetId || "")
                })
            }
        }
        return rows
    }

    function agentLoopSummaryText() {
        const loops = root.agentEditLoops()
        if (loops.length === 0)
            return ""
        const first = loops[0] || ({})
        const score = Number(first.finalScorePercent || Math.round(Number(first.finalScore || 0) * 100))
        const attemptCount = Number(first.attemptCount || (first.attempts ? first.attempts.length : 0))
        const review = first.needsUserReview ? "review" : "ready"
        return attemptCount + (attemptCount === 1 ? " attempt" : " attempts") +
               " · score " + score + "% · " +
               String(first.finalStopReason || review)
    }

    function agentLoopStatusColor(row) {
        const status = String((row && row.status) || "").toLowerCase()
        if (status.indexOf("failed") >= 0 || status.indexOf("invalid") >= 0)
            return theme.error
        if ((row && row.needsUserReview) || status.indexOf("warning") >= 0 ||
                status.indexOf("limit") >= 0 || status.indexOf("review") >= 0)
            return theme.warning
        if (status.indexOf("clean") >= 0 || status.indexOf("validated") >= 0)
            return theme.success
        return root.dimText
    }

    function agentToolCallStatusColor(call) {
        const status = String((call && call.status) || "").toLowerCase()
        if (status === "failed" || status === "error")
            return theme.error
        if (status === "warning")
            return theme.warning
        if (status === "ok" || status === "complete" || status === "completed" || status === "success")
            return theme.success
        return root.dimText
    }

    function agentToolCallTitle(call) {
        const name = String((call && call.name) || "tool")
        const status = String((call && call.status) || "recorded")
        return name + " · " + status
    }

    function agentToolCallDetail(call) {
        const outcome = call && call.outcome !== undefined ? call.outcome : ({})
        const parts = []
        const durationMs = Number((call && call.durationMs) || outcome.durationMs || 0)
        const warningCount = Number(outcome.warningCount || 0)
        const errorCount = Number(outcome.errorCount || 0)
        if (durationMs > 0)
            parts.push(durationMs + " ms")
        if (warningCount > 0)
            parts.push(warningCount + (warningCount === 1 ? " warning" : " warnings"))
        if (errorCount > 0)
            parts.push(errorCount + (errorCount === 1 ? " error" : " errors"))
        if (outcome.proofPath !== undefined && String(outcome.proofPath).length > 0)
            parts.push(String(outcome.proofPath))
        return parts.length > 0 ? parts.join(" · ") : "completed"
    }

    function agentRunWarnings() {
        const report = root.agentLastReport()
        const validation = report && report.validationReport !== undefined ? report.validationReport : ({})
        const warnings = []
        const addWarnings = function(items) {
            if (!items)
                return
            for (let index = 0; index < items.length; ++index) {
                const text = String(items[index] || "")
                if (text.length > 0 && warnings.indexOf(text) < 0)
                    warnings.push(text)
            }
        }
        addWarnings(report.warnings)
        addWarnings(validation.warnings)
        return warnings
    }

    function agentRunArtifactSummary() {
        const parts = []
        const current = root.agentArtifactPath("currentProofPath")
        const before = root.agentArtifactPath("beforeProofPath")
        const after = root.agentArtifactPath("afterProofPath")
        const manifest = root.agentArtifactPath("manifestPath")
        const shareable = root.agentArtifactPath("shareableManifestPath")
        if (current.length > 0)
            parts.push("proof " + current)
        if (before.length > 0)
            parts.push("before " + before)
        if (after.length > 0)
            parts.push("after " + after)
        if (manifest.length > 0)
            parts.push("manifest " + manifest)
        if (shareable.length > 0)
            parts.push("shareable " + shareable)
        return parts.join(" · ")
    }

    function agentRecipeDiff() {
        const report = root.agentLastReport()
        if (report && report.recipeDiff !== undefined && report.recipeDiff !== null)
            return report.recipeDiff
        const validation = report && report.validationReport !== undefined ? report.validationReport : ({})
        if (validation && validation.recipeDiff !== undefined && validation.recipeDiff !== null)
            return validation.recipeDiff
        return ({})
    }

    function agentRecipeDiffGroupCount() {
        const diff = root.agentRecipeDiff()
        let count = 0
        const keys = Object.keys(diff)
        for (let index = 0; index < keys.length; ++index) {
            const group = diff[keys[index]]
            if (group && typeof group === "object" && Object.keys(group).length > 0)
                count += 1
        }
        return count
    }

    function agentStyleCitationCount() {
        const report = root.agentLastReport()
        const citations = report && report.styleConstraintCitations !== undefined
                          ? report.styleConstraintCitations
                          : []
        return citations.length || 0
    }

    function agentRunEvidenceSummary() {
        const report = root.agentLastReport()
        const validation = report && report.validationReport !== undefined ? report.validationReport : ({})
        const parts = []
        const toolCount = root.agentToolCalls().length
        const diffCount = root.agentRecipeDiffGroupCount()
        const citationCount = root.agentStyleCitationCount()
        const warningCount = root.agentRunWarnings().length
        if (toolCount > 0)
            parts.push(toolCount + " tool call" + (toolCount === 1 ? "" : "s"))
        if (diffCount > 0)
            parts.push(diffCount + " recipe group" + (diffCount === 1 ? "" : "s"))
        if (validation.ok !== undefined)
            parts.push(validation.ok ? "validation passed" : "validation failed")
        if (warningCount > 0)
            parts.push(warningCount + " warning" + (warningCount === 1 ? "" : "s"))
        if (citationCount > 0)
            parts.push(citationCount + " style citation" + (citationCount === 1 ? "" : "s"))
        if (root.agentLoopSummaryText().length > 0)
            parts.push(root.agentLoopSummaryText())
        if (String((report && report.shareableManifestPath) || "").length > 0)
            parts.push("shareable report ready")
        return parts.join(" · ")
    }

    function agentThinkingLines() {
        const report = root.agentLastReport()
        const draftReport = report && report.draftReport !== undefined ? report.draftReport : ({})
        const state = root.agentWorkflowState()
        const lines = []
        const addLine = function(text) {
            const value = String(text || "").trim()
            if (value.length > 0 && lines.indexOf(value) < 0)
                lines.push(value)
        }

        if (root.hasAgentEditController && root.agentEditController.running)
            addLine("Working: " + String(root.agentEditController.status || state.statusLine || "planning the edit"))
        if (root.hasAgentEditController && root.agentEditController.awaitingUserInput)
            addLine("Waiting on you: " + root.agentPendingQuestionText())

        addLine(report.planSummary)
        addLine(draftReport.planSummary)
        addLine(report.analysisSummary)

        const goals = report.editGoals || draftReport.editGoals || []
        for (let index = 0; index < goals.length && lines.length < 6; ++index) {
            const goal = goals[index]
            if (typeof goal === "string")
                addLine(goal)
            else
                addLine(goal.label || goal.goal || goal.summary || goal.reason)
        }

        const risk = report.riskAssessment || draftReport.riskAssessment || ({})
        const approvalTypes = risk.approvalTypes || []
        if (approvalTypes.length > 0)
            addLine("Needs care around " + approvalTypes.join(", ") + ".")
        addLine(report.reviewRequiredReason || draftReport.reviewRequiredReason)

        const evidence = root.agentRunEvidenceSummary()
        if (evidence.length > 0)
            addLine("Evidence: " + evidence)

        const calls = root.agentToolCalls()
        if (calls.length > 0) {
            const latest = calls[Math.min(calls.length - 1, 2)] || ({})
            addLine("Last checked: " + root.agentToolCallTitle(latest))
        }

        if (lines.length === 0) {
            const style = root.agentSelectedStyleName()
            const scope = String(state.scopeLabel || root.agentScopeModeFullLabel(root.agentScopeMode) || "")
            addLine("Ready to reason from " + (style.length > 0 ? style : "the selected inspiration") +
                    (scope.length > 0 ? " across " + scope + "." : "."))
        }
        return lines.slice(0, 6)
    }

    function agentThinkingVisible() {
        if (!root.hasAgentEditController)
            return false
        if (root.agentEditController.running || root.agentEditController.awaitingUserInput)
            return root.agentThinkingLines().length > 0
        return root.agentHasRunAudit() && root.agentThinkingLines().length > 0
    }

    function agentHasRunAudit() {
        return root.agentToolCalls().length > 0 ||
               root.agentEditLoops().length > 0 ||
               root.agentRunWarnings().length > 0 ||
               root.agentRunArtifactSummary().length > 0 ||
               root.agentRunEvidenceSummary().length > 0
    }

    function agentMaskLocalProofText() {
        const report = root.agentLastReport()
        const proof = report && report.maskLocalProof !== undefined ? report.maskLocalProof : ({})
        if (!proof || proof.required !== true)
            return ""
        const maskCount = Number(proof.maskStackCount || 0)
        const localCount = Number(proof.localAdjustmentFieldCount || 0)
        const ready = proof.proofAvailable === true ? "proof ready" : "proof pending"
        return "Mask/local " + ready + " · " + maskCount + " masks · " + localCount + " local edits"
    }

    function systemHealthItems() {
        const gpuActive = previewBackend ? String(previewBackend.activeBackend || "CPU") : "Unavailable"
        const gpuDetail = root.developerDiagnosticsEnabled
                ? (previewBackend && String(previewBackend.fallbackReason || "").length > 0
                   ? String(previewBackend.fallbackReason)
                   : (previewBackend ? String(previewBackend.backendSummary || gpuActive) : "Preview backend unavailable"))
                : (previewBackend && previewBackend.gpuAvailable ? "Preview acceleration ready" : "Preview acceleration limited")
        const gpuState = previewBackend && previewBackend.gpuAvailable ? "OK" : (gpuActive === "CPU" ? "CPU" : "Warn")

        const modelReady = editorPreview.aiSmartSelectionAvailable || editorPreview.aiInpaintAvailable
        const modelFeatures = [
            editorPreview.smartSelectionRuntimeLabel,
            editorPreview.inpaintRuntimeLabel
        ].filter(function(item) { return item.length > 0 }).join(", ")
        const modelDiagnostics = String(editorPreview.aiModelDiagnostics || "")
        const modelDetail = root.developerDiagnosticsEnabled
                ? (modelReady
                   ? modelFeatures + " / " + modelDiagnostics
                   : modelFeatures + " / " + String(editorPreview.aiModelStatus || "Model runtime unavailable") + " / " + modelDiagnostics)
                : (modelReady ? modelFeatures : "Local selection and retouch tools unavailable")

        const catalogState = catalogAssets.errorMessage.length > 0
                ? "Error"
                : (catalogAssets.busy ? "Busy" : "OK")
        const catalogDetail = catalogAssets.errorMessage.length > 0
                ? catalogAssets.errorMessage
                : formatInt(catalogAssets.totalAssetCount) + " assets / " + importStatusText()

        const exportFailures = jobQueue ? jobQueue.failedJobCountForKind("asset_export") : 0
        const exportActive = jobQueue ? jobQueue.activeJobCountForKind("asset_export") : 0
        const exportState = exportFailures > 0 ? "Error" : (exportActive > 0 || (exportJobs && exportJobs.busy) ? "Busy" : "OK")
        const exportDetail = jobQueue
                ? jobQueue.statusForKind("asset_export", exportJobs ? exportJobs.status : "Export queue ready.")
                : "Export queue unavailable"

        return [
            { label: "GPU", state: gpuState, detail: gpuDetail },
            { label: "Model", state: modelReady ? "OK" : "Warn", detail: modelDetail },
            { label: "Catalog", state: catalogState, detail: catalogDetail },
            { label: "Export", state: exportState, detail: exportDetail }
        ]
        if (layerKind === "text") {
            items.splice(7, 0, {
                key: "toggle-text-controls",
                label: root.expandedTextLayerIndex === validIndex ? "Hide Text Controls" : "Text Controls",
                icon: "edit",
                enabled: validIndex >= 0,
                checked: root.expandedTextLayerIndex === validIndex,
                disabledReason: "Layer is no longer available.",
                tooltip: "Show text content, font, color, size, alignment, and text box controls."
            })
        }
        return items
    }

