Rectangle {
    id: root
    objectName: page === "library" ? "libraryStudioWorkspace"
                : page === "edit" ? "editStudioWorkspace"
                : "exportStudioWorkspace"
    color: "transparent"
    focus: true
    readonly property bool pageContentReady: studioPageLoader.status === Loader.Ready
    readonly property bool libraryLoadingSceneVisible: page === "library" &&
        (!pageContentReady || (catalogAssets.loading && root.assetCount() === 0 &&
         !root.importModeOpen && !root.libraryDocumentsOpen && root.catalogViewMode !== "cull"))

    Theme { id: theme }
    property alias canvasRulersVisible: editGuideState.rulersVisible
    CanvasGuideState {
        id: editGuideState
        workspaceKey: root.inspectorOnly ? "TimelineColorInspector" : String(root.page || "edit")
        documentKey: root.editorPreviewController ? String(root.editorPreviewController.assetId || "") : ""
        canvasWidth: root.editorPreviewController ? root.editorPreviewController.sourceImageWidth : 1
        canvasHeight: root.editorPreviewController ? root.editorPreviewController.sourceImageHeight : 1
    }
    Shortcut {
        sequence: "Ctrl+Shift+R"
        context: Qt.WindowShortcut
        enabled: root.workspaceActive && root.visible && root.page === "edit" && !root.inspectorOnly
        onActivated: editGuideState.rulersVisible = !editGuideState.rulersVisible
    }
    Shortcut {
        sequence: "Ctrl+Alt+J"
        context: Qt.WindowShortcut
        enabled: root.workspaceActive && root.visible && root.page === "edit" && !root.inspectorOnly
        onActivated: root.setAnalysisOverlay("clipping")
