    function startRetouchTool(modeName, switchAlreadyPrepared) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (switchAlreadyPrepared !== true) {
            root.beginEditToolSwitch("retouch")
            root.clearTransientToolStateFor("retouch")
        }
        root.editTool = "retouch"
        root.editInspectorTab = "adjust"
        editorPreview.compareMode = false
        editorPreview.cropEditing = false
        editorPreview.maskPreviewMode = "overlay"
        root.pendingRetouchStartMode = mode.length > 0 ? mode : "remove"
        retouchToolStartTimer.restart()
        root.rememberEditToolVariant("retouch", root.pendingRetouchStartMode)
        return root.pendingRetouchStartMode
    }

    function completePendingRetouchToolStart() {
        const mode = String(root.pendingRetouchStartMode || "")
        root.pendingRetouchStartMode = ""
        if (root.editTool !== "retouch" || mode.length === 0)
            return ""
        if (mode === "heal")
            editorPreview.startHealBrush()
        else if (mode === "patch")
            editorPreview.startPatchBrush()
        else if (mode === "clone")
            editorPreview.startCloneBrush()
        else if (mode === "dust")
            editorPreview.removeDustSpots()
        else if (mode === "red-eye")
            editorPreview.removeRedEye()
        else if (mode === "skin-cleanup" || mode === "skin")
            editorPreview.cleanupSkin()
        else if (mode === "frequency-smoothing" || mode === "smooth")
            editorPreview.smoothSkinFrequency()
        else
            editorPreview.startRemoveBrush()
        root.rememberEditToolVariant("retouch", editorPreview.activeMaskRetouchMode)
        return editorPreview.activeMaskRetouchMode
    }

    function retouchModeLabel(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove")
            return "Remove"
        if (mode === "heal")
            return "Heal"
        if (mode === "patch")
            return "Patch"
        if (mode === "clone")
            return "Clone Stamp"
        if (mode === "dust")
            return "Dust Cleanup"
        if (mode === "red-eye")
            return "Red Eye"
        if (mode === "skin-cleanup")
            return "Skin Cleanup (Heuristic)"
        if (mode === "frequency-smoothing")
            return "Frequency Smoothing"
        return "Retouch"
    }

    function retouchModeCapabilityState(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove" || mode === "heal" || mode === "patch")
            return editorPreview.aiInpaintAvailable ? "model-ready" : "local-fallback"
        if (mode === "clone")
            return "deterministic"
        if (mode === "dust" || mode === "red-eye")
            return "local-staged"
        if (mode === "skin-cleanup" || mode === "frequency-smoothing")
            return "experimental-hidden"
        return "unsupported-hidden"
    }

    function retouchModeVisibilityState(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove" || mode === "heal" || mode === "patch" || mode === "clone")
            return "primary"
        if (mode === "dust" || mode === "red-eye")
            return "mode-menu"
        return root.retouchModeCapabilityState(mode)
    }

    function retouchModeIsPrimary(modeName) {
        return root.retouchModeVisibilityState(modeName) === "primary"
    }

    function retouchHudModeMenuItems() {
        return [
            { key: "retouch-remove", label: "Remove", icon: "erase-tool", checked: editorPreview.activeMaskRetouchMode === "remove", tooltip: "Paint an object removal area." },
            { key: "retouch-heal", label: "Heal", icon: "brush-tool", checked: editorPreview.activeMaskRetouchMode === "heal", tooltip: "Blend blemishes into nearby texture." },
            { key: "retouch-patch", label: "Patch", icon: "geometry", checked: editorPreview.activeMaskRetouchMode === "patch", tooltip: "Patch a painted area from surrounding pixels." },
            { key: "retouch-clone", label: "Clone Stamp", icon: "source", checked: editorPreview.activeMaskRetouchMode === "clone", tooltip: "Clone from a sampled source." },
            { key: "retouch-dust", label: "Dust Cleanup", icon: "scope", separatorBefore: true, checked: editorPreview.activeMaskRetouchMode === "dust", tooltip: "Stage local dust spot cleanup." },
            { key: "retouch-red-eye", label: "Red Eye", icon: "adjust", checked: editorPreview.activeMaskRetouchMode === "red-eye", tooltip: "Stage red-eye correction." },
            { key: "retouch-skin-cleanup", label: "Skin Cleanup (Heuristic)", icon: "brush-tool", separatorBefore: true, enabled: false, disabledReason: "Experimental skin cleanup is hidden until the workflow is production-ready.", tooltip: "Experimental skin cleanup is not available in the primary HUD." },
            { key: "retouch-frequency-smoothing", label: "Frequency Smoothing", icon: "brush-tool", enabled: false, disabledReason: "Experimental frequency smoothing is hidden until the workflow is production-ready.", tooltip: "Experimental frequency smoothing is not available in the primary HUD." }
        ]
    }

    function retouchCapabilityText() {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch")
            return "Ready"
        const state = root.retouchModeCapabilityState(editorPreview.activeMaskRetouchMode)
        if (state === "model-ready")
            return editorPreview.inpaintRuntimeLabel
        if (state === "local-fallback")
            return editorPreview.inpaintRuntimeLabel + " local"
        if (state === "deterministic")
            return "Manual"
        if (state === "local-staged")
            return "Local staged"
        if (state === "experimental-hidden")
            return "Experimental"
        return "Unsupported"
    }

    function retouchRequirementText() {
        const mode = editorPreview.activeMaskRetouchMode
        if (mode === "clone")
            return editorPreview.activeMaskCloneSourceSet ? "Source set" : "Pick source"
        if (mode === "remove" || mode === "heal" || mode === "patch")
            return editorPreview.activeMaskCommitted ? "Applied" : "Paint area"
        if (mode === "dust" || mode === "red-eye" || mode === "skin-cleanup" ||
                mode === "frequency-smoothing")
            return editorPreview.activeMaskCommitted ? "Review applied" : "Review staged"
        return editorPreview.activeMaskCommitted ? "Applied" : "Staged"
    }

    function retouchHudStatusText() {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch")
            return "Retouch"
        if (editorPreview.inpaintProgressActive)
            return String(editorPreview.inpaintProgressLabel || "Final retouch") + " / " +
                   Math.round(Math.max(0, Math.min(1, Number(editorPreview.inpaintProgressValue || 0))) * 100) + "%"
        return root.retouchModeLabel(editorPreview.activeMaskRetouchMode) + " / " +
               root.retouchRequirementText() + " / " +
               (editorPreview.retouchBeforeAfterEnabled ? "Before" : "After")
    }

    function retouchHudPrimaryText() {
        if (editorPreview.inpaintProgressActive)
            return "Cancel"
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch")
            return "Done"
        return editorPreview.activeMaskCommitted ? "Done" : "Apply"
    }

    function retouchHudPrimaryTooltip() {
        if (editorPreview.inpaintProgressActive)
            return "Stop generation and keep the previous applied patch."
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch")
            return "Exit retouch."
        if (editorPreview.activeMaskCommitted)
            return "Leave retouch and return to adjustment controls."
        return "Apply this retouch patch to the edit recipe; the original file is unchanged."
    }

    function completeRetouchTool() {
        root.finishSelectionWorkflow()
    }

    function triggerRetouchPrimaryAction() {
        if (editorPreview.inpaintProgressActive) {
            editorPreview.cancelActiveRetouch()
            return
        }
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch") {
            root.activateEditTool("adjust")
            return
        }
        if (editorPreview.activeMaskCommitted)
            root.completeRetouchTool()
        else
            editorPreview.applyActiveRetouch()
    }

    function retouchHudInlineActions() {
        if (!editorPreview.hasActiveMask ||
                editorPreview.activeMaskToolRole !== "retouch" ||
                editorPreview.activeMaskRetouchMode !== "remove")
            return []
        return [
            {
                key: "remove-add",
                objectName: "retouchHudRemoveAddButton",
                label: "Add",
                icon: "brush-tool",
                role: "segmented",
                checked: editorPreview.activeMaskOperation === "add",
                accent: "#d98962",
                tooltip: "Add to the pending remove area."
            },
            {
                key: "remove-subtract",
                objectName: "retouchHudRemoveSubtractButton",
                label: "Subtract",
                icon: "brush-subtract",
                role: "segmented",
                checked: editorPreview.activeMaskOperation === "subtract",
                accent: "#d36a5e",
                tooltip: "Subtract from the pending remove area."
            }
        ]
    }

    function handleRetouchHudInlineAction(key) {
        if (key === "remove-add") {
            editorPreview.startRemoveRefineBrush(false)
            return
        }
        if (key === "remove-subtract")
            editorPreview.startRemoveRefineBrush(true)
    }

    function retouchHudMoreMenuItems() {
        const active = editorPreview.hasActiveMask && editorPreview.activeMaskToolRole === "retouch"
        if (!active)
            return []
        const mode = String(editorPreview.activeMaskRetouchMode || "remove")
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const committed = editorPreview.activeMaskCommitted
        const items = [
            {
                key: "before-after",
                label: editorPreview.retouchBeforeAfterEnabled ? "Show After" : "Show Before",
                icon: "compare",
                checked: editorPreview.retouchBeforeAfterEnabled,
                tooltip: editorPreview.retouchBeforeAfterEnabled
                         ? "Return to the retouched result; the edit recipe is unchanged."
                         : "Compare against the pre-retouch image; the edit recipe is unchanged."
            }
        ]
        if (inpaintMode) {
            const texture = String(editorPreview.inpaintPrompt || "")
            items.push({ key: "texture-auto", label: "Fill texture: automatic", checked: texture.length === 0, separatorBefore: true, enabled: !committed, tooltip: "Reconstruct the surrounding image texture. This does not generate objects from text." })
            items.push({ key: "texture-smooth", label: "Fill texture: smooth", checked: texture === "smooth", enabled: !committed, tooltip: "Reduce texture in the reconstructed area." })
            items.push({ key: "texture-detail", label: "Fill texture: detailed", checked: texture === "texture detail", enabled: !committed, tooltip: "Preserve more surrounding texture in the reconstructed area." })
            items.push({
                           key: "regenerate",
                           label: committed ? "Regenerate Patch" : "Regenerate Preview",
                           icon: "reset",
                           enabled: !committed || editorPreview.activeInpaintRegenerationAvailable,
                           disabledReason: "Apply or select a generated patch before regenerating.",
                           tooltip: committed
                                    ? "Regenerate this applied retouch patch from its stored source selection."
                                    : "Advance the seed for the pending retouch patch candidate."
                       })
	            items.push({
	                           key: "finalize",
	                           label: "Finalize Result",
	                           icon: "check",
	                           enabled: editorPreview.activeInpaintFinalizationAvailable,
	                           disabledReason: "Apply a preview patch before finalizing the retouch result.",
	                           tooltip: "Queue the final retouch result from the stored source selection."
	                       })
        }
        if (editorPreview.maskActionRetryAvailable &&
                String(editorPreview.maskActionRetryLabel || "").indexOf("Inpaint") >= 0) {
            items.push({
                           key: "retry",
                           label: editorPreview.maskActionRetryLabel || "Retry",
                           icon: "reset",
                           tooltip: editorPreview.maskActionRetryDetail || "Retry the last failed retouch action."
                       })
        }
        if (mode === "heal") {
            items.push({ key: "heal-texture-down", label: "Less Texture", icon: "minus", separatorBefore: true, tooltip: "Reduce synthesized heal texture." })
            items.push({ key: "heal-texture-up", label: "More Texture", icon: "plus", tooltip: "Increase synthesized heal texture." })
            items.push({ key: "heal-color-down", label: "Less Color Blend", icon: "minus", tooltip: "Preserve more of the original heal color." })
            items.push({ key: "heal-color-up", label: "More Color Blend", icon: "plus", tooltip: "Blend more repaired heal color." })
        }
        if (mode === "patch") {
            items.push({ key: "patch-left", label: "Move Source Left", icon: "move-back", separatorBefore: true, tooltip: "Move the Patch source region left before applying." })
            items.push({ key: "patch-right", label: "Move Source Right", icon: "move-forward", tooltip: "Move the Patch source region right before applying." })
            items.push({ key: "patch-up", label: "Move Source Up", icon: "move-up", tooltip: "Move the Patch source region up before applying." })
            items.push({ key: "patch-down", label: "Move Source Down", icon: "move-down", tooltip: "Move the Patch source region down before applying." })
            items.push({ key: "patch-reset", label: "Reset Source Region", icon: "reset", tooltip: "Reset the Patch source region before applying." })
        }
        if (mode === "clone") {
            items.push({
                           key: "clone-aligned",
                           label: editorPreview.activeMaskCloneAligned ? "Aligned Clone" : "Non-aligned Clone",
                           icon: "source",
                           checked: editorPreview.activeMaskCloneAligned,
                           separatorBefore: true,
                           tooltip: "Toggle whether Clone Stamp keeps the source offset continuous across strokes."
                       })
            items.push({ key: "clone-save-source", label: "Save Clone Source", icon: "plus", enabled: editorPreview.activeMaskCloneSourceSet, disabledReason: "Pick a clone source before saving it.", tooltip: "Save the current Clone Stamp source, scale, rotation, and alignment." })
            items.push({ key: "clone-scale-down", label: "Reduce Clone Scale", icon: "minus", tooltip: "Reduce Clone Stamp source scale." })
            items.push({ key: "clone-scale-up", label: "Increase Clone Scale", icon: "plus", tooltip: "Increase Clone Stamp source scale." })
            items.push({ key: "clone-rotate-left", label: "Rotate Clone Left", icon: "undo", tooltip: "Rotate Clone Stamp source counterclockwise." })
            items.push({ key: "clone-rotate-right", label: "Rotate Clone Right", icon: "reset", tooltip: "Rotate Clone Stamp source clockwise." })
            const sources = editorPreview.activeMaskCloneSources || []
            for (let sourceIndex = 0; sourceIndex < sources.length; ++sourceIndex) {
                items.push({
                               key: "clone-source-" + sourceIndex,
                               label: String(sources[sourceIndex].name || ("Source " + (sourceIndex + 1))),
                               icon: "target",
                               checked: editorPreview.activeMaskCloneSourceIndex === sourceIndex,
                               tooltip: "Load saved Clone Stamp source."
                           })
            }
        }
        if (editorPreview.activeInpaintVariationPickerVisible) {
            for (let index = 0; index < editorPreview.activeInpaintCandidateCount; ++index) {
                items.push({
                               key: "variation-" + index,
                               label: "Use Variation " + String(index + 1),
                               icon: "compare",
                               checked: editorPreview.activeInpaintCandidateIndex === index,
                               separatorBefore: index === 0,
                               tooltip: "Use inpaint variation " + String(index + 1) + " from the generated patch candidates."
                           })
            }
        }
        if (editorPreview.inpaintProgressActive) {
            items.push({ key: "cancel", label: "Cancel Inpainting", icon: "close", separatorBefore: true, tooltip: "Stop generation and keep the previous applied patch." })
        } else if (!committed) {
            items.push({ key: "reset-selection", label: "Reset Selection", icon: "reset", separatorBefore: true, tooltip: "Clear the pending retouch selection while keeping the active retouch tool." })
            items.push({ key: "cancel", label: "Cancel Retouch", icon: "close", tooltip: "Discard the pending retouch selection before it is applied." })
        } else {
            items.push({ key: "reopen-selection", label: "Reopen Selection", icon: "brush-tool", separatorBefore: true, tooltip: "Reopen the applied retouch selection for refinement." })
            items.push({ key: "delete-patch", label: "Delete Patch", icon: "delete", destructive: true, tooltip: "Remove the applied retouch patch from the edit recipe." })
        }
        return items
    }

    function handleRetouchHudMoreMenuAction(key) {
        if (key === "texture-auto" || key === "texture-smooth" || key === "texture-detail") {
            editorPreview.inpaintPrompt = key === "texture-auto" ? "" : key === "texture-smooth" ? "smooth" : "texture detail"
        } else if (key === "before-after") {
            editorPreview.retouchBeforeAfterEnabled = !editorPreview.retouchBeforeAfterEnabled
        } else if (key === "regenerate") {
            if (editorPreview.activeMaskCommitted)
                editorPreview.regenerateActiveInpaintPatch()
            else
                editorPreview.regenerateInpaintSeed()
        } else if (key === "finalize") {
            editorPreview.queueActiveFinalInpaintPatch()
        } else if (key === "retry") {
            editorPreview.retryLastMaskAction()
        } else if (key === "heal-texture-down") {
            editorPreview.activeMaskHealTextureBlend = editorPreview.activeMaskHealTextureBlend - 0.08
        } else if (key === "heal-texture-up") {
            editorPreview.activeMaskHealTextureBlend = editorPreview.activeMaskHealTextureBlend + 0.08
        } else if (key === "heal-color-down") {
            editorPreview.activeMaskHealColorBlend = editorPreview.activeMaskHealColorBlend - 0.08
        } else if (key === "heal-color-up") {
            editorPreview.activeMaskHealColorBlend = editorPreview.activeMaskHealColorBlend + 0.08
        } else if (key === "patch-left") {
            root.retouchPatchSourceNudge(-0.04, 0.0)
        } else if (key === "patch-right") {
            root.retouchPatchSourceNudge(0.04, 0.0)
        } else if (key === "patch-up") {
            root.retouchPatchSourceNudge(0.0, -0.04)
        } else if (key === "patch-down") {
            root.retouchPatchSourceNudge(0.0, 0.04)
        } else if (key === "patch-reset") {
            editorPreview.setActiveMaskPatchSourceRegion(0.62, 0.50, 0.18, 0.18)
        } else if (key === "clone-aligned") {
            editorPreview.activeMaskCloneAligned = !editorPreview.activeMaskCloneAligned
        } else if (key === "clone-save-source") {
            editorPreview.saveActiveCloneSource()
        } else if (key === "clone-scale-down") {
            editorPreview.activeMaskCloneScale = editorPreview.activeMaskCloneScale - 0.1
        } else if (key === "clone-scale-up") {
            editorPreview.activeMaskCloneScale = editorPreview.activeMaskCloneScale + 0.1
        } else if (key === "clone-rotate-left") {
            editorPreview.activeMaskCloneRotation = editorPreview.activeMaskCloneRotation - 15
        } else if (key === "clone-rotate-right") {
            editorPreview.activeMaskCloneRotation = editorPreview.activeMaskCloneRotation + 15
        } else if (key.indexOf("clone-source-") === 0) {
            editorPreview.selectActiveCloneSource(Number(key.substring(13)))
        } else if (key.indexOf("variation-") === 0) {
            editorPreview.activeInpaintCandidateIndex = Number(key.substring(10))
        } else if (key === "reset-selection") {
            editorPreview.resetActiveRetouchSelection()
        } else if (key === "cancel") {
            editorPreview.cancelActiveRetouch()
        } else if (key === "reopen-selection") {
            editorPreview.reopenActiveRetouchSelection()
        } else if (key === "delete-patch") {
            editorPreview.deleteActiveRetouchPatch()
        }
    }

    function retouchToolVisibilitySignature() {
        const active = editorPreview.hasActiveMask && editorPreview.activeMaskToolRole === "retouch"
        const mode = active ? String(editorPreview.activeMaskRetouchMode || "remove") : "none"
        return "retouch-tool-visibility:v2" +
               "|family:Retouch" +
               "|variant:" + (active ? root.retouchModeLabel(mode) : "Retouch") +
               "|mode:" + mode +
               "|status:" + root.retouchHudStatusText() +
               "|last:" + root.editToolLastUsedVariant("retouch", mode) +
               "|hud:" + String(active && !editorPreview.compareMode) +
               "|layout:single-row-command-bar" +
               "|primary:" + root.retouchHudPrimaryText() +
               "|inline:" + String(root.retouchHudInlineActions().length) +
               "|more:" + String(root.retouchHudMoreMenuItems().length) +
               "|text:no-elide-no-overlap" +
               "|menus:secondary-actions"
    }

    function retouchWorkflowSignature() {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskToolRole !== "retouch")
            return "mode:none|label:Retouch|stage:inactive|source:none|apply:false|regenerate:false|beforeAfter:after"
        const mode = editorPreview.activeMaskRetouchMode
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const canRegenerate = inpaintMode &&
                (!editorPreview.activeMaskCommitted || editorPreview.activeInpaintRegenerationAvailable)
        const sourceState = mode === "clone"
                ? (editorPreview.activeMaskCloneSourceSet ? "set" : "required")
                : (mode === "patch"
                   ? (editorPreview.activeMaskPatchSourceSet ? "region" : "required")
                   : "none")
        return "mode:" + mode +
               "|label:" + root.retouchModeLabel(mode) +
               "|stage:" + root.retouchRequirementText() +
               "|source:" + sourceState +
               "|apply:" + String(!editorPreview.activeMaskCommitted) +
               "|regenerate:" + String(canRegenerate) +
                 "|capability:" + root.retouchModeCapabilityState(mode) +
                 "|beforeAfter:" + (editorPreview.retouchBeforeAfterEnabled ? "before" : "after") +
                 (editorPreview.inpaintProgressActive
                  ? "|inpaintProgress:" + Math.max(0, Math.min(1, Number(editorPreview.inpaintProgressValue || 0))).toFixed(3)
                    + "|inpaintProgressLabel:" + String(editorPreview.inpaintProgressLabel || "")
                  : "")
    }

    function retouchAllWorkflowStateSignature() {
        return editorPreview.retouchWorkflowStateSignature
    }

    function retouchVariationPickerSignature() {
        return "visible:" + String(editorPreview.activeInpaintVariationPickerVisible) +
               "|count:" + String(editorPreview.activeInpaintCandidateCount) +
               "|index:" + String(editorPreview.activeInpaintCandidateIndex)
    }

    function activeCloneMaskDefinition() {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskIndex < 0)
            return ({})
        const stack = editorPreview.maskStack || []
        if (editorPreview.activeMaskIndex >= stack.length)
            return ({})
        return stack[editorPreview.activeMaskIndex] || ({})
    }

    function activeCloneTargetX() {
        const mask = root.activeCloneMaskDefinition()
        return root.clamp(Number(mask.cloneSourceX !== undefined ? mask.cloneSourceX : editorPreview.activeMaskCloneSourceX) -
                          Number(mask.cloneOffsetX || 0), 0.0, 1.0)
    }

    function activeCloneTargetY() {
        const mask = root.activeCloneMaskDefinition()
        return root.clamp(Number(mask.cloneSourceY !== undefined ? mask.cloneSourceY : editorPreview.activeMaskCloneSourceY) -
                          Number(mask.cloneOffsetY || 0), 0.0, 1.0)
    }

    function retouchCloneOverlaySignature() {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskRetouchMode !== "clone")
            return "visible:false"
        return "visible:" + String(editorPreview.activeMaskCloneSourceSet) +
               "|source:" + Math.round(editorPreview.activeMaskCloneSourceX * 100).toString() + "," +
                    Math.round(editorPreview.activeMaskCloneSourceY * 100).toString() +
               "|target:" + Math.round(root.activeCloneTargetX() * 100).toString() + "," +
                    Math.round(root.activeCloneTargetY() * 100).toString() +
               "|scale:" + Number(editorPreview.activeMaskCloneScale).toFixed(2) +
               "|rotation:" + Math.round(editorPreview.activeMaskCloneRotation).toString() +
               "|mode:" + (editorPreview.activeMaskCloneAligned ? "aligned" : "non-aligned")
    }

    function retouchCloneSourcePanelSignature() {
        const sources = editorPreview.activeMaskCloneSources || []
        const first = sources.length > 0 ? String(sources[0].name || "Source 1") : "none"
        return "visible:" + String(editorPreview.hasActiveMask && editorPreview.activeMaskRetouchMode === "clone") +
               "|count:" + String(editorPreview.activeMaskCloneSourceCount) +
               "|index:" + String(editorPreview.activeMaskCloneSourceIndex) +
               "|first:" + first
    }

    function retouchPatchSourceSignature() {
        return "visible:" + String(editorPreview.hasActiveMask && editorPreview.activeMaskRetouchMode === "patch") +
               "|set:" + String(editorPreview.activeMaskPatchSourceSet) +
               "|x:" + Math.round(editorPreview.activeMaskPatchSourceX * 100).toString() +
               "|y:" + Math.round(editorPreview.activeMaskPatchSourceY * 100).toString() +
               "|w:" + Math.round(editorPreview.activeMaskPatchSourceWidth * 100).toString() +
               "|h:" + Math.round(editorPreview.activeMaskPatchSourceHeight * 100).toString()
    }

    function retouchPatchSourceNudge(deltaX, deltaY) {
        if (!editorPreview.hasActiveMask || editorPreview.activeMaskRetouchMode !== "patch")
            return
        editorPreview.setActiveMaskPatchSourceRegion(
                    editorPreview.activeMaskPatchSourceX + deltaX,
                    editorPreview.activeMaskPatchSourceY + deltaY,
                    editorPreview.activeMaskPatchSourceWidth,
                    editorPreview.activeMaskPatchSourceHeight)
    }

    function retouchBeforeAfterSignature() {
        return "view:" + (editorPreview.retouchBeforeAfterEnabled ? "before" : "after") +
               "|button:" + (editorPreview.retouchBeforeAfterEnabled ? "Show After" : "Show Before") +
               "|recipe:unchanged"
    }

    function retouchHealBlendSignature() {
        return "visible:" + String(editorPreview.hasActiveMask && editorPreview.activeMaskRetouchMode === "heal") +
               "|texture:" + Math.round(editorPreview.activeMaskHealTextureBlend * 100).toString() +
               "|color:" + Math.round(editorPreview.activeMaskHealColorBlend * 100).toString()
    }

    function retouchActionSignature() {
        const active = editorPreview.hasActiveMask && editorPreview.activeMaskToolRole === "retouch"
        const committed = active && editorPreview.activeMaskCommitted
        return "apply:" + String(active && !committed) +
               "|cancel:" + String(active && !committed) +
               "|reset:" + String(active && !committed) +
               "|delete:" + String(committed) +
               "|reopen:" + String(committed)
    }

    function retouchRecoverabilitySignature() {
        const mode = editorPreview.hasActiveMask && editorPreview.activeMaskToolRole === "retouch"
                ? editorPreview.activeMaskRetouchMode
                : "none"
        const state = root.retouchModeCapabilityState(mode)
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const canRegenerate = editorPreview.hasActiveMask && inpaintMode &&
                (!editorPreview.activeMaskCommitted || editorPreview.activeInpaintRegenerationAvailable)
        const canApply = editorPreview.hasActiveMask &&
                editorPreview.activeMaskToolRole === "retouch" &&
                !editorPreview.activeMaskCommitted
        return "mode:" + mode +
               "|state:" + state +
               "|canvasBlocking:false" +
               "|apply:" + String(canApply) +
               "|regenerate:" + String(canRegenerate) +
               "|modelReason:" + root.disabledCapabilityReason("model-inpaint")
    }

    function retouchPrimaryToolSignature() {
        const modes = ["remove", "heal", "patch", "clone", "dust", "red-eye", "skin-cleanup", "frequency-smoothing"]
        const parts = []
        for (let index = 0; index < modes.length; ++index) {
            const mode = modes[index]
            parts.push(mode + ":" + root.retouchModeVisibilityState(mode))
        }
        return parts.join("|")
    }

    function photoLayerBlendModes() {
        return ["normal", "multiply", "screen", "overlay", "soft-light", "hard-light", "color", "luminosity"]
    }

    function photoLayerBlendModesForLayer(layer) {
        if (layer === null || layer === undefined)
            return root.photoLayerBlendModes()
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "").trim().toLowerCase()
        if (kind === "adjustment" || kind === "fill" || kind === "pixel" ||
                kind === "group" ||
                kind === "text" || kind === "source")
            return root.photoLayerBlendModes()
        return ["normal"]
    }

    function photoLayerBlendModeSupported(layer, modeName) {
        const mode = String(modeName || "normal").trim().toLowerCase()
        return root.photoLayerBlendModesForLayer(layer).indexOf(mode) >= 0
    }

    function photoLayerBlendModeControlsEnabled(layer) {
        return root.photoLayerBlendModesForLayer(layer).length > 1
    }

    function photoLayerBlendModeSupportSignature(layer) {
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "unknown").trim().toLowerCase()
        const modes = root.photoLayerBlendModesForLayer(layer)
        return "photo-layer-blend-mode-support:v1" +
               "|kind:" + kind +
               "|enabled:" + String(modes.length > 1) +
               "|default:normal" +
               "|modes:" + modes.join(",")
    }

    function photoLayerBlendLabel(modeName) {
        const mode = String(modeName || "normal").trim().toLowerCase()
        if (mode === "soft-light")
            return "Soft Light"
        if (mode === "hard-light")
            return "Hard Light"
        return mode.length > 0 ? mode.charAt(0).toUpperCase() + mode.slice(1) : "Normal"
    }

    function photoLayerKindLabel(layer) {
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "layer").trim().toLowerCase()
        if (kind === "source")
            return "Source Image"
        if (kind === "adjustment")
            return "Layer"
        if (kind === "pixel")
            return Object.keys((layer && layer.shapeDefinition) || ({})).length > 0 ? "Shape Layer" : "Pixel Layer"
        if (kind === "fill")
            return "Fill Layer"
        if (kind === "text")
            return "Text Layer"
        if (kind === "group")
            return "Group"
        return "Layer"
    }

    function photoLayerVisibilityLabel(layer) {
        if (layer && layer.enabled === false)
            return "Hidden"
        return "Visible"
    }

    function photoLayerMaskLinkLabel(layer, layerIndex) {
        const linked = root.maskSetsForAdjustmentLayer(layerIndex)
        if (linked.length > 0)
            return linked.length + " mask" + (linked.length === 1 ? "" : "s")
        if (layer && layer.hasLayerMask === true)
            return "Layer mask"
        return "No mask"
    }

    function selectedLayerHeaderSignature(layer, layerIndex) {
        const opacity = Math.round(root.clamp(Number(layer && layer.opacity !== undefined ? layer.opacity : 1.0), 0.0, 1.0) * 100)
        return "selected-layer-header:v1" +
                "|index:" + layerIndex.toString() +
                "|kind:" + root.photoLayerKindLabel(layer) +
                "|visible:" + root.photoLayerVisibilityLabel(layer) +
                "|opacity:" + opacity.toString() +
                "|blend:" + root.photoLayerBlendLabel(layer && layer.blendMode !== undefined ? layer.blendMode : "normal") +
                "|mask:" + root.photoLayerMaskLinkLabel(layer, layerIndex) +
                "|changed:" + root.layerChangedAdjustmentGroupSignature(layer)
    }

    function photoLayerBlendLabels() {
        return root.photoLayerBlendLabelsForLayer(null)
    }

    function photoLayerBlendLabelsForLayer(layer) {
        const labels = []
        const modes = root.photoLayerBlendModesForLayer(layer)
        for (let index = 0; index < modes.length; ++index)
            labels.push(root.photoLayerBlendLabel(modes[index]))
        return labels
    }

    function photoLayerBlendModeAt(index) {
        return root.photoLayerBlendModeAtForLayer(null, index)
    }

    function photoLayerBlendModeAtForLayer(layer, index) {
        const modes = root.photoLayerBlendModesForLayer(layer)
        return modes[Math.max(0, Math.min(modes.length - 1, Number(index || 0)))]
    }

    function photoLayerBlendModeIndex(modeName) {
        return root.photoLayerBlendModeIndexForLayer(null, modeName)
    }

    function photoLayerBlendModeIndexForLayer(layer, modeName) {
        const modes = root.photoLayerBlendModesForLayer(layer)
        const index = modes.indexOf(String(modeName || "normal").trim().toLowerCase())
        return index < 0 ? 0 : index
    }

    function nextPhotoLayerBlendMode(modeName) {
        const modes = root.photoLayerBlendModes()
        const current = String(modeName || "normal").trim().toLowerCase()
        const index = modes.indexOf(current)
        return modes[(index + 1) % modes.length]
    }

    function cyclePhotoLayerBlendMode(layerIndex, modeName) {
        return editorPreview.setPhotoLayerBlendMode(layerIndex, root.nextPhotoLayerBlendMode(modeName))
    }

    function adjustPhotoLayerOpacity(layerIndex, opacity, delta) {
        const currentOpacity = opacity === undefined || opacity === null ? 1.0 : Number(opacity)
        const nextOpacity = Math.round(root.clamp(currentOpacity + delta, 0.0, 1.0) * 100) / 100
        return editorPreview.setPhotoLayerOpacity(layerIndex, nextOpacity)
    }

    function layerAddMenuItems() {
