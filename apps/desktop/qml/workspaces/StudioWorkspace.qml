            },
            { key: "paint", label: "Paint Layer", icon: "brush-tool", description: "Transparent pixels for painting and erasing.", tooltip: "Add a paint layer." },
            { key: "pen", label: "Pen path", icon: "edit", description: "Draw and edit smooth vector curves.", tooltip: "Create an editable vector path." },
            { key: "shapes", label: "Shape", icon: "geometry", description: "Draw a rectangle, ellipse, line, or arrow as an editable layer.", tooltip: "Draw a graphic shape on the photo." },
            {
                key: "fill",
                label: "Fill Layer",
                icon: "swatch",
                description: "Solid color layer for backgrounds, overlays, or graphic blocks.",
                tooltip: "Add a solid color fill layer."
            },
            {
                key: "text",
                label: "Text Layer",
                icon: "media",
                description: "Editable caption or title layer with typography controls.",
                tooltip: "Add a text layer."
            },
            {
                key: "paragraph",
                label: "Draw Text Box",
                icon: "media",
                description: "Draw a paragraph box on the photo and type directly on the canvas.",
                tooltip: "Create positioned paragraph text."
            },
            {
                key: "source",
                label: "Source / Image Layer",
                icon: "source",
                description: root.componentWorkspaceActive
