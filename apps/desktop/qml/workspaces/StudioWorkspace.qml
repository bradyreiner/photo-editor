    function filtersActive() {
        return catalogAssets.projectFilter !== "all" ||
               catalogAssets.importDateFilter !== "all" ||
               catalogAssets.captureYearFilter !== "all" ||
               catalogAssets.mediaTypeFilter !== "all" ||
               catalogAssets.reviewFilter !== "all" ||
               catalogAssets.availabilityFilter !== "all" ||
               catalogAssets.minimumRatingFilter > 0 ||
               catalogAssets.visualSearchActive ||
               catalogAssets.searchFilter.length > 0
    }

    function setLibrarySearchDraft(text) {
        root.librarySearchDraftText = String(text || "")
        root.searchText = root.librarySearchDraftText
        librarySearchDebounceTimer.restart()
    }

    function applyLibrarySearchNow() {
        librarySearchDebounceTimer.stop()
        if (!catalogAssets)
            return
        root.searchText = root.librarySearchDraftText
        if (String(catalogAssets.searchFilter || "") !== root.librarySearchDraftText)
            catalogAssets.searchFilter = root.librarySearchDraftText
    }

    function clearLibrarySearch() {
        librarySearchDebounceTimer.stop()
        root.librarySearchDraftText = ""
        root.searchText = ""
        if (catalogAssets)
            catalogAssets.searchFilter = ""
    }

    function clearLibraryFilters() {
        librarySearchDebounceTimer.stop()
        root.librarySearchDraftText = ""
        root.searchText = ""
        if (catalogAssets)
            catalogAssets.clearFilters()
    }

    function librarySearchBehaviorSignature() {
        return "library-search:v1" +
               "|draft:" + String(root.librarySearchHasText) +
               "|active:" + String(root.librarySearchActive) +
               "|pending:" + String(root.librarySearchPending) +
               "|clear-visible:" + String(root.librarySearchHasText) +
               "|debounce:180" +
               "|text:no-elide" +
               "|preserve:catalogAssets.searchFilter"
    }

    Timer {
        id: librarySearchDebounceTimer
        interval: 180
        repeat: false
        onTriggered: root.applyLibrarySearchNow()
    }

    Connections {
        target: catalogAssets
        function onSelectedIndexChanged() { root.rememberLibraryCullPosition() }
        function onFiltersChanged() {
            if (!librarySearchDebounceTimer.running &&
                    root.librarySearchDraftText !== String(catalogAssets.searchFilter || "")) {
                root.librarySearchDraftText = String(catalogAssets.searchFilter || "")
                root.searchText = root.librarySearchDraftText
            }
        }
    }

    function libraryWorkflowPolishSignature() {
        if (!catalogAssets)
            return "library-workflow-polish:v1|catalog:unavailable|preserve:search-filter-select-review-edit-import-compare-export"
        const selectedCount = Number(catalogAssets.selectedAssetCount || 0)
        const singleSelection = selectedCount === 1 || (!catalogAssets.hasMultiSelection && catalogAssets.selectedIndex >= 0)
        return "library-workflow-polish:v1" +
               "|search:" + (String(catalogAssets.searchFilter || "").length > 0 ? "active" : "idle") +
               "|filters:" + (root.filtersActive() ? "active" : "clear") +
               "|selection-mode:" + String(root.selectionMode) +
               "|selected:" + selectedCount.toString() +
               "|view:" + root.catalogViewMode +
               "|sources:false" +
               "|inspector:" + String(root.libraryInspectorPanelVisible) +
               "|inspector-state:" + (selectedCount > 1 ? "batch" : (singleSelection ? "single" : "empty")) +
               "|import:" + String(root.importModeOpen) +
               "|activity:" + String(Boolean(catalogAssets.loading || catalogAssets.importing)) +
               "|preserve:search-filter-select-rate-pick-reject-edit-import-compare-export"
    }

    function mediaFilterActive() {
        return catalogAssets.mediaTypeFilter !== "all"
    }

    function projectFilterActive() {
        return catalogAssets.projectFilter !== "all"
    }

    function timeFilterActive() {
        return catalogAssets.importDateFilter !== "all" || catalogAssets.captureYearFilter !== "all"
    }

    function reviewFilterActive() {
        return catalogAssets.reviewFilter !== "all" || catalogAssets.minimumRatingFilter > 0
    }

    function cycleMediaFilter() {
        const values = ["all", "photos", "videos"]
        const next = (values.indexOf(catalogAssets.mediaTypeFilter) + 1) % values.length
        catalogAssets.mediaTypeFilter = values[next]
    }

    function cycleProjectFilter() {
        const values = ["all", "unassigned"].concat(catalogAssets.projectNames)
        const next = (values.indexOf(catalogAssets.projectFilter) + 1) % values.length
        catalogAssets.projectFilter = values[next]
    }

    function cycleTimeFilter() {
        const values = ["all", "today", "7d", "30d", "year"]
        const next = (values.indexOf(catalogAssets.importDateFilter) + 1) % values.length
        catalogAssets.importDateFilter = values[next]
    }

    function cycleReviewFilter() {
        const values = ["all", "picked", "rejected", "rated", "unrated", "unmarked"]
        const next = (values.indexOf(catalogAssets.reviewFilter) + 1) % values.length
        catalogAssets.minimumRatingFilter = 0
        catalogAssets.reviewFilter = values[next]
    }

    function mediaFilterMenuItems() {
        return [
            { key: "all", label: "All Media", icon: "media", checked: catalogAssets.mediaTypeFilter === "all" },
            { key: "photos", label: "Photos", icon: "media", checked: catalogAssets.mediaTypeFilter === "photos" },
            { key: "videos", label: "Videos", icon: "video", checked: catalogAssets.mediaTypeFilter === "videos" }
        ]
    }

    function handleMediaFilterMenu(key) {
        const value = String(key || "all")
        catalogAssets.mediaTypeFilter = ["all", "photos", "videos"].indexOf(value) >= 0 ? value : "all"
    }

    function projectFilterMenuItems() {
        const items = [
            { key: "all", label: "All Projects", icon: "folder", checked: catalogAssets.projectFilter === "all" },
            { key: "unassigned", label: "Unassigned", icon: "folder", checked: catalogAssets.projectFilter === "unassigned" }
        ]
        const names = catalogAssets.projectNames || []
        for (let index = 0; index < names.length; ++index) {
            const name = String(names[index] || "")
            if (name.length > 0)
                items.push({
                    key: "project:" + name,
                    label: name,
                    icon: "folder",
                    checked: catalogAssets.projectFilter === name
                })
        }
        return items
    }

    function handleProjectFilterMenu(key) {
        const value = String(key || "all")
        if (value.indexOf("project:") === 0) {
            catalogAssets.projectFilter = value.slice(8)
            return
        }
        catalogAssets.projectFilter = value === "unassigned" ? "unassigned" : "all"
    }

    function timeFilterMenuItems() {
        return [
            { key: "all", label: "All Time", icon: "clock", checked: catalogAssets.importDateFilter === "all" && catalogAssets.captureYearFilter === "all" },
            { key: "today", label: "Today", icon: "clock", checked: catalogAssets.importDateFilter === "today" },
            { key: "7d", label: "Last 7 Days", icon: "clock", checked: catalogAssets.importDateFilter === "7d" },
            { key: "30d", label: "Last 30 Days", icon: "clock", checked: catalogAssets.importDateFilter === "30d" },
            { key: "year", label: "This Year", icon: "clock", checked: catalogAssets.importDateFilter === "year" }
        ]
    }

    function handleTimeFilterMenu(key) {
        const value = String(key || "all")
        catalogAssets.captureYearFilter = "all"
        catalogAssets.importDateFilter = ["today", "7d", "30d", "year"].indexOf(value) >= 0 ? value : "all"
    }

    function reviewFilterMenuItems() {
        return [
            { key: "all", label: "All Reviews", icon: "star", checked: catalogAssets.reviewFilter === "all" && catalogAssets.minimumRatingFilter === 0 },
            { key: "picked", label: "Picked", icon: "select", checked: catalogAssets.reviewFilter === "picked" },
            { key: "rejected", label: "Rejected", icon: "delete", checked: catalogAssets.reviewFilter === "rejected" },
            { key: "rated", label: "Rated", icon: "star", checked: catalogAssets.reviewFilter === "rated" && catalogAssets.minimumRatingFilter === 0 },
            { key: "unrated", label: "Unrated", icon: "star", checked: catalogAssets.reviewFilter === "unrated" },
            { key: "unmarked", label: "Unmarked", icon: "select", checked: catalogAssets.reviewFilter === "unmarked" },
            { key: "rating:5", label: "5+ Stars", icon: "star", checked: catalogAssets.minimumRatingFilter === 5 },
            { key: "rating:4", label: "4+ Stars", icon: "star", checked: catalogAssets.minimumRatingFilter === 4 },
            { key: "rating:3", label: "3+ Stars", icon: "star", checked: catalogAssets.minimumRatingFilter === 3 }
        ]
    }

    function handleReviewFilterMenu(key) {
        const value = String(key || "all")
        if (value.indexOf("rating:") === 0) {
            catalogAssets.reviewFilter = "all"
            catalogAssets.minimumRatingFilter = Math.max(0, Math.min(5, Number(value.slice(7))))
            return
        }
        catalogAssets.minimumRatingFilter = 0
        catalogAssets.reviewFilter = ["picked", "rejected", "rated", "unrated", "unmarked"].indexOf(value) >= 0 ? value : "all"
    }

    function compactLibraryFilterMenuItems() {
        function prefixedItems(prefix, title, sourceItems) {
            const rows = [{
                key: prefix + "__header",
                label: title,
                icon: "menu",
                enabled: false
            }]
            for (let index = 0; index < sourceItems.length; ++index) {
                const item = sourceItems[index]
                rows.push({
                    key: prefix + String(item.key || "all"),
                    label: item.label,
                    icon: item.icon,
                    checked: item.checked
                })
            }
            return rows
        }

        return []
            .concat(prefixedItems("media:", "Media", root.mediaFilterMenuItems()))
            .concat(prefixedItems("project-filter:", "Projects", root.projectFilterMenuItems()))
            .concat(prefixedItems("time:", "Time", root.timeFilterMenuItems()))
            .concat(prefixedItems("review:", "Review", root.reviewFilterMenuItems()))
    }

    function handleCompactLibraryFilterMenu(key) {
        const value = String(key || "")
        if (value.indexOf("__header") >= 0)
            return
        if (value.indexOf("media:") === 0) {
            root.handleMediaFilterMenu(value.slice(6))
            return
        }
        if (value.indexOf("project-filter:") === 0) {
            root.handleProjectFilterMenu(value.slice(15))
            return
        }
        if (value.indexOf("time:") === 0) {
            root.handleTimeFilterMenu(value.slice(5))
            return
        }
        if (value.indexOf("review:") === 0)
            root.handleReviewFilterMenu(value.slice(7))
    }

    function aspectRatioText(width, height) {
        let w = Math.round(Number(width || 0))
        let h = Math.round(Number(height || 0))
        if (w <= 0 || h <= 0)
            return ""
        while (h !== 0) {
            const next = w % h
            w = h
            h = next
        }
        const divisor = Math.max(1, w)
        return Math.round(width / divisor) + ":" + Math.round(height / divisor)
    }

    function displayImageSource(offset) {
        const base = catalogAssets.selectedIndex >= 0 ? catalogAssets.selectedIndex : 0
        if (offset < 0) {
            if (editorPreview.displayReferencePreviewSource.length > 0)
                return editorPreview.displayReferencePreviewSource
            if (editorPreview.referencePreviewSource.length > 0)
                return editorPreview.referencePreviewSource
            return assetThumb(base)
        }
        if (offset === 0 && editorPreview.displayPreviewSource.length > 0)
            return editorPreview.displayPreviewSource
        return assetThumb(clamp(base + offset, 0, Math.max(0, assetCount() - 1)))
    }

    function resolvedCompareSource() {
        const mode = editorPreview.compareSourceMode
        if ((mode === "snapshot" || mode === "auto") && root.compareSnapshotIndex() >= 0)
            return "snapshot"
        if ((mode === "external" || mode === "auto") && editorPreview.hasReferenceImage)
            return "external"
        return "original"
    }

    function comparePanelTitle(index) {
        if (editorPreview.renderingUpgradePreviewActive)
            return index === 0
                   ? "Current · " + root.renderingModelLabel(editorPreview.currentPhotographicRenderingModel)
                   : "Updated · " + root.renderingModelLabel(editorPreview.renderingUpgradeTargetModel)
        if (index === 1)
            return "After · Current edit"
        if (root.resolvedCompareSource() === "snapshot")
            return "Before · Snapshot: " + (editorPreview.compareSnapshotName.length > 0
                                             ? editorPreview.compareSnapshotName
                                             : "Unavailable")
        if (root.resolvedCompareSource() === "external")
            return "Reference · " + editorPreview.referenceImageName
        if (editorPreview.compareAdjustmentGroups.length > 0) {
            const labels = { tone: "Tone", color: "Color", detail: "Detail", masks: "Selections" }
            return "Before · " + editorPreview.compareAdjustmentGroups.map(function(group) {
                return labels[group] || group
            }).join(", ") + " bypassed"
        }
        return "Before · Original"
    }

    function compareSnapshotIndex() {
        for (let index = 0; index < editorPreview.editHistorySnapshots.length; ++index) {
            if (String(editorPreview.editHistorySnapshots[index].id || "") === editorPreview.compareSnapshotId)
                return index
        }
        return -1
    }

    function selectCompareSnapshot(index) {
        if (index < 0 || index >= editorPreview.editHistorySnapshots.length)
            return false
        editorPreview.compareSnapshotId = String(editorPreview.editHistorySnapshots[index].id || "")
        editorPreview.compareSourceMode = "snapshot"
        return editorPreview.compareSnapshotId.length > 0
    }

    function setOriginalHold(active) {
        const next = active === true
        if (root.originalHoldActive === next || !editorPreview.hasAsset)
            return false
        if (next) {
            root.originalHoldPreviousSourceMode = String(editorPreview.compareSourceMode || "auto")
            root.originalHoldOwnedCompareMode = !editorPreview.compareMode
            editorPreview.compareSourceMode = "original"
            editorPreview.compareMode = true
            root.originalHoldActive = true
            return true
        }
        root.originalHoldActive = false
        if (root.originalHoldOwnedCompareMode)
            editorPreview.compareMode = false
        editorPreview.compareSourceMode = root.originalHoldPreviousSourceMode
        root.originalHoldOwnedCompareMode = false
        return true
    }

    function sectionComparisonActive(scope) {
        const index = root.activeAdjustmentLayerIndex()
        const layerId = index >= 0 ? String(editorPreview.photoLayers[index].id || "") : ""
        return editorPreview.sectionComparisonScope === scope && editorPreview.sectionComparisonLayerId === layerId
    }

    function toggleSectionComparison(scope) {
        if (sectionComparisonActive(scope))
            editorPreview.clearSectionComparison()
        else
            editorPreview.setSectionComparison(scope, root.activeAdjustmentLayerIndex())
    }

    function holdSectionComparison(scope, held) {
        if (held)
            editorPreview.beginSectionComparisonHold(scope, root.activeAdjustmentLayerIndex())
        else
            editorPreview.endSectionComparisonHold()
    }

    function holdCompareEditGroup(groupKey, held) {
        const normalizedGroup = String(groupKey || "").trim()
        if (held) {
            if (root.compareEditGroupHoldActive || normalizedGroup.length === 0)
                return false
            root.compareEditGroupHoldPreviousGroups = editorPreview.compareAdjustmentGroups.slice(0)
            root.compareEditGroupHoldActive = true
            editorPreview.compareAdjustmentGroups = [normalizedGroup]
            return true
        }
        if (!root.compareEditGroupHoldActive)
            return false
        const previousGroups = root.compareEditGroupHoldPreviousGroups.slice(0)
        root.compareEditGroupHoldPreviousGroups = []
        root.compareEditGroupHoldActive = false
        editorPreview.compareAdjustmentGroups = previousGroups
        return true
    }

    onSelectedEditTargetChanged: {
        root.holdCompareEditGroup("", false)
        editorPreview.clearSectionComparison()
    }
    onActivePhotoLayerIndexChanged: {
        root.holdCompareEditGroup("", false)
        editorPreview.clearSectionComparison()
    }

    function compareEditGroupActive(groupKey) {
        return editorPreview.compareAdjustmentGroups.indexOf(groupKey) >= 0
    }

    function toggleCompareEditGroup(groupKey) {
        const groups = editorPreview.compareAdjustmentGroups.slice(0)
        const existingIndex = groups.indexOf(groupKey)
        if (existingIndex >= 0) {
            groups.splice(existingIndex, 1)
        } else {
            groups.push(groupKey)
        }
        editorPreview.compareAdjustmentGroups = groups
    }

    function selectedName() {
        if (root.page === "edit" && root.openPhotoFilePath.length > 0)
            return root.openPhotoFilePath.split("/").pop()
        if (catalogAssets.selectedFilePath.length > 0) {
            const parts = catalogAssets.selectedFilePath.split("/")
            return parts.length > 0 ? parts[parts.length - 1] : catalogAssets.selectedFilePath
        }
        return assetName(catalogAssets.selectedIndex >= 0 ? catalogAssets.selectedIndex : 0)
    }

    function selectedToneWheelName() {
        if (selectedToneWheel === 0)
            return "Shadows"
        if (selectedToneWheel === 2)
            return "Highlights"
        return "Midtones"
    }

    function rainbowTrack() {
        return ["#d45a62", "#dd8a39", "#d7bd42", "#61b56f", "#49b8c4", "#4e86d9", "#8b6be3", "#c85ac1", "#d45a62"]
    }

    function gradingPreviewColor(hueValue, saturationValue, luminanceValue) {
        const hue = ((hueValue % 1.0) + 1.0) % 1.0
        const saturation = Math.max(0.18, Math.min(1.0, Math.abs(saturationValue) / 100.0))
        const lightness = Math.max(0.38, Math.min(0.76, 0.56 + luminanceValue / 280.0))
        return Qt.hsla(hue, saturation, lightness, 1.0)
    }

    function selectedToneWheelHue() {
        if (selectedToneWheel === 0)
            return root.primaryNestedAdjustmentValue("colorGrading", "shadows", "hue", editorPreview.gradingShadowsHue)
        if (selectedToneWheel === 2)
            return root.primaryNestedAdjustmentValue("colorGrading", "highlights", "hue", editorPreview.gradingHighlightsHue)
        return root.primaryNestedAdjustmentValue("colorGrading", "midtones", "hue", editorPreview.gradingMidtonesHue)
    }

    function selectedToneWheelSaturation() {
        if (selectedToneWheel === 0)
            return root.primaryNestedAdjustmentValue("colorGrading", "shadows", "saturation", editorPreview.gradingShadowsSaturation)
        if (selectedToneWheel === 2)
            return root.primaryNestedAdjustmentValue("colorGrading", "highlights", "saturation", editorPreview.gradingHighlightsSaturation)
        return root.primaryNestedAdjustmentValue("colorGrading", "midtones", "saturation", editorPreview.gradingMidtonesSaturation)
    }

    function selectedToneWheelLuminance() {
        if (selectedToneWheel === 0)
            return root.primaryNestedAdjustmentValue("colorGrading", "shadows", "luminance", editorPreview.gradingShadowsLuminance)
        if (selectedToneWheel === 2)
            return root.primaryNestedAdjustmentValue("colorGrading", "highlights", "luminance", editorPreview.gradingHighlightsLuminance)
        return root.primaryNestedAdjustmentValue("colorGrading", "midtones", "luminance", editorPreview.gradingMidtonesLuminance)
    }

    function setSelectedToneWheelHue(value) {
        if (selectedToneWheel === 0)
            root.setPrimaryAdjustmentValue("gradingShadowsHue", value)
        else if (selectedToneWheel === 2)
            root.setPrimaryAdjustmentValue("gradingHighlightsHue", value)
        else
            root.setPrimaryAdjustmentValue("gradingMidtonesHue", value)
    }

    function setSelectedToneWheelSaturation(value) {
        if (selectedToneWheel === 0)
            root.setPrimaryAdjustmentValue("gradingShadowsSaturation", value)
        else if (selectedToneWheel === 2)
            root.setPrimaryAdjustmentValue("gradingHighlightsSaturation", value)
        else
            root.setPrimaryAdjustmentValue("gradingMidtonesSaturation", value)
    }

    function setSelectedToneWheelLuminance(value) {
        if (selectedToneWheel === 0)
            root.setPrimaryAdjustmentValue("gradingShadowsLuminance", value)
        else if (selectedToneWheel === 2)
            root.setPrimaryAdjustmentValue("gradingHighlightsLuminance", value)
        else
            root.setPrimaryAdjustmentValue("gradingMidtonesLuminance", value)
    }

    function activeVisibilityContract() {
        if (root.page === "library")
            return root.importModeOpen ? root.importStudioVisibilityContract : root.libraryStudioVisibilityContract
        if (root.page === "edit" && root.maskToolKeepsActiveMask(root.editTool))
            return root.maskStudioVisibilityContract
        if (root.page === "edit")
            return root.editStudioVisibilityContract
        return root.exportStudioVisibilityContract
    }

    function selectAsset(index, modifiers) {
        if (!catalogAssets || index < 0 || index >= catalogAssets.assetCount)
            return
        catalogAssets.selectIndexWithModifiers(index, Number(modifiers || 0), selectionMode)
    }

    function canSelectAll() {
        return page === "library" && assetCount() > 0
    }

    function selectAll() {
        if (!canSelectAll())
            return
        selectionMode = true
        catalogAssets.selectAll()
    }

    function canDeselect() {
        return page === "library" && (selectionMode || catalogAssets.selectedAssetCount > 0)
    }

    function deselectAll() {
        if (!canDeselect())
            return
        catalogAssets.clearSelection()
        selectionMode = false
    }

    function queueExport(index) {
        if (!exportJobs || !catalogAssets || assetCount() === 0)
            return
        const asset = assetAt(index)
        const sourcePath = String(asset.filePath || catalogAssets.selectedFilePath || "")
        if (sourcePath.length === 0)
            return
        exportJobs.queueExport(
                    String(asset.assetId || sourcePath),
                    String(asset.mediaType || "photo"),
                    assetName(index),
                    sourcePath,
                    editorPreview.assetId === String(asset.assetId || "") ? editorPreview.previewSource : "",
                    String(asset.adjustmentPatchJson || catalogAssets.selectedAdjustmentPatchJson || ""),
                    exportPresets[selectedPresetIndex].name,
                    exportDestination)
    }

    function startVaultImport() {
        root.importModeOpen = true
        catalogAssets.refreshImportSources()
    }

    function maskToolKeepsActiveMask(toolName) {
        if (toolName === "masks" || toolName === "brush" || toolName === "retouch" ||
                toolName === "paint" || toolName === "eraser")
            return true
        return (toolName === "adjust" || toolName === "layers") &&
                root.selectedEditTargetMaskSetId().length > 0
    }

    function clearTransientToolStateFor(toolName) {
        if (editorPreview.brushStrokeActive)
            editorPreview.endActiveBrushStroke()
        if (toolName !== "retouch") {
            retouchToolStartTimer.stop()
            root.pendingRetouchStartMode = ""
        }
        if (toolName !== "layers") {
            layerToolActivationTimer.stop()
            root.pendingLayerActivationIndex = -1
        }
        if (!root.maskToolKeepsActiveMask(toolName)) {
            maskOutlineActivationTimer.stop()
            root.maskOutlineActivationDeferred = false
        }
        root.clearTransientMaskTools()
        if (!root.maskToolKeepsActiveMask(toolName))
            editorPreview.deselectActiveMask()
        if (toolName !== "crop")
            editorPreview.cropEditing = false
        if (toolName !== "compare")
            editorPreview.compareMode = false
    }

    function transientToolStateSignature() {
        return "tool:" + root.editTool +
               "|activeMask:" + String(editorPreview.hasActiveMask) +
               "|stroke:" + String(editorPreview.brushStrokeActive) +
               "|crop:" + String(editorPreview.cropEditing) +
               "|compare:" + String(editorPreview.compareMode)
    }

    function toolSwitchCleanupSignature() {
        return "tool-switch-cleanup:v1|serial:" + root.toolSwitchSerial +
               "|diagnostics:" + String(root.diagnosticsPanelOpen) +
               "|maskRail:" + String(root.maskToolRailExpanded) +
               "|menus:closed-by-tool-rail-switch-serial|committed-edits:preserved" +
               "|target-preservation:appropriate|selected-target:" + root.selectedEditTargetContract +
               "|mask-tools-keep-active-selection:" + String(root.maskToolKeepsActiveMask(root.editTool)) +
               "|non-mask-tools-clear-transient-mask-only:true|inspector-transient:reset" +
               "|inspector-tab:" + root.editInspectorTab +
               "|layer-activation:queued"
    }

    function rememberEditToolVariant(toolName, variant) {
        const tool = String(toolName || "")
        const value = String(variant || "")
        if (tool.length === 0 || value.length === 0)
            return
        const next = Object.assign({}, root.lastUsedEditToolVariants)
        next[tool] = value
        root.lastUsedEditToolVariants = next
    }

    function editToolLastUsedVariant(toolName, fallback) {
        const tool = String(toolName || "")
        const value = String(root.lastUsedEditToolVariants[tool] || "")
        return value.length > 0 ? value : String(fallback || "")
    }

    function beginEditToolSwitch(nextToolName) {
        const nextTool = String(nextToolName || "")
        const previousTool = String(root.editTool || "")
        root.toolSwitchSerial += 1
        root.beginToolSwitchLatencyProbe(previousTool, nextTool)
        root.diagnosticsPanelOpen = false
        if (nextTool !== "masks" && nextTool !== "brush" && nextTool !== "retouch")
            root.maskToolRailExpanded = false
    }

    function activateEditTool(toolName) {
        const nextTool = String(toolName || "").trim()
        if (nextTool.length === 0)
            return
        if (nextTool === "scopes") {
            root.toggleScopesDock(root.scopeDockPosition === "right" ? "bottom" : root.scopeDockPosition)
            return
        }
        if (root.page === "edit" && root.workspaceActive) {
            root.pendingEditToolTransitionName = nextTool
            root.editToolTransitionTitle = "Switching to " + root.editToolDisplayName(nextTool)
            root.editToolTransitionDetail = root.editToolTransitionDescription(nextTool)
            root.editToolTransitionActive = true
            root.applyEditToolActivation(nextTool)
            return
        }
        root.applyEditToolActivation(nextTool)
    }

    function applyEditToolActivation(toolName) {
        if (toolName === "scopes") {
            root.toggleScopesDock(root.scopeDockPosition === "right" ? "bottom" : root.scopeDockPosition)
            return
        }
        root.beginEditToolSwitch(toolName)
        root.clearTransientToolStateFor(toolName)
        if (toolName === "presets" || toolName === "info") {
            root.activateEditInspectorTab(toolName)
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "layers-focus") {
            root.toggleLayersOnlyFocusMode()
            root.finishEditToolTransitionSoon()
            return
        }
        root.editTool = toolName
        if (["paint", "eraser", "shapes", "text", "brush", "masks", "pixel-brush", "pixel-select"].indexOf(toolName) >= 0)
            root.editCreativeToolsVisible = true
        if (toolName === "adjust") {
            root.selectedEditLayer = "adjustments"
            root.editInspectorTab = "adjust"
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            root.rememberEditToolVariant("adjust", root.editInspectorTab)
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "crop") {
            root.cropToolMode = root.editToolLastUsedVariant("crop", "crop")
            root.editInspectorTab = "crop"
            editorPreview.compareMode = false
            editorPreview.cropEditing = root.cropToolMode === "crop"
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "masks") {
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            root.editInspectorTab = "adjust"
            root.maskToolRailExpanded = !root.smallDisplayMode || !editorPreview.hasActiveMask
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "paint" || toolName === "eraser") {
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            root.editInspectorTab = "layers"
            const layer = root.currentPhotoLayerData()
            if (toolName === "eraser" && root.selectedEditTargetScope() === "base-image") {
                root.finishEditToolTransitionSoon()
                return
            }
            if (String(layer.kind || "") === "pixel" &&
                    (toolName === "eraser" || Object.keys(layer.shapeDefinition || ({})).length === 0))
                root.setActivePhotoLayerSelection(root.normalizedActivePhotoLayerIndex(), false)
            else if (toolName === "paint" && editorPreview.addPaintLayer())
                root.setActivePhotoLayerSelection(0, false)
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "shapes") {
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            root.editInspectorTab = "layers"
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "brush") {
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            editorPreview.startSelectionBrush(root.editToolLastUsedVariant("brush", "add") === "erase")
            root.editInspectorTab = "adjust"
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "retouch") {
            root.startRetouchTool(root.editToolLastUsedVariant("retouch", "remove"), true)
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "compare") {
            editorPreview.compareMode = true
            editorPreview.cropEditing = false
            root.compareViewMode = root.editToolLastUsedVariant("compare", root.compareViewMode)
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "text") {
            root.editInspectorTab = "layers"
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "layers") {
            editorPreview.compareMode = false
            editorPreview.cropEditing = false
            root.editInspectorTab = "layers"
            if (editorPreview.photoLayerCount > 0)
                root.queueLayerToolActivation(root.normalizedActivePhotoLayerIndex())
            root.finishEditToolTransitionSoon()
            return
        }
        if (toolName === "export") {
            root.assetActivated("export")
            root.finishEditToolTransitionSoon()
        }
    }

    function editToolDisplayName(toolName) {
        const tool = String(toolName || "").toLowerCase()
        if (tool === "paint") return "Paint"
        if (tool === "eraser") return "Eraser"
        if (tool === "shapes") return "Shapes"
        if (tool === "text")
            return "Text"
        if (tool === "crop")
            return "Crop"
        if (tool === "masks")
            return "Masks"
        if (tool === "brush")
            return "Brush"
        if (tool === "pixel-brush")
            return "Pixel Brush"
        if (tool === "retouch")
            return "Retouch"
        if (tool === "compare")
            return "Compare"
        if (tool === "layers")
            return "Layers"
        if (tool === "presets")
            return "Presets"
        if (tool === "scopes")
            return "Scopes"
        return "Adjust"
    }

    function editToolTransitionDescription(toolName) {
        const tool = String(toolName || "").toLowerCase()
        if (tool === "masks" || tool === "brush" || tool === "retouch")
            return "Preparing selection controls and canvas overlays."
        if (tool === "shapes")
            return "Preparing shape controls and canvas drawing."
        if (tool === "crop")
            return "Preparing crop handles and transform controls."
        if (tool === "compare")
            return "Preparing before and after preview."
        if (tool === "layers")
            return "Preparing layer controls."
        return "Preparing edit controls."
    }

    function finishEditToolTransitionSoon() {
        if (root.editToolTransitionActive)
            editToolTransitionFinishTimer.restart()
    }

    function completeEditToolTransition() {
        root.finishToolSwitchLatencyProbe()
        root.editToolTransitionActive = false
        root.pendingEditToolTransitionName = ""
        root.editToolTransitionTitle = ""
        root.editToolTransitionDetail = ""
    }

    function qmlPerformanceMonitorAvailable() {
        return typeof qmlPerformance !== "undefined" &&
               qmlPerformance !== null &&
               qmlPerformance.nowMs !== undefined &&
               qmlPerformance.routeStarted !== undefined &&
               qmlPerformance.routeReady !== undefined
    }

    function beginToolSwitchLatencyProbe(previousTool, nextTool) {
        if (!root.qmlPerformanceMonitorAvailable()) {
            root.editToolSwitchStartedAtMs = 0
            root.editToolSwitchWorkflowId = ""
            return
        }
        const fromTool = String(previousTool || "unknown")
        const toTool = String(nextTool || "unknown")
        root.editToolSwitchStartedAtMs = qmlPerformance.nowMs()
        root.editToolSwitchWorkflowId = "studio-tool-switch:" + fromTool + "->" + toTool
        qmlPerformance.routeStarted(
                    "studio-tool-switch",
                    root.toolSwitchSerial,
                    root.editToolSwitchWorkflowId)
    }

    function finishToolSwitchLatencyProbe() {
        if (!root.qmlPerformanceMonitorAvailable() ||
                root.editToolSwitchStartedAtMs <= 0 ||
                root.editToolSwitchWorkflowId.length === 0)
            return
        qmlPerformance.routeReady(
                    "studio-tool-switch",
                    root.toolSwitchSerial,
                    root.editToolSwitchStartedAtMs,
                    root.editToolSwitchStartedAtMs,
                    false,
                    root.editToolSwitchWorkflowId)
        root.editToolSwitchStartedAtMs = 0
        root.editToolSwitchWorkflowId = ""
    }

    function editToolDisabledReason(toolName) {
        const tool = String(toolName || "")
        if (tool === "export")
            return root.assetCount() > 0 ? "" : "Import or select assets before exporting."
        return editorPreview.hasAsset ? "" : "Select a photo before using this edit tool."
    }

    function editToolVariant(toolName) {
        const tool = String(toolName || "")
        if (tool === "paint") return "pixels"
        if (tool === "eraser") return "erase pixels"
        if (tool === "shapes") return "draw"
        if (tool === "text")
            return "paragraph"
        if (tool === "adjust")
            return root.editInspectorTab
        if (tool === "crop")
            return root.cropToolMode
        if (tool === "masks")
            return editorPreview.hasActiveMask ? String(editorPreview.activeMaskKind || "selection") : "new-selection"
        if (tool === "brush" || tool === "pixel-brush")
            return root.maskCreationOperation === "subtract" ? "erase" : "add"
        if (tool === "retouch")
            return String(editorPreview.activeMaskRetouchMode || "remove")
        if (tool === "layers")
            return root.selectedEditTargetScope()
        if (tool === "presets" || tool === "scopes" || tool === "info")
            return tool
        if (tool === "layers-focus")
            return "focused"
        if (tool === "compare")
            return root.compareViewMode
        if (tool === "export")
            return "queue"
        return ""
    }

    function editToolInspectorSection(toolName) {
        const tool = String(toolName || "")
        if (tool === "adjust")
            return root.editInspectorTab
        if (tool === "crop")
            return "crop"
        if (tool === "masks" || tool === "brush" || tool === "pixel-brush" || tool === "retouch")
            return "adjust"
        if (tool === "layers" || tool === "text" || tool === "paint" || tool === "eraser" || tool === "shapes")
            return "layers"
        if (tool === "presets" || tool === "scopes" || tool === "info")
            return tool
        if (tool === "layers-focus")
            return "layers"
        if (tool === "compare")
            return "compare"
        if (tool === "export")
            return "export"
        return ""
    }

    function editToolPendingState(toolName) {
        const tool = String(toolName || "")
        const disabledReason = root.editToolDisabledReason(tool)
        if (disabledReason.length > 0)
            return "disabled"
        if (!root.editRailToolActive(tool))
            return "inactive"
        if (tool === "brush")
            return editorPreview.brushStrokeActive ? "active" : "armed"
        if (tool === "pixel-brush")
            return root.pixelBrushToolReady() ? "armed" : "inactive"
        if (tool === "masks") {
            if (root.objectPickArmed && editorPreview.smartSelectPreviewActive)
                return "pending"
            if (root.objectPickArmed || root.activeLassoShortcutReady() || root.activePolygonShortcutReady())
                return "active"
            return "armed"
        }
        if (tool === "crop")
            return editorPreview.cropEditing ? "active" : "armed"
        if (tool === "retouch")
            return editorPreview.activeMaskToolRole === "retouch" ? "armed" : "inactive"
        if (tool === "compare" || tool === "layers" || tool === "adjust" || tool === "paint" || tool === "eraser" || tool === "shapes")
            return "armed"
        return "inactive"
    }

    function editToolStatusText(toolName) {
        const tool = String(toolName || "")
        const disabledReason = root.editToolDisabledReason(tool)
        if (disabledReason.length > 0)
            return disabledReason
        if (tool === "text")
            return "Draw a paragraph text box"
        if (tool === "shapes")
            return "Drag on the image to draw a shape"
        if (tool === "brush")
            return root.maskOperationLabel(editorPreview.activeMaskOperation) + " brush"
        if (tool === "pixel-brush")
            return root.maskOperationLabel(root.maskCreationOperation) + " pixel brush"
        if (tool === "masks")
            return editorPreview.hasActiveMask ? "Editing " + String(editorPreview.activeMaskName || "selection") : "Create a selection"
        if (tool === "crop")
            return root.cropToolMode === "horizon" ? "Draw horizon" : "Adjust crop"
        if (tool === "layers")
            return root.activeEditTargetSummaryText()
        if (tool === "presets")
            return "Preset library"
        if (tool === "scopes")
            return root.scopeDockPosition.charAt(0).toUpperCase() + root.scopeDockPosition.slice(1) + " dock"
        if (tool === "info")
            return "Asset info"
        if (tool === "layers-focus")
            return "Focused layer stack"
        if (tool === "compare")
            return root.compareViewMode
        if (tool === "export")
            return "Send to Export"
        return root.editToolVariant(tool)
    }

    function editToolLifecycle(toolName) {
        const tool = String(toolName || "")
        const disabledReason = root.editToolDisabledReason(tool)
        const lifecycle = {
            entry: tool === "layers" || tool === "info"
                   ? "inspector-tab-shortcut"
                   : "rail-click-page-shortcut",
            activeState: root.editToolPendingState(tool),
            primaryAction: "",
            feedback: "",
            commit: "",
            cancel: "",
            disabledState: disabledReason.length > 0 ? disabledReason : "available",
            errorState: ""
        }
        if (tool === "adjust" || tool === "presets" || tool === "scopes" || tool === "info") {
            lifecycle.primaryAction = "edit-inspector-values"
            lifecycle.feedback = "preview-and-changed-values"
            lifecycle.commit = "auto-commit-value-change"
            lifecycle.cancel = "reset-control-or-undo"
            lifecycle.errorState = "show-control-error-inline"
        } else if (tool === "paint" || tool === "eraser") {
            lifecycle.primaryAction = "paint-or-erase-layer-pixels"
            lifecycle.feedback = "live-layer-preview-and-brush-cursor"
            lifecycle.commit = "stroke-release-commits"
            lifecycle.cancel = "escape-discards-stroke"
            lifecycle.errorState = "show-layer-target-reason"
        } else if (tool === "shapes") {
            lifecycle.primaryAction = "draw-editable-shape-layer"
            lifecycle.feedback = "shape-preview-and-layer-bounds"
            lifecycle.commit = "release-creates-one-editable-layer"
            lifecycle.cancel = "escape-cancels-current-drag"
            lifecycle.errorState = "keep-tool-and-report-invalid-shape"
        } else if (tool === "text") {
            lifecycle.primaryAction = "draw-paragraph-box"
            lifecycle.feedback = "box-outline-and-canvas-editor"
            lifecycle.commit = "release-creates-box-done-saves-text"
            lifecycle.cancel = "escape-discards-draft"
            lifecycle.errorState = "retain-tool-on-invalid-box"
        } else if (tool === "crop") {
            lifecycle.primaryAction = "adjust-crop-transform-or-horizon"
            lifecycle.feedback = "canvas-handles-grid-hud"
            lifecycle.commit = "done-or-switch-tool-keeps-crop"
            lifecycle.cancel = "cancel-exits-crop"
            lifecycle.errorState = "keep-controls-and-disable-commit"
        } else if (tool === "masks") {
            lifecycle.primaryAction = "create-or-refine-selection"
            lifecycle.feedback = "selection-overlay-and-tool-hud"
            lifecycle.commit = "done-exits-selection-to-layers"
            lifecycle.cancel = "cancel-exits-transient-selection"
            lifecycle.errorState = "show-selection-retry"
        } else if (tool === "brush" || tool === "pixel-brush") {
            lifecycle.primaryAction = "paint-selection"
            lifecycle.feedback = tool === "pixel-brush" ? "snapped-source-pixel-cursor-and-selection-overlay" : "brush-outline-and-stroke-overlay"
            lifecycle.commit = tool === "pixel-brush" ? "done-exits-pixel-brush-to-layers" : "stroke-release-commits-done-exits-to-layers"
            lifecycle.cancel = tool === "pixel-brush" ? "cancel-exits-pixel-brush" : "cancel-ends-brush"
            lifecycle.errorState = "show-disabled-reason"
        } else if (tool === "retouch") {
            lifecycle.primaryAction = "paint-retouch-selection"
            lifecycle.feedback = "selection-overlay-and-patch-preview"
            lifecycle.commit = "apply-retouch-patch-or-done-exits-to-layers"
            lifecycle.cancel = "cancel-clears-pending-selection"
            lifecycle.errorState = "show-retry-regenerate"
        } else if (tool === "layers" || tool === "layers-focus") {
            lifecycle.primaryAction = "select-layer-target"
            lifecycle.feedback = "layer-row-target-summary"
            lifecycle.commit = "row-action-commits"
            lifecycle.cancel = "escape-menu-or-keep-target"
            lifecycle.errorState = "disabled-row-reason"
        } else if (tool === "compare") {
            lifecycle.primaryAction = "inspect-before-after"
            lifecycle.feedback = "compare-viewport-mode"
            lifecycle.commit = "switch-tool-exits"
            lifecycle.cancel = "switch-tool-exits"
            lifecycle.errorState = "fallback-to-single-view"
        } else if (tool === "export") {
            lifecycle.primaryAction = "queue-or-open-export"
            lifecycle.feedback = "queue-status"
            lifecycle.commit = "queue-export"
            lifecycle.cancel = "return-to-edit"
            lifecycle.errorState = "queue-error-and-retry"
        }
        return lifecycle
    }

    function editToolLifecycleContract(toolName) {
        const lifecycle = root.editToolLifecycle(toolName)
        return "tool-lifecycle:v1|" +
               "entry:" + lifecycle.entry +
               "|state:" + lifecycle.activeState +
               "|primary:" + lifecycle.primaryAction +
               "|feedback:" + lifecycle.feedback +
               "|commit:" + lifecycle.commit +
               "|cancel:" + lifecycle.cancel +
               "|disabled:" + lifecycle.disabledState +
               "|error:" + lifecycle.errorState
    }

    function configuredEditToolShortcut(actionId, fallbackKey) {
        const windowObject = root.Window.window
        let fallback = "Ctrl+Alt+" + String(fallbackKey || "")
        if (windowObject && typeof windowObject.primaryAltShortcut === "function")
            fallback = windowObject.primaryAltShortcut(String(fallbackKey || ""))
        if (windowObject && typeof windowObject.configuredShortcut === "function")
            return windowObject.configuredShortcut(String(actionId || ""), fallback)
        return appShell.shortcutSequence(String(actionId || ""), fallback)
    }

    function editToolModel() {
        const tools = [
            { id: "adjust", label: "Adjust", icon: "adjust", shortcutAction: "tool-adjust", shortcutFallback: "A", family: "Adjust", railGroup: "Adjust", category: "Edit", objectName: "adjustInspectorTabButton", railObjectName: "editRailAdjustButton", tooltip: "Adjust light, color, detail, lens, and transform controls." },
            { id: "presets", label: "Presets", icon: "swatch", shortcut: "", family: "Adjust", railGroup: "Adjust", category: "Edit", objectName: "presetsInspectorTabButton", railObjectName: "editRailPresetsButton", primaryTool: false, tooltip: "Open saved looks and preset packs." },
            { id: "masks", label: "Selection", icon: "smart-select", shortcutAction: "tool-masks", shortcutFallback: "M", family: "Selection", railGroup: "Selection", category: "Local", railObjectName: "editRailSelectionButton", tooltip: "Create selections, paint brush refinements, or retouch repairs from one canvas workflow." },
            { id: "paint", label: "Paint", icon: "brush-tool", shortcutAction: "tool-brush", shortcutFallback: "B", family: "Paint", railGroup: "Paint", category: "Graphics", railObjectName: "editRailPaintButton", tooltip: "Paint color or erase pixels on a transparent paint layer." },
            { id: "eraser", label: "Eraser", icon: "erase-tool", shortcut: "", family: "Paint", railGroup: "Paint", category: "Graphics", railObjectName: "editRailEraserButton", tooltip: "Erase pixels on the selected paint or pixel layer with independent size, hardness, opacity, and flow." },
            { id: "shapes", label: "Shapes", icon: "shape-tool", shortcut: "", family: "Shapes", railGroup: "Shapes", category: "Graphics", railObjectName: "editRailShapesButton", tooltip: "Draw editable rectangles, ellipses, lines, and arrows." },
            { id: "text", label: "Text", icon: "text", shortcut: "T", family: "Text", railGroup: "Text", category: "Graphics", railObjectName: "editRailTextButton", tooltip: "Click or drag a paragraph text box, then type on the canvas." },
            { id: "crop", label: "Crop", icon: "crop", shortcutAction: "tool-crop", shortcutFallback: "C", family: "Crop", railGroup: "Crop", category: "Geometry", objectName: "cropInspectorTabButton", railObjectName: "editRailCropButton", tooltip: "Crop, straighten, and transform the photo." },
            { id: "compare", label: "Compare", icon: "compare", shortcutAction: "tool-compare", shortcutFallback: "P", family: "View", railGroup: "View", category: "View", railObjectName: "editRailCompareButton", topRail: true, tooltip: "Compare before and after views." },
            { id: "scopes", label: "Scopes", icon: "scope", shortcut: "", family: "View", railGroup: "View", category: "View", objectName: "scopesInspectorTabButton", railObjectName: "editRailScopesButton", topRail: true, primaryTool: false, tooltip: "Open histogram, waveform, and analysis scopes." },
            { id: "export", label: "Export", icon: "export", shortcutAction: "tool-export", shortcutFallback: "E", family: "Export", railGroup: "Export", category: "Delivery", railObjectName: "editRailExportButton", primaryTool: false, tooltip: "Send the current work to Export." }
        ]
        return tools.map(function(tool) {
            const disabledReason = root.editToolDisabledReason(tool.id)
            const lifecycle = root.editToolLifecycle(tool.id)
            const shortcut = tool.shortcutAction
                    ? root.configuredEditToolShortcut(tool.shortcutAction, tool.shortcutFallback)
                    : String(tool.shortcut || "")
            return {
                id: tool.id,
                label: tool.label,
                icon: tool.icon,
                shortcut: shortcut,
                category: tool.category,
                family: tool.family,
                railGroup: tool.railGroup,
                topRail: tool.topRail === true,
                railObjectName: String(tool.railObjectName || ""),
                primaryTool: tool.primaryTool !== false,
                tooltip: String(tool.tooltip || ""),
                variant: root.editToolVariant(tool.id),
                lastUsedVariant: root.editToolLastUsedVariant(tool.id, root.editToolVariant(tool.id)),
                enabled: disabledReason.length === 0,
                disabledReason: disabledReason,
                active: root.editRailToolActive(tool.id),
                primaryAction: "activateEditTool",
                lifecycle: lifecycle,
                lifecycleContract: root.editToolLifecycleContract(tool.id),
                menuActions: root.editRailMenuItems(tool.id),
                menuWidth: tool.id === "masks" ? 250 : 220,
                customizationActions: [],
                hudComponent: root.activeCanvasToolChipVisible() && root.editRailToolActive(tool.id) ? "activeCanvasToolChip" : "",
                inspectorSection: root.editToolInspectorSection(tool.id),
                cursor: tool.id === "brush" || tool.id === "masks" || tool.id === "retouch" ? "crosshair" : "default",
                statusText: root.editToolStatusText(tool.id),
                pendingState: root.editToolPendingState(tool.id)
            }
        })
    }

    function editToolModelSignature() {
        return root.editToolModel().map(function(tool) {
            return tool.id + ":" +
                   tool.variant + ":" +
                   tool.lastUsedVariant + ":" +
                   tool.pendingState + ":" +
                   String(tool.enabled) + ":" +
                   String(tool.active) + ":" +
                   tool.railGroup + ":" +
                   tool.inspectorSection + ":" +
                   tool.lifecycle.primaryAction + ":" +
                   tool.lifecycle.commit + ":" +
                   tool.lifecycle.cancel
        }).join("|")
    }

    function editToolRailNavigationSignature() {
        const model = root.editToolModel()
        const groups = []
        const tools = []
        const primaryTools = []
        let explicitTooltips = true
        for (let index = 0; index < model.length; ++index) {
            const tool = model[index]
            const group = String(tool.railGroup || "")
            if (group.length > 0 && groups.indexOf(group) < 0)
                groups.push(group)
            tools.push(tool.id + "=" + group)
            if (tool.primaryTool !== false)
                primaryTools.push(tool.id)
            if (String(tool.tooltip || "").length === 0)
                explicitTooltips = false
        }
        return "tool-rail-navigation:v2" +
               "|groups:" + groups.join(">") +
               "|tools:" + tools.join(",") +
               "|primary:" + primaryTools.join(",") +
               "|stable-size:true|hover-layout-shift:false|tooltips:" + String(explicitTooltips) +
               "|navigation:direct|variants:page-controls|layers:inspector-tab|info:subtle-inspector-action|shortcuts:visible-model"
    }

    function studioMotionSignature() {
        return root.studioMotionContract +
               "|tool:" + root.editTool +
               "|transition-active:" + String(root.editToolTransitionActive) +
               "|switch-serial:" + String(root.toolSwitchSerial) +
               "|hud:" + String(root.activeCanvasToolChromeReduced || root.activeCanvasToolChipVisible()) +
               "|inspector:" + String(root.editInspectorPanelVisible) +
               "|target:" + root.activeEditTargetScope() +
               "|rows:LayerRowChrome"
    }

    function studioMotionDurationForState(reducedMotion, renderWorkActive, defaultDuration) {
        if (Boolean(reducedMotion) || Boolean(renderWorkActive))
            return 0
        const duration = Number(defaultDuration)
        return Number.isFinite(duration) && duration > 0 ? Math.round(duration) : 0
    }

    function platformStyleHints() {
        try {
            if (typeof Qt === "undefined" ||
                    Qt.application === undefined ||
                    Qt.application === null ||
                    Qt.application.styleHints === undefined ||
                    Qt.application.styleHints === null)
                return null
            return Qt.application.styleHints
        } catch (error) {
            return null
        }
    }

    function platformReducedMotionAvailable() {
        const hints = root.platformStyleHints()
        return hints !== null &&
               (hints.reducedMotion !== undefined ||
                hints.reduceMotion !== undefined ||
                hints.prefersReducedMotion !== undefined)
    }

    function platformReducedMotionPreference() {
        const hints = root.platformStyleHints()
        if (hints === null)
            return false
        if (hints.reducedMotion !== undefined)
            return Boolean(hints.reducedMotion)
        if (hints.reduceMotion !== undefined)
            return Boolean(hints.reduceMotion)
        if (hints.prefersReducedMotion !== undefined)
            return Boolean(hints.prefersReducedMotion)
        return false
    }

    function editToolLifecycleSignature() {
        return root.editToolModel().map(function(tool) {
            return tool.id + ":" + tool.lifecycleContract
        }).join("|")
    }

    function editRailToolActive(toolName) {
        if (toolName === "adjust")
            return root.editTool === "adjust" && root.editInspectorTab === "adjust"
        if (toolName === "presets" || toolName === "info")
            return root.editInspectorTab === toolName
        if (toolName === "scopes")
            return root.scopeDockVisible || root.editInspectorTab === "scopes"
        if (toolName === "layers-focus")
            return root.layersOnlyFocusMode
        if (toolName === "layers")
            return root.editTool === "layers" || root.editInspectorTab === "layers"
        if (toolName === "masks")
            return root.editTool === "masks" || root.editTool === "brush" ||
                   root.editTool === "pixel-brush" || root.editTool === "pixel-select" ||
                   root.editTool === "retouch" || root.brushToolReady()
        if (toolName === "brush")
            return root.editTool === "brush" || root.editTool === "pixel-brush" ||
                   root.brushToolReady()
        if (toolName === "retouch")
            return root.editTool === "retouch" ||
                   (editorPreview.hasActiveMask && editorPreview.activeMaskToolRole === "retouch")
        return root.editTool === toolName
    }

    function editRailMenuItems(toolName) {
