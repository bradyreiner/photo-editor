               "|context-panel:hidden-by-default" +
               "|layer-actions:primary-target-plus-more-during-brush" +
               "|layer-rows:compact-brush-mode" +
               "|visibility-states:menu-during-brush" +
               "|functions:preserved"
    }

    function setBrushPaintMode(operationName) {
        const operation = root.normalizedMaskCreationOperation(operationName)
        root.maskCreationOperation = operation
        root.editTool = "brush"
        root.editInspectorTab = "adjust"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        if (root.brushToolReady()) {
            return operation
        }
        root.editorPreviewController.startSelectionBrush(operation === "subtract")
        if (root.editorPreviewController.hasActiveMask)
            root.editorPreviewController.activeMaskOperation = operation
        return operation
    }

    function setTemporaryBrushEraseFromShortcut(active) {
        const requestedActive = active === true
        if (!root.brushToolReady()) {
            if (!requestedActive) {
                root.temporaryBrushEraseActive = false
                root.temporaryBrushErasePreviousOperation = ""
            }
            return false
        }
        if (requestedActive) {
            if (!root.temporaryBrushEraseActive) {
                root.temporaryBrushErasePreviousOperation =
                        root.normalizedMaskCreationOperation(root.maskCreationOperation)
                root.temporaryBrushEraseActive = true
            }
            root.maskCreationOperation = "subtract"
            return true
        }
        if (!root.temporaryBrushEraseActive)
            return false
        const restoredOperation = root.temporaryBrushErasePreviousOperation.length > 0
                ? root.temporaryBrushErasePreviousOperation
                : root.maskCreationOperation
        root.temporaryBrushEraseActive = false
        root.temporaryBrushErasePreviousOperation = ""
        root.maskCreationOperation = root.normalizedMaskCreationOperation(restoredOperation)
        return true
    }

    function adjustActiveBrushSize(delta) {
        if (!root.brushToolReady())
            return false
        root.editorPreviewController.activeMaskBrushSize = root.clamp(root.editorPreviewController.activeMaskBrushSize + delta, 0.01, 0.35)
        return true
    }

    function setActiveBrushSizePercent(percent) {
        if (!root.brushToolReady())
            return false
        const numericValue = Number(percent)
        if (!Number.isFinite(numericValue))
            return false
        root.editorPreviewController.activeMaskBrushSize = root.clamp(numericValue / 100.0, 0.01, 0.35)
        return true
    }

    function setActiveBrushSizeText(valueText) {
        const normalizedText = String(valueText || "").replace("%", "").trim()
        if (normalizedText.length === 0)
            return false
        return root.setActiveBrushSizePercent(normalizedText)
    }

    function beginBrushHudSizeDrag(sceneX) {
        if (!root.brushToolReady())
            return false
        root.brushHudSizeDragActive = true
        root.brushHudSizeDragStartX = Number(sceneX)
        root.brushHudSizeDragStartSize = root.editorPreviewController.activeMaskBrushSize
        return true
    }

    function updateBrushHudSizeDrag(sceneX) {
        if (!root.brushHudSizeDragActive || !root.brushToolReady())
            return false
        const sizeDelta = (Number(sceneX) - root.brushHudSizeDragStartX) / 180.0 * 0.18
        root.editorPreviewController.activeMaskBrushSize = root.clamp(root.brushHudSizeDragStartSize + sizeDelta, 0.01, 0.35)
        return true
    }

    function endBrushHudSizeDrag() {
        const wasActive = root.brushHudSizeDragActive
        root.brushHudSizeDragActive = false
        return wasActive
    }

    function adjustActiveBrushFlow(delta) {
        if (!root.brushToolReady())
            return false
        root.editorPreviewController.activeMaskBrushFlow = root.clamp(root.editorPreviewController.activeMaskBrushFlow + delta, 0.05, 1.0)
        return true
    }

    function adjustActiveBrushHardness(delta) {
        if (!root.brushToolReady())
            return false
        root.editorPreviewController.activeMaskBrushHardness = root.clamp(root.editorPreviewController.activeMaskBrushHardness + delta, 0.0, 1.0)
        return true
    }

    function adjustActiveMaskDensity(delta) {
        if (!root.brushToolReady())
            return false
        root.editorPreviewController.activeMaskDensity = root.clamp(root.editorPreviewController.activeMaskDensity + delta, 0.0, 1.0)
        return true
    }

    function adjustActiveMaskOpacity(delta) {
        if (!root.brushToolReady())
            return false
        root.editorPreviewController.activeMaskOpacity = root.clamp(root.editorPreviewController.activeMaskOpacity + delta, 0.0, 1.0)
        return true
    }

    function startRetouchTool(modeName, switchAlreadyPrepared) {
        // This entry is also used directly by rail menus, bypassing the main
        // tool activation function. Resolve authoring ownership before clearing
        // transient tools or arming a delayed retouch start.
        const mode = String(modeName || "").trim().toLowerCase()
        const sourceReason = root.componentRetouchDisabledReason(mode)
        if (sourceReason.length > 0) {
            root.showEditActionFeedback(sourceReason, true)
            return ""
        }
        if (root.editorPreviewController.selectionEditSessionActive) {
            if (root.editorPreviewController.selectionEditSessionDirty || !root.editorPreviewController.finishSelectionEditSession())
                return ""
        }
        if (!root.resolveTextSession())
            return ""
        root.cancelCloneSourcePick()
        if (switchAlreadyPrepared !== true) {
            root.beginEditToolSwitch("retouch")
            root.clearTransientToolStateFor("retouch")
        }
        root.editTool = "retouch"
        root.editInspectorTab = "adjust"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "overlay"
        root.pendingRetouchStartMode = mode.length > 0 ? mode : "remove"
        retouchToolStartTimer.restart()
        root.rememberEditToolVariant("retouch", root.pendingRetouchStartMode)
        return root.pendingRetouchStartMode
    }

    function completePendingRetouchToolStart() {
        const mode = String(root.pendingRetouchStartMode || "")
        root.pendingRetouchStartMode = ""
        if (root.editTool !== "retouch" || mode.length === 0)
            return ""
        if (mode === "heal")
            root.editorPreviewController.startHealBrush()
        else if (mode === "patch")
            root.editorPreviewController.startPatchBrush()
        else if (mode === "clone")
            root.editorPreviewController.startCloneBrush()
        else if (mode === "dust")
            root.editorPreviewController.removeDustSpots()
        else if (mode === "red-eye")
            root.editorPreviewController.removeRedEye()
        else if (mode === "skin-cleanup" || mode === "skin")
            root.editorPreviewController.cleanupSkin()
        else if (mode === "frequency-smoothing" || mode === "smooth")
            root.editorPreviewController.smoothSkinFrequency()
        else
            root.editorPreviewController.startRemoveBrush()
        root.rememberEditToolVariant("retouch", root.editorPreviewController.activeMaskRetouchMode)
        return root.editorPreviewController.activeMaskRetouchMode
    }

    function retouchModeLabel(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove")
            return "Remove"
        if (mode === "heal")
            return "Heal"
        if (mode === "patch")
            return "Patch"
        if (mode === "clone")
            return "Clone Stamp"
        if (mode === "dust")
            return "Dust Cleanup"
        if (mode === "red-eye")
            return "Red Eye"
        if (mode === "skin-cleanup")
            return "Skin Cleanup (Heuristic)"
        if (mode === "frequency-smoothing")
            return "Frequency Smoothing"
        return "Retouch"
    }

    function retouchModeCapabilityState(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove" || mode === "heal" || mode === "patch")
            return root.editorPreviewController.aiInpaintAvailable ? "model-ready" : "local-fallback"
        if (mode === "clone")
            return "deterministic"
        if (mode === "dust" || mode === "red-eye")
            return "local-staged"
        if (mode === "skin-cleanup" || mode === "frequency-smoothing")
            return "experimental-hidden"
        return "unsupported-hidden"
    }

    function retouchModeVisibilityState(modeName) {
        const mode = String(modeName || "").trim().toLowerCase()
        if (mode === "remove" || mode === "heal" || mode === "patch" || mode === "clone")
            return "primary"
        if (mode === "dust" || mode === "red-eye")
            return "mode-menu"
        return root.retouchModeCapabilityState(mode)
    }

    function retouchModeIsPrimary(modeName) {
        return root.retouchModeVisibilityState(modeName) === "primary"
    }

    function retouchHudModeMenuItems() {
        const sourceReason = root.componentRetouchDisabledReason("")
        return [
            { key: "retouch-remove", label: "Remove", icon: "erase-tool", checked: root.editorPreviewController.activeMaskRetouchMode === "remove", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Paint an object removal area." },
            { key: "retouch-heal", label: "Heal", icon: "brush-tool", checked: root.editorPreviewController.activeMaskRetouchMode === "heal", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Blend blemishes into nearby texture." },
            { key: "retouch-patch", label: "Patch", icon: "geometry", checked: root.editorPreviewController.activeMaskRetouchMode === "patch", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Patch a painted area from surrounding pixels." },
            { key: "retouch-clone", label: "Clone Stamp", icon: "source", checked: root.editorPreviewController.activeMaskRetouchMode === "clone", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Clone from a sampled source." },
            { key: "retouch-dust", label: "Dust Cleanup", icon: "scope", separatorBefore: true, checked: root.editorPreviewController.activeMaskRetouchMode === "dust", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Stage local dust spot cleanup." },
            { key: "retouch-red-eye", label: "Red Eye", icon: "adjust", checked: root.editorPreviewController.activeMaskRetouchMode === "red-eye", enabled: sourceReason.length === 0, disabledReason: sourceReason, tooltip: sourceReason || "Stage red-eye correction." },
            { key: "retouch-skin-cleanup", label: "Skin Cleanup (Heuristic)", icon: "brush-tool", separatorBefore: true, enabled: false, disabledReason: "Experimental skin cleanup is hidden until the workflow is production-ready.", tooltip: "Experimental skin cleanup is not available in the primary HUD." },
            { key: "retouch-frequency-smoothing", label: "Frequency Smoothing", icon: "brush-tool", enabled: false, disabledReason: "Experimental frequency smoothing is hidden until the workflow is production-ready.", tooltip: "Experimental frequency smoothing is not available in the primary HUD." }
        ].map(function(item) {
            const reason = root.componentRetouchDisabledReason(item.key)
            if (reason.length > 0) {
                item.enabled = false
                item.disabledReason = reason
                item.tooltip = reason
            }
            return item
        })
    }

    function retouchHudSecondaryModeMenuItems() {
        const modes = root.retouchHudModeMenuItems()
        const secondary = []
        for (let index = 0; index < modes.length; ++index) {
            const key = String(modes[index].key || "")
            if (key === "retouch-dust" || key === "retouch-red-eye")
                secondary.push(modes[index])
        }
        return secondary
    }

    function retouchCapabilityText() {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch")
            return "Ready"
        const state = root.retouchModeCapabilityState(root.editorPreviewController.activeMaskRetouchMode)
        if (state === "model-ready")
            return root.editorPreviewController.inpaintRuntimeLabel
        if (state === "local-fallback")
            return root.editorPreviewController.inpaintRuntimeLabel + " local"
        if (state === "deterministic")
            return "Manual"
        if (state === "local-staged")
            return "Local staged"
        if (state === "experimental-hidden")
            return "Experimental"
        return "Unsupported"
    }

    function retouchRequirementText() {
        const mode = root.editorPreviewController.activeMaskRetouchMode
        if (mode === "clone")
            return root.editorPreviewController.activeMaskCloneSourceSet ? "Source set" : "Pick source"
        if (mode === "remove" || mode === "heal" || mode === "patch")
            return root.editorPreviewController.activeMaskCommitted ? "Applied" : "Paint area"
        if (mode === "dust" || mode === "red-eye" || mode === "skin-cleanup" ||
                mode === "frequency-smoothing")
            return root.editorPreviewController.activeMaskCommitted ? "Review applied" : "Review staged"
        return root.editorPreviewController.activeMaskCommitted ? "Applied" : "Staged"
    }

    function retouchHudStatusText() {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch")
            return "Retouch"
        if (root.editorPreviewController.inpaintProgressActive)
            return String(root.editorPreviewController.inpaintProgressLabel || "Final retouch") + " / " +
                   Math.round(Math.max(0, Math.min(1, Number(root.editorPreviewController.inpaintProgressValue || 0))) * 100) + "%"
        return root.retouchModeLabel(root.editorPreviewController.activeMaskRetouchMode) + " / " +
               root.retouchRequirementText() + " / " +
               (root.editorPreviewController.retouchBeforeAfterEnabled ? "Before" : "After")
    }

    function retouchHudPrimaryText() {
        if (root.editorPreviewController.inpaintProgressActive)
            return "Cancel"
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch")
            return "Done"
        if (root.editorPreviewController.activeMaskRetouchMode === "remove" && !root.editorPreviewController.aiInpaintAvailable &&
                (!root.editorPreviewController.activeMaskCommitted || root.editorPreviewController.activeInpaintFinalizationAvailable))
            return "Set up model"
        if (root.editorPreviewController.activeInpaintFinalizationAvailable)
            return "Finalize"
        return root.editorPreviewController.activeMaskCommitted ? "Done" : "Apply"
    }

    function retouchHudPrimaryTooltip() {
        if (root.editorPreviewController.inpaintProgressActive)
            return "Stop generation and keep the previous applied patch."
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch")
            return "Exit retouch."
        if (root.editorPreviewController.activeMaskRetouchMode === "remove" && !root.editorPreviewController.aiInpaintAvailable &&
                (!root.editorPreviewController.activeMaskCommitted || root.editorPreviewController.activeInpaintFinalizationAvailable))
            return "Open Settings → Models to install or repair the Remove model. Your region is preserved."
        if (root.editorPreviewController.activeInpaintFinalizationAvailable)
            return "Finalize this repair at full output quality before export."
        if (root.editorPreviewController.activeMaskCommitted)
            return "Leave retouch and return to adjustment controls."
        return "Apply this retouch patch to the edit recipe; the original file is unchanged."
    }

    function completeRetouchTool() {
        root.finishSelectionWorkflow()
    }

    function triggerRetouchPrimaryAction() {
        if (root.editorPreviewController.inpaintProgressActive) {
            root.editorPreviewController.cancelActiveRetouch()
            return
        }
        const sourceReason = root.componentRetouchDisabledReason(root.editorPreviewController.activeMaskRetouchMode)
        if (sourceReason.length > 0) {
            root.showEditActionFeedback(sourceReason, true)
            return
        }
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch") {
            root.activateEditTool("adjust")
            return
        }
        if (root.editorPreviewController.activeMaskRetouchMode === "remove" && !root.editorPreviewController.aiInpaintAvailable &&
                (!root.editorPreviewController.activeMaskCommitted || root.editorPreviewController.activeInpaintFinalizationAvailable)) {
            root.modelSettingsRequested()
            return
        }
        if (root.editorPreviewController.activeInpaintFinalizationAvailable)
            root.editorPreviewController.queueActiveFinalInpaintPatch()
        else if (root.editorPreviewController.activeMaskCommitted)
            root.completeRetouchTool()
        else
            root.editorPreviewController.applyActiveRetouch()
    }

    function retouchHudInlineActions() {
        if (!root.editorPreviewController.hasActiveMask ||
                root.editorPreviewController.activeMaskToolRole !== "retouch" ||
                root.editorPreviewController.activeMaskRetouchMode !== "remove")
            return []
        const sourceReason = root.componentRetouchDisabledReason("remove")
        return [
            {
                key: "remove-add",
                objectName: "retouchHudRemoveAddButton",
                label: "Add",
                icon: "brush-tool",
                role: "segmented",
                checked: root.editorPreviewController.activeMaskOperation === "add",
                enabled: sourceReason.length === 0,
                disabledReason: sourceReason,
                accent: "#d98962",
                tooltip: sourceReason || "Add to the pending remove area."
            },
            {
                key: "remove-subtract",
                objectName: "retouchHudRemoveSubtractButton",
                label: "Subtract",
                icon: "brush-subtract",
                role: "segmented",
                checked: root.editorPreviewController.activeMaskOperation === "subtract",
                enabled: sourceReason.length === 0,
                disabledReason: sourceReason,
                accent: "#d36a5e",
                tooltip: sourceReason || "Subtract from the pending remove area."
            }
        ]
    }

    function handleRetouchHudInlineAction(key) {
        if (key === "remove-add") {
            root.editorPreviewController.startRemoveRefineBrush(false)
            return
        }
        if (key === "remove-subtract")
            root.editorPreviewController.startRemoveRefineBrush(true)
    }

    function retouchHudMoreMenuItems() {
        const active = root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskToolRole === "retouch"
        if (!active)
            return []
        if (root.componentRetouchDisabledReason(root.editorPreviewController.activeMaskRetouchMode).length > 0)
            return []
        const mode = String(root.editorPreviewController.activeMaskRetouchMode || "remove")
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const committed = root.editorPreviewController.activeMaskCommitted
        const items = []
        if (inpaintMode) {
            const texture = String(root.editorPreviewController.inpaintPrompt || "")
            items.push({ key: "texture-auto", label: "Fill texture: automatic", checked: texture.length === 0, separatorBefore: true, enabled: !committed, tooltip: "Reconstruct the surrounding image texture. This does not generate objects from text." })
            items.push({ key: "texture-smooth", label: "Fill texture: smooth", checked: texture === "smooth", enabled: !committed, tooltip: "Reduce texture in the reconstructed area." })
            items.push({ key: "texture-detail", label: "Fill texture: detailed", checked: texture === "texture detail", enabled: !committed, tooltip: "Preserve more surrounding texture in the reconstructed area." })
            items.push({
                           key: "regenerate",
                           label: committed ? "Regenerate Patch" : "Regenerate Preview",
                           icon: "reset",
                           enabled: !committed || root.editorPreviewController.activeInpaintRegenerationAvailable,
                           disabledReason: "Apply or select a generated patch before regenerating.",
                           tooltip: committed
                                    ? "Regenerate this applied retouch patch from its stored source selection."
                                    : "Advance the seed for the pending retouch patch candidate."
                       })
	            items.push({
	                           key: "finalize",
	                           label: "Finalize Result",
	                           icon: "check",
	                           enabled: root.editorPreviewController.activeInpaintFinalizationAvailable,
	                           disabledReason: "Apply a preview patch before finalizing the retouch result.",
	                           tooltip: "Queue the final retouch result from the stored source selection."
	                       })
        }
        if (root.editorPreviewController.maskActionRetryAvailable &&
                String(root.editorPreviewController.maskActionRetryLabel || "").indexOf("Inpaint") >= 0) {
            items.push({
                           key: "retry",
                           label: root.editorPreviewController.maskActionRetryLabel || "Retry",
                           icon: "reset",
                           tooltip: root.editorPreviewController.maskActionRetryDetail || "Retry the last failed retouch action."
                       })
        }
        if (mode === "heal") {
            items.push({ key: "heal-texture-down", label: "Less Texture", icon: "minus", separatorBefore: true, tooltip: "Reduce synthesized heal texture." })
            items.push({ key: "heal-texture-up", label: "More Texture", icon: "plus", tooltip: "Increase synthesized heal texture." })
            items.push({ key: "heal-color-down", label: "Less Color Blend", icon: "minus", tooltip: "Preserve more of the original heal color." })
            items.push({ key: "heal-color-up", label: "More Color Blend", icon: "plus", tooltip: "Blend more repaired heal color." })
        }
        if (mode === "patch") {
            items.push({ key: "patch-left", label: "Move Source Left", icon: "move-back", separatorBefore: true, tooltip: "Move the Patch source region left before applying." })
            items.push({ key: "patch-right", label: "Move Source Right", icon: "move-forward", tooltip: "Move the Patch source region right before applying." })
            items.push({ key: "patch-up", label: "Move Source Up", icon: "move-up", tooltip: "Move the Patch source region up before applying." })
            items.push({ key: "patch-down", label: "Move Source Down", icon: "move-down", tooltip: "Move the Patch source region down before applying." })
            items.push({ key: "patch-reset", label: "Reset Source Region", icon: "reset", tooltip: "Reset the Patch source region before applying." })
        }
        if (mode === "clone") {
            items.push({
                           key: "clone-aligned",
                           label: root.editorPreviewController.activeMaskCloneAligned ? "Aligned Clone" : "Non-aligned Clone",
                           icon: "source",
                           checked: root.editorPreviewController.activeMaskCloneAligned,
                           separatorBefore: true,
                           tooltip: "Toggle whether Clone Stamp keeps the source offset continuous across strokes."
                       })
            items.push({ key: "clone-save-source", label: "Save Clone Source", icon: "plus", enabled: root.editorPreviewController.activeMaskCloneSourceSet, disabledReason: "Pick a clone source before saving it.", tooltip: "Save the current Clone Stamp source, scale, rotation, and alignment." })
            items.push({ key: "clone-scale-down", label: "Reduce Clone Scale", icon: "minus", tooltip: "Reduce Clone Stamp source scale." })
            items.push({ key: "clone-scale-up", label: "Increase Clone Scale", icon: "plus", tooltip: "Increase Clone Stamp source scale." })
            items.push({ key: "clone-rotate-left", label: "Rotate Clone Left", icon: "undo", tooltip: "Rotate Clone Stamp source counterclockwise." })
            items.push({ key: "clone-rotate-right", label: "Rotate Clone Right", icon: "reset", tooltip: "Rotate Clone Stamp source clockwise." })
            const sources = root.editorPreviewController.activeMaskCloneSources || []
            for (let sourceIndex = 0; sourceIndex < sources.length; ++sourceIndex) {
                items.push({
                               key: "clone-source-" + sourceIndex,
                               label: String(sources[sourceIndex].name || ("Source " + (sourceIndex + 1))),
                               icon: "target",
                               checked: root.editorPreviewController.activeMaskCloneSourceIndex === sourceIndex,
                               tooltip: "Load saved Clone Stamp source."
                           })
            }
        }
        if (root.editorPreviewController.activeInpaintVariationPickerVisible) {
            for (let index = 0; index < root.editorPreviewController.activeInpaintCandidateCount; ++index) {
                items.push({
                               key: "variation-" + index,
                               label: "Use Variation " + String(index + 1),
                               icon: "compare",
                               checked: root.editorPreviewController.activeInpaintCandidateIndex === index,
                               separatorBefore: index === 0,
                               tooltip: "Use inpaint variation " + String(index + 1) + " from the generated patch candidates."
                           })
            }
        }
        if (root.editorPreviewController.inpaintProgressActive) {
            items.push({ key: "cancel", label: "Cancel Inpainting", icon: "close", separatorBefore: true, tooltip: "Stop generation and keep the previous applied patch." })
        } else if (!committed) {
            items.push({ key: "reset-selection", label: "Reset Selection", icon: "reset", separatorBefore: true, tooltip: "Clear the pending retouch selection while keeping the active retouch tool." })
            items.push({ key: "discard", label: "Discard Repair", icon: "close", tooltip: "Discard only this pending repair selection." })
        } else {
            items.push({ key: "reopen-selection", label: "Reopen Selection", icon: "brush-tool", separatorBefore: true, tooltip: "Reopen the applied retouch selection for refinement." })
            items.push({ key: "delete-patch", label: "Delete Patch", icon: "delete", destructive: true, tooltip: "Remove the applied retouch patch from the edit recipe." })
        }
        return items
    }

    function handleRetouchHudMoreMenuAction(key) {
        if (key === "texture-auto" || key === "texture-smooth" || key === "texture-detail") {
            root.editorPreviewController.inpaintPrompt = key === "texture-auto" ? "" : key === "texture-smooth" ? "smooth" : "texture detail"
        } else if (key === "before-after") {
            root.editorPreviewController.retouchBeforeAfterEnabled = !root.editorPreviewController.retouchBeforeAfterEnabled
        } else if (key === "regenerate") {
            if (root.editorPreviewController.activeMaskCommitted)
                root.editorPreviewController.regenerateActiveInpaintPatch()
            else
                root.editorPreviewController.regenerateInpaintSeed()
        } else if (key === "finalize") {
            root.editorPreviewController.queueActiveFinalInpaintPatch()
        } else if (key === "retry") {
            root.editorPreviewController.retryLastMaskAction()
        } else if (key === "heal-texture-down") {
            root.editorPreviewController.activeMaskHealTextureBlend = root.editorPreviewController.activeMaskHealTextureBlend - 0.08
        } else if (key === "heal-texture-up") {
            root.editorPreviewController.activeMaskHealTextureBlend = root.editorPreviewController.activeMaskHealTextureBlend + 0.08
        } else if (key === "heal-color-down") {
            root.editorPreviewController.activeMaskHealColorBlend = root.editorPreviewController.activeMaskHealColorBlend - 0.08
        } else if (key === "heal-color-up") {
            root.editorPreviewController.activeMaskHealColorBlend = root.editorPreviewController.activeMaskHealColorBlend + 0.08
        } else if (key === "patch-left") {
            root.retouchPatchSourceNudge(-0.04, 0.0)
        } else if (key === "patch-right") {
            root.retouchPatchSourceNudge(0.04, 0.0)
        } else if (key === "patch-up") {
            root.retouchPatchSourceNudge(0.0, -0.04)
        } else if (key === "patch-down") {
            root.retouchPatchSourceNudge(0.0, 0.04)
        } else if (key === "patch-reset") {
            root.editorPreviewController.setActiveMaskPatchSourceRegion(0.62, 0.50, 0.18, 0.18)
        } else if (key === "clone-aligned") {
            root.editorPreviewController.activeMaskCloneAligned = !root.editorPreviewController.activeMaskCloneAligned
        } else if (key === "clone-save-source") {
            root.editorPreviewController.saveActiveCloneSource()
