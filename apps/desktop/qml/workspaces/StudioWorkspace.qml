    function swappedCropAspectPreset(presetName) {
        const preset = String(presetName || "")
        const pairs = {
            "4:5": "5:4", "5:4": "4:5",
            "3:2": "2:3", "2:3": "3:2",
            "4:3": "3:4", "3:4": "4:3",
            "16:9": "9:16", "9:16": "16:9",
            "4x6 in": "6x4 in", "6x4 in": "4x6 in",
            "5x7 in": "7x5 in", "7x5 in": "5x7 in",
