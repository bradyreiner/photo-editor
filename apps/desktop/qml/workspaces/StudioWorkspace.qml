                                                    { name: "gamma", value: clamp(0.5 + root.primaryAdjustmentValue("levelsGamma", root.editorPreviewController.levelsGamma) / 220, 0.05, 0.95) },
                                                    { name: "white", value: clamp(1 - root.primaryAdjustmentValue("levelsWhitePoint", root.editorPreviewController.levelsWhitePoint) * 0.0095, 0.05, 1) }
                                                ]
                                                let nearest = positions[0]
                                                for (let index = 1; index < positions.length; ++index) {
                                                    if (Math.abs(positions[index].value - position) < Math.abs(nearest.value - position))
                                                        nearest = positions[index]
                                                }
                                                return nearest.name
