                                  root.activeEditHistoryPreviewIndex >= 0
        if (editHistoryHoverPreviewTimer) editHistoryHoverPreviewTimer.stop()
        root.pendingEditHistoryPreviewIndex = -1
        root.pendingEditHistoryPreviewAssetId = ""
