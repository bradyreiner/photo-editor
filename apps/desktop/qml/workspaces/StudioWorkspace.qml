    function handleMaskToolMenuAction(key) {
        if (root.componentWorkspaceActive &&
                ["depth", "remove-item"].indexOf(String(key || "")) >= 0) {
            root.showEditActionFeedback(root.componentSourceSamplingDisabledReason(), true)
            return
        }
        if (key === "remove-item") {
            root.createMaskSource("object")
            root.objectPickMode = "remove"
        } else if (key === "subject" || key === "sky" || key === "background") {
            root.createGeneratedSelectionSource(key)
        } else if (key === "object" || key === "linear" || key === "radial" ||
                   key === "ellipse" || key === "rectangle" || key === "luminance" ||
                   key === "color" || key === "depth") {
            root.createMaskSource(key)
        } else if (key === "brush-add") {
            root.startMaskBrushSource("add")
        } else if (key === "brush-erase") {
            root.startMaskBrushSource("subtract")
        } else if (key === "pixel-brush-add" || key === "pixel-select-add") {
            root.startPixelBrushSource("add")
        } else if (key === "pixel-brush-erase" || key === "pixel-select-erase") {
            root.startPixelBrushSource("subtract")
        } else if (key === "lasso" || key === "polygon") {
            root.startMaskPathSource(key)
        } else if (String(key || "").indexOf("retouch-") === 0) {
            root.handleEditRailMenuAction("retouch", key)
        }
    }

    function brushToolReady() {
        return page === "edit" &&
               root.editTool === "brush" &&
               root.editorPreviewController.hasActiveMask &&
               root.editorPreviewController.activeMaskKind === "brush" &&
               root.editorPreviewController.activeMaskToolRole !== "retouch"
    }

    function pixelSelectToolReady() {
        return page === "edit" &&
               root.editTool === "pixel-select" &&
               root.editorPreviewController.hasAsset &&
               !root.editorPreviewController.compareMode
    }

    function pixelBrushToolReady() {
        return page === "edit" &&
               root.editTool === "pixel-brush" &&
               root.editorPreviewController.hasAsset &&
