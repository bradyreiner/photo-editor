                                "Layer is no longer available.",
                tooltip: "Move this layer down."
            },
            {
                key: "move-out-of-group",
                label: "Move Out of Group",
                icon: "group",
                visible: isNested,
                enabled: root.photoLayerCanMoveOutOfGroup(validIndex),
                separatorBefore: true,
                disabledReason: locked
                    ? "Unlock the layer before changing its group."
                    : "Unlock the current or destination group before moving this layer.",
                tooltip: "Move this layer or group up one level in the layer hierarchy."
            },
            {
                key: "export",
                label: "Export Layer",
                icon: "export",
                enabled: false,
                disabledReason: "Choose a destination before exporting a single layer.",
                tooltip: "Layer export needs a destination picker before it can be run here."
            },
            {
                key: "use-selection-mask", label: "Use Active Selection as Mask", icon: "masks",
                separatorBefore: true,
                enabled: validIndex >= 0 && !locked && ["adjustment", "group"].indexOf(layerKind) < 0 &&
                         editorPreview.hasActiveMask && editorPreview.activeMaskToolRole !== "retouch",
                disabledReason: locked ? "Unlock the layer first." : "Select a mask and a content layer."
            },
            {
                key: "erase-background", label: "Erase Background", icon: "erase-tool",
                enabled: validIndex >= 0 && !locked && ["adjustment", "group"].indexOf(layerKind) < 0,
                disabledReason: "Choose an unlocked content layer."
            },
            {
                key: "copy-adjustments", label: "Copy Adjustments", icon: "source",
                visible: layerKind === "adjustment", separatorBefore: true, enabled: validIndex >= 0
            },
            {
                key: "paste-adjustments", label: "Paste Adjustments", icon: "insert",
                visible: layerKind === "adjustment", enabled: !locked && editorPreview.hasCopiedPhotoLayerAdjustments,
                disabledReason: locked ? "Unlock the layer first." : "Copy layer adjustments first."
            },
            {
                key: "paste-base-adjustments", label: "Paste Base Image Adjustments", icon: "media",
                visible: layerKind === "adjustment", enabled: !locked
            },
            {
                key: "preview-adjustments", label: layer && layer.adjustmentsPreviewBypassed === true ? "Show Adjustments" : "Preview Before Adjustments", icon: "compare",
                visible: layerKind === "adjustment", enabled: layer && layer.hasNonNeutralAdjustments === true
            },
            {
                key: "sync-adjustments", label: "Sync Adjustments to Selected Layers", icon: "effects",
                visible: layerKind === "adjustment" && root.normalizedPhotoLayerSelection().length > 1,
                enabled: root.selectedAdjustmentLayerIndices(validIndex).length > 0
            },
            {
                key: "delete",
                label: "Delete Layer",
                icon: "delete",
                destructive: true,
                separatorBefore: true,
                enabled: validIndex >= 0 && !locked,
                disabledReason: locked ? "Unlock the layer before deleting it." : "Layer is no longer available.",
                tooltip: "Delete this layer."
            }
        ]
        let firstGroupChoice = true
        if (validIndex >= 0 && !locked) {
            for (let groupIndex = 0; groupIndex < editorPreview.photoLayerCount; ++groupIndex) {
                if (!root.photoLayerCanMoveIntoGroup(validIndex, groupIndex))
                    continue
                const group = root.photoLayerRows[groupIndex] || ({})
                const groupName = String(group.displayName || group.name || "Layer Group")
                items.splice(items.length - 2, 0, {
                    key: "move-into-group:" + String(group.id),
                    label: "Move Into " + groupName,
                    icon: "group",
                    separatorBefore: firstGroupChoice,
                    tooltip: "Move this layer and its children into the selected group."
                })
                firstGroupChoice = false
            }
        }
        return items.filter(function(item) { return item.visible !== false })
    }

    function layerStackAcceptanceSignature() {
        return "layer-stack-acceptance:v3" +
               "|select:pointer-modifiers-keyboard" +
               "|rename:inline-f2-properties" +
               "|reorder:drag-keyboard-menu" +
               "|hierarchy:drag-into-group-cycle-safe-highlight-expand" +
               "|visibility:toggle-and-state" +
               "|opacity:fixed-readout" +
               "|mask-select:inspector-context" +
               "|transform:entry-exit" +
               "|escape:transient-first" +
               "|base-image:stack-bottom-selectable-locked" +
               "|row-body-drag:true" +
               "|rows:" + editorPreview.photoLayerCount.toString() +
               "|target:" + root.selectedEditTargetScope()
    }

    function layerDuplicatePolicySignature() {
        return "layer-duplicate-policy:v1|with-masks:duplicatePhotoLayerWithMasks|without-masks:duplicatePhotoLayerWithoutMasks|locked:blocked|batch:both"
    }

    function handleLayerRowMenuAction(key, layerIndex, layer) {
        if (key === "copy-layers") { root.copyLayers([layerIndex]); return }
        if (key === "paste-layers" || key === "paste-layers-in-place") {
            root.pasteLayers(key === "paste-layers-in-place")
            return
        }
        if (key === "relink-source") {
            if (!layer || layer.kind !== "source" || layer.locked === true)
                return
            relinkSourceLayerDialog.targetLayerId = String(layer.id || "")
            relinkSourceLayerDialog.open()
            return
        }
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return
        if (key === "move-out-of-group") {
            const layerId = String((root.photoLayerRows[index] || ({})).id || "")
            if (root.photoLayerCanMoveOutOfGroup(index)
                    && editorPreview.movePhotoLayerOutOfGroup(index)) {
                const movedIndex = root.photoLayerIndexForId(layerId)
                if (movedIndex >= 0)
                    root.setActivePhotoLayerSelection(movedIndex, false)
            }
        } else if (String(key).indexOf("move-into-group:") === 0) {
            const groupId = String(key).substring("move-into-group:".length)
            const groupIndex = root.photoLayerIndexForId(groupId)
            const layerId = String((root.photoLayerRows[index] || ({})).id || "")
            if (root.photoLayerCanMoveIntoGroup(index, groupIndex) &&
                    editorPreview.movePhotoLayerIntoGroup(index, groupIndex)) {
                const movedIndex = root.photoLayerIndexForId(layerId)
                if (movedIndex >= 0)
                    root.setActivePhotoLayerSelection(movedIndex, false)
            }
        } else if (key === "properties") {
            root.setActivePhotoLayerSelection(index, false)
            root.editInspectorTab = "layers"
            Qt.callLater(function() { root.photoLayerDetailsExpanded = true })
        } else if (key === "edit") {
            root.editPhotoLayerInspectorTarget(index)
        } else if (key === "use-selection-mask") {
            root.useActiveSelectionAsLayerMask(index, false)
        } else if (key === "erase-background") {
            root.startLayerBackgroundEraser(index)
        } else if (key === "copy-adjustments") {
            editorPreview.copyPhotoLayerAdjustments(index)
        } else if (key === "paste-adjustments") {
            editorPreview.pastePhotoLayerAdjustments(index)
        } else if (key === "paste-base-adjustments") {
            editorPreview.pasteGlobalAdjustmentsToPhotoLayer(index)
        } else if (key === "preview-adjustments") {
            editorPreview.setPhotoLayerAdjustmentsPreviewBypassed(index, !(layer && layer.adjustmentsPreviewBypassed === true))
        } else if (key === "sync-adjustments") {
            editorPreview.syncPhotoLayerAdjustments(index, root.selectedAdjustmentLayerIndices(index))
        } else if (key === "toggle-visible") {
            editorPreview.setPhotoLayerEnabled(index, layer && layer.enabled === false)
        } else if (key === "toggle-lock") {
            editorPreview.setPhotoLayerLocked(index, !(layer && layer.locked === true))
        } else if (key === "toggle-solo") {
            if (layer && layer.solo === true)
                editorPreview.clearPhotoLayerSolo()
            else
                editorPreview.isolatePhotoLayer(index)
        } else if (key === "toggle-clip") {
            editorPreview.setPhotoLayerClippingMask(index, !(layer && layer.clippingMask === true))
        } else if (key === "toggle-mask") {
            editorPreview.setPhotoLayerMaskEnabled(index, !(layer && layer.hasLayerMask === true))
        } else if (key === "transform") {
            root.setActivePhotoLayer(index)
        } else if (key === "toggle-text-controls") {
            root.expandedTextLayerIndex = root.expandedTextLayerIndex === index ? -1 : index
        } else if (key === "erase-selection-pixels") {
            editorPreview.erasePixelsFromSelection(index)
        } else if (key === "copy-selection-pixels") {
            if (editorPreview.copyPixelsFromSelection(index)) root.setActivePhotoLayerSelection(0, false)
        } else if (key === "copy-selection-pixels-independent") {
            if (editorPreview.copyPixelsFromSelection(index, true)) root.setActivePhotoLayerSelection(0, false)
        } else if (key === "duplicate" || key === "duplicate-with-masks") {
            editorPreview.duplicatePhotoLayerWithMasks(index)
        } else if (key === "duplicate-without-masks") {
            editorPreview.duplicatePhotoLayerWithoutMasks(index)
        } else if (key === "move-up") {
            root.movePhotoLayerPreservingSelection(index, -1)
        } else if (key === "move-down") {
            root.movePhotoLayerPreservingSelection(index, 1)
        } else if (key === "delete") {
            root.deletePhotoLayerTarget(index)
        }
    }

    function relinkSourceLayer(layerId, sourceUrl) {
        return editorPreview.relinkSourceLayer(String(layerId), String(sourceUrl))
    }

    function maskSetRowMenuItems(maskSet, linkedLayerIndex, parentLayerIndex, combineOrderIndex, combineOrderCount) {
        const maskId = String(maskSet && maskSet.id !== undefined ? maskSet.id : "")
        const hasSources = Number(maskSet && maskSet.sourceCount !== undefined ? maskSet.sourceCount : 0) > 0
        const previewBypassed = maskSet && maskSet.maskSetPreviewBypassed === true
        const linkedIndex = Math.floor(Number(linkedLayerIndex))
        const parentIndex = Math.floor(Number(parentLayerIndex))
        const orderIndex = Math.floor(Number(combineOrderIndex))
        const orderCount = Math.max(0, Math.floor(Number(combineOrderCount)))
        const nested = parentIndex >= 0
        return [
            { key: "copy-pixels", label: "Copy Linked Pixels from Selection", icon: "copy", enabled: hasSources, tooltip: "Create a copy that follows later base-photo edits and keeps this selection editable." },
            { key: "copy-independent", label: "Create Independent Cutout", icon: "copy", enabled: hasSources, tooltip: "Render the developed base now and bake this selection into a self-contained pixel layer." },
            { key: "edit-mask", label: "Edit Selection", icon: "select", checked: root.maskSetActive(maskSet), tooltip: "Edit this selection on the canvas." },
            { key: "edit-layer", label: linkedIndex >= 0 ? "Edit Layer" : "Create Layer", icon: "adjust", separatorBefore: true, tooltip: linkedIndex >= 0 ? "Edit the linked layer." : "Create and edit a layer for this selection." },
            { key: "toggle-preview", label: previewBypassed ? "Show Preview" : "Preview Before Selection", icon: "compare", enabled: maskId.length > 0 && hasSources, disabledReason: "This selection has no source preview yet.", checked: previewBypassed, tooltip: previewBypassed ? "Show this selection in preview." : "Preview before this selection." },
            { key: "move-mask-up", label: "Move Selection Up", icon: "move-up", enabled: nested && orderIndex > 0, disabledReason: nested ? "Selection is already first." : "Only linked selections can be reordered here.", tooltip: "Move this selection earlier in the combine order." },
            { key: "move-mask-down", label: "Move Selection Down", icon: "move-down", enabled: nested && orderIndex >= 0 && orderIndex < orderCount - 1, disabledReason: nested ? "Selection is already last." : "Only linked selections can be reordered here.", tooltip: "Move this selection later in the combine order." },
            { key: "delete-mask", label: "Delete Selection", icon: "delete", destructive: true, separatorBefore: true, tooltip: "Delete this selection." }
        ]
    }

    function handleMaskSetRowMenuAction(key, maskSet, linkedLayerIndex, parentLayerIndex, combineOrderIndex) {
        const action = String(key || "")
        const parentIndex = Math.floor(Number(parentLayerIndex))
        const orderIndex = Math.floor(Number(combineOrderIndex))
        if (action === "copy-pixels") {
            if (editorPreview.selectMaskSet(String(maskSet.id)) && editorPreview.copyPixelsFromSelection())
                root.setActivePhotoLayerSelection(0, false)
        } else if (action === "copy-independent") {
            if (editorPreview.selectMaskSet(String(maskSet.id)) && editorPreview.copyPixelsFromSelection(-1, true))
                root.setActivePhotoLayerSelection(0, false)
        } else if (action === "edit-mask") {
            root.selectMaskSetAndLayer(maskSet, false)
        } else if (action === "edit-layer") {
            root.selectMaskSetAndLayer(maskSet, true)
        } else if (action === "toggle-preview") {
            editorPreview.setMaskSetPreviewBypassed(String(maskSet && maskSet.id !== undefined ? maskSet.id : ""),
                                                    !(maskSet && maskSet.maskSetPreviewBypassed === true))
        } else if (action === "move-mask-up") {
            root.moveLayerMaskSet(parentIndex, maskSet, orderIndex - 1)
        } else if (action === "move-mask-down") {
            root.moveLayerMaskSet(parentIndex, maskSet, orderIndex + 1)
        } else if (action === "delete-mask") {
            root.deleteMaskSet(maskSet)
        }
    }

    function selectedLayerTargetScope(layerIndex) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return "base-image"
        return root.photoLayerKind(index) === "adjustment" ? "adjustment-layer" : "photo-layer"
    }

    function selectedEditTargetScope() {
        const scope = String(root.selectedEditTarget.scope || "base-image")
        return scope.length > 0 ? scope : "base-image"
    }

    function selectedEditTargetLayerIndex() {
        const identity = String(root.selectedEditTarget.layerId || "")
        if (identity.length > 0)
            return root.photoLayerIndexForIdentity(identity)
        const index = Math.floor(Number(root.selectedEditTarget.layerIndex))
        return index >= 0 && index < editorPreview.photoLayerCount ? index : -1
    }

    function selectedEditTargetSourceIndex() {
        const identity = String(root.selectedEditTarget.componentId || "")
        if (identity.length > 0) {
            const stack = editorPreview.maskStack || []
            for (let index = 0; index < stack.length; ++index) {
                if (String(stack[index].id || "") === identity &&
                        String(stack[index].maskSetId || "") === root.selectedEditTargetMaskSetId())
                    return index
            }
            return -1
        }
        return Math.floor(Number(root.selectedEditTarget.sourceIndex ?? -1))
    }

    function selectedEditTargetMaskSetId() {
        return String(root.selectedEditTarget.maskSetId || "").trim()
    }

    function selectedEditTargetSignature() {
        return "selected-target:v1|scope:" + root.selectedEditTargetScope() +
                "|layer:" + root.selectedEditTargetLayerIndex().toString() +
                "|mask:" + root.selectedEditTargetMaskSetId() +
                "|source:" + root.selectedEditTargetSourceIndex().toString() +
                "|legacy-layer:" + Math.floor(Number(root.activePhotoLayerIndex || -1)).toString() +
                "|legacy-mask:" + Math.floor(Number(root.selectedMaskSetIndex || -1)).toString() +
                "|base:" + String(root.baseImageTargetActive === true)
    }

    function setSelectedEditTarget(scope, layerIndex, maskSet, sourceIndex) {
        const nextScope = String(scope || "base-image")
        const normalizedLayerIndex = Math.floor(Number(layerIndex))
        const validLayerIndex = normalizedLayerIndex >= 0 && normalizedLayerIndex < editorPreview.photoLayerCount
                ? normalizedLayerIndex
                : -1
        const maskSetId = String(maskSet && maskSet.id !== undefined ? maskSet.id : "").trim()
        const maskSetName = String(maskSet && maskSet.name !== undefined ? maskSet.name : "").trim()
        const normalizedSourceIndex = Math.floor(Number(sourceIndex !== undefined ? sourceIndex : -1))
        root.selectedEditTarget = {
            scope: nextScope,
            layerIndex: validLayerIndex,
            layerId: root.photoLayerIdentityAt(validLayerIndex),
            maskSetId: maskSetId,
            maskSetName: maskSetName,
            sourceIndex: normalizedSourceIndex,
            componentId: normalizedSourceIndex >= 0 && normalizedSourceIndex < editorPreview.maskStack.length
                         ? String(editorPreview.maskStack[normalizedSourceIndex].id || "") : ""
        }
        root.baseImageTargetActive = nextScope === "base-image"
        if (validLayerIndex >= 0)
            root.activePhotoLayerIndex = validLayerIndex
        if (nextScope === "mask") {
            const maskSets = root.maskSetRows
            for (let index = 0; index < maskSets.length; ++index) {
                const candidate = maskSets[index] || ({})
                if ((maskSetId.length > 0 && String(candidate.id || "").trim() === maskSetId) ||
                        (maskSetId.length === 0 && maskSetName.length > 0 && String(candidate.name || "").trim() === maskSetName)) {
                    root.selectedMaskSetIndex = index
                    break
                }
            }
        }
        return true
    }

    function normalizedActivePhotoLayerIndex() {
        if (editorPreview.photoLayerCount <= 0)
            return -1
        return Math.max(0, Math.min(editorPreview.photoLayerCount - 1, root.activePhotoLayerIndex))
    }

    function normalizedPhotoLayerSelection() {
        const selected = []
        const seen = ({})
        const source = root.selectedPhotoLayerIndices || []
        for (let index = 0; index < source.length; ++index) {
            const layerIndex = Number(source[index])
            if (!isFinite(layerIndex) || layerIndex < 0 || layerIndex >= editorPreview.photoLayerCount)
                continue
            const normalizedIndex = Math.floor(layerIndex)
            const key = String(normalizedIndex)
            if (seen[key] === true)
                continue
            seen[key] = true
            selected.push(normalizedIndex)
        }
        return selected
    }

    function canCopyLayers() {
        return page === "edit" && editorPreview.hasAsset && !root.editBoardSwitchBusy && !editorPreview.photoLayerClipboardBusy &&
               !editorPreview.photoPaintBusy && !root.shortcutTextInputActive() &&
               (root.selectedEditTargetScope() === "base-image" || root.normalizedPhotoLayerSelection().length > 0)
    }

    function copySelectedLayers() {
        if (!root.canCopyLayers()) return false
        return root.copyLayers(root.selectedEditTargetScope() === "base-image" ? [-1] : root.normalizedPhotoLayerSelection())
    }

    function copyLayers(indices) {
        if (!editorPreview.copyPhotoLayers(indices)) return false
        root.showEditActionFeedback(qsTr("Copying layers…"), false)
        editActionFeedbackTimer.stop()
        return true
    }

    function pasteLayers(inPlace) {
        if (root.shortcutTextInputActive() || root.editBoardSwitchBusy) return false
        const identities = editorPreview.pastePhotoLayers(Math.max(0, root.normalizedActivePhotoLayerIndex()), inPlace)
        if (!identities.length) return false
        const layers = editorPreview.photoLayers
        const indices = []
        for (let i = 0; i < layers.length; ++i)
            if (identities.indexOf(String(layers[i].id)) >= 0) indices.push(i)
        if (indices.length) {
            root.setActivePhotoLayerSelection(indices[0], false)
            root.selectedPhotoLayerIndices = indices
        }
        root.recentlyPastedLayerIds = identities
        pastedLayerHighlightTimer.restart()
        const primary = layers[indices[0]] || ({})
        const kind = String(primary.kind || "")
        const compatible = ["adjust", "layers"].indexOf(root.editTool) >= 0 ||
            (root.editTool === "text" && kind === "text") || (root.editTool === "shapes" && (kind === "shape" || Object.keys(primary.shapeDefinition || ({})).length > 0)) ||
            (["paint", "eraser"].indexOf(root.editTool) >= 0 && kind === "pixel" && Object.keys(primary.shapeDefinition || ({})).length === 0)
        if (!compatible) {
            root.editInspectorTab = "layers"
            root.activateEditTool("layers")
        }
        return true
    }

    function addDroppedImageLayer(fileUrl) {
        const editViewport = root.editViewportHandle
        if (root.editBoardSwitchBusy || !editorPreview.hasAsset || !editViewport ||
            !(editViewport.paintedContentWidth > 0 && editViewport.paintedContentHeight > 0)) return false
        editorPreview.beginCoalescedEdit()
        const added = editorPreview.addSourceLayer(fileUrl)
        if (added) {
            const layer = editorPreview.photoLayers[0]
            const sourceW = editorPreview.sourceImageWidth
            const sourceH = editorPreview.sourceImageHeight
            const sx = editViewport.paintedContentWidth / sourceW
            const sy = editViewport.paintedContentHeight / sourceH
            const tileW = editViewport.boardUnitWidth * editViewport.zoom / sx
            const tileH = editViewport.boardUnitHeight * editViewport.zoom / sy
            const tileX = (editViewport.imageFrameX + (root.editBoardIndex - editViewport.imageSpanStart) * editViewport.boardUnitWidth * editViewport.zoom - editViewport.paintedContentX) / sx
            const tileY = (editViewport.imageFrameY - editViewport.paintedContentY) / sy
            const scale = Math.max(0.05, Math.min(32, Math.min(tileW / layer.pixelWidth, tileH / layer.pixelHeight) * 0.8))
            editorPreview.setPhotoLayerTransform(0, Math.round(tileX + (tileW - layer.pixelWidth * scale) / 2),
                Math.round(tileY + (tileH - layer.pixelHeight * scale) / 2), scale, 0)
            root.setActivePhotoLayerSelection(0, false)
            root.recentlyPastedLayerIds = [String(layer.id)]
            pastedLayerHighlightTimer.restart()
            root.editInspectorTab = "layers"
            root.activateEditTool("layers")
            root.showEditActionFeedback(qsTr("Image layer added"), false)
        } else root.showEditActionFeedback(editorPreview.status, true)
        editorPreview.endCoalescedEdit()
        return added
    }

    function photoLayerIdentityAt(layerIndex) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return ""
        const layer = root.photoLayerRows[index] || ({})
        return String(layer.id || "")
    }

    function photoLayerIndexForIdentity(identity) {
        const target = String(identity || "").trim()
        if (target.length === 0)
            return -1
        for (let index = 0; index < editorPreview.photoLayerCount; ++index) {
            if (root.photoLayerIdentityAt(index) === target)
                return index
        }
        return -1
    }

    function photoLayerIdentitiesForSelection(selection) {
        const identities = []
        const source = selection || []
        for (let index = 0; index < source.length; ++index) {
            const identity = root.photoLayerIdentityAt(source[index])
            if (identity.length > 0)
                identities.push(identity)
        }
        return identities
    }

    function photoLayerIndicesForIdentities(identities) {
        const selected = []
        const seen = ({})
        const source = identities || []
        for (let index = 0; index < source.length; ++index) {
            const layerIndex = root.photoLayerIndexForIdentity(source[index])
            const key = String(layerIndex)
            if (layerIndex >= 0 && seen[key] !== true) {
                seen[key] = true
                selected.push(layerIndex)
            }
        }
        return selected
    }

    function movePhotoLayerPreservingSelection(layerIndex, offset) {
        const index = Math.floor(Number(layerIndex))
        const selectedIdentities = root.photoLayerIdentitiesForSelection(root.normalizedPhotoLayerSelection())
        const activeIdentity = root.photoLayerIdentityAt(root.normalizedActivePhotoLayerIndex())
        const targetIdentity = root.photoLayerIdentityAt(root.selectedEditTargetLayerIndex())
        const expandedTextIdentity = root.photoLayerIdentityAt(root.expandedTextLayerIndex)
        const retainedTarget = {
            scope: root.selectedEditTargetScope(),
            maskSetId: root.selectedEditTargetMaskSetId(),
            maskSetName: String(root.selectedEditTarget.maskSetName || "").trim(),
            sourceIndex: root.selectedEditTargetSourceIndex()
        }
        if (!editorPreview.movePhotoLayer(index, offset))
            return false
        const restoredSelection = root.photoLayerIndicesForIdentities(selectedIdentities)
        root.selectedPhotoLayerIndices = restoredSelection.length > 0 ? restoredSelection : root.normalizedPhotoLayerSelection()
        const activeIndex = root.photoLayerIndexForIdentity(activeIdentity)
        if (activeIndex >= 0)
            root.activePhotoLayerIndex = activeIndex
        const targetIndex = root.photoLayerIndexForIdentity(targetIdentity)
        if (retainedTarget.scope === "base-image") {
            root.setSelectedEditTarget("base-image", -1, ({}), -1)
        } else if (targetIndex >= 0) {
            root.setSelectedEditTarget(
                        retainedTarget.scope,
                        targetIndex,
                        { id: retainedTarget.maskSetId, name: retainedTarget.maskSetName },
                        retainedTarget.sourceIndex)
        }
        const expandedTextIndex = root.photoLayerIndexForIdentity(expandedTextIdentity)
        root.expandedTextLayerIndex = expandedTextIndex
        return true
    }

    function photoLayerSelected(layerIndex) {
        return root.normalizedPhotoLayerSelection().indexOf(Number(layerIndex)) >= 0
    }

    function photoLayerHasSelectedMask(layerIndex) {
        const linkedMaskSets = root.maskSetsForAdjustmentLayer(layerIndex)
        for (let index = 0; index < linkedMaskSets.length; ++index) {
            if (root.maskSetActive(linkedMaskSets[index]))
                return true
        }
        return false
    }

    function photoLayerStateSummary(layer, layerIndex) {
        const states = [layer.enabled === false ? "Hidden" : "Visible"]
        if (layer.locked === true)
            states.push("Locked")
        if (layer.solo === true)
            states.push("Solo")
        if (root.photoLayerSelected(layerIndex))
            states.push("Selected")
        if (root.photoLayerHasSelectedMask(layerIndex))
            states.push("Mask selected")
        return states.join(" / ")
    }

    function photoLayerStateSignature(layer, layerIndex) {
        return "visible:" + String(layer.enabled !== false) +
                "|hidden:" + String(layer.enabled === false) +
                "|locked:" + String(layer.locked === true) +
                "|solo:" + String(layer.solo === true) +
                "|selected:" + String(root.photoLayerSelected(layerIndex)) +
                "|mask-selected:" + String(root.photoLayerHasSelectedMask(layerIndex))
    }

    function photoLayerHasMaskBadge(layer, layerIndex) {
        if (!layer)
            return false
        if (layer.hasLayerMask === true)
            return true
        const singleMaskId = String(layer.selectionMaskSetId || "").trim()
        const singleMaskName = String(layer.selectionMaskSetName || "").trim()
        if (singleMaskId.length > 0 || singleMaskName.length > 0)
            return true
        const maskIds = layer.selectionMaskSetIds || []
        const maskNames = layer.selectionMaskSetNames || []
        if ((maskIds.length !== undefined && maskIds.length > 0) ||
                (maskNames.length !== undefined && maskNames.length > 0))
            return true
        return root.maskSetsForAdjustmentLayer(layerIndex).length > 0
    }

    function photoLayerStateBadges(layer, layerIndex, rendering, failed, progressive, stale, displayState) {
        const badges = []
        const addBadge = function(key, label, tone) {
            badges.push({ key: key, label: label, tone: tone || "neutral" })
        }
        if (root.photoLayerHasMaskBadge(layer, layerIndex))
            addBadge("masked", "Masked", "accent")
        if (layer && layer.enabled === false)
            addBadge("hidden", "Hidden", "neutral")
        if (layer && layer.locked === true)
            addBadge("locked", "Locked", "neutral")
        if (layer && layer.solo === true)
            addBadge("solo", "Solo", "warning")
        if (progressive === true || stale === true ||
                String(displayState || "").indexOf("progressive") >= 0)
            addBadge("draft", "Draft", "info")
        if (rendering === true)
            addBadge("rendering", "Rendering", "info")
        if (failed === true)
            addBadge("failed", "Failed", "warning")
        return badges
    }

    function photoLayerStateBadgeSignature(layer, layerIndex, rendering, failed, progressive, stale, displayState) {
        const badges = root.photoLayerStateBadges(
                    layer,
                    layerIndex,
                    rendering,
                    failed,
                    progressive,
                    stale,
                    displayState)
        const keys = []
        for (let index = 0; index < badges.length; ++index)
            keys.push(String(badges[index].key || ""))
        return "layer-state-badges:v1|global:base-row|keys:" + keys.join(",") +
                "|masked:" + String(root.photoLayerHasMaskBadge(layer, layerIndex)) +
                "|hidden:" + String(layer && layer.enabled === false) +
                "|locked:" + String(layer && layer.locked === true) +
                "|solo:" + String(layer && layer.solo === true) +
                "|draft:" + String(progressive === true || stale === true ||
                                    String(displayState || "").indexOf("progressive") >= 0) +
                "|rendering:" + String(rendering === true) +
                "|failed:" + String(failed === true)
    }

    function selectedAdjustmentLayerIndices(excludeIndex) {
        const selected = root.normalizedPhotoLayerSelection()
        const targets = []
        for (let index = 0; index < selected.length; ++index) {
            const layerIndex = selected[index]
            if (layerIndex === excludeIndex)
                continue
            const layer = root.photoLayerRows[layerIndex] || ({})
            if (String(layer.kind || "").trim().toLowerCase() === "adjustment" && layer.locked !== true)
                targets.push(layerIndex)
        }
        return targets
    }

    function selectedPhotoLayerBatchTargets(includeActiveFallback, excludeIndex) {
        let selected = root.normalizedPhotoLayerSelection()
        const activeIndex = root.normalizedActivePhotoLayerIndex()
        if (selected.length === 0 && includeActiveFallback === true && activeIndex >= 0)
            selected = [activeIndex]
        const targets = []
        const seen = ({})
        for (let index = 0; index < selected.length; ++index) {
            const layerIndex = Math.floor(Number(selected[index]))
            if (layerIndex < 0 || layerIndex >= editorPreview.photoLayerCount)
                continue
            if (layerIndex === excludeIndex)
                continue
            const key = String(layerIndex)
            if (seen[key] === true)
                continue
            seen[key] = true
            targets.push(layerIndex)
        }
        return targets
    }

    function selectedPhotoLayerBatchSignature() {
        const targets = root.selectedPhotoLayerBatchTargets(true, -1)
        return "selected-layer-batch-actions:v1|visibility:true|lock:true|delete:true|duplicate:true|opacity:true|blend:true|paste-adjustments:true|paste-global:true|targets:" +
                targets.join(",")
    }

    function selectedLayerGeometry() {
        const selected = root.normalizedPhotoLayerSelection()
        const result = []
        for (let index of selected) {
            const layer = root.photoLayerRows[index] || ({})
            if (layer.locked === true || String(layer.parentId || "").length > 0 ||
                String(layer.kind || "") === "group" || !root.photoLayerHasDirectTransform(layer))
                return []
            const scale = Number(layer.scale || 1)
            const width = Number(layer.pixelWidth || 0) * scale
            const height = Number(layer.pixelHeight || 0) * scale
            if (!(width > 0 && height > 0)) return []
            const radians = Number(layer.rotation || 0) * Math.PI / 180
            const extentX = Math.abs(Math.cos(radians)) * width + Math.abs(Math.sin(radians)) * height
            const extentY = Math.abs(Math.sin(radians)) * width + Math.abs(Math.cos(radians)) * height
            result.push({ index: index, layer: layer, cx: Number(layer.x || 0) + width / 2,
                          cy: Number(layer.y || 0) + height / 2, width: extentX, height: extentY })
        }
        return result
    }

    function layerAlignmentMenuItems() {
        const count = root.selectedLayerGeometry().length
        const reason = qsTr("Select unlocked text, shape or pixel layers outside a group.")
        return [
            { key: "left", label: "Align left edges" }, { key: "center-x", label: "Align horizontal centers" },
            { key: "right", label: "Align right edges" }, { key: "top", label: "Align top edges" },
            { key: "center-y", label: "Align vertical centers" }, { key: "bottom", label: "Align bottom edges" },
            { key: "distribute-x", label: "Distribute horizontal spacing", separatorBefore: true },
            { key: "distribute-y", label: "Distribute vertical spacing" }
        ].map(function(item) {
            const distribute = item.key.indexOf("distribute") === 0
            item.enabled = count >= (distribute ? 3 : 2)
            item.disabledReason = distribute ? qsTr("Select at least three unlocked content layers outside a group.") : reason
            item.tooltip = distribute ? qsTr("Keep the outer layers in place and make the gaps equal.") : qsTr("Align selected layers to one another.")
            return item
        })
    }

    function alignSelectedLayers(operation) {
        const layers = root.selectedLayerGeometry()
        const horizontal = ["left", "right", "center-x", "distribute-x"].indexOf(operation) >= 0
        const distribute = operation.indexOf("distribute-") === 0
        if (layers.length < (distribute ? 3 : 2)) return false
        if (["left", "right", "center-x", "top", "bottom", "center-y", "distribute-x", "distribute-y"].indexOf(operation) < 0) return false
        const center = horizontal ? "cx" : "cy"
        const extent = horizontal ? "width" : "height"
        let start = Infinity
        let end = -Infinity
        let total = 0
        for (let item of layers) {
            start = Math.min(start, item[center] - item[extent] / 2)
            end = Math.max(end, item[center] + item[extent] / 2)
            total += item[extent]
        }
        if (distribute) {
            layers.sort(function(a, b) {
                return (a[center] - a[extent] / 2) - (b[center] - b[extent] / 2)
            })
            start = layers[0][center] - layers[0][extent] / 2
            end = layers[layers.length - 1][center] + layers[layers.length - 1][extent] / 2
        }
        const gap = (end - start - total) / (layers.length - 1)
        let position = start
        let changed = false
        editorPreview.beginCoalescedEdit()
        for (let i = 0; i < layers.length; ++i) {
            const item = layers[i]
            let target = (start + end) / 2
            if (distribute) {
                target = position + item[extent] / 2
                position += item[extent] + gap
                if (i === 0 || i === layers.length - 1) continue
            } else if (operation === "left" || operation === "top") target = start + item[extent] / 2
            else if (operation === "right" || operation === "bottom") target = end - item[extent] / 2
            const dx = horizontal ? target - item.cx : 0
            const dy = horizontal ? 0 : target - item.cy
            changed = editorPreview.setPhotoLayerTransform(item.index, Math.round(Number(item.layer.x || 0) + dx),
                Math.round(Number(item.layer.y || 0) + dy), Number(item.layer.scale || 1), Number(item.layer.rotation || 0)) || changed
        }
        editorPreview.endCoalescedEdit()
        return changed
    }

    function selectedPhotoLayerBatchMenuItems(activeLayerIndex, activeLayer) {
        const targets = root.selectedPhotoLayerBatchTargets(true, -1)
        const selectedCount = root.normalizedPhotoLayerSelection().length
        const hasBatch = targets.length > 0
        const activeLayerValid = activeLayerIndex >= 0 && activeLayerIndex < editorPreview.photoLayerCount
        return [
            {
                key: "ungroup-selected",
                label: "Ungroup selected group",
                icon: "layers",
                enabled: activeLayerValid && String(activeLayer.kind || "") === "group",
                disabledReason: "Select a group row first."
            },
            { key: "hide-selected", label: "Hide selected", icon: "hidden", enabled: hasBatch },
            { key: "show-selected", label: "Show selected", icon: "visible", enabled: hasBatch },
            { key: "lock-selected", label: "Lock selected", icon: "lock", enabled: hasBatch },
            { key: "unlock-selected", label: "Unlock selected", icon: "unlock", enabled: hasBatch },
            { key: "duplicate-selected", label: "Duplicate selected with masks", icon: "copy", enabled: hasBatch },
            { key: "duplicate-selected-without-masks", label: "Duplicate selected without masks", icon: "copy", enabled: hasBatch },
            {
                key: "match-active-opacity",
                label: "Match active opacity",
                icon: "adjust",
                enabled: hasBatch && activeLayerValid,
                tooltip: "Apply the active layer opacity to selected unlocked layers."
            },
            {
                key: "match-active-blend",
                label: "Match active blend mode",
                icon: "effects",
                enabled: hasBatch && activeLayerValid,
                tooltip: "Apply the active layer blend mode to selected unlocked layers."
            },
            {
                key: "paste-copied-adjustments",
                label: "Paste copied adjustments",
                icon: "insert",
                enabled: hasBatch && editorPreview.hasCopiedPhotoLayerAdjustments,
                tooltip: "Paste copied layer adjustments onto selected unlocked layers."
            },
            {
                key: "paste-global-adjustments",
                label: "Paste Base Image adjustments",
                icon: "media",
                enabled: hasBatch,
                tooltip: "Paste Base Image adjustments onto selected unlocked layers."
            },
            {
                key: "delete-selected",
                label: selectedCount > 1 ? "Delete selected layers" : "Delete active layer",
                icon: "delete",
                enabled: hasBatch,
                danger: true,
                tooltip: "Delete selected unlocked layers."
            }
        ]
    }

    function handleSelectedPhotoLayerBatchAction(key, activeLayerIndex, activeLayer) {
        const targets = root.selectedPhotoLayerBatchTargets(true, -1)
        if (targets.length === 0)
            return false
        const activeLayerValid = activeLayerIndex >= 0 && activeLayerIndex < editorPreview.photoLayerCount
        let changed = false
        const applyUnlocked = function(callback) {
            for (let index = 0; index < targets.length; ++index) {
                const layerIndex = targets[index]
                const layer = root.photoLayerRows[layerIndex] || ({})
                if (layer.locked === true)
                    continue
                changed = callback(layerIndex, layer) || changed
            }
        }
        if (key === "hide-selected") {
            applyUnlocked(function(layerIndex) { return editorPreview.setPhotoLayerEnabled(layerIndex, false) })
        } else if (key === "show-selected") {
            applyUnlocked(function(layerIndex) { return editorPreview.setPhotoLayerEnabled(layerIndex, true) })
        } else if (key === "lock-selected") {
            for (let index = 0; index < targets.length; ++index)
                changed = editorPreview.setPhotoLayerLocked(targets[index], true) || changed
        } else if (key === "unlock-selected") {
            for (let index = 0; index < targets.length; ++index)
                changed = editorPreview.setPhotoLayerLocked(targets[index], false) || changed
        } else if (key === "duplicate-selected") {
            const duplicateTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < duplicateTargets.length; ++index)
                changed = editorPreview.duplicatePhotoLayerWithMasks(duplicateTargets[index]) || changed
        } else if (key === "duplicate-selected-without-masks") {
            const duplicateTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < duplicateTargets.length; ++index)
                changed = editorPreview.duplicatePhotoLayerWithoutMasks(duplicateTargets[index]) || changed
        } else if (key === "match-active-opacity") {
            const opacity = Number(activeLayer && activeLayer.opacity !== undefined ? activeLayer.opacity : 1.0)
            applyUnlocked(function(layerIndex) { return editorPreview.setPhotoLayerOpacity(layerIndex, opacity) })
        } else if (key === "match-active-blend") {
            const blendMode = String(activeLayer && activeLayer.blendMode !== undefined ? activeLayer.blendMode : "normal")
            applyUnlocked(function(layerIndex) { return editorPreview.setPhotoLayerBlendMode(layerIndex, blendMode) })
        } else if (key === "paste-copied-adjustments") {
            applyUnlocked(function(layerIndex) { return editorPreview.pastePhotoLayerAdjustments(layerIndex) })
        } else if (key === "paste-global-adjustments") {
            applyUnlocked(function(layerIndex) { return editorPreview.pasteGlobalAdjustmentsToPhotoLayer(layerIndex) })
        } else if (key === "delete-selected") {
            const deleteTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < deleteTargets.length; ++index)
                changed = root.deletePhotoLayerTarget(deleteTargets[index]) || changed
            root.selectedPhotoLayerIndices = root.normalizedActivePhotoLayerIndex() >= 0
                    ? [root.normalizedActivePhotoLayerIndex()]
                    : []
        } else if (key === "ungroup-selected" && activeLayerValid) {
            changed = editorPreview.ungroupPhotoLayer(activeLayerIndex)
            if (changed)
                root.setActivePhotoLayerSelection(activeLayerIndex, false)
        }
        return changed
    }

    function setActivePhotoLayerSelection(index, extendSelection) {
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return false
        let selected = root.normalizedPhotoLayerSelection()
        if (extendSelection) {
            const existing = selected.indexOf(index)
            if (existing >= 0)
                selected.splice(existing, 1)
            else
                selected.push(index)
            if (selected.length === 0)
                selected.push(index)
        } else {
            selected = [index]
        }
        root.selectedPhotoLayerIndices = selected
        root.setSelectedEditTarget(root.selectedLayerTargetScope(index), index, ({}), -1)
        return true
    }

    function selectPhotoLayerWithModifiers(index, modifiers) {
        const layerIndex = Math.floor(Number(index))
        if (layerIndex < 0 || layerIndex >= editorPreview.photoLayerCount)
            return false
        const flags = Number(modifiers || 0)
        const extendRange = (flags & Qt.ShiftModifier) !== 0
        const toggle = (flags & Qt.ControlModifier) !== 0 ||
                       (flags & Qt.MetaModifier) !== 0
        if (extendRange) {
            const anchor = root.photoLayerSelectionAnchorIndex >= 0 &&
                           root.photoLayerSelectionAnchorIndex < editorPreview.photoLayerCount
                    ? root.photoLayerSelectionAnchorIndex
                    : root.normalizedActivePhotoLayerIndex()
            const first = Math.min(anchor, layerIndex)
            const last = Math.max(anchor, layerIndex)
            const next = toggle ? root.normalizedPhotoLayerSelection().slice() : []
            for (let candidate = first; candidate <= last; ++candidate) {
                if (next.indexOf(candidate) < 0)
                    next.push(candidate)
            }
            root.selectedPhotoLayerIndices = next
            root.setSelectedEditTarget(root.selectedLayerTargetScope(layerIndex), layerIndex, ({}), -1)
            return true
        }
        root.photoLayerSelectionAnchorIndex = layerIndex
        return root.setActivePhotoLayerSelection(layerIndex, toggle)
    }

    function beginInlinePhotoLayerRename(index) {
        const layerIndex = Math.floor(Number(index))
        if (layerIndex < 0 || layerIndex >= editorPreview.photoLayerCount)
            return false
        const layer = root.photoLayerRows[layerIndex] || ({})
        if (layer.locked === true)
            return false
        root.inlineRenamingPhotoLayerIndex = layerIndex
        root.inlinePhotoLayerRenameOriginal = String(layer.displayName || layer.name || "Layer")
        return true
    }

    function commitInlinePhotoLayerRename(index, name) {
        const layerIndex = Math.floor(Number(index))
        if (root.inlineRenamingPhotoLayerIndex !== layerIndex)
            return false
        const nextName = String(name || "").trim()
        root.inlineRenamingPhotoLayerIndex = -1
        root.inlinePhotoLayerRenameOriginal = ""
        if (nextName.length === 0)
            return false
        const layer = root.photoLayerRows[layerIndex] || ({})
        const currentName = String(layer.displayName || layer.name || "Layer").trim()
        return nextName === currentName || editorPreview.renamePhotoLayer(layerIndex, nextName)
    }

    function cancelInlinePhotoLayerRename(index) {
        if (root.inlineRenamingPhotoLayerIndex !== Math.floor(Number(index)))
            return false
        root.inlineRenamingPhotoLayerIndex = -1
        root.inlinePhotoLayerRenameOriginal = ""
        return true
    }

    function layerKeyboardNavigationSignature() {
        return "layer-keyboard-navigation:v3|arrows:nudge-in-layer-tools|up-down:select-otherwise|enter:edit|f2:rename|space:visibility|shift:range-select|modifier-up-down:reorder|escape:base-focus"
    }

    function handlePhotoLayerRowKey(event, layerIndex, layer) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return false
        if (root.handleLayerNudgePress(event)) return true
        const key = event.key
        const modifiers = event.modifiers || 0
	        const extendSelection = (modifiers & Qt.ShiftModifier) !== 0
	        const reorder = (modifiers & Qt.ControlModifier) !== 0 || (modifiers & Qt.MetaModifier) !== 0
	        if (key === Qt.Key_Return || key === Qt.Key_Enter) {
	            const selected = root.normalizedPhotoLayerSelection()
	            if (selected.length > 1 && selected.indexOf(index) >= 0) {
	                root.setSelectedEditTarget(root.selectedLayerTargetScope(index), index, ({}), -1)
	                if (root.photoLayerKind(index) === "adjustment")
	                    root.activateEditTool("adjust")
	                else {
	                    root.editTool = "layers"
	                    root.editInspectorTab = "layers"
	                }
	            } else {
	                root.editPhotoLayerInspectorTarget(index)
	            }
	            event.accepted = true
	            return true
	        }
        if (key === Qt.Key_F2) {
            root.beginInlinePhotoLayerRename(index)
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Space) {
            editorPreview.setPhotoLayerEnabled(index, !(layer && layer.enabled !== false))
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Up || key === Qt.Key_Down) {
            const offset = key === Qt.Key_Up ? -1 : 1
	            if (reorder) {
	                root.movePhotoLayerPreservingSelection(index, offset)
            } else {
                const nextIndex = Math.max(0, Math.min(editorPreview.photoLayerCount - 1, index + offset))
                root.setActivePhotoLayerSelection(nextIndex, extendSelection)
            }
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Escape) {
            root.forceActiveFocus()
            event.accepted = true
            return true
        }
        return false
    }

    function currentPhotoLayerData() {
        const index = root.normalizedActivePhotoLayerIndex()
        if (index < 0)
            return ({})
        return root.photoLayerRows[index] || ({})
    }

    function activeAdjustmentLayerIndex() {
        if (root.selectedEditTargetScope() === "base-image" || root.baseImageTargetActive)
            return -1
        const selectedIndex = root.selectedEditTargetLayerIndex()
        if (selectedIndex < 0 && String(root.selectedEditTarget.layerId || "").length > 0)
            return -1
        const index = selectedIndex >= 0 ? selectedIndex : root.normalizedActivePhotoLayerIndex()
        if (index < 0)
            return -1
        const layer = root.photoLayerRows[index] || ({})
        const kind = String(layer.kind || "").trim().toLowerCase()
        return ["adjustment", "pixel", "source"].indexOf(kind) >= 0 ? index : -1
    }

    function activeAdjustmentLayerData() {
        const index = root.activeAdjustmentLayerIndex()
        return index >= 0 ? (root.photoLayerRows[index] || ({})) : ({})
    }

    function primaryAdjustmentLayerIndex() {
        const selectedLayerIndex = root.activeAdjustmentLayerIndex()
        if (selectedLayerIndex >= 0)
            return selectedLayerIndex
        if (root.selectedEditTargetScope() === "mask" || root.activeEditTargetScope() === "mask")
            return root.activeMaskAdjustmentLayerIndex()
        return -1
    }

    function photoLayerKind(index) {
        if (index < 0 || index >= editorPreview.photoLayerCount)
            return ""
        const layer = root.photoLayerRows[index] || ({})
        return String(layer.kind || "").trim().toLowerCase()
    }

    function editTargetCanShowMask() {
        return editorPreview.hasActiveMask &&
               editorPreview.activeMaskToolRole !== "retouch" &&
               (root.editTool === "masks" || root.editTool === "brush")
    }

    function activeEditTargetLayerIndex() {
        if (root.selectedEditTargetScope() === "base-image" || root.baseImageTargetActive)
            return -1
        const selectedLayerIndex = root.selectedEditTargetLayerIndex()
        if (selectedLayerIndex >= 0)
            return selectedLayerIndex
        if (String(root.selectedEditTarget.layerId || "").length > 0)
            return -1
        const maskLayerIndex = root.activeMaskAdjustmentLayerIndex()
        if (root.editTargetCanShowMask() && maskLayerIndex >= 0)
            return maskLayerIndex
        if (root.editInspectorTab === "layers")
            return root.normalizedActivePhotoLayerIndex()
        if (root.editInspectorTab === "adjust")
            return root.activeAdjustmentLayerIndex()
        return -1
    }

    function activeEditTargetLayerData() {
        const index = root.activeEditTargetLayerIndex()
        return index >= 0 ? (root.photoLayerRows[index] || ({})) : ({})
    }

    function activeMaskSetData() {
        const selectedMaskId = root.selectedEditTargetMaskSetId()
        const selectedMaskName = String(root.selectedEditTarget.maskSetName || "").trim()
        if (root.selectedEditTargetScope() === "mask") {
            const maskSets = root.maskSetRows
            for (let index = 0; index < maskSets.length; ++index) {
                const maskSet = maskSets[index] || ({})
                if ((selectedMaskId.length > 0 && String(maskSet.id || "").trim() === selectedMaskId) ||
                        (selectedMaskId.length === 0 && selectedMaskName.length > 0 && String(maskSet.name || "").trim() === selectedMaskName))
                    return maskSet
            }
        }
        if (!editorPreview.hasActiveMask)
            return ({})
        const maskSets = root.maskSetRows
        for (let index = 0; index < maskSets.length; ++index) {
            const maskSet = maskSets[index] || ({})
            if (root.maskSetActive(maskSet))
                return maskSet
        }
        return ({})
    }

    function activeEditTargetThumbnailData() {
        const scope = root.activeEditTargetScope()
        if (scope === "mask")
            return root.activeMaskSetData()
        if (scope === "adjustment-layer" || scope === "photo-layer")
            return root.activeEditTargetLayerData()
        return ({})
    }

    function activeEditTargetMaskActive() {
        const maskLayerIndex = root.activeMaskAdjustmentLayerIndex()
        return root.editTargetCanShowMask() &&
               maskLayerIndex >= 0 &&
               maskLayerIndex === root.activeEditTargetLayerIndex()
    }

    function activeEditTargetScope() {
        const selectedScope = root.selectedEditTargetScope()
        if (selectedScope === "base-image")
            return "base-image"
        if (selectedScope === "mask" && editorPreview.hasActiveMask)
            return "mask"
        if (root.activeEditTargetMaskActive())
            return "mask"
        if (selectedScope === "adjustment-layer" || selectedScope === "photo-layer") {
            const selectedIndex = root.selectedEditTargetLayerIndex()
            if (selectedIndex >= 0) {
                const selectedLayer = root.photoLayerRows[selectedIndex] || ({})
                return String(selectedLayer.kind || "").trim().toLowerCase() === "adjustment"
                        ? "adjustment-layer"
                        : "photo-layer"
            }
        }
        const layerIndex = root.activeEditTargetLayerIndex()
        if (layerIndex < 0)
            return "base-image"
        const layer = root.photoLayerRows[layerIndex] || ({})
        return String(layer.kind || "").trim().toLowerCase() === "adjustment"
                ? "adjustment-layer"
                : "photo-layer"
    }

    function activeEditTargetPrimaryName() {
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return "Base Image"
        const layer = root.activeEditTargetLayerData()
        return String(layer.displayName || layer.name || "Layer")
    }

    function activeEditTargetMaskName() {
        if (!editorPreview.hasActiveMask)
            return ""
        return String(editorPreview.activeMaskName || editorPreview.activeMaskSetName || "Selection")
    }

    function activeEditTargetBreadcrumbText() {
        if (root.maskTargetInspectorActive())
            return root.activeEditTargetPrimaryName() + " / " + root.activeEditTargetMaskName()
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return "Base Image"
        const layerName = root.activeEditTargetPrimaryName()
        if (scope === "mask")
            return layerName + " / " + root.activeEditTargetMaskName()
        return layerName
    }

    function editDocumentBreadcrumbText() {
        if (!root.editBoardMode)
            return ""
        const board = root.activeEditBoard
