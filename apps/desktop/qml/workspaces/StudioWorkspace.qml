    function aspectRatioText(width, height) {
        let w = Math.round(Number(width || 0))
        let h = Math.round(Number(height || 0))
        if (w <= 0 || h <= 0)
            return ""
        while (h !== 0) {
            const next = w % h
            w = h
            h = next
        }
        const divisor = Math.max(1, w)
        return Math.round(width / divisor) + ":" + Math.round(height / divisor)
    }

    function displayImageSource(offset) {
        const base = catalogAssets.selectedIndex >= 0 ? catalogAssets.selectedIndex : 0
        if (offset < 0) {
            if (root.editorPreviewController.displayReferencePreviewSource.length > 0)
                return root.editorPreviewController.displayReferencePreviewSource
            if (root.editorPreviewController.referencePreviewSource.length > 0)
                return root.editorPreviewController.referencePreviewSource
            return assetThumb(base)
        }
        if (offset === 0 && root.editorPreviewController.displayPreviewSource.length > 0)
            return root.editorPreviewController.displayPreviewSource
        return assetThumb(clamp(base + offset, 0, Math.max(0, assetCount() - 1)))
    }

    function resolvedCompareSource() {
        const mode = root.editorPreviewController.compareSourceMode
        if ((mode === "snapshot" || mode === "auto") && root.compareSnapshotIndex() >= 0)
            return "snapshot"
        if ((mode === "external" || mode === "auto") && root.editorPreviewController.hasReferenceImage)
            return "external"
        return "original"
    }

    function comparePanelTitle(index) {
        if (root.editorPreviewController.renderingUpgradePreviewActive)
            return index === 0
                   ? "Current · " + root.renderingModelLabel(root.editorPreviewController.currentPhotographicRenderingModel)
                   : "Updated · " + root.renderingModelLabel(root.editorPreviewController.renderingUpgradeTargetModel)
        if (index === 1)
            return "After · Current edit"
        if (root.resolvedCompareSource() === "snapshot")
            return "Before · Snapshot: " + (root.editorPreviewController.compareSnapshotName.length > 0
                                             ? root.editorPreviewController.compareSnapshotName
                                             : "Unavailable")
        if (root.resolvedCompareSource() === "external")
            return "Reference · " + root.editorPreviewController.referenceImageName
        if (root.editorPreviewController.compareAdjustmentGroups.length > 0) {
            const labels = { tone: "Tone", color: "Color", detail: "Detail", masks: "Selections" }
            return "Before · " + root.editorPreviewController.compareAdjustmentGroups.map(function(group) {
                return labels[group] || group
            }).join(", ") + " bypassed"
        }
        return "Before · Original"
    }

    function compareSnapshotIndex() {
        for (let index = 0; index < root.editorPreviewController.editHistorySnapshots.length; ++index) {
            if (String(root.editorPreviewController.editHistorySnapshots[index].id || "") === root.editorPreviewController.compareSnapshotId)
                return index
        }
        return -1
    }

    function selectCompareSnapshot(index) {
        if (index < 0 || index >= root.editorPreviewController.editHistorySnapshots.length)
            return false
        root.editorPreviewController.compareSnapshotId = String(root.editorPreviewController.editHistorySnapshots[index].id || "")
        root.editorPreviewController.compareSourceMode = "snapshot"
        return root.editorPreviewController.compareSnapshotId.length > 0
    }

    function setOriginalHold(active) {
        const next = active === true
        if (root.originalHoldActive === next || !root.editorPreviewController.hasAsset)
            return false
        if (next) {
            root.originalHoldPreviousSourceMode = String(root.editorPreviewController.compareSourceMode || "auto")
            root.originalHoldOwnedCompareMode = !root.editorPreviewController.compareMode
            root.editorPreviewController.compareSourceMode = "original"
            root.editorPreviewController.compareMode = true
            root.originalHoldActive = true
            return true
        }
        root.originalHoldActive = false
        if (root.originalHoldOwnedCompareMode)
            root.editorPreviewController.compareMode = false
        root.editorPreviewController.compareSourceMode = root.originalHoldPreviousSourceMode
        root.originalHoldOwnedCompareMode = false
        return true
    }

    function sectionComparisonActive(scope) {
        const index = root.activeAdjustmentLayerIndex()
        const layerId = index >= 0 ? String(root.editorPreviewController.photoLayers[index].id || "") : ""
        return root.editorPreviewController.sectionComparisonScope === scope && root.editorPreviewController.sectionComparisonLayerId === layerId
    }

    function toggleSectionComparison(scope) {
        if (sectionComparisonActive(scope))
            root.editorPreviewController.clearSectionComparison()
        else
            root.editorPreviewController.setSectionComparison(scope, root.activeAdjustmentLayerIndex())
    }

    function holdSectionComparison(scope, held) {
        if (held)
            root.editorPreviewController.beginSectionComparisonHold(scope, root.activeAdjustmentLayerIndex())
        else
            root.editorPreviewController.endSectionComparisonHold()
    }

    function holdCompareEditGroup(groupKey, held) {
        const normalizedGroup = String(groupKey || "").trim()
        if (held) {
            if (root.compareEditGroupHoldActive || normalizedGroup.length === 0)
                return false
            root.compareEditGroupHoldPreviousGroups = root.editorPreviewController.compareAdjustmentGroups.slice(0)
            root.compareEditGroupHoldActive = true
            root.editorPreviewController.compareAdjustmentGroups = [normalizedGroup]
            return true
        }
        if (!root.compareEditGroupHoldActive)
            return false
        const previousGroups = root.compareEditGroupHoldPreviousGroups.slice(0)
        root.compareEditGroupHoldPreviousGroups = []
        root.compareEditGroupHoldActive = false
        root.editorPreviewController.compareAdjustmentGroups = previousGroups
        return true
    }

