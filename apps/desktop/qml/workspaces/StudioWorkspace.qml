    }

    function pixelExactToolReady() {
        return root.pixelBrushToolReady() || root.pixelSelectToolReady()
    }

    function studioAiMaskKind(kindName) {
        const kind = String(kindName || "").trim().toLowerCase()
        return kind === "subject" || kind === "sky" || kind === "background" ||
               kind === "people" || kind === "face" || kind === "hair" ||
               kind === "clothing" || kind === "object"
    }

    function studioMaskSupportsSelectionRefine() {
        if (!root.editorPreviewController.hasActiveMask ||
                root.editorPreviewController.activeMaskToolRole !== "selection")
            return false
        const kind = String(root.editorPreviewController.activeMaskKind || "").trim().toLowerCase()
        return kind === "linear" || kind === "radial" || kind === "ellipse" ||
               kind === "rectangle" || kind === "brush" ||
               kind === "polygon" || kind === "lasso" || kind === "alpha" ||
               kind === "luminance" || kind === "color" || kind === "depth" ||
               root.studioAiMaskKind(kind)
    }

    function beginStudioSelectionRefinement(pageName) {
        if (!root.studioMaskSupportsSelectionRefine() ||
                (pageName !== "view" && String(root.editorPreviewController.activeMaskEditDisabledReason || "").length > 0))
            return false
        if (!root.beginMaskSelectionSession())
            return false
        root.editTool = "masks"
        root.editInspectorTab = "adjust"
        root.editorPreviewController.compareMode = false
        root.editorPreviewController.cropEditing = false
        root.editorPreviewController.maskPreviewMode = "outline"
        if (!root.maskRefinementSessionActive) {
            root.maskRefinementSessionActive = true
            root.maskRefinementPage = "paint"
            root.maskRefinementDetailPage = false
        }
        root.maskRefinementPage = pageName
        root.maskRefinementDetailPage = false
        return true
    }

    function startStudioSelectionRefine(subtract, edgeAware) {
        if (!root.beginStudioSelectionRefinement("paint"))
            return false
        root.editTool = "brush"
        root.selectionAdvancedRefinementExpanded = false
        const current = root.activeMaskData()
        const operation = subtract ? "subtract" : "add"
        root.maskCreationOperation = operation
        const useEdgeAware = edgeAware !== false
        const matchingBrush = useEdgeAware ? current.brushRefineMode === true
                                          : current.kind === "brush" && current.brushPreset === "Selection Brush"
        if (matchingBrush && root.editorPreviewController.activeMaskOperation === operation)
            return true
        if (!useEdgeAware)
            root.editorPreviewController.startSelectionBrush(subtract)
        else if (root.studioAiMaskKind(root.editorPreviewController.activeMaskKind))
            root.editorPreviewController.startAIMaskRefineBrush(subtract)
        else
            root.editorPreviewController.startSelectionEdgeBrush(subtract)
        return true
    }

    function setStudioSelectionEdgeValue(key, value) {
        if (!root.beginMaskSelectionSession()) return false
        root.editorPreviewController.maskRefinementPreviewMode = "refined"
        root.editorPreviewController.maskPreviewMode = "overlay"
        return root.editorPreviewController.setSelectionEdgeAdjustment(key, value)
    }

    function resetStudioSelectionEdge() {
        if (!root.studioMaskSupportsSelectionRefine())
            return false
        return root.setStudioSelectionEdgeValue("reset", 0)
    }

    function cancelStudioSelectionRefine() {
        if (root.editorPreviewController.selectionEditSessionActive)
            return root.editorPreviewController.cancelSelectionEditSession()
        if (!root.maskRefinementSessionActive)
            return false
        root.maskRefinementSessionActive = false
        root.maskShapeEditTransactionActive = false
        const canceled = root.editorPreviewController.cancelCoalescedEdit()
        root.finishSelectionWorkflow()
        return canceled
    }

