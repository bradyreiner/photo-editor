        if (root.objectPickArmed && root.editorPreviewController.smartSelectPreviewActive) {
            const outcome = root.editorPreviewController.acceptSmartSelectPreview(root.objectPickMode, root.objectPickCreateNew)
            if (outcome === "error") return false
