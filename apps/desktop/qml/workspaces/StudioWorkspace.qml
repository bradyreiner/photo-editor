        onActivated: editGuideState.guidesVisible = !editGuideState.guidesVisible
    }
    Settings {
        id: studioWorkspaceSettings
        category: "StudioWorkspace-" + (root.inspectorOnly ? "timeline-color" : String(root.page || "default"))
        property string panelLayoutJson: ""
        property string savedLayoutsJson: ""
        property alias snapLayers: root.layerSnappingEnabled
        property alias safeMargins: root.layerSafeMarginsEnabled
    }
    Settings {
        id: libraryCullSettings
        category: "LibraryCull"
        property string resumeByShootJson: ""
    }
    property var libraryCullResumeByShoot: ({})
    property bool libraryCullResumeLoaded: false
    property string libraryCullResumeAssetId: ""
    property string libraryCullPreviousMediaFilter: ""
    Timer {
        id: libraryCullResumeSaveTimer
        interval: 500
        repeat: false
        onTriggered: {
            if (!root.libraryCullResumeLoaded)
                return
            libraryCullSettings.resumeByShootJson = JSON.stringify(root.libraryCullResumeByShoot)
        }
    }

    property bool workspaceSettingsReady: false
    Timer {
        id: workspaceSettingsSaveTimer
        interval: 120
        repeat: false
        onTriggered: {
            if (!root.workspaceSettingsReady)
                return
            studioWorkspaceSettings.panelLayoutJson = JSON.stringify({
                librarySourcesPanelVisible: root.librarySourcesPanelVisible,
                libraryInspectorPanelVisible: root.libraryInspectorPanelVisible,
                libraryInspectorPreviewExpanded: root.libraryInspectorPreviewExpanded,
                editSidebarCollapsed: root.editSidebarCollapsed,
                editFilmstripCollapsed: root.editFilmstripCollapsed,
                editContextPanelVisible: root.editContextPanelVisible,
                editInspectorPanelVisible: root.editInspectorPanelVisible,
                editCreativeToolsVisible: root.editCreativeToolsVisible,
                editCreativeToolsFloating: root.editCreativeToolsFloating,
                editCreativeToolsHeight: root.editCreativeToolsHeight,
                scopeDockVisible: root.scopeDockVisible,
                exportPresetsPanelVisible: root.exportPresetsPanelVisible,
                exportSettingsPanelVisible: root.exportSettingsPanelVisible,
                focusEditLayoutEnabled: root.focusEditLayoutEnabled
            })
            studioWorkspaceSettings.savedLayoutsJson = JSON.stringify(root.savedWorkspaceLayouts)
        }
    }

    function scheduleWorkspaceSettingsSave() {
        if (workspaceSettingsReady)
            workspaceSettingsSaveTimer.restart()
    }

    Component.onCompleted: Qt.callLater(function() {
        let saved = null
        try {
            saved = JSON.parse(String(studioWorkspaceSettings.panelLayoutJson || ""))
        } catch (error) {
            saved = null
        }
        if (saved && typeof saved === "object") {
            root.librarySourcesPanelVisible = saved.librarySourcesPanelVisible !== false
            root.libraryInspectorPanelVisible = saved.libraryInspectorPanelVisible !== false
            root.libraryInspectorPreviewExpanded = saved.libraryInspectorPreviewExpanded !== false
            root.editSidebarCollapsed = saved.editSidebarCollapsed === true
            root.editFilmstripCollapsed = saved.editFilmstripCollapsed === true
            root.editContextPanelVisible = saved.editContextPanelVisible !== false
            root.editInspectorPanelVisible = saved.editInspectorPanelVisible !== false
            root.editCreativeToolsVisible = saved.editCreativeToolsVisible !== false
            root.editCreativeToolsFloating = saved.editCreativeToolsFloating === true
            root.editCreativeToolsHeight = root.clamp(Number(saved.editCreativeToolsHeight || 440), 200, 800)
            if (saved.scopeDockVisible !== undefined)
                root.scopeDockVisible = saved.scopeDockVisible === true
            root.exportPresetsPanelVisible = saved.exportPresetsPanelVisible !== false
            root.exportSettingsPanelVisible = saved.exportSettingsPanelVisible !== false
            root.focusEditLayoutEnabled = saved.focusEditLayoutEnabled === true
            // Display density is an application preference. Older workspace
            // settings may still contain interfaceMode; leave it to the global
            // preference migration in appShell.
        }
        try {
            const layouts = JSON.parse(String(studioWorkspaceSettings.savedLayoutsJson || ""))
            if (Array.isArray(layouts)) {
                const namedLayouts = layouts.filter(function(layout) {
                    return layout && typeof layout === "object" &&
                           typeof layout.name === "string" && layout.name.trim().length > 0
                }).slice(0, 12)
                if (namedLayouts.length > 0)
                    root.savedWorkspaceLayouts = namedLayouts
            }
        } catch (error) {
            // Keep the built-in layouts when a stored value cannot be read.
        }
        root.workspaceSettingsReady = true
    })

    Connections {
        target: root
        function onLibrarySourcesPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onLibraryInspectorPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onLibraryInspectorPreviewExpandedChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditSidebarCollapsedChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditFilmstripCollapsedChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditContextPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditInspectorPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditCreativeToolsVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditCreativeToolsFloatingChanged() { root.scheduleWorkspaceSettingsSave() }
        function onEditCreativeToolsHeightChanged() { root.scheduleWorkspaceSettingsSave() }
        function onScopeDockVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onExportPresetsPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onExportSettingsPanelVisibleChanged() { root.scheduleWorkspaceSettingsSave() }
        function onFocusEditLayoutEnabledChanged() { root.scheduleWorkspaceSettingsSave() }
        function onSavedWorkspaceLayoutsChanged() { root.scheduleWorkspaceSettingsSave() }
    }
    Connections {
        target: root
        function onSelectedEditTargetChanged() {
            const preview = root.editorPreviewController.cutoutPreview || ({})
            if (String(preview.layerId || "").length && String(preview.layerId) !== root.photoLayerIdentityAt(root.selectedEditTargetLayerIndex()))
                root.editorPreviewController.dismissCutoutPreview()
        }
        function onEditToolChanged() {
            if (root.editTool !== "layers" && typeof root.editorPreviewController.dismissCutoutPreview === "function")
                root.editorPreviewController.dismissCutoutPreview()
        }
    }
    ThumbnailStateUtils { id: thumbnailStateUtils }
    PhotoLayerSnapshot { id: photoLayerSnapshot; controller: root.editorPreviewController }
    readonly property var photoLayerRows: photoLayerSnapshot.rows
    readonly property var maskSetRows: root.editorPreviewController.maskSetCount > 0
                                       ? root.editorPreviewController.maskSetSnapshot() : []
    property int photoLayerHierarchyDropTargetIndex: -1
    property int photoLayerReorderDropTargetIndex: -1
    property bool photoLayerReorderDropAfter: false
    property string editActionFeedback: ""
    property var undoEditHandler: null
    property bool historyShortcutsHandledByHost: false
    property var resetEditHandler: null
    property var redoEditHandler: null
    property bool canUndoEdit: root.editorPreviewController.smartDocumentEditState.active ? false : root.textEditSessionActive ? root.canUndoTextSession(false) : root.editorPreviewController.canUndo
    property bool canRedoEdit: root.editorPreviewController.smartDocumentEditState.active ? false : root.textEditSessionActive ? root.canUndoTextSession(true) : root.editorPreviewController.canRedo
    property string undoEditLabel: root.editorPreviewController.undoLabel
    property string redoEditLabel: root.editorPreviewController.redoLabel

    function undoEdit() {
        if (root.textEditSessionActive) { root.undoTextSession(false); return }
        if (!root.canUndoEdit) return
        root.cancelEditHistoryHoverPreview()
        if (root.undoEditHandler) root.undoEditHandler()
        else root.editorPreviewController.undo()
    }

    function redoEdit() {
        if (root.textEditSessionActive) { root.undoTextSession(true); return }
        if (!root.canRedoEdit) return
        root.cancelEditHistoryHoverPreview()
        if (root.redoEditHandler) root.redoEditHandler()
        else root.editorPreviewController.redo()
    }
    property bool editActionFeedbackError: false
    property var recentlyPastedLayerIds: []
    Timer {
        id: editActionFeedbackTimer
        interval: 3200
        onTriggered: root.editActionFeedback = ""
    }
    Timer {
        id: pastedLayerHighlightTimer
        interval: 1400
        onTriggered: root.recentlyPastedLayerIds = []
    }
    function showEditActionFeedback(message, failure) {
        root.editActionFeedbackError = failure === true
        root.editActionFeedback = message
        editActionFeedbackTimer.restart()
    }

    readonly property bool componentWorkspaceActive: !root.inspectorOnly && root.page === "edit" &&
        typeof componentWorkspace !== "undefined" && !!componentWorkspace && componentWorkspace.active === true

    function openPhotoComponentWorkspace(layerIndex) {
        const index = Math.floor(Number(layerIndex))
        const layer = index >= 0 && index < root.photoLayerRows.length ? root.photoLayerRows[index] : null
        if (root.page !== "edit" || !layer || root.professionalLayerLocked(layer) ||
                typeof componentWorkspace === "undefined" || !componentWorkspace)
            return false
        const controller = root.editorPreviewController
        if (controller.professionalToolsBusy || controller.photoPaintBusy || controller.brushStrokeActive ||
                controller.selectionEditSessionActive || controller.smartSelectPreviewActive ||
                root.componentWorkspaceHasPendingCanvasDraft) {
            root.showEditActionFeedback(qsTr("Finish or cancel the active canvas draft before opening component contents."), true)
            return false
        }
        if (!root.componentWorkspaceCanvasHandlesReady()) {
            root.showEditActionFeedback(qsTr("Canvas tools are still loading. Try again shortly."), false)
            return false
        }
        const penControls = root.photoPenControlsHandle
        const shapeOverlay = root.photoShapeCreationOverlayHandle
        if (!root.resolveTextSession())
            return false
        const penPath = JSON.parse(JSON.stringify(root.penPathDocument || ({
            schema: "photo-vector-path", version: 1, coordinateSpace: "normalized", subpaths: []
        })))
        const savedUiState = {
            controller: controller,
            editTool: root.editTool,
            editInspectorTab: root.editInspectorTab,
            editInspectorPanelVisible: root.editInspectorPanelVisible,
            photoLayerDetailsExpanded: root.photoLayerDetailsExpanded,
            selectedEditTarget: Object.assign({}, root.selectedEditTarget),
            selectedPhotoLayerIndices: root.selectedPhotoLayerIndices.slice(0),
            activePhotoLayerIndex: root.activePhotoLayerIndex,
            selectedMaskSetIndex: root.selectedMaskSetIndex,
            penAssetId: root.penAssetId,
            penLayerId: root.penLayerId,
            penTargetKind: root.penTargetKind,
            penPathDocument: penPath,
            penControls: {
                fillColor: penControls.fillColor,
                strokeColor: penControls.strokeColor,
                strokeWidth: penControls.strokeWidth,
                outputMode: penControls.outputMode
            },
            shapeControls: {
                shapeType: shapeOverlay.shapeType,
                fillColor: shapeOverlay.fillColor,
                strokeColor: shapeOverlay.strokeColor,
                strokeWidth: shapeOverlay.strokeWidth
            }
        }
        root.componentWorkspaceUiStateStack = root.componentWorkspaceUiStateStack.concat([savedUiState])
        root.cancelEditHistoryHoverPreview()
        root.clearStudioPresetPreview()
        root.resetComponentWorkspaceTransientUiState(controller)
        root.selectedEditTarget = {
            scope: "base-image", layerIndex: -1, layerId: "", maskSetId: "",
            maskSetName: "", sourceIndex: -1, componentId: ""
        }
        root.selectedPhotoLayerIndices = []
        root.activePhotoLayerIndex = -1
        root.selectedMaskSetIndex = -1
        if (componentWorkspace.open(index))
            return true
        root.componentWorkspaceUiStateStack = root.componentWorkspaceUiStateStack.slice(0, -1)
        root.restoreComponentWorkspaceUiState(savedUiState)
        return false
    }

    function restoreComponentWorkspaceUiState(savedUiState) {
        if (!savedUiState || !savedUiState.controller || savedUiState.controller !== root.editorPreviewController)
            return false
        root.selectedEditTarget = Object.assign({}, savedUiState.selectedEditTarget || ({
            scope: "base-image", layerIndex: -1, layerId: "", maskSetId: "",
            maskSetName: "", sourceIndex: -1, componentId: ""
        }))
        root.selectedPhotoLayerIndices = (savedUiState.selectedPhotoLayerIndices || []).slice(0)
        root.activePhotoLayerIndex = Number(savedUiState.activePhotoLayerIndex !== undefined
                                            ? savedUiState.activePhotoLayerIndex : -1)
        root.selectedMaskSetIndex = Number(savedUiState.selectedMaskSetIndex !== undefined
                                            ? savedUiState.selectedMaskSetIndex : -1)
        root.penAssetId = String(savedUiState.penAssetId || "")
        root.penLayerId = String(savedUiState.penLayerId || "")
        root.penTargetKind = String(savedUiState.penTargetKind || "layer")
        root.penPathDocument = JSON.parse(JSON.stringify(savedUiState.penPathDocument || ({
            schema: "photo-vector-path", version: 1, coordinateSpace: "normalized", subpaths: []
        })))
        const penControls = savedUiState.penControls || ({})
        const penControlsView = root.photoPenControlsHandle
        if (penControlsView) {
            penControlsView.fillColor = String(penControls.fillColor || "#4a78ff")
            penControlsView.strokeColor = String(penControls.strokeColor || "#ffffff")
            penControlsView.strokeWidth = Number(penControls.strokeWidth !== undefined ? penControls.strokeWidth : 2)
            penControlsView.outputMode = String(penControls.outputMode || "layer")
        }
        const shapeControls = savedUiState.shapeControls || ({})
        const shapeOverlay = root.photoShapeCreationOverlayHandle
        if (shapeOverlay) {
            shapeOverlay.shapeType = String(shapeControls.shapeType || "rectangle")
            shapeOverlay.fillColor = String(shapeControls.fillColor || "#4a78ff")
            shapeOverlay.strokeColor = String(shapeControls.strokeColor || "#ffffff")
            shapeOverlay.strokeWidth = Number(shapeControls.strokeWidth !== undefined ? shapeControls.strokeWidth : 4)
        }
        root.editInspectorPanelVisible = savedUiState.editInspectorPanelVisible !== false
        root.editInspectorTab = String(savedUiState.editInspectorTab || "layers")
        root.editTool = String(savedUiState.editTool || "layers")
        root.photoLayerDetailsExpanded = savedUiState.photoLayerDetailsExpanded === true
        return true
    }

    function resetComponentWorkspaceTransientUiState(nextController) {
        const targetController = nextController || root.editorPreviewController
        const textOverlay = root.photoTextOverlayHandle
        const paintOverlay = root.photoPaintOverlayHandle
        const textCreationOverlay = root.photoTextCreationOverlayHandle
        const shapeOverlay = root.photoShapeCreationOverlayHandle
        const penOverlay = root.photoPenOverlayHandle
        const penControls = root.photoPenControlsHandle
        const layerPicker = root.photoLayerCanvasPickerHandle
        const transformOverlay = root.photoLayerTransformOverlayHandle
        if (root.photoLayerStyleOverlayHandle) root.photoLayerStyleOverlayHandle.cancelInteraction()
        if (root.photoTextDimensionOverlayHandle) root.photoTextDimensionOverlayHandle.cancelInteraction()
        root.photoTextDimensionCanvasMode = ""
        root.photoTextDimensionCanvasTargetMode = "dimension"
        root.photoStyleCanvasLayerId = ""
        root.photoStyleCanvasStyleId = ""
        root.photoStyleCanvasAssetId = ""
        root.componentWorkspaceControllerSwitching = true

        // These overlay controllers remain attached to the outgoing document
        // until their QML drafts have been discarded. This keeps a child Cancel
        // from sending a stale finish/cancel callback to the restored parent.
        if (textOverlay && textOverlay.editing)
            textOverlay.finish(false)
        if (textOverlay) {
            textOverlay.pathHandlesActive = false
            textOverlay.pathHandleDragActive = false
            textOverlay.draggedPathPoint = -1
        }
        if (paintOverlay && paintOverlay.drawing)
            paintOverlay.finish(false)
        if (paintOverlay)
            paintOverlay.tabletDrawing = false
        if (textCreationOverlay) {
            textCreationOverlay.dragging = false
            textCreationOverlay.startPoint = Qt.point(0, 0)
            textCreationOverlay.endPoint = Qt.point(0, 0)
        }
        if (shapeOverlay) {
            shapeOverlay.dragging = false
            shapeOverlay.startPoint = Qt.point(0, 0)
            shapeOverlay.endPoint = Qt.point(0, 0)
        }

        if (penOverlay) {
            if (penOverlay.transactionOpen)
                penOverlay.cancelPath()
            penOverlay.commitPending = false
            penOverlay.transactionOpen = false
            penOverlay.transactionStart = null
            penOverlay.commitError = ""
            penOverlay.dragMode = ""
            penOverlay.selectedSubpathId = ""
            penOverlay.selectedAnchorId = ""
        }
        root.penAssetId = ""
        root.penLayerId = ""
        root.penTargetKind = "layer"
        root.penPathDocument = ({schema: "photo-vector-path", version: 1,
                                 coordinateSpace: "normalized", subpaths: []})
        if (penControls) {
            penControls.fillColor = "#4a78ff"
            penControls.strokeColor = "#ffffff"
            penControls.strokeWidth = 2
            penControls.outputMode = "layer"
        }
        if (shapeOverlay) {
            shapeOverlay.shapeType = "rectangle"
            shapeOverlay.fillColor = "#4a78ff"
            shapeOverlay.strokeColor = "#ffffff"
            shapeOverlay.strokeWidth = 4
        }

        if (layerPicker)
            layerPicker.movingSelection = false
        if (transformOverlay) {
            transformOverlay.interactionActive = false
            transformOverlay.snapGuideX = Number.NaN
            transformOverlay.snapGuideY = Number.NaN
            transformOverlay.snapGuideLabel = ""
        }
        root.maskRefinementSessionActive = false
        root.maskShapeEditTransactionActive = false
        root.maskSessionUiBaseline = ({})
        root.pendingSelectionAction = ""
        root.objectPickArmed = false
        root.objectPickBoxMode = false
        root.objectPickCreateNew = false
        root.objectPickMode = "selection"
        root.cloneSourcePickArmed = false
        root.polygonDrawArmed = false
        root.lassoDrawArmed = false
        root.spacePanActive = false

        root.componentWorkspaceOverlayController = targetController
        root.componentWorkspaceControllerSwitching = false
    }

    function restoreParentEditorStateAfterControllerSwitch() {
        const stack = root.componentWorkspaceUiStateStack || []
        if (stack.length === 0)
            return false
        const savedUiState = stack[stack.length - 1]
        if (!root.restoreComponentWorkspaceUiState(savedUiState))
            return false
        root.componentWorkspaceUiStateStack = stack.slice(0, -1)
        return true
    }

    function handleComponentWorkspaceControllerSwitch() {
        const stack = root.componentWorkspaceUiStateStack || []
        if (stack.length === 0)
            return false
        const savedUiState = stack[stack.length - 1]
        const targetController = root.editorPreviewController
        if (root.componentWorkspaceActive && componentWorkspace.busy)
            return false

        if (targetController === savedUiState.controller) {
            if (root.componentWorkspaceRoutedController === targetController)
                return false
            root.resetComponentWorkspaceTransientUiState(targetController)
            root.componentWorkspaceRoutedController = targetController
            return root.restoreParentEditorStateAfterControllerSwitch()
        }

        if (root.componentWorkspaceActive) {
            if (root.componentWorkspaceRoutedController &&
                    root.componentWorkspaceRoutedController !== targetController)
                root.resetComponentWorkspaceTransientUiState(targetController)
            else if (root.componentWorkspaceOverlayController !== targetController)
                root.resetComponentWorkspaceTransientUiState(targetController)
            root.componentWorkspaceRoutedController = targetController
            root.cancelEditHistoryHoverPreview()
            root.clearStudioPresetPreview()
            root.selectedEditTarget = {
                scope: "base-image", layerIndex: -1, layerId: "", maskSetId: "",
                maskSetName: "", sourceIndex: -1, componentId: ""
            }
            root.selectedPhotoLayerIndices = []
            root.activePhotoLayerIndex = -1
            root.selectedMaskSetIndex = -1
            root.focusComponentLayerTarget()
            return true
        }

        if (root.componentWorkspaceRoutedController &&
                root.componentWorkspaceRoutedController !== targetController)
            root.resetComponentWorkspaceTransientUiState(targetController)
        root.componentWorkspaceRoutedController = null
        return root.restoreParentEditorStateAfterControllerSwitch()
    }

    function focusComponentLayerTarget() {
        if (!root.componentWorkspaceActive || root.editorPreviewController.photoLayerCount <= 0)
            return false
        root.editInspectorPanelVisible = true
        root.editTool = "layers"
        root.editInspectorTab = "layers"
        let fallbackIndex = -1
        for (let index = 0; index < root.photoLayerRows.length; ++index) {
            const layer = root.photoLayerRows[index] || ({})
            if (layer.baseImageEdit === true)
                continue
            if (fallbackIndex < 0)
                fallbackIndex = index
            if (layer.locked !== true) {
                fallbackIndex = index
                break
            }
        }
        if (fallbackIndex < 0)
            return false
        return root.setActivePhotoLayerSelection(fallbackIndex, false)
    }

    onComponentWorkspaceActiveChanged: {
        if (!root.componentWorkspaceActive) {
            Qt.callLater(root.handleComponentWorkspaceControllerSwitch)
            return
        }
        if (agentRunDialogLoader.item && agentRunDialogLoader.item.visible)
            agentRunDialogLoader.item.close()
        root.editInspectorPanelVisible = true
        root.editTool = "layers"
        root.editInspectorTab = "layers"
        Qt.callLater(root.focusComponentLayerTarget)
    }
    onEditorControllerOverrideChanged: {
        if (root.photoTextDimensionOverlayHandle)
            root.photoTextDimensionOverlayHandle.cancelInteraction()
        Qt.callLater(root.handleComponentWorkspaceControllerSwitch)
    }

    property var catalogAssets: null
    property var editorControllerOverride: null
    property var componentWorkspaceUiStateStack: []
    property var componentWorkspaceRoutedController: null
    property var componentWorkspaceOverlayController: editorPreview
    property bool componentWorkspaceControllerSwitching: false
    readonly property var editorPreviewController: editorControllerOverride || editorPreview
    readonly property var studioTheme: theme
    readonly property var agentEditController: typeof agentEdit !== "undefined" ? agentEdit : null
    readonly property var agentSessionController: typeof agentSession !== "undefined" ? agentSession : null
    readonly property bool hasAgentEditController: agentEditController !== null && agentEditController !== undefined

    Connections {
        target: root.agentSessionController
        enabled: root.agentSessionController !== null && root.workspaceActive && !root.componentWorkspaceActive
        function onExecutionRequested(snapshot) {
            if (root.componentWorkspaceActive)
                return
            if (String(root.agentSessionController.stage || "") !== "executing")
                return
            root.agentTargetAssetIds = (snapshot.targetIds || []).slice(0)
            root.agentPrompt = String(snapshot.prompt || "")
            root.agentScopeMode = String((snapshot.context || ({})).scope || root.agentScopeMode)
            root.agentResultVisible = false
            root.agentApplyInProgress = true
            if (root.agentTargetAssetIds.length > 0) {
                const targetId = String(root.agentTargetAssetIds[0])
                const selectedIds = catalogAssets ? (catalogAssets.selectedAssetIds || []) : []
                if (catalogAssets && selectedIds.indexOf(targetId) < 0)
                    catalogAssets.selectAssetById(targetId, true)
                const targetAlreadyOpen = root.page === "edit" &&
                        String(root.editorPreviewController.assetId || "") === targetId
                if (!targetAlreadyOpen)
                    root.assetActivated("edit")
            } else if (root.page !== "edit") {
                root.assetActivated("edit")
            }
        }
        function onPreparedTargetResolved(assetId) {
            if (root.componentWorkspaceActive)
                return
            root.agentTargetAssetIds = [String(assetId)]
            if (catalogAssets)
                catalogAssets.selectAssetById(String(assetId), true)
            root.assetActivated("edit")
        }
    }
    readonly property var visualSearchController: typeof visualSearch !== "undefined" ? visualSearch : null
    readonly property var similaritySearchBinding: typeof similaritySearch !== "undefined" ? similaritySearch : null
    readonly property var similaritySearchController: similaritySearchBinding ? similaritySearchBinding.controller : null
    property bool useSimilaritySearch: true
    readonly property var searchModelSetupController: typeof searchModelSetup !== "undefined" ? searchModelSetup : null
    readonly property var activeVisualSearchController: useSimilaritySearch ? similaritySearchController : visualSearchController
    readonly property var searchEditWorkflow: typeof searchEdit !== "undefined" ? searchEdit : null

    SearchEditDialog {
        id: searchEditDialog
        anchors.centerIn: parent
        workflow: root.searchEditWorkflow
        modelConfig: root.visualSearchModel()
    }
    LibrarySearchCoordinator {
        id: librarySearch
        catalog: root.catalogAssets
        similarity: root.similaritySearchBinding
        setup: root.searchModelSetupController
        active: root.page === "library" && root.workspaceActive && !root.importModeOpen && !root.libraryDocumentsOpen
    }
    Connections {
        target: root.searchEditWorkflow
        enabled: !root.componentWorkspaceActive
        function onChanged() {
            if (root.page === "library" && root.searchEditWorkflow.phase === "searching" && !searchEditDialog.visible)
                searchEditDialog.open()
