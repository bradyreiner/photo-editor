    function clamp(value, low, high) {
        return Math.max(low, Math.min(high, value))
    }

    function thumbnailScreenDevicePixelRatio() {
        return Math.max(1.0, Number(Screen.devicePixelRatio || 1.0))
    }

    function thumbnailSourceSizeForDisplay(displayPixels, backingPixels) {
        return Math.max(0, Math.max(Number(backingPixels || 0),
                                   Math.round(Math.max(1, Number(displayPixels || 1)) *
                                              root.thumbnailScreenDevicePixelRatio())))
    }

    function libraryGalleryAspectKey(index, thumbnailSource, knownAssetId) {
        const asset = knownAssetId ? ({ assetId: knownAssetId }) : root.assetAt(index)
        const assetId = String(asset.assetId || "")
        if (assetId.length > 0)
            return assetId
        const source = String(thumbnailSource || asset.thumbnailSource || "")
        return source.length > 0 ? source : String(index)
    }

    function libraryGalleryAspectRatio(index, thumbnailSource, knownAssetId) {
        const revision = root.libraryGalleryAspectRevision
        const key = root.libraryGalleryAspectKey(index, thumbnailSource, knownAssetId)
        const ratio = Number(root.libraryGalleryAspectRatios[key] || 0)
        if (revision >= 0 && ratio > 0)
            return root.clamp(ratio, 0.28, 4.5)
        return 1.5
    }

    function setLibraryGalleryAspectRatio(index, thumbnailSource, sourceWidth, sourceHeight, knownAssetId) {
        const width = Number(sourceWidth || 0)
        const height = Number(sourceHeight || 0)
        if (width <= 0 || height <= 0)
            return

        const key = root.libraryGalleryAspectKey(index, thumbnailSource, knownAssetId)
        const nextRatio = root.clamp(width / height, 0.28, 4.5)
        const currentRatio = root.libraryGalleryAspectRatio(index, thumbnailSource, knownAssetId)
        // Cached and regenerated thumbnails can round either dimension by a
        // pixel. That is not a new aspect ratio and must not rebuild the rows.
        const roundingTolerance = (1 + currentRatio) / height
        if (Math.abs(currentRatio - nextRatio) <= Math.max(0.001, roundingTolerance))
            return

        const ratios = {}
        for (const existingKey in root.libraryGalleryAspectRatios)
            ratios[existingKey] = root.libraryGalleryAspectRatios[existingKey]
        ratios[key] = nextRatio
        root.libraryGalleryAspectRatios = ratios
        root.libraryGalleryAspectRevision += 1
    }

    function libraryGalleryViewportWidth(viewWidth, scrollbarGutter) {
        const width = Math.max(1, Math.floor(Number(viewWidth || 0)))
        const gutter = Math.max(0, Math.ceil(Number(scrollbarGutter || root.libraryGalleryScrollbarGutter)))
        return Math.max(1, width - gutter)
    }

    function libraryGalleryRows(viewWidth) {
        const revision = root.libraryGalleryAspectRevision
        const assets = catalogAssets ? catalogAssets.galleryAssets() : []
        const count = assets.length
        const width = Math.max(1, Math.floor(Number(viewWidth || 0)))
        if (revision < 0 || count <= 0 || width <= 1)
            return []

        const idealHeight = root.libraryToolbarTight ? 184 : 214
        const rows = []
        let row = []
        let rowAspect = 0
        let rowTop = 0

        function flushRow(justified) {
            if (row.length === 0)
                return

            const rowJustified = justified === true
            const height = rowJustified
                           ? Math.max(92, Math.round(width / Math.max(0.1, rowAspect)))
                           : idealHeight
            const items = []
            let consumed = 0
            for (let position = 0; position < row.length; ++position) {
                const entry = row[position]
                const isLast = position === row.length - 1
                const naturalWidth = Math.max(1, Math.round(height * entry.aspect))
                const remainingWidth = Math.max(1, width - consumed)
                const itemWidth = rowJustified && isLast ? remainingWidth
                                                         : Math.min(naturalWidth, remainingWidth)
                consumed += itemWidth
                items.push({
                    index: entry.index,
                    assetId: entry.assetId,
                    thumbnailSource: entry.thumbnailSource,
                    mediaType: entry.mediaType,
                    durationText: entry.durationText,
                    rating: entry.rating,
                    picked: entry.picked,
                    rejected: entry.rejected,
                    width: itemWidth
                })
            }

            rows.push({ top: rowTop, height: height, width: consumed, justified: rowJustified, items: items })
            rowTop += height
            row = []
            rowAspect = 0
        }

        for (let index = 0; index < count; ++index) {
            const asset = assets[index]
            const thumbnailSource = String(asset.thumbnailSource || "")
            const aspect = root.libraryGalleryAspectRatio(index, thumbnailSource, String(asset.assetId || ""))
            row.push({
                index: index,
                assetId: String(asset.assetId || ""),
                thumbnailSource: thumbnailSource,
                mediaType: String(asset.mediaType || "photo"),
                durationText: String(asset.durationText || ""),
                rating: Math.max(0, Math.min(5, Number(asset.rating || 0))),
                picked: Boolean(asset.picked),
                rejected: Boolean(asset.rejected),
                aspect: aspect
            })
            rowAspect += aspect
            if (row.length > 0 && rowAspect * idealHeight >= width)
                flushRow(true)
        }
        flushRow(false)

        return rows
    }

    function libraryGalleryLayoutSignature(viewWidth, scrollbarGutter) {
        const rawWidth = Math.max(1, Math.floor(Number(viewWidth || 0)))
        const gutter = Math.max(0, Math.ceil(Number(scrollbarGutter || root.libraryGalleryScrollbarGutter)))
        const viewportWidth = root.libraryGalleryViewportWidth(rawWidth, gutter)
        const rows = root.libraryGalleryRows(viewportWidth)
        let maxRowWidth = 0
        let lastRowHeight = 0
        let lastRowJustified = false
        for (let rowIndex = 0; rowIndex < rows.length; ++rowIndex) {
            const items = rows[rowIndex].items || []
            let rowWidth = 0
            for (let itemIndex = 0; itemIndex < items.length; ++itemIndex)
                rowWidth += Math.max(0, Number(items[itemIndex].width || 0))
            maxRowWidth = Math.max(maxRowWidth, rowWidth)
            if (rowIndex === rows.length - 1) {
                lastRowHeight = Math.round(Number(rows[rowIndex].height || 0))
                lastRowJustified = rows[rowIndex].justified === true
            }
        }
        return "library-gallery-layout:v1|raw:" + rawWidth +
               "|gutter:" + gutter +
               "|viewport:" + viewportWidth +
               "|rows:" + rows.length +
               "|max-row:" + maxRowWidth +
               "|last-height:" + lastRowHeight +
               "|last-justified:" + String(lastRowJustified) +
               "|overflow:" + String(maxRowWidth > viewportWidth)
    }

    function clearTransientMaskTools() {
        if (root.editorPreviewController.brushStrokeActive)
            root.editorPreviewController.endActiveBrushStroke()
        root.endMaskShapeEditTransaction()
        if (root.maskRefinementSessionActive) {
            root.maskRefinementSessionActive = false
            if (!root.editorPreviewController.selectionEditSessionActive)
                root.editorPreviewController.endCoalescedEdit()
        }
        objectPickArmed = false
        objectPickBoxMode = false
        objectPickCreateNew = false
        objectPickMode = "selection"
        root.cancelCloneSourcePick()
        polygonDrawArmed = false
        lassoDrawArmed = false
        spacePanActive = false
        root.editorPreviewController.clearSmartSelectPreview()
    }

    function toggleCloneSourcePick() {
        if (root.cloneSourcePickArmed)
            return root.cancelCloneSourcePick()
        if (!root.cloneSourcePickAvailable())
            return false
        root.cloneSourcePickArmed = true
        return true
    }

    function cloneSourcePickAvailable() {
        return root.page === "edit" && root.workspaceActive && root.visible &&
               root.editTool === "retouch" && root.editorPreviewController.hasActiveMask &&
               root.editorPreviewController.activeMaskToolRole === "retouch" &&
               root.editorPreviewController.activeMaskRetouchMode === "clone" &&
               !root.editorPreviewController.activeMaskCommitted && !root.editorPreviewController.activeMaskLocked &&
               !root.editorPreviewController.inpaintProgressActive && !root.editorPreviewController.compareMode
    }

    function cancelCloneSourcePick() {
        const wasArmed = root.cloneSourcePickArmed
        root.cloneSourcePickArmed = false
        return wasArmed
    }

    function completeCloneSourcePick(normalizedX, normalizedY) {
        if (!root.cloneSourcePickArmed || !root.cloneSourcePickAvailable()) {
            root.cancelCloneSourcePick()
            return false
        }
        root.editorPreviewController.setActiveMaskCloneSource(normalizedX, normalizedY)
        root.cancelCloneSourcePick()
        return true
    }

    function beginMaskShapeEditTransaction() {
        if (root.maskShapeEditTransactionActive)
            return
        if (!root.beginMaskSelectionSession())
            return
        root.editorPreviewController.beginCoalescedEdit()
        root.maskShapeEditTransactionActive = true
    }

    function endMaskShapeEditTransaction() {
        if (!root.maskShapeEditTransactionActive)
            return
        root.maskShapeEditTransactionActive = false
        root.editorPreviewController.endCoalescedEdit()
    }

    function manualSelectionSubtractActive() {
        return root.maskCreationOperation === "subtract" ||
               root.objectPickMode === "selection-subtract"
    }

    function maskOperationForModifierState(modifierState) {
        const modifiers = Number(modifierState || 0)
        const shiftHeld = (modifiers & Qt.ShiftModifier) !== 0
        const optionHeld = (modifiers & Qt.AltModifier) !== 0
        if (shiftHeld && optionHeld)
            return "intersect"
        if (optionHeld)
            return "subtract"
        if (shiftHeld)
            return "add"
        return root.maskCreationOperation
    }

    function applyMaskOperationForModifierState(modifierState, updateActiveSource) {
        const operation = root.maskOperationForModifierState(modifierState)
        root.maskCreationOperation = operation
        return operation
    }

    function objectPickModeForModifierState(modifierState) {
        const operation = root.maskOperationForModifierState(modifierState)
        return operation === "subtract" ? "selection-subtract"
             : operation === "intersect" ? "selection-intersect" : "selection"
    }

    function applyObjectPickModeForModifierState(modifierState) {
        if (root.objectPickMode === "remove")
            return root.objectPickMode
        root.objectPickMode = root.objectPickModeForModifierState(modifierState)
        return root.objectPickMode
    }

    function maskSpacePanShortcutActive() {
        return page === "edit" &&
               root.editorPreviewController.hasAsset &&
               !root.editorPreviewController.compareMode &&
               (root.brushToolReady() ||
                root.lassoDrawArmed ||
                root.activeLassoShortcutReady() ||
                root.polygonDrawArmed ||
                root.activePolygonShortcutReady() ||
                root.objectPickArmed)
    }

    function handleMaskPickOutcome(outcome) {
        if (outcome === "selection-ai" || outcome === "remove-ai") {
            root.clearTransientMaskTools()
            root.editTool = "masks"
            root.editInspectorTab = "adjust"
        }
    }

    function pixelValueText(sample) {
        if (!sample || sample.valid !== true)
            return "--"
        return sample.hex + "  " + sample.red + " " + sample.green + " " + sample.blue
    }

    function pixelDeltaText(inspector) {
        if (!inspector || inspector.hasBefore !== true || inspector.hasAfter !== true)
            return "Before unavailable"
        const r = inspector.deltaRed > 0 ? "+" + inspector.deltaRed : "" + inspector.deltaRed
        const g = inspector.deltaGreen > 0 ? "+" + inspector.deltaGreen : "" + inspector.deltaGreen
        const b = inspector.deltaBlue > 0 ? "+" + inspector.deltaBlue : "" + inspector.deltaBlue
        const luma = inspector.deltaLuminance > 0
            ? "+" + inspector.deltaLuminance.toFixed(3)
            : inspector.deltaLuminance.toFixed(3)
        return "Delta " + r + " " + g + " " + b + "  Y " + luma
    }

    function previewFailureStageLabel(stage) {
        if (String(stage || "").trim() === "layer_source")
            return "Linked image source"
        const normalized = String(stage || "").replace(/_/g, " ").trim()
        if (normalized.length === 0)
            return ""
        return normalized.charAt(0).toUpperCase() + normalized.slice(1)
    }

    function thumbnailFailureStageLabel(stage) {
        const label = previewFailureStageLabel(stage)
        return label.length > 0 ? label : "Thumbnail"
    }

    function thumbnailStateSignature(data) {
        return thumbnailStateUtils.thumbnailStateSignature(data)
    }

    function thumbnailDisplayState(data) {
        return thumbnailStateUtils.thumbnailDisplayState(data)
    }

    function thumbnailStatusLabel(data, fallbackText) {
        return thumbnailStateUtils.thumbnailStatusLabel(data, fallbackText)
    }

    function thumbnailRetryActionSignature(data, rowKind) {
        return thumbnailStateUtils.thumbnailRetryActionSignature(data, rowKind)
    }

    function thumbnailRefreshQueued(data) {
        return thumbnailStateUtils.thumbnailRefreshQueued(data)
    }

    function thumbnailQueueSignature(data) {
        return thumbnailStateUtils.thumbnailQueueSignature(data)
    }

    function maskAlphaProviderSummary(data) {
        const provider = String(data && data.mask_alpha_provider !== undefined
                                ? data.mask_alpha_provider : "").trim()
        if (provider.length === 0)
            return "Selection preview unavailable"
        const full = Boolean(data && data.mask_alpha_full_resolution_available === true)
        const deterministic = Boolean(data && data.mask_alpha_deterministic === true)
        const width = Math.max(0, Number(data && data.mask_alpha_target_width !== undefined
                                         ? data.mask_alpha_target_width : 0))
        const height = Math.max(0, Number(data && data.mask_alpha_target_height !== undefined
                                          ? data.mask_alpha_target_height : 0))
        const target = width > 0 && height > 0 ? " / " + Math.round(width) + "x" + Math.round(height) : ""
        return "Selection preview / " + (full ? "detailed" : "preview")
                + " / " + (deterministic ? "stable" : "live")
                + target
    }

    function maskSourceProvenanceSummary(data) {
        const brushContract = String(data && data.brushAlphaSourceContract !== undefined
                                     ? data.brushAlphaSourceContract : "").trim()
        if (brushContract.length > 0) {
            const strokes = Math.max(0, Number(data && data.brushAlphaStrokeCount !== undefined
                                               ? data.brushAlphaStrokeCount : 0))
            const points = Math.max(0, Number(data && data.brushAlphaPointCount !== undefined
                                              ? data.brushAlphaPointCount : 0))
            return "Brush selection / " + Math.round(strokes) + " strokes / "
                    + Math.round(points) + " points"
        }

        const shapeContract = String(data && data.shapeAlphaSourceContract !== undefined
                                     ? data.shapeAlphaSourceContract : "").trim()
        if (shapeContract.length > 0) {
            const points = Math.max(0, Number(data && data.shapeAlphaPointCount !== undefined
                                              ? data.shapeAlphaPointCount : 0))
            const rawPoints = Math.max(0, Number(data && data.shapeAlphaRawPointCount !== undefined
                                                 ? data.shapeAlphaRawPointCount : 0))
            const lassoState = root.lassoPathStateText(data)
            const pointText = rawPoints > 0
                    ? Math.round(points) + " points / " + Math.round(rawPoints) + " drawn"
                    : Math.round(points) + " points"
            return "Path selection / " +
                    (lassoState.length > 0 ? lassoState + " / " : "") +
                    pointText + " / "
                    + (Boolean(data && data.shapeAlphaClosed === true) ? "closed" : "open")
        }

        const generatedContract = String(data && data.generatedAlphaSourceContract !== undefined
                                         ? data.generatedAlphaSourceContract : "").trim()
        if (generatedContract.length > 0) {
            const target = String(data && data.generatedAlphaTargetType !== undefined
                                  ? data.generatedAlphaTargetType : "generated").trim()
            const width = Math.max(0, Number(data && data.generatedAlphaWidth !== undefined
                                             ? data.generatedAlphaWidth : 0))
            const height = Math.max(0, Number(data && data.generatedAlphaHeight !== undefined
                                              ? data.generatedAlphaHeight : 0))
            const size = width > 0 && height > 0
                    ? " / " + Math.round(width) + "x" + Math.round(height)
                    : ""
            return "Smart selection / " + target + size
        }

        return maskAlphaProviderSummary(data)
    }

    function selectionRowFallbackStatus(data, relationText) {
        const relation = String(relationText || "").trim()
        const source = root.maskSourceProvenanceSummary(data)
        return source + (relation.length > 0 ? " / " + relation : "")
    }

    function previewRenderPresentationSignature(processing, statusText, failureStage, failureDetail) {
        const status = String(statusText || "").toLowerCase()
        const stage = String(failureStage || "").trim()
        const detail = String(failureDetail || "").trim()
        const failed = stage.length > 0 || detail.length > 0
                || status.indexOf("fail") >= 0
                || status.indexOf("error") >= 0
                || status.indexOf("unavailable") >= 0
                || status.indexOf("unable") >= 0
        const updating = Boolean(processing) && !failed
        const state = failed ? "failed" : (updating ? "updating" : "ready")
        return state
                + "|blocking:false"
                + "|stale:" + String(updating)
                + "|retry:" + String(failed)
                + (failed && stage.length > 0 ? "|stage:" + stage : "")
                + (failed && detail.length > 0 ? "|detail:true" : "")
    }

    function previewRenderFailed() {
        return previewRenderPresentationSignature(
                    root.editorPreviewController.processing,
                    root.editorPreviewController.status,
                    root.editorPreviewController.previewFailureStage,
                    root.editorPreviewController.previewFailureDetail).indexOf("failed") === 0
    }

    function previewFailurePresentationSource(statusText, failureStage, failureDetail) {
        const stage = String(failureStage || "").trim()
        const detail = String(failureDetail || "").trim()
        if (stage.length > 0 || detail.length > 0)
            return "render_failure_state"
        const status = String(statusText || "").toLowerCase()
        if (status.indexOf("fail") >= 0 ||
                status.indexOf("error") >= 0 ||
                status.indexOf("unavailable") >= 0 ||
                status.indexOf("unable") >= 0)
            return "status_classifier"
        return "unknown"
    }

    function qmlPreviewFailureLoggingAvailable() {
        return typeof qmlPerformance !== "undefined" &&
               qmlPerformance !== null &&
               qmlPerformance.previewFailurePresented !== undefined
    }

    function logPreviewFailurePresented(trigger) {
        const presentation = previewRenderPresentationSignature(
                    root.editorPreviewController.processing,
                    root.editorPreviewController.status,
                    root.editorPreviewController.previewFailureStage,
                    root.editorPreviewController.previewFailureDetail)
        if (presentation.indexOf("failed") !== 0) {
            root.previewFailurePresentedLogSignature = ""
            return
        }
        const source = previewFailurePresentationSource(
                    root.editorPreviewController.status,
                    root.editorPreviewController.previewFailureStage,
                    root.editorPreviewController.previewFailureDetail)
        const signature = presentation +
                "|status:" + String(root.editorPreviewController.status || "") +
                "|source:" + source +
                "|trigger:" + String(trigger || "unknown")
        if (signature === root.previewFailurePresentedLogSignature)
            return
        root.previewFailurePresentedLogSignature = signature
        if (!root.qmlPreviewFailureLoggingAvailable())
            return
        qmlPerformance.previewFailurePresented(
                    root.page,
                    root.editorPreviewController.status,
                    root.editorPreviewController.previewFailureStage,
                    root.editorPreviewController.previewFailureDetail,
                    presentation,
                    root.editorPreviewController.processing,
                    source)
    }

    function activePreviewFailureStage() {
        if (!previewRenderFailed())
            return ""
        return String(root.editorPreviewController.previewFailureStage || "").trim()
    }

    function previewFailureIdListContains(idList, id) {
        const needle = String(id || "").trim()
        if (needle.length === 0 || !idList || idList.length === undefined)
            return false
        for (let index = 0; index < idList.length; ++index) {
            if (String(idList[index] || "").trim() === needle)
                return true
        }
        return false
    }

    function previewFailureHasAffectedIds() {
        return (root.editorPreviewController.previewFailureLayerIds &&
                root.editorPreviewController.previewFailureLayerIds.length > 0) ||
               (root.editorPreviewController.previewFailureMaskSetIds &&
                root.editorPreviewController.previewFailureMaskSetIds.length > 0)
    }

    function maskSetId(maskSet) {
        return String(maskSet && maskSet.id !== undefined ? maskSet.id : "").trim()
    }

    function previewFailureRowLabel(stage) {
        const label = previewFailureStageLabel(stage)
        return label.length > 0 ? "Preview failed: " + label : ""
    }

    function previewFailureRowPresentationSignature(rowKind, rowActive, statusText, failureStage, failureDetail) {
        const presentation = previewRenderPresentationSignature(
                    false,
                    statusText,
                    failureStage,
                    failureDetail)
        const stage = String(failureStage || "").trim()
        const failed = Boolean(rowActive) &&
                presentation.indexOf("failed") === 0 &&
                stage.length > 0
        return "row:" + String(rowKind || "unknown") +
                "|failed:" + String(failed) +
                "|stage:" + (failed ? stage : "") +
                "|label:" + String(failed && previewFailureRowLabel(stage).length > 0)
    }

    function photoLayerPreviewFailureStage(layerIndex) {
        const stage = activePreviewFailureStage()
        if (stage.length === 0)
            return ""
        const normalizedLayerIndex = Math.floor(Number(layerIndex))
        if (normalizedLayerIndex < 0 || normalizedLayerIndex >= root.editorPreviewController.photoLayerCount)
            return ""
        const layer = root.photoLayerRows[normalizedLayerIndex] || ({})
        let checkedAffectedIds = false
        let matchedAffectedIds = false
        if (root.editorPreviewController.previewFailureLayerIds &&
                root.editorPreviewController.previewFailureLayerIds.length > 0) {
            checkedAffectedIds = true
            matchedAffectedIds = matchedAffectedIds ||
                    root.previewFailureIdListContains(
                        root.editorPreviewController.previewFailureLayerIds,
                        String(layer.id || ""))
        }
        if (root.editorPreviewController.previewFailureMaskSetIds &&
                root.editorPreviewController.previewFailureMaskSetIds.length > 0) {
            checkedAffectedIds = true
            const layerMaskSetIds = root.photoLayerMaskSetIds(layer)
            for (let index = 0; index < layerMaskSetIds.length; ++index) {
                matchedAffectedIds = matchedAffectedIds ||
                        root.previewFailureIdListContains(
                            root.editorPreviewController.previewFailureMaskSetIds,
                            layerMaskSetIds[index])
            }
            const linkedMaskSets = root.maskSetsForAdjustmentLayer(normalizedLayerIndex)
            for (let index = 0; index < linkedMaskSets.length; ++index) {
                matchedAffectedIds = matchedAffectedIds ||
                        root.previewFailureIdListContains(
                            root.editorPreviewController.previewFailureMaskSetIds,
                            root.maskSetId(linkedMaskSets[index]))
            }
        }
        if (checkedAffectedIds)
            return matchedAffectedIds ? stage : ""
        if (normalizedLayerIndex === root.activeEditTargetLayerIndex() ||
                root.photoLayerSelected(normalizedLayerIndex) ||
                root.photoLayerHasSelectedMask(normalizedLayerIndex))
            return stage
        return ""
    }

    function photoLayerPreviewFailureSignature(layerIndex) {
        const stage = photoLayerPreviewFailureStage(layerIndex)
        const rowActive = stage.length > 0
        return previewFailureRowPresentationSignature(
                    "layer",
                    rowActive,
                    root.editorPreviewController.status,
                    stage,
                    root.editorPreviewController.previewFailureDetail) +
                "|active-target:" + String(Math.floor(Number(layerIndex)) === root.activeEditTargetLayerIndex()) +
                "|selected:" + String(root.photoLayerSelected(layerIndex)) +
                "|mask-selected:" + String(root.photoLayerHasSelectedMask(layerIndex)) +
                "|affected-ids:" + String(root.previewFailureHasAffectedIds()) +
                "|affected-layer-ids:" + String(root.editorPreviewController.previewFailureLayerIds || []) +
                "|affected-mask-set-ids:" + String(root.editorPreviewController.previewFailureMaskSetIds || [])
    }

    function maskSetPreviewFailureStage(maskSet) {
        const stage = activePreviewFailureStage()
        if (stage.length === 0)
            return ""
        let checkedAffectedIds = false
        let matchedAffectedIds = false
        if (root.editorPreviewController.previewFailureMaskSetIds &&
                root.editorPreviewController.previewFailureMaskSetIds.length > 0) {
            checkedAffectedIds = true
            matchedAffectedIds = matchedAffectedIds ||
                    root.previewFailureIdListContains(
                        root.editorPreviewController.previewFailureMaskSetIds,
                        root.maskSetId(maskSet))
        }
        if (root.editorPreviewController.previewFailureLayerIds &&
                root.editorPreviewController.previewFailureLayerIds.length > 0) {
            checkedAffectedIds = true
            const linkedLayerIndex = root.adjustmentLayerIndexForMaskSet(maskSet)
            const layer = linkedLayerIndex >= 0
                    ? (root.photoLayerRows[linkedLayerIndex] || ({}))
                    : ({})
            matchedAffectedIds = matchedAffectedIds ||
                    root.previewFailureIdListContains(
                        root.editorPreviewController.previewFailureLayerIds,
                        String(layer.id || ""))
        }
        if (checkedAffectedIds)
            return matchedAffectedIds ? stage : ""
        if (!root.maskSetActive(maskSet))
            return ""
        return stage
    }

    function maskSetPreviewFailureSignature(maskSet) {
        const stage = maskSetPreviewFailureStage(maskSet)
        return previewFailureRowPresentationSignature(
                    "mask",
                    stage.length > 0,
                    root.editorPreviewController.status,
                    stage,
                    root.editorPreviewController.previewFailureDetail) +
                "|active-mask:" + String(root.maskSetActive(maskSet)) +
                "|affected-ids:" + String(root.previewFailureHasAffectedIds()) +
                "|affected-layer-ids:" + String(root.editorPreviewController.previewFailureLayerIds || []) +
                "|affected-mask-set-ids:" + String(root.editorPreviewController.previewFailureMaskSetIds || [])
    }

    function previewRenderChromeSignature(processing, statusText, failureStage, failureDetail) {
        const presentation = previewRenderPresentationSignature(
                    processing,
                    statusText,
                    failureStage,
                    failureDetail)
        const failed = presentation.indexOf("failed") === 0
        return presentation
                + "|chrome:global-status-bar"
                + "|center:false"
                + "|retryButton:" + String(failed)
    }

    function previewUpdateBadgeText() {
        if (previewRenderFailed()) {
            const stage = previewFailureStageLabel(root.editorPreviewController.previewFailureStage)
            return stage.length > 0 ? "Preview failed: " + stage : "Preview failed"
        }
        if (root.editorPreviewController.processing) {
            if (root.editorPreviewController.displayPreviewNativeFullResolution)
                return "Full resolution held • refining"
            return "Draft preview • refining"
        }
        return root.editorPreviewController.displayPreviewNativeFullResolution
               ? "Full resolution preview"
               : "Preview ready"
    }

    function maskWorkChromeSignature() {
        return "maskWork:" + String(root.maskWorkActive) +
                "|chromeReduced:" + String(root.activeCanvasToolChromeReduced) +
                "|diagnosticsPanel:" + String(root.diagnosticsPanelOpen && !root.maskWorkActive)
    }

    function maskActivityPresentationSignature(processing, statusText, smartPreviewActive, toolName) {
        const status = String(statusText || "").toLowerCase()
        const tool = String(toolName || "").toLowerCase()
        const maskTool = tool === "masks" || tool === "brush" || tool === "retouch"
        let phase = "idle"
        if (root.editorPreviewController.inpaintProgressActive)
            phase = "inpainting"
        else if (Boolean(smartPreviewActive) || status.indexOf("smart select") >= 0 || status.indexOf("smart selection") >= 0)
            phase = "analyzing"
        else if (Boolean(processing) && (status.indexOf("inpaint") >= 0 || status.indexOf("retouch") >= 0))
            phase = "inpainting"
        else if (Boolean(processing) && (maskTool || status.indexOf("mask") >= 0 || status.indexOf("selection") >= 0))
            phase = "rasterizing"
        const visible = phase !== "idle"
        const progressSuffix = root.editorPreviewController.inpaintProgressActive
                ? "|progress:" + Math.max(0, Math.min(1, Number(root.editorPreviewController.inpaintProgressValue || 0))).toFixed(3)
                  + "|label:" + String(root.editorPreviewController.inpaintProgressLabel || "")
                : ""
        return phase + "|visible:" + String(visible) +
                "|blocking:false|chip:persistent|progress-animation:viewport-spinner|smart:indeterminate|retouch:determinate" +
                progressSuffix
    }

    function maskActivityProgressValue() {
        if (root.editorPreviewController.inpaintProgressActive)
            return Math.max(0, Math.min(1, Number(root.editorPreviewController.inpaintProgressValue || 0)))
        return -1
    }

    function maskActivityChipVisible() {
        return maskActivityPresentationSignature(
                    root.editorPreviewController.processing,
                    root.editorPreviewController.status,
                    root.editorPreviewController.smartSelectPreviewActive,
                    root.editTool).indexOf("visible:true") >= 0
    }

    function maskActivityChipText() {
        const signature = maskActivityPresentationSignature(
                    root.editorPreviewController.processing,
                    root.editorPreviewController.status,
                    root.editorPreviewController.smartSelectPreviewActive,
                    root.editTool)
        if (signature.indexOf("analyzing") === 0)
            return "Analyzing selection"
        if (signature.indexOf("inpainting") === 0)
            return root.editorPreviewController.inpaintProgressActive
                    ? String(root.editorPreviewController.inpaintProgressLabel || "Inpainting retouch") + " · "
                      + Math.round(Math.max(0, Math.min(1, Number(root.editorPreviewController.inpaintProgressValue || 0))) * 100) + "%"
                    : "Inpainting retouch"
        if (signature.indexOf("rasterizing") === 0)
            return "Rasterizing masks"
        return "Mask activity"
    }

    function layerMaskJobChipVisible(rowIsActive) {
        return Boolean(rowIsActive) && root.maskActivityChipVisible()
    }

