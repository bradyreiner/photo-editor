               "|scale:" + Number(root.editorPreviewController.activeMaskCloneScale).toFixed(2) +
               "|rotation:" + Math.round(root.editorPreviewController.activeMaskCloneRotation).toString() +
               "|mode:" + (root.editorPreviewController.activeMaskCloneAligned ? "aligned" : "non-aligned")
    }

    function retouchCloneSourcePanelSignature() {
        const sources = root.editorPreviewController.activeMaskCloneSources || []
        const first = sources.length > 0 ? String(sources[0].name || "Source 1") : "none"
        return "visible:" + String(root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskRetouchMode === "clone") +
               "|count:" + String(root.editorPreviewController.activeMaskCloneSourceCount) +
               "|index:" + String(root.editorPreviewController.activeMaskCloneSourceIndex) +
               "|first:" + first
    }

    function retouchPatchSourceSignature() {
        return "visible:" + String(root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskRetouchMode === "patch") +
               "|set:" + String(root.editorPreviewController.activeMaskPatchSourceSet) +
               "|x:" + Math.round(root.editorPreviewController.activeMaskPatchSourceX * 100).toString() +
               "|y:" + Math.round(root.editorPreviewController.activeMaskPatchSourceY * 100).toString() +
               "|w:" + Math.round(root.editorPreviewController.activeMaskPatchSourceWidth * 100).toString() +
               "|h:" + Math.round(root.editorPreviewController.activeMaskPatchSourceHeight * 100).toString()
    }

    function retouchPatchSourceNudge(deltaX, deltaY) {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskRetouchMode !== "patch")
            return
        root.editorPreviewController.setActiveMaskPatchSourceRegion(
                    root.editorPreviewController.activeMaskPatchSourceX + deltaX,
                    root.editorPreviewController.activeMaskPatchSourceY + deltaY,
                    root.editorPreviewController.activeMaskPatchSourceWidth,
                    root.editorPreviewController.activeMaskPatchSourceHeight)
    }

    function retouchBeforeAfterSignature() {
        return "view:" + (root.editorPreviewController.retouchBeforeAfterEnabled ? "before" : "after") +
               "|button:" + (root.editorPreviewController.retouchBeforeAfterEnabled ? "Show After" : "Show Before") +
               "|recipe:unchanged"
    }

    function retouchHealBlendSignature() {
        return "visible:" + String(root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskRetouchMode === "heal") +
               "|texture:" + Math.round(root.editorPreviewController.activeMaskHealTextureBlend * 100).toString() +
               "|color:" + Math.round(root.editorPreviewController.activeMaskHealColorBlend * 100).toString()
    }

    function retouchActionSignature() {
        const active = root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskToolRole === "retouch"
        const committed = active && root.editorPreviewController.activeMaskCommitted
        return "apply:" + String(active && !committed) +
               "|cancel:" + String(active && !committed) +
               "|reset:" + String(active && !committed) +
               "|delete:" + String(committed) +
               "|reopen:" + String(committed)
    }

    function retouchRecoverabilitySignature() {
        const mode = root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskToolRole === "retouch"
                ? root.editorPreviewController.activeMaskRetouchMode
                : "none"
        const state = root.retouchModeCapabilityState(mode)
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const canRegenerate = root.editorPreviewController.hasActiveMask && inpaintMode &&
                (!root.editorPreviewController.activeMaskCommitted || root.editorPreviewController.activeInpaintRegenerationAvailable)
        const canApply = root.editorPreviewController.hasActiveMask &&
                root.editorPreviewController.activeMaskToolRole === "retouch" &&
                !root.editorPreviewController.activeMaskCommitted
        return "mode:" + mode +
               "|state:" + state +
               "|canvasBlocking:false" +
               "|apply:" + String(canApply) +
               "|regenerate:" + String(canRegenerate) +
               "|modelReason:" + root.disabledCapabilityReason("model-inpaint")
    }

    function retouchPrimaryToolSignature() {
        const modes = ["remove", "heal", "patch", "clone", "dust", "red-eye", "skin-cleanup", "frequency-smoothing"]
        const parts = []
        for (let index = 0; index < modes.length; ++index) {
            const mode = modes[index]
            parts.push(mode + ":" + root.retouchModeVisibilityState(mode))
        }
        return parts.join("|")
    }

    function photoLayerBlendModes() {
        return ["normal", "multiply", "screen", "overlay", "soft-light", "hard-light", "color", "luminosity"]
    }

    function photoLayerBlendModesForLayer(layer) {
        if (layer === null || layer === undefined)
            return root.photoLayerBlendModes()
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "").trim().toLowerCase()
        if (kind === "adjustment" || kind === "fill" || kind === "pixel" ||
                kind === "group" ||
                kind === "text" || kind === "source")
            return root.photoLayerBlendModes()
        return ["normal"]
    }

    function photoLayerBlendModeSupported(layer, modeName) {
        const mode = String(modeName || "normal").trim().toLowerCase()
        return root.photoLayerBlendModesForLayer(layer).indexOf(mode) >= 0
    }

    function photoLayerBlendModeControlsEnabled(layer) {
        return root.photoLayerBlendModesForLayer(layer).length > 1
    }

    function photoLayerBlendModeSupportSignature(layer) {
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "unknown").trim().toLowerCase()
        const modes = root.photoLayerBlendModesForLayer(layer)
        return "photo-layer-blend-mode-support:v1" +
               "|kind:" + kind +
               "|enabled:" + String(modes.length > 1) +
               "|default:normal" +
               "|modes:" + modes.join(",")
    }

    function photoLayerBlendLabel(modeName) {
        const mode = String(modeName || "normal").trim().toLowerCase()
        if (mode === "soft-light")
            return "Soft Light"
        if (mode === "hard-light")
            return "Hard Light"
        return mode.length > 0 ? mode.charAt(0).toUpperCase() + mode.slice(1) : "Normal"
    }

    function photoLayerKindLabel(layer) {
        const kind = String(layer && layer.kind !== undefined ? layer.kind : "layer").trim().toLowerCase()
        if (kind === "source")
            return layer.boardVideoSource ? qsTr("Video") : "Source Image"
        if (kind === "adjustment")
            return "Layer"
        if (kind === "pixel")
            return Object.keys((layer && layer.shapeDefinition) || ({})).length > 0 ? "Shape Layer" : "Pixel Layer"
        if (kind === "fill")
            return "Fill Layer"
        if (kind === "text")
            return "Text Layer"
        if (kind === "group")
            return "Group"
        return "Layer"
    }

    function photoLayerVisibilityLabel(layer) {
        if (layer && layer.enabled === false)
            return "Hidden"
        return "Visible"
    }

    function photoLayerMaskLinkLabel(layer, layerIndex) {
        const linked = root.maskSetsForAdjustmentLayer(layerIndex)
        if (linked.length > 0)
            return linked.length + " mask" + (linked.length === 1 ? "" : "s")
        if (layer && layer.hasLayerMask === true)
            return "Layer mask"
        return "No mask"
    }

    function selectedLayerHeaderSignature(layer, layerIndex) {
        const opacity = Math.round(root.clamp(Number(layer && layer.opacity !== undefined ? layer.opacity : 1.0), 0.0, 1.0) * 100)
        return "selected-layer-header:v1" +
                "|index:" + layerIndex.toString() +
                "|kind:" + root.photoLayerKindLabel(layer) +
                "|visible:" + root.photoLayerVisibilityLabel(layer) +
                "|opacity:" + opacity.toString() +
                "|blend:" + root.photoLayerBlendLabel(layer && layer.blendMode !== undefined ? layer.blendMode : "normal") +
                "|mask:" + root.photoLayerMaskLinkLabel(layer, layerIndex) +
                "|changed:" + root.layerChangedAdjustmentGroupSignature(layer)
    }

    function photoLayerBlendLabels() {
        return root.photoLayerBlendLabelsForLayer(null)
    }

    function photoLayerBlendLabelsForLayer(layer) {
        const labels = []
        const modes = root.photoLayerBlendModesForLayer(layer)
        for (let index = 0; index < modes.length; ++index)
            labels.push(root.photoLayerBlendLabel(modes[index]))
        return labels
    }

    function photoLayerBlendModeAt(index) {
        return root.photoLayerBlendModeAtForLayer(null, index)
    }

    function photoLayerBlendModeAtForLayer(layer, index) {
        const modes = root.photoLayerBlendModesForLayer(layer)
        return modes[Math.max(0, Math.min(modes.length - 1, Number(index || 0)))]
    }

    function photoLayerBlendModeIndex(modeName) {
        return root.photoLayerBlendModeIndexForLayer(null, modeName)
    }

    function photoLayerBlendModeIndexForLayer(layer, modeName) {
        const modes = root.photoLayerBlendModesForLayer(layer)
        const index = modes.indexOf(String(modeName || "normal").trim().toLowerCase())
        return index < 0 ? 0 : index
    }

    function nextPhotoLayerBlendMode(modeName) {
        const modes = root.photoLayerBlendModes()
        const current = String(modeName || "normal").trim().toLowerCase()
        const index = modes.indexOf(current)
        return modes[(index + 1) % modes.length]
    }

    function cyclePhotoLayerBlendMode(layerIndex, modeName) {
        return root.editorPreviewController.setPhotoLayerBlendMode(layerIndex, root.nextPhotoLayerBlendMode(modeName))
    }

    function adjustPhotoLayerOpacity(layerIndex, opacity, delta) {
        const currentOpacity = opacity === undefined || opacity === null ? 1.0 : Number(opacity)
        const nextOpacity = Math.round(root.clamp(currentOpacity + delta, 0.0, 1.0) * 100) / 100
        return root.editorPreviewController.setPhotoLayerOpacity(layerIndex, nextOpacity)
    }

    function professionalLayerLocked(layer) {
        const seen = ({})
        for (let depth = 0; layer && depth < 64; ++depth) {
            const id = String(layer.id || "")
            if (layer.locked === true || seen[id]) return true
            seen[id] = true
            const parent = String(layer.parentId || "")
            if (!parent.length) return false
            layer = root.photoLayerRows.find(function(item) { return String(item.id) === parent })
        }
        return true
    }

    function startPhotoPen(layerIndex) {
        const controls = root.photoPenControlsHandle
        if (!controls)
            return false
        root.editorPreviewController.finishLayerMaskEditing()
        const layer = layerIndex >= 0 ? root.photoLayerRows[layerIndex] || ({}) : ({})
        if (layerIndex >= 0 && root.professionalLayerLocked(layer)) return false
        root.penAssetId = String(root.editorPreviewController.assetId)
        root.penTargetKind = "layer"
        root.penLayerId = layer.vectorPath ? String(layer.id || "") : ""
        root.penPathDocument = layer.vectorPath || ({schema: "photo-vector-path", version: 1, coordinateSpace: "normalized", subpaths: []})
        controls.fillColor = String(layer.vectorFillColor || "#4a78ff")
        controls.strokeColor = String(layer.vectorStrokeColor || "#ffffff")
        controls.strokeWidth = Number(layer.vectorStrokeWidth !== undefined ? layer.vectorStrokeWidth : 2)
        controls.outputMode = "layer"
        root.activateEditTool("pen")
    }

    function startPhotoVectorMask(layerIndex) {
        const layer = root.photoLayerRows[layerIndex]
        if (!layer || root.professionalLayerLocked(layer) || layer.baseImageEdit === true) return false
        root.editorPreviewController.finishLayerMaskEditing()
        root.setActivePhotoLayerSelection(layerIndex, false)
        root.penAssetId = String(root.editorPreviewController.assetId)
        root.penTargetKind = "mask"
        root.penLayerId = String(layer.id)
        root.penPathDocument = layer.vectorMask ? layer.vectorMask.path : ({schema: "photo-vector-path", version: 1, coordinateSpace: "normalized", subpaths: []})
        root.activateEditTool("pen")
        return true
    }

    function layerAddMenuItems() {
        if (root.inspectorOnly)
            return [{key: "adjustment", label: "Adjustment Layer", icon: "adjust",
                tooltip: "Add an editable color and effects layer to this clip."}]
        return [
            {
                key: "adjustment",
                label: "Adjustment Layer",
                icon: "adjust",
                checked: true,
                description: "Editable light, color, masks, and local recipe controls.",
