    function retouchToolVisibilitySignature() {
        const active = root.editorPreviewController.hasActiveMask && root.editorPreviewController.activeMaskToolRole === "retouch"
        const mode = active ? String(root.editorPreviewController.activeMaskRetouchMode || "remove") : "none"
        return "retouch-tool-visibility:v2" +
               "|family:Retouch" +
               "|variant:" + (active ? root.retouchModeLabel(mode) : "Retouch") +
               "|mode:" + mode +
               "|status:" + root.retouchHudStatusText() +
               "|last:" + root.editToolLastUsedVariant("retouch", mode) +
               "|hud:" + String(active && !root.editorPreviewController.compareMode) +
               "|layout:grouped-workflow-panel" +
               "|primary:" + root.retouchHudPrimaryText() +
               "|inline:" + String(root.retouchHudInlineActions().length) +
               "|more:" + String(root.retouchHudMoreMenuItems().length) +
               "|mode-buttons:remove-heal-patch-clone" +
               "|guidance:true|brush:size-presets|review:before-after|source:contextual" +
               "|text:readable|menus:advanced-options"
    }

    function retouchWorkflowSignature() {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskToolRole !== "retouch")
            return "mode:none|label:Retouch|stage:inactive|source:none|apply:false|regenerate:false|beforeAfter:after"
        const mode = root.editorPreviewController.activeMaskRetouchMode
        const inpaintMode = mode === "remove" || mode === "heal" || mode === "patch"
        const canRegenerate = inpaintMode &&
                (!root.editorPreviewController.activeMaskCommitted || root.editorPreviewController.activeInpaintRegenerationAvailable)
        const sourceState = mode === "clone"
                ? (root.editorPreviewController.activeMaskCloneSourceSet ? "set" : "required")
                : (mode === "patch"
                   ? (root.editorPreviewController.activeMaskPatchSourceSet ? "region" : "required")
                   : "none")
        return "mode:" + mode +
               "|label:" + root.retouchModeLabel(mode) +
               "|stage:" + root.retouchRequirementText() +
               "|source:" + sourceState +
               "|apply:" + String(!root.editorPreviewController.activeMaskCommitted) +
               "|regenerate:" + String(canRegenerate) +
                 "|capability:" + root.retouchModeCapabilityState(mode) +
                 "|beforeAfter:" + (root.editorPreviewController.retouchBeforeAfterEnabled ? "before" : "after") +
                 (root.editorPreviewController.inpaintProgressActive
                  ? "|inpaintProgress:" + Math.max(0, Math.min(1, Number(root.editorPreviewController.inpaintProgressValue || 0))).toFixed(3)
                    + "|inpaintProgressLabel:" + String(root.editorPreviewController.inpaintProgressLabel || "")
                  : "")
    }

    function retouchAllWorkflowStateSignature() {
        return root.editorPreviewController.retouchWorkflowStateSignature
    }

    function retouchVariationPickerSignature() {
        return "visible:" + String(root.editorPreviewController.activeInpaintVariationPickerVisible) +
               "|count:" + String(root.editorPreviewController.activeInpaintCandidateCount) +
               "|index:" + String(root.editorPreviewController.activeInpaintCandidateIndex)
    }

    function activeCloneMaskDefinition() {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskIndex < 0)
            return ({})
        const stack = root.editorPreviewController.maskStack || []
        if (root.editorPreviewController.activeMaskIndex >= stack.length)
            return ({})
        return stack[root.editorPreviewController.activeMaskIndex] || ({})
    }

    function activeCloneTargetX() {
        const mask = root.activeCloneMaskDefinition()
        return root.clamp(Number(mask.cloneSourceX !== undefined ? mask.cloneSourceX : root.editorPreviewController.activeMaskCloneSourceX) -
                          Number(mask.cloneOffsetX || 0), 0.0, 1.0)
    }

    function activeCloneTargetY() {
        const mask = root.activeCloneMaskDefinition()
        return root.clamp(Number(mask.cloneSourceY !== undefined ? mask.cloneSourceY : root.editorPreviewController.activeMaskCloneSourceY) -
                          Number(mask.cloneOffsetY || 0), 0.0, 1.0)
    }

    function retouchCloneOverlaySignature() {
        if (!root.editorPreviewController.hasActiveMask || root.editorPreviewController.activeMaskRetouchMode !== "clone")
            return "visible:false"
        return "visible:" + String(root.editorPreviewController.activeMaskCloneSourceSet) +
               "|source:" + Math.round(root.editorPreviewController.activeMaskCloneSourceX * 100).toString() + "," +
                    Math.round(root.editorPreviewController.activeMaskCloneSourceY * 100).toString() +
               "|target:" + Math.round(root.activeCloneTargetX() * 100).toString() + "," +
