            if (root.editorPreviewController.brushStrokeActive)
                root.editorPreviewController.endActiveBrushStroke()
            return root.finishSelectionWorkflow()
        }
        if (root.pixelExactToolReady())
            return root.finishSelectionWorkflow()
        if (root.objectPickArmed) {
            root.editorPreviewController.rejectSmartSelectPreview()
            return root.finishSelectionWorkflow()
