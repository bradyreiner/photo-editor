    readonly property bool componentWorkspaceHasPendingCanvasDraft: root.componentWorkspaceCanvasDraftIsActive()

    function resolveComponentWorkspaceEdit() {
        if (!root.componentWorkspaceActive)
            return false
        root.componentWorkspaceApplyBlockReason = ""
        if (!root.componentWorkspaceCanvasHandlesReady()) {
            root.componentWorkspaceApplyBlockReason = qsTr("Canvas controls are still loading. Try Apply again when they are ready.")
            root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, false)
            return false
        }
        const penOverlay = root.photoPenOverlayHandle
        if (!root.resolveTextSession()) {
            root.componentWorkspaceApplyBlockReason = qsTr("Finish the active text edit before applying component contents.")
            root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, true)
            return false
        }
        if (root.editTool === "pen" && penOverlay.transactionOpen) {
            if (!penOverlay.canFinishPath) {
                root.componentWorkspaceApplyBlockReason = qsTr("Finish the path with Done, or cancel it before applying component contents.")
                root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, true)
                return false
            }
            if (!root.finishActiveCanvasTool()) {
                root.componentWorkspaceApplyBlockReason = qsTr("The path could not be finished. Retry or cancel it before applying.")
                root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, true)
                return false
            }
            if (penOverlay.transactionOpen || penOverlay.commitPending) {
                root.componentWorkspaceApplyBlockReason = qsTr("The path is still being checked. Apply again when it finishes.")
                root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, false)
                return false
            }
        }
        const paintOverlay = root.photoPaintOverlayHandle
        const shapeOverlay = root.photoShapeCreationOverlayHandle
        const textCreateOverlay = root.photoTextCreationOverlayHandle
        const layerPicker = root.photoLayerCanvasPickerHandle
        const transformOverlay = root.photoLayerTransformOverlayHandle
        if (root.maskRefinementSessionActive || root.maskShapeEditTransactionActive ||
                penOverlay.transactionOpen || (!!paintOverlay && paintOverlay.drawing) ||
                (!!shapeOverlay && shapeOverlay.dragging) || (!!textCreateOverlay && textCreateOverlay.dragging) ||
                (!!layerPicker && layerPicker.movingSelection) || (!!transformOverlay && transformOverlay.interactionActive) ||
                root.objectPickArmed || root.cloneSourcePickArmed || root.polygonDrawArmed ||
                root.lassoDrawArmed || root.pendingSelectionAction.length > 0 ||
                (root.objectPickArmed && root.editorPreviewController.smartSelectPreviewActive)) {
            root.componentWorkspaceApplyBlockReason = qsTr("Finish or cancel the active canvas draft before applying component contents.")
            root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, true)
            return false
        }
        if (root.editorPreviewController.brushStrokeActive)
            root.editorPreviewController.endActiveBrushStroke()
        if (root.editorPreviewController.selectionEditSessionActive) {
            if (!root.finishSelectionWorkflow()) {
                root.componentWorkspaceApplyBlockReason = qsTr("The selection edit could not be finished. Retry or cancel it before applying.")
                root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, true)
                return false
            }
            if (root.editorPreviewController.selectionEditSessionActive) {
                root.componentWorkspaceApplyBlockReason = qsTr("The selection is still being applied. Apply again when it finishes.")
                root.showEditActionFeedback(root.componentWorkspaceApplyBlockReason, false)
