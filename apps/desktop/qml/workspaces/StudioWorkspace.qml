    function setActiveMaskQuickAdjustment(kindName, value) {
        const kind = String(kindName || "").trim().toLowerCase()
        const numericValue = Number(value)
        if (!root.editorPreviewController.hasActiveMask || !isFinite(numericValue))
            return false
        let layerIndex = root.activeMaskAdjustmentLayerIndex()
        if (layerIndex < 0)
            layerIndex = root.editorPreviewController.ensureActiveSelectionAdjustmentLayer()
        if (layerIndex >= 0) {
            root.setActivePhotoLayerSelection(layerIndex, false)
            const layerKey = kind === "temp" ? "temperature" : kind
            return root.editorPreviewController.setPhotoLayerAdjustmentValue(layerIndex, layerKey, numericValue)
        }
        if (kind === "exposure") {
            root.editorPreviewController.activeMaskExposure = root.clamp(numericValue, -5.0, 5.0)
            return true
        }
        if (kind === "temperature" || kind === "temp") {
            root.editorPreviewController.activeMaskTemperature = root.clamp(numericValue, -100.0, 100.0)
            return true
        }
        if (kind === "contrast") {
            root.editorPreviewController.activeMaskContrast = root.clamp(numericValue, -100.0, 100.0)
            return true
        }
        if (kind === "shadows") {
            root.editorPreviewController.activeMaskShadows = root.clamp(numericValue, -100.0, 100.0)
            return true
        }
        return false
    }

