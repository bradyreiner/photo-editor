    onEditToolChanged: {
        if (root.boardSequencePreviewActive && root.editTool !== "layers" && root.editTool !== "export") {
            root.editTool = "layers"
            return
        }
        if (editTool !== "retouch")
            root.cancelCloneSourcePick()
        if (editTool !== "crop")
            root.editorPreviewController.cancelAutoHorizonAnalysis()
        if (editTool !== "text" && root.photoTextOverlayHandle && root.photoTextOverlayHandle.editing) {
            if (!root.resolveTextSession()) {
                root.editTool = "text"
                return
            }
        }
        if (editTool === "compare") {
            root.editorPreviewController.compareMode = true
            root.editorPreviewController.cropEditing = false
            return
        }
        if (editTool === "crop") {
            root.editorPreviewController.compareMode = false
            root.editorPreviewController.cropEditing = root.cropToolMode === "crop"
            return
        }
        root.editorPreviewController.compareMode = false
        if (editTool !== "crop")
            root.editorPreviewController.cropEditing = false
    }

