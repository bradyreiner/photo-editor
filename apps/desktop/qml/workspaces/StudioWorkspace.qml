        }
        root.editorPreviewController.setColorToolSamplingTarget(cleanTarget)
        return root.editorPreviewController.colorToolSamplingTarget
    }

    function setMaskColorRangeSampler(enabled) {
        const nextEnabled = Boolean(enabled) && root.editorPreviewController.activeMaskKind === "color"
        root.maskColorRangeSampling = nextEnabled
        root.maskLuminanceRangeSampling = false
