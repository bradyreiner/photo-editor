            if (!hidePreview)
                root.editorPreviewController.maskPreviewTemporarilyHidden = false
            return false
        }
        root.editorPreviewController.maskPreviewTemporarilyHidden = hidePreview
        return true
    }

    function deleteActiveMaskFromShortcut() {
        if (!root.maskShortcutContextActive(true))
