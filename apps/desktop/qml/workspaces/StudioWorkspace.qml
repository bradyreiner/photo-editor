        const pressureOpacity = root.clamp(root.editorPreviewController.activeMaskBrushPressureOpacity, 0.0, 1.0)
        const pressureOff = pressureSize <= 0.001 && pressureFlow <= 0.001 && pressureOpacity <= 0.001
