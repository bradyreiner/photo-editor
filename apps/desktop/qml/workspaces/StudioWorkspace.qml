        const key = String(groupKey || "").trim().toLowerCase()
        if (key === "tone-curve")
            return "curve"
        if (key === "hsl")
            return "hsl"
        if (key === "grading" || key === "lut" || key === "color")
            return "color"
        if (key === "detail")
            return "detail"
        if (key === "lens-transform")
