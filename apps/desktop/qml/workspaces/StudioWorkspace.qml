    function photoLayerMaskSetIds(layer) {
        const values = root.normalizedPhotoLayerMaskSetValues(layer, "selectionMaskSetIds", "selectionMaskSetId")
        const intersections = root.normalizedPhotoLayerMaskSetValues(layer, "selectionIntersectionMaskSetIds", "")
        for (let index = 0; index < intersections.length; ++index) {
            if (values.indexOf(intersections[index]) < 0)
                values.push(intersections[index])
        }
        return values
    }

    function photoLayerMaskSetNames(layer) {
        const values = root.normalizedPhotoLayerMaskSetValues(layer, "selectionMaskSetNames", "selectionMaskSetName")
        const intersections = root.normalizedPhotoLayerMaskSetValues(layer, "selectionIntersectionMaskSetNames", "")
        for (let index = 0; index < intersections.length; ++index) {
