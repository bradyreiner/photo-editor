            }
        ]
    }

    function handleSelectedPhotoLayerBatchAction(key, activeLayerIndex, activeLayer) {
        const targets = root.selectedPhotoLayerBatchTargets(true, -1)
        if (targets.length === 0)
            return false
        const activeLayerValid = activeLayerIndex >= 0 && activeLayerIndex < root.editorPreviewController.photoLayerCount
        let changed = false
        const applyUnlocked = function(callback) {
            for (let index = 0; index < targets.length; ++index) {
                const layerIndex = targets[index]
                const layer = root.photoLayerRows[layerIndex] || ({})
                if (layer.locked === true)
                    continue
                changed = callback(layerIndex, layer) || changed
            }
        }
        if (key === "hide-selected") {
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.setPhotoLayerEnabled(layerIndex, false) })
        } else if (key === "show-selected") {
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.setPhotoLayerEnabled(layerIndex, true) })
        } else if (key === "lock-selected") {
            for (let index = 0; index < targets.length; ++index)
                changed = root.editorPreviewController.setPhotoLayerLocked(targets[index], true) || changed
        } else if (key === "unlock-selected") {
            for (let index = 0; index < targets.length; ++index)
                changed = root.editorPreviewController.setPhotoLayerLocked(targets[index], false) || changed
        } else if (key === "duplicate-selected") {
            const duplicateTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < duplicateTargets.length; ++index)
                changed = root.editorPreviewController.duplicatePhotoLayerWithMasks(duplicateTargets[index]) || changed
        } else if (key === "duplicate-selected-without-masks") {
            const duplicateTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < duplicateTargets.length; ++index)
                changed = root.editorPreviewController.duplicatePhotoLayerWithoutMasks(duplicateTargets[index]) || changed
        } else if (key === "match-active-opacity") {
            const opacity = Number(activeLayer && activeLayer.opacity !== undefined ? activeLayer.opacity : 1.0)
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.setPhotoLayerOpacity(layerIndex, opacity) })
        } else if (key === "match-active-blend") {
            const blendMode = String(activeLayer && activeLayer.blendMode !== undefined ? activeLayer.blendMode : "normal")
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.setPhotoLayerBlendMode(layerIndex, blendMode) })
        } else if (key === "paste-copied-adjustments") {
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.pastePhotoLayerAdjustments(layerIndex) })
        } else if (key === "paste-global-adjustments") {
            applyUnlocked(function(layerIndex) { return root.editorPreviewController.pasteGlobalAdjustmentsToPhotoLayer(layerIndex) })
        } else if (key === "delete-selected") {
            const deleteTargets = targets.slice().sort(function(a, b) { return b - a })
            for (let index = 0; index < deleteTargets.length; ++index)
                changed = root.deletePhotoLayerTarget(deleteTargets[index]) || changed
            root.selectedPhotoLayerIndices = root.normalizedActivePhotoLayerIndex() >= 0
                    ? [root.normalizedActivePhotoLayerIndex()]
                    : []
        } else if (key === "ungroup-selected" && activeLayerValid) {
            changed = root.editorPreviewController.ungroupPhotoLayer(activeLayerIndex)
            if (changed)
                root.setActivePhotoLayerSelection(activeLayerIndex, false)
        }
        return changed
    }

    function setActivePhotoLayerSelection(index, extendSelection) {
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        if ((root.photoLayerRows[index] || ({})).baseImageEdit === true)
            return root.activateBaseImageLayerTarget()
        let selected = root.normalizedPhotoLayerSelection()
        if (extendSelection) {
            const existing = selected.indexOf(index)
            if (existing >= 0)
                selected.splice(existing, 1)
            else
                selected.push(index)
            if (selected.length === 0)
                selected.push(index)
        } else {
            selected = [index]
        }
        if (!root.setSelectedEditTarget(root.selectedLayerTargetScope(index), index, ({}), -1))
            return false
        root.editorPreviewController.finishLayerMaskEditing()
        root.selectedPhotoLayerIndices = selected
        return true
    }

    function selectPhotoLayerWithModifiers(index, modifiers) {
        if (root.selectionNavigationActive && root.editorPreviewController.hasWorkingSelection && Number(modifiers || 0) === 0)
            return root.switchSelectionLayerTarget("layer:" + root.photoLayerIdentityAt(index))
        const layerIndex = Math.floor(Number(index))
        if (layerIndex < 0 || layerIndex >= root.editorPreviewController.photoLayerCount)
            return false
        if ((root.photoLayerRows[layerIndex] || ({})).baseImageEdit === true)
            return root.activateBaseImageLayerTarget()
        const flags = Number(modifiers || 0)
        if (root.editorPreviewController.selectionEditSessionActive)
            return root.queueSelectionAction("layer-row:" + JSON.stringify({id: root.photoLayerIdentityAt(layerIndex), modifiers: flags}))
        const extendRange = (flags & Qt.ShiftModifier) !== 0
        const toggle = (flags & Qt.ControlModifier) !== 0 ||
                       (flags & Qt.MetaModifier) !== 0
        if (extendRange) {
            const anchor = root.photoLayerSelectionAnchorIndex >= 0 &&
                           root.photoLayerSelectionAnchorIndex < root.editorPreviewController.photoLayerCount
                    ? root.photoLayerSelectionAnchorIndex
                    : root.normalizedActivePhotoLayerIndex()
            const first = Math.min(anchor, layerIndex)
            const last = Math.max(anchor, layerIndex)
            const next = toggle ? root.normalizedPhotoLayerSelection().slice() : []
            for (let candidate = first; candidate <= last; ++candidate) {
                if ((root.photoLayerRows[candidate] || ({})).baseImageEdit === true)
                    continue
                if (next.indexOf(candidate) < 0)
                    next.push(candidate)
            }
            if (!root.setSelectedEditTarget(root.selectedLayerTargetScope(layerIndex), layerIndex, ({}), -1))
                return false
            root.editorPreviewController.finishLayerMaskEditing()
            root.selectedPhotoLayerIndices = next
            root.clearTransientMaskTools()
            if (["masks", "brush", "pixel-brush", "pixel-select"].indexOf(root.editTool) >= 0) root.editTool = "layers"
            return true
        }
        if (!root.setActivePhotoLayerSelection(layerIndex, toggle))
            return false
        root.photoLayerSelectionAnchorIndex = layerIndex
        root.clearTransientMaskTools()
        if (["masks", "brush", "pixel-brush", "pixel-select"].indexOf(root.editTool) >= 0) root.editTool = "layers"
        return true
    }

    function beginInlinePhotoLayerRename(index) {
        const layerIndex = Math.floor(Number(index))
        if (layerIndex < 0 || layerIndex >= root.editorPreviewController.photoLayerCount)
            return false
        const layer = root.photoLayerRows[layerIndex] || ({})
        if (layer.locked === true)
            return false
        root.inlineRenamingPhotoLayerIndex = layerIndex
        root.inlinePhotoLayerRenameOriginal = String(layer.displayName || layer.name || "Layer")
        return true
    }

    function commitInlinePhotoLayerRename(index, name) {
        const layerIndex = Math.floor(Number(index))
        if (root.inlineRenamingPhotoLayerIndex !== layerIndex)
            return false
        const nextName = String(name || "").trim()
        root.inlineRenamingPhotoLayerIndex = -1
        root.inlinePhotoLayerRenameOriginal = ""
        if (nextName.length === 0)
            return false
        const layer = root.photoLayerRows[layerIndex] || ({})
        const currentName = String(layer.displayName || layer.name || "Layer").trim()
        return nextName === currentName || root.editorPreviewController.renamePhotoLayer(layerIndex, nextName)
    }

    function cancelInlinePhotoLayerRename(index) {
        if (root.inlineRenamingPhotoLayerIndex !== Math.floor(Number(index)))
            return false
        root.inlineRenamingPhotoLayerIndex = -1
        root.inlinePhotoLayerRenameOriginal = ""
        return true
    }

    function layerKeyboardNavigationSignature() {
        return "layer-keyboard-navigation:v3|arrows:nudge-in-layer-tools|up-down:select-otherwise|enter:edit|f2:rename|space:visibility|shift:range-select|modifier-up-down:reorder|escape:base-focus"
    }

    function handlePhotoLayerRowKey(event, layerIndex, layer) {
        const index = Math.floor(Number(layerIndex))
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return false
        if (root.handleLayerNudgePress(event)) return true
        const key = event.key
        const modifiers = event.modifiers || 0
        if (layer && layer.baseImageEdit === true &&
                (key === Qt.Key_Return || key === Qt.Key_Enter || key === Qt.Key_F2)) {
            root.activateBaseImageLayerTarget()
            event.accepted = true
            return true
        }
	        const extendSelection = (modifiers & Qt.ShiftModifier) !== 0
	        const reorder = (modifiers & Qt.ControlModifier) !== 0 || (modifiers & Qt.MetaModifier) !== 0
	        if (key === Qt.Key_Return || key === Qt.Key_Enter) {
	            const selected = root.normalizedPhotoLayerSelection()
	            if (selected.length > 1 && selected.indexOf(index) >= 0) {
	                root.setSelectedEditTarget(root.selectedLayerTargetScope(index), index, ({}), -1)
	                if (root.photoLayerKind(index) === "adjustment")
	                    root.activateEditTool("adjust")
	                else {
	                    root.editTool = "layers"
	                    root.editInspectorTab = "layers"
	                }
	            } else {
	                root.editPhotoLayerInspectorTarget(index)
	            }
	            event.accepted = true
	            return true
	        }
        if (key === Qt.Key_F2) {
            root.beginInlinePhotoLayerRename(index)
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Space) {
            root.editorPreviewController.setPhotoLayerEnabled(index, !(layer && layer.enabled !== false))
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Up || key === Qt.Key_Down) {
            const offset = key === Qt.Key_Up ? -1 : 1
	            if (reorder) {
	                root.movePhotoLayerPreservingSelection(index, offset)
            } else {
                const nextIndex = Math.max(0, Math.min(root.editorPreviewController.photoLayerCount - 1, index + offset))
                root.setActivePhotoLayerSelection(nextIndex, extendSelection)
            }
            event.accepted = true
            return true
        }
        if (key === Qt.Key_Escape) {
            root.forceActiveFocus()
            event.accepted = true
            return true
        }
        return false
    }

    function currentPhotoLayerData() {
        const index = root.normalizedActivePhotoLayerIndex()
        if (index < 0)
            return ({})
        return root.photoLayerRows[index] || ({})
    }

    function activeAdjustmentLayerIndex() {
        if (root.selectedEditTargetScope() === "base-image" || root.baseImageTargetActive)
            return -1
        const selectedIndex = root.selectedEditTargetLayerIndex()
        if (selectedIndex < 0 && String(root.selectedEditTarget.layerId || "").length > 0)
            return -1
        const index = selectedIndex >= 0 ? selectedIndex : root.normalizedActivePhotoLayerIndex()
        if (index < 0)
            return -1
        const layer = root.photoLayerRows[index] || ({})
        const kind = String(layer.kind || "").trim().toLowerCase()
        return ["adjustment", "pixel", "source"].indexOf(kind) >= 0 ? index : -1
    }

    function activeAdjustmentLayerData() {
        const index = root.activeAdjustmentLayerIndex()
        return index >= 0 ? (root.photoLayerRows[index] || ({})) : ({})
    }

    function primaryAdjustmentLayerIndex() {
        const selectedLayerIndex = root.activeAdjustmentLayerIndex()
        if (selectedLayerIndex >= 0)
            return selectedLayerIndex
        if (root.selectedEditTargetScope() === "mask" || root.activeEditTargetScope() === "mask")
            return root.activeMaskAdjustmentLayerIndex()
        return -1
    }

    function photoLayerKind(index) {
        if (index < 0 || index >= root.editorPreviewController.photoLayerCount)
            return ""
        const layer = root.photoLayerRows[index] || ({})
        return String(layer.kind || "").trim().toLowerCase()
    }

    function editTargetCanShowMask() {
        return root.editorPreviewController.hasActiveMask &&
               root.editorPreviewController.activeMaskToolRole !== "retouch" &&
               (root.editTool === "masks" || root.editTool === "brush")
    }

    function activeEditTargetLayerIndex() {
        if (root.selectedEditTargetScope() === "base-image" || root.baseImageTargetActive)
            return -1
        const selectedLayerIndex = root.selectedEditTargetLayerIndex()
        if (selectedLayerIndex >= 0)
            return selectedLayerIndex
        if (String(root.selectedEditTarget.layerId || "").length > 0)
            return -1
        const maskLayerIndex = root.activeMaskAdjustmentLayerIndex()
        if (root.editTargetCanShowMask() && maskLayerIndex >= 0)
            return maskLayerIndex
        if (root.editInspectorTab === "layers")
            return root.normalizedActivePhotoLayerIndex()
        if (root.editInspectorTab === "adjust")
            return root.activeAdjustmentLayerIndex()
        return -1
    }

    function activeEditTargetLayerData() {
        const index = root.activeEditTargetLayerIndex()
        return index >= 0 ? (root.photoLayerRows[index] || ({})) : ({})
    }

    function activeMaskSetData() {
        const selectedMaskId = root.selectedEditTargetMaskSetId()
        const selectedMaskName = String(root.selectedEditTarget.maskSetName || "").trim()
        if (root.selectedEditTargetScope() === "mask") {
            const maskSets = root.maskSetRows
            for (let index = 0; index < maskSets.length; ++index) {
                const maskSet = maskSets[index] || ({})
                if ((selectedMaskId.length > 0 && String(maskSet.id || "").trim() === selectedMaskId) ||
                        (selectedMaskId.length === 0 && selectedMaskName.length > 0 && String(maskSet.name || "").trim() === selectedMaskName))
                    return maskSet
            }
        }
        if (!root.editorPreviewController.hasActiveMask)
            return ({})
        const maskSets = root.maskSetRows
        for (let index = 0; index < maskSets.length; ++index) {
            const maskSet = maskSets[index] || ({})
            if (root.maskSetActive(maskSet))
                return maskSet
        }
        return ({})
    }

    function activeEditTargetThumbnailData() {
        const scope = root.activeEditTargetScope()
        if (scope === "mask")
            return root.activeMaskSetData()
        if (scope === "adjustment-layer" || scope === "photo-layer")
            return root.activeEditTargetLayerData()
        return ({})
    }

    function activeEditTargetMaskActive() {
        const maskLayerIndex = root.activeMaskAdjustmentLayerIndex()
        return root.editTargetCanShowMask() &&
               maskLayerIndex >= 0 &&
               maskLayerIndex === root.activeEditTargetLayerIndex()
    }

    function activeEditTargetScope() {
        const selectedScope = root.selectedEditTargetScope()
        if (selectedScope === "base-image")
            return "base-image"
        if (selectedScope === "mask" && root.editorPreviewController.hasActiveMask)
            return "mask"
        if (selectedScope === "adjustment-layer" || selectedScope === "photo-layer") {
            const selectedIndex = root.selectedEditTargetLayerIndex()
            if (selectedIndex >= 0) {
                const selectedLayer = root.photoLayerRows[selectedIndex] || ({})
                return String(selectedLayer.kind || "").trim().toLowerCase() === "adjustment"
                        ? "adjustment-layer"
                        : "photo-layer"
            }
        }
        const layerIndex = root.activeEditTargetLayerIndex()
        if (layerIndex < 0)
            return "base-image"
        const layer = root.photoLayerRows[layerIndex] || ({})
        return String(layer.kind || "").trim().toLowerCase() === "adjustment"
                ? "adjustment-layer"
                : "photo-layer"
    }

    function activeEditTargetPrimaryName() {
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return "Base Image"
        const layer = root.activeEditTargetLayerData()
        return String(layer.displayName || layer.name || "Layer")
    }

    function activeEditTargetMaskName() {
        if (!root.editorPreviewController.hasActiveMask)
            return ""
        return String(root.editorPreviewController.activeMaskName || root.editorPreviewController.activeMaskSetName || "Selection")
    }

    function activeEditTargetBreadcrumbText() {
        if (root.maskTargetInspectorActive())
            return root.activeEditTargetPrimaryName() + " / " + root.activeEditTargetMaskName()
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return "Base Image"
        const layerName = root.activeEditTargetPrimaryName()
        if (scope === "mask")
            return layerName + " / " + root.activeEditTargetMaskName()
        return layerName
    }

    function editDocumentBreadcrumbText() {
        if (!root.editBoardMode)
            return ""
        const board = root.activeEditBoard
        const boardName = String(board.boardName || qsTr("Board %1").arg(root.editBoardIndex + 1))
        const documentName = String(root.editBoardDocumentName || "").trim()
        return documentName.length > 0 ? documentName + " / " + boardName : boardName
    }

    function activeEditTargetModeLabel() {
        const scope = root.activeEditTargetScope()
        if (scope === "mask")
            return "Editing: Mask"
        if (scope === "adjustment-layer")
            return "Editing: Layer"
        if (scope === "photo-layer")
            return "Editing: Layer"
        return "Editing: Entire image"
    }

    function activeEditTargetBadgeText() {
        const scope = root.activeEditTargetScope()
        if (scope === "mask")
            return "SEL"
        if (scope === "adjustment-layer")
            return "LAYER"
        if (scope === "photo-layer")
            return "LAYER"
        return "BASE"
    }

    function activeEditTargetAccentColor() {
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return theme.accentCool300
        if (scope === "photo-layer")
            return theme.accentWarm400
        if (scope === "mask")
            return "#8FA8FF"
        return root.mint
    }

    function activeEditTargetToneName() {
        const scope = root.activeEditTargetScope()
        if (scope === "base-image")
            return "base"
        if (scope === "mask")
            return "selection"
        if (scope === "photo-layer")
            return "photo-layer"
        return "layer"
    }

    function activeEditTargetVisualSignature() {
        const scope = root.activeEditTargetScope()
        const thumbnail = root.activeEditTargetThumbnailData()
        const hasThumbnail = String(thumbnail.thumbnailSource || "").length > 0
        return "scope:" + scope +
                "|badge:" + root.activeEditTargetBadgeText() +
                "|compact-copy:true" +
                "|tone:" + root.activeEditTargetToneName() +
                "|base-tone:cool" +
                "|layer-tone:mint" +
                "|selection-tone:periwinkle" +
                "|photo-layer-tone:warm" +
                "|visible-breadcrumbs:1" +
                "|max-visible-breadcrumbs:1" +
                "|inspector-context:visible" +
                "|motion:color-opacity-scale" +
                "|motion-duration:" + String(root.studioMotionFast) +
                "|context-owner:inspector" +
                "|implementation-path:false" +
                "|rail:true|separation:hard" +
                "|thumbnail:" + String(scope !== "base-image") +
                "|thumbnail-source:" + String(hasThumbnail) +
                "|base:" + String(scope === "base-image") +
                "|layer:" + String(scope === "adjustment-layer" || scope === "mask")
    }

    function normalizedAdjustmentControlTargets(rawTargets) {
        const source = Array.isArray(rawTargets)
                ? rawTargets
                : String(rawTargets || "base-image,adjustment-layer").split(",")
        const normalized = []
        for (let index = 0; index < source.length; ++index) {
            const target = String(source[index] || "").trim().toLowerCase()
            if (["base-image", "adjustment-layer", "photo-layer", "mask"].indexOf(target) >= 0 &&
                    normalized.indexOf(target) < 0)
                normalized.push(target)
        }
        return normalized.length > 0 ? normalized : ["base-image", "adjustment-layer"]
    }

    function adjustmentControlTargetSupportSignature(rawTargets) {
        const targets = root.normalizedAdjustmentControlTargets(rawTargets)
        return root.adjustmentControlTargetSupportContract +
                "|base-image:" + String(targets.indexOf("base-image") >= 0) +
                "|adjustment-layer:" + String(targets.indexOf("adjustment-layer") >= 0) +
                "|photo-layer:" + String(targets.indexOf("photo-layer") >= 0) +
                "|mask:" + String(targets.indexOf("mask") >= 0) +
                "|active:" + root.activeEditTargetScope()
    }

    function adjustmentControlSupportsActiveTarget(rawTargets) {
        const targets = root.normalizedAdjustmentControlTargets(rawTargets)
        const activeScope = root.activeEditTargetScope()
        if (targets.indexOf(activeScope) >= 0)
            return true
        return (activeScope === "mask" || activeScope === "photo-layer") &&
               targets.indexOf("adjustment-layer") >= 0 &&
               root.activeAdjustmentLayerIndex() >= 0
    }

    function activeAdjustmentLayerLocked() {
        const layerIndex = root.activeAdjustmentLayerIndex()
        if (layerIndex < 0)
            return false
        const layer = root.photoLayerRows[layerIndex] || ({})
        return root.professionalLayerLocked(layer)
    }

    function adjustmentControlCanWriteActiveTarget(rawTargets) {
        return !root.inspectorReadOnly && !(root.componentWorkspaceActive && root.activeEditTargetScope() === "base-image") &&
               root.adjustmentControlSupportsActiveTarget(rawTargets) &&
               !root.activeAdjustmentLayerLocked()
    }

    function adjustmentControlDisabledReason(rawTargets) {
        const targets = root.normalizedAdjustmentControlTargets(rawTargets)
        const activeScope = root.activeEditTargetScope()
        if (root.componentWorkspaceActive && activeScope === "base-image")
            return "Select an editable component layer to change its adjustments."
        if (root.adjustmentControlSupportsActiveTarget(targets) && root.activeAdjustmentLayerLocked())
            return "Unlock the active layer before changing this adjustment."
        if (root.adjustmentControlSupportsActiveTarget(targets))
            return ""
        if (activeScope === "mask")
            return root.activeAdjustmentLayerIndex() >= 0
                    ? "This selection cannot receive this adjustment. Choose its linked layer or the base image."
                    : "This retouch selection has no adjustment recipe. Choose the base image or an adjustment layer."
        if (activeScope === "photo-layer" && targets.indexOf("photo-layer") < 0)
            return "Choose an image, pixel, or adjustment layer to edit its colors."
