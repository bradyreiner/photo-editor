        const title = selectedOnly ? "Relink Selected Original" : "Relink All Offline Originals"
        const folderUrl = catalogAssets.pickFolder(title)
        if (!folderUrl)
            return 0
        root.offlineMissingConfirmationArmed = false
        return selectedOnly
