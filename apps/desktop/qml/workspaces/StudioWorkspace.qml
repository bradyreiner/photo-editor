                disabledReason: "Select a mask and an unlocked content layer.",
                tooltip: "Rasterize this layer through the active selection and its existing masks into independent pixels."
            },
            {
                key: "duplicate-with-masks",
                label: "Duplicate With Selections",
                icon: "source",
                enabled: validIndex >= 0 && !locked,
                separatorBefore: true,
                disabledReason: locked ? "Unlock the layer before duplicating it." : "Layer is no longer available.",
                tooltip: "Duplicate this layer and keep linked selections."
            },
            {
                key: "duplicate-without-masks",
                label: "Duplicate Without Selections",
                icon: "source",
                enabled: validIndex >= 0 && !locked,
                disabledReason: locked ? "Unlock the layer before duplicating it." : "Layer is no longer available.",
                tooltip: "Duplicate this layer with the same adjustments but no mask links."
            },
            {
                key: "move-up",
                label: "Move Up",
                icon: "move-up",
