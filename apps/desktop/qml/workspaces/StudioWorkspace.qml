    function photoLayerReferencesMaskSet(layer, maskSet) {
        const setId = String(maskSet && maskSet.id || "").trim()
        const setName = String(maskSet && maskSet.name || "").trim()
        function matchesDomain(listKey, singleKey, namesKey, nameKey) {
            const ids = root.normalizedPhotoLayerMaskSetValues(layer, listKey, singleKey)
            const names = root.normalizedPhotoLayerMaskSetValues(layer, namesKey, nameKey)
            return (setId.length > 0 && ids.indexOf(setId) >= 0) ||
                    ((setId.length === 0 || ids.length === 0) && setName.length > 0 &&
                     names.indexOf(setName) >= 0)
        }
        return matchesDomain("selectionMaskSetIds", "selectionMaskSetId",
                             "selectionMaskSetNames", "selectionMaskSetName") ||
                matchesDomain("selectionIntersectionMaskSetIds", "",
