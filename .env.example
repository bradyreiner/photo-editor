PHOTO_EDITOR_DATABASE_URL=postgresql://photo_editor:photo_editor@localhost:5433/photo_editor
PHOTO_EDITOR_POSTGRES_HOST_PORT=5433
PHOTO_EDITOR_DATABASE_MAX_CONNECTIONS=10
PHOTO_EDITOR_APP_DATA_DIR=
# Optional private INI preferences for isolated review or automation workers.
PHOTO_EDITOR_PREFERENCES_DIR=
PHOTO_EDITOR_LOG_DIR=
# Optional local-only advisory decision capture; disabled when empty.
# Captures contain private brief/document text and are not approved training labels.
PHOTO_EDITOR_AGENT_DECISION_SHADOW_DIR=
PHOTO_EDITOR_BACKUP_DIR=
PHOTO_EDITOR_POSTGRES_BIN_DIR=
# Optional local Depth Motion runtime/model/project root and compatible Python.
PHOTO_EDITOR_DEPTH_MOTION_HOME=
PHOTO_EDITOR_DEPTH_MOTION_PYTHON=
