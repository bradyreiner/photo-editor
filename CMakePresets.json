{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "PHOTO_EDITOR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-macos-debug",
      "inherits": "base",
      "displayName": "macOS Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "dev-windows-debug",
      "inherits": "base",
      "displayName": "Windows Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-macos",
      "inherits": "base",
      "displayName": "macOS Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-windows",
      "inherits": "base",
      "displayName": "Windows Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci-headless",
      "inherits": "base",
      "displayName": "CI Headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PHOTO_EDITOR_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "ci-headless-tsan",
      "inherits": "ci-headless",
      "displayName": "CI Headless (ThreadSanitizer)",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "ci-headless-asan-ubsan",
      "inherits": "ci-headless",
      "displayName": "CI Headless (Address/UndefinedBehavior Sanitizers)",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-dev-macos-debug",
      "configurePreset": "dev-macos-debug"
    },
    {
      "name": "build-dev-windows-debug",
      "configurePreset": "dev-windows-debug"
    },
    {
      "name": "build-release-macos",
      "configurePreset": "release-macos"
    },
    {
      "name": "build-release-windows",
      "configurePreset": "release-windows"
    },
    {
      "name": "build-ci-headless",
      "configurePreset": "ci-headless"
    },
    {
      "name": "build-ci-headless-tsan",
      "configurePreset": "ci-headless-tsan"
    },
    {
      "name": "build-ci-headless-asan-ubsan",
      "configurePreset": "ci-headless-asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "test-ci-headless",
      "configurePreset": "ci-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-ci-headless-tsan",
      "configurePreset": "ci-headless-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-ci-headless-asan-ubsan",
      "configurePreset": "ci-headless-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
