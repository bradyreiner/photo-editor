if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "EmbedColorMetal requires INPUT and OUTPUT")
endif()

file(READ "${INPUT}" shader)
get_filename_component(shader_dir "${INPUT}" DIRECTORY)
# Expand the shared scalar operator before runtime Metal compilation, which has
# no source-tree include context. The resulting bytes belong to this build.
foreach(helper color_look_harmony_math color_look_grading_math)
  set(helper_include "#include \"../${helper}.h\"")
  string(FIND "${shader}" "${helper_include}" include_position)
  if(NOT include_position EQUAL -1)
    file(READ "${shader_dir}/../${helper}.h" helper_math)
    string(REPLACE "${helper_include}" "${helper_math}" shader "${shader}")
  endif()
endforeach()

string(FIND "${shader}" ")pe_msl\"" delimiter_position)
if(NOT delimiter_position EQUAL -1)
  message(FATAL_ERROR "Metal source contains the embedding delimiter")
endif()
string(LENGTH "${shader}" remaining)
set(header "#pragma once\n// Generated from canonical Metal source; do not edit.\nstatic NSString* photo_editor_bundled_color_shader_source() {\n  NSMutableString* source = [NSMutableString stringWithCapacity:${remaining}];\n")
while(remaining GREATER 0)
  set(length 12000)
  if(remaining LESS_EQUAL length)
    set(length "${remaining}")
  else()
    string(SUBSTRING "${shader}" 0 "${length}" prefix)
    string(FIND "${prefix}" "\n" newline REVERSE)
    if(NOT newline EQUAL -1)
      math(EXPR length "${newline} + 1")
    endif()
  endif()
  string(SUBSTRING "${shader}" 0 "${length}" chunk)
  string(APPEND header "  [source appendString:@R\"pe_msl(${chunk})pe_msl\"];\n")
  string(SUBSTRING "${shader}" "${length}" -1 shader)
  string(LENGTH "${shader}" remaining)
endwhile()
string(APPEND header "  return source;\n}\n")
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}.tmp" "${header}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
