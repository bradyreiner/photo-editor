# Prepared runtimes carry byte inventories trusted by the executable. Qt's
# deployer must not strip or rewrite their independently relocated binaries.
function(photo_editor_preserve_prepared_app_runtimes bundle_relative_path)
  if(NOT DEFINED QT_DEPLOY_PREFIX)
    message(FATAL_ERROR "QT_DEPLOY_PREFIX is required to preserve prepared runtimes.")
  endif()
  set(bundle_root "${QT_DEPLOY_PREFIX}/${bundle_relative_path}")
  set(stash "${bundle_root}.prepared-runtimes")
  if(EXISTS "${stash}" OR IS_SYMLINK "${stash}")
    message(FATAL_ERROR "Prepared runtime staging already exists: ${stash}")
  endif()
  foreach(runtime IN ITEMS agent-runtime search-runtime)
    set(source "${bundle_root}/Contents/Resources/${runtime}")
    if(IS_SYMLINK "${source}" OR (EXISTS "${source}" AND NOT IS_DIRECTORY "${source}"))
      message(FATAL_ERROR "Prepared runtime must be a directory: ${source}")
    endif()
    if(IS_DIRECTORY "${source}")
      file(MAKE_DIRECTORY "${stash}")
      file(RENAME "${source}" "${stash}/${runtime}" RESULT result)
      if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not preserve ${runtime}: ${result}")
      endif()
    endif()
  endforeach()
endfunction()

function(photo_editor_restore_prepared_app_runtimes bundle_relative_path)
  if(NOT DEFINED QT_DEPLOY_PREFIX)
    message(FATAL_ERROR "QT_DEPLOY_PREFIX is required to restore prepared runtimes.")
  endif()
  set(bundle_root "${QT_DEPLOY_PREFIX}/${bundle_relative_path}")
  set(stash "${bundle_root}.prepared-runtimes")
  if(IS_SYMLINK "${stash}")
    message(FATAL_ERROR "Prepared runtime staging must not be a symlink: ${stash}")
  endif()
  foreach(runtime IN ITEMS agent-runtime search-runtime)
    set(source "${stash}/${runtime}")
    set(destination "${bundle_root}/Contents/Resources/${runtime}")
    if(IS_SYMLINK "${source}")
      message(FATAL_ERROR "Preserved runtime must not be a symlink: ${source}")
    endif()
    if(IS_DIRECTORY "${source}")
      if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
        message(FATAL_ERROR "Refusing to overwrite deployed runtime: ${destination}")
      endif()
      file(RENAME "${source}" "${destination}" RESULT result)
      if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not restore ${runtime}: ${result}")
      endif()
    endif()
  endforeach()
  if(IS_DIRECTORY "${stash}")
    file(GLOB leftovers LIST_DIRECTORIES TRUE "${stash}/*")
    if(leftovers)
      message(FATAL_ERROR "Unexpected files remain in prepared runtime staging: ${leftovers}")
    endif()
    file(REMOVE_RECURSE "${stash}")
  endif()
endfunction()
