function(virel_dereference_deployed_qml_plugins bundle_name)
  if(NOT APPLE)
    return()
  endif()

  set(qt_qml_root "${__QT_DEPLOY_QT_INSTALL_PREFIX}/${__QT_DEPLOY_QT_INSTALL_DATA}/qml")
  foreach(relative_plugin IN LISTS ARGN)
    set(deployed_plugin "${QT_DEPLOY_PREFIX}/${relative_plugin}")
    if(NOT IS_SYMLINK "${deployed_plugin}")
      continue()
    endif()

    get_filename_component(plugin_name "${deployed_plugin}" NAME)
    file(GLOB_RECURSE source_candidates LIST_DIRECTORIES FALSE "${qt_qml_root}/${plugin_name}")
    list(LENGTH source_candidates source_candidate_count)
    if(source_candidate_count EQUAL 0)
      message(FATAL_ERROR "Unable to resolve deployed Qt QML plug-in symlink: ${plugin_name}")
    endif()

    list(GET source_candidates 0 source_candidate)
    file(REAL_PATH "${source_candidate}" resolved_source)
    file(REMOVE "${deployed_plugin}")
    file(COPY_FILE "${resolved_source}" "${deployed_plugin}")
  endforeach()

  set(deployed_qml_root "${QT_DEPLOY_PREFIX}/${bundle_name}/Contents/Resources/qml")
  file(GLOB_RECURSE deployed_qml_entries LIST_DIRECTORIES FALSE "${deployed_qml_root}/*")
  foreach(deployed_entry IN LISTS deployed_qml_entries)
    if(NOT IS_SYMLINK "${deployed_entry}" OR EXISTS "${deployed_entry}")
      continue()
    endif()

    file(RELATIVE_PATH relative_entry "${deployed_qml_root}" "${deployed_entry}")
    set(source_entry "${qt_qml_root}/${relative_entry}")
    if(NOT EXISTS "${source_entry}")
      message(FATAL_ERROR "Unable to resolve deployed Qt QML metadata symlink: ${relative_entry}")
    endif()
    file(REAL_PATH "${source_entry}" resolved_source)
    file(REMOVE "${deployed_entry}")
    file(COPY_FILE "${resolved_source}" "${deployed_entry}")
  endforeach()
endfunction()
