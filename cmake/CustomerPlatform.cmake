set(LOOKSY_CUSTOMER_API_URL "" CACHE STRING "HTTPS customer API issuer; empty retains receipt-only ownership")
set(LOOKSY_ENTITLEMENT_PUBLIC_KEY "" CACHE STRING "Base64 raw Ed25519 public key, never a private key")
set(LOOKSY_ENTITLEMENT_KEY_ID "looksy-1" CACHE STRING "Pinned entitlement signing key ID")
option(LOOKSY_ENABLE_CRASH_REPORTING "Build the opt-in Sentry Native integration" OFF)
set(LOOKSY_SENTRY_DSN "" CACHE STRING "Public Sentry ingestion DSN")
set(LOOKSY_CRASHPAD_HANDLER "" CACHE FILEPATH "Crashpad handler from the same Sentry Native build")
set(LOOKSY_RELEASE_CHANNEL "development" CACHE STRING "Crash release channel")
if(NOT LOOKSY_RELEASE_CHANNEL MATCHES "^(development|staging|beta|stable)$")
  message(FATAL_ERROR "Invalid release channel")
endif()
if(LOOKSY_SENTRY_DSN AND NOT LOOKSY_SENTRY_DSN MATCHES "^https://[A-Za-z0-9]+@[A-Za-z0-9.-]+/[0-9]+$")
  message(FATAL_ERROR "Invalid public Sentry DSN")
endif()
find_package(OpenSSL 3 QUIET COMPONENTS Crypto)
if(LOOKSY_CUSTOMER_API_URL)
  if(NOT LOOKSY_CUSTOMER_API_URL MATCHES "^https://[A-Za-z0-9.-]+(:[0-9]+)?$")
    message(FATAL_ERROR "LOOKSY_CUSTOMER_API_URL must be an HTTPS origin without a path")
  endif()
  string(LENGTH "${LOOKSY_ENTITLEMENT_PUBLIC_KEY}" entitlement_key_length)
  if(NOT LOOKSY_ENTITLEMENT_PUBLIC_KEY MATCHES "^[A-Za-z0-9+/]+=$" OR
      NOT entitlement_key_length EQUAL 44 OR NOT OpenSSL_FOUND)
    message(FATAL_ERROR "Customer access requires the pinned Ed25519 public key and OpenSSL Crypto")
  endif()
endif()
if(NOT LOOKSY_ENTITLEMENT_KEY_ID MATCHES "^[A-Za-z0-9_-]+$")
  message(FATAL_ERROR "Invalid entitlement key ID")
endif()
configure_file("${PROJECT_SOURCE_DIR}/cmake/customer_platform_config.h.in"
  "${CMAKE_CURRENT_BINARY_DIR}/customer_platform_config.h" @ONLY)
add_library(photo_editor_customer_access STATIC
  src/customer_lease.cpp src/customer_lease.h
  src/customer_credential_store.cpp src/customer_credential_store.h
  src/crash_reporting_controller.cpp src/crash_reporting_controller.h
  src/customer_access_controller.cpp src/customer_access_controller.h)
set_target_properties(photo_editor_customer_access PROPERTIES AUTOMOC ON)
target_include_directories(photo_editor_customer_access PUBLIC src PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(photo_editor_customer_access PUBLIC Qt6::Core Qt6::Network Qt6::Gui)
target_compile_definitions(photo_editor_customer_access PRIVATE LOOKSY_HAS_ENTITLEMENT_CRYPTO=$<BOOL:${OpenSSL_FOUND}>)
target_compile_definitions(photo_editor_customer_access PRIVATE LOOKSY_HAS_SENTRY=$<BOOL:${LOOKSY_ENABLE_CRASH_REPORTING}>)
if(LOOKSY_ENABLE_CRASH_REPORTING)
  find_package(sentry 0.17 CONFIG REQUIRED)
  if(NOT LOOKSY_SENTRY_DSN)
    message(FATAL_ERROR "Crash reporting requires LOOKSY_SENTRY_DSN")
  endif()
  if(NOT EXISTS "${LOOKSY_CRASHPAD_HANDLER}")
    message(FATAL_ERROR "Crash reporting requires LOOKSY_CRASHPAD_HANDLER from the matching SDK build")
  endif()
  target_link_libraries(photo_editor_customer_access PRIVATE sentry::sentry)
endif()
if(OpenSSL_FOUND)
  target_link_libraries(photo_editor_customer_access PUBLIC OpenSSL::Crypto)
endif()
if(APPLE)
  target_link_libraries(photo_editor_customer_access PRIVATE "-framework Security" "-framework CoreFoundation")
elseif(WIN32)
  target_link_libraries(photo_editor_customer_access PRIVATE Advapi32)
endif()
photo_editor_apply_warnings(photo_editor_customer_access)
