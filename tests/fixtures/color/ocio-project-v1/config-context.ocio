ocio_profile_version: 2.1

name: photo-editor-ocio-context-v1
description: Deterministic context-isolation fixture.

search_path: luts
strictparsing: true

environment:
  LUT_NAME: scale.clf

roles:
  default: linear
  scene_linear: linear

file_rules:
  - !<Rule> {name: Default, colorspace: linear}

displays:
  Context Display:
    - !<View> {name: Raw, colorspace: linear}

active_displays: [Context Display]
active_views: [Raw]

colorspaces:
  - !<ColorSpace>
    name: linear
    family: Working
    encoding: scene-linear
    bitdepth: 32f
    isdata: false

  - !<ColorSpace>
    name: context_scaled
    family: Context
    description: Resolves an explicitly controlled context-variable LUT.
    encoding: scene-linear
    bitdepth: 32f
    isdata: false
    from_scene_reference: !<FileTransform> {src: $LUT_NAME}
