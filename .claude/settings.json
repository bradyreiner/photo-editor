{
  "permissions": {
    "allow": [
      "Bash(cmake --preset *)",
      "Bash(cmake --build --preset *)",
      "Bash(ctest --preset *)",
      "Bash(ctest --test-dir *)",
      "Bash(cd rust && cargo test *)",
      "Bash(cd rust && cargo check *)",
      "Bash(cd rust && cargo fmt *)",
      "Bash(cd rust && cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(python3 *scripts/ai/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "mcp__photo-editor__search_code",
      "mcp__photo-editor__read_path",
      "mcp__photo-editor__cmake_configure",
      "mcp__photo-editor__cmake_build",
      "mcp__photo-editor__ctest_run",
      "mcp__photo-editor__cargo_test",
      "mcp__photo-editor__run_repo_checks",
      "mcp__photo-editor__catalog_local_db",
      "mcp__photo-editor__list_observability_runs",
      "mcp__photo-editor__read_observability_run"
    ]
  },
  "env": {
    "RUST_BACKTRACE": "1",
    "QT_QPA_PLATFORM": "offscreen"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/ai/session_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/ai/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/ai/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/ai/post_tool_guidance.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__photo-editor__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/ai/post_mcp_guidance.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
