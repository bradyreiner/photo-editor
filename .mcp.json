{
  "mcpServers": {
    "photo-editor": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "rust/Cargo.toml",
        "-p",
        "photo-editor-mcp",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "${RUST_LOG:-info}",
        "OTEL_SERVICE_NAMESPACE": "${OTEL_SERVICE_NAMESPACE:-photo-editor-dev}",
        "OTEL_DEPLOYMENT_ENVIRONMENT": "${OTEL_DEPLOYMENT_ENVIRONMENT:-development}"
      }
    }
  }
}
