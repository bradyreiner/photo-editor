  "readAndDeliveryExamples": [
    {
      "tool": "app.agent_guide",
      "arguments": {
        "workflow": "timeline"
      }
    },
    {
      "tool": "timeline.inspect_document",
      "arguments": {}
    },
    {
      "tool": "app.list_commands",
      "arguments": {
        "domain": "timeline",
        "query": "createTimeline",
        "offset": 0,
        "limit": 64
      }
    },
    {
      "tool": "app.command_schema",
      "arguments": {
        "commandId": "timeline.action.createTimelineTitle"
      }
    },
    {
      "tool": "timeline.inspect_structure",
      "arguments": {
        "scope": "tracks",
        "maxItems": 64,
        "resourceId": "${CURRENT_RESOURCE_ID}",
        "documentHash": "${CURRENT_DOCUMENT_HASH}"
      }
    },
    {
      "tool": "timeline.preview_at_time",
      "arguments": {
        "seconds": 9,
        "resourceId": "${CURRENT_RESOURCE_ID}",
        "documentHash": "${CURRENT_DOCUMENT_HASH}"
      }
    },
    {
      "tool": "timeline.capture_visible_proof",
      "arguments": {}
    },
    {
      "tool": "timeline.capture_visible_proof",
      "arguments": {
        "captureId": "${RETURNED_CAPTURE_ID}"
      }
    },
    {
      "tool": "timeline.inspect_used_media",
      "arguments": {
        "offset": 0,
        "maxItems": 256,
        "resourceId": "${CURRENT_RESOURCE_ID}",
        "documentHash": "${CURRENT_DOCUMENT_HASH}"
      }
    },
    {
      "tool": "timeline.inspect_delivery_preflight",
      "arguments": {
        "preset": "instagram"
      }
    },
    {
      "tool": "timeline.export_h264",
      "arguments": {
        "requestId": "${NEW_CANONICAL_UUID}",
        "confirmed": true,
        "resourceId": "${CURRENT_RESOURCE_ID}",
        "documentHash": "${CURRENT_DOCUMENT_HASH}"
      }
    },
    {
      "tool": "timeline.inspect_export",
      "arguments": {
        "requestId": "${SAME_EXPORTED_REQUEST_UUID}",
        "resourceId": "${CURRENT_RESOURCE_ID}",
        "documentHash": "${CURRENT_DOCUMENT_HASH}"
      }
    }
  ],
  "uncertainReplyRule": "Inspect current state/receipts. Do not replay create/import/edit or queue a new export request ID.",
