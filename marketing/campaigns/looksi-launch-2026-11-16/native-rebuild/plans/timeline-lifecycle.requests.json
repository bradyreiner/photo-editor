      "create": {
        "tool": "timeline.create_draft",
        "arguments": {
          "settings": {
            "timelineName": "LOOKSi C01 — I wanted to make this.",
            "width": 1080,
            "height": 1920,
            "frameRate": 30,
            "audioSampleRate": 48000,
            "colorSpace": "Rec.709",
            "dataLevels": "Legal",
            "trackLayout": "creator_social"
          }
        }
      },
      "admit": {
        "tool": "timeline.admit_task",
        "arguments": {
          "targetResourceId": "${CURRENT_RESOURCE_ID}",
          "objective": "I wanted to make this. — author native editable Timeline objects",
          "actions": [
            {
              "kind": "text",
              "summary": "Create editable campaign titles and native graphic shapes."
            },
            {
              "kind": "layers",
              "summary": "Create and arrange native Timeline tracks and clips."
            },
            {
              "kind": "media",
              "summary": "Import only the listed raw/native source assets as individual clips."
            },
            {
              "kind": "framing",
              "summary": "Frame sources and animate native position, scale and opacity."
            },
            {
              "kind": "audio",
              "summary": "Place admitted audio source clips and author gain envelopes in Timeline."
            },
            {
              "kind": "delivery",
              "summary": "Save readback-verified native project and prepare native H.264 export."
            }
          ],
          "assetPaths": [
