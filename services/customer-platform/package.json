{
  "name": "looksy-customer-platform",
  "private": true,
  "overrides": { "workerd": "1.20260921.1", "sharp": "0.35.4" },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local",
    "types": "wrangler types",
