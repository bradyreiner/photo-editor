    "setup:check": "node scripts/check-setup.mjs",
    "setup:staff": "node scripts/staff-access.mjs",
    "operations:check": "node scripts/check-operations.mjs",
    "operations:monitor": "node scripts/monitor-operations.mjs",
    "database:recovery": "node scripts/database-recovery.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260923.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.137.0"
  }
}
